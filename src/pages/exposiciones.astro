---
import Layout from '../layouts/Layout.astro';
import MenuItem from '../components/MenuItem.astro';
import SideMenu from '../components/SideMenu.astro';
import EmptyState from '../components/EmptyState.astro';

// La página se guarda ya montada en la CDN de Vercel durante 5 minutos. Sin
// esto, CADA visita —y cada toque en una tarjeta, porque la ficha también se
// construye en el servidor— obliga a ir a Google Sheets y esperar su respuesta
// antes de poder pintar nada: medido, 645ms de los 650 que tardaba la primera
// tinta.
//
// `stale-while-revalidate` de un día: pasados los 5 minutos el visitante sigue
// recibiendo la copia al instante y la CDN la rehace por detrás. Nadie espera a
// Google, ni siquiera el primero que llega tras caducar.
//
// Se cachea por URL completa, así que ?view=, ?search= y ?location= tienen cada
// una la suya. Para comprobar que un cambio de la hoja ha subido bien, añade
// cualquier parámetro nuevo (?v=2): es otra clave de caché y se construye desde
// cero.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
---

<Layout title="Sala de Exposiciones">
  <div class="w-full max-w-[1440px] min-h-dvh mx-auto bg-mel-bg-primary px-6 sm:px-12 lg:px-[108px] pb-16 flex flex-col items-center">

    <!-- Header (Solid background, no transparency). pt-[var(--mel-header-pt-mobile)] lg:pt-[var(--mel-header-pt-desktop)] and the row layout
         mirror the home page header exactly so the title/menu never shift between
         pages; on mobile the title collapses to "M.E.L." and the menu to its icon.
         108px side padding now switches at `lg` (1024px), same as index.astro/
         info.astro/event/[id].astro — was `md` (768px) here, giving this page
         wider margins than the others in the 768-1024px range. -->
    <div class="w-full bg-mel-bg-primary shrink-0 sticky top-0 z-[190] border-b border-mel-border/30 pb-4 pt-[var(--mel-header-pt-mobile)] lg:pt-[var(--mel-header-pt-desktop)]">
      <div class="flex items-center gap-4 lg:gap-6 w-full">
        <div class="flex-1 min-w-0 w-full">
          <a href="/" class="flex items-center h-[48px] no-underline text-mel-text-primary hover:text-mel-action-primary transition-colors duration-200">
            <span class="font-sans font-bold text-[22px] leading-[28px] tracking-[-0.44px] whitespace-nowrap select-none">
              <span class="lg:hidden">M.E.L.</span><span class="hidden lg:inline">Memoria Electrónica Leonesa</span>
            </span>
          </a>
        </div>
        <div class="shrink-0 flex justify-end">
          <MenuItem id="menu-btn" />
        </div>
      </div>
    </div>

    <!-- Main Empty State Section -->
    <div class="flex-1 flex flex-col items-center justify-center pt-[80px] pb-[100px] w-full">
      <EmptyState />
    </div>

  </div>

  <SideMenu />
</Layout>
