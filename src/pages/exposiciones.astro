---
import Layout from '../layouts/Layout.astro';
import MenuItem from '../components/MenuItem.astro';
import SideMenu from '../components/SideMenu.astro';
---

<Layout title="Sala de Exposiciones">
  <div class="w-full max-w-[1440px] min-h-screen mx-auto bg-mel-bg-primary px-6 sm:px-12 md:px-[108px] pb-16 flex flex-col items-center">
    
    <!-- Header (Solid background, no transparency) -->
    <div class="w-full bg-mel-bg-primary shrink-0 sticky top-0 z-[190] border-b border-mel-border/30 pb-4 pt-[32px] md:pt-[112px]">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center w-full">
        <div class="col-span-12 md:col-span-6 w-full">
          <a href="/" class="flex items-center no-underline text-mel-text-primary hover:text-mel-action-primary transition-colors duration-200">
            <span class="font-sans font-bold text-[22px] leading-[28px] tracking-[-0.44px] whitespace-nowrap select-none">
              Memoria Electrónica Leonesa
            </span>
          </a>
        </div>
        <div class="col-span-12 md:col-span-6 flex justify-end">
          <MenuItem id="menu-btn" />
        </div>
      </div>
    </div>

    <!-- Main Empty State Section -->
    <div class="flex-1 flex flex-col items-center justify-center pt-[80px] pb-[100px] text-center w-full max-w-[600px]">
      <!-- Rounded Icon Wrapper -->
      <div class="w-[100px] h-[100px] rounded-full bg-mel-bg-secondary flex items-center justify-center text-mel-action-secondary mb-8 shadow-inner border border-mel-border/10 transition-transform duration-300 hover:scale-105">
        <!-- Lucide Box/Exhibition Icon -->
        <svg class="w-12 h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
      </div>

      <!-- Heading -->
      <h1 class="font-sans font-bold text-[36px] sm:text-[40px] leading-[44px] tracking-[-1.6px] text-mel-text-primary mb-4">
        Sala de Exposiciones
      </h1>

      <!-- Alert Warning Box -->
      <div class="w-full bg-[#fcf9f9] dark:bg-[#201618] border border-mel-border/40 p-5 mb-8 flex flex-col items-center gap-2 rounded-sm">
        <span class="font-sans font-bold text-[14px] uppercase tracking-[0.05em] text-mel-action-primary">En construcción</span>
        <p class="font-sans font-normal text-[17px] leading-[24px] tracking-[-0.17px] text-mel-text-secondary max-w-[400px]">
          La exposición está en construcción. Estamos trabajando en ello para ofrecerte la mejor experiencia muy pronto.
        </p>
      </div>

      <!-- Action Button -->
      <a 
        href="/" 
        class="inline-block px-8 py-3 bg-mel-action-secondary text-mel-text-on-action hover:bg-mel-action-primary font-sans font-bold text-[15px] leading-[20px] transition-colors duration-200 no-underline shadow-sm hover:shadow-md cursor-pointer"
      >
        Volver al Inicio
      </a>
    </div>

  </div>

  <SideMenu />
</Layout>
