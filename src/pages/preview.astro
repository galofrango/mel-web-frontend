---
// preview.astro — Standalone animation preview (no editor)
// This file is for local experimentation only; it is NOT linked from the main site.
import Layout from '../layouts/Layout.astro';
---

<Layout title="MEL Preview">
  <!-- SVG Filters -->
  <svg class="hidden absolute w-0 h-0" aria-hidden="true">
    <defs>
      <filter id="bleed-cian" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" result="noise" />
        <feDisplacementMap id="disp-cian" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="bleed-yellow" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
        <feDisplacementMap id="disp-yellow" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="bleed-magenta" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="3" result="noise" />
        <feDisplacementMap id="disp-magenta" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="grain-filter" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence id="grain-turbulence" type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" result="noise"/>
        <feColorMatrix type="saturate" values="0" in="noise" result="gray"/>
        <feBlend mode="overlay" in="SourceGraphic" in2="gray" result="blend"/>
        <feComposite in="blend" in2="SourceGraphic" operator="in"/>
      </filter>
    </defs>
  </svg>

  <!-- Canvas -->
  <div id="pv-canvas" class="fixed inset-0 bg-[#f7f3f5] z-0 flex items-end justify-center overflow-hidden">
    <!-- Paper -->
    <div id="pv-paper" class="absolute inset-0 pointer-events-none opacity-40 z-10"></div>
    <!-- Noise -->
    <div id="pv-noise" class="absolute inset-0 pointer-events-none z-40 mix-blend-overlay opacity-0"></div>
    <!-- CRT -->
    <div id="pv-crt" class="absolute inset-0 pointer-events-none opacity-0 z-20"></div>
    <!-- Scanlines -->
    <div id="pv-scanline" class="absolute inset-0 pointer-events-none opacity-0 z-[25] bg-[linear-gradient(0deg,rgba(0,0,0,0.6)_50%,transparent_50%)] bg-[length:100%_4px]"></div>

    <!-- Content -->
    <div class="relative w-full max-w-[1440px] h-full max-h-[1024px] aspect-[1440/1024] flex flex-col justify-end p-[7.5%] pb-[140px] md:pb-[160px] z-30">
      <div class="flex flex-col items-start w-full">

        <!-- Title layers -->
        <div id="pv-title-container" class="relative w-full h-[220px] md:h-[420px] isolate">

          <!-- CIAN -->
          <div id="pv-layer-cian"
            class="absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#00ffff] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply overflow-visible">
            <div class="relative z-10 flex flex-col" style="visibility:hidden">
              <span class="block">Memoria</span>
              <span class="block">Electrónica</span>
              <span class="block">Leonesa</span>
            </div>
            <div id="pv-layer-cian-ht" class="absolute inset-0 z-30 pointer-events-none flex flex-col">
              <div id="pv-layer-cian-ht-dots" class="flex flex-col"
                style="-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;background-image:radial-gradient(circle,#00ffff 40%,transparent 41%);background-size:8px 8px;">
                <span class="block">Memoria</span>
                <span class="block">Electrónica</span>
                <span class="block">Leonesa</span>
              </div>
            </div>
          </div>

          <!-- YELLOW -->
          <div id="pv-layer-yellow"
            class="absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#ffff00] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply overflow-visible">
            <div class="relative z-10 flex flex-col" style="visibility:hidden">
              <span class="block">Memoria</span>
              <span class="block">Electrónica</span>
              <span class="block">Leonesa</span>
            </div>
            <div id="pv-layer-yellow-ht" class="absolute inset-0 z-30 pointer-events-none flex flex-col">
              <div id="pv-layer-yellow-ht-dots" class="flex flex-col"
                style="-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;background-image:radial-gradient(circle,#ffff00 40%,transparent 41%);background-size:8px 8px;">
                <span class="block">Memoria</span>
                <span class="block">Electrónica</span>
                <span class="block">Leonesa</span>
              </div>
            </div>
          </div>

          <!-- MAGENTA -->
          <div id="pv-layer-magenta"
            class="absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#ff00ff] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply overflow-visible">
            <div class="relative z-10 flex flex-col" style="visibility:hidden">
              <span class="block">Memoria</span>
              <span class="block">Electrónica</span>
              <span class="block">Leonesa<span id="pv-reg" class="text-[#981932] text-[0.8em] tracking-[-0.05em] font-sans font-bold relative -top-[0.1em] ml-1">®</span></span>
            </div>
            <div id="pv-layer-magenta-ht" class="absolute inset-0 z-30 pointer-events-none flex flex-col">
              <div id="pv-layer-magenta-ht-dots" class="flex flex-col"
                style="-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;background-image:radial-gradient(circle,#ff00ff 40%,transparent 41%);background-size:8px 8px;">
                <span class="block">Memoria</span>
                <span class="block">Electrónica</span>
                <span class="block">Leonesa<span class="text-[#981932] text-[0.8em] tracking-[-0.05em] font-sans font-bold relative -top-[0.1em] ml-1">®</span></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div id="pv-divider" class="w-full h-[2px] bg-[#190609] my-[3.3%] opacity-100 scale-x-100 origin-left"></div>

        <!-- Subtitle -->
        <div id="pv-subtitle"
          class="flex items-center flex-wrap h-[48px] shrink-0 font-sans font-normal text-[4.6vw] md:text-[38px] text-[#190609] tracking-[-0.04em] relative w-full">
        </div>
      </div>
    </div>
  </div>

  <!-- Minimal HUD -->
  <div class="fixed top-0 left-0 right-0 z-[500] h-10 flex items-center justify-between px-5 select-none"
    style="background:rgba(0,0,0,0.55);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.06)">
    <!-- Brand -->
    <div class="flex items-center gap-2 text-[11px] font-semibold text-white/70 tracking-widest uppercase">
      <span class="w-1.5 h-1.5 rounded-full bg-[#00e5ff]/70"></span>
      MEL Preview
    </div>

    <!-- Preset selector -->
    <div class="flex items-center gap-1" id="pv-preset-btns"></div>

    <!-- Playback -->
    <div class="flex items-center gap-3">
      <span id="pv-tc" class="font-mono text-[11px] text-white/50 tabular-nums">0.00s</span>
      <button id="pv-play"
        class="w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 border border-white/10 flex items-center justify-center text-white transition-all"
        title="Play / Pause (Espacio)">
        <svg id="pv-icon-play" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg id="pv-icon-pause" class="w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>
      <a href="/intro-lab" class="text-[11px] text-white/30 hover:text-white/70 transition-colors">Editor →</a>
    </div>
  </div>

  <!-- Timeline scrubber (thin, bottom) -->
  <div class="fixed bottom-0 left-0 right-0 z-[500] h-1 bg-white/5 cursor-pointer" id="pv-track">
    <div id="pv-progress" class="h-full bg-[#00e5ff]/40 w-0 pointer-events-none"></div>
  </div>
</Layout>

<script>
  // ─── TYPES ───────────────────────────────────────────────────────────────────
  interface LayerFX {
    color: string; opacity: number; blend: string;
    bloom: number; bleed: number; blur: number;
    halftone: number; angle: number; htSize: number; htHard: number;
    offsetX?: number; offsetY?: number;
  }
  interface Keyframe {
    time: number;
    bgColor: string; bgOpacity: number;
    subColor: string; subOpacity: number;
    cian: LayerFX; yellow: LayerFX; magenta: LayerFX;
    crtOpacity: number; crtSize: number; scanlineOpacity: number;
    paperOpacity: number; paperType: string; paperScale: number;
    noiseOpacity?: number; noiseScale?: number;
  }
  interface Preset { id: string; name: string; keyframes: Keyframe[]; }

  // ─── DATA ─────────────────────────────────────────────────────────────────────
  const PRESETS: Preset[] = [
    {
      "id": "crt",
      "name": "1. CRT Macro Grid",
      "keyframes": [
        {"time":0,"bgColor":"#f7f3f5","bgOpacity":100,"subColor":"#190609","subOpacity":100,"cian":{"color":"#00ffff","opacity":71,"blend":"overlay","bloom":0,"bleed":0.5,"blur":3.5,"halftone":99,"angle":17,"htSize":15,"htHard":71,"offsetX":-21,"offsetY":-13},"yellow":{"color":"#ffff00","opacity":100,"blend":"overlay","bloom":0,"bleed":7.5,"blur":0,"halftone":100,"angle":163,"htSize":16,"htHard":38,"offsetX":-24,"offsetY":-18},"magenta":{"color":"#ff00ff","opacity":100,"blend":"multiply","bloom":0,"bleed":0,"blur":0,"halftone":35,"angle":196,"htSize":9,"htHard":47,"offsetX":-20,"offsetY":-16},"crtOpacity":0,"crtSize":4,"scanlineOpacity":0,"paperOpacity":13,"paperType":"toner","paperScale":20,"noiseOpacity":100,"noiseScale":5},
        {"time":1.25,"bgColor":"#f7f3f5","bgOpacity":100,"subColor":"#190609","subOpacity":100,"cian":{"color":"#00ffff","opacity":64,"blend":"overlay","bloom":0,"bleed":2,"blur":4,"halftone":96,"angle":18,"htSize":14,"htHard":71,"offsetX":-21,"offsetY":-13},"yellow":{"color":"#ffff00","opacity":100,"blend":"overlay","bloom":0,"bleed":7,"blur":0,"halftone":99,"angle":164,"htSize":16,"htHard":38,"offsetX":-24,"offsetY":-18},"magenta":{"color":"#ff00ff","opacity":100,"blend":"multiply","bloom":0,"bleed":1,"blur":0,"halftone":39,"angle":213,"htSize":9,"htHard":44,"offsetX":-20,"offsetY":-16},"crtOpacity":0,"crtSize":4,"scanlineOpacity":0,"paperOpacity":12,"paperType":"toner","paperScale":19,"noiseOpacity":99,"noiseScale":5},
        {"time":2.5,"bgColor":"#f7f3f5","bgOpacity":100,"subColor":"#190609","subOpacity":100,"cian":{"color":"#00ffff","opacity":9,"blend":"multiply","bloom":3,"bleed":13,"blur":6,"halftone":74,"angle":28,"htSize":10,"htHard":69,"offsetX":-22,"offsetY":-16},"yellow":{"color":"#ffff00","opacity":14,"blend":"multiply","bloom":0,"bleed":5,"blur":4,"halftone":100,"angle":168,"htSize":28,"htHard":50,"offsetX":-24,"offsetY":-20},"magenta":{"color":"#ff00ff","opacity":14,"blend":"multiply","bloom":0,"bleed":7,"blur":0,"halftone":70,"angle":339,"htSize":7,"htHard":19,"offsetX":-22,"offsetY":-17},"crtOpacity":0,"crtSize":3,"scanlineOpacity":0,"paperOpacity":6,"paperType":"halftone","paperScale":12,"noiseOpacity":95,"noiseScale":5},
        {"time":2.87,"bgColor":"#f7f3f5","bgOpacity":100,"subColor":"#190609","subOpacity":100,"cian":{"color":"#00ffff","opacity":3,"blend":"multiply","bloom":3,"bleed":14.5,"blur":6,"halftone":72,"angle":29,"htSize":10,"htHard":69,"offsetX":-22,"offsetY":-16},"yellow":{"color":"#ffff00","opacity":4,"blend":"multiply","bloom":0,"bleed":4.5,"blur":4.5,"halftone":100,"angle":168,"htSize":29,"htHard":51,"offsetX":-24,"offsetY":-20},"magenta":{"color":"#ff00ff","opacity":4,"blend":"multiply","bloom":0,"bleed":7.5,"blur":0,"halftone":74,"angle":354,"htSize":7,"htHard":16,"offsetX":-22,"offsetY":-17},"crtOpacity":0,"crtSize":3,"scanlineOpacity":0,"paperOpacity":5,"paperType":"halftone","paperScale":11,"noiseOpacity":94,"noiseScale":5},
        {"time":2.99,"bgColor":"#f7f3f5","bgOpacity":100,"subColor":"#190609","subOpacity":19,"cian":{"color":"#00ffff","opacity":100,"blend":"multiply","bloom":0,"bleed":0,"blur":3.5,"halftone":11,"angle":38,"htSize":6,"htHard":68,"offsetX":-24,"offsetY":-13},"yellow":{"color":"#ffff00","opacity":100,"blend":"multiply","bloom":0,"bleed":0,"blur":0,"halftone":91,"angle":171,"htSize":16,"htHard":38,"offsetX":-24,"offsetY":-21},"magenta":{"color":"#ff00ff","opacity":100,"blend":"multiply","bloom":0,"bleed":1.5,"blur":1,"halftone":36,"angle":138,"htSize":5,"htHard":54,"offsetX":-24,"offsetY":-18},"crtOpacity":0,"crtSize":2,"scanlineOpacity":0,"paperOpacity":0,"paperType":"halftone","paperScale":6,"noiseOpacity":90,"noiseScale":5}
      ]
    },
    {
      "id": "riso",
      "name": "2. Riso LED",
      "keyframes": [
        {"time":0,"bgColor":"#fbf7f4","bgOpacity":100,"subColor":"#280a14","subOpacity":100,"cian":{"color":"#00e5ff","opacity":100,"blend":"multiply","bloom":0,"bleed":4,"blur":0.2,"halftone":60,"angle":15,"htSize":6,"htHard":50},"yellow":{"color":"#ffea00","opacity":100,"blend":"multiply","bloom":0,"bleed":6,"blur":0.4,"halftone":65,"angle":0,"htSize":6,"htHard":50},"magenta":{"color":"#ff0077","opacity":100,"blend":"multiply","bloom":0,"bleed":3,"blur":0.1,"halftone":60,"angle":75,"htSize":6,"htHard":50},"crtOpacity":0,"crtSize":5,"scanlineOpacity":0,"paperOpacity":60,"paperType":"riso","paperScale":3},
        {"time":1.2,"bgColor":"#0a0812","bgOpacity":100,"subColor":"#ffffff","subOpacity":100,"cian":{"color":"#00ffff","opacity":100,"blend":"screen","bloom":15,"bleed":1,"blur":0,"halftone":0,"angle":15,"htSize":6,"htHard":50},"yellow":{"color":"#ffff00","opacity":100,"blend":"screen","bloom":12,"bleed":1,"blur":0,"halftone":0,"angle":0,"htSize":6,"htHard":50},"magenta":{"color":"#ff00ff","opacity":100,"blend":"screen","bloom":15,"bleed":1,"blur":0,"halftone":0,"angle":75,"htSize":6,"htHard":50},"crtOpacity":100,"crtSize":5,"scanlineOpacity":0,"paperOpacity":0,"paperType":"riso","paperScale":3}
      ]
    },
    {
      "id": "scanline",
      "name": "3. Curva Scanline",
      "keyframes": [
        {"time":0.88,"bgColor":"#030206","bgOpacity":100,"subColor":"#ffffff","subOpacity":100,"cian":{"color":"#0040ff","opacity":100,"blend":"screen","bloom":30,"bleed":0,"blur":0.5,"halftone":29,"angle":45,"htSize":10,"htHard":49,"offsetX":0,"offsetY":10},"yellow":{"color":"#00ff59","opacity":100,"blend":"screen","bloom":35,"bleed":0,"blur":0,"halftone":37,"angle":45,"htSize":10,"htHard":22,"offsetX":2,"offsetY":0},"magenta":{"color":"#ff0000","opacity":100,"blend":"screen","bloom":30,"bleed":0,"blur":0,"halftone":38,"angle":45,"htSize":10,"htHard":90,"offsetX":0,"offsetY":0},"crtOpacity":70,"crtSize":12,"scanlineOpacity":100,"paperOpacity":0,"paperType":"satin","paperScale":6,"noiseOpacity":0,"noiseScale":0.7},
        {"time":1.6,"bgColor":"#f4f2f5","bgOpacity":100,"subColor":"#100b12","subOpacity":100,"cian":{"color":"#00ffff","opacity":98,"blend":"multiply","bloom":0,"bleed":0,"blur":0,"halftone":50,"angle":45,"htSize":10,"htHard":58,"offsetX":0,"offsetY":0},"yellow":{"color":"#ffff00","opacity":100,"blend":"multiply","bloom":0,"bleed":14.5,"blur":0,"halftone":50,"angle":45,"htSize":10,"htHard":56,"offsetX":0,"offsetY":0},"magenta":{"color":"#ff00ff","opacity":100,"blend":"multiply","bloom":0,"bleed":0,"blur":0,"halftone":81,"angle":360,"htSize":10,"htHard":56,"offsetX":0,"offsetY":0},"crtOpacity":0,"crtSize":4,"scanlineOpacity":0,"paperOpacity":50,"paperType":"satin","paperScale":8,"noiseOpacity":0,"noiseScale":0.7}
      ]
    },
    {
      "id": "bloom",
      "name": "4. Bloom Subpíxel",
      "keyframes": [
        {"time":0,"bgColor":"#f8f5f6","bgOpacity":100,"subColor":"#1b080e","subOpacity":100,"cian":{"color":"#00ffff","opacity":100,"blend":"multiply","bloom":0,"bleed":2,"blur":0,"halftone":50,"angle":105,"htSize":12,"htHard":60},"yellow":{"color":"#ffff00","opacity":100,"blend":"multiply","bloom":0,"bleed":2,"blur":0,"halftone":50,"angle":90,"htSize":12,"htHard":60},"magenta":{"color":"#ff00ff","opacity":100,"blend":"multiply","bloom":0,"bleed":2,"blur":0,"halftone":50,"angle":15,"htSize":12,"htHard":60},"crtOpacity":0,"crtSize":4,"scanlineOpacity":0,"paperOpacity":40,"paperType":"toner","paperScale":5},
        {"time":1,"bgColor":"#08050c","bgOpacity":100,"subColor":"#ffffff","subOpacity":100,"cian":{"color":"#00ffff","opacity":100,"blend":"plus-lighter","bloom":45,"bleed":0,"blur":0,"halftone":0,"angle":105,"htSize":12,"htHard":60},"yellow":{"color":"#ffff00","opacity":100,"blend":"plus-lighter","bloom":40,"bleed":0,"blur":0,"halftone":0,"angle":90,"htSize":12,"htHard":60},"magenta":{"color":"#ff00ff","opacity":100,"blend":"plus-lighter","bloom":45,"bleed":0,"blur":0,"halftone":0,"angle":15,"htSize":12,"htHard":60},"crtOpacity":80,"crtSize":4,"scanlineOpacity":10,"paperOpacity":0,"paperType":"toner","paperScale":5}
      ]
    }
  ];

  const SUBTITLE = 'Archivo de la escena electrónica leonesa, 2004–2019';
  const MAX_TIME = 3.0;

  // ─── DOM REFS ──────────────────────────────────────────────────────────────
  const canvas        = document.getElementById('pv-canvas')!;
  const paper         = document.getElementById('pv-paper')!;
  const noiseLayer    = document.getElementById('pv-noise')!;
  const crtLayer      = document.getElementById('pv-crt')!;
  const scanline      = document.getElementById('pv-scanline')!;
  const lCian         = document.getElementById('pv-layer-cian')!;
  const lCianHt       = document.getElementById('pv-layer-cian-ht')!;
  const lYellow       = document.getElementById('pv-layer-yellow')!;
  const lYellowHt     = document.getElementById('pv-layer-yellow-ht')!;
  const lMagenta      = document.getElementById('pv-layer-magenta')!;
  const lMagentaHt    = document.getElementById('pv-layer-magenta-ht')!;
  const divider       = document.getElementById('pv-divider')!;
  const subtitle      = document.getElementById('pv-subtitle')!;
  const presetBtns    = document.getElementById('pv-preset-btns')!;
  const tcEl          = document.getElementById('pv-tc')!;
  const playBtn       = document.getElementById('pv-play')!;
  const iconPlay      = document.getElementById('pv-icon-play')!;
  const iconPause     = document.getElementById('pv-icon-pause')!;
  const trackEl       = document.getElementById('pv-track')!;
  const progressEl    = document.getElementById('pv-progress')!;

  // ─── STATE ────────────────────────────────────────────────────────────────
  let activePreset    = PRESETS[0];
  let currentTime     = 0;
  let isPlaying       = false;
  let lastTS: number | null = null;
  let rafId: number | null = null;

  // ─── SUBTITLE BUILD ───────────────────────────────────────────────────────
  subtitle.innerHTML = SUBTITLE.split(' ').map((w, i) =>
    `<span class="pv-word inline-block mr-[0.32em] last:mr-0" data-idx="${i}">${w}</span>`
  ).join('');

  // ─── PRESET BUTTONS ───────────────────────────────────────────────────────
  function renderPresetBtns() {
    presetBtns.innerHTML = PRESETS.map(p => {
      const active = p.id === activePreset.id;
      return `<button data-pid="${p.id}"
        class="px-2.5 py-1 rounded text-[11px] font-medium transition-all border
        ${active
          ? 'bg-white/15 border-white/20 text-white'
          : 'bg-transparent border-transparent text-white/40 hover:text-white/70'
        }">${p.name}</button>`;
    }).join('');
    presetBtns.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-pid')!;
        activePreset = PRESETS.find(p => p.id === id) ?? PRESETS[0];
        currentTime = 0;
        renderPresetBtns();
        seek(0);
      });
    });
  }
  renderPresetBtns();

  // ─── MATH ─────────────────────────────────────────────────────────────────
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  function hexToRgb(hex: string) {
    const c = hex.replace('#', '');
    const n = parseInt(c, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  function rgbToHex(r: number, g: number, b: number) {
    return '#' + [r, g, b].map(x => Math.round(x).toString(16).padStart(2, '0')).join('');
  }
  function lerpColor(c1: string, c2: string, t: number) {
    try {
      const r1 = hexToRgb(c1), r2 = hexToRgb(c2);
      return rgbToHex(lerp(r1[0], r2[0], t), lerp(r1[1], r2[1], t), lerp(r1[2], r2[2], t));
    } catch { return c1; }
  }

  function lerpLayerFX(a: LayerFX, b: LayerFX, t: number): LayerFX {
    return {
      color:   lerpColor(a.color, b.color, t),
      opacity: lerp(a.opacity ?? 100, b.opacity ?? 100, t),
      blend:   t < 0.5 ? a.blend : b.blend,
      bloom:   lerp(a.bloom, b.bloom, t),
      bleed:   lerp(a.bleed, b.bleed, t),
      blur:    lerp(a.blur, b.blur, t),
      halftone: lerp(a.halftone ?? 0, b.halftone ?? 0, t),
      angle:   lerp(a.angle ?? 0, b.angle ?? 0, t),
      htSize:  lerp(a.htSize ?? 8, b.htSize ?? 8, t),
      htHard:  lerp(a.htHard ?? 40, b.htHard ?? 40, t),
      offsetX: lerp(a.offsetX ?? 0, b.offsetX ?? 0, t),
      offsetY: lerp(a.offsetY ?? 0, b.offsetY ?? 0, t),
    };
  }

  function interpolate(time: number): Keyframe {
    const kfs = [...activePreset.keyframes].sort((a, b) => a.time - b.time);
    if (kfs.length === 0) return kfs[0];
    if (time <= kfs[0].time) return kfs[0];
    if (time >= kfs[kfs.length - 1].time) return kfs[kfs.length - 1];

    let prev = kfs[0], next = kfs[1];
    for (let i = 0; i < kfs.length - 1; i++) {
      if (time >= kfs[i].time && time <= kfs[i + 1].time) {
        prev = kfs[i]; next = kfs[i + 1]; break;
      }
    }
    const span = next.time - prev.time;
    const factor = span === 0 ? 0 : (time - prev.time) / span;

    return {
      time,
      bgColor:        lerpColor(prev.bgColor, next.bgColor, factor),
      bgOpacity:      lerp(prev.bgOpacity, next.bgOpacity, factor),
      subColor:       lerpColor(prev.subColor, next.subColor, factor),
      subOpacity:     lerp(prev.subOpacity ?? 100, next.subOpacity ?? 100, factor),
      cian:           lerpLayerFX(prev.cian, next.cian, factor),
      yellow:         lerpLayerFX(prev.yellow, next.yellow, factor),
      magenta:        lerpLayerFX(prev.magenta, next.magenta, factor),
      crtOpacity:     lerp(prev.crtOpacity, next.crtOpacity, factor),
      crtSize:        lerp(prev.crtSize, next.crtSize, factor),
      scanlineOpacity:lerp(prev.scanlineOpacity, next.scanlineOpacity, factor),
      paperOpacity:   lerp(prev.paperOpacity, next.paperOpacity, factor),
      paperType:      factor < 0.5 ? prev.paperType : next.paperType,
      paperScale:     lerp(prev.paperScale, next.paperScale, factor),
      noiseOpacity:   lerp(prev.noiseOpacity ?? 0, next.noiseOpacity ?? 0, factor),
      noiseScale:     lerp(prev.noiseScale ?? 0.65, next.noiseScale ?? 0.65, factor),
    };
  }

  // ─── HALFTONE ─────────────────────────────────────────────────────────────
  function applyHalftone(wrapperEl: HTMLElement, fx: LayerFX) {
    const dotsEl = wrapperEl.firstElementChild as HTMLElement | null;
    const isDark = ['screen', 'plus-lighter', 'color-dodge', 'lighten'].includes(fx.blend);
    wrapperEl.style.backgroundColor = isDark ? 'black' : 'white';

    const contrast = Math.max(1, Math.round((fx.halftone ?? 0) / 100 * 50));
    wrapperEl.style.filter = `contrast(${contrast})`;
    wrapperEl.style.opacity = '1';

    if (!dotsEl) return;
    const sz = Math.max(3, Math.round(fx.htSize ?? 8));
    const stop1 = Math.max(5, Math.min(85, fx.htHard ?? 30));
    const stop2 = Math.min(100, stop1 + 25);
    dotsEl.style.backgroundSize = `${sz}px ${sz}px`;
    dotsEl.style.backgroundImage = `radial-gradient(circle, ${fx.color} ${stop1}%, transparent ${stop2}%)`;
    const offset = ((( fx.angle ?? 0) / 360) * sz).toFixed(2);
    dotsEl.style.backgroundPosition = `${offset}px ${offset}px`;
    const blur = fx.blur ?? 0;
    dotsEl.style.filter = blur > 0 ? `blur(${blur}px)` : 'none';
  }

  // ─── RENDER ───────────────────────────────────────────────────────────────
  function cubicEaseIn(p: number) { return Math.pow(p, 2.5); }

  function render(state: Keyframe, t: number) {
    // Background
    canvas.style.backgroundColor = state.bgColor;
    (canvas as HTMLElement).style.opacity = `${(state.bgOpacity ?? 100) / 100}`;

    // Paper
    const sc = Math.round(state.paperScale);
    paper.style.opacity = `${state.paperOpacity / 100}`;
    if (state.paperType === 'halftone') {
      paper.style.backgroundImage = `radial-gradient(#000 15%,transparent 16%),radial-gradient(#000 15%,transparent 16%),repeating-linear-gradient(45deg,rgba(0,0,0,0.03) 0px,rgba(0,0,0,0.03) 2px,transparent 2px,transparent 6px)`;
      paper.style.backgroundSize = `${sc}px ${sc}px,${sc}px ${sc}px,8px 8px`;
      paper.style.backgroundPosition = `0 0,${sc/2}px ${sc/2}px,0 0`;
    } else if (state.paperType === 'riso') {
      paper.style.backgroundImage = `radial-gradient(rgba(40,10,20,0.2) 1px,transparent 0)`;
      paper.style.backgroundSize = `${sc}px ${sc}px`;
    } else if (state.paperType === 'satin') {
      paper.style.backgroundImage = `repeating-radial-gradient(circle at 50% 50%,rgba(0,0,0,0.05) 0,rgba(0,0,0,0.05) 1px,transparent 1px,transparent 4px)`;
      paper.style.backgroundSize = `${sc}px ${sc}px`;
    } else if (state.paperType === 'toner') {
      paper.style.backgroundImage = `radial-gradient(circle at 20% 20%,rgba(0,0,0,0.12) 1px,transparent 1px),radial-gradient(circle at 80% 70%,rgba(0,0,0,0.12) 1px,transparent 1px)`;
      paper.style.backgroundSize = `${sc}px ${sc}px,${sc+1}px ${sc+1}px`;
    }

    // CRT
    crtLayer.style.opacity = `${state.crtOpacity / 100}`;
    const csz = Math.round(state.crtSize);
    crtLayer.style.backgroundImage = `linear-gradient(90deg,rgba(255,0,0,0.8) 0px 1px,rgba(0,255,0,0.8) 1px 2px,rgba(0,0,255,0.8) 2px 3px,rgba(0,0,0,0.95) 3px ${csz}px),linear-gradient(0deg,rgba(0,0,0,0.4) 50%,rgba(255,255,255,0.05) 50%)`;
    crtLayer.style.backgroundSize = `${csz}px 100%,100% 4px`;
    scanline.style.opacity = `${state.scanlineOpacity / 100}`;

    // Noise
    noiseLayer.style.opacity = `${(state.noiseOpacity ?? 0) / 100}`;
    const turbulence = document.getElementById('grain-turbulence');
    if (turbulence) turbulence.setAttribute('baseFrequency', `${state.noiseScale ?? 0.65}`);
    noiseLayer.style.filter = (state.noiseOpacity ?? 0) > 0 ? 'url(#grain-filter)' : 'none';

    // Flight Y-positions
    let yC = 0, yY = 0, yM = 0, yS = 0, dScale = 1, dOp = (state.subOpacity ?? 100) / 100;
    if (t > 0.8) {
      const fp = Math.min(1, (t - 0.8) / 2.2);
      const ease = cubicEaseIn(fp);
      yC = -135 * ease; yY = -200 * ease; yM = -165 * ease;
      yS = -90  * ease;
      dScale = Math.max(0, 1 - ease * 1.2);
      dOp = Math.max(0, ((state.subOpacity ?? 100) / 100) - ease * 1.5);
    }

    // SVG bleed
    document.getElementById('disp-cian')?.setAttribute('scale', `${state.cian.bleed}`);
    document.getElementById('disp-yellow')?.setAttribute('scale', `${state.yellow.bleed}`);
    document.getElementById('disp-magenta')?.setAttribute('scale', `${state.magenta.bleed}`);

    // Halftones
    applyHalftone(lCianHt, state.cian);
    applyHalftone(lYellowHt, state.yellow);
    applyHalftone(lMagentaHt, state.magenta);

    // Layer Cian
    lCian.style.color   = state.cian.color;
    lCian.style.opacity = `${(state.cian.opacity ?? 100) / 100}`;
    lCian.style.mixBlendMode = state.cian.blend;
    lCian.style.transform = `translate3d(${state.cian.offsetX ?? 0}px,calc(${yC}vh + ${state.cian.offsetY ?? 0}px),0)`;
    {
      const bloom = state.cian.bloom > 0 ? `drop-shadow(0 0 ${state.cian.bloom}px ${state.cian.color})` : '';
      const bleed = state.cian.bleed > 0 ? 'url(#bleed-cian)' : '';
      lCian.style.filter = [bloom, bleed].filter(Boolean).join(' ') || 'none';
    }

    // Layer Yellow
    lYellow.style.color   = state.yellow.color;
    lYellow.style.opacity = `${(state.yellow.opacity ?? 100) / 100}`;
    lYellow.style.mixBlendMode = state.yellow.blend;
    lYellow.style.transform = `translate3d(${state.yellow.offsetX ?? 0}px,calc(${yY}vh + ${state.yellow.offsetY ?? 0}px),0)`;
    {
      const bloom = state.yellow.bloom > 0 ? `drop-shadow(0 0 ${state.yellow.bloom}px ${state.yellow.color})` : '';
      const bleed = state.yellow.bleed > 0 ? 'url(#bleed-yellow)' : '';
      lYellow.style.filter = [bloom, bleed].filter(Boolean).join(' ') || 'none';
    }

    // Layer Magenta
    lMagenta.style.color   = state.magenta.color;
    lMagenta.style.opacity = `${(state.magenta.opacity ?? 100) / 100}`;
    lMagenta.style.mixBlendMode = state.magenta.blend;
    lMagenta.style.transform = `translate3d(${state.magenta.offsetX ?? 0}px,calc(${yM}vh + ${state.magenta.offsetY ?? 0}px),0)`;
    {
      const bloom = state.magenta.bloom > 0 ? `drop-shadow(0 0 ${state.magenta.bloom}px ${state.magenta.color})` : '';
      const bleed = state.magenta.bleed > 0 ? 'url(#bleed-magenta)' : '';
      lMagenta.style.filter = [bloom, bleed].filter(Boolean).join(' ') || 'none';
    }

    // Divider
    divider.style.backgroundColor = state.subColor;
    (divider as HTMLElement).style.transform = `scaleX(${dScale})`;
    (divider as HTMLElement).style.opacity = `${dOp}`;

    // Subtitle words
    document.querySelectorAll('.pv-word').forEach((w, idx) => {
      const el = w as HTMLElement;
      el.style.color = state.subColor;
      let wy = yS;
      if (t > 0.8 + idx * 0.15) {
        const wp = Math.min(1, (t - (0.8 + idx * 0.15)) / 2.2);
        wy = -90 * cubicEaseIn(wp);
      } else if (t <= 0.8 + idx * 0.15) {
        wy = 0;
      }
      el.style.transform = `translate3d(0,${wy}vh,0)`;
      el.style.opacity = wy < -80 ? '0' : `${(state.subOpacity ?? 100) / 100}`;
    });

    // HUD
    tcEl.textContent = `${t.toFixed(2)}s`;
    progressEl.style.width = `${(t / MAX_TIME) * 100}%`;
  }

  // ─── SEEK / PLAY ──────────────────────────────────────────────────────────
  function seek(t: number) {
    currentTime = Math.max(0, Math.min(MAX_TIME, t));
    render(interpolate(currentTime), currentTime);
  }

  function togglePlay() {
    isPlaying = !isPlaying;
    iconPlay.classList.toggle('hidden', isPlaying);
    iconPause.classList.toggle('hidden', !isPlaying);
    if (isPlaying) {
      lastTS = performance.now();
      rafId = requestAnimationFrame(loop);
    } else {
      if (rafId) cancelAnimationFrame(rafId);
    }
  }

  function loop(ts: number) {
    if (!isPlaying) return;
    if (lastTS === null) lastTS = ts;
    currentTime += (ts - lastTS) / 1000;
    lastTS = ts;
    if (currentTime >= MAX_TIME) currentTime = 0; // loop
    seek(currentTime);
    rafId = requestAnimationFrame(loop);
  }

  playBtn.addEventListener('click', togglePlay);
  document.addEventListener('keydown', e => {
    if (e.code === 'Space' && !['INPUT','SELECT','TEXTAREA'].includes((document.activeElement?.tagName || ''))) {
      e.preventDefault();
      togglePlay();
    }
  });

  // Track scrubbing
  trackEl.addEventListener('click', e => {
    const rect = trackEl.getBoundingClientRect();
    const ratio = (e.clientX - rect.left) / rect.width;
    seek(ratio * MAX_TIME);
  });

  // Init
  seek(0);
  // Auto-play after a tick
  setTimeout(togglePlay, 100);
</script>
