---
import Layout from '../layouts/Layout.astro';
import SideMenu from '../components/SideMenu.astro';
import MenuItem from '../components/MenuItem.astro';

// Dynamic fetching from Google Sheets tab: "Página de Información"
const SHEET_ID = '1buzisIlDkCo2Rj5BYZh5-JKrAYSo3RSuBXYmJVGYT0E';
const sheetName = encodeURIComponent('Página de Información');
const INFO_SHEET_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${sheetName}`;

let sectionsData = [];

// Static fallbacks in case of fetch issues
const fallbackSections = [
  {
    id: "proyecto",
    title: "Proyecto",
    subtitle: "Antes de este proyecto ha habido mucha historia",
    items: [
      {
        title: "Memoria",
        paragraphs: [
          "No es hasta que nos vamos haciendo mayores que aparece el miedo a olvidar o a ser olvidados.",
          "En una época en la que vamos cada vez más rápido y las sensaciones son más volátiles, hemos decidido tomarnos nuestro tiempo para rescatar, catalogar y exhibir el patrimonio gráfico generado dentro de la cultura –musical– electrónica de nuestra provincia.",
          "Hay quien define la música como arte efímero. Quizá por eso, su representación gráfica también lo es.",
          "Queremos resignificar todos esos flyers que se repartieron en mano y los carteles que se pegaron en las calles, rescatándolos de sus cajas de zapatos y discos duros sulfatados.",
          "--------",
          "M.E.L. (Memoria Electrónica Leonesa) nace de una necesidad vital y urgente: rescatar, catalogar y preservar el patrimonio gráfico y sonoro de la cultura de club en León.",
          "Lo que durante décadas fue considerado arte efímero —flyers que se repartían en mano, carteles pegados en las calles y programaciones de salas míticas— es hoy un documento histórico indispensable para entender la evolución musical, social y del diseño gráfico de nuestra provincia. M.E.L. es el refugio digital donde toda esa memoria queda a salvo del olvido."
        ]
      },
      {
        title: "Electrónica",
        paragraphs: [
          "La música electrónica es más que un sonido: es un movimiento social, estético y tecnológico que ha transformado la noche leonesa. Desde los primeros colectivos autogestionados y las raves libres en el medio rural, hasta la consolidación de festivales y clubes míticos, León ha tenido siempre una vibrante corriente subterránea.",
          "El análisis de esta gráfica permite comprender cómo evolucionaron no solo los gustos musicales, sino las propias tecnologías de diseño y la estética de una época. M.E.L. no solo conserva imágenes; narra la transformación de una comunidad a través de su identidad visual."
        ]
      },
      {
        title: "Leonesa",
        paragraphs: [
          "La pertenencia a un territorio singular como León otorga una identidad propia al archivo. Buscamos documentar la escena clubbing y electrónica prestando especial atención a lo local y periférico, visibilizando lo que ocurrió más allá de las grandes metrópolis de la música de baile.",
          "Cada flyer, casete o fotografía recuperada es una pieza de un rompecabezas histórico colectivo. Es el testimonio gráfico de generaciones enteras que bailaron en templos como el Km 7.5, La Xana del Torío, Pop Art, Retrovisor o El Gran Café."
        ]
      }
    ]
  },
  {
    id: "equipo",
    title: "Equipo",
    subtitle: "Detrás de esta iniciativa hay dos leoneses unidos por el respeto al diseño y el amor a la música..",
    items: [
      {
        title: "Marcos Abella",
        photo: "/archive-1.png",
        paragraphs: [
          "Diseñador gráfico, coleccionista de vinilos e impresos, y selector musical leonés. Apasionado de la tipografía y de la historia gráfica de los clubes de la provincia."
        ]
      },
      {
        title: "Galo Franganillo",
        photo: "/archive-2.png",
        paragraphs: [
          "Historiador del arte, investigador de subculturas y agitador cultural. Dedicado a rescatar y poner en valor la memoria oral y visual de los movimientos underground leoneses."
        ]
      }
    ]
  },
  {
    id: "contacto",
    title: "Contacto",
    subtitle: "Puedes escribirnos a contacto@mel.org o a través del perfil de Instagram @mel.archivo",
    items: [
      {
        title: "Si tienes material que nos falta",
        paragraphs: [
          "Si guardas en casa flyers, carteles, fotografías de la época, entradas de clubs, fanzines o grabaciones de sesiones en formato físico o digital (entre 2004 y 2019), ponte en contacto con nosotros.",
          "Nosotros nos encargamos de la digitalización profesional de tu material sin alterar los originales, los cuales te serán devueltos intactos, pasando a formar parte de este archivo colectivo."
        ]
      },
      {
        title: "Si quieres apoyar el trabajo que hacemos",
        paragraphs: [
          "Puedes colaborar compartiendo el proyecto en tus redes, aportando datos que falten en los eventos publicados (como nombres de DJs, fechas o localizaciones exactas) o patrocinando la digitalización y el mantenimiento del servidor para garantizar que este archivo siga siendo de acceso libre y gratuito."
        ]
      },
      {
        title: "Si puedes aportar de otra forma",
        paragraphs: [
          "Estamos abiertos a propuestas de colaboración con instituciones culturales, comisariado de exposiciones físicas de cartelería, charlas de divulgación, proyectos de investigación universitaria o sinergias con otros archivos e investigadores de la cultura musical nacional."
        ]
      }
    ]
  }
];

// The info tab is a mini-CMS. Every column drives the page:
//  A "Nombre de sección"  -> one <section> per distinct name (fully dynamic:
//                           add a row with a new section name in the sheet
//                           and it appears on the page, no code change)
//  B "Orden de Sección"   -> section order (filled on the section's 1st row)
//  C "Tipo de módulo"     -> "Párrafo" (section subtitle) | "Acordeón" (item)
//  D "Título de módulo"   -> accordion title
//  E "Orden de módulo"    -> item order within its section
//  F "Imagen"             -> optional image URL shown inside the accordion
//  G "Contenido"          -> text (line breaks split paragraphs)
try {
  const response = await fetch(INFO_SHEET_URL);
  const text = await response.text();
  const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*?)\);/);

  if (match && match[1]) {
    const cleanJson = JSON.parse(match[1]);
    const rows = cleanJson.table.rows;
    const sectionsMap = {};

    rows.forEach(row => {
      const c = row.c;
      if (!c) return;

      const sectionName = c[0] ? String(c[0].v).trim() : '';
      if (!sectionName) return;

      const sectionOrder = c[1] && c[1].v != null ? Number(c[1].v) : null;
      const type = c[2] ? c[2].v : '';
      const moduleTitle = c[3] ? c[3].v : '';
      const moduleOrder = c[4] && c[4].v != null ? Number(c[4].v) : 999;
      const rawImage = c[5] && c[5].v ? String(c[5].v).trim() : '';
      // Google Drive share links can't load in an <img> directly — convert
      // them to the thumbnail endpoint (same trick as the event flyers).
      // Non-Drive URLs pass through untouched.
      let imageUrl = rawImage;
      if (rawImage.includes('drive.google.com')) {
        let fileId = '';
        if (rawImage.includes('id=')) fileId = rawImage.split('id=')[1].split('&')[0];
        else if (rawImage.includes('/d/')) fileId = rawImage.split('/d/')[1].split('/')[0];
        imageUrl = fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : rawImage;
      }
      const textVal = c[6] ? String(c[6].v) : '';

      if (!sectionsMap[sectionName]) {
        sectionsMap[sectionName] = {
          id: sectionName.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-"),
          title: sectionName,
          order: 999,
          subtitle: '',
          items: []
        };
      }
      const section = sectionsMap[sectionName];
      if (sectionOrder != null) section.order = sectionOrder;

      if (type === 'Párrafo' || type === 'Parrafo') {
        if (!section.subtitle) section.subtitle = textVal.trim();
      } else if (type === 'Acordeon' || type === 'Acordeón') {
        section.items.push({
          title: moduleTitle,
          order: moduleOrder,
          photo: imageUrl || null,
          paragraphs: textVal.split('\n').map(p => p.trim()).filter(p => p.length > 0)
        });
      }
    });

    sectionsData = Object.values(sectionsMap).sort((a: any, b: any) => a.order - b.order);
    sectionsData.forEach((s: any) => s.items.sort((a: any, b: any) => a.order - b.order));
  }
} catch (err) {
  console.error("Error loading info sheet:", err);
}

// Fallback if data is empty or fetch failed
if (sectionsData.length === 0) {
  sectionsData = fallbackSections;
}

// Turns plain sheet text into safe HTML where emails and @handles become
// links (mailto: / instagram profile) — so contact info typed straight into
// the sheet works as links without anyone touching code.
function escapeHtml(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
// Same style as Link.astro's default state (Body Roman Lora): serif font,
// text-secondary that turns action-primary on hover, with a scaleX(0->1)
// underline instead of the browser's native text-decoration. The font is
// set explicitly here (not inherited) since these links sit inline inside
// sans body text but must render in Lora regardless.
function linkify(s) {
  const wrap = (href, label, extraAttrs = '') =>
    `<a href="${href}" ${extraAttrs} class="group font-serif text-[16px] font-medium leading-[24px] tracking-[0.16px] text-mel-text-secondary hover:text-mel-action-primary transition-colors relative no-underline"><span class="relative inline-block text-inherit">${label}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span></span></a>`;
  return escapeHtml(s)
    .replace(/([\w.+-]+@[\w-]+\.[\w.-]*\w)/g, (_m, email) => wrap(`mailto:${email}`, email))
    .replace(/(^|\s)@([\w.]*\w)/g, (_m, pre, handle) => `${pre}${wrap(`https://instagram.com/${handle}`, `@${handle}`, 'target="_blank" rel="noopener"')}`);
}
---

<Layout title="Proyecto, Equipo y Contacto">
  <div class="w-full max-w-[1440px] min-h-screen mx-auto bg-mel-bg-primary px-6 sm:px-12 md:px-[108px] pb-16 flex flex-col items-center">
    
    <!-- Static Header matching the Page Header layout of home page (No blur, no
         opacity). pt-[calc(10vh-40px)] md:pt-[10vh] and the row layout mirror the home header exactly so
         the title/menu never shift between pages; on mobile the title collapses
         to "M.E.L." and the menu to its icon. -->
    <div class="w-full bg-mel-bg-primary shrink-0 sticky top-0 z-[190] border-b border-mel-border/30 pb-4 pt-[calc(10vh-40px)] lg:pt-[var(--mel-header-pt-desktop)]">
      <div class="flex items-center gap-4 lg:gap-6 w-full">
        <div class="flex-1 min-w-0 w-full">
          <!-- Static link back to homepage with identical styles -->
          <a href="/" class="flex items-center h-[48px] no-underline text-mel-text-primary hover:text-mel-action-primary transition-colors duration-200">
            <span class="font-sans font-bold text-[22px] leading-[28px] tracking-[-0.44px] whitespace-nowrap select-none">
              <span class="lg:hidden">M.E.L.</span><span class="hidden lg:inline">Memoria Electrónica Leonesa</span>
            </span>
          </a>
        </div>
        <div class="shrink-0 flex justify-end">
          <MenuItem id="menu-btn" />
        </div>
      </div>
    </div>

    <!-- Menú Sections body container (12-column layout, sections LEFT-aligned to cols 1-8).
         pt-[40px] matches the same 40px gap already used between modules further down (gap-[40px]
         on the sections column below) — the 80px tried before was double that, too much. -->
    <div class="w-full grid grid-cols-1 md:grid-cols-12 gap-6 pt-[40px] relative">
      <div class="col-span-12 md:col-span-8 flex flex-col gap-[40px] pb-[80px]">
        
        {sectionsData.map((section) => (
          <section id={section.id} data-info-section class="w-full scroll-mt-[180px] flex flex-col gap-6" data-node-id="606:39642">
            
            <!-- Section Title & Subtitle Header (subtitle comes straight from
                 the sheet; emails/@handles in it are auto-linked) -->
            <div class="flex flex-col gap-[16px]" data-node-id="590:91521">
              <h2 class="font-sans font-bold text-[40px] leading-[40px] tracking-[-1.6px] text-mel-text-primary">
                {section.title}
              </h2>
              {section.subtitle && (
                <p class="font-sans font-normal text-[17px] leading-[24px] tracking-[-0.17px] text-mel-text-primary" set:html={linkify(section.subtitle)} />
              )}
            </div>

            <!-- Accordion elements wrapper -->
            <div class="w-full flex flex-col overflow-hidden border border-mel-border/30" data-node-id="600:91873">
              {section.items.map((item, idx) => (
                <div 
                  class="accordion-item w-full relative flex flex-col transition-all duration-300"
                  data-open="false"
                  data-node-id="600:91782"
                >
                  <!-- Accordion Toggle Header Row -->
                  <button class="accordion-header w-full flex justify-between items-center text-left select-none cursor-pointer bg-transparent border-none outline-none group">
                    <span class="font-sans font-bold text-[20px] leading-[24px] tracking-[-0.8px] text-mel-text-primary transition-colors flex-1 overflow-hidden text-ellipsis">
                      {item.title}
                    </span>
                    
                    <div class="relative shrink-0 size-[40px] flex items-center justify-center text-mel-action-secondary transition-colors pointer-events-none">
                      <svg class="accordion-icon w-[24px] h-[24px] transition-transform duration-300 transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </div>
                  </button>

                  <!-- Accordion Expandable body -->
                  <div class="accordion-body grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
                    <div class="overflow-hidden">
                      <div class="content-start flex flex-wrap gap-[24px_32px] items-start pt-[16px] w-full">
                        {item.photo && (
                          // Same tint-overlay technique as EmptyState.astro (image behind, a
                          // mix-blend-screen tint layer on top) — this component's own scale
                          // (h-[320px]/w-[288px]) is kept as-is, only the tinting layer changed.
                          <div class="h-[320px] max-h-[320px] overflow-hidden relative shrink-0 w-[288px] rounded-sm select-none" data-node-id="600:91789">
                            <img src={item.photo} alt="" referrerpolicy="no-referrer" class="absolute inset-0 size-full object-cover pointer-events-none" />
                            <div class="absolute inset-0 bg-[var(--mel-primitive-le-900)] mix-blend-screen pointer-events-none"></div>
                          </div>
                        )}
                        <div class="flex-1 min-w-[280px] text-[17px] leading-[24px] tracking-[-0.17px] text-mel-text-primary font-sans font-normal">
                          {item.paragraphs.map((p) => (
                            <p class="mb-[16px] last:mb-0" set:html={linkify(p)} />
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Divider line inside the accordion element (not on the last item) -->
                  {idx < section.items.length - 1 && (
                    <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30 pointer-events-none"></div>
                  )}
                </div>
              ))}
            </div>

          </section>
        ))}

      </div>
    </div>

  </div>

  <!-- Incorporate global SideMenu for navigation -->
  <SideMenu />
</Layout>

<style>
  /* Accordion styling for padding, backgrounds, and hover transitions */
  .accordion-item[data-open="true"] {
    padding-top: 16px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 16px;
    background-color: #e9e0e2;
  }
  :global(.dark) .accordion-item[data-open="true"] {
    background-color: rgba(44, 29, 32, 0.8);
  }
  /* Chevron turns action-primary when hovering the header of an already-open
     accordion (the same click target that would close it). */
  .accordion-item[data-open="true"] .accordion-header:hover .accordion-icon {
    color: var(--mel-action-primary);
  }

  .accordion-item[data-open="false"] {
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 24px;
    padding-right: 16px;
    background-color: #e9e0e2;
    cursor: pointer;
  }
  :global(.dark) .accordion-item[data-open="false"] {
    background-color: rgba(44, 29, 32, 0.8);
  }
  
  .accordion-item[data-open="false"]:hover {
    background-color: #d4c4c7;
  }
  :global(.dark) .accordion-item[data-open="false"]:hover {
    background-color: rgba(61, 47, 50, 0.95);
  }
</style>

<script>
  function initInfoPage() {
    // 2. Setup manual accordion clicks
    document.querySelectorAll('.accordion-header').forEach(header => {
      header.addEventListener('click', () => {
        const item = header.closest('.accordion-item');
        if (!item) return;
        const body = item.querySelector('.accordion-body') as HTMLElement;
        const icon = item.querySelector('.accordion-icon') as HTMLElement;
        const isOpen = item.getAttribute('data-open') === 'true';

        if (isOpen) {
          body.style.gridTemplateRows = '0fr';
          item.setAttribute('data-open', 'false');
          icon.style.transform = 'rotate(0deg)';
        } else {
          body.style.gridTemplateRows = '1fr';
          item.setAttribute('data-open', 'true');
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });

    // 3. Setup dynamic anchor scroll and auto-accordion open logic
    function handleAnchorNavigation() {
      const hash = window.location.hash;
      if (!hash) return;
      
      const targetId = hash.substring(1);
      const targetSection = document.getElementById(targetId);
      
      if (targetSection) {
        // Scroll into view smoothly
        targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

        // Go through all (sheet-driven, dynamic) sections and expand
        // accordions inside the target section, collapse the others
        document.querySelectorAll('section[data-info-section]').forEach(sec => {
          const items = sec.querySelectorAll('.accordion-item');
          const shouldExpand = sec.id === targetId;

          items.forEach(item => {
            const body = item.querySelector('.accordion-body') as HTMLElement;
            const icon = item.querySelector('.accordion-icon') as HTMLElement;
            if (shouldExpand) {
              body.style.gridTemplateRows = '1fr';
              item.setAttribute('data-open', 'true');
              icon.style.transform = 'rotate(180deg)';
            } else {
              body.style.gridTemplateRows = '0fr';
              item.setAttribute('data-open', 'false');
              icon.style.transform = 'rotate(0deg)';
            }
          });
        });
      }
    }

    // Call on load and hash change
    setTimeout(handleAnchorNavigation, 150);
    window.addEventListener('hashchange', handleAnchorNavigation);
  }

  // Bind init function on page-load for View Transitions compatibility
  document.addEventListener('astro:page-load', initInfoPage);
</script>
