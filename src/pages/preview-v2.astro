---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MEL Preview V2">
  <!-- Clean Preview Stage Container -->
  <div id="v2-preview-stage" class="fixed inset-0 bg-[#f7f3f5] z-[300] flex items-center justify-center overflow-hidden select-none cursor-pointer">
    
    <!-- 1440x1024 Aspect Frame -->
    <div class="relative w-full max-w-[1440px] h-full max-h-[1024px] aspect-[1440/1024] flex flex-col justify-end p-[7.5%] pb-[140px] md:pb-[160px] z-30 pointer-events-none">
      
      <!-- Master Title Stage (Canvas 2D) -->
      <div id="lab-title-container" class="relative w-full h-[220px] md:h-[420px] isolate">
        <canvas id="cmyk-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
      </div>

      <!-- Line Divider (DOM) -->
      <div
        id="lab-divider"
        class="w-full h-[2px] bg-[#190609] my-[3.3%] opacity-100 scale-x-100 origin-left transition-transform duration-700 ease-out"
      ></div>

      <!-- Subtitle Container (DOM) -->
      <div
        id="lab-subtitle-container"
        class="flex items-center flex-wrap h-[48px] shrink-0 font-['Space_Grotesk'] font-normal text-[4.6vw] md:text-[38px] text-[#190609] tracking-[-0.04em] leading-[48px] relative w-full"
      >
        <!-- Subtitle words populated by JS -->
      </div>

    </div>
  </div>
</Layout>

<script>
  interface StudioSettings {
    chroma: number;
    halftone: number;
    bloom: number;
    noise: number;
    scanlines: number;
    glitch: number;
  }

  let currentSettings: StudioSettings = { chroma: 8, halftone: 35, bloom: 1.5, noise: 12, scanlines: 10, glitch: 0 };

  const saved = localStorage.getItem('mel_intro_v2_settings');
  if (saved) {
    try { currentSettings = { ...currentSettings, ...JSON.parse(saved) }; } catch(e) {}
  }

  const canvas = document.getElementById('cmyk-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
  const container = document.getElementById('lab-title-container')!;
  const subtitleContainer = document.getElementById('lab-subtitle-container')!;

  // Subtitle Setup
  const subtitleText = "A través del diseño gráfico";
  const words = subtitleText.split(' ');
  subtitleContainer.innerHTML = words.map((w, i) => `
    <span class="subtitle-word inline-block opacity-0 translate-y-4 transition-all duration-500 ease-out mr-[0.3em]" style="transition-delay: ${i * 120 + 400}ms">
      ${w}
    </span>
  `).join('');

  function triggerSubtitleAnimation() {
    subtitleContainer.querySelectorAll('.subtitle-word').forEach(el => {
      el.classList.remove('opacity-0', 'translate-y-4');
    });
  }

  let startTime = performance.now();

  function resizeCanvas() {
    const rect = container.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  function drawTextLayer(
    layerCtx: CanvasRenderingContext2D,
    textLines: string[],
    color: string,
    offsetX: number,
    offsetY: number,
    progress: number,
    fontSize: number,
    lineHeight: number,
    htDensity: number
  ) {
    const dpr = window.devicePixelRatio || 1;
    const scaledFontSize = fontSize * dpr;
    const scaledLineHeight = lineHeight * dpr;

    layerCtx.save();
    layerCtx.font = `bold ${scaledFontSize}px "Space Grotesk", sans-serif`;
    layerCtx.letterSpacing = `${-8 * dpr}px`;
    layerCtx.textAlign = 'left';
    layerCtx.textBaseline = 'top';

    const startY = (1 - progress) * (scaledFontSize * 0.8);

    textLines.forEach((line, idx) => {
      const y = idx * scaledLineHeight + startY + (offsetY * dpr);
      const x = offsetX * dpr;

      layerCtx.fillStyle = color;
      layerCtx.fillText(line, x, y);

      if (line.includes("Leonesa")) {
        const textWidth = layerCtx.measureText("Leonesa").width;
        layerCtx.save();
        layerCtx.font = `bold ${scaledFontSize * 0.4}px "Space Grotesk", sans-serif`;
        layerCtx.fillText("®", x + textWidth + (10 * dpr), y);
        layerCtx.restore();
      }
    });

    if (htDensity > 0) {
      layerCtx.globalCompositeOperation = 'destination-out';
      const patternCanvas = document.createElement('canvas');
      const patternSize = Math.max(4, Math.floor(12 - (htDensity / 10))) * dpr;
      patternCanvas.width = patternSize;
      patternCanvas.height = patternSize;
      const pCtx = patternCanvas.getContext('2d')!;
      pCtx.fillStyle = '#000000';
      pCtx.beginPath();
      pCtx.arc(patternSize / 2, patternSize / 2, patternSize * 0.35 * (htDensity / 100), 0, Math.PI * 2);
      pCtx.fill();

      const pattern = layerCtx.createPattern(patternCanvas, 'repeat');
      if (pattern) {
        layerCtx.fillStyle = pattern;
        layerCtx.fillRect(0, 0, layerCtx.canvas.width, layerCtx.canvas.height);
      }
    }

    layerCtx.restore();
  }

  function render() {
    requestAnimationFrame(render);
    const now = performance.now();
    const elapsed = (now - startTime) / 1000;
    
    const animDuration = 2.1;
    const rawProgress = Math.min(1, elapsed / animDuration);
    const progress = Math.pow(rawProgress, 2.5);

    if (rawProgress >= 0.3) {
      triggerSubtitleAnimation();
    }

    const width = canvas.width;
    const height = canvas.height;
    const dpr = window.devicePixelRatio || 1;

    ctx.clearRect(0, 0, width, height);

    const isMobile = window.innerWidth < 768;
    const fontSize = isMobile ? window.innerWidth * 0.138 : 190;
    const lineHeight = fontSize * 0.82;
    const lines = ["Memoria", "Electrónica", "Leonesa"];

    const chroma = currentSettings.chroma;
    const bloom = currentSettings.bloom;
    const glitch = currentSettings.glitch;

    let glitchX = 0;
    if (glitch > 0 && Math.random() < (glitch / 100) * 0.3) {
      glitchX = (Math.random() - 0.5) * 20;
    }

    // CIAN
    const cianCanvas = document.createElement('canvas');
    cianCanvas.width = width; cianCanvas.height = height;
    const cianCtx = cianCanvas.getContext('2d')!;
    drawTextLayer(cianCtx, lines, '#00ffff', glitchX, 0, progress, fontSize, lineHeight, currentSettings.halftone);

    // YELLOW
    const yellowCanvas = document.createElement('canvas');
    yellowCanvas.width = width; yellowCanvas.height = height;
    const yellowCtx = yellowCanvas.getContext('2d')!;
    const yellowX = glitchX - (chroma * 1.5 * progress);
    const yellowY = -(chroma * 0.8 * progress);
    drawTextLayer(yellowCtx, lines, '#ffff00', yellowX, yellowY, progress, fontSize, lineHeight, currentSettings.halftone);

    // MAGENTA
    const magentaCanvas = document.createElement('canvas');
    magentaCanvas.width = width; magentaCanvas.height = height;
    const magentaCtx = magentaCanvas.getContext('2d')!;
    const magentaX = glitchX + (chroma * 0.8 * progress);
    const magentaY = -(chroma * 0.4 * progress);
    drawTextLayer(magentaCtx, lines, '#ff00ff', magentaX, magentaY, progress, fontSize, lineHeight, currentSettings.halftone);

    // Composite
    ctx.save();
    ctx.globalCompositeOperation = 'multiply';
    ctx.drawImage(cianCanvas, 0, 0);
    ctx.drawImage(yellowCanvas, 0, 0);
    ctx.drawImage(magentaCanvas, 0, 0);
    ctx.restore();

    // Bloom
    if (bloom > 0) {
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.filter = `blur(${bloom * dpr}px)`;
      ctx.globalAlpha = 0.3;
      ctx.drawImage(cianCanvas, 0, 0);
      ctx.drawImage(magentaCanvas, 0, 0);
      ctx.restore();
    }

    // Noise & Scanlines
    const noise = currentSettings.noise;
    const scanlines = currentSettings.scanlines;

    if (noise > 0 || scanlines > 0) {
      ctx.save();
      if (scanlines > 0) {
        ctx.fillStyle = `rgba(0, 0, 0, ${ (scanlines / 100) * 0.15 })`;
        for (let y = 0; y < height; y += 4 * dpr) {
          ctx.fillRect(0, y, width, 2 * dpr);
        }
      }
      if (noise > 0) {
        const imgData = ctx.getImageData(0, 0, width, height);
        const data = imgData.data;
        const amount = (noise / 100) * 25;
        for (let i = 0; i < data.length; i += 16) {
          const n = (Math.random() - 0.5) * amount;
          data[i] = Math.min(255, Math.max(0, data[i] + n));
          data[i+1] = Math.min(255, Math.max(0, data[i+1] + n));
          data[i+2] = Math.min(255, Math.max(0, data[i+2] + n));
        }
        ctx.putImageData(imgData, 0, 0);
      }
      ctx.restore();
    }
  }

  requestAnimationFrame(render);

  // Click stage to replay
  document.getElementById('v2-preview-stage')?.addEventListener('click', () => {
    startTime = performance.now();
    subtitleContainer.querySelectorAll('.subtitle-word').forEach(el => {
      el.classList.add('opacity-0', 'translate-y-4');
    });
  });
</script>
