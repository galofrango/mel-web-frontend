---
import Layout from '../layouts/Layout.astro';
import HeaderSimple from '../components/HeaderSimple.astro';
import SideMenu from '../components/SideMenu.astro';
import EmptyState from '../components/EmptyState.astro';

// Página de error 404 (Figma 1073:114391). Deliberadamente mínima: solo la
// cabecera y el menú, sin toolbar, sin slider ni vistas — quien llega aquí no ha
// pedido explorar el archivo, se ha topado con una dirección que no existe, así
// que lo único útil es reconocerlo y ofrecer la vuelta al inicio.
//
// El estado se fija a mano porque a esta página también se llega por `rewrite`
// desde /event/[id] cuando el identificador no existe, y un rewrite conserva el
// 200 de la ruta original: sin esto, un enlace roto respondería "todo correcto"
// a buscadores y clientes mientras enseña un 404 por pantalla.
Astro.response.status = 404;
---

<Layout title="404">
  <div class="w-full max-w-[1440px] min-h-dvh mx-auto bg-mel-bg-primary px-6 sm:px-12 lg:px-[108px] pb-16 flex flex-col items-center">

    <!-- Cabecera idéntica a la del resto de páginas (mismo pt, misma fila, mismo
         colapso a "M.E.L." + icono en móvil): al aterrizar aquí desde cualquier
         sitio, el título y el menú no se mueven de su posición. -->
    <HeaderSimple />

    <!-- Estado vacío 404: mismo componente que el resto del sitio, solo cambia
         la variante (foto, textos y destino del botón viven en EmptyState). -->
    <div class="flex-1 flex flex-col items-center justify-center pt-[80px] pb-[100px] w-full">
      <EmptyState variant="404" />
    </div>

  </div>

  <SideMenu />
</Layout>
