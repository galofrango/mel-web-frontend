---
import Layout from '../../layouts/Layout.astro';
import TagWithLink from '../../components/TagWithLink.astro';
import Link from '../../components/Link.astro';
import PaginationDot from '../../components/PaginationDot.astro';
import BotonCompartir from '../../components/BotonCompartir.astro';
import Whisper from '../../components/Whisper.astro';
import IconButton from '../../components/IconButton.astro';
import AdaptiveTagsRow from '../../components/AdaptiveTagsRow.astro';
import { fetchEvents, extractDriveImage, srcSetDrive, formatFechaDMY } from '../../lib/mel';
import flyerTecnico from '../../data/flyer_tecnico.json';

// SSR route (server-rendered per request, see astro.config.mjs) — reads the
// sheet fresh on every visit instead of baking it in at build time, so new
// events/edits show up without a rebuild. Fetches + groups the full list
// (not just the one event) because Anterior/Siguiente need their neighbors.
// La ficha necesita la lista COMPLETA, no solo su evento: Anterior/Siguiente
// necesitan a los vecinos. Sale ya agrupada y en orden cronológico.
const eventsList = await fetchEvents();

const eventIndex = eventsList.findIndex((e: any) => e.idMel === Astro.params.id);
if (eventIndex === -1) {
  // Un enlace roto a un evento va al 404, no de vuelta al inicio: devolver a la
  // home en silencio dejaba al visitante creyendo que había pulsado mal. Se usa
  // `rewrite` y no `redirect` para conservar la URL fallida a la vista (y el
  // código 404 real, que lo fija la propia página).
  return Astro.rewrite('/404');
}

// Caché de CDN, 5 minutos + servir-viejo-mientras-renueva (D-258). La
// explicación completa está sobre la cabecera gemela de index.astro; si se
// toca una, las tres (aquí, la home e info). DESPUÉS del rewrite al 404 a
// propósito: un enlace roto no debe dejar un "no existe" cacheado 5 minutos —
// justo el plazo en el que un evento recién añadido a la hoja aún puede no
// existir para la CDN.
// `max-age=60` (D-259): imprescindible para que el prefetch de las tarjetas
// sirva de algo — la explicación, sobre la cabecera gemela de index.astro.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=600');

// Nombres en inglés para el resto de la plantilla de esta página, que es la que
// ya los usaba. El mapeo va aquí y no en el módulo compartido a propósito: la
// home los quiere en español y renombrar su mitad sería un diff enorme en
// index.astro por un beneficio nulo. Lo que importaba —el fetch, el parseo, el
// mapa de columnas y el agrupado— ya es común.
const evento = (e: any) => ({
  idMel: e.idMel,
  title: e.evento,
  // formatFechaDMY reordena si viene en ISO y antepone el cero al día
  // (D-216) — se saltaba aquí porque la ficha nunca pasaba `fecha` por esa
  // función, a diferencia de la home/lista, que sí.
  date: formatFechaDMY(e.fecha),
  location: e.lugar,
  locality: e.localidad,
  description: e.descripcion,
  artists: e.artistas,
  organizer: e.organiza,
  designer: e.disenador,
  carruselItems: e.carruselItems,
  // OJO: este objeto se construye con una lista EXPLÍCITA de campos, así que un
  // campo nuevo de `fetchEvents()` no llega solo — hay que añadirlo aquí. Se
  // olvidó al estrenar `carruselVisibles` y la ficha reventó en producción con
  // un `Cannot read properties of undefined (reading 'map')`. El respaldo a
  // `carruselItems` es el mismo criterio que `visiblesDelCarrusel`: ante un dato
  // que falta, degradar a lo de siempre y no a una página en blanco.
  carruselVisibles: e.carruselVisibles ?? e.carruselItems,
});

const eventData = evento(eventsList[eventIndex]);
const prevEvent = eventIndex > 0 ? evento(eventsList[eventIndex - 1]) : null;
const nextEvent = eventIndex < eventsList.length - 1 ? evento(eventsList[eventIndex + 1]) : null;

// Lista completa para el filtrado de búsqueda en cliente.
//
// `fotoUrl` va ya resuelta desde aquí, y no es un extra: `adelantarVecino()`
// —la precarga de vecinos de D-090— llamaba a `extractDriveImage()` dentro del
// script de cliente, donde esa función NO existe (vive en este frontmatter, que
// corre en el servidor). No reventaba por casualidad: `allEvents` tampoco
// llevaba `carruselItems`, así que su guarda `if (foto)` nunca se cumplía y la
// llamada no se ejecutaba jamás. O sea que la mitad que precargaba LA FOTO
// —según su propio comentario, "lo único que se ve tardar"— no ha funcionado
// nunca. Resolviéndola en el servidor no hace falta ninguna copia cliente de la
// función, y el cliente solo tiene que leer una cadena.
//
// Aquí se llega hasta 2000: es UNA imagen, no 32 como en la galería, así que el
// coste de servir la grande solo a quien la aprovecha es asumible (medido el
// 04/08/2026: 161 KB de media a w1000, 421 KB a w2000). La caja de la ficha son
// 496 px CSS en escritorio y el ancho completo en móvil; el visor, unos 684.
// Van antes de `allEvents` porque la precarga de vecinos también los usa.
const ANCHOS_FICHA = [1000, 1400, 2000];
const TAMANOS_FICHA = '(min-width: 1024px) 496px, 100vw';
const TAMANOS_VISOR = '(min-width: 1024px) 684px, 92vw';

const allEvents = eventsList.map((e: any) => ({
  idMel: e.idMel,
  title: e.evento,
  location: e.lugar || '',
  locality: e.localidad || '',
  artists: e.artistas || '',
  organizer: e.organiza || '',
  designer: e.disenador || '',
  // La primera que enseña la ficha del vecino (`carruselVisibles`, como su
  // carrusel), con el mismo srcset: si la precarga pide otra URL que la que
  // luego elige la ficha, se descarga dos veces (D-296).
  fotoUrl: extractDriveImage((e.carruselVisibles?.[0] ?? e.carruselItems?.[0])?.urlDrive) || '',
  fotoSrcset: srcSetDrive((e.carruselVisibles?.[0] ?? e.carruselItems?.[0])?.urlDrive, ANCHOS_FICHA),
}));

// `carruselVisibles`, no `carruselItems`: deja fuera lo que está en el archivo
// pero no es una pieza que enseñar (hoy, el fotograma extraído de un GIF, que
// hace de portada ligera — ver `visiblesDelCarrusel` en mel.ts). La PORTADA
// sigue saliendo de `carruselItems[0]`, unas líneas más arriba.
const imageUrls = eventData.carruselVisibles.map(i => extractDriveImage(i.urlDrive)).filter(Boolean);
const imageSrcsets = eventData.carruselVisibles.map(i => srcSetDrive(i.urlDrive, ANCHOS_FICHA));

// Dimensiones reales de cada cartel, medidas offline por
// `scripts/medir-archivo.mjs`. Sirven para dar a la caja de imagen el alto que
// de verdad necesita en vez de 360px fijos, y para no ampliar nunca una imagen
// por encima de su tamaño real.
//
// Tienen que venir del servidor, no medirse en el navegador: medir en cliente
// significa pintar primero con un alto provisional y corregirlo después, que es
// exactamente el salto que esto viene a quitar.
//
// Si un cartel no está en el fichero —recién subido, sin volver a pasar el
// script— no se emite nada y el CSS se queda con el `h-[360px]` de siempre. Es a
// propósito: lo desconocido se comporta como hoy y no puede empeorar nada.
const idDeDrive = (url?: string) => {
  if (!url) return '';
  if (url.includes('id=')) return url.split('id=')[1].split('&')[0];
  if (url.includes('/d/')) return url.split('/d/')[1].split('/')[0];
  return '';
};
// La misma lista que `imageUrls`, y no `carruselItems`: si la caja se midiera
// con una imagen que no se llega a enseñar, se dimensionaría para algo que no
// está ahí.
const medidas = eventData.carruselVisibles
  .map((i: any) => flyerTecnico[idDeDrive(i.urlDrive)]?.px)
  .filter((d: any): d is [number, number] => Array.isArray(d) && d[0] > 0 && d[1] > 0);

// La MÁS ALTA manda, y ese es el punto: si la caja se ajustara a cada imagen,
// pasar de una a otra daría un salto. Con la más alta, las demás quedan con aire
// arriba y abajo y la caja no se mueve nunca.
// "Más alta" = mayor alto A IGUALDAD DE ANCHO, o sea la de menor proporción.
const masAlta = medidas.length
  ? medidas.reduce((a, b) => (a[0] / a[1] <= b[0] / b[1] ? a : b))
  : null;

// Centinelas con los que la hoja marca "aquí no hay dato". Los cuatro reciben
// el mismo trato (D-097): el término NO se pinta, se sustituye por la
// invitación a colaborar de abajo. Ojo, la vista Lista de index.astro sí los
// sigue pintando inertes (`celdaSinDato`) — ahí son decenas de filas y repetir
// la llamada la convertiría en ruido de fondo.
const CENTINELAS_SIN_DATO = ['desconocido', 'sin fecha', 'no detallados', 'varios'];

// Enlace de colaboración con el que se SUSTITUYE el valor cuando no hay dato.
// Antes se pintaba "Desconocido" inerte, que ocupa un renglón para no decir
// nada; ahora ese mismo renglón invita a rellenarlo. Al ocupar el sitio del
// valor en lugar de añadirse debajo, sirve para todas las tags sin que ninguna
// crezca de alto.
const AYUDA_TEXTO = '¿Nos ayudas?';
const AYUDA_HREF = '/info#contacto';

function getTagDisplay(val) {
  const clean = val ? String(val).trim() : '';
  const bajo = clean.toLowerCase();
  if (!clean || CENTINELAS_SIN_DATO.includes(bajo)) {
    return { text: AYUDA_TEXTO, href: AYUDA_HREF };
  }
  return { text: clean, href: undefined };
}

const dateDisplay = getTagDisplay(eventData.date);
const locationDisplay = getTagDisplay(eventData.location);
const localityDisplay = getTagDisplay(eventData.locality);
const designerDisplay = getTagDisplay(eventData.designer);

// Los promotores pueden venir varios en la misma celda, separados por comas
// (D-218) — igual que los artistas. Cada uno busca el suyo, no la cadena
// completa: antes "Ravers 7.5, Colectivo X" era un único enlace que no
// encontraba nada porque esa cadena literal no coincide con ningún evento.
const nombresPromotores = (eventData.organizer || '')
  .split(/,+/)
  .map(o => o.trim())
  .filter(Boolean);
const sinPromotor = !nombresPromotores.length
  || nombresPromotores.every(n => CENTINELAS_SIN_DATO.includes(n.toLowerCase()));
const PROMOTORES = sinPromotor
  ? [{ texto: AYUDA_TEXTO, href: AYUDA_HREF, ariaLabel: `${AYUDA_TEXTO} Falta el dato de organiza` }]
  : nombresPromotores.map(nombre => {
      // "Varios"/"No detallados" sueltos entre nombres reales se muestran
      // tal cual, sin enlace — igual que en cualquier otra tag (D-064).
      const esCentinela = CENTINELAS_SIN_DATO.includes(nombre.toLowerCase());
      return { texto: nombre, href: esCentinela ? undefined : `/?search=${encodeURIComponent(nombre)}` };
    });

// Las tags se definen UNA vez y se pintan dos veces: la fila horizontal de
// móvil/tablet y la columna de escritorio. Antes eran dos listas paralelas
// escritas a mano, que es justo donde se cuelan las divergencias. "Organiza"
// se construye aparte porque puede llevar varios enlaces (multi), no uno.
const TAGS_EVENTO = [
  { label: 'Fecha',     display: dateDisplay,      buscar: null },
  { label: 'Lugar',     display: locationDisplay,  buscar: `/?view=mapa&location=${encodeURIComponent(eventData.location)}` },
  { label: 'Localidad', display: localityDisplay,  buscar: `/?search=${encodeURIComponent(eventData.locality)}` },
  { label: 'Diseño',    display: designerDisplay,  buscar: `/?search=${encodeURIComponent(eventData.designer)}` },
].map(t => ({
  label: t.label,
  count: t.display.text,
  href: t.display.href ?? t.buscar,
  // Cinco invitaciones con el mismo texto son cinco entradas idénticas en el
  // listado de enlaces de un lector de pantalla. El campo que falta va en el
  // nombre accesible, no solo en la etiqueta visual de al lado.
  ariaLabel: t.display.href ? `${AYUDA_TEXTO} Falta el dato de ${t.label.toLowerCase()}` : undefined,
  // "¿Nos ayudas?" ya en action-primary en reposo (D-217), para que destaque
  // como invitación en vez de leerse como un dato más.
  state: t.display.href ? 'Primary' : undefined,
}));
TAGS_EVENTO.splice(3, 0, {
  label: 'Organiza',
  multi: PROMOTORES,
  state: sinPromotor ? 'Primary' : 'Default',
});

// Los artistas se pintan como lista de enlaces. Campo vacío y campo con
// centinela son el mismo hueco, así que reciben el mismo trato: el bloque NO se
// oculta —en un archivo la laguna es información, «de este evento no sabemos
// quién pinchó»— y en lugar del nombre aparece la invitación. Un vacío se
// representa como una única entrada, que sale de aquí igual que un
// "Desconocido".
const nombresArtistas = (eventData.artists || '')
  .split(/,+/)
  .map(a => a.trim())
  .filter(Boolean);
const ARTISTAS = (nombresArtistas.length ? nombresArtistas : ['']).map(nombre => {
  const sinDato = !nombre || CENTINELAS_SIN_DATO.includes(nombre.toLowerCase());
  return {
    texto: sinDato ? AYUDA_TEXTO : nombre,
    href: sinDato ? AYUDA_HREF : `/?search=${encodeURIComponent(nombre)}`,
    ariaLabel: sinDato ? `${AYUDA_TEXTO} Faltan los artistas` : undefined,
  };
});

// Vista previa al compartir el enlace de esta ficha (D-303). Texto: fecha,
// lugar y artistas (criterio del propietario), sin los huecos sin dato.
// WhatsApp corta hacia las dos líneas; Google, hacia los 160 caracteres. Se
// recorta en 200 y por un nombre entero (nunca «Israel…» de «Israel Alonso»).
const conDato = (v?: string) => {
  const t = (v || '').trim();
  return t && !CENTINELAS_SIN_DATO.includes(t.toLowerCase()) ? t : '';
};
const artistasConDato = nombresArtistas.filter(conDato);
let descripcionCompartir = [
  conDato(eventData.date),
  // Lugar y localidad, una sola vez si son lo mismo («Valdepiélago»).
  [...new Set([conDato(eventData.location), conDato(eventData.locality)].filter(Boolean))].join(', '),
  artistasConDato.join(', '),
].filter(Boolean).join(' · ');
if (descripcionCompartir.length > 200) {
  descripcionCompartir = descripcionCompartir.slice(0, 200).replace(/(,| ·) [^,·]*$/, '') + '…';
}
// Imagen: el primer cartel que enseña la ficha (el anverso), en JPEG de hasta
// 800 px al 75 %. WhatsApp no enseña la imagen si pasa de ~300 KB: medidas las
// 141 fichas (02/10/2026), así la más pesada son 293 KB (mediana 96); a 1200 px
// al 85 %, 28 pasaban de 300 y una llegaba a 785. Google no la amplía si el
// original es más estrecho: de ahí el `Math.min` para declarar su tamaño real.
const ANCHO_COMPARTIR = 800;
const portadaCompartir = eventData.carruselVisibles[0]?.urlDrive;
const urlCompartir = extractDriveImage(portadaCompartir, ANCHO_COMPARTIR, '-rj-l75');
const pxCompartir = flyerTecnico[idDeDrive(portadaCompartir)]?.px;
const pxValidos = Array.isArray(pxCompartir) && pxCompartir[0] > 0 && pxCompartir[1] > 0;
const anchoCompartir = pxValidos ? Math.min(ANCHO_COMPARTIR, pxCompartir[0]) : undefined;
const imagenCompartir = urlCompartir ? {
  url: urlCompartir,
  ancho: anchoCompartir,
  alto: anchoCompartir ? Math.round(pxCompartir[1] * anchoCompartir / pxCompartir[0]) : undefined,
  alt: `Cartel de ${eventData.title}`,
} : undefined;

---
<Layout title={eventData.title} description={descripcionCompartir || undefined} imagen={imagenCompartir}>
  <!-- El compás del morphing del cartel: 0,5 s y esta curva. Va con `set:html` porque el nombre
       lleva el id del evento: hasta D-310 estaba escrito como `{eventData.idMel}`
       dentro de un `<style is:inline>`, donde Astro NO sustituye nada, así que la
       regla no casaba con ningún cartel y el vuelo duraba los 250 ms de serie del
       navegador. El grupo es el movimiento. La imagen nueva va OPACA desde el
       primer fotograma (sin fundido de entrada): con la vieja yéndose en 200 ms
       y la nueva entrando en 500, a mitad ninguna estaba entera y el cartel
       arrancaba medio transparente. La vieja se va con el resto de la portada
       (ver `::view-transition-old(*)` abajo), por debajo de la nueva. -->
  <style is:inline set:html={`
    ::view-transition-group(flyer-img-${eventData.idMel}) {
      animation-duration: 0.5s !important;
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1) !important;
    }
    ::view-transition-new(flyer-img-${eventData.idMel}) {
      animation: none !important;
    }
  `} />

  <!-- Main layout container. pt-0 below `lg`: the header there is
       `position: fixed` from the very first frame (see its own comment)
       and #detail-header-spacer reserves exactly its height — any
       additional top padding here would just stack on top of that and push
       content down by an unwanted extra gap below the header. lg:pt-[10vh]
       matches every other page header's top offset (unaffected — desktop's
       header isn't fixed, it's back in normal flow via lg:static).
       Los 40px de abajo en móvil/tablet (<lg) NO van aquí: viven en el
       `pb-[40px]` del propio scroller, unas líneas más abajo. Estuvieron aquí y
       eso los dejaba FUERA del área con scroll, o sea que no separaban la última
       línea de nada — la recortaban. Ver el comentario del scroller. A `lg+` sí
       van aquí (`lg:pb-[108px]`), porque allí no hay recorte ni scroll interno. -->
  <div class="w-full max-w-[1440px] mx-auto h-dvh overflow-hidden lg:h-auto lg:min-h-dvh lg:overflow-visible bg-mel-bg-primary text-mel-text-primary flex flex-col items-center justify-start pt-0 lg:pt-[var(--mel-header-pt-desktop)] lg:pb-[108px] lg:px-[108px]">
    <!-- Main Box Container (Figma 1224px wide).
         data-event-id / data-image-urls: la identidad del evento viaja en el
         DOM, no solo en las variables de `define:vars`. Esas quedan congeladas
         en la closure del script que las sirvió, y con el botón atrás/adelante
         del navegador Astro restaura la página desde su caché SIN reejecutar el
         script: solo corren las closures ya registradas, la última de ellas con
         el id del evento ANTERIOR. Resultado: la ficha mostraba un evento y su
         navegación pertenecía a otro (con "Siguiente" apuntándose a sí misma,
         de ahí que se quedara pillada). Leyéndolo del DOM en cada
         `astro:page-load`, la identidad siempre es la de la página visible. -->
    <!-- `pb-[40px]` AQUÍ, y no en el contenedor de arriba, que es donde estaba.
         Allí era padding de un padre con `overflow: hidden`, o sea 40px de fondo
         por DEBAJO del área con scroll: no separaban la última línea del borde
         de recorte, la dejaban muriendo exactamente en él (medido: la última
         línea acababa en 660 con el scroller acabando en 660, holgura CERO).
         Como es del mismo color que la página, se veía como un faldón opaco
         tumbado sobre el texto — y el propietario lo describió tal cual.
         Dentro del scroller los 40px son contenido: la última línea siempre
         aterriza 40px por encima del recorte y no puede cortarse. El hueco a
         pie de pantalla se ve igual que antes. Efecto secundario bienvenido: el
         área con scroll llega ahora hasta el borde de la pantalla, así que la
         rendija legible bajo la foto fijada gana esos 40px. -->
    <div
      id="detail-page-container"
      class="w-full max-w-[1224px] flex flex-col select-none pt-0 pb-[40px] lg:pb-0 flex-1 min-h-0 overflow-y-auto lg:flex-1 lg:min-h-auto lg:overflow-visible"
      data-event-id={eventData.idMel}
      data-image-urls={JSON.stringify(imageUrls)}
    >

      <!-- Cabecera completa en UN bloque pegajoso (X + compartir + título +
           tags), clavado en `top: 0` y QUIETO: no se mueve nunca (D-307). Hasta
           D-306 se anclaba con la fila de la X por encima del borde y la X
           asomaba siguiendo al dedo (`--mel-revelado`); el propietario lo
           quitó porque ponía nervioso. Lleva dentro los 16 px de aire de arriba
           (antes en el contenedor con scroll): fuera, el texto se vería pasar
           por esa franja. A partir de `lg` el bloque se disuelve (`contents`)
           y cada pieza vuelve a su sitio en la rejilla. -->
      <div id="detail-cabecera" class="sticky top-0 z-40 w-full px-6 sm:px-12 pt-[var(--mel-header-pt-mobile)] bg-mel-bg-primary lg:static lg:p-0 lg:bg-transparent lg:contents">
      <!-- Fila de la X y compartir. Quieta con el resto de la cabecera (D-307).
           Mismo alto que la cabecera de la home (fila de 48px con el mismo aire
           encima), para que al ir de una página a otra el icono no dé un salto. -->
      <div
        id="detail-sticky-header"
        class="w-full bg-mel-bg-primary lg:bg-transparent shrink-0 lg:contents"
      >
        <!-- La X va dentro de una fila de 48px con el icono centrado, que es
             exactamente lo que pasa en las demás páginas: allí el botón de
             menú (40px) se centra en la fila del título, que mide 48. Sin esta
             fila la X quedaba 4px más alta que el icono de menú al cambiar de
             página. -->
        <div class="flex items-center justify-between h-[48px] lg:mb-12">
          <IconButton
            id="detail-close-btn"
            href="/"
            icon="x"
            type="phantom"
            size={40}
            class="cursor-pointer shrink-0"
            aria-label="Cerrar detalles de evento"
          />
          <!-- Compartir en teléfono y tableta (D-306, Figma 1354:61067): mismo
               botón fantasma que la X, en el otro extremo de su fila, así que
               se esconde y reaparece con ella al desplazar. Desde `lg` el
               botón con texto de la columna de info (BotonCompartir). -->
          <IconButton
            id="detail-share-btn"
            icon="share"
            type="phantom"
            size={40}
            class="cursor-pointer shrink-0 lg:hidden"
            aria-label="Compartir evento"
          />
        </div>
      </div>

      <!-- Título + tags: `sticky top-0`. Suben con el contenido hasta tocar el
           borde superior y ahí se quedan — el propietario fue explícito en que
           el nombre del evento no debe irse nunca. Es CSS puro: `sticky` lo
           gestiona el compositor y, a diferencia de `fixed`, no se re-ancla
           cuando la barra del navegador redimensiona el viewport a mitad de un
           gesto (que era D-103). Fondo opaco porque la foto le pasa por debajo.
           A partir de `lg` se desmonta: el título vive en la columna de info y
           los tags en su propia columna. -->
      <div id="detail-titulo-tags" class="w-full shrink-0 pb-8 lg:pb-0 lg:contents">
        <h2 class="typo-h2 lg:hidden text-mel-text-primary mt-4 mb-8">
          {eventData.title}
        </h2>

        <div id="detail-tags-fixed" class="lg:hidden w-full">
          <AdaptiveTagsRow id="detail-tags-fixed-row" tags={TAGS_EVENTO} />
        </div>
      </div>
      </div>

      <!-- Three-column content grid (Figma widths: 184px, 496px, 496px). On
           mobile the same three blocks reflow per Figma 369:32751: image first
           (full-bleed, pinned, shrinking), then the tags as a horizontally
           scrollable row, then the info column — a real grid at every
           breakpoint, with `order` doing the mobile reflow (see each column's
           own comment). -->
      <div class="contents lg:grid lg:grid-cols-12 lg:gap-6 lg:items-start">

        <!-- Column 2: Image Box (Figma 496px wide, height exactly 400px on
             desktop). order-1 (lg:order-2 restores the desktop middle-column
             position) puts it first below `lg`, matching Figma 369:32751's
             image-then-tags-then-info mobile flow. -->
        <div id="detail-image-column" class="w-full shrink-0 lg:order-2 lg:col-span-5 flex flex-col items-center relative h-auto lg:h-[400px] lg:mx-0 lg:w-full" data-name="Image Viewer / Desktop">

          <!-- Pinned image box (Figma 369:32751: min-h-[200px] on scroll).
               Below `lg`, updateStickyImage() drives `position: fixed` plus
               `top`/`left`/`width` directly — can't be static Tailwind
               classes since they depend on scroll position and on the sticky
               header's live height. NO bottom padding/margin of its own: the
               32px resting gap to tags is the parent grid's gap-8, which
               already applies after this box (dots included) whether or not
               this event has pagination — any spacing here would stack on
               top of that gap (the propietario flagged exactly that as
               unwanted extra space below the photo). -->
          <div
            id="detail-image-sticky"
            class:list={[
              "z-20 flex flex-col items-center w-full",
              /* Sin paginación no hay nada que separe la foto del contenido, así
                 que la propia caja lleva un faldón macizo de 32px por el que el
                 contenido pasa por debajo. Con paginación sobra: los 24px de
                 abajo del `py-6` de los puntos ya hacen ese papel. */
              /* El fondo opaco va en el recorte y en los puntos, no en la caja:
                 con los puntos escondidos (D-307) la caja tiene que dejar ver el
                 texto en el hueco que ellos dejan. Sin puntos, la caja pone el
                 fondo de su faldón. */
              imageUrls.length > 1 ? "" : "pb-8 lg:pb-0 bg-mel-bg-primary lg:bg-transparent",
            ]}
          >
            <!-- Crop window: THIS is what shrinks (400px→200px), via
                 overflow-hidden — not the photo itself. The photo (button
                 below) always stays a full, unscaled 400px tall and CENTERED
                 in this wrapper (flex column + justify-center; the button
                 needs shrink-0 or column-flex would shrink its 400px height
                 to fit), so shrinking the wrapper crops it evenly from the
                 top and bottom at its real size/ratio, keeping the image
                 centered instead of pinned to the top edge. -->
            <!-- `--mel-ratio-cartel`: la proporción de la imagen MÁS ALTA del
                 evento. El CSS la convierte en el alto de la caja, acotado entre
                 200 y 360 (ver el bloque `@media (max-width: 1023px)` de abajo).
                 Sin ella —cartel aún sin medir— manda el `h-[360px]` de la clase
                 y todo se comporta como antes. -->
            <div
              id="detail-image-crop"
              class="relative z-[1] w-full overflow-hidden flex flex-col justify-center h-[360px] lg:h-[400px] bg-mel-bg-primary lg:bg-transparent"
              style={masAlta ? `--mel-ratio-cartel: ${masAlta[0]} / ${masAlta[1]}; --mel-alto-cartel: ${masAlta[1]}px;` : undefined}
            >
              <button
                id="carousel-main-container"
                class="relative w-full h-full lg:h-[400px] overflow-hidden flex items-center justify-center cursor-zoom-in outline-none group bg-transparent"
                aria-label="Siguiente imagen"
              >
                <!-- Custom background image matching Figma specifications exactly (flipped 180deg horizontally) -->
                <div class="absolute inset-0 striped-bg z-0 pointer-events-none"></div>

                <!-- Slides track container with sliding transform transition -->
                <div
                  id="carousel-track"
                  class="flex w-full h-full transition-transform duration-500 ease-out z-10 pointer-events-none"
                  style="transform: translate3d(0, 0, 0);"
                >
                  {imageUrls.map((img, idx) => {
                    // NUNCA se amplía un cartel por encima de su tamaño real: si
                    // no da la resolución se pinta al máximo que tenga, centrado,
                    // y no estirado. El centrado lo pone el padre.
                    //
                    // La caja de la imagen mide EXACTAMENTE lo que el cartel, sin
                    // márgenes (D-310): el ancho es el menor de tres —el del hueco
                    // (`100cqw`), el real del cartel y el que cabe en el alto del
                    // hueco (`100cqh` × proporción)— y el alto sale de la
                    // proporción. Antes la caja llenaba el hueco y el cartel se
                    // encajaba dentro (`object-contain`) dejando márgenes
                    // transparentes, y el morphing desde la tarjeta metía esa caja
                    // con márgenes en el hueco de la tarjeta: el cartel arrancaba
                    // más pequeño y arriba, y «bajaba y rebotaba». Con medidas
                    // conocidas (`flyer_tecnico.json`) no depende de que la imagen
                    // haya cargado: la caja existe desde el primer fotograma, con
                    // el cartel de la galería de fondo mientras llega el grande.
                    // Sin medidas, como antes.
                    const d = flyerTecnico[idDeDrive(eventData.carruselItems[idx]?.urlDrive)]?.px;
                    const medido = Array.isArray(d) && d[0] > 0 && d[1] > 0;
                    const tope = medido
                      ? `width: min(100cqw, ${d[0]}px, calc(100cqh * ${d[0]} / ${d[1]})); height: auto; aspect-ratio: ${d[0]} / ${d[1]};` : '';
                    const nombre = idx === 0 ? `view-transition-name: flyer-img-${eventData.idMel};` : '';
                    // La 1.ª con prioridad alta y el resto baja (D-296): siguen sin
                    // ser diferidas (D-258, que no haya hueco al deslizar), pero ya
                    // no le quitan línea a la que se ve. Medido con 4G lenta: la
                    // 1.ª llega en ~1,16 s en vez de ~1,56 s.
                    return (
                    <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden [container-type:size]">
                      <img
                        src={img}
                        srcset={imageSrcsets[idx] || undefined}
                        sizes={imageSrcsets[idx] ? TAMANOS_FICHA : undefined}
                        alt={eventData.title}
                        referrerpolicy="no-referrer"
                        fetchpriority={idx === 0 ? 'high' : 'low'}
                        class={medido ? "object-contain" : "w-full h-full object-contain"}
                        style={`${tope}${nombre}`}
                      />
                    </div>
                    );
                  })}
                </div>
              </button>
            </div>

            <!-- Pagination dots: in flow (below the image) below `lg`, so they
                 count as part of the sticky box's own content — the parent
                 grid's gap-8 always applies after them, keeping the 32px gap
                 to tags constant whether or not they're rendered. Floating absolute
                 on desktop (top-[400px]) so they don't shift the navigation
                 block there, unchanged from before. -->
            {imageUrls.length > 1 && (
              <div class="relative z-0 bg-mel-bg-primary lg:bg-transparent lg:absolute lg:top-[400px] lg:left-0 lg:right-0 flex gap-4 items-center justify-center py-6 w-full" id="carousel-dots-container">

                {imageUrls.map((_, idx) => (
                  <PaginationDot
                    state={idx === 0 ? "Active" : "Resting"}
                    index={idx}
                    class="carousel-dot"
                  />
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Column 1: Tags Sidebar — DESKTOP ONLY (`lg+`) now: below `lg`,
             #detail-tags-fixed above (pinned under the header) takes over this
             role entirely (V2 layout, made definitive — see D-042/D-043), so
             this instance is `hidden` there and contributes nothing to the
             mobile grid flow. h-[400px]+justify-between matches the image
             column's own fixed height and spreads the tags across it instead
             of a flat 40px gap that leaves the column visibly shorter than
             the image next to it. -->
        <div class="hidden lg:block lg:order-1 lg:col-span-2 lg:h-[400px] w-full min-w-0" data-name="Tags Section">
          <div class="event-tags-row hidden lg:flex lg:flex-col lg:justify-between lg:gap-2 h-full min-w-0 lg:overflow-visible no-scrollbar lg:mx-0 lg:w-full lg:px-0">
            {TAGS_EVENTO.map((tag) => (
              <TagWithLink
                label={tag.label}
                count={tag.count}
                href={tag.href}
                state={tag.state}
                multi={tag.multi}
                ariaLabel={tag.ariaLabel}
                hideBorder={true}
                class="w-full"
              />
            ))}
          </div>
        </div>

        <!-- Column 3: Event Info (Figma 496px wide with 24px left padding).
             order-3 (same at every breakpoint, third of three) needs to be
             explicit here — the default `order: 0` on an unstyled item would
             otherwise rank it ABOVE the image/tags columns, which both carry
             an explicit order. -->
        <!-- Ritmo de la columna: 32px (L) entre todo, con dos excepciones que el
             propietario pidió expresamente — 40px del contenido al botón y 56px
             del botón a la navegación. Las tres tallas van de menos a más según
             se baja, así que el bloque se lee como una unidad que se despide.
             El `gap` de aquí no puede dar los dos valores a la vez (título→texto
             y texto→botón cuelgan del mismo), así que vale 32 para ambos y el
             bloque del botón añade los 8 que le faltan. -->
        <div id="detail-scroll" class="shrink-0 px-6 sm:px-12 lg:px-0 lg:order-3 lg:col-span-5 flex flex-col gap-8 w-full lg:pl-6" data-name="Info">

          <!-- Event Title (desktop position — the mobile one renders above the grid) -->
          <h2 id="detail-titulo-escritorio" class="typo-h2 hidden lg:block text-mel-text-primary">
            {eventData.title}
          </h2>

          <!-- Description + Artists block. 32px también aquí dentro: texto→divisor
               y divisor→Artistas. Antes eran 24 y 40, y ese cambio de talla justo
               a los lados de la línea es lo que rompía el ritmo.
               OJO: este comentario tiene que quedarse FUERA del
               `{eventData.description && (…)}` de abajo — ahí dentro se compila
               como expresión y un comentario HTML revienta el build con
               `[CompilerError] Unexpected token`. -->
          <div class="flex flex-col gap-8">
            {eventData.description && (
              <div class="flex flex-col gap-8">
                <p class="typo-body-sans text-mel-text-primary">
                  {eventData.description}
                </p>
                <!-- Figma 1px divider -->
                <div class="h-px w-full bg-mel-border"></div>
              </div>
            )}

            <div class="flex flex-col gap-2">
              <span class="typo-overline typo-tag-label text-mel-text-primary">Artistas</span>
              <div class="flex flex-wrap gap-y-1">
                {ARTISTAS.map((a, idx) => (
                  <span class="inline-flex items-center whitespace-nowrap">
                    <Link href={a.href} ariaLabel={a.ariaLabel} hideChevron={true}>{a.texto}</Link>
                    {idx < ARTISTAS.length - 1 && <span class="typo-body-roman text-mel-text-secondary mr-2">,</span>}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Compartir (D-306), en el hueco que ocupaba «Me presta» (retirado
               hasta decidir qué hacer con él; recuperable desde v1.4.0). Solo
               escritorio: en teléfono y tableta va de icono en la fila de la X.
               `lg:mt-2` son los 8px que suman 40 sobre el `gap-8` del padre: el
               botón se separa del contenido una talla más que el contenido de sí
               mismo. -->
          <div class="hidden lg:flex gap-6 items-start lg:mt-2">
            <BotonCompartir id="btn-compartir" />
          </div>

        </div>

      </div>


      <!-- En escritorio el margen superior es AUTOMÁTICO, no fijo.
           Así la navegación tiene sitio de serie —el fondo de la página— y se
           queda ahí mientras el contenido no llegue. Solo cuando el contenido
           crece y empieza a empujarla, el margen automático se agota y manda el
           `lg:pt-14`: 56px, el hueco más ancho de la columna a propósito — es la
           despedida del bloque. Antes era `lg:mt-24` + `pt-8`, o sea 128px fijos
           que ni anclaban la navegación ni seguían el ritmo del resto.

           `lg:pb-14` decide LA ALTURA del punto fijo, y hace falta porque antes no
           había ninguno: con el contenedor a `lg:flex-none` la navegación colgaba
           del final del contenido, así que cada ficha la dejaba a una altura
           distinta (medido: 165px del borde inferior en FIV XI y 278px en Trip
           With Us, 113px de diferencia). Al anclarla quedó a ras del
           `padding-bottom` de 108px de la página, que el propietario vio
           demasiado abajo. Estos 56px la levantan hasta ~164, la altura que tenía
           en las fichas que él miraba, y son la misma talla que el hueco de
           arriba: la navegación queda enmarcada por el mismo valor por los dos
           lados. Es EL número a mover si hay que reajustar la altura.

           El `pt-8` de móvil se conserva: ahí el pseudoelemento del divisor se
           dibuja en el borde de la caja y esos 32px son su separación. -->
      <div
        id="detail-nav-block"
        class="relative px-6 sm:px-12 lg:px-0 grid grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-6 w-full mt-10 lg:mt-auto pt-8 lg:pt-14 lg:pb-14 lg:border-t-0 shrink-0 items-center"
        data-name="Navigation Block"
        style={!prevEvent && !nextEvent ? 'display:none' : undefined}
      >
        
        <!-- Empty cell for Left Column alignment -->
        <div class="hidden lg:block lg:col-span-2"></div>
        
        <!-- Anterior / Siguiente.
             Nacen SIEMPRE `invisible`, con `href="#"`, y solo los revela el
             cliente cuando ha resuelto los vecinos de la secuencia activa
             (`mel-active-nav-sequence`). El servidor no puede conocer esa
             secuencia — solo sabe el orden cronológico del archivo entero —,
             así que si pintaba aquí sus propios vecinos quedaba una ventana,
             entre el primer pintado y el arranque del script, en la que estos
             enlaces apuntaban FUERA del contexto del visitante: entrando desde
             el panel de un local con dos eventos, por ejemplo, mostraban dos
             eventos cualesquiera del archivo, y pulsarlos ahí sacaba de la
             navegación acotada. Los títulos SSR se conservan solo como
             contenido de reemplazo; el cliente los sobrescribe. -->
        <div class="lg:col-span-5 flex justify-end text-right items-center invisible cursor-pointer pointer-fine:cursor-auto" id="nav-prev-container" data-mel-tocable>
          <TagWithLink
            label="Anterior"
            count={prevEvent ? prevEvent.title : "Anterior"}
            alignment="Right"
            href="#"
            class="w-full max-w-[496px]"
            hideBorder={true}
          />
        </div>

        <!-- Siguiente (Left-aligned under right column with 24px left padding on desktop) -->
        <div class="lg:col-span-5 flex justify-start text-left pl-0 lg:pl-6 items-center invisible cursor-pointer pointer-fine:cursor-auto" id="nav-next-container" data-mel-tocable>
          <TagWithLink
            label="Siguiente"
            count={nextEvent ? nextEvent.title : "Siguiente"}
            alignment="Left"
            href="#"
            class="w-full max-w-[496px]"
            hideBorder={true}
          />
        </div>

      </div>

    </div>

    <!-- Image Detail Lightbox Overlay (Figma 841:40903: fixed-size modal,
         image object-contained inside it — never sized off the photo's
         natural dimensions, which used to let large photos overflow the
         screen — with pagination dots inside the modal below the image) -->
    <div
      id="image-detail-overlay"
      class="fixed inset-0 bg-[var(--mel-scrim)] z-[250] opacity-0 pointer-events-none transition-opacity duration-300 hidden flex items-center justify-center max-[479px]:touch-none"
    >
      <!-- En el teléfono (<480 px) el visor ocupa la pantalla entera (D-305):
           los mismos elementos del sistema de diseño —fondo, rayas, X, puntos—,
           sin la caja cuadrada, para que el cartel salga lo más grande posible
           y se pueda ampliar con los dedos. Arriba, el hueco justo de la X. -->
      <!-- Modal Container: proportional to viewport height, true square aspect ratio, width
           follows from that. Bottom padding matches the other sides (pb-8) when there's no
           pagination to show — with pagination, pb-4 plus the dots row's own padding reads as
           the same visual weight, so it stays smaller there on purpose. -->
      <div
        id="image-detail-modal"
        class={`relative bg-mel-bg-primary flex flex-col items-center transform scale-95 transition-transform duration-300 pt-8 px-8 ${imageUrls.length > 1 ? 'pb-4' : 'pb-8'} h-[76vh] max-w-[92vw] aspect-square max-[479px]:h-dvh max-[479px]:w-full max-[479px]:max-w-none max-[479px]:aspect-auto max-[479px]:px-0 max-[479px]:pt-[calc(env(safe-area-inset-top)+64px)] max-[479px]:pb-[calc(env(safe-area-inset-bottom)+8px)]`}
        data-node-id="841:40541"
      >
        <!-- Close Button (40px, offset half-outside the top-right corner) -->
        <button
          id="overlay-close-btn"
          class="absolute -top-5 -right-5 max-[479px]:top-[calc(env(safe-area-inset-top)+12px)] max-[479px]:right-4 w-10 h-10 bg-mel-action-secondary text-mel-text-on-action hover:bg-mel-action-primary flex items-center justify-center shadow-[0px_4px_8px_rgba(38,31,31,0.32)] border-none cursor-pointer z-50 transition-colors"
          aria-label="Cerrar vista grande"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <!-- Image Box: fills the modal, sliding track mirrors the main carousel's transition (no autoplay here) -->
        <div id="overlay-image-box" class="relative flex-1 min-h-0 w-full overflow-hidden flex items-center justify-center">
          <div class="absolute inset-0 striped-bg pointer-events-none"></div>
          <div
            id="overlay-track"
            class="flex w-full h-full transition-transform duration-500 ease-out z-10"
            style="transform: translate3d(0, 0, 0);"
          >
            {imageUrls.map((img, idx) => {
              // La caja de la imagen, del tamaño exacto del cartel (D-313, como
              // la del carrusel en D-310): es lo que vuela al abrir y cerrar el
              // visor. Aquí SÍ se amplía hasta llenar el hueco, como hacía
              // `object-contain`: el visor es para verlo grande. El zoom del
              // teléfono no cambia: calcula con la caja del visor, no con esta.
              const d = flyerTecnico[idDeDrive(eventData.carruselItems[idx]?.urlDrive)]?.px;
              const medido = Array.isArray(d) && d[0] > 0 && d[1] > 0;
              return (
              <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden [container-type:size]">
                <img
                  src={img}
                  srcset={imageSrcsets[idx] || undefined}
                  sizes={imageSrcsets[idx] ? TAMANOS_VISOR : undefined}
                  alt={eventData.title}
                  referrerpolicy="no-referrer"
                  loading="lazy"
                  draggable="false"
                  class={`${medido ? '' : 'w-full h-full '}object-contain select-none [-webkit-touch-callout:none]`}
                  style={medido ? `width: min(100cqw, calc(100cqh * ${d[0]} / ${d[1]})); height: auto; aspect-ratio: ${d[0]} / ${d[1]};` : undefined}
                />
              </div>
              );
            })}
          </div>
        </div>

        {imageUrls.length > 1 && (
          <div class="flex gap-4 items-center justify-center pt-4 pb-1 shrink-0" id="overlay-dots-container">
            {imageUrls.map((_, idx) => (
              <PaginationDot
                state={idx === 0 ? "Active" : "Resting"}
                index={idx}
                class="overlay-dot"
              />
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Aviso «Enlace copiado» (D-306): solo cuando el teléfono no tiene hoja
         de compartir y se copia el enlace en su lugar. El mismo canal que el
         orden de la portada (D-162); aquí se centra desde el script. -->
    <Whisper />

  </div>
</Layout>


<script define:vars={{ ssrImageUrls: imageUrls, ssrEventId: eventData.idMel, allEvents, tamanosFicha: TAMANOS_FICHA }}>
  function initPage() {
    // astro:page-load dispara en TODAS las páginas tras una navegación suave
    // (los listeners viven en `document` y sobreviven al salto). Sin este
    // guard, al volver a la home esta función seguía ejecutándose allí y —lo
    // grave— abortaba el AbortController compartido, matando los listeners que
    // la home acababa de registrar.
    const dataNode = document.getElementById('detail-page-container');
    if (!dataNode) return;

    // Identidad REAL de la página visible, leída del DOM y no de `define:vars`
    // (ver el comentario de data-event-id en el marcado): con atrás/adelante
    // del navegador el script no se reejecuta y las variables de la closure
    // pertenecen al evento anterior. Sombrean a las del SSR para todo initPage.
    const eventId = dataNode.dataset.eventId || ssrEventId;
    let imageUrls = ssrImageUrls;
    try {
      const parsed = JSON.parse(dataNode.dataset.imageUrls || 'null');
      if (Array.isArray(parsed)) imageUrls = parsed;
    } catch (e) {}

    // Vuelo de vuelta (D-314): solo desde la ficha por la que se entró. La
    // portada apunta ese evento al abrirlo (`mel-vuelo-origen`); si esta ficha
    // es otra (Anterior/Siguiente, flechas…), se borra y ya no habrá vuelo,
    // aunque luego se vuelva a la primera.
    try {
      if (sessionStorage.getItem('mel-vuelo-origen') !== eventId) sessionStorage.removeItem('mel-vuelo-origen');
    } catch (e) {}

    // La vuelta apunta al flyer que se está mirando AHORA, no al que se abrió
    // desde la galería. El estado de vuelta lo escribe la home al pulsar una
    // tarjeta y no lo tocaba nadie más, así que recorriendo la sesión con
    // Anterior/Siguiente seguía señalando al primero: cerrar desde el tercer
    // evento devolvía al primero, que era justo lo que la vuelta al flyer venía
    // a resolver. Se engancha a QUÉ FICHA SE ESTÁ MOSTRANDO y no a los enlaces
    // porque hay cuatro maneras de llegar a una (los dos enlaces, las flechas
    // del teclado y una URL directa) y así quedan cubiertas las cuatro.
    // Se reescribe solo ese campo: los filtros, los lotes cargados y el píxel
    // de reserva siguen siendo los de la galería que se dejó. Y solo si ya hay
    // estado — llegando por una URL directa no hay ninguna vuelta que ajustar.
    try {
      const crudo = sessionStorage.getItem('mel-return-state');
      if (crudo) {
        const estado = JSON.parse(crudo);
        estado.flyer = eventId;
        sessionStorage.setItem('mel-return-state', JSON.stringify(estado));
      }
    } catch (e) {}

    // El cartel que la galería ya tenía descargado, de fondo, mientras el
    // grande viaja (lo deja escrito `recordarFlyerAbierto()` en index.astro,
    // donde está la explicación larga). El fondo se pinta al instante porque
    // esa URL está en caché, así que el morph aterriza sobre la imagen de
    // verdad —borrosita— en vez de sobre un hueco, y cuando llega la nítida la
    // sustituye sin que se note un segundo tiempo.
    //
    // `background-size: contain` para casar con el `object-contain` de la
    // imagen: comparten caja (el tope de tamaño real va en el propio elemento),
    // así que encuadran igual y la sustitución no mueve nada.
    //
    // Se retira al cargar la buena: hay carteles PNG con transparencia y si no,
    // se verían los dos superpuestos por las zonas transparentes.
    try {
      const crudoCartel = sessionStorage.getItem('mel-cartel-cacheado');
      const cacheado = crudoCartel ? JSON.parse(crudoCartel) : null;
      const primera = document.querySelector('#carousel-track img');
      if (cacheado && cacheado.id === eventId && cacheado.src && primera && !primera.complete) {
        primera.style.backgroundImage = `url("${cacheado.src}")`;
        primera.style.backgroundSize = 'contain';
        primera.style.backgroundPosition = 'center';
        primera.style.backgroundRepeat = 'no-repeat';
        primera.addEventListener('load', () => {
          primera.style.backgroundImage = '';
          primera.style.backgroundSize = '';
          primera.style.backgroundPosition = '';
          primera.style.backgroundRepeat = '';
        }, { once: true });
      }
    } catch (e) {}

    // Parse search/location/view queries from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const activeView = urlParams.get('view') || 'galería';
    const activeSearch = urlParams.get('search') || '';
    const activeLocation = urlParams.get('location') || '';

    // Append search/location/view queries to close button so it returns with filters and state preserved
    const closeBtn = document.getElementById('detail-close-btn');
    if (closeBtn) {
      const returnParams = new URLSearchParams();
      if (activeView) returnParams.set('view', activeView);
      if (activeSearch) returnParams.set('search', activeSearch);
      if (activeLocation) returnParams.set('location', activeLocation);
      closeBtn.href = `/?${returnParams.toString()}`;
      // Volviendo a un panel abierto (D-266). Hasta ahora esto forzaba RECARGA
      // COMPLETA: el motivo original (D-116, y cuatro intentos) era que dentro
      // de la transición la cabecera y la toolbar se promocionaban a la capa
      // superior y el panel llegaba a destiempo, y el propietario prefirió
      // instantáneo antes que una animación que no cuadraba. Ese motivo ya no
      // existe: desde D-261 la franja viaja como UNA sola pieza y desde D-263
      // la vuelta apaga todos los nombres y se resuelve con la ficha
      // disolviéndose sobre la home ya montada. Así que se deja navegar suave
      // y la vuelta al mapa hereda ese mismo cierre.
      //
      // La marca sigue: le dice a la home que esto es una VUELTA a un estado y
      // no un viaje a un sitio. Sin ella se reproduce la secuencia de entrada
      // entera —cámara buscando el marcador y panel abriéndose tras su segundo
      // de espera—, que tiene sentido llegando desde una tag de "Lugar" y
      // ninguno volviendo.
      closeBtn.removeAttribute('data-astro-reload');
      if (activeLocation) {
        closeBtn.addEventListener('click', () => {
          try { sessionStorage.setItem('mel-volviendo-al-panel', activeLocation); } catch (e) {}
        }, { once: true });
      }
    }

    // La tag de "Lugar" aterriza en el MISMO sitio que el cierre (D-266,
    // decisión del propietario): todos los eventos de esta navegación
    // comparten local, así que ir al mapa por el enlace o salir por la X
    // llevan al mismo estado, y merecen la misma llegada — panel abierto y sin
    // coreografía. Se marca aquí igual que en el cierre.
    //
    // Delegado en el documento y no atado a la tag: la fila de tags se pinta
    // DOS veces (la horizontal de móvil y la columna de escritorio, ver
    // TAGS_EVENTO) y además AdaptiveTagsRow la rehace al medir. Un listener por
    // enlace se perdería en cada repintado; el delegado los cubre todos.
    if (!window._melLugarBound) {
      window._melLugarBound = true;
      document.addEventListener('click', (e) => {
        const enlace = e.target && e.target.closest && e.target.closest('a[href^="/?"]');
        if (!enlace) return;
        // El botón de CERRAR queda fuera, y no es un detalle: su `href` es
        // `/?view=…&search=…` cuando se venía de una búsqueda, o sea que
        // empieza igual y lleva `search=` igual que un enlace de artista. Sin
        // esta salida marcaba el relato al cerrar, y al volver a la galería se
        // repetía toda la función —buscador llenándose y tarjetas moviéndose—
        // cuando volver tiene que dejarlo TODO quieto (D-268). Volver no es
        // buscar: es regresar a un sitio que ya estaba filtrado.
        if (enlace.id === 'detail-close-btn' || enlace.closest('#detail-close-btn')) return;
        try {
          const params = new URL(enlace.href, location.href).searchParams;
          const local = params.get('location');
          if (local) { sessionStorage.setItem('mel-volviendo-al-panel', local); return; }
          // Enlaces que generan una BÚSQUEDA (artista, localidad, diseño): se
          // marca el término para que la home cuente el proceso en vez de
          // aterrizar con todo filtrado ya (D-267). Solo se marca aquí, en un
          // clic DENTRO del sitio: llegar de fuera por un enlace compartido
          // sigue mostrando el resultado al instante, que allí no hay ningún
          // gesto que explicar.
          const termino = params.get('search');
          if (termino && termino.trim()) sessionStorage.setItem('mel-relato-busqueda', termino.trim());
        } catch (err) {}
      });
    }

    // Abort any previous window listeners to prevent duplicates across page transitions.
    // Clave propia (_melDetailAbortCtrl), NO la de index.astro: ambas páginas
    // compartían `_melAbortCtrl` y se abortaban los listeners la una a la otra
    // según el orden en que corrieran sus respectivos astro:page-load.
    if (window._melDetailAbortCtrl) window._melDetailAbortCtrl.abort();
    window._melDetailAbortCtrl = new AbortController();
    const wSig = window._melDetailAbortCtrl.signal;

    // La ficha de evento es una PÁGINA NORMAL: el documento se desplaza y no
    // hay ni un solo elemento fijo o pegajoso. Es lo más robusto que puede
    // haber en un móvil — la barra del navegador se repliega y devuelve
    // pantalla, y no hay nada anclado que el navegador pueda re-anclar a
    // mitad de un gesto (que era D-103).
    //
    // Fueron cayendo, por este orden: los tres `position: fixed` con sus
    // espaciadores y la pista de scroll (D-105), y después el contenedor con
    // scroll propio, porque impedía que la barra del navegador se replegara y
    // dejaba la foto fuera del área desplazable — no se podía arrastrar sobre
    // ella, que es media pantalla.

    // Geometría de la cabecera. Se mide UNA vez al iniciar y al redimensionar,
    // nunca durante el scroll: son los dos altos que el CSS necesita y que no
    // puede calcular solo (el título puede ocupar una o dos líneas).
    //   --mel-cab-fija  alto de la cabecera entera, donde se clava la foto
    const cabecera = document.getElementById('detail-cabecera');
    const filaX = document.getElementById('detail-sticky-header');
    const tituloTags = document.getElementById('detail-titulo-tags');
    const columnaFoto = document.getElementById('detail-image-column');
    const cajaFoto = document.getElementById('detail-image-sticky');
    const raizPagina = document.getElementById('detail-page-container');
    const imageCrop = document.getElementById('detail-image-crop');
    // Alto de partida de la caja. YA NO es una constante: lo decide el CSS a
    // partir de la proporción del cartel (ver `#detail-image-crop` en el bloque
    // de estilos) y medirCabecera() lo lee. 360 es solo el valor de arranque por
    // si se consultara antes de la primera medición.
    //
    // Antes el 360 estaba escrito DOS VECES —en la clase `h-[360px]` y aquí— que
    // es la trampa nº2 del traspaso: dos números que deben coincidir, calculados
    // por separado. Ahora manda el CSS y aquí solo se lee.
    let altoMaximo = 360;
    // 200px es la especificación de Figma para la foto fijada (369:32751) y es un
    // SUELO DURO: el propietario no quiere nada más pequeño en el sitio, por
    // respeto a los diseños. Se probó calcularlo para que la cola del contenido
    // cupiera bajo el cajón y se descartó por eso (D-156). No lo bajes.
    const IMAGE_MIN_H = 200;

    // Distancia, en el documento, desde el origen hasta el punto en que la
    // columna de la foto llega a su posición pegada. Se mide una vez.
    let inicioEncogido = 0;
    // Distancia desde el borde superior a la que se clava la foto. La usan la
    // variable CSS que la posiciona y el cálculo de cuándo empieza a encoger:
    // tienen que ser EXACTAMENTE el mismo número o dejan de ir sincronizadas.
    let anclajeFoto = 0;

    function medirCabecera() {
      if (!cabecera || !filaX || !tituloTags) return;
      const raiz = document.documentElement;
      if (window.innerWidth >= 1024) {
        raiz.style.removeProperty('--mel-cab-fija');
        if (columnaFoto) columnaFoto.style.height = '';
        if (imageCrop) imageCrop.style.height = '';
        raizPagina.classList.remove('fijada', 'puntos-ocultos');
        return;
      }
      // La cabecera está quieta en `top: 0` y lleva dentro el aire de arriba
      // (D-307): la foto se clava justo en su borde inferior.
      anclajeFoto = cabecera.getBoundingClientRect().height;
      raiz.style.setProperty('--mel-cab-fija', `${anclajeFoto}px`);
      // Alto CONGELADO de la columna de la foto. Es la invariante que impide
      // que el encogido se realimente: si la columna encogiera con el recorte,
      // el documento se acortaría a mitad de scroll, el navegador recolocaría
      // la posición y la foto volvería a crecer. Se mide con el recorte a su
      // tamaño máximo para que el valor no dependa de dónde esté el scroll.
      // Hueco reservado para la foto, de alto CONSTANTE. Se mide con el
      // recorte a su máximo y con la caja todavía en flujo, porque una vez
      // fija la columna mediría cero y el documento se quedaría sin recorrido.
      if (columnaFoto && imageCrop && cajaFoto) {
        const altoPrevio = imageCrop.style.height;
        const fijadaAntes = raizPagina.classList.contains('fijada');
        raizPagina.classList.remove('fijada');
        // Se limpia el alto en línea para que mande el CSS, y se LEE lo que
        // decide. Ese es el alto de partida del encogido, y ya viene acotado
        // entre 200 y 360 por la propia regla.
        imageCrop.style.height = '';
        altoMaximo = Math.round(imageCrop.getBoundingClientRect().height) || 360;
        columnaFoto.style.height = '';
        columnaFoto.style.height = `${cajaFoto.getBoundingClientRect().height}px`;
        inicioEncogido = Math.max(0,
          cajaFoto.getBoundingClientRect().top + raizPagina.scrollTop - anclajeFoto);
        imageCrop.style.height = altoPrevio;
        if (fijadaAntes) raizPagina.classList.add('fijada');
      }
    }

    // Lo único ligado al scroll: una altura y dos clases.
    // Los puntos del carrusel se esconden detrás de la foto en cuanto se
    // empieza a leer y vuelven arriba del todo (D-307). Todo o nada: es un
    // cambio de estado con su propia animación (CSS), no algo atado al dedo,
    // así que nunca se quedan a medio tapar. Entre 0 y el umbral se conserva
    // el estado que hubiera, para que un dedo quieto en el borde no los haga
    // parpadear.
    const UMBRAL_PUNTOS = 24;
    function alDesplazar() {
      const y = raizPagina.scrollTop;
      if (window.innerWidth >= 1024) return;

      if (y > UMBRAL_PUNTOS) raizPagina.classList.add('puntos-ocultos');
      else if (y <= 0) raizPagina.classList.remove('puntos-ocultos');

      // La foto se fija justo al llegar a su sitio, y a partir de ahí encoge.
      // Con la cabecera quieta ese sitio es el de reposo, así que se fija en
      // cuanto hay scroll; la clase sigue haciendo falta porque en flujo la
      // caja se iría con el contenido.
      const pasado = Math.max(0, y - inicioEncogido);
      raizPagina.classList.toggle('fijada', pasado > 0);
      if (imageCrop) {
        // Si la caja ya nace en el suelo (cartel apaisado), esto no encoge nada:
        // no hay aire que recuperar. Es la consecuencia buscada, no un fallo.
        imageCrop.style.height = `${Math.max(IMAGE_MIN_H, altoMaximo - pasado)}px`;
      }
    }

    // Reparto del ancho de la fila de tags (D-059/D-060), gemelo reducido de
    // updateAdaptiveTagsRow() en index.astro: aquí la fila nunca comparte
    // renglón con nada, así que sobra todo el tramo de "espacio reservado"
    // por un hermano. Faltaba por completo en esta página — de ahí que en
    // tablet la fila se quedase para siempre en el modo de ancho de contenido
    // que pinta el SSR, sin repartirse el ancho disponible aunque cupiera.
    const ANCHO_MAXIMO_TAG = 176;   // tope por unidad (D-061 / global.css)
    const HUECO_ENTRE_TAGS = 32;
    // Visto en grabación de pantalla (2026-08-01): la fila de tags "saltaba"
    // al arrastrarla en horizontal, en cualquier punto del scroll — no tenía
    // que ver con la cabecera sticky (se descartó esa hipótesis, ver
    // decisions.md). La causa real: esta función desmontaba la fila entera
    // (volvía a "modo contenido", quitando el ancho-igual si estaba puesto) y
    // la volvía a montar EN CADA LLAMADA, aunque el ancho disponible no
    // hubiera cambiado nada — y se llama en cada `resize` de ventana. Un
    // gesto táctil, aunque sea horizontal, puede disparar la animación de la
    // barra de Safari y con ella un resize de verdad sin que el ancho del
    // contenedor cambie ni un píxel. Guardar el último ancho y no tocar nada
    // si no ha cambiado quita el desmontaje innecesario y con él el salto.
    let ultimoAnchoTags = null;
    function ajustarFilaTags() {
      const fila = document.getElementById('detail-tags-fixed-row');
      const contenedor = fila && fila.parentElement;
      if (!contenedor) return;

      // Ancho de CONTENIDO, no el de caja: este contenedor sí lleva padding
      // lateral propio (px-6 / sm:px-12), a diferencia del de la home. Medirlo
      // con getBoundingClientRect() regalaba 96px que la fila no tiene. Se
      // mide ANTES de tocar ninguna clase: no depende del modo actual de la
      // fila (el padding vive en el contenedor, no en ella).
      const relleno = getComputedStyle(contenedor);
      const anchoContenedor = contenedor.clientWidth
        - parseFloat(relleno.paddingLeft) - parseFloat(relleno.paddingRight);
      if (anchoContenedor === ultimoAnchoTags) return;
      ultimoAnchoTags = anchoContenedor;

      // Modo contenido primero: es el único estado en el que cada unidad mide
      // su ancho natural sin arrastrar el reparto que dejó una pasada previa.
      fila.classList.remove('highlights-grid-equal');
      fila.classList.add('highlights-flex-content');
      fila.style.width = '';

      const unidades = [...fila.querySelectorAll('.highlight-unit')];
      // Por encima de `lg` la fila está oculta (mide 0): sin esto el reparto
      // saldría negativo y quedaría fijado un modo que allí no se ve.
      if (!unidades.length || anchoContenedor <= 0) return;

      // Listón del reparto: la tag natural más ancha de las que TODAVÍA se ven
      // enteras. Una que ya está cortada en el tope (p. ej. "S. Andrés del
      // Rabanedo") aparece truncada exactamente igual en los dos modos, así
      // que tomarla como referencia bloqueaba el reparto de toda la fila a
      // cambio de nada: se cortaba igual y encima sobraba hueco muerto a la
      // derecha. Se pregunta por el desbordamiento real del valor, no por el
      // ancho: una tag que mide 175,9 y cabe perfectamente tiene que contar, y
      // comparar anchos con tolerancia falla justo en esa banda.
      const enteras = unidades.filter(u => {
        const val = u.querySelector('.tag-count-val');
        return !val || val.scrollWidth <= val.clientWidth + 1;
      }).map(u => u.getBoundingClientRect().width);
      const naturalMaximo = enteras.length
        ? Math.max(...enteras)
        : Math.min(Math.max(...unidades.map(u => u.getBoundingClientRect().width)), ANCHO_MAXIMO_TAG);
      const reparto = (anchoContenedor - HUECO_ENTRE_TAGS * (unidades.length - 1)) / unidades.length;
      // Solo se reparte a partes iguales si ninguna tag tendría que truncarse;
      // si no, cada una conserva su ancho natural y la fila sangra y hace
      // scroll en vez de comprimir nada por debajo de lo legible.
      if (reparto >= naturalMaximo) {
        fila.classList.remove('highlights-flex-content');
        fila.classList.add('highlights-grid-equal');
        fila.style.width = '100%';
      }
    }

    // Desliza al pasar el ratón el valor de una tag que no cabe entero
    // (D-220, mismo mecanismo que la tabla de Lista — CSS compartido en
    // global.css, detección duplicada aquí porque no hay módulo común entre
    // páginas, regla 7 de AGENTS.md). Antes estas tags solo recortaban en
    // seco contra el borde, sin ni siquiera puntos suspensivos, porque nunca
    // llevaban `.marquee-cell`/`.marquee-inner`. Cubre las dos réplicas de
    // marcado (fila móvil y columna de escritorio): ambas usan TagWithLink,
    // así que las dos llevan ya las clases, solo falta medir.
    //
    // La medición ya NO se copia aquí (D-233): es la misma función
    // compartida que usa la tabla de Lista, `window.melMedirMarquee()`,
    // definida en Layout.astro. Se le pasan las dos filas de tags de esta
    // página (la fija de móvil y la columna de escritorio).
    function ajustarMarquee() {
      if (!window.melMedirMarquee) return;
      ['#detail-tags-fixed-row', '.event-tags-row'].forEach(sel => {
        document.querySelectorAll(sel).forEach(fila => window.melMedirMarquee(fila));
      });
    }

    medirCabecera();
    ajustarFilaTags();
    alDesplazar();
    ajustarMarquee();
    raizPagina.addEventListener('scroll', alDesplazar, { passive: true, signal: wSig });
    let resizeRaf = null;
    window.addEventListener('resize', () => {
      if (resizeRaf) cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => { medirCabecera(); ajustarFilaTags(); alDesplazar(); ajustarMarquee(); });
    }, { signal: wSig });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { medirCabecera(); ajustarFilaTags(); alDesplazar(); ajustarMarquee(); });
    }

    // Read active navigation vector from sessionStorage.
    // The active vector is maintained by index.astro (initial load, filters,
    // table sort, or map panel click). If absent or stale, falls back to
    // chronological order (allEvents).
    let filteredEvents = [];
    try {
      const storedOrder = sessionStorage.getItem('mel-active-nav-sequence');
      if (storedOrder) {
        const ids = JSON.parse(storedOrder);
        if (Array.isArray(ids) && ids.length > 0) {
          const mapById = new Map(allEvents.map(e => [e.idMel, e]));
          const ordered = ids.map(id => mapById.get(id)).filter(Boolean);
          if (ordered.length > 0) filteredEvents = ordered;
        }
      }
    } catch (err) {
      // Fallback to chronological
    }
    if (filteredEvents.length === 0) filteredEvents = allEvents;

    let curIdx = filteredEvents.findIndex(x => x.idMel === eventId);
    // Fallback: if the current event is not in the stored vector (direct URL
    // access without a session, or stale vector), fall back silently to
    // chronological order so navigation always works.
    if (curIdx === -1) {
      filteredEvents = allEvents;
      curIdx = filteredEvents.findIndex(x => x.idMel === eventId);
    }
    const prevEventItem = curIdx > 0 ? filteredEvents[curIdx - 1] : null;
    const nextEventItem = curIdx < filteredEvents.length - 1 ? filteredEvents[curIdx + 1] : null;

    // Build the correct detail page query param: search, location, and view
    const returnNavParams = new URLSearchParams();
    if (activeView) returnNavParams.set('view', activeView);
    if (activeSearch) returnNavParams.set('search', activeSearch);
    if (activeLocation) returnNavParams.set('location', activeLocation);
    // `sort`/`dir` se arrastran de salto en salto: los pone index.astro al
    // entrar y sin esto se perdían en el primer Anterior/Siguiente, dejando al
    // SSR del siguiente evento ordenando por fecha mientras el cliente usaba
    // la secuencia real. Solo afecta al reparto en servidor, pero es la misma
    // clase de desajuste que provocaba el parpadeo de vecinos equivocados.
    const activeSort = urlParams.get('sort');
    const activeDir = urlParams.get('dir');
    if (activeSort) returnNavParams.set('sort', activeSort);
    if (activeDir) returnNavParams.set('dir', activeDir);
    const navParam = returnNavParams.toString();

    // Helper for smooth View Transitions navigation on click
    const handleNavClick = (e) => {
      const a = e.currentTarget;
      const url = a ? a.getAttribute('href') : null;
      // El marcador SSR nace con href="#" (ver el bloque de navegación): si por
      // lo que sea llega un click antes de que el cliente lo rellene, no se
      // navega a ninguna parte en vez de saltar al principio de la página.
      if (!url || url === '#') { e.preventDefault(); return; }
      if (url && typeof window.__melNavigate === 'function') {
        e.preventDefault();
        window.__melNavigate(url);
      }
    };

    // Render navigation dynamically based on active search/location matches (using visibility:hidden to preserve grid layout!)
    // Precarga de los vecinos. La documentación (D-090) da esto por hecho, pero
    // en esta página no quedaba ni una línea: se perdió en alguna reescritura y
    // el resultado es que al pulsar Anterior/Siguiente la página llegaba y SOLO
    // ENTONCES se pedía la foto — unos 400ms viéndola aparecer a trompicones.
    //
    // Se adelantan las dos cosas y por separado, porque no son lo mismo:
    // `prefetch` trae el HTML de la ficha vecina, y `preload as=image` trae su
    // primera foto, que es lo único que se ve tardar. La foto pesa mucho más que
    // el HTML, así que es la que de verdad cambia la sensación.
    function adelantarVecino(item) {
      if (!item) return;
      const meter = (rel, href, comoImagen) => {
        if (!href || document.querySelector(`link[rel="${rel}"][href="${href}"]`)) return;
        const l = document.createElement('link');
        l.rel = rel;
        l.href = href;
        if (comoImagen) {
          l.as = 'image';
          l.referrerPolicy = 'no-referrer';
          // Sin esto, la precarga pedía w1000 y la ficha vecina, en un móvil,
          // elegía w1400 de su srcset: dos descargas y el aviso de «precarga
          // no usada» en la consola (D-296).
          if (comoImagen.srcset) { l.imageSrcset = comoImagen.srcset; l.imageSizes = tamanosFicha; }
        }
        document.head.appendChild(l);
      };
      // El HTML, con la función común de Layout.astro (D-299): `<link
      // rel="prefetch">` no funciona en ningún iPhone. Y con la MISMA dirección
      // que el enlace de Anterior/Siguiente, `?…` incluido: se precargaba
      // `/event/ID` a secas, la navegación pedía `/event/ID?view=…`, y para la
      // caché son dos páginas distintas — la precarga no se usaba nunca.
      if (typeof window.__melPrecargar === 'function') window.__melPrecargar(`/event/${item.idMel}?${navParam}`);
      // `fotoUrl` la resuelve el servidor al construir `allEvents` — ver el
      // comentario de ahí: esta línea llamaba a extractDriveImage(), que no
      // existe en el cliente, sobre un carruselItems que tampoco se pasaba.
      if (item.fotoUrl) meter('preload', item.fotoUrl, { srcset: item.fotoSrcset });
    }

    const prevContainer = document.getElementById('nav-prev-container');
    if (prevContainer) {
      if (prevEventItem) {
        prevContainer.classList.remove('invisible');
        const link = prevContainer.querySelector('a');
        const text = prevContainer.querySelector('.tag-count-val');
        if (link) {
          link.href = `/event/${prevEventItem.idMel}?${navParam}`;
          link.addEventListener('click', handleNavClick, { signal: wSig });
        }
        if (text) text.textContent = prevEventItem.title;
      } else {
        prevContainer.classList.add('invisible');
        // Se neutraliza también el href: si no, queda un enlace obsoleto (del
        // SSR o del evento anterior) escondido pero vivo bajo el contenedor.
        const deadLink = prevContainer.querySelector('a');
        if (deadLink) deadLink.href = '#';
      }
    }

    adelantarVecino(prevEventItem);
    adelantarVecino(nextEventItem);

    const nextContainer = document.getElementById('nav-next-container');
    if (nextContainer) {
      if (nextEventItem) {
        nextContainer.classList.remove('invisible');
        const link = nextContainer.querySelector('a');
        const text = nextContainer.querySelector('.tag-count-val');
        if (link) {
          link.href = `/event/${nextEventItem.idMel}?${navParam}`;
          link.addEventListener('click', handleNavClick, { signal: wSig });
        }
        if (text) text.textContent = nextEventItem.title;
      } else {
        nextContainer.classList.add('invisible');
        // Se neutraliza también el href: si no, queda un enlace obsoleto (del
        // SSR o del evento anterior) escondido pero vivo bajo el contenedor.
        const deadLink = nextContainer.querySelector('a');
        if (deadLink) deadLink.href = '#';
      }
    }

    // La caja ENTERA de Anterior/Siguiente responde al toque (D-299), no solo
    // el título. En un móvil el enlace era el texto del título, 77-104 × 27 px
    // (Apple pide 44 × 44), y su halo de `mel-link-hit-expand` no servía: lo
    // recorta la `marquee-cell` que corta los títulos largos. Medido: solo
    // respondía el 7-13 % de la caja, y el propietario veía que «me hace caso
    // la mitad de las veces». Un toque en cualquier otro punto de la caja (la
    // palabra «Anterior», el hueco junto al título) hace lo mismo que el título.
    [prevContainer, nextContainer].forEach((caja) => {
      if (!caja) return;
      caja.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;   // el propio enlace ya navega
        // Con ratón, no: en escritorio la caja es mucho más ancha que el
        // enlace (y el halo del enlace sí funciona allí), así que su zona vacía
        // no debe navegar. Y Cmd/Ctrl/Mayús-clic se deja al navegador.
        if (window.matchMedia('(pointer: fine)').matches || e.metaKey || e.ctrlKey || e.shiftKey) return;
        const enlace = caja.querySelector('a');
        if (enlace && enlace.getAttribute('href') && enlace.getAttribute('href') !== '#') enlace.click();
      }, { signal: wSig });
    });

    // El bloque entero (divisor + espacio reservado) corrige aquí el cálculo
    // de partida hecho en el servidor con el orden cronológico: la secuencia
    // real (búsqueda, local del mapa...) puede no tener vecinos aunque SÍ los
    // haya cronológicamente, o al revés. Sin esto quedaba una línea y un hueco
    // sin nada que navegar cuando el contexto activo era de un solo evento.
    const navBlock = document.getElementById('detail-nav-block');
    if (navBlock) navBlock.style.display = (prevEventItem || nextEventItem) ? '' : 'none';

    // --- Compartir (D-306) -------------------------------------------------
    // Teléfono y tableta: la hoja de compartir del sistema; si no la hay (el
    // servidor de pruebas por http, algún navegador raro) o falla, se copia el
    // enlace y lo dice el whisper. Escritorio: copia directamente y el botón
    // pasa a «Copiado» (la hoja del sistema en un ordenador taparía el botón).
    // Siempre la dirección oficial (`canonical`, D-303): sin `?view=` ni
    // `?search=`, así todas las veces que se comparte un evento son el mismo
    // enlace y las apps reutilizan su vista previa.
    const enlaceOficial = () => {
      const canonica = document.querySelector('link[rel="canonical"]');
      return canonica ? canonica.href : location.origin + location.pathname;
    };

    async function copiarEnlace(texto) {
      // El portapapeles moderno solo existe en https (y localhost). Si no está,
      // el fallo es síncrono y el método antiguo corre aún dentro del toque,
      // que es lo que exige el navegador para copiar.
      try { await navigator.clipboard.writeText(texto); return true; } catch (err) {}
      const area = document.createElement('textarea');
      area.value = texto;
      area.setAttribute('readonly', '');
      area.style.cssText = 'position:fixed;top:0;left:0;opacity:0;font-size:16px;';
      document.body.appendChild(area);
      area.select();
      area.setSelectionRange(0, texto.length);   // iOS no se fía de select()
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (err) {}
      area.remove();
      return ok;
    }

    let relojAviso = null;
    function avisar(texto) {
      const w = document.getElementById('whisper');
      const t = document.getElementById('whisper-texto');
      if (!w || !t) return;
      t.textContent = texto;
      // En la portada lo coloca `colocarWhisper()` junto al botón de orden;
      // aquí no hay botón: centrado abajo, con 24 px de margen a cada lado.
      w.style.left = '50%';
      w.style.translate = '-50% 0';
      w.style.maxWidth = 'calc(100vw - 48px)';
      w.dataset.visible = 'true';
      clearTimeout(relojAviso);
      relojAviso = setTimeout(() => { w.dataset.visible = 'false'; }, 3000);
    }

    // Compartir ⇄ ✓ (ver el icono `share` de Icon.astro). Con «reducir
    // movimiento» la animación dura 1 ms: es un cambio de golpe. No se escriben
    // los puntos a mano porque, si ya corrió una animación con `fill="freeze"`,
    // su valor congelado taparía lo escrito.
    function transformarIconoCompartir(boton, aCheck) {
      boton.classList.toggle('mel-copiado', aCheck);
      const anim = boton.querySelector(aCheck ? '.mel-a-check' : '.mel-a-share');
      if (!anim) return;
      const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      anim.setAttribute('dur', reducir ? '1ms' : '300ms');
      anim.beginElement();
    }

    const COPIADO_MS = 2000;
    function confirmarCopiado(boton) {
      const texto = boton.querySelector('.boton-compartir-texto');
      if (!boton.classList.contains('mel-copiado')) {
        transformarIconoCompartir(boton, true);
        if (texto) texto.textContent = 'Copiado';
      }
      clearTimeout(boton._melRelojCopiado);
      boton._melRelojCopiado = setTimeout(() => {
        transformarIconoCompartir(boton, false);
        if (texto) texto.textContent = 'Compartir';
      }, COPIADO_MS);
    }

    const botonCompartirMovil = document.getElementById('detail-share-btn');
    if (botonCompartirMovil) {
      botonCompartirMovil.addEventListener('click', async () => {
        const url = enlaceOficial();
        try {
          if (navigator.share) {
            try {
              await navigator.share({ title: document.title, url });
              return;
            } catch (err) {
              // Cerrar la hoja sin elegir nada no es un fallo.
              if (err && err.name === 'AbortError') return;
            }
          }
          if (await copiarEnlace(url)) {
            confirmarCopiado(botonCompartirMovil);
            avisar('Enlace copiado');
          } else {
            avisar('No se pudo copiar el enlace');
          }
        } finally {
          // El pulsado táctil (D-274) espera a una navegación que aquí no llega.
          botonCompartirMovil.classList.remove('mel-pulsado');
        }
      }, { signal: wSig });
    }

    const botonCompartir = document.getElementById('btn-compartir');
    if (botonCompartir) {
      botonCompartir.addEventListener('click', async () => {
        if (await copiarEnlace(enlaceOficial())) confirmarCopiado(botonCompartir);
        else avisar('No se pudo copiar el enlace');
      }, { signal: wSig });
    }

    // Interactive Carousel Image Swap with horizontal sliding transition
    let currentIndex = 0;

    // Crucial: Clear any running autoplay interval on script mount to avoid cumulative loops
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }

    function updateCarousel(index) {
      if (!imageUrls || imageUrls.length === 0) return;
      
      // Wrap index around boundaries
      currentIndex = (index + imageUrls.length) % imageUrls.length;
      
      // Slide the track using CSS transform
      const track = document.getElementById('carousel-track');
      if (track) {
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;
      }

      // Toggle dots active attributes
      const dots = document.querySelectorAll('.carousel-dot');
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.setAttribute('data-active', isActive ? 'true' : 'false');
      });
    }

    // Autoplay function (only runs if there are multiple images)
    function startAutoplay() {
      if (!imageUrls || imageUrls.length <= 1) return;
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
      }
      window.melAutoplayInterval = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);
    }

    function resetAutoplayTimer() {
      startAutoplay();
    }

    // Large Image Overlay Lightbox. The modal is a fixed-size CSS box (see
    // markup) and the photo object-contains inside it — no JS sizing off
    // the image's natural dimensions, which is what previously let large
    // photos push the modal beyond the screen.
    const overlay = document.getElementById('image-detail-overlay');
    const overlayModal = document.getElementById('image-detail-modal');
    const overlayTrack = document.getElementById('overlay-track');
    const pistaCarrusel = document.getElementById('carousel-track');
    const overlayCloseBtn = document.getElementById('overlay-close-btn');
    const overlayDots = document.querySelectorAll('.overlay-dot');

    let overlayIndex = 0;
    // El visor a pantalla completa y con zoom (D-305) es del teléfono.
    const esTelefono = () => window.innerWidth < 480;

    // Zoom del visor (D-305): estado del cartel ampliado. Vive aquí arriba, y
    // no dentro de `habilitarZoom()`, porque pasar de foto y cerrar el visor
    // tienen que dejarlo a cero, y el paso de foto necesita saber si el gesto
    // es del zoom. `dedosZoom` = los dedos que hay ahora mismo sobre el cartel.
    let zoomEscala = 1, zoomX = 0, zoomY = 0;
    const dedosZoom = new Map();
    function quitarZoom() {
      zoomEscala = 1; zoomX = 0; zoomY = 0;
      overlayTrack?.querySelectorAll('img').forEach((img) => { img.style.transform = ''; img.style.transition = ''; });
    }

    // Same sliding-track transition as the main carousel, but this never autoplays on its own
    function showOverlayImage(idx) {
      if (!imageUrls || imageUrls.length === 0) return;
      quitarZoom();
      overlayIndex = (idx + imageUrls.length) % imageUrls.length;
      // En el teléfono el visor es para ampliar con los dedos (D-305): la foto
      // que se ve pasa a la de 2000 px (`400vw` hace que el navegador la elija
      // del `srcset`), como cuando el cartel se abría suelto en otra pestaña.
      // Solo ESA: las demás se quedan con la que la ficha ya tiene descargada
      // (hay eventos de 7 carteles: serían ~3 MB al abrir). Mientras llega la
      // grande se sigue viendo la de la ficha, sin hueco.
      if (esTelefono()) {
        const grande = overlayTrack?.querySelectorAll('img')[overlayIndex];
        if (grande && grande.srcset) grande.sizes = '400vw';
      }
      if (overlayTrack) overlayTrack.style.transform = `translate3d(-${overlayIndex * 100}%, 0, 0)`;
      overlayDots.forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === overlayIndex ? 'true' : 'false');
      });
    }

    // Left/right arrow keys navigate images while lightbox is open, or navigate events when lightbox is closed
    function handleOverlayKeydown(e) {
      const isInput = e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable);
      if (isInput) return;

      if (overlay && !overlay.classList.contains('hidden')) {
        // Lightbox open: navigate carousel photos
        if (e.key === 'ArrowLeft') { e.preventDefault(); showOverlayImage(overlayIndex - 1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); showOverlayImage(overlayIndex + 1); }
      } else {
        // Normal page view: navigate Previous / Next event
        if (e.key === 'ArrowLeft' && prevEventItem) {
          e.preventDefault();
          const url = `/event/${prevEventItem.idMel}?${navParam}`;
          if (typeof window.__melNavigate === 'function') window.__melNavigate(url);
          else window.location.href = url;
        } else if (e.key === 'ArrowRight' && nextEventItem) {
          e.preventDefault();
          const url = `/event/${nextEventItem.idMel}?${navParam}`;
          if (typeof window.__melNavigate === 'function') window.__melNavigate(url);
          else window.location.href = url;
        }
      }
    }
    document.addEventListener('keydown', handleOverlayKeydown, { signal: wSig });

    let retirada = 0;   // el reloj del cierre (300 ms de fundido)

    // Vuelo del cartel entre la ficha y el visor (D-313), con la transición del
    // navegador dentro de la misma página: no hay cambio de página, así que la
    // ficha sigue debajo y la vuelta es tan fiable como la ida. `de` lleva el
    // nombre `mel-visor` en la foto vieja y `a` en la nueva; el resto de
    // carteles se quedan sin nombre mientras tanto (el primero lleva el del
    // morphing desde la galería y, con nombre, se pintaría ENCIMA del fondo
    // oscuro del visor). `cambio()` deja la página en su estado final sin
    // transiciones CSS propias: la foto nueva es en vivo y se verían.
    // Sin la función en el navegador, o con «reducir movimiento», devuelve
    // false y quien llama hace lo de siempre.
    function volarVisor(de, a, cambio) {
      if (!document.startViewTransition || !de || !a) return false;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
      const imgs = [...document.querySelectorAll('#carousel-track img, #overlay-track img')];
      const nombres = imgs.map((img) => img.style.viewTransitionName);
      const raiz = document.documentElement;
      imgs.forEach((img) => { img.style.viewTransitionName = 'none'; });
      de.style.viewTransitionName = 'mel-visor';
      raiz.classList.add('mel-visor-vt');
      const piezas = [overlay, overlayModal, overlayTrack, pistaCarrusel];
      const vt = document.startViewTransition(() => {
        de.style.viewTransitionName = 'none';
        piezas.forEach((el) => { if (el) el.style.transition = 'none'; });
        cambio();
        a.style.viewTransitionName = 'mel-visor';
      });
      vt.finished.finally(() => {
        raiz.classList.remove('mel-visor-vt');
        imgs.forEach((img, i) => { img.style.viewTransitionName = nombres[i]; });
        piezas.forEach((el) => { if (el) el.style.transition = ''; });
      });
      return true;
    }

    // Mientras llega la foto del visor (va con `loading="lazy"` y otro tamaño),
    // se pinta de fondo la que ya enseña la ficha, en caché: así el cartel que
    // vuela nunca está vacío. Mismo truco que la ficha con el de la galería.
    function fondoMientrasCarga(destino, origen) {
      if (!destino || destino.complete || !origen || !origen.currentSrc) return;
      Object.assign(destino.style, { backgroundImage: `url("${origen.currentSrc}")`, backgroundSize: 'contain', backgroundPosition: 'center', backgroundRepeat: 'no-repeat' });
      destino.addEventListener('load', () => {
        Object.assign(destino.style, { backgroundImage: '', backgroundSize: '', backgroundPosition: '', backgroundRepeat: '' });
      }, { once: true });
    }

    function openOverlay() {
      if (!overlay || !overlayModal) return;
      // Si se vuelve a abrir mientras se apaga (los 300 ms del cierre), el
      // reloj del cierre lo escondería recién abierto.
      clearTimeout(retirada);

      // Stop autoplay when large view is open
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
        window.melAutoplayInterval = null;
      }

      // Open on whichever image the page carousel is showing
      const de = pistaCarrusel?.querySelectorAll('img')[currentIndex];
      const a = overlayTrack?.querySelectorAll('img')[currentIndex];
      fondoMientrasCarga(a, de);
      const abierto = () => {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        overlayModal.classList.remove('scale-95');
        overlayModal.classList.add('scale-100');
      };
      const vuela = volarVisor(de, a, () => {
        showOverlayImage(currentIndex);
        overlay.classList.remove('hidden');
        abierto();
      });
      if (vuela) return;
      showOverlayImage(currentIndex);
      overlay.classList.remove('hidden');
      setTimeout(abierto, 10);
    }

    function closeOverlay() {
      if (!overlay || !overlayModal) return;
      quitarZoom();
      dedosZoom.clear();

      // De vuelta a la ficha, volando, si el visor enseña la misma foto que el
      // carrusel; si se ha pasado a otra, se cierra como siempre (la ficha
      // enseña otra foto y el vuelo sería de un cartel a otro).
      if (overlayIndex === currentIndex) {
        const vuela = volarVisor(
          overlayTrack?.querySelectorAll('img')[overlayIndex],
          pistaCarrusel?.querySelectorAll('img')[currentIndex],
          () => {
            overlay.classList.remove('opacity-100', 'pointer-events-auto');
            overlay.classList.add('opacity-0', 'pointer-events-none', 'hidden');
            overlayModal.classList.remove('scale-100');
            overlayModal.classList.add('scale-95');
          },
        );
        if (vuela) { clearTimeout(retirada); startAutoplay(); return; }
      }

      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlayModal.classList.remove('scale-100');
      overlayModal.classList.add('scale-95');

      retirada = setTimeout(() => {
        overlay.classList.add('hidden');
        // Resume autoplay
        startAutoplay();
      }, 300);
    }

    // Click on main image container opens the lightbox — desktop only.
    // Below `lg` it instead re-expands the pinned box (animates the scroll
    // back to the top, which un-shrinks the crop 1:1) if it's currently
    // compressed by scroll, and does nothing otherwise. Hand-rolled
    // timer-driven animation — mirrors the overlay in index.astro, where
    // native smooth scrolling silently no-ops in some environments and
    // requestAnimationFrame never ticks in some sandboxed/throttled
    // contexts, while direct scroll writes always work. Time-based easing,
    // so a slow timer only lowers the frame rate, never the duration.
    const mainImageContainer = document.getElementById('carousel-main-container');
    if (mainImageContainer) {
      mainImageContainer.addEventListener('click', () => {
        if (window.innerWidth < 480) {
          // Con la ficha arriba del todo, el toque abre el visor a pantalla
          // completa, con zoom propio (D-305). Antes abría el cartel como
          // imagen suelta de Google: Chrome la sacaba a otra pestaña, el
          // visitante salía del sitio, y se podía guardar (en escritorio no).
          // El zoom es nuestro porque el pellizco del navegador amplía la
          // página entera, no un elemento: ver `habilitarZoom()`.
          if (raizPagina.scrollTop <= 0) {
            openOverlay();
            return;
          }
          if (raizPagina.scrollTop > 0) {
            const startY = raizPagina.scrollTop;
            const t0 = performance.now();
            const DUR = 350;
            const easeOut = (t) => 1 - Math.pow(1 - t, 3);
            const stepFrame = () => {
              const p = Math.min(1, (performance.now() - t0) / DUR);
              raizPagina.scrollTop = Math.round(startY * (1 - easeOut(p)));
              if (p < 1) setTimeout(stepFrame, 16);
            };
            stepFrame();
          }
          return;
        }
        openOverlay();
      });
    }

    if (overlayCloseBtn) overlayCloseBtn.onclick = () => closeOverlay();
    // Descarga vetada en el visor (D-305): sin menú de «Guardar imagen» con
    // el botón derecho; la pulsación larga del iPhone la quita el CSS de las
    // imágenes (`-webkit-touch-callout: none`) y arrastrarla, `draggable`.
    if (overlay) overlay.addEventListener('contextmenu', (e) => e.preventDefault(), { signal: wSig });
    if (overlay) {
      overlay.onclick = (e) => {
        if (e.target === overlay) closeOverlay();
      };
    }

    // Lightbox pagination dots switch the displayed photo
    overlayDots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        showOverlayImage(parseInt(dot.dataset.index, 10));
      });
    });

    const dots = document.querySelectorAll('.carousel-dot');
    dots.forEach(dot => {
      dot.onclick = (e) => {
        e.stopPropagation();
        const idx = parseInt(dot.dataset.index, 10);
        updateCarousel(idx);
        resetAutoplayTimer();
      };
    });

    // Keep indicators aligned perfectly on window resize
    window.addEventListener('resize', () => {
      updateCarousel(currentIndex);
    }, { signal: wSig });

    // Deslizar con el dedo para cambiar de foto, cuando hay más de una. Se usa
    // tanto en el carrusel de la ficha como en el lightbox, así que la lógica
    // vive aquí una sola vez.
    //
    // Convive con el toque, que sigue haciendo lo suyo (expandir la imagen /
    // volver arriba): solo se considera deslizamiento si el dedo recorre más de
    // 45px en horizontal Y avanza más en horizontal que en vertical — así un
    // scroll vertical sobre la foto no cambia de imagen. Cuando sí ha sido
    // deslizamiento, se suprime el `click` que el navegador dispara después,
    // para no expandir la imagen sin querer al terminar el gesto.
    // La caja de la foto va `position: fixed` porque es lo que hace que la
    // geometría cuadre: el hueco lo reserva un placeholder de alto constante y
    // el contenido pasa por DEBAJO. El precio es que un elemento fijo queda
    // fuera de la cadena de scroll — el navegador busca el ancestro desplazable
    // por la cadena de bloques contenedores, y para un fijo esa cadena acaba en
    // el viewport, que aquí no se desplaza. Arrastrar sobre la foto no movía
    // nada, y con la caja encogida eso es media pantalla muerta.
    //
    // Se probó la vía "correcta" —anclar la columna con `sticky`, que sí está
    // en la cadena— y hubo que revertirla: con la foto en flujo el contenido va
    // DESPUÉS de ella, así que al encoger o queda hueco o la columna encoge y
    // realimenta el scroll (roadmap, problemas conocidos 9 y 10).
    //
    // Así que se reenvía el gesto a mano, sin tocar la geometría. Solo el eje
    // vertical: el horizontal sigue siendo del deslizamiento entre fotos y el
    // toque limpio sigue abriendo el lightbox.
    // Un solo dueño por gesto. El arrastre vertical (de aquí abajo) y el
    // deslizamiento entre fotos deciden su eje con deltas ACUMULADOS y
    // reevalúan en cada movimiento hasta engancharse: en un gesto largo en
    // diagonal acababan enganchándose LOS DOS (primero uno, luego el otro) y
    // peleándose por el mismo dedo — la página desplazándose por debajo de un
    // cambio de foto. El primero que decide eje se queda el gesto entero.
    const ejeGesto = { dueno: null };

    function habilitarArrastreVertical(zona) {
      if (!zona) return;
      const MINIMO = 6;            // por debajo de esto es un toque, no un arrastre
      const ROCE = 0.95;           // frenado de la inercia por fotograma
      const VELOCIDAD_MINIMA = 0.05;
      let y0 = null, x0 = null, scroll0 = 0, arrastrando = false;
      let ultimaY = 0, ultimoT = 0, velocidad = 0, inercia = null, huboArrastre = false;

      // En captura, para llegar antes que el listener que abre la imagen.
      zona.addEventListener('click', (e) => {
        if (!huboArrastre) return;
        huboArrastre = false;
        e.stopPropagation();
        e.preventDefault();
      }, { capture: true, signal: wSig });

      zona.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        if (inercia) { cancelAnimationFrame(inercia); inercia = null; }
        y0 = e.clientY; x0 = e.clientX; scroll0 = raizPagina.scrollTop;
        ultimaY = e.clientY; ultimoT = e.timeStamp; velocidad = 0; arrastrando = false;
        huboArrastre = false;
        ejeGesto.dueno = null;
      }, { signal: wSig });

      zona.addEventListener('pointermove', (e) => {
        if (y0 === null) return;
        const dy = e.clientY - y0;
        // El gesto solo se toma cuando es claramente vertical; si no, se deja
        // pasar para que el deslizamiento entre fotos siga funcionando.
        if (!arrastrando) {
          if (ejeGesto.dueno === 'horizontal') return;
          if (Math.abs(dy) < MINIMO || Math.abs(dy) <= Math.abs(e.clientX - x0)) return;
          arrastrando = true; huboArrastre = true;
          ejeGesto.dueno = 'vertical';
        }
        const dt = e.timeStamp - ultimoT;
        if (dt > 0) velocidad = (e.clientY - ultimaY) / dt;
        ultimaY = e.clientY; ultimoT = e.timeStamp;
        raizPagina.scrollTop = scroll0 - dy;
      }, { signal: wSig });

      const soltar = () => {
        if (y0 === null) return;
        const iba = arrastrando;
        y0 = null; x0 = null; arrastrando = false;
        if (!iba || Math.abs(velocidad) < VELOCIDAD_MINIMA) return;
        // Inercia propia: sin ella el desplazamiento se corta en seco al
        // levantar el dedo y se nota que esa zona va aparte del resto.
        let v = velocidad * 16;
        const paso = () => {
          raizPagina.scrollTop -= v;
          v *= ROCE;
          inercia = Math.abs(v) > 0.5 ? requestAnimationFrame(paso) : null;
        };
        inercia = requestAnimationFrame(paso);
      };
      zona.addEventListener('pointerup', soltar, { signal: wSig });
      zona.addEventListener('pointercancel', soltar, { signal: wSig });
    }

    // Antes el dedo no movía nada: se acumulaba el arrastre en silencio y solo
    // al soltar saltaba de golpe a la foto siguiente con una transición de
    // 500ms — de ahí que se notara "del tirón" en vez de fino. Ahora la pista
    // sigue el dedo en vivo (sin transición CSS mientras se arrastra, para que
    // el seguimiento sea 1:1) y solo al soltar se reactiva la transición para
    // el asentado, ya sea completando el cambio de foto o volviendo a la
    // actual. `track` es el elemento que de verdad se desplaza (el propio
    // `zona` solo delimita la zona táctil).
    // `cedido()` (opcional): mientras devuelva true, el gesto es de otro —el
    // zoom del visor— y aquí no se desliza nada.
    function habilitarDeslizamiento(zona, track, irA, indiceActual, cedido = () => false) {
      if (!zona || !track || !imageUrls || imageUrls.length <= 1) return;

      const MINIMO = 45;
      let x0 = null, y0 = null, dxUltimo = 0, dyUltimo = 0, huboDeslizamiento = false, arrastrando = false;

      // `none`, no `pan-y`: aquí el navegador no pinta nada. Con `auto` se
      // quedaba TODO el gesto (pointercancel inmediato, el deslizamiento no
      // ocurría nunca); con `pan-y` cedíamos el eje vertical… y eso dejaba a
      // Safari quedarse el gesto A MITAD cuando el dedo derivaba en diagonal:
      // `pointercancel`, y nuestro `resolver` contaba el recorrido horizontal
      // acumulado como deslizamiento válido — el "cambia del tirón" de móvil
      // real. Y en el inspector, Chrome reclamaba el pan vertical al instante
      // sobre una caja fija que no tiene nada que desplazar: zona muerta.
      // El eje vertical no lo perdemos por quitárselo al navegador porque
      // sobre la foto NUNCA fue suyo — la caja es fija y el scroll nativo no
      // la atraviesa; lo reenvía a mano `habilitarArrastreVertical` (arriba),
      // que sigue recibiendo los eventos. Los dos ejes son nuestros.
      zona.style.touchAction = 'none';

      // Resistencia elástica: arrastrar hacia un lado sin fotos deja hueco de
      // sobra (un tercio del recorrido real) para notar que el gesto SÍ se ha
      // recibido, sin dar la vuelta ni desplazarse como si hubiera algo detrás.
      function amortiguar(dx, puedeAvanzar, puedeRetroceder) {
        const saliendoPorDerecha = dx > 0 && !puedeRetroceder;
        const saliendoPorIzquierda = dx < 0 && !puedeAvanzar;
        return (saliendoPorDerecha || saliendoPorIzquierda) ? dx / 3 : dx;
      }

      const resolver = () => {
        if (x0 === null) return;
        x0 = null; y0 = null;
        const fueArrastre = arrastrando;
        arrastrando = false;
        // Reactiva la transición del CSS para el asentado — completar el
        // cambio o volver a la foto actual, ambos animados, ninguno un salto.
        track.style.transition = '';
        // Fuerza un reflow ANTES de tocar el transform: reactivar la
        // transición y cambiar el valor en el mismo instante puede hacer que
        // el navegador aplique el cambio de golpe, sin animar, como si nunca
        // hubiera pasado por 'none' — el "a veces salta sin transición" que
        // se veía. Leer una propiedad de layout aquí obliga al navegador a
        // asentar el 'none' antes de que el siguiente transform cuente.
        void track.offsetWidth;
        if (!fueArrastre) return;

        const base = -indiceActual() * 100;
        // Solo cuenta el recorrido horizontal: el eje ya se decidió al
        // engancharse (cerrojo `ejeGesto`), así que comparar aquí contra el
        // vertical era volver a juzgar un gesto ya adjudicado — un arrastre
        // horizontal amplio con deriva vertical hacía snap-back en vez de
        // cambiar de foto.
        if (Math.abs(dxUltimo) < MINIMO) {
          track.style.transform = `translate3d(${base}%, 0, 0)`;
          return;
        }
        // En los extremos NO se da la vuelta: seguir arrastrando más allá de la
        // última foto volvía a la primera de golpe, y eso mareaba más que
        // simplemente no moverse (el autoplay sigue dando la vuelta él solo).
        const siguiente = indiceActual() + (dxUltimo < 0 ? 1 : -1);
        if (siguiente < 0 || siguiente >= imageUrls.length) {
          track.style.transform = `translate3d(${base}%, 0, 0)`;
          return;
        }
        huboDeslizamiento = true;
        irA(siguiente);   // arrastrar a la izquierda = siguiente
      };

      // Ancho de una foto, en píxeles — medido UNA vez al empezar el gesto,
      // no en cada movimiento. Con el transform en `calc(-100% + Npx)` el
      // navegador tenía que resolver el porcentaje contra el layout en cada
      // fotograma del arrastre (no puede quedar todo en la GPU), y eso es
      // justo lo que se notaba "a trompicones" en el móvil real. En píxeles
      // puros el compositor lo lleva sin tocar el hilo principal.
      let anchoFoto = 0;

      zona.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;   // con ratón mandan las flechas y los puntos
        // Un segundo dedo (un pellizco en el visor) no empieza otro
        // deslizamiento: termina el que hubiera, con la pista de vuelta en su
        // sitio. Si no, se reiniciaba con el dedo nuevo y la pista se quedaba
        // a medio camino, enseñando media foto siguiente (lo cazó la revisión).
        if (x0 !== null) {
          if (arrastrando) {
            track.style.transition = '';
            void track.offsetWidth;
            track.style.transform = `translate3d(${-indiceActual() * 100}%, 0, 0)`;
          }
          x0 = null; arrastrando = false;
          return;
        }
        x0 = e.clientX; y0 = e.clientY;
        dxUltimo = 0; dyUltimo = 0; huboDeslizamiento = false; arrastrando = false;
        // También aquí, no solo en el arrastre vertical: el lightbox usa esta
        // misma función y no tiene gestor vertical que le limpie el cerrojo.
        ejeGesto.dueno = null;
        anchoFoto = zona.getBoundingClientRect().width;
      }, { signal: wSig });

      // El recorrido se acumula aquí y no se lee del evento final: si el
      // navegador acaba cancelando el gesto, `pointercancel` no trae posición.
      zona.addEventListener('pointermove', (e) => {
        if (x0 === null) return;
        if (cedido()) {
          // Llega un segundo dedo (pellizco) o el cartel ya está ampliado: si
          // la pista se había empezado a mover, vuelve a su sitio.
          if (arrastrando) {
            arrastrando = false;
            track.style.transition = '';
            void track.offsetWidth;
            track.style.transform = `translate3d(${-indiceActual() * 100}%, 0, 0)`;
          }
          x0 = null;
          return;
        }
        dxUltimo = e.clientX - x0;
        dyUltimo = e.clientY - y0;

        if (!arrastrando) {
          // Sin decidir el eje todavía: un temblor mínimo no cuenta como
          // gesto, y si domina el vertical es scroll de página, no nuestro.
          if (ejeGesto.dueno === 'vertical') return;
          if (Math.max(Math.abs(dxUltimo), Math.abs(dyUltimo)) < 6) return;
          if (Math.abs(dxUltimo) <= Math.abs(dyUltimo)) return;
          arrastrando = true;
          ejeGesto.dueno = 'horizontal';
          track.style.transition = 'none';
        }

        const puedeRetroceder = indiceActual() > 0;
        const puedeAvanzar = indiceActual() < imageUrls.length - 1;
        const dx = amortiguar(dxUltimo, puedeAvanzar, puedeRetroceder);
        const basePx = -indiceActual() * anchoFoto;
        track.style.transform = `translate3d(${basePx + dx}px, 0, 0)`;
      }, { signal: wSig });

      zona.addEventListener('pointerup', resolver, { signal: wSig });
      // Un gesto cancelado que ya había recorrido lo suficiente cuenta igual:
      // de lo contrario el deslizamiento se perdería justo en los navegadores
      // que cancelan antes.
      zona.addEventListener('pointercancel', resolver, { signal: wSig });

      // Va en captura para llegar antes que el listener de expandir.
      zona.addEventListener('click', (e) => {
        if (!huboDeslizamiento) return;
        huboDeslizamiento = false;
        e.preventDefault();
        e.stopPropagation();
      }, { capture: true, signal: wSig });
    }

    habilitarDeslizamiento(mainImageContainer, document.getElementById('carousel-track'), (i) => { updateCarousel(i); startAutoplay(); }, () => currentIndex);
    habilitarDeslizamiento(document.getElementById('overlay-image-box'), overlayTrack, showOverlayImage, () => overlayIndex,
      () => zoomEscala > 1 || dedosZoom.size > 1);
    habilitarZoom(document.getElementById('overlay-image-box'));

    // Zoom del visor con los dedos (D-305): pellizco (hasta ×4), doble toque
    // (×2,5 donde se toca; otro doble toque, vuelta) y, ampliado, arrastrar con
    // un dedo. Sin ampliar, el dedo es del paso de foto (`cedido` de arriba).
    // Solo táctil: con ratón no hace nada. Se mueve la <img> de la foto que se
    // ve, con `translate` + `scale` desde su centro; los límites impiden que
    // el cartel se despegue de los bordes de la caja.
    // Los oyentes van en CAPTURA para ir antes que los del deslizamiento, que
    // están en la misma caja y preguntan por `dedosZoom` y `zoomEscala`.
    function habilitarZoom(zona) {
      if (!zona) return;
      const MAXIMO = 4, DOBLE = 2.5, DOBLE_MS = 300, DOBLE_PX = 30, TEMBLOR_PX = 10;
      let inicio = null;           // cómo estaba todo al empezar el gesto (o al cambiar de dedos)
      let maxDedos = 0, movido = false, ultimoToque = 0, ultimoX = 0, ultimoY = 0;
      const imagen = () => overlayTrack?.querySelectorAll('img')[overlayIndex];

      // Cuánto se puede mover el cartel ampliado a cada lado sin despegarse:
      // la mitad de lo que el cartel VISIBLE (object-contain) sobresale de la caja.
      function aplicar(animado) {
        const img = imagen();
        if (!img) return;
        const r = zona.getBoundingClientRect();
        // Sin la imagen grande aún cargada no se conocen sus medidas: no se
        // limita, y se vuelve a ajustar en cuanto llegue (si no, el pellizco
        // ampliaba siempre desde el centro y no desde los dedos).
        let limX = Infinity, limY = Infinity;
        if (!img.complete) img.addEventListener('load', () => aplicar(false), { once: true });
        if (img.naturalWidth && img.naturalHeight) {
          const k = Math.min(r.width / img.naturalWidth, r.height / img.naturalHeight);
          limX = Math.max(0, (img.naturalWidth * k * zoomEscala - r.width) / 2);
          limY = Math.max(0, (img.naturalHeight * k * zoomEscala - r.height) / 2);
        }
        zoomX = Math.max(-limX, Math.min(limX, zoomX));
        zoomY = Math.max(-limY, Math.min(limY, zoomY));
        img.style.transition = animado ? 'transform 250ms ease-out' : 'none';
        img.style.transform = zoomEscala === 1 && !zoomX && !zoomY ? '' : `translate3d(${zoomX}px, ${zoomY}px, 0) scale(${zoomEscala})`;
      }

      function foto() {
        const r = zona.getBoundingClientRect();
        const [a, b] = [...dedosZoom.values()];
        const mx = b ? (a.x + b.x) / 2 : a.x, my = b ? (a.y + b.y) / 2 : a.y;
        inicio = {
          escala: zoomEscala, x: zoomX, y: zoomY, mx, my,
          d: b ? Math.hypot(b.x - a.x, b.y - a.y) : 0,
          cx: r.left + r.width / 2, cy: r.top + r.height / 2,
        };
      }

      // Al girar el teléfono cambia la caja: se reajusta lo ampliado.
      window.addEventListener('resize', () => { if (zoomEscala > 1) aplicar(false); }, { signal: wSig });

      zona.addEventListener('pointerdown', (e) => {
        // Solo en el teléfono: en tablet el visor se queda como estaba.
        if (e.pointerType === 'mouse' || !esTelefono()) return;
        if (!dedosZoom.size) { maxDedos = 0; movido = false; }
        dedosZoom.set(e.pointerId, { x: e.clientX, y: e.clientY });
        maxDedos = Math.max(maxDedos, dedosZoom.size);
        foto();
      }, { capture: true, signal: wSig });

      zona.addEventListener('pointermove', (e) => {
        if (!dedosZoom.has(e.pointerId) || !inicio) return;
        dedosZoom.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const [a, b] = [...dedosZoom.values()];
        if (b) {
          // Pellizco: el punto del cartel que estaba bajo el centro de los dos
          // dedos se queda bajo ese centro, aunque los dedos se desplacen.
          const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
          zoomEscala = Math.max(1, Math.min(MAXIMO, inicio.escala * Math.hypot(b.x - a.x, b.y - a.y) / (inicio.d || 1)));
          const f = zoomEscala / inicio.escala;
          zoomX = (mx - inicio.cx) - f * (inicio.mx - inicio.cx - inicio.x);
          zoomY = (my - inicio.cy) - f * (inicio.my - inicio.cy - inicio.y);
          movido = true;
          aplicar(false);
        } else if (zoomEscala > 1) {
          zoomX = inicio.x + (a.x - inicio.mx);
          zoomY = inicio.y + (a.y - inicio.my);
          aplicar(false);
        }
        if (Math.hypot(a.x - inicio.mx, a.y - inicio.my) > TEMBLOR_PX) movido = true;
      }, { capture: true, signal: wSig });

      const soltar = (e) => {
        if (!dedosZoom.delete(e.pointerId)) return;
        if (dedosZoom.size) { foto(); return; }   // queda un dedo: sigue moviendo desde aquí
        inicio = null;
        if (zoomEscala < 1.05) { zoomEscala = 1; zoomX = 0; zoomY = 0; aplicar(true); }
        // Doble toque: dos toques de un dedo, sin desplazarse, cerca y seguidos.
        if (e.type !== 'pointerup' || maxDedos > 1 || movido) { ultimoToque = 0; return; }
        if (e.timeStamp - ultimoToque < DOBLE_MS && Math.hypot(e.clientX - ultimoX, e.clientY - ultimoY) < DOBLE_PX) {
          ultimoToque = 0;
          if (zoomEscala > 1) { zoomEscala = 1; zoomX = 0; zoomY = 0; }
          else {
            const r = zona.getBoundingClientRect();
            zoomEscala = DOBLE;
            zoomX = (1 - DOBLE) * (e.clientX - (r.left + r.width / 2));
            zoomY = (1 - DOBLE) * (e.clientY - (r.top + r.height / 2));
          }
          aplicar(true);
        } else {
          ultimoToque = e.timeStamp; ultimoX = e.clientX; ultimoY = e.clientY;
        }
      };
      zona.addEventListener('pointerup', soltar, { capture: true, signal: wSig });
      zona.addEventListener('pointercancel', soltar, { capture: true, signal: wSig });
    }

    // El autoplay (cada 5s) no debe competir con un arrastre en curso: si el
    // temporizador caía a mitad de un gesto, cambiaba currentIndex y el
    // transform por debajo del propio arrastre en vivo (sin transición, de
    // golpe) — eso es lo que se notaba a trompicones después de varias
    // pasadas seguidas, cuanto más se repetía el gesto más probable era que
    // coincidiera con el tic de los 5s. Se para nada más tocar la foto y se
    // reinicia al soltar, haya cambiado de foto o no.
    if (mainImageContainer) {
      mainImageContainer.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;
        if (window.melAutoplayInterval) {
          clearInterval(window.melAutoplayInterval);
          window.melAutoplayInterval = null;
        }
      }, { signal: wSig });
      const reanudarAutoplay = (e) => {
        if (e.pointerType === 'mouse') return;
        startAutoplay();
      };
      mainImageContainer.addEventListener('pointerup', reanudarAutoplay, { signal: wSig });
      mainImageContainer.addEventListener('pointercancel', reanudarAutoplay, { signal: wSig });
    }
    // El arrastre vertical se engancha a TODA la caja fija, no solo a la foto:
    // la paginación y el faldón también son zona muerta si no.
    habilitarArrastreVertical(document.getElementById('detail-image-sticky'));

    // Y la RUEDA del ratón, aparte: el reenvío de arriba escucha dedo
    // (descarta `pointerType === 'mouse'`) y la rueda ni siquiera es un
    // pointer. En escritorio con la ventana estrecha, en cuanto la caja se
    // fija la rueda encima de ella muere — para un `fixed` la cadena de
    // scroll acaba en el viewport, que aquí no se desplaza (el scroll vive
    // en `#detail-page-container`). Solo actúa con la caja fijada: en flujo
    // el scroll nativo ya funciona y reenviar encima lo duplicaría.
    if (cajaFoto) {
      cajaFoto.addEventListener('wheel', (e) => {
        if (!raizPagina.classList.contains('fijada')) return;
        // deltaMode 1 = líneas (Firefox); a píxeles con el alto de línea usual.
        raizPagina.scrollTop += e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
        e.preventDefault();
      }, { passive: false, signal: wSig });
    }

    // Initialize carousel and autoplay
    if (imageUrls && imageUrls.length > 0) {
      updateCarousel(0);
      startAutoplay();
    }
  }

  // Bind carousel and listener init to page-load so it functions perfectly on
  // transition navigation.
  //
  // El registro es IDEMPOTENTE, y sin eso se acumulaba. El script en línea de
  // esta página se **reevalúa en cada navegación suave** a otra ficha, mientras
  // que `document` sobrevive al intercambio: cada visita dejaba enganchada otra
  // copia de initPage(), y en el siguiente page-load corrían todas. Como el
  // listener del cartel no se limpiaba, un solo toque abría tantas pestañas como
  // fichas se hubieran recorrido — el propietario llegó a 21.
  //
  // Medido antes de arreglarlo: `astro:page-load` dispara UNA vez por
  // navegación, y aun así un toque abría 4 pestañas tras 4 fichas. O sea que no
  // era el evento repitiéndose (que es lo que dicen varios comentarios de este
  // repo), sino cuatro copias del inicializador.
  //
  // La copia que sobrevive es la primera, con las variables `define:vars` de
  // aquella ficha. Ya está contemplado: initPage lee la identidad y las imágenes
  // del DOM y no de la closure (ver `dataNode.dataset`), justo por esto. Y
  // `allEvents` es el archivo entero, idéntico en todas las fichas.
  if (!window._melDetailInitBound) {
    window._melDetailInitBound = true;
    document.addEventListener('astro:page-load', initPage);

    // Clean transition intervals on Astro page unload
    document.addEventListener('astro:before-preparation', (e) => {
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
        window.melAutoplayInterval = null;
      }
      if (window.melOverlayKeydownHandler) {
        document.removeEventListener('keydown', window.melOverlayKeydownHandler);
        window.melOverlayKeydownHandler = null;
      }
      // RETIRADO el morphing de VUELTA evento → galería (D-256, decisión del
      // propietario): con la galería reconstruyéndose al volver (orden de
      // sesión vs. el servido) y las tarjetas más allá del primer lote sin
      // existir aún, el morph no puede ser fiable — aterrizaba en la columna
      // equivocada y hasta movía la tarjeta después. Se despoja el nombre
      // ANTES de que el ClientRouter fotografíe el estado viejo (por eso
      // `before-preparation` y no `before-swap`, que llega con la foto ya
      // hecha): sin pareja, el cartel entra en el fundido de la raíz y la
      // vuelta es un fade limpio. La IDA (galería → evento) no se toca.
      try {
        const destino = e && e.to ? new URL(e.to, location.href).pathname : null;
        if (destino === '/') {
          // `flyer-`: los nombres de los carteles.
          document.querySelectorAll('[style*="flyer-"]').forEach(el => {
            el.style.viewTransitionName = 'none';
          });
          // El whisper de la ficha (D-306) también: con nombre, un «Enlace
          // copiado» a la vista flotaría suelto sobre la vuelta, que tiene que
          // ser solo la raíz (D-263).
          const aviso = document.getElementById('whisper');
          if (aviso) aviso.style.viewTransitionName = 'none';
          // El contenido de la ficha, en su propia capa (D-318): se desvanece
          // nada más tocar la X, mientras el fondo de la ficha espera a que la
          // portada esté colocada (`sujetarTelon`). Así la vuelta reacciona al
          // instante y la lista sigue sin aparecer de golpe. Solo hacia la
          // galería o la Lista: el mapa, regla 15, como estaba.
          const vistaDestino = new URL(e.to, location.href).searchParams.get('view') || 'galería';
          const contenido = document.getElementById('detail-page-container');
          if (contenido && vistaDestino !== 'mapa') contenido.style.viewTransitionName = 'mel-ficha';
          prepararVueloDeVuelta(e);
        }
      } catch (err) {}
    });
    // Vuelo de vuelta (D-314): el cartel vuela de la ficha a su tarjeta. Aquí
    // solo se le pone nombre propio (`mel-vuelo`) para que la transición lo
    // fotografíe aparte, y se apunta su geometría; el vuelo lo lanza la
    // portada cuando su tarjeta está colocada (`volarDeVuelta` en index.astro).
    // Sin vuelo, y vuelta de siempre, si: no es la ficha por la que se entró;
    // se vuelve al mapa (la vuelta al panel es zona de la regla 15 y D-300);
    // el carrusel no está QUIETO en la 1.ª foto (es automático: a mitad de
    // pasar o en otra foto, la tarjeta enseñaría otra cosa); el visor está
    // abierto; la foto no está a la vista o sin cargar; o «reducir movimiento».
    function prepararVueloDeVuelta(e) {
      let origen = null;
      try {
        origen = sessionStorage.getItem('mel-vuelo-origen');
        sessionStorage.removeItem('mel-vuelo-origen');
        sessionStorage.removeItem('mel-vuelo');
      } catch (err) { return; }
      const id = document.getElementById('detail-page-container')?.dataset.eventId;
      const vista = new URL(e.to, location.href).searchParams.get('view') || 'galería';
      if (!origen || origen !== id || vista === 'mapa') return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const visor = document.getElementById('image-detail-overlay');
      if (visor && !visor.classList.contains('hidden')) return;
      const pista = document.getElementById('carousel-track');
      const img = pista && pista.querySelector('img');
      if (!img || !img.complete || !img.naturalWidth) return;
      const t = getComputedStyle(pista).transform;
      const quieta = !pista.getAnimations().length && (t === 'none' || new DOMMatrixReadOnly(t).m41 === 0);
      if (!quieta) return;
      const E = img.getBoundingClientRect();
      if (!E.width || E.bottom <= 0 || E.top >= window.innerHeight) return;
      // El cartel de verdad dentro de la caja de la imagen (`object-contain`):
      // la portada lo encaja en la tarjeta, no la caja con sus márgenes.
      const k = Math.min(E.width / img.naturalWidth, E.height / img.naturalHeight);
      const pw = img.naturalWidth * k, ph = img.naturalHeight * k;
      img.style.viewTransitionName = 'mel-vuelo';
      sessionStorage.setItem('mel-vuelo', JSON.stringify({
        id, vista,
        E: { x: E.left, y: E.top, w: E.width, h: E.height },
        P: { x: (E.width - pw) / 2, y: (E.height - ph) / 2, w: pw, h: ph },
      }));
    }


    // El marcador `mel-vuelta` (D-263) se instala DESDE AQUÍ, en el documento
    // ENTRANTE, y no desde el script de la home: el primer intento lo ponía la
    // home al evaluarse su script, asumiendo que eso ocurre antes de la foto
    // nueva — y el vídeo del propietario demostró que NO (la franja seguía
    // apareciendo a 0s y las tarjetas como grupos sueltos: los nombres nunca
    // llegaron a apagarse, o sea que la clase no estaba puesta al fotografiar).
    // `astro:before-swap` es el único gancho con acceso a `e.newDocument`
    // ANTES del intercambio: la clase viaja en los atributos del documento
    // nuevo, el swap la instala, y la foto nueva —que se toma después del
    // swap— ya la ve, junto con todo el CSS de apagado de global.css.
    // La retirada sigue siendo cosa del script de la home (su temporizador de
    // 600ms), que para retirar sí llega siempre a tiempo.
    document.addEventListener('astro:before-swap', (e) => {
      try {
        const destino = e && e.to ? new URL(e.to, location.href).pathname : null;
        // `mel-volviendo-al-panel` cuenta como vuelta igual que el estado de
        // la galería (D-266): al mapa se puede llegar por la X o por la tag de
        // "Lugar", y por esa segunda puede no haber estado de galería que
        // restaurar —se entró por URL directa, por ejemplo— y aun así el
        // aterrizaje merece el mismo cierre.
        // Yendo a contar el proceso de una búsqueda NO se pone (D-267): el
        // cierre de la vuelta dura 620ms entre la tapa y la disolución, y el
        // filtro que viene detrás arrancaría su propia transición encima —
        // apilarlas supersede la primera (regla 3). Con el cruce corriente de
        // la raíz, la historia puede empezar en cuanto la home está montada.
        const hayVuelta = (sessionStorage.getItem('mel-return-state')
          || sessionStorage.getItem('mel-volviendo-al-panel'))
          && !sessionStorage.getItem('mel-relato-busqueda');
        if (destino === '/' && e.newDocument && hayVuelta) {
          e.newDocument.documentElement.classList.add('mel-vuelta');
        }
      } catch (err) {}
    });
  }
</script>

<style>
  /* El ritmo de la IDA (galería → esta ficha), D-262. Estas reglas viven AQUÍ
     y no en global.css a propósito: en una transición del ClientRouter manda
     el CSS del documento de DESTINO (D-260), así que solo actúan cuando se
     viene HACIA una ficha — que es exactamente el único momento en que deben.
     Lo pidió el propietario con números: "la página se evapora como en 20ms
     máximo, mientras que la franja aguanta ese tiempo y luego empieza a
     desvanecerse también". CAMBIADO en D-310 (ver la regla de abajo): con el
     vídeo delante, ese ritmo dejaba un corte duro arriba.
     El (*) alcanza también al par del cartel que hace morphing: su imagen
     vieja se disuelve en esos mismos 20ms y la nueva manda durante todo el
     vuelo — mejor, no peor. Y en Anterior/Siguiente (ficha → ficha) la página
     saliente se evapora igual de rápido. Los selectores empiezan por `html`
     (la excepción documentada del ámbito de Astro, D-239). */
  /* D-310 (propietario, con vídeo): la página que se va se funde ENTERA y
     junta en 200 ms, franja de cabecera incluida. Hasta entonces se evaporaba en
     20 ms y la franja aguantaba opaca y se despedía en 180 ms aparte (D-261/
     D-262): se veía un corte duro arriba, con la ficha entrando por debajo y el
     selector Galería/Mapa/Lista encima del texto de la ficha. */
  /* EL TELÓN (D-315): así se llama, a partir de ahora, todo lo que pasa por
     debajo del cartel mientras vuela. A la ida, estas dos reglas: la página que
     se va (300 ms) y la ficha que llega (espera 200 ms y aparece en 500). A la
     vuelta, `html.mel-vuelta::view-transition-old(root)` en global.css. */
  html::view-transition-old(*) {
    animation-duration: 300ms;
  }
  /* Vuelo ficha ⇄ visor (D-313, `volarVisor()`): el cartel con el compás de la
     ida a la ficha y opaco desde el primer fotograma; el fondo oscuro y el
     resto, un fundido de 300 ms sin la espera de la ida (que es para cambiar de
     página, no para abrir algo encima). */
  html.mel-visor-vt::view-transition-group(mel-visor) {
    animation-duration: 0.5s;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
  }
  html.mel-visor-vt::view-transition-new(mel-visor) {
    animation: none;
  }
  html.mel-visor-vt::view-transition-old(root),
  html.mel-visor-vt::view-transition-new(root) {
    animation-delay: 0s;
    animation-duration: 300ms;
  }
  /* La ficha que llega (todo menos el cartel, que va aparte), un poco más
     suave (D-311, propietario): 400 ms en vez de los 250 de serie, frenando al
     final, y ESPERANDO 150 ms (D-312): la portada se funde primero hasta el
     fondo y solo entonces aparece la ficha encima, con el cartel ya en vuelo.
     `both` la mantiene invisible durante la espera. */
  html::view-transition-new(root) {
    animation-duration: 500ms;
    animation-delay: 200ms;
    animation-fill-mode: both;
    animation-timing-function: ease-out;
  }

  @media (max-width: 1023px) {
    /* El divisor sobre la navegación se dibuja con un pseudoelemento y no con
       `border-top`: el borde se pinta sobre la caja del bloque, así que llegaba
       a sangre mientras el contenido de dentro respeta los márgenes laterales.
       Acotado a los mismos 24px (48 a partir de `sm`) que el resto. */
    #detail-nav-block::before {
      content: "";
      position: absolute;
      top: 0;
      left: 24px;
      right: 24px;
      border-top: 1px solid var(--mel-border);
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    #detail-nav-block::before { left: 48px; right: 48px; }
  }

  /* Con un solo lado navegable, ese enlace se centra a todo el ancho en vez
     de quedarse pegado a su mitad de la rejilla — solo en móvil, donde la
     rejilla es de 2 columnas; en escritorio (12 columnas) el hueco de la
     columna que falta ya se lee como intencionado y no hace falta. Reactivo
     al mismo `invisible` que ya alterna el JS (D-090): sin JS nuevo, se
     resuelve solo con `:has()` cuando cambia el estado o cruza el breakpoint. */
  @media (max-width: 1023px) {
    #detail-nav-block:has(#nav-prev-container.invisible):not(:has(#nav-next-container.invisible)) #nav-next-container,
    #detail-nav-block:has(#nav-next-container.invisible):not(:has(#nav-prev-container.invisible)) #nav-prev-container {
      grid-column: 1 / -1;
      justify-content: center;
    }
    /* El lado sin vecino sigue siendo `invisible` (visibility:hidden), no
       `hidden`: sigue existiendo en la rejilla y reservando su propia celda.
       Con el otro lado ocupando ya las dos columnas, esa celda no cabe en la
       misma fila y salta a una fila nueva — vacía pero con su alto de 48px,
       el hueco que se veía arriba o abajo según qué lado sobraba. Aquí sí lo
       sacamos del todo del grid: ya no hace falta que reserve nada. */
    #detail-nav-block:has(#nav-prev-container.invisible):not(:has(#nav-next-container.invisible)) #nav-prev-container,
    #detail-nav-block:has(#nav-next-container.invisible):not(:has(#nav-prev-container.invisible)) #nav-next-container {
      display: none;
    }
    /* :global() porque `.filter-tag` lo pinta TagWithLink.astro, un componente
       distinto — el scoping de Astro no le añade el atributo de este archivo,
       así que sin esto la regla no llega a coincidir con nada (ver el mismo
       comentario en TagWithLink.astro sobre por qué hace falta ahí también). */
    :global(#detail-nav-block:has(#nav-prev-container.invisible):not(:has(#nav-next-container.invisible)) #nav-next-container .filter-tag),
    :global(#detail-nav-block:has(#nav-next-container.invisible):not(:has(#nav-prev-container.invisible)) #nav-prev-container .filter-tag) {
      align-items: center;
      text-align: center;
    }
    /* `text-align`, NO `justify-content`: esa caja (`.marquee-cell`) no es un
       contenedor flex —deliberadamente, ver D-228 en TagWithLink.astro—, así
       que `justify-content` no hacía absolutamente nada y el título se quedaba
       con el `text-left`/`text-right` de su propia clase mientras la etiqueta
       de encima sí se centraba. Ese era el descuadre: rótulo al centro y
       título pegado a un lado. El enlace es `inline-flex`, o sea una caja de
       nivel en línea, y a esas sí las centra el `text-align` del bloque que
       las contiene. */
    :global(#detail-nav-block:has(#nav-prev-container.invisible):not(:has(#nav-next-container.invisible)) #nav-next-container .filter-tag > div:last-child),
    :global(#detail-nav-block:has(#nav-next-container.invisible):not(:has(#nav-prev-container.invisible)) #nav-prev-container .filter-tag > div:last-child) {
      text-align: center;
    }
  }

  @media (max-width: 1023px) {
    /* Los puntos del carrusel, escondidos detrás de la foto mientras se lee
       (D-307). Suben su alto menos los 24 px de abajo de su `py-6`: los puntos
       quedan enteros bajo el recorte (que va por encima, `z-[1]`) y esos 24 px
       siguen a la vista como faldón entre la foto y el texto. `transform`: no
       mueve nada de la página ni cambia el recorrido del scroll. */
    #carousel-dots-container {
      transition: transform 200ms ease-out;
    }
    .puntos-ocultos #carousel-dots-container {
      transform: translateY(calc(-100% + 24px));
      pointer-events: none;
    }
    @media (prefers-reduced-motion: reduce) {
      #carousel-dots-container {
        transition: none;
      }
    }
    /* La foto va FIJA, no pegajosa: `sticky` se suelta cuando acaba su
       contenedor, y por ahí la foto se escapaba hacia arriba por detrás de la
       cabecera justo al llegar a su tamaño mínimo. Fija se queda donde está
       para siempre y el contenido le pasa por debajo. Su `top` sale de una
       variable medida una vez al iniciar — no de leer en vivo el rectángulo de
       otro elemento fijo, que es lo que se descolocaba en el móvil (D-103).
       El hueco lo reserva #detail-image-column, con alto congelado. */
    /* El alto de la caja sale de la proporción del cartel más alto del evento,
       acotado entre el suelo y el tope. Toda la regla, en tres declaraciones:

           alto = clamp(200, ancho ÷ proporción, 360)

       Funciona sin una línea de JavaScript porque en móvil la caja va A SANGRE:
       su ancho es siempre el del viewport. Y por eso mismo se readapta sola al
       girar el teléfono, sin escuchar nada.

       El suelo de 200px es la cota de Figma (369:32751) y manda: un cartel muy
       apaisado deja la caja en 200 aunque él mida menos, y se queda centrado
       dentro con aire. Que la CAJA tenga un mínimo y la IMAGEN un máximo no es
       contradictorio: son cotas de dos elementos distintos.

       `aspect-ratio` no hace nada si la variable no existe, así que un cartel sin
       medir se queda con el `h-[360px]` de su clase. */
    #detail-image-crop[style*="--mel-ratio-cartel"] {
      aspect-ratio: var(--mel-ratio-cartel);
      height: auto;
      min-height: 200px;
      /* Dos topes, y el segundo no sobra. `aspect-ratio` calcula con el ancho de
         la CAJA, pero un cartel de menos resolución que la pantalla no se estira
         (no ampliamos nunca), así que se pinta más estrecho y más bajo de lo que
         la proporción sugiere. Sin `--mel-alto-cartel`, a 1023px de ancho Trip
         With Us dejaba la caja en 360 con la imagen a 289: 71px de aire.
         Acotando por su alto real, la caja mide exactamente lo que ocupa. */
      max-height: min(360px, var(--mel-alto-cartel));
    }

    /* La primera tag (Fecha) no lleva divisor: una raya vertical antes del
       primer elemento no separa nada, solo cuelga del borde izquierdo.
       Mismo criterio que el panel del mapa, que ya lo hacía con esta regla
       (`#side-panel-tags-container` en index.astro).

       Hace falta `:global()` porque el divisor lo pinta AdaptiveTagsRow, otro
       componente, y el ámbito de estilos de Astro no cruza esa frontera — sin
       él la regla se escribe pero no aplica (comprobado). Es lo mismo que ya
       necesita TagWithLink para llegar a Link. */
    :global(#detail-tags-fixed-row .highlight-unit:first-child > .bg-mel-border) {
      display: none;
    }

    .fijada #detail-image-sticky {
      position: fixed;
      top: var(--mel-cab-fija, 224px);
      left: 0;
      right: 0;
      margin: 0;
      width: 100%;
      /* NO se desvanece el canto de abajo. Se probó una máscara de 24px para que
         una línea atrapada se apagara en vez de quedar cortada, y el propietario
         lo rechazó: no hay ni un degradado en todo el sitio y no va a haber uno
         aquí (D-156). El canto es duro a propósito. */
    }
  }


