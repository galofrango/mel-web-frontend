---
import Layout from '../../layouts/Layout.astro';
import TagWithLink from '../../components/TagWithLink.astro';
import Link from '../../components/Link.astro';
import PaginationDot from '../../components/PaginationDot.astro';
import LikeButton from '../../components/LikeButton.astro';

// SSR route (server-rendered per request, see astro.config.mjs) — reads the
// sheet fresh on every visit instead of baking it in at build time, so new
// events/edits show up without a rebuild. Fetches + groups the full list
// (not just the one event) because Anterior/Siguiente need their neighbors.
const SHEET_ID = '1buzisIlDkCo2Rj5BYZh5-JKrAYSo3RSuBXYmJVGYT0E';
const CONFIG_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json`;

let eventsList: any[] = [];
try {
  const response = await fetch(CONFIG_URL);
  const text = await response.text();
  const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*?)\);/);

  if (match && match[1]) {
    const json = JSON.parse(match[1]);
    const rows = json.table.rows;

    const rawItems = rows.map((row) => {
      const c = row.c;
      if (!c) return null;
      return {
        evento: c[0] ? c[0].v : 'Evento sin título',
        urlDrive: c[2] ? c[2].v : '',
        fecha: c[3] ? c[3].f || c[3].v : 'SIN FECHA',
        lugar: c[4] ? c[4].v : 'León',
        localidad: c[5] ? c[5].v : '',
        coordenadas: c[6] ? c[6].v : '',
        artistas: c[7] ? c[7].v : '',
        organiza: c[8] ? c[8].v : '',
        descripcion: c[9] ? c[9].v : '',
        idMel: c[10] ? c[10].v : '',
        carruselOrder: c[11] ? c[11].v : '1',
        disenador: c[13] ? c[13].v : 'Desconocido',
        existeOriginal: c[16] ? c[16].v : '',
        formato: c[21] ? c[21].v : 'Flyer',
        notesArchivo: c[24] ? c[24].v : '',
        ocr: c[25] ? c[25].v : ''
      };
    }).filter(item => item && item.idMel && item.idMel.startsWith('MEL-'));

    // Group by Event Name + Date (same logic as index.astro to group multiple flyer images)
    const groups = {};
    rawItems.forEach(item => {
      const key = `${item.evento.trim().toLowerCase()}_${item.fecha.trim().toLowerCase()}`;
      if (!groups[key]) {
        groups[key] = {
          idMel: item.idMel,
          title: item.evento,
          date: item.fecha,
          location: item.lugar,
          locality: item.localidad,
          description: item.descripcion,
          artists: item.artistas,
          organizer: item.organiza,
          designer: item.disenador,
          carruselItems: []
        };
      }
      groups[key].carruselItems.push({
        urlDrive: item.urlDrive,
        order: parseInt(item.carruselOrder, 10) || 1
      });
    });

    eventsList = Object.values(groups).map((g: any) => {
      g.carruselItems.sort((a, b) => a.order - b.order);
      return g;
    });
  }
} catch (e) {
  console.error("Error fetching event data", e);
}

const eventIndex = eventsList.findIndex((e: any) => e.idMel === Astro.params.id);
if (eventIndex === -1) {
  return Astro.redirect('/');
}

const eventData = eventsList[eventIndex];
const prevEvent = eventIndex > 0 ? eventsList[eventIndex - 1] : null;
const nextEvent = eventIndex < eventsList.length - 1 ? eventsList[eventIndex + 1] : null;

// Map full list of events for client-side search filtering
const allEvents = eventsList.map((e: any) => ({
  idMel: e.idMel,
  title: e.title,
  location: e.location || '',
  locality: e.locality || '',
  artists: e.artists || '',
  organizer: e.organizer || '',
  designer: e.designer || ''
}));

function extractDriveImage(url) {
  if (!url) return '';
  let fileId = '';
  if (url.includes('id=')) {
    fileId = url.split('id=')[1].split('&')[0];
  } else if (url.includes('/d/')) {
    fileId = url.split('/d/')[1].split('/')[0];
  }
  return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : '';
}

const imageUrls = eventData.carruselItems.map(i => extractDriveImage(i.urlDrive)).filter(Boolean);

// Helper function to format unknown tag values
function getTagDisplay(val) {
  const clean = val ? String(val).trim() : '';
  if (!clean || clean.toLowerCase() === 'desconocido' || clean.toLowerCase() === 'sin fecha') {
    return { text: 'Desconocido', isUnknown: true };
  }
  return { text: clean, isUnknown: false };
}

const dateDisplay = getTagDisplay(eventData.date);
const locationDisplay = getTagDisplay(eventData.location);
const localityDisplay = getTagDisplay(eventData.locality);
const organizerDisplay = getTagDisplay(eventData.organizer);
const designerDisplay = getTagDisplay(eventData.designer);
---
<Layout title={eventData.title}>
  <!-- Direct morphing view transition styling for smooth flyer scale and position translation -->
  <style is:inline>
    ::view-transition-old(flyer-img-{eventData.idMel}),
    ::view-transition-new(flyer-img-{eventData.idMel}) {
      animation-duration: 0.5s !important;
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1) !important;
    }
  </style>

  <!-- Main layout container with 108px (pb-[108px]) padding bottom. pt-[10vh]
       matches every other page header's top offset. -->
  <div class="min-h-screen bg-mel-bg-primary text-mel-text-primary flex flex-col items-center justify-start pt-[10vh] pb-[108px] px-6 sm:px-12">
    <!-- Main Box Container (Figma 1224px wide) -->
    <div class="w-full max-w-[1224px] flex flex-col select-none">

      <!-- Close Button (X) at Top Left -->
      <a
        id="detail-close-btn"
        href="/"
        class="w-6 h-6 mb-8 lg:mb-16 flex items-center justify-center text-mel-action-secondary hover:text-mel-action-primary transition-colors cursor-pointer shrink-0"
        aria-label="Cerrar detalles de evento"
        data-node-id="536:47449"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </a>

      <!-- Mobile-only Event Title: on mobile (Figma 369:32751) the title sits
           between the close button and the image; on desktop it lives at the
           top of the Info column instead. -->
      <h2 class="lg:hidden font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary mb-8">
        {eventData.title}
      </h2>

      <!-- Three-column content grid (Figma widths: 184px, 496px, 496px). On
           mobile the same three blocks reflow per Figma 369:32751: image first
           (full-bleed), then the tags as a horizontally scrollable row, then
           the info column. -->
      <div class="grid grid-cols-1 lg:grid-cols-[184px_496px_496px] gap-8 lg:gap-6 items-start">
        
        <!-- Column 1: Tags Sidebar (Figma 184px wide). h-[400px] matches the image column's own
             fixed height, and justify-between spreads the 5 tags across it so the first one lines
             up with the image's top edge and the last with its bottom edge, instead of a flat
             40px gap that leaves the column visibly shorter than the image next to it. gap-2 is
             just a minimum floor. min-w-0 overrides the grid item's default content-based minimum
             size, which would otherwise let a long tag value push this column wider than its
             fixed 184px track. -->
        <div class="event-tags-row order-2 lg:order-none flex flex-row lg:flex-col justify-start lg:justify-between gap-6 lg:gap-2 h-auto lg:h-[400px] w-full min-w-0 overflow-x-auto lg:overflow-visible no-scrollbar border-b border-mel-border pb-6 lg:border-b-0 lg:pb-0" data-name="Tags Section" style="view-transition-name: event-tags;">
          <TagWithLink 
            label="Fecha" 
            count={dateDisplay.text} 
            state={dateDisplay.isUnknown ? "Disabled" : "Default"} 
            hideBorder={true}
          />
          <TagWithLink 
            label="Lugar" 
            count={locationDisplay.text} 
            state={locationDisplay.isUnknown ? "Disabled" : "Default"} 
            href={locationDisplay.isUnknown ? undefined : `/?view=mapa&search=${encodeURIComponent(eventData.location)}`}
            hideBorder={true}
          />
          <TagWithLink 
            label="Localidad" 
            count={localityDisplay.text} 
            state={localityDisplay.isUnknown ? "Disabled" : "Default"} 
            href={localityDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.locality)}`}
            hideBorder={true}
          />
          <TagWithLink 
            label="Organiza" 
            count={organizerDisplay.text} 
            state={organizerDisplay.isUnknown ? "Disabled" : "Default"} 
            href={organizerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.organizer)}`}
            hideBorder={true}
          />
          <TagWithLink 
            label="Diseño" 
            count={designerDisplay.text} 
            state={designerDisplay.isUnknown ? "Disabled" : "Default"} 
            href={designerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.designer)}`}
            hideBorder={true}
          />
        </div>

        <!-- Column 2: Image Box (Figma 496px wide, height exactly 400px, dots
             absolute/floating so layout height remains constant). On mobile it
             comes first and runs full-bleed to the screen edges. -->
        <div class="order-1 lg:order-none flex flex-col items-center relative h-auto lg:h-[400px] -mx-6 w-[calc(100%+48px)] sm:-mx-12 sm:w-[calc(100%+96px)] lg:mx-0 lg:w-full" data-name="Image Viewer / Desktop">
          <button 
            id="carousel-main-container"
            class="relative w-full h-[400px] overflow-hidden flex items-center justify-center cursor-zoom-in outline-none group bg-transparent"
            aria-label="Siguiente imagen"
          >
            <!-- Custom background image matching Figma specifications exactly (flipped 180deg horizontally) -->
            <div class="absolute inset-0 striped-bg z-0 pointer-events-none"></div>
            
            <!-- Slides track container with sliding transform transition -->
            <div 
              id="carousel-track" 
              class="flex w-full h-full transition-transform duration-500 ease-out z-10 pointer-events-none"
              style="transform: translate3d(0, 0, 0);"
            >
              {imageUrls.map((img, idx) => (
                <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
                  <img
                    src={img}
                    alt={eventData.title}
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-contain"
                    style={idx === 0 ? `view-transition-name: flyer-img-${eventData.idMel};` : ""}
                  />
                </div>
              ))}
            </div>
          </button>

          <!-- Pagination dots: in flow on mobile (below the image), floating absolute
               on desktop (top-[400px]) so they don't shift the navigation block -->
          {imageUrls.length > 1 && (
            <div class="static lg:absolute lg:top-[400px] lg:left-0 lg:right-0 flex gap-4 items-center justify-center py-6 w-full" id="carousel-dots-container">

              {imageUrls.map((_, idx) => (
                <PaginationDot
                  state={idx === 0 ? "Active" : "Resting"}
                  index={idx}
                  class="carousel-dot"
                />
              ))}
            </div>
          )}
        </div>

        <!-- Column 3: Event Info (Figma 496px wide with 24px left padding) -->
        <div class="order-3 lg:order-none flex flex-col gap-10 w-full pl-0 lg:pl-6" data-name="Info" style="view-transition-name: event-info;">

          <!-- Event Title (desktop position — the mobile one renders above the grid) -->
          <h2 class="hidden lg:block font-sans font-bold text-[31px] leading-[32px] tracking-[-0.62px] text-mel-text-primary">
            {eventData.title}
          </h2>

          <!-- Description + Artists block -->
          <div class="flex flex-col gap-10">
            {eventData.description && (
              <div class="flex flex-col gap-6">
                <p class="font-sans font-normal text-[16px] leading-[24px] tracking-[-0.16px] text-mel-text-primary">
                  {eventData.description}
                </p>
                <!-- Figma 1px divider -->
                <div class="h-px w-full bg-mel-border"></div>
              </div>
            )}

            {eventData.artists && eventData.artists.toLowerCase() !== 'no detallados' && (
              <div class="flex flex-col gap-2">
                <span class="typo-tag-label font-sans font-bold text-[13px] leading-[16px] tracking-[1.56px] uppercase text-mel-text-primary">Artistas</span>
                <div class="flex flex-wrap gap-y-1">
                  {eventData.artists.split(/[,;\/]+/).map((artist, idx, arr) => {
                    const cleanArtist = artist.trim();
                    if (!cleanArtist) return null;
                    const isLast = idx === arr.length - 1;
                    return (
                      <span class="inline-flex items-center whitespace-nowrap">
                        <Link href={`/?search=${encodeURIComponent(cleanArtist)}`} hideChevron={true}>{cleanArtist}</Link>{!isLast && <span class="text-mel-text-secondary mr-2 font-serif font-medium text-[15px] leading-[24px] tracking-[0.15px]">,</span>}
                      </span>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          <!-- Actions: Componetized "Me presta" button -->
          <div class="flex gap-6 items-start">
            <LikeButton
              id="btn-me-presta"
              class="w-fit"
            />
          </div>

        </div>

      </div>

      <!-- Navigation block (positioned exactly 280px below the image container and
           columns on desktop, top-aligned). On mobile it's a 2-column row under a
           divider, with Anterior/Siguiente side by side (Figma 575:83196). -->
      <div class="grid grid-cols-2 lg:grid-cols-[184px_496px_496px] gap-8 lg:gap-6 w-full mt-12 lg:mt-[280px] pt-6 border-t border-mel-border lg:pt-0 lg:border-t-0 shrink-0 items-center" data-name="Navigation Block">
        
        <!-- Empty cell for Left Column alignment -->
        <div class="hidden lg:block"></div>
        
        <!-- Anterior (Right-aligned under middle column) -->
        <div class="flex justify-end text-right items-center" id="nav-prev-container">
          {prevEvent && (
            <TagWithLink
              label="Anterior"
              count={prevEvent.title}
              alignment="Right"
              href={`/event/${prevEvent.idMel}`}
              class="w-full max-w-[496px]"
              hideBorder={true}
              reload={true}
            />
          )}
        </div>

        <!-- Siguiente (Left-aligned under right column with 24px left padding on desktop) -->
        <div class="flex justify-start text-left pl-0 lg:pl-6 items-center" id="nav-next-container">
          {nextEvent && (
            <TagWithLink
              label="Siguiente"
              count={nextEvent.title}
              alignment="Left"
              href={`/event/${nextEvent.idMel}`}
              class="w-full max-w-[496px]"
              hideBorder={true}
              reload={true}
            />
          )}
        </div>

      </div>

    </div>
    
    <!-- Image Detail Lightbox Overlay (Figma 841:40903: fixed-size modal,
         image object-contained inside it — never sized off the photo's
         natural dimensions, which used to let large photos overflow the
         screen — with pagination dots inside the modal below the image) -->
    <div
      id="image-detail-overlay"
      class="fixed inset-0 bg-[var(--mel-primitive-le-950)]/80 z-[250] opacity-0 pointer-events-none transition-opacity duration-300 hidden flex items-center justify-center"
    >
      <!-- Modal Container: proportional to viewport height, true square aspect ratio, width
           follows from that. Bottom padding matches the other sides (pb-8) when there's no
           pagination to show — with pagination, pb-4 plus the dots row's own padding reads as
           the same visual weight, so it stays smaller there on purpose. -->
      <div
        id="image-detail-modal"
        class={`relative bg-mel-bg-primary flex flex-col items-center transform scale-95 transition-transform duration-300 pt-8 px-8 ${imageUrls.length > 1 ? 'pb-4' : 'pb-8'} h-[76vh] max-w-[92vw] aspect-square`}
        data-node-id="841:40541"
      >
        <!-- Close Button (40px, offset half-outside the top-right corner) -->
        <button
          id="overlay-close-btn"
          class="absolute -top-5 -right-5 w-10 h-10 bg-mel-action-secondary text-mel-text-on-action hover:bg-mel-action-primary flex items-center justify-center shadow-[0px_4px_8px_rgba(38,31,31,0.32)] border-none cursor-pointer z-50 transition-colors"
          aria-label="Cerrar vista grande"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <!-- Image Box: fills the modal, sliding track mirrors the main carousel's transition (no autoplay here) -->
        <div id="overlay-image-box" class="relative flex-1 min-h-0 w-full overflow-hidden flex items-center justify-center">
          <div class="absolute inset-0 striped-bg pointer-events-none"></div>
          <div
            id="overlay-track"
            class="flex w-full h-full transition-transform duration-500 ease-out z-10"
            style="transform: translate3d(0, 0, 0);"
          >
            {imageUrls.map((img) => (
              <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
                <img
                  src={img}
                  alt={eventData.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-contain"
                />
              </div>
            ))}
          </div>
        </div>

        {imageUrls.length > 1 && (
          <div class="flex gap-4 items-center justify-center pt-4 pb-1 shrink-0" id="overlay-dots-container">
            {imageUrls.map((_, idx) => (
              <PaginationDot
                state={idx === 0 ? "Active" : "Resting"}
                index={idx}
                class="overlay-dot"
              />
            ))}
          </div>
        )}
      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ imageUrls, eventId: eventData.idMel, allEvents }}>
  function initPage() {
    // Parse search/location/view queries from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const activeView = urlParams.get('view') || 'galería';
    const activeSearch = urlParams.get('search') || '';
    const activeLocation = urlParams.get('location') || '';

    // Append search/location/view queries to close button so it returns with filters and state preserved
    const closeBtn = document.getElementById('detail-close-btn');
    if (closeBtn) {
      const returnParams = new URLSearchParams();
      if (activeView) returnParams.set('view', activeView);
      if (activeSearch) returnParams.set('search', activeSearch);
      if (activeLocation) returnParams.set('location', activeLocation);
      closeBtn.href = `/?${returnParams.toString()}`;
    }

    // Dynamic Navigation filtering based on activeSearch or activeLocation results
    let filteredEvents = [];
    if (activeLocation) {
      // If location parameter is present, restrict navigation ONLY to events matching this location
      filteredEvents = allEvents.filter(item => item.location.toLowerCase() === activeLocation.toLowerCase());
    } else {
      // Otherwise filter by search query
      filteredEvents = allEvents.filter(item => {
        if (!activeSearch) return true;
        const q = activeSearch.toLowerCase().trim();
        return item.title.toLowerCase().includes(q) ||
               item.location.toLowerCase().includes(q) ||
               item.locality.toLowerCase().includes(q) ||
               item.artists.toLowerCase().includes(q) ||
               item.organizer.toLowerCase().includes(q) ||
               item.designer.toLowerCase().includes(q);
      });
    }

    const curIdx = filteredEvents.findIndex(x => x.idMel === eventId);
    const prevEventItem = curIdx > 0 ? filteredEvents[curIdx - 1] : null;
    const nextEventItem = curIdx < filteredEvents.length - 1 ? filteredEvents[curIdx + 1] : null;

    // Build the correct detail page query param: search, location, and view
    const returnNavParams = new URLSearchParams();
    if (activeView) returnNavParams.set('view', activeView);
    if (activeSearch) returnNavParams.set('search', activeSearch);
    if (activeLocation) returnNavParams.set('location', activeLocation);
    const navParam = returnNavParams.toString();

    // Render navigation dynamically based on active search/location matches (using visibility:hidden to preserve grid layout!)
    const prevContainer = document.getElementById('nav-prev-container');
    if (prevContainer) {
      if (prevEventItem) {
        prevContainer.classList.remove('invisible');
        const link = prevContainer.querySelector('a');
        const text = prevContainer.querySelector('.tag-count-val');
        if (link) link.href = `/event/${prevEventItem.idMel}?${navParam}`;
        if (text) text.textContent = prevEventItem.title;
      } else {
        prevContainer.classList.add('invisible');
      }
    }

    const nextContainer = document.getElementById('nav-next-container');
    if (nextContainer) {
      if (nextEventItem) {
        nextContainer.classList.remove('invisible');
        const link = nextContainer.querySelector('a');
        const text = nextContainer.querySelector('.tag-count-val');
        if (link) link.href = `/event/${nextEventItem.idMel}?${navParam}`;
        if (text) text.textContent = nextEventItem.title;
      } else {
        nextContainer.classList.add('invisible');
      }
    }

    // Interactive like state persistent via localStorage using componetized LikeButton
    const likeKey = `mel-like-${eventId}`;
    const likeBtn = document.getElementById('btn-me-presta');
    
    if (likeBtn) {
      let isLiked = localStorage.getItem(likeKey) === 'true';
      
      const updateLikeUI = () => {
        likeBtn.setAttribute('data-active', isLiked ? 'true' : 'false');
      };

      updateLikeUI();

      likeBtn.onclick = () => {
        isLiked = !isLiked;
        localStorage.setItem(likeKey, String(isLiked));
        updateLikeUI();
      };
    }

    // Interactive Carousel Image Swap with horizontal sliding transition
    let currentIndex = 0;

    // Crucial: Clear any running autoplay interval on script mount to avoid cumulative loops
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }

    function updateCarousel(index) {
      if (!imageUrls || imageUrls.length === 0) return;
      
      // Wrap index around boundaries
      currentIndex = (index + imageUrls.length) % imageUrls.length;
      
      // Slide the track using CSS transform
      const track = document.getElementById('carousel-track');
      if (track) {
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;
      }

      // Toggle dots active attributes
      const dots = document.querySelectorAll('.carousel-dot');
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.setAttribute('data-active', isActive ? 'true' : 'false');
      });
    }

    // Autoplay function (only runs if there are multiple images)
    function startAutoplay() {
      if (!imageUrls || imageUrls.length <= 1) return;
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
      }
      window.melAutoplayInterval = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);
    }

    function resetAutoplayTimer() {
      startAutoplay();
    }

    // Large Image Overlay Lightbox. The modal is a fixed-size CSS box (see
    // markup) and the photo object-contains inside it — no JS sizing off
    // the image's natural dimensions, which is what previously let large
    // photos push the modal beyond the screen.
    const overlay = document.getElementById('image-detail-overlay');
    const overlayModal = document.getElementById('image-detail-modal');
    const overlayTrack = document.getElementById('overlay-track');
    const overlayCloseBtn = document.getElementById('overlay-close-btn');
    const overlayDots = document.querySelectorAll('.overlay-dot');

    let overlayIndex = 0;

    // Same sliding-track transition as the main carousel, but this never autoplays on its own
    function showOverlayImage(idx) {
      if (!imageUrls || imageUrls.length === 0) return;
      overlayIndex = (idx + imageUrls.length) % imageUrls.length;
      if (overlayTrack) overlayTrack.style.transform = `translate3d(-${overlayIndex * 100}%, 0, 0)`;
      overlayDots.forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === overlayIndex ? 'true' : 'false');
      });
    }

    // Left/right arrow keys navigate images while the lightbox is open
    function handleOverlayKeydown(e) {
      if (!overlay || overlay.classList.contains('hidden')) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); showOverlayImage(overlayIndex - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); showOverlayImage(overlayIndex + 1); }
    }
    if (window.melOverlayKeydownHandler) {
      document.removeEventListener('keydown', window.melOverlayKeydownHandler);
    }
    window.melOverlayKeydownHandler = handleOverlayKeydown;
    document.addEventListener('keydown', window.melOverlayKeydownHandler);

    function openOverlay() {
      if (!overlay || !overlayModal) return;

      // Stop autoplay when large view is open
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
        window.melAutoplayInterval = null;
      }

      // Open on whichever image the page carousel is showing
      showOverlayImage(currentIndex);

      overlay.classList.remove('hidden');
      setTimeout(() => {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        overlayModal.classList.remove('scale-95');
        overlayModal.classList.add('scale-100');
      }, 10);
    }

    function closeOverlay() {
      if (!overlay || !overlayModal) return;

      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlayModal.classList.remove('scale-100');
      overlayModal.classList.add('scale-95');

      setTimeout(() => {
        overlay.classList.add('hidden');
        // Resume autoplay
        startAutoplay();
      }, 300);
    }

    // Click on main image container opens overlay
    const mainImageContainer = document.getElementById('carousel-main-container');
    if (mainImageContainer) {
      mainImageContainer.addEventListener('click', openOverlay);
    }

    if (overlayCloseBtn) overlayCloseBtn.onclick = closeOverlay;
    if (overlay) {
      overlay.onclick = (e) => {
        if (e.target === overlay) closeOverlay();
      };
    }

    // Lightbox pagination dots switch the displayed photo
    overlayDots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        showOverlayImage(parseInt(dot.dataset.index, 10));
      });
    });

    const dots = document.querySelectorAll('.carousel-dot');
    dots.forEach(dot => {
      dot.onclick = (e) => {
        e.stopPropagation();
        const idx = parseInt(dot.dataset.index, 10);
        updateCarousel(idx);
        resetAutoplayTimer();
      };
    });

    // Keep indicators aligned perfectly on window resize
    window.addEventListener('resize', () => {
      updateCarousel(currentIndex);
    });

    // Initialize carousel and autoplay
    if (imageUrls && imageUrls.length > 0) {
      updateCarousel(0);
      startAutoplay();
    }
  }

  // Bind carousel and listener init to page-load so it functions perfectly on transition navigation
  document.addEventListener('astro:page-load', initPage);

  // Clean transition intervals on Astro page unload
  document.addEventListener('astro:before-preparation', () => {
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }
    if (window.melOverlayKeydownHandler) {
      document.removeEventListener('keydown', window.melOverlayKeydownHandler);
      window.melOverlayKeydownHandler = null;
    }
  });
</script>

