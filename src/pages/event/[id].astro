---
import Layout from '../../layouts/Layout.astro';
import TagWithLink from '../../components/TagWithLink.astro';
import Link from '../../components/Link.astro';
import PaginationDot from '../../components/PaginationDot.astro';
import LikeButton from '../../components/LikeButton.astro';
import IconButton from '../../components/IconButton.astro';
import AdaptiveTagsRow from '../../components/AdaptiveTagsRow.astro';

// SSR route (server-rendered per request, see astro.config.mjs) — reads the
// sheet fresh on every visit instead of baking it in at build time, so new
// events/edits show up without a rebuild. Fetches + groups the full list
// (not just the one event) because Anterior/Siguiente need their neighbors.
const SHEET_ID = '1buzisIlDkCo2Rj5BYZh5-JKrAYSo3RSuBXYmJVGYT0E';
const CONFIG_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json`;

let eventsList: any[] = [];
try {
  const response = await fetch(CONFIG_URL);
  const text = await response.text();
  const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*?)\);/);

  if (match && match[1]) {
    const json = JSON.parse(match[1]);
    const rows = json.table.rows;

    const rawItems = rows.map((row) => {
      const c = row.c;
      if (!c) return null;
      return {
        evento: c[0] ? c[0].v : 'Evento sin título',
        urlDrive: c[2] ? c[2].v : '',
        fecha: c[3] ? c[3].f || c[3].v : 'SIN FECHA',
        lugar: c[4] ? c[4].v : 'León',
        localidad: c[5] ? c[5].v : '',
        coordenadas: c[6] ? c[6].v : '',
        artistas: c[7] ? c[7].v : '',
        organiza: c[8] ? c[8].v : '',
        descripcion: c[9] ? c[9].v : '',
        idMel: c[10] ? c[10].v : '',
        carruselOrder: c[11] ? c[11].v : '1',
        disenador: c[13] ? c[13].v : 'Desconocido',
        existeOriginal: c[16] ? c[16].v : '',
        formato: c[21] ? c[21].v : 'Flyer',
        notesArchivo: c[24] ? c[24].v : '',
        ocr: c[25] ? c[25].v : ''
      };
    }).filter(item => item && item.idMel && item.idMel.startsWith('MEL-'));

    // Group by Event Name + Date (same logic as index.astro to group multiple flyer images)
    const groups = {};
    rawItems.forEach(item => {
      const key = `${item.evento.trim().toLowerCase()}_${item.fecha.trim().toLowerCase()}`;
      if (!groups[key]) {
        groups[key] = {
          idMel: item.idMel,
          title: item.evento,
          date: item.fecha,
          location: item.lugar,
          locality: item.localidad,
          description: item.descripcion,
          artists: item.artistas,
          organizer: item.organiza,
          designer: item.disenador,
          carruselItems: []
        };
      }
      groups[key].carruselItems.push({
        urlDrive: item.urlDrive,
        order: parseInt(item.carruselOrder, 10) || 1
      });
    });

    function parseDateToNumber(dateStr) {
      if (!dateStr || dateStr === 'SIN FECHA') return 0;
      const slashBits = String(dateStr).split('/');
      if (slashBits.length === 3) {
        const d = parseInt(slashBits[0], 10);
        const m = parseInt(slashBits[1], 10) - 1;
        const y = parseInt(slashBits[2], 10);
        return new Date(y, m, d).getTime();
      }
      const dashBits = String(dateStr).split('-');
      if (dashBits.length === 3) {
        const y = parseInt(dashBits[0], 10);
        const m = parseInt(dashBits[1], 10) - 1;
        const d = parseInt(dashBits[2], 10);
        return new Date(y, m, d).getTime();
      }
      return 0;
    }

    eventsList = Object.values(groups).map((g: any) => {
      g.carruselItems.sort((a, b) => a.order - b.order);
      return g;
    });

    eventsList.sort((a, b) => parseDateToNumber(a.date) - parseDateToNumber(b.date));
  }
} catch (e) {
  console.error("Error fetching event data", e);
}

const eventIndex = eventsList.findIndex((e: any) => e.idMel === Astro.params.id);
if (eventIndex === -1) {
  // Un enlace roto a un evento va al 404, no de vuelta al inicio: devolver a la
  // home en silencio dejaba al visitante creyendo que había pulsado mal. Se usa
  // `rewrite` y no `redirect` para conservar la URL fallida a la vista (y el
  // código 404 real, que lo fija la propia página).
  return Astro.rewrite('/404');
}

const eventData = eventsList[eventIndex];
const prevEvent = eventIndex > 0 ? eventsList[eventIndex - 1] : null;
const nextEvent = eventIndex < eventsList.length - 1 ? eventsList[eventIndex + 1] : null;

// Map full list of events for client-side search filtering
const allEvents = eventsList.map((e: any) => ({
  idMel: e.idMel,
  title: e.title,
  location: e.location || '',
  locality: e.locality || '',
  artists: e.artists || '',
  organizer: e.organizer || '',
  designer: e.designer || ''
}));

function extractDriveImage(url) {
  if (!url) return '';
  let fileId = '';
  if (url.includes('id=')) {
    fileId = url.split('id=')[1].split('&')[0];
  } else if (url.includes('/d/')) {
    fileId = url.split('/d/')[1].split('/')[0];
  }
  return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : '';
}

const imageUrls = eventData.carruselItems.map(i => extractDriveImage(i.urlDrive)).filter(Boolean);

// Helper function to format unknown tag values
// Centinelas con los que la hoja marca "aquí no hay dato". Regla del sitio: un
// campo desconocido SIEMPRE se pinta en text-tertiary y NUNCA es enlace — no
// tiene sentido ofrecer "buscar más eventos de Desconocido".
// `varios` y `no detallados` se conservan tal cual porque dicen algo (hubo
// varios promotores, hubo artistas sin detallar); los demás se unifican bajo
// "Desconocido".
const CENTINELAS_SIN_DATO = ['desconocido', 'sin fecha', 'no detallados', 'varios'];

function getTagDisplay(val) {
  const clean = val ? String(val).trim() : '';
  const bajo = clean.toLowerCase();
  if (!clean || bajo === 'desconocido' || bajo === 'sin fecha') {
    return { text: 'Desconocido', isUnknown: true };
  }
  if (CENTINELAS_SIN_DATO.includes(bajo)) {
    return { text: clean.charAt(0).toUpperCase() + clean.slice(1), isUnknown: true };
  }
  return { text: clean, isUnknown: false };
}

const dateDisplay = getTagDisplay(eventData.date);
const locationDisplay = getTagDisplay(eventData.location);
const localityDisplay = getTagDisplay(eventData.locality);
const organizerDisplay = getTagDisplay(eventData.organizer);
const designerDisplay = getTagDisplay(eventData.designer);

// ¿Todo el campo de artistas es en realidad un "no lo sabemos"? En ese caso el
// bloque NO se oculta: en un archivo la laguna es información («de este evento
// no sabemos quién pinchó»), y además es la ocasión natural de pedir ayuda. El
// valor sigue inerte y en terciario; lo que enlaza es la invitación, que sí
// lleva a un sitio útil — a diferencia de buscar el archivo por "Desconocido".
// Única excepción a la regla de "campo sin dato nunca enlaza"; ver
// design-system.md.
const artistasSinDatos = (eventData.artists || '')
  .split(/[,;\/]+/)
  .map(a => a.trim())
  .filter(Boolean)
  .every(a => CENTINELAS_SIN_DATO.includes(a.toLowerCase()));
---
<Layout title={eventData.title}>
  <!-- Direct morphing view transition styling for smooth flyer scale and position translation -->
  <style is:inline>
    ::view-transition-old(flyer-img-{eventData.idMel}),
    ::view-transition-new(flyer-img-{eventData.idMel}) {
      animation-duration: 0.5s !important;
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1) !important;
    }
  </style>

  <!-- Main layout container. pt-0 below `lg`: the header there is
       `position: fixed` from the very first frame (see its own comment)
       and #detail-header-spacer reserves exactly its height — any
       additional top padding here would just stack on top of that and push
       content down by an unwanted extra gap below the header. lg:pt-[10vh]
       matches every other page header's top offset (unaffected — desktop's
       header isn't fixed, it's back in normal flow via lg:static). Bottom
       padding is 40px on mobile/tablet (<lg) — the nav block ends up right
       around there from the screen's bottom edge once fully scrolled, per
       spec — and 108px at `lg+`, unchanged from before (desktop doesn't have
       this scroll behavior). -->
  <div class="w-full max-w-[1440px] mx-auto min-h-dvh bg-mel-bg-primary text-mel-text-primary flex flex-col items-center justify-start pt-0 lg:pt-[var(--mel-header-pt-desktop)] pb-[40px] lg:pb-[108px] px-6 sm:px-12 lg:px-[108px]">
    <!-- Main Box Container (Figma 1224px wide).
         data-event-id / data-image-urls: la identidad del evento viaja en el
         DOM, no solo en las variables de `define:vars`. Esas quedan congeladas
         en la closure del script que las sirvió, y con el botón atrás/adelante
         del navegador Astro restaura la página desde su caché SIN reejecutar el
         script: solo corren las closures ya registradas, la última de ellas con
         el id del evento ANTERIOR. Resultado: la ficha mostraba un evento y su
         navegación pertenecía a otro (con "Siguiente" apuntándose a sí misma,
         de ahí que se quedara pillada). Leyéndolo del DOM en cada
         `astro:page-load`, la identidad siempre es la de la página visible. -->
    <div
      id="detail-page-container"
      class="w-full max-w-[1224px] flex flex-col select-none"
      data-event-id={eventData.idMel}
      data-image-urls={JSON.stringify(imageUrls)}
    >

      <!-- Pinned Header (X + Mobile Title) -->
      <div
        id="detail-sticky-header"
        class="fixed top-0 left-0 right-0 z-30 bg-mel-bg-primary px-6 pt-[calc(10vh-40px)] pb-8 sm:px-12 lg:static lg:bg-transparent lg:px-0 lg:pt-0 lg:pb-0 shrink-0"
      >
        <!-- Close Button (X) at Top Left. Va dentro de una fila de 48px con el
             icono centrado, que es exactamente lo que pasa en las demás
             páginas: allí el botón de menú (40px) se centra en la fila del
             título, que mide 48. Sin esta fila la X quedaba 4px más alta que
             el icono de menú al ir de una página a otra. -->
        <div class="flex items-center h-[48px] mb-4 lg:mb-12">
          <IconButton
            id="detail-close-btn"
            href="/"
            icon="x"
            type="phantom"
            size={40}
            class="cursor-pointer shrink-0"
            aria-label="Cerrar detalles de evento"
          />
        </div>

        <!-- Mobile-only Event Title: sits below close button X -->
        <h2 class="lg:hidden font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary">
          {eventData.title}
        </h2>
      </div>

      <!-- Reserves flow space for the now-fixed header below `lg` (fixed
           elements are removed from normal flow) — height synced to the
           header's own current height every tick, so content never starts
           underneath it nor leaves an extra gap below it. -->
      <div id="detail-header-spacer" class="w-full lg:hidden" aria-hidden="true"></div>

      <!-- V2 layout (below `lg` only, made definitive after the overlay trial —
           see D-042/D-043): tags row pinned directly under the fixed header,
           replacing the old "beside the image" mobile position. Mirrors the
           overlay's #overlay-tags-fixed exactly (same ids minus the `overlay-`
           prefix) — a sibling of the header, not nested inside the grid, so it
           can use plain viewport-relative top math via updateTagsFixed(). No
           border/divider on purpose: reads as part of the fixed header. pb-8
           (32px) is the resting gap to the image below, exactly per spec
           regardless of pagination. -->
      <div id="detail-tags-fixed" class="lg:hidden fixed left-0 right-0 z-30 bg-mel-bg-primary px-6 pb-8 sm:px-12">
        <AdaptiveTagsRow
          id="detail-tags-fixed-row"
          tags={[
            { label: 'Fecha', count: dateDisplay.text, state: dateDisplay.isUnknown ? 'Disabled' : 'Default' },
            { label: 'Lugar', count: locationDisplay.text, state: locationDisplay.isUnknown ? 'Disabled' : 'Default', href: locationDisplay.isUnknown ? undefined : `/?view=mapa&location=${encodeURIComponent(eventData.location)}` },
            { label: 'Localidad', count: localityDisplay.text, state: localityDisplay.isUnknown ? 'Disabled' : 'Default', href: localityDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.locality)}` },
            { label: 'Organiza', count: organizerDisplay.text, state: organizerDisplay.isUnknown ? 'Disabled' : 'Default', href: organizerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.organizer)}` },
            { label: 'Diseño', count: designerDisplay.text, state: designerDisplay.isUnknown ? 'Disabled' : 'Default', href: designerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.designer)}` },
          ]}
        />
      </div>
      <!-- Reserves flow space for the fixed tags row below `lg`, right after
           the header's own spacer — so the image column (first in the grid
           below `lg`) naturally starts right after both. -->
      <div id="detail-tags-fixed-spacer" class="w-full lg:hidden" aria-hidden="true"></div>

      <!-- Three-column content grid (Figma widths: 184px, 496px, 496px). On
           mobile the same three blocks reflow per Figma 369:32751: image first
           (full-bleed, pinned, shrinking), then the tags as a horizontally
           scrollable row, then the info column — a real grid at every
           breakpoint, with `order` doing the mobile reflow (see each column's
           own comment). -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-start">

        <!-- Column 2: Image Box (Figma 496px wide, height exactly 400px on
             desktop). order-1 (lg:order-2 restores the desktop middle-column
             position) puts it first below `lg`, matching Figma 369:32751's
             image-then-tags-then-info mobile flow. -->
        <div id="detail-image-column" class="order-1 lg:order-2 lg:col-span-5 flex flex-col items-center relative h-auto lg:h-[400px] lg:mx-0 lg:w-full" data-name="Image Viewer / Desktop">
          <!-- Reserves flow space for the pinned image below `lg` (that image
               is `position: fixed` there, removed from normal flow — see
               updateStickyImage()). Held at a CONSTANT height: the box's
               full-size footprint (crop 400px + dots if any) — deliberately
               NOT synced to the box's current shrunk size. That way the
               page's height never changes with scroll, tags emerge at the
               grid's own 32px gap under the shrinking box, and once the crop
               bottoms out at 200px the content simply passes underneath the
               pinned box. -->
          <div id="detail-image-sentinel" class="w-full lg:hidden" aria-hidden="true"></div>

          <!-- Pinned image box (Figma 369:32751: min-h-[200px] on scroll).
               Below `lg`, updateStickyImage() drives `position: fixed` plus
               `top`/`left`/`width` directly — can't be static Tailwind
               classes since they depend on scroll position and on the sticky
               header's live height. NO bottom padding/margin of its own: the
               32px resting gap to tags is the parent grid's gap-8, which
               already applies after this box (dots included) whether or not
               this event has pagination — any spacing here would stack on
               top of that gap (the propietario flagged exactly that as
               unwanted extra space below the photo). -->
          <div
            id="detail-image-sticky"
            class="z-20 flex flex-col items-center bg-mel-bg-primary -mx-6 w-[calc(100%+48px)] sm:-mx-12 sm:w-[calc(100%+96px)] lg:static lg:mx-0 lg:w-full lg:bg-transparent"
          >
            <!-- Crop window: THIS is what shrinks (400px→200px), via
                 overflow-hidden — not the photo itself. The photo (button
                 below) always stays a full, unscaled 400px tall and CENTERED
                 in this wrapper (flex column + justify-center; the button
                 needs shrink-0 or column-flex would shrink its 400px height
                 to fit), so shrinking the wrapper crops it evenly from the
                 top and bottom at its real size/ratio, keeping the image
                 centered instead of pinned to the top edge. -->
            <div id="detail-image-crop" class="relative w-full overflow-hidden flex flex-col justify-center lg:h-[400px]">
              <button
                id="carousel-main-container"
                class="relative w-full h-full lg:h-[400px] overflow-hidden flex items-center justify-center cursor-zoom-in outline-none group bg-transparent"
                aria-label="Siguiente imagen"
              >
                <!-- Custom background image matching Figma specifications exactly (flipped 180deg horizontally) -->
                <div class="absolute inset-0 striped-bg z-0 pointer-events-none"></div>

                <!-- Slides track container with sliding transform transition -->
                <div
                  id="carousel-track"
                  class="flex w-full h-full transition-transform duration-500 ease-out z-10 pointer-events-none"
                  style="transform: translate3d(0, 0, 0);"
                >
                  {imageUrls.map((img, idx) => (
                    <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
                      <img
                        src={img}
                        alt={eventData.title}
                        referrerpolicy="no-referrer"
                        class="w-full h-full object-contain"
                        style={idx === 0 ? `view-transition-name: flyer-img-${eventData.idMel};` : ""}
                      />
                    </div>
                  ))}
                </div>
              </button>
            </div>

            <!-- Pagination dots: in flow (below the image) below `lg`, so they
                 count as part of the sticky box's own content — the parent
                 grid's gap-8 always applies after them, keeping the 32px gap
                 to tags constant whether or not they're rendered. Floating absolute
                 on desktop (top-[400px]) so they don't shift the navigation
                 block there, unchanged from before. -->
            {imageUrls.length > 1 && (
              <div class="static lg:absolute lg:top-[400px] lg:left-0 lg:right-0 flex gap-4 items-center justify-center py-6 w-full" id="carousel-dots-container">

                {imageUrls.map((_, idx) => (
                  <PaginationDot
                    state={idx === 0 ? "Active" : "Resting"}
                    index={idx}
                    class="carousel-dot"
                  />
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Column 1: Tags Sidebar — DESKTOP ONLY (`lg+`) now: below `lg`,
             #detail-tags-fixed above (pinned under the header) takes over this
             role entirely (V2 layout, made definitive — see D-042/D-043), so
             this instance is `hidden` there and contributes nothing to the
             mobile grid flow. h-[400px]+justify-between matches the image
             column's own fixed height and spreads the tags across it instead
             of a flat 40px gap that leaves the column visibly shorter than
             the image next to it. -->
        <div class="hidden lg:block lg:order-1 lg:col-span-2 lg:h-[400px] w-full min-w-0" data-name="Tags Section">
          <div class="event-tags-row hidden lg:flex lg:flex-col lg:justify-between lg:gap-2 h-full min-w-0 lg:overflow-visible no-scrollbar lg:mx-0 lg:w-full lg:px-0">
            <TagWithLink
              label="Fecha"
              count={dateDisplay.text}
              state={dateDisplay.isUnknown ? "Disabled" : "Default"}
              hideBorder={true}
              class="w-full"
            />
            <TagWithLink
              label="Lugar"
              count={locationDisplay.text}
              state={locationDisplay.isUnknown ? "Disabled" : "Default"}
              href={locationDisplay.isUnknown ? undefined : `/?view=mapa&location=${encodeURIComponent(eventData.location)}`}
              hideBorder={true}
              class="w-full"
            />
            <TagWithLink
              label="Localidad"
              count={localityDisplay.text}
              state={localityDisplay.isUnknown ? "Disabled" : "Default"}
              href={localityDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.locality)}`}
              hideBorder={true}
              class="w-full"
            />
            <TagWithLink
              label="Organiza"
              count={organizerDisplay.text}
              state={organizerDisplay.isUnknown ? "Disabled" : "Default"}
              href={organizerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.organizer)}`}
              hideBorder={true}
              class="w-full"
            />
            <TagWithLink
              label="Diseño"
              count={designerDisplay.text}
              state={designerDisplay.isUnknown ? "Disabled" : "Default"}
              href={designerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.designer)}`}
              hideBorder={true}
              class="w-full"
            />
          </div>
        </div>

        <!-- Column 3: Event Info (Figma 496px wide with 24px left padding).
             order-3 (same at every breakpoint, third of three) needs to be
             explicit here — the default `order: 0` on an unstyled item would
             otherwise rank it ABOVE the image/tags columns, which both carry
             an explicit order. -->
        <div class="order-3 lg:col-span-5 flex flex-col gap-8 lg:gap-10 w-full pl-0 lg:pl-6" data-name="Info">

          <!-- Event Title (desktop position — the mobile one renders above the grid) -->
          <h2 class="hidden lg:block font-sans font-bold text-[31px] leading-[32px] tracking-[-0.62px] text-mel-text-primary">
            {eventData.title}
          </h2>

          <!-- Description + Artists block -->
          <div class="flex flex-col gap-8 lg:gap-10">
            {eventData.description && (
              <div class="flex flex-col gap-8 lg:gap-6">
                <p class="typo-body-sans text-mel-text-primary">
                  {eventData.description}
                </p>
                <!-- Figma 1px divider -->
                <div class="h-px w-full bg-mel-border"></div>
              </div>
            )}

            {(eventData.artists || '').trim() && (
              <div class="flex flex-col gap-2">
                <span class="typo-tag-label font-sans font-bold text-[13px] leading-[16px] tracking-[1.56px] uppercase text-mel-text-primary">Artistas</span>
                <div class="flex flex-wrap gap-y-1">
                  {eventData.artists.split(/[,;\/]+/).map((artist, idx, arr) => {
                    const cleanArtist = artist.trim();
                    if (!cleanArtist) return null;
                    const isLast = idx === arr.length - 1;
                    // Misma regla que en los tags: un nombre que en realidad es
                    // un centinela de "sin dato" se pinta en text-tertiary y no
                    // enlaza — buscar el archivo por "Desconocido" no lleva a
                    // ninguna parte útil.
                    const sinDato = CENTINELAS_SIN_DATO.includes(cleanArtist.toLowerCase());
                    return (
                      <span class="inline-flex items-center whitespace-nowrap">
                        {sinDato
                          ? <span class="typo-body-roman text-mel-text-tertiary">{cleanArtist}</span>
                          : <Link href={`/?search=${encodeURIComponent(cleanArtist)}`} hideChevron={true}>{cleanArtist}</Link>
                        }{!isLast && <span class="typo-body-roman text-mel-text-secondary mr-2">,</span>}
                      </span>
                    );
                  })}
                </div>
                {artistasSinDatos && (
                  <Link href="/info#contacto">¿Nos ayudas?</Link>
                )}
              </div>
            )}
          </div>

          <!-- Actions: Componetized "Me presta" button -->
          <div class="flex gap-6 items-start">
            <LikeButton
              id="btn-me-presta"
              class="w-fit"
            />
          </div>

        </div>

      </div>

      <!-- Scroll runway spacer (below `lg` only), deliberately placed BEFORE
           the nav block: growing it pushes the nav DOWN toward the screen's
           bottom edge, and scrolling can never continue past the nav (it's
           the last thing before the page's own 40px bottom padding). Sized
           by ensureScrollRunway() so that, on content-short events, the nav
           block's bottom lands exactly 40px above the bottom of the screen
           (the page container's pb-[40px], the guard against phone nav UI);
           content-rich events get no extra padding at all — their natural
           scroll end already leaves the nav pinned at that same spot. -->
      <div id="detail-scroll-runway" class="w-full lg:hidden" aria-hidden="true"></div>

      <div id="detail-nav-block" class="grid grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-6 w-full mt-10 lg:mt-24 pt-8 border-t border-mel-border lg:border-t-0 shrink-0 items-center" data-name="Navigation Block">
        
        <!-- Empty cell for Left Column alignment -->
        <div class="hidden lg:block lg:col-span-2"></div>
        
        <!-- Anterior / Siguiente.
             Nacen SIEMPRE `invisible`, con `href="#"`, y solo los revela el
             cliente cuando ha resuelto los vecinos de la secuencia activa
             (`mel-active-nav-sequence`). El servidor no puede conocer esa
             secuencia — solo sabe el orden cronológico del archivo entero —,
             así que si pintaba aquí sus propios vecinos quedaba una ventana,
             entre el primer pintado y el arranque del script, en la que estos
             enlaces apuntaban FUERA del contexto del visitante: entrando desde
             el panel de un local con dos eventos, por ejemplo, mostraban dos
             eventos cualesquiera del archivo, y pulsarlos ahí sacaba de la
             navegación acotada. Los títulos SSR se conservan solo como
             contenido de reemplazo; el cliente los sobrescribe. -->
        <div class="lg:col-span-5 flex justify-end text-right items-center invisible" id="nav-prev-container">
          <TagWithLink
            label="Anterior"
            count={prevEvent ? prevEvent.title : "Anterior"}
            alignment="Right"
            href="#"
            class="w-full max-w-[496px]"
            hideBorder={true}
          />
        </div>

        <!-- Siguiente (Left-aligned under right column with 24px left padding on desktop) -->
        <div class="lg:col-span-5 flex justify-start text-left pl-0 lg:pl-6 items-center invisible" id="nav-next-container">
          <TagWithLink
            label="Siguiente"
            count={nextEvent ? nextEvent.title : "Siguiente"}
            alignment="Left"
            href="#"
            class="w-full max-w-[496px]"
            hideBorder={true}
          />
        </div>

      </div>

    </div>

    <!-- Image Detail Lightbox Overlay (Figma 841:40903: fixed-size modal,
         image object-contained inside it — never sized off the photo's
         natural dimensions, which used to let large photos overflow the
         screen — with pagination dots inside the modal below the image) -->
    <div
      id="image-detail-overlay"
      class="fixed inset-0 bg-[var(--mel-scrim)] z-[250] opacity-0 pointer-events-none transition-opacity duration-300 hidden flex items-center justify-center"
    >
      <!-- Modal Container: proportional to viewport height, true square aspect ratio, width
           follows from that. Bottom padding matches the other sides (pb-8) when there's no
           pagination to show — with pagination, pb-4 plus the dots row's own padding reads as
           the same visual weight, so it stays smaller there on purpose. -->
      <div
        id="image-detail-modal"
        class={`relative bg-mel-bg-primary flex flex-col items-center transform scale-95 transition-transform duration-300 pt-8 px-8 ${imageUrls.length > 1 ? 'pb-4' : 'pb-8'} h-[76vh] max-w-[92vw] aspect-square`}
        data-node-id="841:40541"
      >
        <!-- Close Button (40px, offset half-outside the top-right corner) -->
        <button
          id="overlay-close-btn"
          class="absolute -top-5 -right-5 w-10 h-10 bg-mel-action-secondary text-mel-text-on-action hover:bg-mel-action-primary flex items-center justify-center shadow-[0px_4px_8px_rgba(38,31,31,0.32)] border-none cursor-pointer z-50 transition-colors"
          aria-label="Cerrar vista grande"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <!-- Image Box: fills the modal, sliding track mirrors the main carousel's transition (no autoplay here) -->
        <div id="overlay-image-box" class="relative flex-1 min-h-0 w-full overflow-hidden flex items-center justify-center">
          <div class="absolute inset-0 striped-bg pointer-events-none"></div>
          <div
            id="overlay-track"
            class="flex w-full h-full transition-transform duration-500 ease-out z-10"
            style="transform: translate3d(0, 0, 0);"
          >
            {imageUrls.map((img) => (
              <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
                <img
                  src={img}
                  alt={eventData.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-contain"
                />
              </div>
            ))}
          </div>
        </div>

        {imageUrls.length > 1 && (
          <div class="flex gap-4 items-center justify-center pt-4 pb-1 shrink-0" id="overlay-dots-container">
            {imageUrls.map((_, idx) => (
              <PaginationDot
                state={idx === 0 ? "Active" : "Resting"}
                index={idx}
                class="overlay-dot"
              />
            ))}
          </div>
        )}
      </div>
    </div>

  </div>
</Layout>

<style>
  @media (max-width: 1023px) {
    #detail-tags-fixed {
      top: 136px;
    }
  }
</style>

<script define:vars={{ ssrImageUrls: imageUrls, ssrEventId: eventData.idMel, allEvents }}>
  function initPage() {
    // astro:page-load dispara en TODAS las páginas tras una navegación suave
    // (los listeners viven en `document` y sobreviven al salto). Sin este
    // guard, al volver a la home esta función seguía ejecutándose allí y —lo
    // grave— abortaba el AbortController compartido, matando los listeners que
    // la home acababa de registrar.
    const dataNode = document.getElementById('detail-page-container');
    if (!dataNode) return;

    // Identidad REAL de la página visible, leída del DOM y no de `define:vars`
    // (ver el comentario de data-event-id en el marcado): con atrás/adelante
    // del navegador el script no se reejecuta y las variables de la closure
    // pertenecen al evento anterior. Sombrean a las del SSR para todo initPage.
    const eventId = dataNode.dataset.eventId || ssrEventId;
    let imageUrls = ssrImageUrls;
    try {
      const parsed = JSON.parse(dataNode.dataset.imageUrls || 'null');
      if (Array.isArray(parsed)) imageUrls = parsed;
    } catch (e) {}

    // Parse search/location/view queries from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const activeView = urlParams.get('view') || 'galería';
    const activeSearch = urlParams.get('search') || '';
    const activeLocation = urlParams.get('location') || '';

    // Append search/location/view queries to close button so it returns with filters and state preserved
    const closeBtn = document.getElementById('detail-close-btn');
    if (closeBtn) {
      const returnParams = new URLSearchParams();
      if (activeView) returnParams.set('view', activeView);
      if (activeSearch) returnParams.set('search', activeSearch);
      if (activeLocation) returnParams.set('location', activeLocation);
      closeBtn.href = `/?${returnParams.toString()}`;
    }

    // Abort any previous window listeners to prevent duplicates across page transitions.
    // Clave propia (_melDetailAbortCtrl), NO la de index.astro: ambas páginas
    // compartían `_melAbortCtrl` y se abortaban los listeners la una a la otra
    // según el orden en que corrieran sus respectivos astro:page-load.
    if (window._melDetailAbortCtrl) window._melDetailAbortCtrl.abort();
    window._melDetailAbortCtrl = new AbortController();
    const wSig = window._melDetailAbortCtrl.signal;

    // Pinned, shrinking image (below `lg`). Figma "Screen / Event Details"
    // (369:32751): the image sticks right below the sticky X+title header and
    // shrinks from 400px down to a documented min of 200px as the page
    // scrolls, so the rest of the content (tags, info, nav) passes underneath
    // it (it paints on top, z-20) — matching "el resto de la página pasará
    // por debajo de la foto". The box NEVER moves once pinned: its top stays
    // glued to the header's bottom edge for the whole scroll range (it never
    // slides up behind the header), only the crop window's height changes.
    // During the shrink phase the sentinel (held at a constant full-size
    // height) makes content below emerge at a steady 32px under the box's
    // receding bottom edge; once the crop bottoms out at 200px, further
    // scrolling simply sends that content underneath the (opaque, z-20) box.
    // Driven by JS rather than CSS `position: sticky` because sticky can't
    // express "pinned forever but with a scroll-driven inner height" — and
    // its own engage timing depends on natural resting position, which the
    // propietario explicitly rejected for the header (D-034).
    const stickyHeader = document.getElementById('detail-sticky-header');
    const headerSpacer = document.getElementById('detail-header-spacer');
    const imageSticky = document.getElementById('detail-image-sticky');
    const imageSentinel = document.getElementById('detail-image-sentinel');
    const imageCrop = document.getElementById('detail-image-crop');
    // Crop-window height range below `lg`. Max is 40px SHORTER than the
    // photo's fixed 400px (the photo stays 400px and centered — see the
    // crop's markup comment — so at rest 20px are already cropped off each
    // end); desktop keeps the full 400px via the crop's lg:h-[400px] class.
    const IMAGE_MAX_H = 360;
    const IMAGE_MIN_H = 200;

    // The header is `position: fixed` from the very first frame (not
    // `sticky` — see the header's own comment in the markup for why), so
    // it's out of normal flow immediately and needs its height reserved by
    // hand. Height is effectively constant (no scroll-driven resizing, only
    // varies if a title wraps to a different number of lines), but it's
    // still measured every tick rather than cached — cheap, and avoids ever
    // needing a separate invalidation path.
    function updateHeaderSpacer() {
      if (!stickyHeader || !headerSpacer) return;
      if (window.innerWidth >= 1024) {
        headerSpacer.style.height = '';
        return;
      }
      headerSpacer.style.height = `${stickyHeader.getBoundingClientRect().height}px`;
    }

    // Pins the tags row directly below the fixed header (V2 layout, made
    // definitive — mirrors the overlay's updateOverlayFixedTags() exactly).
    // No self-correcting probe needed: unlike the overlay, this page has no
    // accidental-containing-block quirk to work around (no animated wrapper
    // with `transition:transform`), so plain viewport-relative top math is
    // always correct here too. Height is effectively constant (tags never
    // wrap — every TagWithLink instance is exactly 48px tall, see D-041),
    // but still measured live each tick, matching the header's own pattern.
    function updateTagsFixed() {
      const tagsFixed = document.getElementById('detail-tags-fixed');
      const tagsFixedSpacer = document.getElementById('detail-tags-fixed-spacer');
      if (!tagsFixed || !tagsFixedSpacer || !stickyHeader) return;
      if (window.innerWidth >= 1024) {
        tagsFixed.style.top = '';
        tagsFixedSpacer.style.height = '';
        return;
      }
      tagsFixed.style.top = `${stickyHeader.getBoundingClientRect().bottom}px`;
      tagsFixedSpacer.style.height = `${tagsFixed.getBoundingClientRect().height}px`;
    }

    function updateStickyImage() {
      if (!stickyHeader || !imageSticky || !imageSentinel || !imageCrop) return;
      updateHeaderSpacer();
      updateTagsFixed();
      if (window.innerWidth >= 1024) {
        imageSticky.style.position = '';
        imageSticky.style.top = '';
        imageSticky.style.left = '';
        imageSticky.style.width = '';
        imageSticky.style.margin = '';
        imageCrop.style.height = '';
        imageSentinel.style.height = '';
        return;
      }

      // "headerBottom" now means the bottom of the whole fixed block (header +
      // pinned tags row, V2) — the image starts right below BOTH, not just
      // the header.
      const tagsFixedEl = document.getElementById('detail-tags-fixed');
      const headerBottom = tagsFixedEl ? tagsFixedEl.getBoundingClientRect().bottom : stickyHeader.getBoundingClientRect().bottom;

      // The sentinel sits at the image's natural (unpinned) flow position
      // and, being a plain block with no positioning of its own, keeps moving
      // 1:1 with scroll regardless of what the pinned image above it is
      // doing — that's what lets it measure how far past the engage point
      // we've scrolled, which drives the shrink.
      const sentinelTop = imageSentinel.getBoundingClientRect().top;
      const scrolledPast = Math.max(0, headerBottom - sentinelTop);

      // Below the engage point, stay in plain static flow instead of forcing
      // `position: fixed` — this is what it looks like anyway (right below
      // the header) at rest, and it sidesteps measuring this page's own
      // opening entrance transition mid-flight (getBoundingClientRect() on
      // anything mid-transition gives a moving-target answer, not the
      // settled one, which previously showed the photo torn/misplaced for an
      // instant right after opening).
      if (scrolledPast <= 0) {
        imageSticky.style.position = '';
        imageSticky.style.top = '';
        imageSticky.style.left = '';
        imageSticky.style.width = '';
        imageSticky.style.margin = '';
        imageCrop.style.height = `${IMAGE_MAX_H}px`;
        imageSentinel.style.height = '0px';
        return;
      }

      // The sentinel reserves the box's FULL-SIZE footprint (crop at 400px +
      // dots if present), as a constant — NOT the box's current shrunk
      // height. Measured BEFORE any mutation below (current height plus
      // however much the crop is currently shrunk — exact whether or not
      // this event has dots, without hardcoding their height), and set
      // BEFORE the box switches to `fixed`: setting it after would leave a
      // forced-layout window where the box has already left normal flow but
      // the sentinel hasn't grown yet — the page momentarily shorter than
      // the viewport, which makes the browser clamp the scroll position
      // back to 0 mid-tick (observed as "can't scroll at all"). A constant
      // sentinel also means the page's height no longer depends on scroll
      // position: during the shrink phase, content below rises 1:1 with
      // scroll while the box's bottom edge also recedes 1:1, so tags stay
      // exactly 32px (the grid's own gap-8) under it; after the crop
      // bottoms out at 200px, content simply continues up and passes
      // underneath the (opaque, z-20) box.
      const currentBlockHeight = imageSticky.getBoundingClientRect().height;
      const currentCropHeight = imageCrop.getBoundingClientRect().height;
      const fullBlockHeight = currentBlockHeight + (IMAGE_MAX_H - currentCropHeight);
      imageSentinel.style.height = `${fullBlockHeight}px`;

      const newCropHeight = Math.max(IMAGE_MIN_H, Math.min(IMAGE_MAX_H, IMAGE_MAX_H - scrolledPast));
      imageCrop.style.height = `${newCropHeight}px`;

      imageSticky.style.position = 'fixed';
      imageSticky.style.left = '0';
      // Explicit width, not `right: 0` — the static-mode w-[calc(100%+48px)]
      // class is still in the cascade, and `left`+`right`+`width` all
      // present at once is over-constrained; per spec `right` is the one
      // that gets silently ignored (in ltr), so the calc() width would win
      // and the box would render 48px past the true right edge.
      imageSticky.style.width = `${window.innerWidth}px`;
      // The negative-margin full-bleed trick (-mx-6 etc.) that positions this
      // box edge-to-edge while it's in normal static flow still applies its
      // margin to a `fixed` box too — left uncleared, it'd double up with the
      // left:0 above and render 24-48px past the left edge too.
      imageSticky.style.margin = '0';

      // Pinned at the header's bottom edge, unconditionally — the box never
      // slides up behind the header, no matter how far the page scrolls.
      imageSticky.style.top = `${headerBottom}px`;
    }

    const scrollRunway = document.getElementById('detail-scroll-runway');
    const navBlock = document.getElementById('detail-nav-block');
    // Gap the nav block must always keep to the bottom of the screen, so it
    // never sits under a phone's own navigation UI. Matches the page
    // container's pb-[40px] below `lg` — that padding is what actually
    // stops the scroll 40px short at the natural end; this constant only
    // matters for the content-short case where the runway has to push the
    // nav down to that same resting spot.
    const NAV_BOTTOM_GUARD = 40;

    // Sizes the runway (which sits BEFORE the nav block) so the nav's
    // bottom edge always ends up pinned exactly NAV_BOTTOM_GUARD px above
    // the bottom of the screen, and the scroll is limited to exactly that
    // point: content-rich events need nothing (their natural scroll end —
    // nav + the page's own bottom padding — already lands there), while
    // content-short events get the deficit added so the nav rests at the
    // bottom with no scrolling at all. Since the runway is before the nav
    // and nothing follows the nav but the 40px padding, scrolling past the
    // nav is impossible by construction. (The page's flow height is
    // scroll-independent — the sentinel reserves a constant full-size
    // footprint, see updateStickyImage() — so this is a plain one-shot
    // measurement.)
    function ensureScrollRunway() {
      if (!scrollRunway || !navBlock) return;
      updateHeaderSpacer();
      // Must run BEFORE the nav measurement below: the tags-fixed spacer sits
      // in-flow ahead of the nav, so its height directly shifts where the
      // nav ends up — measuring against a stale (zero) spacer would under-count.
      updateTagsFixed();
      if (window.innerWidth >= 1024) {
        scrollRunway.style.height = '';
        return;
      }
      scrollRunway.style.height = '0px';
      // Flow position (scroll-independent) of the nav's bottom edge.
      const navBottomFlow = navBlock.getBoundingClientRect().bottom + window.scrollY;
      const deficit = (window.innerHeight - NAV_BOTTOM_GUARD) - navBottomFlow;
      if (deficit > 0) {
        scrollRunway.style.height = `${deficit}px`;
      }

      updateStickyImage();
    }

    // Called directly on every scroll tick rather than rAF-throttled: the
    // work here is a handful of getBoundingClientRect() reads plus a few
    // style writes, cheap enough that the browser's own passive-listener
    // scheduling throttles it adequately on its own.
    ensureScrollRunway();
    updateStickyImage();
    window.addEventListener('scroll', updateStickyImage, { passive: true, signal: wSig });
    let resizeRaf = null;
    window.addEventListener('resize', () => {
      if (resizeRaf) cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        ensureScrollRunway();
        updateStickyImage();
      });
    }, { signal: wSig });

    // Web fonts (Space Grotesk / Lora) are still loading at astro:page-load
    // time, so the very first ensureScrollRunway() measurement can catch the
    // page at a taller fallback-font layout and under- or over-shoot the
    // runway it adds. Re-measure once fonts have actually settled.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        ensureScrollRunway();
        updateStickyImage();
      });
    }

    // Read active navigation vector from sessionStorage.
    // The active vector is maintained by index.astro (initial load, filters,
    // table sort, or map panel click). If absent or stale, falls back to
    // chronological order (allEvents).
    let filteredEvents = [];
    try {
      const storedOrder = sessionStorage.getItem('mel-active-nav-sequence');
      if (storedOrder) {
        const ids = JSON.parse(storedOrder);
        if (Array.isArray(ids) && ids.length > 0) {
          const mapById = new Map(allEvents.map(e => [e.idMel, e]));
          const ordered = ids.map(id => mapById.get(id)).filter(Boolean);
          if (ordered.length > 0) filteredEvents = ordered;
        }
      }
    } catch (err) {
      // Fallback to chronological
    }
    if (filteredEvents.length === 0) filteredEvents = allEvents;

    let curIdx = filteredEvents.findIndex(x => x.idMel === eventId);
    // Fallback: if the current event is not in the stored vector (direct URL
    // access without a session, or stale vector), fall back silently to
    // chronological order so navigation always works.
    if (curIdx === -1) {
      filteredEvents = allEvents;
      curIdx = filteredEvents.findIndex(x => x.idMel === eventId);
    }
    const prevEventItem = curIdx > 0 ? filteredEvents[curIdx - 1] : null;
    const nextEventItem = curIdx < filteredEvents.length - 1 ? filteredEvents[curIdx + 1] : null;

    // Build the correct detail page query param: search, location, and view
    const returnNavParams = new URLSearchParams();
    if (activeView) returnNavParams.set('view', activeView);
    if (activeSearch) returnNavParams.set('search', activeSearch);
    if (activeLocation) returnNavParams.set('location', activeLocation);
    // `sort`/`dir` se arrastran de salto en salto: los pone index.astro al
    // entrar y sin esto se perdían en el primer Anterior/Siguiente, dejando al
    // SSR del siguiente evento ordenando por fecha mientras el cliente usaba
    // la secuencia real. Solo afecta al reparto en servidor, pero es la misma
    // clase de desajuste que provocaba el parpadeo de vecinos equivocados.
    const activeSort = urlParams.get('sort');
    const activeDir = urlParams.get('dir');
    if (activeSort) returnNavParams.set('sort', activeSort);
    if (activeDir) returnNavParams.set('dir', activeDir);
    const navParam = returnNavParams.toString();

    // Helper for smooth View Transitions navigation on click
    const handleNavClick = (e) => {
      const a = e.currentTarget;
      const url = a ? a.getAttribute('href') : null;
      // El marcador SSR nace con href="#" (ver el bloque de navegación): si por
      // lo que sea llega un click antes de que el cliente lo rellene, no se
      // navega a ninguna parte en vez de saltar al principio de la página.
      if (!url || url === '#') { e.preventDefault(); return; }
      if (url && typeof window.__melNavigate === 'function') {
        e.preventDefault();
        window.__melNavigate(url);
      }
    };

    // Render navigation dynamically based on active search/location matches (using visibility:hidden to preserve grid layout!)
    const prevContainer = document.getElementById('nav-prev-container');
    if (prevContainer) {
      if (prevEventItem) {
        prevContainer.classList.remove('invisible');
        const link = prevContainer.querySelector('a');
        const text = prevContainer.querySelector('.tag-count-val');
        if (link) {
          link.href = `/event/${prevEventItem.idMel}?${navParam}`;
          link.addEventListener('click', handleNavClick, { signal: wSig });
        }
        if (text) text.textContent = prevEventItem.title;
      } else {
        prevContainer.classList.add('invisible');
        // Se neutraliza también el href: si no, queda un enlace obsoleto (del
        // SSR o del evento anterior) escondido pero vivo bajo el contenedor.
        const deadLink = prevContainer.querySelector('a');
        if (deadLink) deadLink.href = '#';
      }
    }

    const nextContainer = document.getElementById('nav-next-container');
    if (nextContainer) {
      if (nextEventItem) {
        nextContainer.classList.remove('invisible');
        const link = nextContainer.querySelector('a');
        const text = nextContainer.querySelector('.tag-count-val');
        if (link) {
          link.href = `/event/${nextEventItem.idMel}?${navParam}`;
          link.addEventListener('click', handleNavClick, { signal: wSig });
        }
        if (text) text.textContent = nextEventItem.title;
      } else {
        nextContainer.classList.add('invisible');
        // Se neutraliza también el href: si no, queda un enlace obsoleto (del
        // SSR o del evento anterior) escondido pero vivo bajo el contenedor.
        const deadLink = nextContainer.querySelector('a');
        if (deadLink) deadLink.href = '#';
      }
    }

    // Interactive like state persistent via localStorage using componetized LikeButton
    const likeKey = `mel-like-${eventId}`;
    const likeBtn = document.getElementById('btn-me-presta');
    
    if (likeBtn) {
      let isLiked = localStorage.getItem(likeKey) === 'true';
      
      const updateLikeUI = () => {
        likeBtn.setAttribute('data-active', isLiked ? 'true' : 'false');
      };

      updateLikeUI();

      likeBtn.onclick = () => {
        isLiked = !isLiked;
        localStorage.setItem(likeKey, String(isLiked));
        updateLikeUI();
      };
    }

    // Interactive Carousel Image Swap with horizontal sliding transition
    let currentIndex = 0;

    // Crucial: Clear any running autoplay interval on script mount to avoid cumulative loops
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }

    function updateCarousel(index) {
      if (!imageUrls || imageUrls.length === 0) return;
      
      // Wrap index around boundaries
      currentIndex = (index + imageUrls.length) % imageUrls.length;
      
      // Slide the track using CSS transform
      const track = document.getElementById('carousel-track');
      if (track) {
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;
      }

      // Toggle dots active attributes
      const dots = document.querySelectorAll('.carousel-dot');
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.setAttribute('data-active', isActive ? 'true' : 'false');
      });
    }

    // Autoplay function (only runs if there are multiple images)
    function startAutoplay() {
      if (!imageUrls || imageUrls.length <= 1) return;
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
      }
      window.melAutoplayInterval = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);
    }

    function resetAutoplayTimer() {
      startAutoplay();
    }

    // Large Image Overlay Lightbox. The modal is a fixed-size CSS box (see
    // markup) and the photo object-contains inside it — no JS sizing off
    // the image's natural dimensions, which is what previously let large
    // photos push the modal beyond the screen.
    const overlay = document.getElementById('image-detail-overlay');
    const overlayModal = document.getElementById('image-detail-modal');
    const overlayTrack = document.getElementById('overlay-track');
    const overlayCloseBtn = document.getElementById('overlay-close-btn');
    const overlayDots = document.querySelectorAll('.overlay-dot');

    let overlayIndex = 0;

    // Same sliding-track transition as the main carousel, but this never autoplays on its own
    function showOverlayImage(idx) {
      if (!imageUrls || imageUrls.length === 0) return;
      overlayIndex = (idx + imageUrls.length) % imageUrls.length;
      if (overlayTrack) overlayTrack.style.transform = `translate3d(-${overlayIndex * 100}%, 0, 0)`;
      overlayDots.forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === overlayIndex ? 'true' : 'false');
      });
    }

    // Left/right arrow keys navigate images while lightbox is open, or navigate events when lightbox is closed
    function handleOverlayKeydown(e) {
      const isInput = e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable);
      if (isInput) return;

      if (overlay && !overlay.classList.contains('hidden')) {
        // Lightbox open: navigate carousel photos
        if (e.key === 'ArrowLeft') { e.preventDefault(); showOverlayImage(overlayIndex - 1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); showOverlayImage(overlayIndex + 1); }
      } else {
        // Normal page view: navigate Previous / Next event
        if (e.key === 'ArrowLeft' && prevEventItem) {
          e.preventDefault();
          const url = `/event/${prevEventItem.idMel}?${navParam}`;
          if (typeof window.__melNavigate === 'function') window.__melNavigate(url);
          else window.location.href = url;
        } else if (e.key === 'ArrowRight' && nextEventItem) {
          e.preventDefault();
          const url = `/event/${nextEventItem.idMel}?${navParam}`;
          if (typeof window.__melNavigate === 'function') window.__melNavigate(url);
          else window.location.href = url;
        }
      }
    }
    document.addEventListener('keydown', handleOverlayKeydown, { signal: wSig });

    function openOverlay() {
      if (!overlay || !overlayModal) return;

      // Stop autoplay when large view is open
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
        window.melAutoplayInterval = null;
      }

      // Open on whichever image the page carousel is showing
      showOverlayImage(currentIndex);

      overlay.classList.remove('hidden');
      setTimeout(() => {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        overlayModal.classList.remove('scale-95');
        overlayModal.classList.add('scale-100');
      }, 10);
    }

    function closeOverlay() {
      if (!overlay || !overlayModal) return;

      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlayModal.classList.remove('scale-100');
      overlayModal.classList.add('scale-95');

      setTimeout(() => {
        overlay.classList.add('hidden');
        // Resume autoplay
        startAutoplay();
      }, 300);
    }

    // Click on main image container opens the lightbox — desktop only.
    // Below `lg` it instead re-expands the pinned box (animates the scroll
    // back to the top, which un-shrinks the crop 1:1) if it's currently
    // compressed by scroll, and does nothing otherwise. Hand-rolled
    // timer-driven animation — mirrors the overlay in index.astro, where
    // native smooth scrolling silently no-ops in some environments and
    // requestAnimationFrame never ticks in some sandboxed/throttled
    // contexts, while direct scroll writes always work. Time-based easing,
    // so a slow timer only lowers the frame rate, never the duration.
    const mainImageContainer = document.getElementById('carousel-main-container');
    if (mainImageContainer) {
      mainImageContainer.addEventListener('click', () => {
        if (window.innerWidth < 480) {
          if (window.scrollY > 0) {
            const startY = window.scrollY;
            const t0 = performance.now();
            const DUR = 350;
            const easeOut = (t) => 1 - Math.pow(1 - t, 3);
            const stepFrame = () => {
              const p = Math.min(1, (performance.now() - t0) / DUR);
              window.scrollTo(0, Math.round(startY * (1 - easeOut(p))));
              if (p < 1) setTimeout(stepFrame, 16);
            };
            stepFrame();
          }
          return;
        }
        openOverlay();
      });
    }

    if (overlayCloseBtn) overlayCloseBtn.onclick = closeOverlay;
    if (overlay) {
      overlay.onclick = (e) => {
        if (e.target === overlay) closeOverlay();
      };
    }

    // Lightbox pagination dots switch the displayed photo
    overlayDots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        showOverlayImage(parseInt(dot.dataset.index, 10));
      });
    });

    const dots = document.querySelectorAll('.carousel-dot');
    dots.forEach(dot => {
      dot.onclick = (e) => {
        e.stopPropagation();
        const idx = parseInt(dot.dataset.index, 10);
        updateCarousel(idx);
        resetAutoplayTimer();
      };
    });

    // Keep indicators aligned perfectly on window resize
    window.addEventListener('resize', () => {
      updateCarousel(currentIndex);
    }, { signal: wSig });

    // Deslizar con el dedo para cambiar de foto, cuando hay más de una. Se usa
    // tanto en el carrusel de la ficha como en el lightbox, así que la lógica
    // vive aquí una sola vez.
    //
    // Convive con el toque, que sigue haciendo lo suyo (expandir la imagen /
    // volver arriba): solo se considera deslizamiento si el dedo recorre más de
    // 45px en horizontal Y avanza más en horizontal que en vertical — así un
    // scroll vertical sobre la foto no cambia de imagen. Cuando sí ha sido
    // deslizamiento, se suprime el `click` que el navegador dispara después,
    // para no expandir la imagen sin querer al terminar el gesto.
    function habilitarDeslizamiento(zona, irA, indiceActual) {
      if (!zona || !imageUrls || imageUrls.length <= 1) return;

      const MINIMO = 45;
      let x0 = null, y0 = null, dxUltimo = 0, dyUltimo = 0, huboDeslizamiento = false;

      // `pan-y` es imprescindible, no un adorno: sin él el navegador se queda
      // TODO el gesto: en cuanto el dedo se mueve en horizontal decide que es un
      // desplazamiento suyo, dispara `pointercancel` y deja de mandar eventos —
      // por eso el deslizamiento no llegaba a ocurrir nunca en un dispositivo
      // real ni en la emulación del inspector. Con `pan-y` le cedemos el eje
      // vertical (el scroll de la página sigue funcionando sobre la foto) y nos
      // quedamos el horizontal.
      zona.style.touchAction = 'pan-y';

      const resolver = () => {
        if (x0 === null) return;
        x0 = null; y0 = null;
        if (Math.abs(dxUltimo) < MINIMO || Math.abs(dxUltimo) <= Math.abs(dyUltimo)) return;
        huboDeslizamiento = true;
        irA(indiceActual() + (dxUltimo < 0 ? 1 : -1));   // arrastrar a la izquierda = siguiente
      };

      zona.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse') return;   // con ratón mandan las flechas y los puntos
        x0 = e.clientX; y0 = e.clientY;
        dxUltimo = 0; dyUltimo = 0; huboDeslizamiento = false;
      }, { signal: wSig });

      // El recorrido se acumula aquí y no se lee del evento final: si el
      // navegador acaba cancelando el gesto, `pointercancel` no trae posición.
      zona.addEventListener('pointermove', (e) => {
        if (x0 === null) return;
        dxUltimo = e.clientX - x0;
        dyUltimo = e.clientY - y0;
      }, { signal: wSig });

      zona.addEventListener('pointerup', resolver, { signal: wSig });
      // Un gesto cancelado que ya había recorrido lo suficiente cuenta igual:
      // de lo contrario el deslizamiento se perdería justo en los navegadores
      // que cancelan antes.
      zona.addEventListener('pointercancel', resolver, { signal: wSig });

      // Va en captura para llegar antes que el listener de expandir.
      zona.addEventListener('click', (e) => {
        if (!huboDeslizamiento) return;
        huboDeslizamiento = false;
        e.preventDefault();
        e.stopPropagation();
      }, { capture: true, signal: wSig });
    }

    habilitarDeslizamiento(mainImageContainer, (i) => { updateCarousel(i); startAutoplay(); }, () => currentIndex);
    habilitarDeslizamiento(document.getElementById('overlay-image-box'), showOverlayImage, () => overlayIndex);

    // Initialize carousel and autoplay
    if (imageUrls && imageUrls.length > 0) {
      updateCarousel(0);
      startAutoplay();
    }
  }

  // Bind carousel and listener init to page-load so it functions perfectly on transition navigation
  document.addEventListener('astro:page-load', initPage);

  // Clean transition intervals on Astro page unload
  document.addEventListener('astro:before-preparation', () => {
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }
    if (window.melOverlayKeydownHandler) {
      document.removeEventListener('keydown', window.melOverlayKeydownHandler);
      window.melOverlayKeydownHandler = null;
    }
  });
</script>

<style>
  /* Scroll anchoring (on by default) fights the pinned-image scroll math:
     Chrome tries to keep on-screen content visually stable whenever an
     off-screen box changes size, and will silently nudge scrollY to
     compensate whenever #detail-image-crop, #detail-image-sentinel,
     #detail-header-spacer or #detail-scroll-runway resize — which then
     feeds back into updateStickyImage()'s own scroll handler, compounding
     into an unpredictable final scroll position. These are the only
     elements whose height changes purely from script, never from
     user-visible content shifting around, so disabling anchoring on them
     specifically is safe. */
  #detail-image-crop,
  #detail-image-sentinel,
  #detail-header-spacer,
  #detail-tags-fixed-spacer,
  #detail-scroll-runway {
    overflow-anchor: none;
  }

  /* Custom Typography style sheets mapping Figma tokens */
  .typo-tag-label {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: 0.12em; /* 1.56px letter-spacing */
    text-transform: uppercase;
    color: var(--mel-text-primary);
  }

  /* Custom vector diagonal line pattern with -45deg incline and border color */
  .striped-bg {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 7px,
      var(--mel-border) 7px,
      var(--mel-border) 8px
    );
  }
</style>
