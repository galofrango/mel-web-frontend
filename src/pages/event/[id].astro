---
import Layout from '../../layouts/Layout.astro';
import TagWithLink from '../../components/TagWithLink.astro';
import Link from '../../components/Link.astro';
import PaginationDot from '../../components/PaginationDot.astro';
import LikeButton from '../../components/LikeButton.astro';

// SSR route (server-rendered per request, see astro.config.mjs) — reads the
// sheet fresh on every visit instead of baking it in at build time, so new
// events/edits show up without a rebuild. Fetches + groups the full list
// (not just the one event) because Anterior/Siguiente need their neighbors.
const SHEET_ID = '1buzisIlDkCo2Rj5BYZh5-JKrAYSo3RSuBXYmJVGYT0E';
const CONFIG_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json`;

let eventsList: any[] = [];
try {
  const response = await fetch(CONFIG_URL);
  const text = await response.text();
  const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*?)\);/);

  if (match && match[1]) {
    const json = JSON.parse(match[1]);
    const rows = json.table.rows;

    const rawItems = rows.map((row) => {
      const c = row.c;
      if (!c) return null;
      return {
        evento: c[0] ? c[0].v : 'Evento sin título',
        urlDrive: c[2] ? c[2].v : '',
        fecha: c[3] ? c[3].f || c[3].v : 'SIN FECHA',
        lugar: c[4] ? c[4].v : 'León',
        localidad: c[5] ? c[5].v : '',
        coordenadas: c[6] ? c[6].v : '',
        artistas: c[7] ? c[7].v : '',
        organiza: c[8] ? c[8].v : '',
        descripcion: c[9] ? c[9].v : '',
        idMel: c[10] ? c[10].v : '',
        carruselOrder: c[11] ? c[11].v : '1',
        disenador: c[13] ? c[13].v : 'Desconocido',
        existeOriginal: c[16] ? c[16].v : '',
        formato: c[21] ? c[21].v : 'Flyer',
        notesArchivo: c[24] ? c[24].v : '',
        ocr: c[25] ? c[25].v : ''
      };
    }).filter(item => item && item.idMel && item.idMel.startsWith('MEL-'));

    // Group by Event Name + Date (same logic as index.astro to group multiple flyer images)
    const groups = {};
    rawItems.forEach(item => {
      const key = `${item.evento.trim().toLowerCase()}_${item.fecha.trim().toLowerCase()}`;
      if (!groups[key]) {
        groups[key] = {
          idMel: item.idMel,
          title: item.evento,
          date: item.fecha,
          location: item.lugar,
          locality: item.localidad,
          description: item.descripcion,
          artists: item.artistas,
          organizer: item.organiza,
          designer: item.disenador,
          carruselItems: []
        };
      }
      groups[key].carruselItems.push({
        urlDrive: item.urlDrive,
        order: parseInt(item.carruselOrder, 10) || 1
      });
    });

    eventsList = Object.values(groups).map((g: any) => {
      g.carruselItems.sort((a, b) => a.order - b.order);
      return g;
    });
  }
} catch (e) {
  console.error("Error fetching event data", e);
}

const eventIndex = eventsList.findIndex((e: any) => e.idMel === Astro.params.id);
if (eventIndex === -1) {
  return Astro.redirect('/');
}

const eventData = eventsList[eventIndex];
const prevEvent = eventIndex > 0 ? eventsList[eventIndex - 1] : null;
const nextEvent = eventIndex < eventsList.length - 1 ? eventsList[eventIndex + 1] : null;

// Map full list of events for client-side search filtering
const allEvents = eventsList.map((e: any) => ({
  idMel: e.idMel,
  title: e.title,
  location: e.location || '',
  locality: e.locality || '',
  artists: e.artists || '',
  organizer: e.organizer || '',
  designer: e.designer || ''
}));

function extractDriveImage(url) {
  if (!url) return '';
  let fileId = '';
  if (url.includes('id=')) {
    fileId = url.split('id=')[1].split('&')[0];
  } else if (url.includes('/d/')) {
    fileId = url.split('/d/')[1].split('/')[0];
  }
  return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : '';
}

const imageUrls = eventData.carruselItems.map(i => extractDriveImage(i.urlDrive)).filter(Boolean);

// Helper function to format unknown tag values
function getTagDisplay(val) {
  const clean = val ? String(val).trim() : '';
  if (!clean || clean.toLowerCase() === 'desconocido' || clean.toLowerCase() === 'sin fecha') {
    return { text: 'Desconocido', isUnknown: true };
  }
  return { text: clean, isUnknown: false };
}

const dateDisplay = getTagDisplay(eventData.date);
const locationDisplay = getTagDisplay(eventData.location);
const localityDisplay = getTagDisplay(eventData.locality);
const organizerDisplay = getTagDisplay(eventData.organizer);
const designerDisplay = getTagDisplay(eventData.designer);
---
<Layout title={eventData.title}>
  <!-- Direct morphing view transition styling for smooth flyer scale and position translation -->
  <style is:inline>
    ::view-transition-old(flyer-img-{eventData.idMel}),
    ::view-transition-new(flyer-img-{eventData.idMel}) {
      animation-duration: 0.5s !important;
      animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1) !important;
    }
  </style>

  <!-- Main layout container. pt-0 below `lg`: the header there is
       `position: fixed` from the very first frame (see its own comment)
       and #detail-header-spacer reserves exactly its height — any
       additional top padding here would just stack on top of that and push
       content down by an unwanted extra gap below the header. lg:pt-[10vh]
       matches every other page header's top offset (unaffected — desktop's
       header isn't fixed, it's back in normal flow via lg:static). Bottom
       padding is 40px on mobile/tablet (<lg) — the nav block ends up right
       around there from the screen's bottom edge once fully scrolled, per
       spec — and 108px at `lg+`, unchanged from before (desktop doesn't have
       this scroll behavior). -->
  <div class="min-h-screen bg-mel-bg-primary text-mel-text-primary flex flex-col items-center justify-start pt-0 lg:pt-[10vh] pb-[40px] lg:pb-[108px] px-6 sm:px-12">
    <!-- Main Box Container (Figma 1224px wide) -->
    <div id="detail-page-container" class="w-full max-w-[1224px] flex flex-col select-none">

      <!-- Fixed Header (X + Mobile Title), Figma "Screen / Event Details"
           (369:32751) PageHeader + "No Scrolling Content": pinned at the true
           viewport top below `lg` from the very first frame — genuinely
           `position: fixed`, not `sticky`. `sticky` was tried first, but it
           only pins once scrolled past its own natural (padded) resting
           position, so there was a real, visible window where it still moved
           with the page — unacceptable per the propietario's explicit "fija,
           sin hacer scroll en ningún momento". Being fixed from the start
           means it's out of normal flow immediately, so #detail-header-spacer
           right after it reserves its height for the content that follows
           (see updateStickyImage()) — pb-8 lives on the wrapper itself (not
           as the title's own mb-8) so that measurement is reliable: a margin
           on the last child can collapse through into the parent's own box,
           but padding never does. -->
      <div
        id="detail-sticky-header"
        class="fixed top-0 left-0 right-0 z-30 bg-mel-bg-primary px-6 pb-8 sm:px-12 lg:static lg:bg-transparent lg:px-0 lg:pb-0"
      >
        <!-- Close Button (X) at Top Left -->
        <a
          id="detail-close-btn"
          href="/"
          class="w-6 h-6 mb-8 lg:mb-16 flex items-center justify-center text-mel-action-secondary hover:text-mel-action-primary transition-colors cursor-pointer shrink-0"
          aria-label="Cerrar detalles de evento"
          data-node-id="536:47449"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </a>

        <!-- Mobile-only Event Title: on mobile (Figma 369:32751) the title sits
             between the close button and the image; on desktop it lives at the
             top of the Info column instead. -->
        <h2 class="lg:hidden font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary">
          {eventData.title}
        </h2>
      </div>

      <!-- Reserves flow space for the now-fixed header below `lg` (fixed
           elements are removed from normal flow) — height synced to the
           header's own current height every tick, so content never starts
           underneath it nor leaves an extra gap below it. -->
      <div id="detail-header-spacer" class="w-full lg:hidden" aria-hidden="true"></div>

      <!-- Three-column content grid (Figma widths: 184px, 496px, 496px). On
           mobile the same three blocks reflow per Figma 369:32751: image first
           (full-bleed, pinned, shrinking), then the tags as a horizontally
           scrollable row, then the info column — a real grid at every
           breakpoint, with `order` doing the mobile reflow (see each column's
           own comment). -->
      <div class="grid grid-cols-1 lg:grid-cols-[184px_496px_496px] gap-8 lg:gap-6 items-start">

        <!-- Column 2: Image Box (Figma 496px wide, height exactly 400px on
             desktop). order-1 (lg:order-2 restores the desktop middle-column
             position) puts it first below `lg`, matching Figma 369:32751's
             image-then-tags-then-info mobile flow. -->
        <div id="detail-image-column" class="order-1 lg:order-2 flex flex-col items-center relative h-auto lg:h-[400px] lg:mx-0 lg:w-full" data-name="Image Viewer / Desktop">
          <!-- Reserves flow space for the pinned image below `lg` (that image
               is `position: fixed` there, removed from normal flow — see
               updateStickyImage()). Its height is kept in sync with the
               pinned box's own current size on every scroll tick, so tags
               below it are never covered by, nor gapped away from, the image:
               they always start exactly where it currently ends, whatever
               that current shrunk/unshrunk size happens to be. -->
          <div id="detail-image-sentinel" class="w-full lg:hidden" aria-hidden="true"></div>

          <!-- Pinned image box (Figma 369:32751: min-h-[200px] on scroll).
               Below `lg`, updateStickyImage() drives `position: fixed` plus
               `top`/`left`/`width` directly — can't be static Tailwind
               classes since they depend on scroll position and on the sticky
               header's live height. pb-8 (32px) is the gap to whatever comes
               next (tags): it's on this box itself, after the dots if
               present, so it's the same 32px whether or not this event has
               pagination. -->
          <div
            id="detail-image-sticky"
            class="z-20 flex flex-col items-center bg-mel-bg-primary pb-8 -mx-6 w-[calc(100%+48px)] sm:-mx-12 sm:w-[calc(100%+96px)] lg:static lg:pb-0 lg:mx-0 lg:w-full lg:bg-transparent"
          >
            <!-- Crop window: THIS is what shrinks (400px→200px), via
                 overflow-hidden — not the photo itself. The photo (button
                 below) always stays a full, unscaled 400px tall and anchored
                 to this wrapper's top edge (plain flow, first/only child), so
                 shrinking the wrapper just reveals progressively less of it
                 from the bottom up, at its real size/ratio, instead of
                 rescaling it down. -->
            <div id="detail-image-crop" class="relative w-full overflow-hidden lg:h-[400px]">
              <button
                id="carousel-main-container"
                class="relative w-full h-[400px] overflow-hidden flex items-center justify-center cursor-zoom-in outline-none group bg-transparent"
                aria-label="Siguiente imagen"
              >
                <!-- Custom background image matching Figma specifications exactly (flipped 180deg horizontally) -->
                <div class="absolute inset-0 striped-bg z-0 pointer-events-none"></div>

                <!-- Slides track container with sliding transform transition -->
                <div
                  id="carousel-track"
                  class="flex w-full h-full transition-transform duration-500 ease-out z-10 pointer-events-none"
                  style="transform: translate3d(0, 0, 0);"
                >
                  {imageUrls.map((img, idx) => (
                    <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
                      <img
                        src={img}
                        alt={eventData.title}
                        referrerpolicy="no-referrer"
                        class="w-full h-full object-contain"
                        style={idx === 0 ? `view-transition-name: flyer-img-${eventData.idMel};` : ""}
                      />
                    </div>
                  ))}
                </div>
              </button>
            </div>

            <!-- Pagination dots: in flow (below the image) below `lg`, so they
                 count as part of the sticky box's own content — the pb-8
                 above always applies after them, keeping the 32px gap to tags
                 constant whether or not they're rendered. Floating absolute
                 on desktop (top-[400px]) so they don't shift the navigation
                 block there, unchanged from before. -->
            {imageUrls.length > 1 && (
              <div class="static lg:absolute lg:top-[400px] lg:left-0 lg:right-0 flex gap-4 items-center justify-center py-6 w-full" id="carousel-dots-container">

                {imageUrls.map((_, idx) => (
                  <PaginationDot
                    state={idx === 0 ? "Active" : "Resting"}
                    index={idx}
                    class="carousel-dot"
                  />
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Column 1: Tags Sidebar (Figma 184px wide). h-[400px] matches the image column's own
             fixed height, and justify-between spreads the 5 tags across it so the first one lines
             up with the image's top edge and the last with its bottom edge, instead of a flat
             40px gap that leaves the column visibly shorter than the image next to it. gap-2 is
             just a minimum floor. min-w-0 overrides the grid item's default content-based minimum
             size, which would otherwise let a long tag value push this column wider than its
             fixed 184px track. order-2 (lg:order-1 restores the desktop column position) puts it
             right after the image below `lg`, matching Figma 369:32751. The grid's own gap-8
             provides the 32px to the image column — same whether or not this event has pagination,
             since #detail-image-sentinel's height (see the Image Column's comment) already accounts
             for the dots when present. -->
        <div class="event-tags-row order-2 lg:order-1 flex flex-row lg:flex-col justify-start lg:justify-between gap-6 lg:gap-2 h-auto lg:h-[400px] w-full min-w-0 overflow-x-auto lg:overflow-visible no-scrollbar border-b border-mel-border pb-6 lg:border-b-0 lg:pb-0" data-name="Tags Section" style="view-transition-name: event-tags;">
          <TagWithLink
            label="Fecha"
            count={dateDisplay.text}
            state={dateDisplay.isUnknown ? "Disabled" : "Default"}
            hideBorder={true}
          />
          <TagWithLink
            label="Lugar"
            count={locationDisplay.text}
            state={locationDisplay.isUnknown ? "Disabled" : "Default"}
            href={locationDisplay.isUnknown ? undefined : `/?view=mapa&search=${encodeURIComponent(eventData.location)}`}
            hideBorder={true}
          />
          <TagWithLink
            label="Localidad"
            count={localityDisplay.text}
            state={localityDisplay.isUnknown ? "Disabled" : "Default"}
            href={localityDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.locality)}`}
            hideBorder={true}
          />
          <TagWithLink
            label="Organiza"
            count={organizerDisplay.text}
            state={organizerDisplay.isUnknown ? "Disabled" : "Default"}
            href={organizerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.organizer)}`}
            hideBorder={true}
          />
          <TagWithLink
            label="Diseño"
            count={designerDisplay.text}
            state={designerDisplay.isUnknown ? "Disabled" : "Default"}
            href={designerDisplay.isUnknown ? undefined : `/?search=${encodeURIComponent(eventData.designer)}`}
            hideBorder={true}
          />
        </div>

        <!-- Column 3: Event Info (Figma 496px wide with 24px left padding).
             order-3 (same at every breakpoint, third of three) needs to be
             explicit here — the default `order: 0` on an unstyled item would
             otherwise rank it ABOVE the image/tags columns, which both carry
             an explicit order. -->
        <div class="order-3 flex flex-col gap-10 w-full pl-0 lg:pl-6" data-name="Info" style="view-transition-name: event-info;">

          <!-- Event Title (desktop position — the mobile one renders above the grid) -->
          <h2 class="hidden lg:block font-sans font-bold text-[31px] leading-[32px] tracking-[-0.62px] text-mel-text-primary">
            {eventData.title}
          </h2>

          <!-- Description + Artists block -->
          <div class="flex flex-col gap-10">
            {eventData.description && (
              <div class="flex flex-col gap-6">
                <p class="font-sans font-normal text-[16px] leading-[24px] tracking-[-0.16px] text-mel-text-primary">
                  {eventData.description}
                </p>
                <!-- Figma 1px divider -->
                <div class="h-px w-full bg-mel-border"></div>
              </div>
            )}

            {eventData.artists && eventData.artists.toLowerCase() !== 'no detallados' && (
              <div class="flex flex-col gap-2">
                <span class="typo-tag-label font-sans font-bold text-[13px] leading-[16px] tracking-[1.56px] uppercase text-mel-text-primary">Artistas</span>
                <div class="flex flex-wrap gap-y-1">
                  {eventData.artists.split(/[,;\/]+/).map((artist, idx, arr) => {
                    const cleanArtist = artist.trim();
                    if (!cleanArtist) return null;
                    const isLast = idx === arr.length - 1;
                    return (
                      <span class="inline-flex items-center whitespace-nowrap">
                        <Link href={`/?search=${encodeURIComponent(cleanArtist)}`} hideChevron={true}>{cleanArtist}</Link>{!isLast && <span class="text-mel-text-secondary mr-2 font-serif font-medium text-[15px] leading-[24px] tracking-[0.15px]">,</span>}
                      </span>
                    );
                  })}
                </div>
              </div>
            )}
          </div>

          <!-- Actions: Componetized "Me presta" button -->
          <div class="flex gap-6 items-start">
            <LikeButton
              id="btn-me-presta"
              class="w-fit"
            />
          </div>

        </div>

      </div>

      <!-- Navigation block (positioned exactly 280px below the image container and
           columns on desktop, top-aligned). On mobile it's a 2-column row under a
           divider, with Anterior/Siguiente side by side (Figma 575:83196). -->
      <div id="detail-nav-block" class="grid grid-cols-2 lg:grid-cols-[184px_496px_496px] gap-8 lg:gap-6 w-full mt-12 lg:mt-[280px] pt-6 border-t border-mel-border lg:pt-0 lg:border-t-0 shrink-0 items-center" data-name="Navigation Block">
        
        <!-- Empty cell for Left Column alignment -->
        <div class="hidden lg:block"></div>
        
        <!-- Anterior (Right-aligned under middle column) -->
        <div class="flex justify-end text-right items-center" id="nav-prev-container">
          {prevEvent && (
            <TagWithLink
              label="Anterior"
              count={prevEvent.title}
              alignment="Right"
              href={`/event/${prevEvent.idMel}`}
              class="w-full max-w-[496px]"
              hideBorder={true}
              reload={true}
            />
          )}
        </div>

        <!-- Siguiente (Left-aligned under right column with 24px left padding on desktop) -->
        <div class="flex justify-start text-left pl-0 lg:pl-6 items-center" id="nav-next-container">
          {nextEvent && (
            <TagWithLink
              label="Siguiente"
              count={nextEvent.title}
              alignment="Left"
              href={`/event/${nextEvent.idMel}`}
              class="w-full max-w-[496px]"
              hideBorder={true}
              reload={true}
            />
          )}
        </div>

      </div>

      <!-- Scroll runway spacer (below `lg` only). Guarantees the shrink has
           room to fully complete (reach its 200px floor) before hitting the
           natural end of the page — without this, on a short event the crop
           is still actively shrinking right as the page runs out of content,
           and since shrinking it directly reduces the page's own scrollable
           height, scrolling further and the page getting shorter chase each
           other 1:1, forever, instead of settling: the box visibly trembles
           and the max scroll position flickers between two nearby values.
           Height is 0 by default and only grows via ensureScrollRunway() in
           the script below when the page's own natural content falls short —
           content-rich events get no extra padding at all. -->
      <div id="detail-scroll-runway" class="w-full lg:hidden" aria-hidden="true"></div>

    </div>

    <!-- Image Detail Lightbox Overlay (Figma 841:40903: fixed-size modal,
         image object-contained inside it — never sized off the photo's
         natural dimensions, which used to let large photos overflow the
         screen — with pagination dots inside the modal below the image) -->
    <div
      id="image-detail-overlay"
      class="fixed inset-0 bg-[var(--mel-scrim)] z-[250] opacity-0 pointer-events-none transition-opacity duration-300 hidden flex items-center justify-center"
    >
      <!-- Modal Container: proportional to viewport height, true square aspect ratio, width
           follows from that. Bottom padding matches the other sides (pb-8) when there's no
           pagination to show — with pagination, pb-4 plus the dots row's own padding reads as
           the same visual weight, so it stays smaller there on purpose. -->
      <div
        id="image-detail-modal"
        class={`relative bg-mel-bg-primary flex flex-col items-center transform scale-95 transition-transform duration-300 pt-8 px-8 ${imageUrls.length > 1 ? 'pb-4' : 'pb-8'} h-[76vh] max-w-[92vw] aspect-square`}
        data-node-id="841:40541"
      >
        <!-- Close Button (40px, offset half-outside the top-right corner) -->
        <button
          id="overlay-close-btn"
          class="absolute -top-5 -right-5 w-10 h-10 bg-mel-action-secondary text-mel-text-on-action hover:bg-mel-action-primary flex items-center justify-center shadow-[0px_4px_8px_rgba(38,31,31,0.32)] border-none cursor-pointer z-50 transition-colors"
          aria-label="Cerrar vista grande"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <!-- Image Box: fills the modal, sliding track mirrors the main carousel's transition (no autoplay here) -->
        <div id="overlay-image-box" class="relative flex-1 min-h-0 w-full overflow-hidden flex items-center justify-center">
          <div class="absolute inset-0 striped-bg pointer-events-none"></div>
          <div
            id="overlay-track"
            class="flex w-full h-full transition-transform duration-500 ease-out z-10"
            style="transform: translate3d(0, 0, 0);"
          >
            {imageUrls.map((img) => (
              <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
                <img
                  src={img}
                  alt={eventData.title}
                  referrerpolicy="no-referrer"
                  class="w-full h-full object-contain"
                />
              </div>
            ))}
          </div>
        </div>

        {imageUrls.length > 1 && (
          <div class="flex gap-4 items-center justify-center pt-4 pb-1 shrink-0" id="overlay-dots-container">
            {imageUrls.map((_, idx) => (
              <PaginationDot
                state={idx === 0 ? "Active" : "Resting"}
                index={idx}
                class="overlay-dot"
              />
            ))}
          </div>
        )}
      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ imageUrls, eventId: eventData.idMel, allEvents }}>
  function initPage() {
    // Parse search/location/view queries from URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const activeView = urlParams.get('view') || 'galería';
    const activeSearch = urlParams.get('search') || '';
    const activeLocation = urlParams.get('location') || '';

    // Append search/location/view queries to close button so it returns with filters and state preserved
    const closeBtn = document.getElementById('detail-close-btn');
    if (closeBtn) {
      const returnParams = new URLSearchParams();
      if (activeView) returnParams.set('view', activeView);
      if (activeSearch) returnParams.set('search', activeSearch);
      if (activeLocation) returnParams.set('location', activeLocation);
      closeBtn.href = `/?${returnParams.toString()}`;
    }

    // Abort any previous window listeners to prevent duplicates across page transitions
    if (window._melAbortCtrl) window._melAbortCtrl.abort();
    window._melAbortCtrl = new AbortController();
    const wSig = window._melAbortCtrl.signal;

    // Pinned, shrinking image (below `lg`). Figma "Screen / Event Details"
    // (369:32751): the image sticks right below the sticky X+title header and
    // shrinks from 400px down to a documented min of 200px as the page
    // scrolls, so the rest of the content (tags, info, nav) passes underneath
    // it (it paints on top, z-20) — matching "el resto de la página pasará
    // por debajo de la foto". This is driven entirely by JS rather than CSS
    // `position: sticky`: a sticky element only auto-releases (stops pinning,
    // starts scrolling away normally) once its containing block runs out of
    // room below it, which requires the sticky element itself to be at least
    // as tall as the viewport — ours (well under 500px) never is, so native
    // sticky would just stay pinned forever, permanently hiding tags/info
    // behind it. `updateStickyImage()` below computes the release by hand:
    // tags' own live position (which only depends on the sentinel's height,
    // not on wherever the pinned image is currently rendered) is compared
    // directly against the pinned box's current height, and the pin is
    // capped the instant continuing to hold it would start covering tags —
    // release happens naturally as part of the same formula, no separate
    // nav-position tracking needed, and it's mathematically guaranteed to
    // never leave tags/info/nav permanently covered.
    const stickyHeader = document.getElementById('detail-sticky-header');
    const headerSpacer = document.getElementById('detail-header-spacer');
    const imageSticky = document.getElementById('detail-image-sticky');
    const imageSentinel = document.getElementById('detail-image-sentinel');
    const imageCrop = document.getElementById('detail-image-crop');
    const tagsRow = document.querySelector('.event-tags-row');
    const IMAGE_MAX_H = 400;
    const IMAGE_MIN_H = 200;

    // The header is `position: fixed` from the very first frame (not
    // `sticky` — see the header's own comment in the markup for why), so
    // it's out of normal flow immediately and needs its height reserved by
    // hand. Height is effectively constant (no scroll-driven resizing, only
    // varies if a title wraps to a different number of lines), but it's
    // still measured every tick rather than cached — cheap, and avoids ever
    // needing a separate invalidation path.
    function updateHeaderSpacer() {
      if (!stickyHeader || !headerSpacer) return;
      if (window.innerWidth >= 1024) {
        headerSpacer.style.height = '';
        return;
      }
      headerSpacer.style.height = `${stickyHeader.getBoundingClientRect().height}px`;
    }

    function updateStickyImage() {
      if (!stickyHeader || !imageSticky || !imageSentinel || !imageCrop || !tagsRow) return;
      updateHeaderSpacer();
      if (window.innerWidth >= 1024) {
        imageSticky.style.position = '';
        imageSticky.style.top = '';
        imageSticky.style.left = '';
        imageSticky.style.width = '';
        imageSticky.style.margin = '';
        imageCrop.style.height = '';
        imageSentinel.style.height = '';
        return;
      }

      // Bottom edge of the (now permanently fixed) header. Effectively a
      // constant (headerSpacer.style.height, i.e. the header's own height),
      // but read live off the header itself rather than assumed.
      const headerBottom = stickyHeader.getBoundingClientRect().bottom;

      // The sentinel sits at the image's natural (unpinned) flow position
      // and, being a plain block with no positioning of its own, keeps moving
      // 1:1 with scroll regardless of what the pinned image above it is
      // doing — that's what lets it measure how far past the engage point
      // we've scrolled, which drives the shrink.
      const sentinelTop = imageSentinel.getBoundingClientRect().top;
      const scrolledPast = Math.max(0, headerBottom - sentinelTop);

      // Below the engage point, stay in plain static flow instead of forcing
      // `position: fixed` — this is what it looks like anyway (right below
      // the header) at rest, and it sidesteps measuring this page's own
      // opening entrance transition mid-flight (getBoundingClientRect() on
      // anything mid-transition gives a moving-target answer, not the
      // settled one, which previously showed the photo torn/misplaced for an
      // instant right after opening).
      if (scrolledPast <= 0) {
        imageSticky.style.position = '';
        imageSticky.style.top = '';
        imageSticky.style.left = '';
        imageSticky.style.width = '';
        imageSticky.style.margin = '';
        imageCrop.style.height = `${IMAGE_MAX_H}px`;
        imageSentinel.style.height = '0px';
        return;
      }

      const newCropHeight = Math.max(IMAGE_MIN_H, Math.min(IMAGE_MAX_H, IMAGE_MAX_H - scrolledPast));
      imageCrop.style.height = `${newCropHeight}px`;

      // Measure the pinned box's own current total height (crop window +
      // dots, if present, + its pb-8) now that the crop window's height is
      // set — and reserve exactly that much flow space via the sentinel, so
      // tags below always start right where this box currently ends, never
      // gapped away from it or overlapping it.
      imageSticky.style.position = 'fixed';
      imageSticky.style.left = '0';
      // Explicit width, not `right: 0` — the static-mode w-[calc(100%+48px)]
      // class is still in the cascade, and `left`+`right`+`width` all
      // present at once is over-constrained; per spec `right` is the one
      // that gets silently ignored (in ltr), so the calc() width would win
      // and the box would render 48px past the true right edge.
      imageSticky.style.width = `${window.innerWidth}px`;
      // The negative-margin full-bleed trick (-mx-6 etc.) that positions this
      // box edge-to-edge while it's in normal static flow still applies its
      // margin to a `fixed` box too — left uncleared, it'd double up with the
      // left:0 above and render 24-48px past the left edge too.
      imageSticky.style.margin = '0';
      const blockHeight = imageSticky.getBoundingClientRect().height;
      imageSentinel.style.height = `${blockHeight}px`;

      // Pin at the header's bottom edge normally — but never lower than
      // (tags' own current top minus this box's height), which would start
      // covering tags. Once scrolling brings tags' natural position up to
      // that ceiling, `desiredTop` starts tracking it 1:1 (both now moving
      // together, so the gap to tags stays constant from then on — and since
      // info/nav never move relative to tags, they're covered by exactly the
      // same guarantee).
      const tagsTop = tagsRow.getBoundingClientRect().top;
      const desiredTop = Math.min(headerBottom, tagsTop - blockHeight);
      imageSticky.style.top = `${desiredTop}px`;
    }

    const scrollRunway = document.getElementById('detail-scroll-runway');
    // Minimum scroll distance that must remain available, past the point
    // where the crop starts shrinking, for it to reach its 200px floor
    // before the page runs out of content: the shrink range itself (200px)
    // plus a safety margin (60px) — without at least this much room, the
    // shrink is still active exactly when scroll hits the natural end, and
    // since shrinking directly reduces the page's own scrollable height,
    // "scroll further" and "page gets shorter" chase each other 1:1 forever
    // instead of settling (the box visibly trembles, maxScroll flickers
    // between two nearby values).
    const MIN_SCROLL_RUNWAY = (IMAGE_MAX_H - IMAGE_MIN_H) + 60;

    function ensureScrollRunway() {
      if (!scrollRunway || !imageCrop || !imageSentinel || !imageSticky) return;
      updateHeaderSpacer();
      if (window.innerWidth >= 1024) {
        scrollRunway.style.height = '';
        return;
      }
      scrollRunway.style.height = '0px';

      // Probe: temporarily force the fully-shrunk (fixed, pinned) state to
      // see how much natural scroll room is left after it, then immediately
      // restore the real current state via updateStickyImage() — this all
      // happens synchronously before the browser paints, so it's never
      // visible. Has to actually switch to `fixed` (not just shrink the crop
      // while still static) — otherwise imageSticky keeps occupying its own
      // real flow space AND the sentinel reserves space on top of that,
      // double-counting and wildly overstating how tall the page is.
      imageCrop.style.height = `${IMAGE_MIN_H}px`;
      imageSticky.style.position = 'fixed';
      imageSticky.style.left = '0';
      imageSticky.style.width = `${window.innerWidth}px`;
      imageSticky.style.margin = '0';
      const minBlockHeight = imageSticky.getBoundingClientRect().height;
      imageSentinel.style.height = `${minBlockHeight}px`;
      const maxScrollAtFullShrink = document.documentElement.scrollHeight - window.innerHeight;

      if (maxScrollAtFullShrink < MIN_SCROLL_RUNWAY) {
        scrollRunway.style.height = `${MIN_SCROLL_RUNWAY - maxScrollAtFullShrink}px`;
      }

      updateStickyImage();
    }

    // Called directly on every scroll tick rather than rAF-throttled: the
    // work here is a handful of getBoundingClientRect() reads plus a few
    // style writes, cheap enough that the browser's own passive-listener
    // scheduling throttles it adequately on its own.
    ensureScrollRunway();
    updateStickyImage();
    window.addEventListener('scroll', updateStickyImage, { passive: true, signal: wSig });
    window.addEventListener('resize', () => {
      ensureScrollRunway();
      updateStickyImage();
    }, { signal: wSig });

    // Web fonts (Space Grotesk / Lora) are still loading at astro:page-load
    // time, so the very first ensureScrollRunway() measurement can catch the
    // page at a taller fallback-font layout and under- or over-shoot the
    // runway it adds. Re-measure once fonts have actually settled.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        ensureScrollRunway();
        updateStickyImage();
      });
    }

    // Dynamic Navigation filtering based on activeSearch or activeLocation results
    let filteredEvents = [];
    if (activeLocation) {
      // If location parameter is present, restrict navigation ONLY to events matching this location
      filteredEvents = allEvents.filter(item => item.location.toLowerCase() === activeLocation.toLowerCase());
    } else {
      // Otherwise filter by search query
      filteredEvents = allEvents.filter(item => {
        if (!activeSearch) return true;
        const q = activeSearch.toLowerCase().trim();
        return item.title.toLowerCase().includes(q) ||
               item.location.toLowerCase().includes(q) ||
               item.locality.toLowerCase().includes(q) ||
               item.artists.toLowerCase().includes(q) ||
               item.organizer.toLowerCase().includes(q) ||
               item.designer.toLowerCase().includes(q);
      });
    }

    const curIdx = filteredEvents.findIndex(x => x.idMel === eventId);
    const prevEventItem = curIdx > 0 ? filteredEvents[curIdx - 1] : null;
    const nextEventItem = curIdx < filteredEvents.length - 1 ? filteredEvents[curIdx + 1] : null;

    // Build the correct detail page query param: search, location, and view
    const returnNavParams = new URLSearchParams();
    if (activeView) returnNavParams.set('view', activeView);
    if (activeSearch) returnNavParams.set('search', activeSearch);
    if (activeLocation) returnNavParams.set('location', activeLocation);
    const navParam = returnNavParams.toString();

    // Render navigation dynamically based on active search/location matches (using visibility:hidden to preserve grid layout!)
    const prevContainer = document.getElementById('nav-prev-container');
    if (prevContainer) {
      if (prevEventItem) {
        prevContainer.classList.remove('invisible');
        const link = prevContainer.querySelector('a');
        const text = prevContainer.querySelector('.tag-count-val');
        if (link) link.href = `/event/${prevEventItem.idMel}?${navParam}`;
        if (text) text.textContent = prevEventItem.title;
      } else {
        prevContainer.classList.add('invisible');
      }
    }

    const nextContainer = document.getElementById('nav-next-container');
    if (nextContainer) {
      if (nextEventItem) {
        nextContainer.classList.remove('invisible');
        const link = nextContainer.querySelector('a');
        const text = nextContainer.querySelector('.tag-count-val');
        if (link) link.href = `/event/${nextEventItem.idMel}?${navParam}`;
        if (text) text.textContent = nextEventItem.title;
      } else {
        nextContainer.classList.add('invisible');
      }
    }

    // Interactive like state persistent via localStorage using componetized LikeButton
    const likeKey = `mel-like-${eventId}`;
    const likeBtn = document.getElementById('btn-me-presta');
    
    if (likeBtn) {
      let isLiked = localStorage.getItem(likeKey) === 'true';
      
      const updateLikeUI = () => {
        likeBtn.setAttribute('data-active', isLiked ? 'true' : 'false');
      };

      updateLikeUI();

      likeBtn.onclick = () => {
        isLiked = !isLiked;
        localStorage.setItem(likeKey, String(isLiked));
        updateLikeUI();
      };
    }

    // Interactive Carousel Image Swap with horizontal sliding transition
    let currentIndex = 0;

    // Crucial: Clear any running autoplay interval on script mount to avoid cumulative loops
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }

    function updateCarousel(index) {
      if (!imageUrls || imageUrls.length === 0) return;
      
      // Wrap index around boundaries
      currentIndex = (index + imageUrls.length) % imageUrls.length;
      
      // Slide the track using CSS transform
      const track = document.getElementById('carousel-track');
      if (track) {
        track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;
      }

      // Toggle dots active attributes
      const dots = document.querySelectorAll('.carousel-dot');
      dots.forEach((dot, idx) => {
        const isActive = idx === currentIndex;
        dot.setAttribute('data-active', isActive ? 'true' : 'false');
      });
    }

    // Autoplay function (only runs if there are multiple images)
    function startAutoplay() {
      if (!imageUrls || imageUrls.length <= 1) return;
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
      }
      window.melAutoplayInterval = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);
    }

    function resetAutoplayTimer() {
      startAutoplay();
    }

    // Large Image Overlay Lightbox. The modal is a fixed-size CSS box (see
    // markup) and the photo object-contains inside it — no JS sizing off
    // the image's natural dimensions, which is what previously let large
    // photos push the modal beyond the screen.
    const overlay = document.getElementById('image-detail-overlay');
    const overlayModal = document.getElementById('image-detail-modal');
    const overlayTrack = document.getElementById('overlay-track');
    const overlayCloseBtn = document.getElementById('overlay-close-btn');
    const overlayDots = document.querySelectorAll('.overlay-dot');

    let overlayIndex = 0;

    // Same sliding-track transition as the main carousel, but this never autoplays on its own
    function showOverlayImage(idx) {
      if (!imageUrls || imageUrls.length === 0) return;
      overlayIndex = (idx + imageUrls.length) % imageUrls.length;
      if (overlayTrack) overlayTrack.style.transform = `translate3d(-${overlayIndex * 100}%, 0, 0)`;
      overlayDots.forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === overlayIndex ? 'true' : 'false');
      });
    }

    // Left/right arrow keys navigate images while the lightbox is open
    function handleOverlayKeydown(e) {
      if (!overlay || overlay.classList.contains('hidden')) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); showOverlayImage(overlayIndex - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); showOverlayImage(overlayIndex + 1); }
    }
    if (window.melOverlayKeydownHandler) {
      document.removeEventListener('keydown', window.melOverlayKeydownHandler);
    }
    window.melOverlayKeydownHandler = handleOverlayKeydown;
    document.addEventListener('keydown', window.melOverlayKeydownHandler);

    function openOverlay() {
      if (!overlay || !overlayModal) return;

      // Stop autoplay when large view is open
      if (window.melAutoplayInterval) {
        clearInterval(window.melAutoplayInterval);
        window.melAutoplayInterval = null;
      }

      // Open on whichever image the page carousel is showing
      showOverlayImage(currentIndex);

      overlay.classList.remove('hidden');
      setTimeout(() => {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        overlayModal.classList.remove('scale-95');
        overlayModal.classList.add('scale-100');
      }, 10);
    }

    function closeOverlay() {
      if (!overlay || !overlayModal) return;

      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlayModal.classList.remove('scale-100');
      overlayModal.classList.add('scale-95');

      setTimeout(() => {
        overlay.classList.add('hidden');
        // Resume autoplay
        startAutoplay();
      }, 300);
    }

    // Click on main image container opens overlay
    const mainImageContainer = document.getElementById('carousel-main-container');
    if (mainImageContainer) {
      mainImageContainer.addEventListener('click', openOverlay);
    }

    if (overlayCloseBtn) overlayCloseBtn.onclick = closeOverlay;
    if (overlay) {
      overlay.onclick = (e) => {
        if (e.target === overlay) closeOverlay();
      };
    }

    // Lightbox pagination dots switch the displayed photo
    overlayDots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        showOverlayImage(parseInt(dot.dataset.index, 10));
      });
    });

    const dots = document.querySelectorAll('.carousel-dot');
    dots.forEach(dot => {
      dot.onclick = (e) => {
        e.stopPropagation();
        const idx = parseInt(dot.dataset.index, 10);
        updateCarousel(idx);
        resetAutoplayTimer();
      };
    });

    // Keep indicators aligned perfectly on window resize
    window.addEventListener('resize', () => {
      updateCarousel(currentIndex);
    }, { signal: wSig });

    // Initialize carousel and autoplay
    if (imageUrls && imageUrls.length > 0) {
      updateCarousel(0);
      startAutoplay();
    }
  }

  // Bind carousel and listener init to page-load so it functions perfectly on transition navigation
  document.addEventListener('astro:page-load', initPage);

  // Clean transition intervals on Astro page unload
  document.addEventListener('astro:before-preparation', () => {
    if (window.melAutoplayInterval) {
      clearInterval(window.melAutoplayInterval);
      window.melAutoplayInterval = null;
    }
    if (window.melOverlayKeydownHandler) {
      document.removeEventListener('keydown', window.melOverlayKeydownHandler);
      window.melOverlayKeydownHandler = null;
    }
  });
</script>

<style>
  /* Scroll anchoring (on by default) fights the pinned-image scroll math:
     Chrome tries to keep on-screen content visually stable whenever an
     off-screen box changes size, and will silently nudge scrollY to
     compensate whenever #detail-image-crop, #detail-image-sentinel,
     #detail-header-spacer or #detail-scroll-runway resize — which then
     feeds back into updateStickyImage()'s own scroll handler, compounding
     into an unpredictable final scroll position. These are the only
     elements whose height changes purely from script, never from
     user-visible content shifting around, so disabling anchoring on them
     specifically is safe. */
  #detail-image-crop,
  #detail-image-sentinel,
  #detail-header-spacer,
  #detail-scroll-runway {
    overflow-anchor: none;
  }

  /* Custom Typography style sheets mapping Figma tokens */
  .typo-tag-label {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    line-height: 16px;
    letter-spacing: 0.12em; /* 1.56px letter-spacing */
    text-transform: uppercase;
    color: var(--mel-text-primary);
  }

  /* Custom vector diagonal line pattern with -45deg incline and border color */
  .striped-bg {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 7px,
      var(--mel-border) 7px,
      var(--mel-border) 8px
    );
  }

  /* Custom dissolve view transitions for details page info/tags panels */
  ::view-transition-old(event-info),
  ::view-transition-old(event-tags) {
    animation: fade-out 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  ::view-transition-new(event-info),
  ::view-transition-new(event-tags) {
    animation: fade-in 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes fade-out {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
