/**
 * /panel — pestaña Control. Diagnóstico de los 84 carteles del archivo: qué
 * falla, por qué y cómo se corrige. SOLO LECTURA en esta tarea (tarea 5 del
 * plan): todo lo que se ve está pintado por el servidor, y ningún control
 * hace nada todavía al pulsarlo — eso es la tarea 6 (el cliente) y la 7 (los
 * arreglos con `sips`). La única excepción son los enlaces reales a la hoja
 * de cálculo (MEL de cada fila, "Abrir en la hoja" de las tres reglas
 * manuales): son navegación pura, sin backend propio, y el propio encargo los
 * pide verificados en este mismo paso.
 *
 * El guarda va ANTES que cualquier otra cosa del frontmatter — punto 1 de la
 * sección "Seguridad" del spec: si esta ruta llegara a existir en producción,
 * ahí sí habría algo escuchando en internet capaz de lanzar `sips` o escribir
 * en Drive más adelante (tareas 6/7). `npm run build` + grep sobre `dist/`
 * comprueba que este guarda deja la ruta fuera del build de producción.
 */
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

// El panel es de escritorio y del propio ordenador, no de "todo el que esté en
// dev": `npm run dev --host` publicaría esta ruta a todo el wifi, y la tarea 7
// le pone botones que ejecutan `sips`. Basta la cabecera Host — sin ella (o
// con cualquier otra cosa) 404, igual que fuera de DEV.
const host = Astro.request.headers.get('host') || '';
if (!/^(localhost|127\.0\.0\.1)(:\d+)?$/.test(host)) return new Response(null, { status: 404 });

import Layout from '../layouts/Layout.astro';
import PanelTarjeta from '../components/PanelTarjeta.astro';
import PanelCifra from '../components/PanelCifra.astro';
import PanelSeccion from '../components/PanelSeccion.astro';
import PanelModal from '../components/PanelModal.astro';
import PanelNota from '../components/PanelNota.astro';
import { resumirHistorial, type Apunte } from '../lib/historial';
import { auditar, AUTOMATICAS, LIMPIO, type FilaHoja } from '../lib/auditoria';
import { fetchSheetRows, mapSheetRow } from '../lib/mel';
import { medirDeDrive } from '../lib/imagen.ts';
// Lectura de disco y no `import`: el registro puede no existir todavía, y un
// import de un fichero ausente tumba el build. Es de la ruta de arreglos, que
// lo va escribiendo — no es un dato del repositorio.
import { readFileSync, writeFileSync } from 'node:fs';

// La caché de medidas también se lee DEL DISCO en cada petición, y no con un
// `import`. El motivo es una cadena de dos eslabones que costó encontrarla:
//
//   1. La ruta de arreglos reescribe este fichero tras cada pasada.
//   2. Para que eso no dispare una recarga en caliente a mitad de faena, el
//      fichero está excluido del vigilante de Vite (D-196).
//
// Con un `import`, Vite se queda con la copia que leyó al arrancar y —al estar
// fuera del vigilante— ya nunca la refresca: los carteles arreglados seguían
// saliendo en su sección después de convertirlos, aunque el disco y el historial
// dijeran lo contrario. Un `readFileSync` por petición cuesta nada (100 entradas)
// y siempre dice la verdad.
//
// La ficha de evento SÍ usa `import`, y hace bien: en producción este fichero se
// hornea en el build y no lo reescribe nadie.
const RUTA_TECNICO = new URL('../data/flyer_tecnico.json', import.meta.url);
const flyerTecnico: Record<string, any> = JSON.parse(readFileSync(RUTA_TECNICO, 'utf8'));

// Misma hoja que el resto del sitio, leída en vivo (mel.ts, sin caché propia).
// Los datos técnicos (dimensiones, formato, peso, perfil) SÍ están cacheados
// en flyer_tecnico.json — medirlos exige descargar los 84 originales de Drive,
// ~125 MB, y no se puede hacer en cada carga de página (ver spec, "De dónde
// salen los datos").
const rawRows = await fetchSheetRows();

// mapSheetRow no numera filas (no es su trabajo: mel.ts es la capa de datos
// compartida con la home y la ficha, que no necesitan ese número). El +2 es
// el desfase entre índice de array (0-based, ya sin cabecera) y número de
// fila real de la hoja (1-based, CON cabecera en la fila 1) — el propio plan
// lo señala así por si el enlace de un MEL cae en la fila de al lado.
const filas: FilaHoja[] = rawRows
  .map((row: any, i: number) => {
    const mapeada = mapSheetRow(row.c);
    return mapeada ? { ...mapeada, n: i + 2 } : null;
  })
  .filter((f: FilaHoja | null): f is FilaHoja => !!f && f.idMel.startsWith('MEL-'));

// urlDrive y formato por idMel: auditoria.ts no los lleva en `Item` (no los
// necesita para auditar, y ese tipo ya está aprobado/testeado en la tarea 4)
// — la miniatura y la columna nueva de formato de la tabla los piden aparte.
// Mismo parseo de id que auditoria.ts (que a su vez lo repite de mel.ts): se
// duplica aquí en vez de importarse porque no está exportado — es la práctica
// ya asentada en el proyecto (ver comentario de idDeDrive en auditoria.ts).
function idDeDrive(url: string): string {
  if (!url) return '';
  if (url.includes('id=')) return url.split('id=')[1].split('&')[0];
  if (url.includes('/d/')) return url.split('/d/')[1].split('/')[0];
  return '';
}
const ROTULO_FORMATO: Record<string, string> = { jpeg: 'JPG', png: 'PNG', gif: 'GIF' };

// --- El panel mide lo que le falte, al arrancar ------------------------------
// `flyer_tecnico.json` se rellena offline con `scripts/medir-archivo.mjs`, así
// que un cartel recién subido a la hoja llegaba aquí sin medir y caía en la
// sección «Sin medir». Eso es correcto como aviso pero es pereza como
// comportamiento: el panel PUEDE averiguarlo, y son dos segundos.
//
// Se miden SOLO los que faltan, en lotes de 8 (más y Drive corta), y el
// resultado se guarda en el mismo fichero que escribe el script — así la
// siguiente carga ya no paga nada. Medir los 101 costaría ~125 MB y sí sería
// inaceptable en cada visita; medir los 11 que faltan, no.
//
// Solo en desarrollo, que es lo único que existe de esta página.
const tecnico: Record<string, any> = { ...flyerTecnico };
const porMedir = [...new Set(filas.map((f) => idDeDrive(f.urlDrive)).filter((id) => id && !tecnico[id]))];
if (import.meta.env.DEV && porMedir.length) {
  for (let i = 0; i < porMedir.length; i += 8) {
    await Promise.all(porMedir.slice(i, i + 8).map(async (id) => {
      // Un fallo no tumba la página: ese cartel se queda en «Sin medir», que
      // es exactamente lo que la sección está para decir.
      try { tecnico[id] = await medirDeDrive(id); } catch { /* sigue sin medir */ }
    }));
  }
  const medidos = porMedir.filter((id) => tecnico[id]).length;
  if (medidos) {
    writeFileSync(RUTA_TECNICO, JSON.stringify(tecnico, null, 2) + '\n');
    console.log(`[panel] medidos ${medidos} carteles nuevos y guardados en flyer_tecnico.json`);
  }
}

const urlPorId: Record<string, string> = {};
const formatoPorId: Record<string, string> = {};
filas.forEach((f) => {
  urlPorId[f.idMel] = f.urlDrive;
  formatoPorId[f.idMel] = ROTULO_FORMATO[tecnico[idDeDrive(f.urlDrive)]?.tipo] || '—';
});

const grupos = auditar(filas, tecnico);

// Avisos silenciados con `#oculto:` en la hoja. Se cuentan AVISOS, no carteles:
// un mismo cartel con dos avisos silenciados suma dos, porque lo que el
// interruptor enseña son avisos.
// El registro de lo que el panel ya ha hecho. Se lee del disco porque es lo que
// escribe la ruta de arreglos tras cada pasada REAL; si no existe todavía, no
// hay nada que presumir y la tarjeta lo dice con un cero honesto.
let apuntes: Apunte[] = [];
try {
  apuntes = JSON.parse(readFileSync(new URL('../data/panel_historial.json', import.meta.url), 'utf8'));
} catch { /* aún no se ha arreglado nada */ }
const pesoActual = Object.values(tecnico).reduce((n: number, d: any) => n + (d?.bytes ?? 0), 0);
const historial = resumirHistorial(apuntes, pesoActual);
const totalCarteles = Object.keys(tecnico).length;
const MB = (b: number) => Math.round(b / 1048576);

const totalOcultos = grupos.reduce((n, g) => n + g.items.filter((it) => it.oculto).length, 0);

// --- Resumen de cada tarjeta (nivel 1/2) -----------------------------------
// La cifra grande es de IDS ÚNICOS, no la suma de los tamaños de sección: un
// mismo cartel puede estar en varias reglas del mismo nivel (p.ej. un PNG que
// además pesa más de 2MB), y sumar lo contaría dos veces. El desglose muestra
// las 3 PRIMERAS secciones de ese nivel EN EL ORDEN DE auditar() — que es
// orden de trabajo, no un ranking por tamaño (auditoria.ts:5-9): reordenar
// por cantidad pondría "Sin perfil"/"+2MB" (efectos) por delante de "PNG"/
// "CMYK" (causas que arrastran a los demás), invirtiendo justo el consejo que
// la cascada existe para dar. Si sobra alguna cuarta y siguientes, se resumen
// en una línea con el total de lo que no cupo — igual que hará la tarea 6 tras
// cada recálculo (mismo cómputo, aquí solo en el primer pintado del servidor).
type Linea = { titulo: string; cifra: number };

function resumenNivel(nivel: 1 | 2) {
  const gruposNivel = grupos.filter((g) => g.nivel === nivel);

  // Solo lo VISIBLE. Los avisos silenciados en la hoja vienen igual dentro del
  // grupo (para que el interruptor «Ver ocultos» pueda sacarlos sin
  // volver al servidor), pero no cuentan en ninguna cifra de partida. Cuando el
  // interruptor se enciende, `recalcularTodo()` reescribe estas mismas cifras
  // desde el DOM con el mismo criterio.
  const visibles = (g: typeof gruposNivel[number]) => g.items.filter((it) => !it.oculto);

  const idsUnicos = new Set<string>();
  gruposNivel.forEach((g) => visibles(g).forEach((it) => idsUnicos.add(it.idMel)));

  // Solo las líneas que existen — nada de relleno cuando el nivel tiene menos
  // de 3 secciones (corrección del propietario: "una tarjeta con menos de tres
  // avisos no pinta guiones"). PanelTarjeta alinea `.lins` arriba, pegado a la
  // cifra, para que las tarjetas compartan línea de base pese a tener listas
  // de alto distinto.
  const top3 = gruposNivel.slice(0, 3);
  const lineas: Linea[] = top3.map((g) => ({ titulo: g.titulo, cifra: visibles(g).length }));

  const restantes = gruposNivel.slice(3);
  const desbordamiento = restantes.length > 0
    ? restantes.reduce((suma, g) => suma + visibles(g).length, 0)
    : null;

  return { cifra: idsUnicos.size, lineas, desbordamiento };
}

const tarjetas = [
  { nivel: 1 as const, overline: 'Falta información', ...resumenNivel(1) },
  { nivel: 2 as const, overline: 'Bajo rendimiento', ...resumenNivel(2) },
];
