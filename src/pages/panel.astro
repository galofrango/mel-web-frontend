---
/**
 * /panel — pestaña Control. Diagnóstico de los 84 carteles del archivo: qué
 * falla, por qué y cómo se corrige. SOLO LECTURA en esta tarea (tarea 5 del
 * plan): todo lo que se ve está pintado por el servidor, y ningún control
 * hace nada todavía al pulsarlo — eso es la tarea 6 (el cliente) y la 7 (los
 * arreglos con `sips`). La única excepción son los enlaces reales a la hoja
 * de cálculo (MEL de cada fila, "Abrir en la hoja" de las tres reglas
 * manuales): son navegación pura, sin backend propio, y el propio encargo los
 * pide verificados en este mismo paso.
 *
 * El guarda va ANTES que cualquier otra cosa del frontmatter — punto 1 de la
 * sección "Seguridad" del spec: si esta ruta llegara a existir en producción,
 * ahí sí habría algo escuchando en internet capaz de lanzar `sips` o escribir
 * en Drive más adelante (tareas 6/7). `npm run build` + grep sobre `dist/`
 * comprueba que este guarda deja la ruta fuera del build de producción.
 */
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

// El panel es de escritorio y del propio ordenador, no de "todo el que esté en
// dev": `npm run dev --host` publicaría esta ruta a todo el wifi, y la tarea 7
// le pone botones que ejecutan `sips`. Basta la cabecera Host — sin ella (o
// con cualquier otra cosa) 404, igual que fuera de DEV.
const host = Astro.request.headers.get('host') || '';
if (!/^(localhost|127\.0\.0\.1)(:\d+)?$/.test(host)) return new Response(null, { status: 404 });

import Layout from '../layouts/Layout.astro';
import PanelTarjeta from '../components/PanelTarjeta.astro';
import PanelSeccion from '../components/PanelSeccion.astro';
import { auditar, LIMPIO, type FilaHoja } from '../lib/auditoria';
import { fetchSheetRows, mapSheetRow } from '../lib/mel';
import flyerTecnico from '../data/flyer_tecnico.json';

// Misma hoja que el resto del sitio, leída en vivo (mel.ts, sin caché propia).
// Los datos técnicos (dimensiones, formato, peso, perfil) SÍ están cacheados
// en flyer_tecnico.json — medirlos exige descargar los 84 originales de Drive,
// ~125 MB, y no se puede hacer en cada carga de página (ver spec, "De dónde
// salen los datos").
const rawRows = await fetchSheetRows();

// mapSheetRow no numera filas (no es su trabajo: mel.ts es la capa de datos
// compartida con la home y la ficha, que no necesitan ese número). El +2 es
// el desfase entre índice de array (0-based, ya sin cabecera) y número de
// fila real de la hoja (1-based, CON cabecera en la fila 1) — el propio plan
// lo señala así por si el enlace de un MEL cae en la fila de al lado.
const filas: FilaHoja[] = rawRows
  .map((row: any, i: number) => {
    const mapeada = mapSheetRow(row.c);
    return mapeada ? { ...mapeada, n: i + 2 } : null;
  })
  .filter((f: FilaHoja | null): f is FilaHoja => !!f && f.idMel.startsWith('MEL-'));

// urlDrive y formato por idMel: auditoria.ts no los lleva en `Item` (no los
// necesita para auditar, y ese tipo ya está aprobado/testeado en la tarea 4)
// — la miniatura y la columna nueva de formato de la tabla los piden aparte.
// Mismo parseo de id que auditoria.ts (que a su vez lo repite de mel.ts): se
// duplica aquí en vez de importarse porque no está exportado — es la práctica
// ya asentada en el proyecto (ver comentario de idDeDrive en auditoria.ts).
function idDeDrive(url: string): string {
  if (!url) return '';
  if (url.includes('id=')) return url.split('id=')[1].split('&')[0];
  if (url.includes('/d/')) return url.split('/d/')[1].split('/')[0];
  return '';
}
const ROTULO_FORMATO: Record<string, string> = { jpeg: 'JPG', png: 'PNG', gif: 'GIF' };

const urlPorId: Record<string, string> = {};
const formatoPorId: Record<string, string> = {};
filas.forEach((f) => {
  urlPorId[f.idMel] = f.urlDrive;
  const tipo = (flyerTecnico as any)[idDeDrive(f.urlDrive)]?.tipo;
  formatoPorId[f.idMel] = ROTULO_FORMATO[tipo] || '—';
});

const grupos = auditar(filas, flyerTecnico as any);

// --- Resumen de cada tarjeta (nivel 1/2/3) ---------------------------------
// La cifra grande es de IDS ÚNICOS, no la suma de los tamaños de sección: un
// mismo cartel puede estar en varias reglas del mismo nivel (p.ej. un PNG que
// además pesa más de 2MB), y sumar lo contaría dos veces. El desglose muestra
// las 3 PRIMERAS secciones de ese nivel EN EL ORDEN DE auditar() — que es
// orden de trabajo, no un ranking por tamaño (auditoria.ts:5-9): reordenar
// por cantidad pondría "Sin perfil"/"+2MB" (efectos) por delante de "PNG"/
// "CMYK" (causas que arrastran a los demás), invirtiendo justo el consejo que
// la cascada existe para dar. Si sobra alguna cuarta y siguientes, se resumen
// en una línea con el total de lo que no cupo — igual que hará la tarea 6 tras
// cada recálculo (mismo cómputo, aquí solo en el primer pintado del servidor).
type Linea = { titulo: string; cifra: number };

function resumenNivel(nivel: 1 | 2 | 3) {
  const gruposNivel = grupos.filter((g) => g.nivel === nivel);

  const idsUnicos = new Set<string>();
  gruposNivel.forEach((g) => g.items.forEach((it) => idsUnicos.add(it.idMel)));

  // Solo las líneas que existen — nada de relleno cuando el nivel tiene menos
  // de 3 secciones (corrección del propietario: "una tarjeta con menos de tres
  // avisos no pinta guiones"). PanelTarjeta alinea `.lins` abajo para que las
  // tres tarjetas compartan línea de base pese a tener listas de alto distinto.
  const top3 = gruposNivel.slice(0, 3);
  const lineas: Linea[] = top3.map((g) => ({ titulo: g.titulo, cifra: g.items.length }));

  const restantes = gruposNivel.slice(3);
  const desbordamiento = restantes.length > 0
    ? restantes.reduce((suma, g) => suma + g.items.length, 0)
    : null;

  return { cifra: idsUnicos.size, lineas, desbordamiento };
}

const tarjetas = [
  { nivel: 1 as const, overline: 'Fallos críticos', ...resumenNivel(1) },
  { nivel: 2 as const, overline: 'Bajo rendimiento', ...resumenNivel(2) },
  { nivel: 3 as const, overline: 'Falta información', ...resumenNivel(3) },
];
---

<Layout title="Panel de archivos">
  <div class="w-full max-w-[1440px] min-h-dvh mx-auto bg-mel-bg-primary px-6 sm:px-12 lg:px-[108px] pb-16">

    <header class="pt-10 pb-6">
      <div class="flex items-center justify-between gap-4 pb-6 border-b border-mel-border">
        <h1 class="typo-h3 text-mel-text-primary">Panel de archivos M.E.L.</h1>
        <nav class="flex items-center gap-6" aria-label="Secciones del panel">
          <span class="typo-button text-mel-text-primary" aria-current="page">Control</span>
          <span class="typo-button text-mel-text-tertiary" title="Todavía no existe: ingesta de material nuevo">Preparación</span>
        </nav>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pt-6">
        <p class="typo-lead text-mel-text-secondary max-w-[720px]">
          Una página interna que dice, en un vistazo, qué le pasa hoy al archivo y deja arreglar en el sitio lo que se puede arreglar solo.
        </p>
        <!-- Sin JS todavía (tarea 6): "releer" no puede distinguir la lectura
             barata de la hoja del remedido caro de las 84 imágenes, así que
             se queda desactivado en vez de fingir que hace la mitad. -->
        <button type="button" class="shrink-0 h-14 px-6 inline-flex items-center gap-3 bg-mel-action-primary text-mel-text-on-action-primary typo-button whitespace-nowrap disabled:opacity-60 disabled:cursor-not-allowed" disabled>
          Releer el archivo
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a9 9 0 0 1-15.3 6.4L3 16"></path>
            <path d="M3 12a9 9 0 0 1 15.3-6.4L21 8"></path>
            <path d="M3 21v-5h5"></path>
            <path d="M21 3v5h-5"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pb-10">
      {tarjetas.map((t) => (
        <PanelTarjeta
          nivel={t.nivel}
          overline={t.overline}
          cifra={t.cifra}
          lineas={t.lineas}
          desbordamiento={t.desbordamiento}
        />
      ))}
    </div>

    <div class="flex flex-col gap-6 pb-16">
      {grupos.map((grupo) => (
        <PanelSeccion grupo={grupo} urlPorId={urlPorId} formatoPorId={formatoPorId} />
      ))}
    </div>

    <!-- Comprobaciones que hoy dan cero (tarea 4, LIMPIO). Se enseñan igual:
         si el panel no dice lo que miró y pasó, no se sabe si llegó a
         mirarlo. Sin ganchos de la tarea 6 a propósito: no hay nada que
         recalcular aquí (no hay filas, ni ocultar, ni acción). -->
    <div class="border-t border-mel-border pt-6">
      <p class="typo-caption text-mel-text-tertiary">
        Comprobaciones sin hallazgos hoy: {LIMPIO.join(' · ')}.
      </p>
    </div>

  </div>
</Layout>

<script>
  // Comportamiento de cliente del panel de control del archivo (tarea 6 del
  // plan). El marcado entero lo pinta el servidor (tarea 5): este script SOLO
  // escribe valores dentro de él y alterna clases o atributos — nunca
  // construye nodos nuevos (regla 7 de AGENTS.md). Ganchos que consume, todos
  // dejados por la tarea 5: `[data-nivel]`/`[data-clave]` en cada `<section>`,
  // `.fila[data-id]` en cada fila, `.tarj` en cada tarjeta,
  // `.sec-cab[aria-expanded]` en la cabecera plegable, `.nn` en el contador
  // entre corchetes, `.cifra`/`.lins` en la tarjeta, `.seleccionar-todos`,
  // `.ver-ocultos`, `.ocultar-seleccionados`, `.accion-seleccionados` (estas
  // tres nacen `hidden`) y `.ocultar-aviso` (nace `disabled`).
  //
  // NO implementado — punto 7 del encargo (cabecera de columnas que ordena):
  // pide una fila de rótulos nueva (Evento · MEL · Dimensiones · Formato ·
  // Peso) dentro de la tabla de cada sección, y esa fila no existe en el
  // marcado de `PanelSeccion.astro` (confirmado leyendo el fichero entero y
  // el historial de `progress.md`: el propietario la pidió DESPUÉS de que la
  // tarea 5 se diera por completa y revisada). El propio encargo de esta
  // tarea es explícito: si esa fila falta, hay que pararse a decirlo en vez
  // de construirla por JS (regla 7) o de ampliar el alcance a un fichero que
  // el encargo no lista (`PanelSeccion.astro`; esta tarea solo declara
  // `src/pages/panel.astro`, bloque `<script>`). Detalle y propuesta en el
  // informe de la tarea 6.

  const NIVELES = [1, 2, 3] as const;

  // --- Filas: ocultar / mostrar ---------------------------------------------
  // `.fila` es `display:contents` (clase propia de PanelSeccion.astro, más la
  // utilidad `contents` de Tailwind) para que sus 8 hijos caigan en la rejilla
  // de `.tabla` en vez de abrir su propio grid anidado. El atributo `hidden`
  // NO basta para ocultarla: `[hidden]` vive en la hoja de estilos del USER
  // AGENT, y una regla de autor (la de `.fila`) le gana SIEMPRE a una de UA,
  // gane o no en especificidad — el atributo se pondría pero la fila seguiría
  // maquetada. El estilo en línea sí gana siempre (especificidad máxima), así
  // que es lo que se usa aquí.
  function filaOculta(fila: HTMLElement): boolean {
    return fila.style.display === 'none';
  }
  function ocultarFila(fila: HTMLElement) {
    fila.style.display = 'none';
    const chk = fila.querySelector('.chk-fila') as HTMLInputElement | null;
    if (chk) chk.checked = false;
  }
  function mostrarFila(fila: HTMLElement) {
    fila.style.display = '';
  }
  function filasDe(sec: Element): HTMLElement[] {
    return Array.from(sec.querySelectorAll('.fila[data-id]')) as HTMLElement[];
  }

  // --- Tarjetas: filtran las secciones de su nivel --------------------------
  // Mismas clases que pintaría el servidor con `activa=true` en
  // PanelTarjeta.astro — no se inventa ningún estado visual nuevo.
  const CLASES_TARJ_ACTIVA = ['bg-mel-bg-tertiary', 'border-mel-action-primary', 'shadow-[var(--mel-shadow-button)]'];
  const CLASES_TARJ_INACTIVA = ['bg-mel-bg-secondary', 'border-mel-border'];

  function marcarTarjeta(tarj: HTMLElement, activa: boolean) {
    tarj.dataset.activa = activa ? 'true' : 'false';
    CLASES_TARJ_ACTIVA.forEach((c) => tarj.classList.toggle(c, activa));
    CLASES_TARJ_INACTIVA.forEach((c) => tarj.classList.toggle(c, !activa));
  }

  // Pulsar la tarjeta ya activa la apaga (vuelven a verse las diez
  // secciones); pulsar otra la activa a ella sola en exclusiva.
  function pulsarTarjeta(tarj: HTMLElement) {
    const yaActiva = tarj.dataset.activa === 'true';
    document.querySelectorAll('.tarj').forEach((t) => marcarTarjeta(t as HTMLElement, false));
    const nivelFiltro = yaActiva ? null : tarj.dataset.nivel || null;
    if (nivelFiltro) marcarTarjeta(tarj, true);
    document.querySelectorAll('section[data-nivel]').forEach((el) => {
      const sec = el as HTMLElement;
      sec.hidden = !!nivelFiltro && sec.dataset.nivel !== nivelFiltro;
    });
  }

  // --- Cabecera de sección: plegar / desplegar ------------------------------
  function pulsarCabeceraSeccion(cab: HTMLElement) {
    const expandido = cab.getAttribute('aria-expanded') === 'true';
    cab.setAttribute('aria-expanded', expandido ? 'false' : 'true');
    const cuerpoId = cab.getAttribute('aria-controls');
    const cuerpo = cuerpoId ? document.getElementById(cuerpoId) : null;
    if (cuerpo) cuerpo.hidden = expandido;
    const chevronSvg = cab.querySelector('.chevron svg');
    if (chevronSvg) chevronSvg.classList.toggle('rotate-180', expandido);
  }

  // --- Selección y acciones en bloque ----------------------------------------
  // "No se ven hasta que hay selección" (corrección tras la revisión visual):
  // se revela quitando `hidden`, nunca reconstruyendo el botón.
  function actualizarAccionesBloque(sec: HTMLElement) {
    const haySeleccion = !!sec.querySelector('.chk-fila:checked');
    const btnOcultar = sec.querySelector('.ocultar-seleccionados') as HTMLElement | null;
    const btnAccion = sec.querySelector('.accion-seleccionados') as HTMLElement | null;
    if (btnOcultar) btnOcultar.hidden = !haySeleccion;
    if (btnAccion) btnAccion.hidden = !haySeleccion;
  }

  function seleccionarTodos(sec: HTMLElement) {
    filasDe(sec).forEach((fila) => {
      if (filaOculta(fila)) return; // "sobre las visibles" (encargo, punto 4)
      const chk = fila.querySelector('.chk-fila') as HTMLInputElement | null;
      if (chk) chk.checked = true;
    });
    actualizarAccionesBloque(sec);
  }

  function verAvisosOcultos(sec: HTMLElement) {
    filasDe(sec).forEach((fila) => { if (filaOculta(fila)) mostrarFila(fila); });
    recalcularTodo();
  }

  function ocultarSeleccionados(sec: HTMLElement) {
    filasDe(sec).forEach((fila) => {
      const chk = fila.querySelector('.chk-fila') as HTMLInputElement | null;
      if (chk && chk.checked) ocultarFila(fila);
    });
    recalcularTodo();
  }

  // --- Recalcular desde cero ---------------------------------------------------
  // Regla del spec ("Después de cada acción: recalcular desde cero"): nunca
  // parchear un contador con +1/-1. La cifra de cada tarjeta es un Set de IDs
  // VISIBLES reconstruido entero en cada pasada — así, ocultar un cartel que
  // está en dos secciones de un mismo nivel (p.ej. un PNG de más de 2MB, en
  // "Archivo PNG" y en "Por encima de 2 MB") solo baja la cifra cuando
  // desaparece de LA ÚLTIMA sección donde seguía visible, nunca dos veces.
  function recalcularTodo() {
    document.querySelectorAll('section[data-clave]').forEach((el) => {
      const sec = el as HTMLElement;
      const filas = filasDe(sec);
      const ocultas = filas.filter(filaOculta);
      const visibles = filas.length - ocultas.length;

      const nn = sec.querySelector('.nn');
      if (nn) nn.textContent = `[${visibles}]`;

      sec.classList.toggle('opacity-40', visibles === 0); // atenuar sección vacía

      const btnVerOcultos = sec.querySelector('.ver-ocultos') as HTMLElement | null;
      if (btnVerOcultos) btnVerOcultos.hidden = ocultas.length === 0;

      actualizarAccionesBloque(sec); // ocultar una fila puede llevarse la única marca
    });

    // El desglose de cada tarjeta mantiene el orden de trabajo que ya trae el
    // servidor (gravedad, tarea 4): la línea N-ésima de `.lins` corresponde
    // SIEMPRE a la sección N-ésima de ese nivel en el DOM — mismo criterio con
    // el que `resumenNivel()` (frontmatter de esta página) construyó `lineas`
    // a partir de `gruposNivel.slice(0,3)`. Solo se reescribe el NÚMERO de
    // cada línea; nunca qué sección ocupa cada una (no se reordena por
    // cantidad).
    NIVELES.forEach((nivel) => {
      const secciones = Array.from(document.querySelectorAll(`section[data-nivel="${nivel}"]`)) as HTMLElement[];
      const idsUnicos = new Set<string>();
      const cuentaPorSeccion = secciones.map((sec) => {
        const visibles = filasDe(sec).filter((f) => !filaOculta(f));
        visibles.forEach((f) => { if (f.dataset.id) idsUnicos.add(f.dataset.id); });
        return visibles.length;
      });

      const tarj = document.querySelector(`.tarj[data-nivel="${nivel}"]`);
      if (!tarj) return;

      const cifraEl = tarj.querySelector('.cifra');
      if (cifraEl) cifraEl.textContent = String(idsUnicos.size);

      const lineas = Array.from(tarj.querySelectorAll('.lins > span'));
      const numLineas = Math.min(3, cuentaPorSeccion.length);
      lineas.forEach((linea, i) => {
        const valor = linea.lastElementChild;
        if (!valor) return;
        if (i < numLineas) {
          valor.textContent = String(cuentaPorSeccion[i]);
        } else {
          // La única línea posible más allá de las tres primeras es la de
          // desbordamiento ("Otras incidencias +N"): suma de las secciones 4ª
          // en adelante de este nivel.
          const resto = cuentaPorSeccion.slice(3).reduce((a, b) => a + b, 0);
          valor.textContent = `+${resto}`;
        }
      });
    });
  }

  // --- Delegación de eventos ---------------------------------------------------
  // Un solo oyente de click y uno de change para todo el panel, en vez de uno
  // por fila/botón (84 filas × varios controles): más simple, y no hay que
  // reenganchar nada al revelar u ocultar elementos.
  function alPulsar(e: MouseEvent) {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const tarj = target.closest('.tarj') as HTMLElement | null;
    if (tarj) { pulsarTarjeta(tarj); return; }

    const cab = target.closest('.sec-cab') as HTMLElement | null;
    if (cab) { pulsarCabeceraSeccion(cab); return; }

    // El botón "Releer el archivo" no lleva clase ni id propios; es el único
    // <button> de la cabecera (las pestañas Control/Preparación son <span>,
    // inertes: Preparación no existe todavía — fuera de alcance, ver spec).
    if (target.closest('header button')) { window.location.reload(); return; }

    const btnTodos = target.closest('.seleccionar-todos') as HTMLElement | null;
    if (btnTodos) {
      const sec = btnTodos.closest('section[data-clave]') as HTMLElement | null;
      if (sec) seleccionarTodos(sec);
      return;
    }

    const btnVerOcultos = target.closest('.ver-ocultos') as HTMLElement | null;
    if (btnVerOcultos) {
      const sec = btnVerOcultos.closest('section[data-clave]') as HTMLElement | null;
      if (sec) verAvisosOcultos(sec);
      return;
    }

    const btnOcultarSel = target.closest('.ocultar-seleccionados') as HTMLElement | null;
    if (btnOcultarSel) {
      const sec = btnOcultarSel.closest('section[data-clave]') as HTMLElement | null;
      if (sec) ocultarSeleccionados(sec);
      return;
    }

    const btnOcultarAviso = target.closest('.ocultar-aviso') as HTMLElement | null;
    if (btnOcultarAviso) {
      const fila = btnOcultarAviso.closest('.fila[data-id]') as HTMLElement | null;
      if (fila) ocultarFila(fila);
      recalcularTodo();
      return;
    }
  }

  function alCambiar(e: Event) {
    const target = e.target as HTMLElement | null;
    if (!target || !target.classList.contains('chk-fila')) return;
    const sec = target.closest('section[data-clave]') as HTMLElement | null;
    if (sec) actualizarAccionesBloque(sec);
  }

  // --- Arranque ------------------------------------------------------------
  function initPanel() {
    // Si no hay tarjetas, este page-load es de otra página: una vez
    // registrado, el oyente de astro:page-load se dispara en TODAS las
    // navegaciones, no solo en las que vuelven a /panel.
    if (!document.querySelector('.tarj')) return;

    // `.ocultar-aviso` y "Releer el archivo" nacen `disabled` en el SSR de la
    // tarea 5 (sin JS no había nada honesto que hacer al pulsarlos). Se
    // habilitan aquí; no se reconstruyen.
    document.querySelectorAll('.ocultar-aviso').forEach((btn) => { (btn as HTMLButtonElement).disabled = false; });
    const btnReleer = document.querySelector('header button') as HTMLButtonElement | null;
    if (btnReleer) btnReleer.disabled = false;

    // Cancela los oyentes de una inicialización anterior (vuelta a /panel con
    // el ClientRouter) antes de poner los nuevos: si no, se acumula un
    // delegado más por cada visita y una sola acción dispara tantas veces
    // como visitas se hayan hecho (mismo mecanismo que TimeSlider.astro).
    if ((window as any)._melPanelAbortCtrl) (window as any)._melPanelAbortCtrl.abort();
    const abortCtrl = new AbortController();
    (window as any)._melPanelAbortCtrl = abortCtrl;
    const sig = abortCtrl.signal;

    document.addEventListener('click', alPulsar, { signal: sig });
    document.addEventListener('change', alCambiar, { signal: sig });
  }

  // Registro del oyente de astro:page-load, IDEMPOTENTE (regla 1 de
  // AGENTS.md). Sin esta guarda: cada vuelta a /panel con el ClientRouter
  // reevalúa este script (medido en index.astro — 2 copias tras 2 idas y
  // vueltas, 3 tras 3) y registraría OTRO oyente de astro:page-load, así que
  // un solo evento llamaría a `initPanel()` N veces. El AbortController de
  // arriba ya evita que eso duplique los oyentes delegados (cada llamada
  // cancela los de la anterior), pero esta guarda ataja el trabajo de sobra
  // en el origen, igual que `window._melHomeInitBound` en index.astro.
  if (!(window as any)._melPanelInitBound) {
    (window as any)._melPanelInitBound = true;
    document.addEventListener('astro:page-load', initPanel);
  }
</script>
