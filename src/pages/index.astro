  // Matches the long-format Google Maps share link, e.g.
  // https://www.google.com/maps/place/Av.+Lancia,+9,+24004+León/@42.59,-5.57,460m/data=...!3d42.5937072!4d-5.573658!...
  // — the preferred way to fill in an event's address going forward (see
  // parseCoords below): paste the "share" link from Maps and it carries
  // both a human-readable address AND precise coordinates, no separate
  // geocoding step or hand-maintained coordinate dictionary needed. Only
  // the long format is supported (not the maps.app.goo.gl short one) since
  // that one embeds everything directly in the URL text — resolving a
  // short link's redirect would mean a network call on every page render
  // now that this site is server-rendered per visit.
  const GOOGLE_MAPS_URL_RE = /google\.[a-z.]+\/maps|maps\.app\.goo\.gl|goo\.gl\/maps/i;

  // Pulls the readable address out of a Maps share link's /maps/place/NAME/
  // segment for display (e.g. in the map side panel). Falls back to the
  // raw string unchanged for anything that isn't a Maps link (DMS text,
  // a plain address someone typed by hand, etc.).
  function extractAddressLabel(coordStr) {
    if (!coordStr || !GOOGLE_MAPS_URL_RE.test(coordStr)) return coordStr;
    const placeMatch = coordStr.match(/\/maps\/place\/([^/]+)/);
    if (placeMatch) {
      try {
        return decodeURIComponent(placeMatch[1].replace(/\+/g, ' '));
      } catch (e) {
        return placeMatch[1].replace(/\+/g, ' ');
      }
    }
    return coordStr;
  }

  // Coordinates parser for map markers
  function parseCoords(coordStr, locality) {
    if (!coordStr && !locality) return null;
    const cleanCoord = coordStr ? coordStr.trim().toLowerCase() : '';

    // Google Maps share link: prefer the precise pinned point (!3d..!4d..)
    // over the @lat,lng that follows the place name, which is just the
    // map viewport's center at share time and can be noticeably off from
    // the actual pin for a zoomed-out share.
    if (coordStr && GOOGLE_MAPS_URL_RE.test(coordStr)) {
      const preciseMatch = coordStr.match(/!3d(-?\d+\.?\d*)!4d(-?\d+\.?\d*)/);
      if (preciseMatch) return [parseFloat(preciseMatch[1]), parseFloat(preciseMatch[2])];
      const viewportMatch = coordStr.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
      if (viewportMatch) return [parseFloat(viewportMatch[1]), parseFloat(viewportMatch[2])];
    }
    const cleanLoc = locality ? locality.trim().toLowerCase() : '';
    
    // Verified against the actual street address by geocoding it (OpenStreetMap
    // Nominatim), not hand-guessed — the previous values here were off by
    // 100-700m from the real address on almost every entry, and three venues
    // (Dickens Tavern, Sala Place, Tirol Rock Bar) had no entry at all for
    // their real address text, so they never got plotted on the map.
    const dict = {
      // Generic locality fallbacks, used only when a row has no address text
      'león': [42.5987, -5.5671],
      'leon': [42.5987, -5.5671],
      'san andrés del rabanedo': [42.6105, -5.6147],
      'santa olaja de porma': [42.6322, -5.4055],

      // Real street addresses from the "Dirección / Coordenadas" column
      'plaza caño de sta. ana, 1': [42.5954405, -5.5665437], // Caño Santana
      'c. arco de ánimas, 2': [42.5971331, -5.5712475], // Confussion
      'c. de pablo flórez, 2': [42.6000294, -5.5674657], // Dickens Tavern
      'calle cervantes, 9': [42.5990618, -5.5692838], // El Gran Café
      'c. de juan de arfe, 15': [42.5961847, -5.5676066], // Graffiti Pub
      'av. la estación, 23': [42.7886268, -5.5060121], // La Xana del Torío
      'calle villa benavente, 3': [42.5963345, -5.5723652], // LeClub
      'calle las varillas, 2': [42.5982118, -5.5679074], // MOMA
      'av. lancia, 9': [42.5935856, -5.5735919], // Moravia
      'calle sta. ana, 15': [42.5945004, -5.5658876], // Plástico
      'pl. don gutierre': [42.5961017, -5.5684446], // Sala Place
      'calle villa benavente, 9': [42.5954228, -5.5730187], // Sala Retrovisor
      'calle caño badillo, 19': [42.5976998, -5.5656898], // Tempo Club
      'calle conde guillén, 9': [42.5946594, -5.5745765], // Tirol Rock Bar
    };
    
    if (cleanCoord && dict[cleanCoord]) return dict[cleanCoord];
    
    if (coordStr) {
      const dmsRegex = /(\d+)°\s*(\d+)'\s*([\d.]+)"\s*([NS])\s*(\d+)°\s*(\d+)'\s*([\d.]+)"\s*([EW])/i;
      const match = coordStr.match(dmsRegex);
      if (match) {
        let lat = parseInt(match[1]) + parseInt(match[2]) / 60 + parseFloat(match[3]) / 3600;
        if (match[4].toUpperCase() === 'S') lat = -lat;
        let lng = parseInt(match[5]) + parseInt(match[6]) / 60 + parseFloat(match[7]) / 3600;
        if (match[8].toUpperCase() === 'W') lng = -lng;
        return [lat, lng];
      }
      const decRegex = /(-?\d+\.\d+)\s*,\s*(-?\d+\.\d+)/;
      const decMatch = coordStr.match(decRegex);
      if (decMatch) return [parseFloat(decMatch[1]), parseFloat(decMatch[2])];
    }
    
    // Only fall back to locality if coordStr is empty
    if (!cleanCoord && cleanLoc && dict[cleanLoc]) return dict[cleanLoc];
    
    return null;
  }

  // Renders a cluster bubble. Defined once at module scope (not nested
  // inside initGoogleMap) since it only touches markerLib/googleMap, which
  // are already shared top-level state — that lets createGoogleMapInstance()
  // reuse it too when the map gets recreated for a color scheme change.
  const clusterRenderer = {
    render: ({ count, position }) => {
      const clusterContent = document.createElement('div');
      clusterContent.className = 'mel-marker-wrapper';
      clusterContent.innerHTML = `
        <div class="mel-marker-body">
          <span class="mel-marker-label">${count}</span>
        </div>
        <div class="mel-marker-pointer"></div>
      `;

      const clusterMarker = new markerLib.AdvancedMarkerElement({
        position,
        content: clusterContent,
        zIndex: Number(google.maps.Marker.MAX_ZINDEX) + count,
      });

      clusterMarker.addListener('click', () => {
        // A cluster can hold many members packed into a small area —
        // forcing them ALL to separate with margin in one step demands
        // a zoom deep enough that, in this map's fairly short viewport,
        // often isn't achievable at all (see fitBounds()'s padding vs.
        // container-height math we hit trying that). Instead, zoom in
        // a fixed, moderate amount and let the clusterer re-group
        // whatever's still packed together into smaller pieces — click
        // again to keep drilling down until it's just individual pins.
        googleMap.panTo(position);
        smoothZoomTo(Math.min(Math.round(googleMap.getZoom()) + 3, 20));
      });

      return clusterMarker;
    }
  };

  // Creates (or re-creates) the Map + its MarkerClusterer in #map-container.
  // Split out of initGoogleMap() so the color-scheme-change handler below
  // can call it again — colorScheme can't be swapped live via setOptions()
  // on an existing Map instance, Google keeps rendering tiles from whichever
  // scheme it was created with, so switching it means building a new one.
  function createGoogleMapInstance(colorScheme, center, zoom) {
    googleMap = new google.maps.Map(document.getElementById("map-container"), {
      center,
      zoom,
      mapId: "972db64e35393894d465ef68", // Custom Maps style ID matching Figma
      colorScheme,
      disableDefaultUI: true, // Disables Satellite view, Street View (saves cost and keeps layout clean)
      zoomControl: true,
    });
    _s.googleMap = googleMap;

    if (typeof markerClusterer !== 'undefined') {
      googleMapClusterer = new markerClusterer.MarkerClusterer({
        map: googleMap,
        markers: [],
        renderer: clusterRenderer,
        // Default clustering radius (60px) is tuned for small dot markers —
        // ours are wide text-label bubbles (~150-250px), so the library was
        // "declustering" them into individual pins well before they were
        // actually far enough apart on screen not to overlap. A wider
        // radius keeps them bundled as one cluster bubble until they've
        // spread out enough to stand on their own without piling up.
        algorithm: new markerClusterer.SuperClusterAlgorithm({ radius: 110 }),
      });
    }
    _s.googleMapClusterer = googleMapClusterer;
  }

  async function initGoogleMap() {
    try {
      await google.maps.importLibrary("maps");
      markerLib = await google.maps.importLibrary("marker");
      mapCore = await google.maps.importLibrary("core");

      // The Map ID has both a light and a dark style variant configured in
      // Google Cloud Console — colorScheme picks between them; it's kept in
      // sync with the site's own toggle below.
      const isDarkNow = document.documentElement.classList.contains('dark');
      createGoogleMapInstance(
        isDarkNow ? google.maps.ColorScheme.DARK : google.maps.ColorScheme.LIGHT,
        { lat: 42.5987, lng: -5.5671 },
        14
      );

      infoWindow = new google.maps.InfoWindow({
        minWidth: 280
      });

      // Persist to global state
      _s.markerLib = markerLib;
      _s.mapCore = mapCore;
      _s.infoWindow = infoWindow;
      _s.mapInitialized = true;
      mapInitialized = true;

      // Bind close button event for map side panel
      const closePanelBtn = document.getElementById('close-map-side-panel');
      const sidePanel = document.getElementById('map-side-panel');
      if (closePanelBtn && sidePanel) {
        closePanelBtn.addEventListener('click', () => {
          const closedCoords = activeSidePanelCoords;
          activeSidePanelKey = null;
          _s.activeSidePanelKey = null;
          activeSidePanelCoords = null;
          // Drop ?location= so the auto-open check inside updateMapMarkers()
          // doesn't immediately re-match this same place and pop the panel
          // back open next time it runs.
          try {
            const url = new URL(window.location.href);
            url.searchParams.delete('location');
            window.history.replaceState({}, '', url.toString());
          } catch (e) {}
          sidePanel.classList.remove('w-[393px]', 'border-l');
          sidePanel.classList.add('w-0', 'border-l-0');
          if (googleMap) {
            setTimeout(() => {
              google.maps.event.trigger(googleMap, "resize");
            }, 310);
          }
          // Return the closed marker to its resting look via the same CSS
          // transition already used for hover — no pan/zoom at all, since
          // the user may well have moved around the map independently of
          // this marker. Toggling the class on the existing marker element
          // (instead of a full updateMapMarkers() rebuild, which destroys
          // and recreates every marker) is what lets it actually animate
          // instead of snapping.
          if (closedCoords) {
            const closedMarker = mapMarkers.find(m =>
              m.position && m.position.lat === closedCoords.lat && m.position.lng === closedCoords.lng
            );
            if (closedMarker && closedMarker.content) {
              closedMarker.content.classList.remove('active');
            }
          }
        });
      }

      updateMapMarkers(true);

      // The map container may not have its final layout size yet at this
      // exact moment (it just became visible as part of the same view
      // switch), which can make this first fitBounds() compute a bogus,
      // too-far-out zoom. Re-trigger resize + re-fit shortly after, same
      // fix already relied on when switching back to an initialized map.
      setTimeout(() => {
        google.maps.event.trigger(googleMap, 'resize');
        fitMapToMarkers();
      }, 150);
    } catch (e) {
      console.error("Error loading Google Maps API", e);
    }
  }

  // Populate side panel details dynamically
  function populateSidePanel(group) {
    const sidePanel = document.getElementById('map-side-panel');
    if (!sidePanel) return;

    const isAlreadyOpen = sidePanel.classList.contains('w-[393px]');

    const updateSidePanelDOM = () => {
