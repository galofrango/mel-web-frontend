  function switchView(viewName) {
    // Dynamically synchronize the view query parameter in the browser URL
    try {
      const url = new URL(window.location.href);
      url.searchParams.set('view', viewName);
      window.history.replaceState({}, '', url.toString());
    } catch (e) {
      console.warn("Unable to update URL query params", e);
    }

    // Update sliding indicator position
    if (activeIndicator) {
      if (viewName === 'galería') {
        activeIndicator.style.transform = 'translate3d(0, 0, 0)';
      } else if (viewName === 'mapa') {
        activeIndicator.style.transform = 'translate3d(100%, 0, 0)';
      } else if (viewName === 'lista') {
        activeIndicator.style.transform = 'translate3d(200%, 0, 0)';
      }
    }

    viewBtns.forEach(btn => {
      const isActive = btn.dataset.view === viewName;
      btn.setAttribute('data-active', isActive ? 'true' : 'false');
      
      if (isActive) {
        btn.classList.add('toggle-btn-active');
        btn.classList.remove('toggle-btn-inactive');
      } else {
        btn.classList.remove('toggle-btn-active');
        btn.classList.add('toggle-btn-inactive');
      }

      const span = btn.querySelector('span');
      if (span) {
        if (isActive) {
          span.classList.add('font-bold', 'text-mel-text-on-action');
          span.classList.remove('font-medium', 'text-mel-text-secondary');
        } else {
          span.classList.remove('font-bold', 'text-mel-text-on-action');
          span.classList.add('font-medium', 'text-mel-text-secondary');
        }
      }
    });

    viewPanels.forEach(panel => {
      if (panel.id === `view-${viewName}`) {
        panel.classList.remove('hidden');
        panel.classList.add('active');
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('active');
      }
    });

    // Tarjetas reconstruidas (búsqueda/filtro/orden) mientras la galería
    // estaba oculta tras otra pestaña miden clientWidth=0 en ese momento:
    // sizeGalleryCard() no puede calcular su row-span y se quedan
    // "unsized" (placeholder de ~300px). Como el grid no recorta la caja a
    // su área reservada (align-self:start), una imagen real más alta que
    // ese placeholder se solapa con la fila siguiente. Al volver a mostrar
    // la galería, remide solo las que se quedaron a medias.
    if (viewName === 'galería') {
      const unsizedCards = document.querySelectorAll('#gallery-grid .gallery-item.unsized');
      if (unsizedCards.length > 0) {
        const anyCard = document.querySelector('#gallery-grid .gallery-item');
        const colWidth = anyCard ? anyCard.clientWidth : 0;
        unsizedCards.forEach(card => sizeGalleryCard(card, colWidth));
      }
    }

    // Solo la lista pagina (la galería usa scroll infinito desde D-015).
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;
    document.querySelectorAll('.pagination-controls-container').forEach(pagControls => {
      if (viewName === 'lista' && filtered.length > 0 && totalPages > 1) {
        pagControls.classList.remove('hidden');
        pagControls.classList.add('flex');
      } else {
        pagControls.classList.add('hidden');
        pagControls.classList.remove('flex');
      }
    });

    // Initialize or refresh Google map on switch to 'mapa'. On a soft (Astro
    // SPA) navigation away from and back to this page, mapInitialized/googleMap
    // persist on window._melState (they're just JS objects), but the actual
    // #map-container DOM node they were built into gets swapped out for a
    // fresh one — Google Maps never re-parents into the new node, so the map
    // silently renders into a detached element. Detect that by comparing the
    // container we last built into against the one currently in the DOM, and
    // force a full re-init when they differ (or the old one got disconnected).
    if (viewName === 'mapa') {
      const currentMapContainer = document.getElementById('map-container');
      const isStale = !mapInitialized || !googleMap || !currentMapContainer ||
        currentMapContainer !== mapContainerEl || !mapContainerEl.isConnected;
      if (isStale) {
        initGoogleMap();
        mapInitialized = true;
      } else if (googleMap) {
        // Trigger resize and re-fit bounds now that container has dimensions
        google.maps.event.trigger(googleMap, 'resize');
        fitMapToMarkers();
      }
    }
  }

  // Matches the long-format Google Maps share link, e.g.
  // https://www.google.com/maps/place/Av.+Lancia,+9,+24004+León/@42.59,-5.57,460m/data=...!3d42.5937072!4d-5.573658!...
  // — the preferred way to fill in an event's address going forward (see
  // parseCoords below): paste the "share" link from Maps and it carries
  // both a human-readable address AND precise coordinates, no separate
  // geocoding step or hand-maintained coordinate dictionary needed. Only
  // the long format is supported (not the maps.app.goo.gl short one) since
  // that one embeds everything directly in the URL text — resolving a
  // short link's redirect would mean a network call on every page render
  // now that this site is server-rendered per visit.
  const GOOGLE_MAPS_URL_RE = /google\.[a-z.]+\/maps|maps\.app\.goo\.gl|goo\.gl\/maps/i;

  // Pulls the readable address out of a Maps share link's /maps/place/NAME/
  // segment for display (e.g. in the map side panel). Falls back to the
  // raw string unchanged for anything that isn't a Maps link (DMS text,
  // a plain address someone typed by hand, etc.).
  function extractAddressLabel(coordStr) {
    if (!coordStr || !GOOGLE_MAPS_URL_RE.test(coordStr)) return coordStr;
    const placeMatch = coordStr.match(/\/maps\/place\/([^/]+)/);
    if (placeMatch) {
      try {
        return decodeURIComponent(placeMatch[1].replace(/\+/g, ' '));
      } catch (e) {
        return placeMatch[1].replace(/\+/g, ' ');
      }
    }
    return coordStr;
  }

  // Coordinates parser for map markers
  function parseCoords(coordStr, locality) {
    if (!coordStr && !locality) return null;
    const cleanCoord = coordStr ? coordStr.trim().toLowerCase() : '';

    // Google Maps share link: prefer the precise pinned point (!3d..!4d..)
    // over the @lat,lng that follows the place name, which is just the
    // map viewport's center at share time and can be noticeably off from
    // the actual pin for a zoomed-out share.
    if (coordStr && GOOGLE_MAPS_URL_RE.test(coordStr)) {
      const preciseMatch = coordStr.match(/!3d(-?\d+\.?\d*)!4d(-?\d+\.?\d*)/);
      if (preciseMatch) return [parseFloat(preciseMatch[1]), parseFloat(preciseMatch[2])];
      const viewportMatch = coordStr.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
      if (viewportMatch) return [parseFloat(viewportMatch[1]), parseFloat(viewportMatch[2])];
    }
    const cleanLoc = locality ? locality.trim().toLowerCase() : '';
    
    // Verified against the actual street address by geocoding it (OpenStreetMap
    // Nominatim), not hand-guessed — the previous values here were off by
    // 100-700m from the real address on almost every entry, and three venues
    // (Dickens Tavern, Sala Place, Tirol Rock Bar) had no entry at all for
    // their real address text, so they never got plotted on the map.
    const dict = {
      // Generic locality fallbacks, used only when a row has no address text
      'león': [42.5987, -5.5671],
      'leon': [42.5987, -5.5671],
      'san andrés del rabanedo': [42.6105, -5.6147],
      'santa olaja de porma': [42.6322, -5.4055],

      // Real street addresses from the "Dirección / Coordenadas" column
      'plaza caño de sta. ana, 1': [42.5954405, -5.5665437], // Caño Santana
      'c. arco de ánimas, 2': [42.5971331, -5.5712475], // Confussion
      'c. de pablo flórez, 2': [42.6000294, -5.5674657], // Dickens Tavern
      'calle cervantes, 9': [42.5990618, -5.5692838], // El Gran Café
      'c. de juan de arfe, 15': [42.5961847, -5.5676066], // Graffiti Pub
      'av. la estación, 23': [42.7886268, -5.5060121], // La Xana del Torío
      'calle villa benavente, 3': [42.5963345, -5.5723652], // LeClub
      'calle las varillas, 2': [42.5982118, -5.5679074], // MOMA
      'av. lancia, 9': [42.5935856, -5.5735919], // Moravia
      'calle sta. ana, 15': [42.5945004, -5.5658876], // Plástico
      'pl. don gutierre': [42.5961017, -5.5684446], // Sala Place
      'calle villa benavente, 9': [42.5954228, -5.5730187], // Sala Retrovisor
      'calle caño badillo, 19': [42.5976998, -5.5656898], // Tempo Club
      'calle conde guillén, 9': [42.5946594, -5.5745765], // Tirol Rock Bar
    };
    
    if (cleanCoord && dict[cleanCoord]) return dict[cleanCoord];
    
    if (coordStr) {
      const dmsRegex = /(\d+)°\s*(\d+)'\s*([\d.]+)"\s*([NS])\s*(\d+)°\s*(\d+)'\s*([\d.]+)"\s*([EW])/i;
      const match = coordStr.match(dmsRegex);
      if (match) {
        let lat = parseInt(match[1]) + parseInt(match[2]) / 60 + parseFloat(match[3]) / 3600;
        if (match[4].toUpperCase() === 'S') lat = -lat;
        let lng = parseInt(match[5]) + parseInt(match[6]) / 60 + parseFloat(match[7]) / 3600;
        if (match[8].toUpperCase() === 'W') lng = -lng;
        return [lat, lng];
      }
      const decRegex = /(-?\d+\.\d+)\s*,\s*(-?\d+\.\d+)/;
      const decMatch = coordStr.match(decRegex);
      if (decMatch) return [parseFloat(decMatch[1]), parseFloat(decMatch[2])];
