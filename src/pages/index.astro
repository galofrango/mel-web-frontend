        <h2 id="overlay-event-title-mobile" class="lg:hidden font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary mb-8"></h2>

        <!-- Three-column content grid (Figma widths: 184px, 496px, 496px). lg:h-[400px] pins the
