          <div class="event-tags-row order-2 lg:order-none flex flex-row lg:flex-col justify-start lg:justify-between gap-6 lg:gap-2 h-auto lg:h-[400px] w-full min-w-0 overflow-x-auto lg:overflow-visible no-scrollbar border-b border-mel-border pb-6 lg:border-b-0 lg:pb-0" id="overlay-tags-sidebar">
            <!-- Populated dynamically via JS -->
          </div>

          <!-- Column 2: Image Box. On mobile it comes first and runs full-bleed,
               with the dots in normal flow below the image (h-auto) instead of
               absolutely hanging over the tags row. -->
          <div class="order-1 lg:order-none flex flex-col items-center relative h-auto lg:h-[400px] -mx-6 w-[calc(100%+48px)] sm:-mx-12 sm:w-[calc(100%+96px)] lg:mx-0 lg:w-full">
            <button 
              id="overlay-carousel-main"
              class="relative w-full h-[400px] overflow-hidden flex items-center justify-center cursor-zoom-in outline-none group bg-transparent"
              aria-label="Ver imagen ampliada"
            >
              <!-- Striped background -->
              <div class="absolute inset-0 striped-bg z-0 pointer-events-none"></div>
              
              <!-- Track container -->
              <div 
                id="overlay-carousel-track" 
                class="flex w-full h-full transition-transform duration-500 ease-out z-10 pointer-events-none"
                style="transform: translate3d(0, 0, 0);"
              >
                <!-- Populated dynamically -->
              </div>
            </button>

            <!-- Dots: in flow on mobile (below the image), floating absolute on
                 desktop so they never shift the columns' fixed 400px height -->
            <div class="static lg:absolute lg:top-[400px] lg:left-0 lg:right-0 flex gap-4 items-center justify-center py-6 w-full" id="overlay-carousel-dots">
              <!-- Populated dynamically -->
            </div>
          </div>

          <!-- Column 3: Event Info -->
          <div class="order-3 lg:order-none flex flex-col gap-10 w-full pl-0 lg:pl-6">
            <h2 id="overlay-event-title" class="hidden lg:block font-sans font-bold text-[31px] leading-[32px] tracking-[-0.62px] text-mel-text-primary"></h2>

            <div class="flex flex-col gap-10">
              <div id="overlay-description-container" class="flex flex-col gap-6">
                <p id="overlay-event-description" class="font-sans font-normal text-[16px] leading-[24px] tracking-[-0.16px] text-mel-text-primary"></p>
                <div class="h-px w-full bg-mel-border"></div>
              </div>

              <div id="overlay-artists-container" class="flex flex-col gap-2">
                <span class="typo-tag-label font-sans font-bold text-[13px] leading-[16px] tracking-[1.56px] uppercase text-mel-text-primary">Artistas</span>
                <div id="overlay-artists-list" class="flex flex-wrap gap-y-1"></div>
              </div>
            </div>

            <!-- Like Button -->
            <div class="flex gap-6 items-start">
              <button
                id="overlay-btn-me-presta"
                class="content-stretch cursor-pointer flex items-center justify-center py-3 px-4 relative select-none outline-none group border font-sans font-medium text-[16px] leading-[20px] tracking-[0px] w-fit"
                data-active="false"
              >
                <!-- Centered Label -->
                <span class="text-mel-action-secondary group-hover:text-mel-action-primary group-data-[active=true]:text-mel-text-on-action transition-colors duration-300 select-none pointer-events-none">
                  Me presta
                </span>
                <!-- Checkmark -->
                <div class="icon-container flex items-center justify-center overflow-hidden shrink-0 w-0 opacity-0 mr-0 transition-all duration-300 ease-out group-data-[active=true]:w-5 group-data-[active=true]:opacity-100 group-data-[active=true]:ml-2">
                  <svg class="w-4 h-4 text-mel-text-on-action shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
              </button>
            </div>
          </div>

        </div>

        <!-- Navigation block. On mobile: 2-column row under a divider, with
             Anterior/Siguiente side by side (Figma 575:83196). -->
        <div class="grid grid-cols-2 lg:grid-cols-[184px_496px_496px] gap-8 lg:gap-6 w-full mt-12 lg:mt-[280px] pt-6 border-t border-mel-border lg:pt-0 lg:border-t-0 shrink-0 items-center">
          <div class="hidden lg:block"></div>

          <!-- Anterior -->
          <div class="flex justify-end text-right items-center" id="overlay-nav-prev-container"></div>

          <!-- Siguiente -->
          <div class="flex justify-start text-left pl-0 lg:pl-6 items-center" id="overlay-nav-next-container"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- Image Detail Lightbox for the Overlay (Figma 841:40903: fixed-size
       modal, photo object-contained inside, pagination dots below) -->
  <div
    id="overlay-image-lightbox"
    class="fixed inset-0 bg-[var(--mel-primitive-le-950)]/80 z-[250] opacity-0 pointer-events-none transition-opacity duration-300 hidden flex items-center justify-center"
  >
    <div
      id="overlay-lightbox-modal"
      class="relative bg-mel-bg-primary flex flex-col items-center transform scale-95 transition-transform duration-300 pt-8 px-8 pb-4 h-[76vh] max-w-[92vw] aspect-square"
    >
      <button
        id="overlay-lightbox-close"
        class="absolute -top-5 -right-5 w-10 h-10 bg-mel-action-secondary text-mel-text-on-action hover:bg-mel-action-primary flex items-center justify-center shadow-[0px_4px_8px_rgba(38,31,31,0.32)] border-none cursor-pointer z-50 transition-colors"
        aria-label="Cerrar vista grande"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="relative flex-1 min-h-0 w-full overflow-hidden flex items-center justify-center">
        <div class="absolute inset-0 striped-bg pointer-events-none"></div>
        <div
          id="overlay-lightbox-track"
          class="flex w-full h-full transition-transform duration-500 ease-out z-10"
          style="transform: translate3d(0, 0, 0);"
        ></div>
      </div>

      <!-- Pagination dots, populated per event by renderOverlayEvent(), which also toggles
           #overlay-lightbox-modal between pb-4/pb-8 depending on whether this row ends up with
           any dots in it — see the note on event/[id].astro's own (static) version of this. -->
      <div id="overlay-lightbox-dots" class="flex gap-4 items-center justify-center pt-4 pb-1 shrink-0"></div>
    </div>
  </div>

  <IntroAnimation />
  <SideMenu />
</Layout>



<style>
  ::view-transition-group(mel-header),
  ::view-transition-group(mel-toolbar),
  ::view-transition-group(mel-pagination) {
    z-index: 100;
  }

  /* Define typographic Lora variables at root for clean token mapping */
  :root {
    --Font-Size-Body-Roman: 16px;
    --Line-Height-Body-Roman: 24px;
    --Text-Secondary: var(--mel-text-secondary);
    --Action-Primary: var(--mel-action-primary);
  }

  /* Custom CSS for Range Slider */
  input[type="range"]::-webkit-slider-thumb {
    pointer-events: auto;
    width: 24px;
    height: 32px;
    opacity: 0; /* Hide default thumb, we use absolute divs matching sliders */
    cursor: pointer;
  }
  
  input[type="range"]::-moz-range-thumb {
    pointer-events: auto;
    width: 24px;
    height: 32px;
    opacity: 0;
    cursor: pointer;
  }

  /* Striped grid pattern replicating Figma design */
  .striped-bg {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 7px,
      var(--mel-border) 7px,
      var(--mel-border) 8px
    );
  }

  /* Dynamic panels transition */
  .view-panel {
    transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;
  }
  
  .view-panel.hidden {
    display: none !important;
    opacity: 0;
    pointer-events: none;
  }
  
  .view-panel.active {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  #view-lista.active {
    display: flex;
  }

  /* Overlay Me Presta Button Styles */
  #overlay-btn-me-presta {
    border-color: var(--mel-action-secondary);
    background-color: transparent;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  #overlay-btn-me-presta:hover {
    border-color: var(--mel-action-primary);
  }

  #overlay-btn-me-presta[data-active="true"] {
    border-color: var(--mel-action-secondary);
    background-color: var(--mel-action-secondary);
  }

  #overlay-btn-me-presta[data-active="true"]:hover {
    border-color: var(--mel-action-primary);
    background-color: var(--mel-action-primary);
  }
</style>

<style is:global>
  /* The shared .view-panel.active rule sets display:flex, which stretches the
     gallery grid to the scroll viewport height and makes its rows overflow —
     that buries the grid's bottom padding mid-content instead of below the last
     row. Force the gallery scroll container to flow as a block so the grid grows
     to its natural height and pb reserves real space at the end of the scroll.
     :not(.hidden) keeps the display:none !important hide behaviour intact. */
  #view-galería:not(.hidden) {
    display: block;
  }

  /* Masonry por CSS Grid + row-span (D-015): cada tarjeta reserva tantas
     filas de 4px (auto-rows del contenedor) como pide su imagen a ancho de
     columna más el hueco de 24px — lo calcula sizeGalleryCard() cuando la
     imagen publica su ratio (onload). align-self:start deja que la tarjeta
     mida exactamente lo que mide su imagen: el resto del área reservada es
     el hueco vertical. A diferencia del multicol, añadir tarjetas al final
     NO recoloca las existentes (requisito del scroll infinito). */
  .gallery-item {
    align-self: start;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  /* Placeholder mientras la imagen aún no ha declarado su ratio: bloque
     blanco de ~300px para que la rejilla no arranque colapsada. */
  .gallery-item.unsized {
    grid-row-end: span 75;
    min-height: 280px;
  }

  /* Revelado al hacer scroll (a nivel de tarjeta, independiente de cómo se
     alineen: sirve igual para cualquier layout futuro de la galería). Las
     tarjetas que nacen fuera del viewport esperan ocultas (.reveal-pending)
     y animan su entrada cuando el IntersectionObserver las ve llegar. */
  .gallery-item.reveal-pending {
    opacity: 0;
  }
  @keyframes gallery-reveal {
    from {
      opacity: 0;
      transform: translate3d(0, 32px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  .gallery-item.reveal-in {
    animation: gallery-reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .gallery-item:hover {
    transform: scale(1.025) !important;
    z-index: 30 !important;
    box-shadow: 0 239px 67px 0 rgba(38, 32, 32, 0.00), 
                0 153px 61px 0 rgba(38, 32, 32, 0.01), 
                0 86px 52px 0 rgba(38, 32, 32, 0.05), 
                0 38px 38px 0 rgba(38, 32, 32, 0.09), 
                0 10px 21px 0 rgba(38, 32, 32, 0.10) !important;
  }

  @keyframes marker-fade-in {
    0% {
      opacity: 0;
      transform: scale(0.6) translateY(10px);
    }
    60% {
      opacity: 1;
      transform: scale(1.08) translateY(-2px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Gallery entrance on first load: each card drifts in from the
     bottom-right, staggered so the sweep reads as starting from that
     corner (see the JS in bindInitialCardClicks()). */
  @keyframes gallery-item-intro {
    from {
      opacity: 0;
      transform: translate3d(36px, 36px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .gallery-item.intro-in {
    animation: gallery-item-intro 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* List view: rows genuinely new to the visible page (not just reordered)
     fade in — the FLIP reorder itself is driven inline via style.transform,
     see performDOMUpdates(). */
  @keyframes list-row-intro {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .list-row-intro {
    animation: list-row-intro 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Map side panel / overlay sidebar tags (makeTagHtml()): value never wraps
     to a second line or bleeds past the tag's box — always ellipsis. */
  .tag-value-link {
    min-width: 0;
    max-width: 100%;
  }
  .tag-value-text {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }

  /* Event details SPA overlay: settle-in/out reveal shared by all entry
     points (gallery card, list row, map panel), since they all open it
     through the same openDetailsOverlaySPA(). */
  #overlay-details-content {
    transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #overlay-details-content.overlay-content-enter {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
  }
  /* The overlay's own opaque background never faded on close — only the
     content inside it did — so once the content finished fading out there
     was a brief solid-color gap before the overlay actually hid and the
     gallery/list underneath reappeared. Fading the overlay itself too (in
     step with the content, same 0.5s the close timeout waits on) turns that
     gap into a proper dissolve onto whatever's underneath. */
  #event-details-overlay {
    transition: opacity 0.5s ease;
  }
  #event-details-overlay.overlay-fading {
    opacity: 0;
  }

  @keyframes marker-fade-out {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.6) translateY(10px);
    }
  }

  .mel-marker-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    filter: drop-shadow(0px 4px 8px rgba(38,31,31,0.32));
    cursor: pointer;
