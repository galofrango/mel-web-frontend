  <!-- Fullscreen SPA Event Details Overlay (used for Map and general SPA details flow) -->
  <div id="event-details-overlay" class="fixed inset-0 z-[200] bg-mel-bg-primary hidden flex-col items-center justify-start overflow-y-auto pt-[10vh] pb-[108px] px-6 sm:px-12 select-none">
    <div class="w-full max-w-[1224px] flex flex-col relative" id="overlay-content-wrapper">
      
      <!-- Close Button (X) at Top Left -->
