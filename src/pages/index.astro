---
import Layout from '../layouts/Layout.astro';
import HeaderTitle from '../components/HeaderTitle.astro';
import MenuItem from '../components/MenuItem.astro';
import SideMenu from '../components/SideMenu.astro';
import TimeSlider from '../components/TimeSlider.astro';
import TagWithLink from '../components/TagWithLink.astro';
import AdaptiveTagsRow from '../components/AdaptiveTagsRow.astro';
import ToggleSelector from '../components/ToggleSelector.astro';
import FlyerCard from '../components/FlyerCard.astro';
import IconButton from '../components/IconButton.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import BottomSheetHeader from '../components/BottomSheetHeader.astro';
import EmptyState from '../components/EmptyState.astro';

// Extract Year from Date String
function getYear(dateStr) {
  if (!dateStr || dateStr === 'SIN FECHA') return null;
  const slashBits = dateStr.split('/');
  if (slashBits.length === 3) {
    const yr = parseInt(slashBits[2], 10);
    if (!isNaN(yr)) return yr;
  }
  const dashBits = dateStr.split('-');
  if (dashBits.length === 3) {
    const yr = parseInt(dashBits[0], 10);
    if (!isNaN(yr)) return yr;
  }
  const match = dateStr.match(/\b(19\d\d|20\d\d)\b/);
  if (match) {
    return parseInt(match[1], 10);
  }
  return null;
}

// DD/MM/AAAA a partir del AAAA-MM-DD tal cual llega de la hoja (columna Fecha).
// Espejo server-side de la versión cliente (más abajo, en el <script>) — ver
// AGENTS.md regla 7: FlyerCard se renderiza en SSR y necesita su propia copia.
function formatFechaDMY(fecha) {
  let formatted = fecha || '';
  if (formatted && formatted.includes('-')) {
    const parts = formatted.split('-');
    if (parts.length === 3) formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
  }
  return formatted;
}

// Direct hotlink builder to bypass drive authentication/cors
// `ancho` = el ancho que Drive debe servir, en píxeles. Pedir siempre w1000
// costaba ~679 KB de media por flyer (el peor del archivo, 2 MB) para pintarlo
// en una tarjeta de 342px o, peor, en una miniatura de lista de 40px. Cada
// llamada pide ahora el tamaño que de verdad va a usar; 1000 sigue siendo el
// valor por defecto porque es el que necesitan la ficha y el lightbox.
// Anchos por contexto, medidos en navegador: la tarjeta de galería se pinta a
// 342px (684 con densidad 2) y la miniatura de la lista en una caja de 40px.
const ANCHO_TARJETA = 700;
const ANCHO_MINIATURA = 200;

function extractDriveImage(url, ancho = 1000) {
  if (!url) return '';
  let fileId = '';
  if (url.includes('id=')) {
    fileId = url.split('id=')[1].split('&')[0];
  } else if (url.includes('/d/')) {
    fileId = url.split('/d/')[1].split('/')[0];
  }
  return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w${ancho}` : '';
}

// Fetch and Group Sheets Google Viz JSON Database
const SHEET_ID = '1buzisIlDkCo2Rj5BYZh5-JKrAYSo3RSuBXYmJVGYT0E';
const CONFIG_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json`;

let initialArchives = [];
const initialArtists = new Set();
const initialDesigners = new Set();
const initialPromoters = new Set();

try {
  const response = await fetch(CONFIG_URL);
  const text = await response.text();
  const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*?)\);/);
  
  if (match && match[1]) {
    const cleanJson = JSON.parse(match[1]);
    const rows = cleanJson.table.rows;
    
    const rawItems = rows.map((row) => {
      const c = row.c;
      if (!c) return null;
      return {
        evento: c[0] ? c[0].v : 'Evento sin título',
        urlDrive: c[2] ? c[2].v : '',
        fecha: c[3] ? c[3].f || c[3].v : 'SIN FECHA',
        lugar: c[4] ? c[4].v : '',   // sin dato es sin dato: rellenarlo con 'León' inventaba un local
        localidad: c[5] ? c[5].v : '',
        coordenadas: c[6] ? c[6].v : '',
        artistas: c[7] ? c[7].v : '',
        organiza: c[8] ? c[8].v : '',
        descripcion: c[9] ? c[9].v : '',
        idMel: c[10] ? c[10].v : '',
        carruselOrder: c[11] ? c[11].v : '1',
        disenador: c[13] ? c[13].v : 'Desconocido',
        existeOriginal: c[16] ? c[16].v : '',
        formato: c[21] ? c[21].v : 'Flyer',
        notasArchivo: c[24] ? c[24].v : '',
        ocr: c[25] ? c[25].v : ''
      };
    }).filter(item => item && item.idMel && item.idMel.startsWith('MEL-'));
    
    // Group by Event Name + Date
    const groups = {};
    rawItems.forEach(item => {
      const key = `${item.evento.trim().toLowerCase()}_${item.fecha.trim().toLowerCase()}`;
      if (!groups[key]) {
        groups[key] = {
          evento: item.evento,
          fecha: item.fecha,
          carruselItems: [],
          lugar: item.lugar,
          localidad: item.localidad,
          coordenadas: item.coordenadas,
          artistas: item.artistas,
          organiza: item.organiza,
          descripcion: item.descripcion,
          disenador: item.disenador,
          existeOriginal: item.existeOriginal,
          formato: item.formato,
          notasArchivo: item.notasArchivo,
          ocr: item.ocr,
          idMel: item.idMel
        };
      }
      groups[key].carruselItems.push({
        urlDrive: item.urlDrive,
        carruselOrder: parseInt(item.carruselOrder, 10) || 1,
        idMel: item.idMel
      });
    });
    function parseDateToNumber(dateStr) {
      if (!dateStr || dateStr === 'SIN FECHA') return 0;
      const slashBits = dateStr.split('/');
      if (slashBits.length === 3) {
        const d = parseInt(slashBits[0], 10);
        const m = parseInt(slashBits[1], 10) - 1;
        const y = parseInt(slashBits[2], 10);
        return new Date(y, m, d).getTime();
      }
      const dashBits = dateStr.split('-');
      if (dashBits.length === 3) {
        const y = parseInt(dashBits[0], 10);
        const m = parseInt(dashBits[1], 10) - 1;
        const d = parseInt(dashBits[2], 10);
        return new Date(y, m, d).getTime();
      }
      return 0;
    }

    initialArchives = Object.values(groups).map((g: any) => {
      g.carruselItems.sort((a, b) => a.carruselOrder - b.carruselOrder);
      return g;
    });

    // Sort by date ascending
    initialArchives.sort((a, b) => {
      const timeA = parseDateToNumber(a.fecha);
      const timeB = parseDateToNumber(b.fecha);
      return timeA - timeB;
    });
    
    // Gather initial unique statistics
    initialArchives.forEach(item => {
      if (item.artistas) {
        item.artistas.split(/[,;\/]+/).forEach(a => {
          const cleanA = a.trim().toLowerCase();
          if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') initialArtists.add(cleanA);
        });
      }
      if (item.organiza) {
        const cleanP = item.organiza.trim().toLowerCase();
        if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') initialPromoters.add(cleanP);
      }
      if (item.disenador) {
        const cleanD = item.disenador.trim().toLowerCase();
        if (cleanD && cleanD !== 'desconocido') initialDesigners.add(cleanD);
      }
    });
  }
} catch (e) {
  console.error("Error fetching or parsing GSheets JSON database", e);
}

// Mapped stats matching Figma TagWithLink instances exactly
const tags = [
  { label: "Eventos", count: initialArchives.length },
  { label: "Artistas", count: initialArtists.size },
  { label: "Diseñadores", count: initialDesigners.size },
  { label: "Promotores", count: initialPromoters.size }
];

// Orden aleatorio de la galería (ver decisions.md D-015): cada visita baraja
// el archivo entero (Fisher-Yates) — la galería es deliberadamente "random",
// pensada para quien entra a mirar sin buscar nada concreto. El cliente
// siembra sus claves aleatorias con este mismo orden al arrancar.
const shuffledArchives = [...initialArchives];
for (let i = shuffledArchives.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledArchives[i], shuffledArchives[j]] = [shuffledArchives[j], shuffledArchives[i]];
}

---

<Layout title="Galería de Diseño">
  <!-- Top/bottom paddings are viewport-relative (tuned against the 4K reference:
       112px top / 32px bottom at ~1100px of viewport height ≈ 10vh / 3vh) so
       smaller screens don't waste fixed pixel gaps. -->
  <!-- h-dvh y NO h-screen (100vh): en Chrome/Safari móvil `vh` mide la pantalla
       ENTERA, incluida la franja que ocupan las barras del navegador, así que la
       página quedaba más alta que lo realmente visible y siempre sobraba un
       scroll vertical con el final tapado. `dvh` mide solo el área visible. -->
  <div class="w-full max-w-[1440px] h-dvh mx-auto bg-mel-bg-primary px-6 sm:px-12 lg:px-[108px] pt-[var(--mel-header-pt-mobile)] lg:pt-[var(--mel-header-pt-desktop)] pb-[3vh] flex flex-col gap-6 overflow-hidden" data-node-id="Screen / Desktop / Gallery">
    
    <!-- Page Header: Search (Typing Title prompt) and Menu. Single row on every
         breakpoint — on mobile the title collapses to "M.E.L." and the menu to
         its icon (see HeaderTitle/MenuItem), the gap to the menu button is 16px
         on mobile / 24px from lg up. Plain flex (title flex-1, menu shrink-0)
         at every width — NOT a 50/50 grid split — so the search box only ever
         shrinks (and truncates its placeholder) once it's genuinely out of
         room, i.e. down to that gap from the menu, instead of being capped at
         a fixed half of the row regardless of how little the menu needs. -->
    <div class="flex items-center gap-4 lg:gap-6 shrink-0" style="view-transition-name: mel-header;">
      <div class="flex-1 min-w-0 w-full">
        <HeaderTitle hideDivider={true} />
      </div>
      <div class="shrink-0 flex justify-end">
        <MenuItem id="menu-btn" />
      </div>
    </div>

    <!-- Toolbar: Slider & Controls. El hueco hasta la cabecera lo da el gap-6
         del contenedor padre (24px). En móvil (Figma 439:140952 / 315:17658 el
         toolbar arranca más pegado a la cabecera) lo recortamos a 16px con
         -mt-2, restaurando 24px en desktop (lg:mt-0). El pb-4 mantiene el hueco
         hacia el contenido de abajo. Tailwind: gap-6=24px, -mt-2=-8px. -->
    <div class="flex flex-col gap-6 pb-4 shrink-0 -mt-2 lg:mt-0" style="view-transition-name: mel-toolbar;">
      <!-- Year Slider Bar (Removed text header label as requested). On mobile the
           slider runs full-bleed to the screen edges (negative margins cancel the
           page's px-6), per the mobile toolbar design (Figma 315:17658). -->
      <div class="flex flex-col gap-2 -mx-6 sm:mx-0">
        <TimeSlider />
      </div>

      <!-- Filter Tags and View Switcher (Figma node 341:26425). True
           flex-wrap, not a `lg` breakpoint switch: the Toggle sits beside the
           tags row whenever both fit at their natural sizes, and drops to
           its own full-width line the moment they don't. gap-y-8 (32px,
           D-060): the propietario asked for at least 32px of vertical gap
           between the tags and a wrapped Toggle — mt-0 lg:mt-2 (unrelated:
           the slider→toolbar gap) stays as-is. -->
      <div id="home-highlights-toolbar" class="flex flex-wrap items-center gap-x-6 gap-y-8 mt-0 lg:mt-2">
        <!-- Event Stats Tags — AdaptiveTagsRow.astro (D-059/D-060), shared
             with the event detail's horizontal tags row and the map side
             panel. Layout mode (equal-width grid vs content-sized+scroll)
             is decided by updateAdaptiveTagsRow() in the script below, from
             real measurement rather than a fixed breakpoint. -->
        <AdaptiveTagsRow id="home-highlights-tags" tags={tags} class="pr-[32px]" />

        <!-- View Selector Toggle: grows to fill the rest of its line. Capped
             at 4 grid columns (matching the map side panel's own identical
             formula, D-026 — 4/12 columns with a 24px gap) ONLY while it's
             actually sharing that line with the tags row — toggled via
             .toggle-shares-line by updateHomeToolbarLayout() below, since a
             static max-width would otherwise also clamp it once it wraps
             onto its own line alone, where it should span the full width
             instead (the propietario caught this: "cuando pasa debajo de
             las tags, debe ocupar el ancho total de la pantalla"). Never
             narrower than 320px in either state. -->
        <div id="home-toggle-wrapper" class="grow min-w-[320px] toggle-shares-line">
          <ToggleSelector />
        </div>
      </div>

      <style>
        #home-toggle-wrapper.toggle-shares-line {
          max-width: calc((100% - 264px) / 3 + 72px);
        }
        @media (min-width: 1024px) {
          #home-highlights-toolbar .adaptive-tags-row.highlights-flex-content {
            width: auto;
            flex-shrink: 1;
          }
        }
      </style>
    </div>

    <!-- Main Visual Space: Galería / Mapa / Lista dynamic views -->
    <div id="content-views" class="relative flex-1 min-h-0 w-full overflow-visible flex flex-col justify-between transition-colors duration-300 -mt-[8px]">
      <!-- Single Sitewide Empty State Overlay anchored to content-views for Galería, Mapa, and Lista -->
      <!-- Cubre desde top-0, no desde top-[24px]: la vista Mapa arranca en 0 bajo
           lg, así que esos 24px dejaban asomar una banda de calles por encima
           del estado vacío. El contenido va algo más arriba de lo centrado
           (pb mayor que pt) ahora que el toggle desaparece en este estado y
           queda hueco de sobra por debajo. -->
      <!-- El estado vacío es el COMPONENTE, pintado aquí en SSR y solo mostrado u
           ocultado por JS. Antes se generaba con una plantilla de cadena que
           replicaba su marcado a mano, y se desincronizó a la primera: al
           cambiar el alto de la foto en el componente, la home seguía con el
           anterior. Sin `pt` propio en móvil para que la foto arranque a 32px
           de los recuentos y no a 89. -->
      <div id="views-empty-state" class="hidden absolute inset-0 bg-mel-bg-primary z-[30] items-start justify-center pb-24 lg:items-center overflow-y-auto">
        <EmptyState variant="no-results" class="pt-0 lg:pt-[24px]" />
      </div>

      <!-- 1. GALLERY VIEW (masonry 2.1: CSS Grid + row-span medido por imagen,
           cada flyer entero a ancho de columna y ratio original, sin recortes;
           orden aleatorio, scroll infinito vía #gallery-sentinel. Ver
           decisions.md D-014/D-015; galeria-1.0 es el tag de la rejilla
           antigua de alturas fijas). -->
      <!-- Negative side margins + matching padding make the scroll container clip
           44px OUTSIDE the grid on the sides, so hovered cards (scale + shadow)
           aren't cut off at the edges while the grid stays full-width. Bottom
           breathing room lives on the grid itself (pb) because a scroll
           container's own padding-bottom is dropped from the scrollable area,
           so it wouldn't reserve space at the end of the scroll.
           pt-0 (D-067, was pt-[24px]): on mobile the gap up to the toolbar
           already comes from the page's own flex layout — this extra 24px on
           top of that was pushing the grid down further than intended.
           lg:mt-[16px]/lg:pt-[8px] (D-064) still stand on desktop, where the
           opposite problem existed (cards sitting too close during scroll).
           -mb-[3vh] cancels the page's own pb-[3vh] (the calibrated top/bottom
           breathing room, rule 9 — not touching that) so the scroll
           container's own box reaches the literal bottom of the screen
           instead of stopping 3vh short of it. -->
      <div id="view-galería" class="view-panel active flex-1 w-[calc(100%+88px)] -ml-[44px] -mb-[3vh] overflow-y-auto transition-all duration-500 px-[44px] pt-0 lg:pt-[8px] lg:mt-[16px] relative">
        <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-mel-l auto-rows-[4px] w-full pb-[13vh]">
          {shuffledArchives.slice(0, 32).map((item, i) => {
            const imgSrc = extractDriveImage(item.carruselItems[0]?.urlDrive, ANCHO_TARJETA) || `/flyers/flyer-${((i % 13) + 1)}.png`;
            const yr = getYear(item.fecha) || 2004;
            return (
              <FlyerCard
                id={item.idMel}
                title={item.evento}
                category={item.organiza || "Colectivo"}
                location={`${item.lugar}. ${item.localidad}`}
                year={yr}
                date={formatFechaDMY(item.fecha)}
                image={imgSrc}
              />
            );
          })}
        </div>
        <!-- Centinela del scroll infinito: cuando entra en el margen de
             precarga del IntersectionObserver (~1200px antes de ser visible)
             se añade el siguiente lote de tarjetas. -->
        <div id="gallery-sentinel" class="h-px w-full" aria-hidden="true"></div>
      </div>

      <!-- 2. MAP VIEW (Real Google Map with sliding side panel). top-0 on mobile,
           lg:top-[24px] on desktop (D-067) — mirrors the gallery's own pt-0/lg:pt-[8px]
           split (D-064/D-067): the propietario asked to raise all three home views'
           content by 24px on mobile specifically, desktop untouched here. -->
      <div id="view-mapa" class="view-panel hidden absolute top-0 lg:top-[24px] right-0 bottom-0 left-0 overflow-hidden flex">
        <div id="map-container" class="flex-1 h-full"></div>

        <!-- Dim: solo cuando el panel es bottom sheet (bajo lg). Cubre el slider
             de tiempo (que queda a la vista, atenuado) y todo lo de abajo. -->
        <div
          id="map-side-panel-backdrop"
          class="lg:hidden fixed inset-0 bg-[var(--mel-dim)] mix-blend-multiply z-[19] opacity-0 pointer-events-none transition-opacity duration-500"
          aria-hidden="true"
        ></div>

        <!-- Side Panel / Place Events Panel -->
        <div
          id="map-side-panel"
          class="w-0 h-full bg-mel-bg-primary border-l-0 border-mel-border flex flex-col justify-start z-20 overflow-hidden shrink-0 transition-all duration-300 relative"
          style="opacity: 1;"
          data-node-id="341:25563"
        >
          <!-- Tirador + pliegue decorativo: solo bottom sheet en móvil (Figma
               "Bottom Sheet Header", node 269:11222). Cerrar deslizando hacia
               abajo, ver setupSidePanelDrag(). -->
          <BottomSheetHeader handleId="map-side-panel-handle" class="lg:hidden" closeId="map-side-panel-close-zone" />


          <!-- Header / Close button. Pegada a la caja contenedora (pt-0, a la
               misma altura donde arranca #map-container) en todas las anchuras
               — antes solo en el bottom sheet móvil, el propietario pidió lo
               mismo en desktop viendo que sobraba hueco arriba del todo. -->
          <!-- Ya no hay X en el bottom sheet: cierra la cabecera entera
               (BottomSheetHeader, arriba), que es una zona de acierto mucho
               mayor para un pulgar que un icono de 40px. Como panel lateral se
               cierra pulsando de nuevo el nombre/dirección del local (ver
               #side-panel-header-toggle). -->

          <!-- Title & Address. pt-16 (no el pt-24 original de Figma) en todas
               las anchuras: 8px más cerca de la X, mismo criterio que arriba. -->
          <div class="flex flex-col gap-[8px] items-start pb-[32px] pt-[16px] px-6 sm:px-12 lg:px-6 shrink-0 w-full relative">
            <!-- Como panel lateral (lg+) este bloque ES el cierre: sin X, se
                 pulsa sobre el nombre/dirección para plegarlo. Sin cambio de
                 color al pasar por encima: se leía como "esto es un enlace a
                 otra cosa". Como bottom sheet sigue siendo texto inerte, porque
                 ahí hay X, dim y tirador propios. -->
            <div
              id="side-panel-header-toggle"
              class="flex flex-col gap-[8px] items-start justify-center w-full lg:cursor-pointer lg:select-none"
            >
              <h2 id="side-panel-title" class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] lg:text-[25px] lg:leading-[32px] lg:tracking-[-0.5px] text-mel-text-primary truncate w-full"></h2>
              <p id="side-panel-address" class="typo-body-roman text-mel-text-secondary truncate w-full"></p>
            </div>
          </div>
          
          <!-- Highlight / Tag Section — AdaptiveTagsRow.astro (D-059/D-060),
               shared with the home toolbar and the event detail's horizontal
               tags row. Layout mode (equal-width grid vs content-sized+
               scroll+bleed) is decided by updateAdaptiveTagsRow() below, no
               sibling to negotiate space with so it's always "alone" against
               the panel's own width. -->
          <div class="pb-[24px] px-6 sm:px-12 lg:px-6 flex flex-col items-start justify-center w-full z-[2] relative shrink-0">
            <AdaptiveTagsRow
              id="side-panel-tags-container"
              tags={[
                { label: 'Eventos', count: '0' },
                { label: 'Artistas', count: '0' },
                { label: 'Diseñadores', count: '0' },
                { label: 'Promotores', count: '0' },
              ]}
            />
          </div>
          
          <!-- Event List (Scrollable) -->
          <div id="side-panel-event-list" class="flex-1 overflow-y-auto bg-mel-bg-primary relative pb-8">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>

      <!-- 3. LIST VIEW. pt-0 on mobile, lg:pt-[24px] on desktop (D-067) — same split as
           the gallery/map views above: raise all three home views' content by 24px on
           mobile specifically, desktop untouched.
           -mb-[3vh] (D-064, restored in D-066): cancels the page's own pb-[3vh] so the
           scroll containers inside (#list-mobile-cards/#list-table-wrapper, both flex-1)
           reach the literal bottom of the screen. Safe again now that pagination-controls
           lives INSIDE those containers (D-066) instead of as a flex sibling here — nothing
           left for a negative margin on this element to disturb. -->
      <div id="view-lista" class="view-panel hidden flex-col justify-start w-full relative flex-1 min-h-0 pt-0 lg:pt-[24px] -mb-[3vh]">
        <!-- The border lives on the <table> itself (top+bottom), not this wrapper — the wrapper
             is flex-1/stretches to fill whatever vertical space is available, so its own border
             would sit at the wrapper's edge (often below the actual last row, with an empty gap,
             whenever there are fewer rows than fit on screen) instead of hugging the table's real
             content, which is what "closing" the table means. Cells already carry border-l/border-r
             on every row, so no side borders needed here either. -->
        <!-- Mobile: réplica compacta EventCardList (Figma 439:142691) sustituye
             la tabla ancha de escritorio — ver AGENTS.md regla 7 (JS replica el
             marcado de EventCardList.astro, poblado en performDOMUpdates()). -->
        <!-- -mx-6 sm:-mx-12 cancela el padding horizontal de la página (px-6 /
             sm:px-12) en todo el rango en que esta lista es visible: las filas
             ya traen su propio pl-24/pr-16 (EventCardList), así que sin esto
             quedaban CON DOBLE margen hasta el borde de pantalla. -->
        <div id="list-mobile-cards" class="block min-[440px]:hidden -mx-6 sm:-mx-12 flex-1 overflow-y-auto relative">
          <div id="list-mobile-cards-items"></div>
          <div id="pagination-controls-mobile" class="pagination-controls-container hidden gap-4 items-center justify-center pt-6 pb-10 relative left-0 right-0 w-full select-none shrink-0 bg-mel-bg-primary">
            <IconButton
              icon="chevron-left"
              size={40}
              type="phantom"
              aria-label="Página anterior"
              class="btn-prev-page invisible disabled:opacity-0 disabled:pointer-events-none transition-opacity duration-200"
            />
            <div class="pagination-numbers flex gap-4 items-center relative"></div>
            <IconButton
              icon="chevron-right"
              size={40}
              type="phantom"
              aria-label="Página siguiente"
              class="btn-next-page invisible disabled:opacity-0 disabled:pointer-events-none transition-opacity duration-200"
            />
          </div>
        </div>
        <div id="list-table-wrapper" class="hidden min-[440px]:block overflow-x-auto w-full flex-1 overflow-y-auto">
          <table class="w-full text-left text-sm border-collapse border-t border-b border-mel-border min-w-[816px]" style="table-layout:fixed;">
            <!-- Evento gets 2 "shares" of the space, Lugar/Localidad/Organiza/Diseño get 1 share
                 each (6 shares total), Fecha gets just enough for a date. calc() inside <col>
                 width doesn't reliably resolve per-column here (tested: every calc() column came
                 out identical, ignoring the multiplier) — plain percentages, worked out by hand
                 against a ~120px Fecha column, are what actually render correctly. -->
            <!-- Fecha en PÍXELES fijos, no en porcentaje: con
                 `table-layout:fixed` manda el <colgroup> y el `min-w-[136px]`
