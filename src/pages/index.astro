    // Update sliding indicator position
    if (activeIndicator) {
      if (viewName === 'galería') {
        activeIndicator.style.transform = 'translate3d(0, 0, 0)';
      } else if (viewName === 'mapa') {
        activeIndicator.style.transform = 'translate3d(100%, 0, 0)';
      } else if (viewName === 'lista') {
        activeIndicator.style.transform = 'translate3d(200%, 0, 0)';
      }
    }

    viewBtns.forEach(btn => {
      const isActive = btn.dataset.view === viewName;
      btn.setAttribute('data-active', isActive ? 'true' : 'false');
      
      if (isActive) {
        btn.classList.add('toggle-btn-active');
        btn.classList.remove('toggle-btn-inactive');
      } else {
        btn.classList.remove('toggle-btn-active');
        btn.classList.add('toggle-btn-inactive');
      }

      const span = btn.querySelector('span');
      if (span) {
        // El peso lo pone la clase del DS, no `font-bold`/`font-medium`:
        // `typo-button` es 700 y `typo-lead` 500, y las dos son 17/26 con el
        // mismo interletrado, así que solo cambia el grosor.
        //
        // Ojo con volver a las utilidades: mientras el marcado SSR llevaba la
        // clase `typo-*` y esto intercambiaba `font-bold`/`font-medium`, GANABA
        // LA CLASE. Resultado: la pestaña que se apagaba se quedaba en negrita y
        // la que se encendía no engordaba — exactamente al revés. Las dos cosas
        // tienen que hablar el mismo idioma (ver ToggleButton.astro).
        if (isActive) {
          span.classList.add('typo-button', 'text-mel-text-on-action');
          span.classList.remove('typo-lead', 'text-mel-text-secondary');
        } else {
          span.classList.remove('typo-button', 'text-mel-text-on-action');
          span.classList.add('typo-lead', 'text-mel-text-secondary');
        }
      }
    });

    viewPanels.forEach(panel => {
      if (panel.id === `view-${viewName}`) {
        panel.classList.remove('hidden');
        panel.classList.add('active');
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('active');
      }
    });

    // Tarjetas reconstruidas (búsqueda/filtro/orden) mientras la galería
    // estaba oculta tras otra pestaña miden clientWidth=0 en ese momento:
    // sizeGalleryCard() no puede calcular su row-span y se quedan
    // "unsized" (placeholder de ~300px). Como el grid no recorta la caja a
    // su área reservada (align-self:start), una imagen real más alta que
    // ese placeholder se solapa con la fila siguiente. Al volver a mostrar
    // la galería, remide solo las que se quedaron a medias.
    if (viewName === 'galería') {
      const unsizedCards = document.querySelectorAll('#gallery-grid .gallery-item.unsized');
      if (unsizedCards.length > 0) {
        const anyCard = document.querySelector('#gallery-grid .gallery-item');
        const colWidth = anyCard ? anyCard.clientWidth : 0;
        unsizedCards.forEach(card => sizeGalleryCard(card, colWidth));
      }
    }

    // Mismo problema que el de arriba, y por el mismo motivo (D-233): la
    // tabla se construye mientras su panel sigue con `hidden`, así que al
    // medir el marquee `clientWidth` es 0 y ninguna celda queda marcada como
    // desbordada — de ahí que al ENTRAR en Lista el deslizado no funcionara
    // en ningún enlace, y sí lo hiciera al volver desde una ficha (ahí el
    // panel ya estaba visible al construirse). Se remide al mostrarla, en el
    // fotograma siguiente para que el navegador ya le haya dado caja.
    if (viewName === 'lista') {
      requestAnimationFrame(() => medirMarquee(document.getElementById('list-table-body')));
    }

    // Solo la lista pagina (la galería usa scroll infinito desde D-015).
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;
    document.querySelectorAll('.pagination-controls-container').forEach(pagControls => {
      if (viewName === 'lista' && filtered.length > 0 && totalPages > 1) {
        pagControls.classList.remove('hidden');
        pagControls.classList.add('flex');
      } else {
        pagControls.classList.add('hidden');
        pagControls.classList.remove('flex');
      }
    });

    // Initialize or refresh Google map on switch to 'mapa'. On a soft (Astro
    // SPA) navigation away from and back to this page, mapInitialized/googleMap
    // persist on window._melState (they're just JS objects), but the actual
    // #map-container DOM node they were built into gets swapped out for a
    // fresh one — Google Maps never re-parents into the new node, so the map
    // silently renders into a detached element. Detect that by comparing the
    // container we last built into against the one currently in the DOM, and
    // force a full re-init when they differ (or the old one got disconnected).
    if (viewName === 'mapa') {
      const currentMapContainer = document.getElementById('map-container');
      const isStale = !mapInitialized || !googleMap || !currentMapContainer ||
        currentMapContainer !== mapContainerEl || !mapContainerEl.isConnected;
      if (isStale) {
        initGoogleMap();
        mapInitialized = true;
      } else if (googleMap) {
        // Trigger resize and re-fit bounds now that container has dimensions
        google.maps.event.trigger(googleMap, 'resize');
        fitMapToMarkers();
      }
    }
  }

  // Matches the long-format Google Maps share link, e.g.
  // https://www.google.com/maps/place/Av.+Lancia,+9,+24004+León/@42.59,-5.57,460m/data=...!3d42.5937072!4d-5.573658!...
  // — the preferred way to fill in an event's address going forward (see
  // parseCoords below): paste the "share" link from Maps and it carries
  // both a human-readable address AND precise coordinates, no separate
  // geocoding step or hand-maintained coordinate dictionary needed. Only
  // the long format is supported (not the maps.app.goo.gl short one) since
  // that one embeds everything directly in the URL text — resolving a
  // short link's redirect would mean a network call on every page render
  // now that this site is server-rendered per visit.
  const GOOGLE_MAPS_URL_RE = /google\.[a-z.]+\/maps|maps\.app\.goo\.gl|goo\.gl\/maps/i;

  // Pulls the readable address out of a Maps share link's /maps/place/NAME/
  // segment for display (e.g. in the map side panel). Falls back to the
  // raw string unchanged for anything that isn't a Maps link (DMS text,
  // a plain address someone typed by hand, etc.).
  // Corta el código postal y se queda con el nombre de la localidad detrás
  // (D-219/D-220): "Av. Lancia, 9, 24004 León" pasa a "Av. Lancia, 9, León".
  // La primera versión buscaba un trozo que fuera SOLO un número (el de la
  // calle) y cortaba justo ahí, tirando la localidad entera — pero fallaba
  // en direcciones de carretera sin número de calle propiamente dicho, como
  // "N-6, Km 400, 24540 Cacabelos, León" (ningún trozo es un número suelto,
  // así que no encontraba nada y lo dejaba TODO, código postal incluido:
  // el bug que reportó el propietario con Voloko).
  //
  // Ahora se busca el trozo con el patrón "código postal + nombre" (dígitos
  // seguidos de texto, sin más suposiciones sobre qué hay antes) y se corta
  // ahí: todo lo anterior se conserva tal cual (calle, número, "Km 400"...),
  // se le quitan los dígitos del código postal a ese trozo y el resultado
  // se añade al final. Cualquier cosa después de ese trozo (en Voloko,
  // "León" de provincia) se descarta — "solo el primero" de los nombres de
  // localidad, no los dos.
  function truncarDireccion(direccion) {
    const partes = direccion.split(',').map(p => p.trim()).filter(Boolean);
    if (partes.length < 2) return direccion;

    const idxLocalidad = partes.findIndex(p => /^\d{4,5}\s+\S/.test(p));
    if (idxLocalidad !== -1) {
      const antes = partes.slice(0, idxLocalidad);
      const localidad = partes[idxLocalidad].replace(/^\d[\d\s-]*\s*/, '').trim();
      const resultado = localidad ? [...antes, localidad] : antes;
      return resultado.length ? resultado.join(', ') : direccion;
    }

    // D-225: sin código postal reconocible en el segmento legible (pasa en
    // direcciones de Google que lo llevan solo en el parámetro de datos de
    // la URL, no en el nombre de calle — caso real "Delfos": el /place/ es
    // literalmente "LE-158/26, Dehesas, León", sin ningún dígito). Si el
    // ÚLTIMO trozo es exactamente "León" —la provincia, que en este archivo
    // (solo cubre la provincia de León) nunca añade nada sobre el trozo de
    // antes, que ya es la localidad real— se descarta y se conserva el
    // resto tal cual: "LE-158/26, Dehesas, León" → "LE-158/26, Dehesas".
    if (partes[partes.length - 1].toLowerCase() === 'león') {
      return partes.slice(0, -1).join(', ');
    }

    return direccion;   // ningún patrón reconocido: se deja tal cual
  }

  function extractAddressLabel(coordStr) {
    if (!coordStr || !GOOGLE_MAPS_URL_RE.test(coordStr)) return coordStr;
    const placeMatch = coordStr.match(/\/maps\/place\/([^/]+)/);
    if (placeMatch) {
      let legible;
      try {
        legible = decodeURIComponent(placeMatch[1].replace(/\+/g, ' '));
      } catch (e) {
        legible = placeMatch[1].replace(/\+/g, ' ');
      }
      return truncarDireccion(legible);
    }
    return coordStr;
  }

  // Coordinates parser for map markers
  function parseCoords(coordStr, locality) {
    if (!coordStr && !locality) return null;
    const cleanCoord = coordStr ? coordStr.trim().toLowerCase() : '';

    // Google Maps share link: prefer the precise pinned point (!3d..!4d..)
    // over the @lat,lng that follows the place name, which is just the
    // map viewport's center at share time and can be noticeably off from
    // the actual pin for a zoomed-out share.
    if (coordStr && GOOGLE_MAPS_URL_RE.test(coordStr)) {
      const preciseMatch = coordStr.match(/!3d(-?\d+\.?\d*)!4d(-?\d+\.?\d*)/);
      if (preciseMatch) return [parseFloat(preciseMatch[1]), parseFloat(preciseMatch[2])];
      const viewportMatch = coordStr.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
      if (viewportMatch) return [parseFloat(viewportMatch[1]), parseFloat(viewportMatch[2])];
    }
    const cleanLoc = locality ? locality.trim().toLowerCase() : '';
    
    // Respaldo por LOCALIDAD, y nada más. Las direcciones concretas de cada
    // garito vivían aquí —14 entradas geocodificadas a mano— y eran la única
    // forma de colocar 31 de los 51 eventos. Se borraron el 02/08/2026, cuando
    // la columna G de la hoja pasó a llevar la URL larga de Google Maps, que ya
    // trae la dirección Y las coordenadas (D-184).
    //
    // No se conserva "por si acaso": un respaldo que rescata en silencio es
    // exactamente lo que tuvo escondido durante meses que la mitad del mapa
    // dependiera del código. Que falle a la vista, y que el panel lo diga.
    const dict = {
      'león': [42.5987, -5.5671],
      'leon': [42.5987, -5.5671],
      'san andrés del rabanedo': [42.6105, -5.6147],
      'santa olaja de porma': [42.6322, -5.4055],
    };
    
    if (cleanCoord && dict[cleanCoord]) return dict[cleanCoord];
    
    if (coordStr) {
      const dmsRegex = /(\d+)°\s*(\d+)'\s*([\d.]+)"\s*([NS])\s*(\d+)°\s*(\d+)'\s*([\d.]+)"\s*([EW])/i;
      const match = coordStr.match(dmsRegex);
      if (match) {
        let lat = parseInt(match[1]) + parseInt(match[2]) / 60 + parseFloat(match[3]) / 3600;
        if (match[4].toUpperCase() === 'S') lat = -lat;
        let lng = parseInt(match[5]) + parseInt(match[6]) / 60 + parseFloat(match[7]) / 3600;
        if (match[8].toUpperCase() === 'W') lng = -lng;
        return [lat, lng];
      }
      const decRegex = /(-?\d+\.\d+)\s*,\s*(-?\d+\.\d+)/;
      const decMatch = coordStr.match(decRegex);
      if (decMatch) return [parseFloat(decMatch[1]), parseFloat(decMatch[2])];
    }
    
    // Only fall back to locality if coordStr is empty
    if (!cleanCoord && cleanLoc && dict[cleanLoc]) return dict[cleanLoc];
    
    return null;
  }

  // Orden de apilamiento de TODOS los marcadores, con una sola regla
  // (D-230): el que está más abajo en la pantalla va por encima. En este
  // mapa "más abajo" es "más al sur", o sea menor latitud, así que se
  // invierte la latitud para que a menor latitud le toque mayor zIndex.
  //
  // Antes no había una regla, había tres: los pines sueltos se dejaban en
  // `null` (Google los ordena por posición, que ya era esto), los clusters
  // saltaban a `MAX_ZINDEX + count` y el activo a `MAX_ZINDEX + 1000000`.
  // Con la sombra dentro del marcador, esos dos saltos hacían que la sombra
  // de un cluster —o del marcador activo— se pintara por encima de pines
  // que estaban más abajo en la pantalla.
  //
  // El x10000 conserva ~4 decimales de latitud, de sobra para que dos
  // locales distintos no empaten. El +900000 lo deja siempre positivo.
  function zIndexPorLatitud(pos) {
    const lat = typeof pos?.lat === 'function' ? pos.lat() : pos?.lat;
    if (typeof lat !== 'number' || Number.isNaN(lat)) return null;
    return Math.round((90 - lat) * 10000);
  }

  // La latitud SOLO sirve mientras el mapa mira al norte (D-242). En cuanto se
  // gira, "más al sur" deja de ser "más abajo en la pantalla" y el orden se
  // invierte a trozos — el propietario lo vio: los marcadores del fondo se
  // colaban por delante. Medido con el mapa a 90°: el orden por z-index y el
  // orden real en pantalla no coincidían en ninguna posición salvo la primera.
  //
  // No hace falta trigonometría con el `heading` ni recalcular "cada X
  // grados": el navegador ya sabe dónde ha pintado cada marcador, así que se
  // lee su posición real y se ordena por ella. Eso vale para girar, inclinar,
  // hacer zoom y desplazar sin distinguir entre ellos.
  //
  // Se escribe la PROPIEDAD `zIndex` del marcador y no `style.zIndex`
  // (D-242): son cosas distintas. Google reaplica su propia propiedad sobre
  // el estilo en cada repintado, así que un `style.zIndex` puesto a mano
  // duraba hasta el siguiente fotograma del gesto — medido: al girar, los
  // valores volvían solos a los de latitud (47xxxx) y el orden se revertía
  // hasta soltar. Escribiendo la propiedad, lo que Google reaplica ya es lo
  // nuestro. Se llega por el DOM y no por `locationMarkers` para no dejar
  // fuera los globos de cluster, que los crea la librería; el elemento
  // `<gmp-advanced-marker>` ES el objeto AdvancedMarkerElement.
  function reordenarMarcadoresPorPantalla() {
    const envoltorios = document.querySelectorAll('#map-container .mel-marker-wrapper');
    if (!envoltorios.length) return;

    const datos = [];
    envoltorios.forEach(w => {
      const marcador = w.closest('gmp-advanced-marker');
      if (!marcador) return;
      const caja = w.getBoundingClientRect();
      // Un marcador todavía sin pintar mide 0: dejarlo fuera evita mandarlo
      // al fondo por un dato que no es su posición real.
      if (caja.height <= 0) return;
      datos.push({ marcador, y: caja.bottom });
    });
    if (!datos.length) return;

    // De arriba abajo en pantalla; al de más abajo, el z-index más alto.
    datos.sort((a, b) => a.y - b.y);
    datos.forEach((d, i) => { d.marcador.zIndex = 1000 + i; });
  }

  // Durante el gesto, no solo al soltarlo (D-242). `idle` llega cuando la
  // cámara ya se ha parado, así que mientras se arrastraba o se giraba el
  // orden se veía revertido y solo se colocaba al levantar el dedo — lo
  // reportó el propietario. `bounds_changed` y `heading_changed` sí van
  // disparándose durante el gesto (comprobado). Se acota a un fotograma para
  // no recalcular varias veces por frame: son pocos marcadores, pero esto
  // corre mientras el dedo se mueve.
  // Es un BUCLE mientras la cámara se mueve, no un reordenado por evento
  // (D-242). Se probó lo segundo y no basta: `bounds_changed` y
  // `heading_changed` se disparan de forma irregular —en una rotación
  // programática saltan al principio y poco más—, así que el orden se
  // quedaba desfasado casi toda la animación (medido: 1-4 aciertos de 7
  // durante ~600ms, y correcto solo al parar). Con el bucle se recalcula en
  // cada fotograma mientras hay movimiento y se corta en `idle`.
  //
  // El coste es una lectura de caja y una escritura por marcador y fotograma,
  // con una decena de marcadores en pantalla.
  let bucleReorden = null;
  function pedirReordenMarcadores() {
    if (bucleReorden) return;
    const paso = () => {
      reordenarMarcadoresPorPantalla();
      bucleReorden = requestAnimationFrame(paso);
    };
    bucleReorden = requestAnimationFrame(paso);
  }
  function pararReordenMarcadores() {
    if (bucleReorden) cancelAnimationFrame(bucleReorden);
    bucleReorden = null;
    reordenarMarcadoresPorPantalla();   // remate con la cámara ya quieta
  }

  // Renders a cluster bubble. Defined once at module scope (not nested
  // inside initGoogleMap) since it only touches markerLib/googleMap, which
  // are already shared top-level state — that lets createGoogleMapInstance()
  // reuse it too when the map gets recreated for a color scheme change.
  // Última cifra de cluster que vio cada localización (por locKey). Es la
  // memoria que permite que una burbuja recreada por el clusterer se lea
  // como CONTINUACIÓN (D-250): nace sin animación de entrada y con su número
  // rodando desde la cifra anterior, en vez del rebote de escala que, al
  // repetirse en cada tirón del slider, era los "saltitos". No se limpia
  // cuando una localización sale del filtro: como mucho, un grupo que
  // reaparezca mucho después rueda desde una cifra vieja — cosmético.
  const ultimaCifraDeCluster = new Map();

  const clusterRenderer = {
    render: ({ count, position, markers }) => {
      // `count` is the number of distinct location pins folded into this
      // cluster — what actually matters to a visitor is how many events live
      // behind it, i.e. the sum of each pin's own event count.
      const eventCount = (markers || []).reduce((sum, m) => sum + (m.eventCount || 1), 0);

      // ¿Algún miembro venía ya de un grupo visible? Entonces esta burbuja
      // es continuación, no estreno. Con varios candidatos manda el mayor
      // (al partirse un grupo por zoom, cada hijo rueda desde la cifra del
      // padre hacia la suya, que es como se lee el reparto).
      let cifraPrevia = null;
      (markers || []).forEach(m => {
        const c = ultimaCifraDeCluster.get(m.melLocKey);
        if (c != null && (cifraPrevia === null || c > cifraPrevia)) cifraPrevia = c;
      });

      const clusterContent = document.createElement('div');
      clusterContent.className = 'mel-marker-wrapper' + (cifraPrevia !== null ? ' sin-entrada' : '');
      // El `+` delante distingue de un golpe un grupo de un marcador suelto: un
      // "12" a secas se lee como "aquí hay doce eventos", cuando lo que dice en
      // realidad es "aquí y alrededor". Solo lo llevan los clusters; los pines
      // individuales siguen con su número tal cual (se pintan en otro sitio).
      clusterContent.innerHTML = `
        <div class="mel-marker-body">
          <span class="mel-marker-label">+${cifraPrevia !== null ? cifraPrevia : eventCount}</span>
        </div>
        <div class="mel-marker-pointer"></div>
        <div class="mel-marker-shadow"></div>
      `;
      if (cifraPrevia !== null && cifraPrevia !== eventCount) {
        // Mismo rodillo que las tags de la cabecera, con el `+` en cada
        // fotograma (ver animateValue).
        animateValue(clusterContent.querySelector('.mel-marker-label'), cifraPrevia, eventCount, 250, '+');
      }
      (markers || []).forEach(m => { if (m.melLocKey) ultimaCifraDeCluster.set(m.melLocKey, eventCount); });

      const clusterMarker = new markerLib.AdvancedMarkerElement({
        position,
        content: clusterContent,
        // Misma regla que cualquier otro marcador: manda la posición en
        // pantalla, no el tipo (D-230). Antes los clusters se colaban en
        // `MAX_ZINDEX + count` (≈1.000.000), muy por encima de todo, así que
        // su sombra tapaba pines que estaban más abajo en la pantalla.
        zIndex: zIndexPorLatitud(position),
      });

      clusterMarker.addListener('click', () => {
        // A cluster can hold many members packed into a small area —
        // forcing them ALL to separate with margin in one step demands
        // a zoom deep enough that, in this map's fairly short viewport,
        // often isn't achievable at all (see fitBounds()'s padding vs.
        // container-height math we hit trying that). Instead, zoom in
        // a fixed, moderate amount and let the clusterer re-group
        // whatever's still packed together into smaller pieces — click
        // again to keep drilling down until it's just individual pins.
        // Centering happens together with the zoom (not as a separate,
        // instant panTo beforehand) so the cluster gradually drifts toward
        // the center as it zooms in and breaks apart, rather than jumping
        // to its final position first.
        smoothZoomTo(Math.min(Math.round(googleMap.getZoom()) + 3, 20), position);
      });

      return clusterMarker;
    }
  };

  // Creates (or re-creates) the Map + its MarkerClusterer in #map-container.
  // Split out of initGoogleMap() so the color-scheme-change handler below
  // can call it again — colorScheme can't be swapped live via setOptions()
  // on an existing Map instance, Google keeps rendering tiles from whichever
  // scheme it was created with, so switching it means building a new one.
  function createGoogleMapInstance(colorScheme, center, zoom) {
    mapContainerEl = document.getElementById("map-container");
    _s.mapContainerEl = mapContainerEl;
    googleMap = new google.maps.Map(mapContainerEl, {
      center,
      zoom,
      mapId: "972db64e35393894d465ef68", // Custom Maps style ID matching Figma
      colorScheme,
      disableDefaultUI: true, // Disables Satellite view, Street View (saves cost and keeps layout clean)
      zoomControl: true,
      isFractionalZoomEnabled: true, // lets smoothZoomTo() animate through in-between zoom levels
    });
    _s.googleMap = googleMap;

    if (typeof markerClusterer !== 'undefined') {
      googleMapClusterer = new markerClusterer.MarkerClusterer({
        map: googleMap,
        markers: [],
        renderer: clusterRenderer,
        // Default clustering radius (60px) is tuned for small dot markers —
        // ours are wide text-label bubbles (~150-250px), so the library was
        // "declustering" them into individual pins well before they were
        // actually far enough apart on screen not to overlap. A wider
        // radius keeps them bundled as one cluster bubble until they've
        // spread out enough to stand on their own without piling up.
        algorithm: new markerClusterer.SuperClusterAlgorithm({ radius: 110 }),
      });
    }
    _s.googleMapClusterer = googleMapClusterer;

    // Reordenar EN VIVO durante el gesto y una vez más al pararse (D-242):
    // `bounds_changed` cubre desplazar e inclinar, `heading_changed` el giro,
    // e `idle` remata por si algún reajuste final movió algo.
    googleMap.addListener('bounds_changed', pedirReordenMarcadores);
    googleMap.addListener('heading_changed', pedirReordenMarcadores);
    googleMap.addListener('idle', pararReordenMarcadores);

    // Any markers from a previous Map instance are gone along with it (a new
    // Map wipes its container's contents) — drop stale references so
    // updateMapMarkers() rebuilds every pin fresh instead of thinking they
    // still exist.
    locationMarkers.clear();
    mapMarkers = [];
    _s.mapMarkers = mapMarkers;

    // The classic google.maps.Map API (unlike the newer <gmp-map> element)
    // has no idea its container resized unless told via event.trigger(map,
    // 'resize') — left alone, opening the side panel (which shrinks
    // #map-container through a plain CSS width transition, D-026) left the
    // map's actual rendered content at its old, wider size for the whole
    // transition, so the panel visually looked like it popped in ON TOP of
    // a still-full-width map instead of the map making room for it. A
    // ResizeObserver ties the resize signal to the container's REAL size on
    // every frame it actually changes — robust regardless of transition
    // duration/easing, and covers open, close, and window resize alike with
    // one mechanism instead of guessing fixed delays per call site.
    if (mapResizeObserver) mapResizeObserver.disconnect();
    mapResizeObserver = new ResizeObserver(() => {
      google.maps.event.trigger(googleMap, 'resize');
    });
    mapResizeObserver.observe(mapContainerEl);
  }

  async function initGoogleMap() {
    try {
      await google.maps.importLibrary("maps");
      markerLib = await google.maps.importLibrary("marker");
      mapCore = await google.maps.importLibrary("core");

      // The Map ID has both a light and a dark style variant configured in
      // Google Cloud Console — colorScheme picks between them; it's kept in
      // sync with the site's own toggle below.
      const isDarkNow = document.documentElement.classList.contains('dark');
      createGoogleMapInstance(
        isDarkNow ? google.maps.ColorScheme.DARK : google.maps.ColorScheme.LIGHT,
        { lat: 42.5987, lng: -5.5671 },
        14
      );

      // Persist to global state
      _s.markerLib = markerLib;
      _s.mapCore = mapCore;
      _s.mapInitialized = true;
      mapInitialized = true;

      updateMapMarkers(true);

      // The map container may not have its final layout size yet at this
      // exact moment (it just became visible as part of the same view
      // switch), which can make this first fitBounds() compute a bogus,
      // too-far-out zoom. Re-trigger resize + re-fit shortly after, same
      // fix already relied on when switching back to an initialized map.
      setTimeout(() => {
        google.maps.event.trigger(googleMap, 'resize');
        fitMapToMarkers();
      }, 150);
    } catch (e) {
      console.error("Error loading Google Maps API", e);
    }
  }

  // Abre/cierra el panel del mapa y su dim (D-022/D-023). Un único punto de
  // entrada para las 5 llamadas que antes tocaban `side-panel-open` por su
  // cuenta, así el backdrop nunca puede quedarse desincronizado del panel.
  function setSidePanelOpenState(open) {
    const sidePanel = document.getElementById('map-side-panel');
    const backdrop = document.getElementById('map-side-panel-backdrop');
    if (open) syncSheetTop();
    if (sidePanel) sidePanel.classList.toggle('side-panel-open', open);
    if (backdrop) backdrop.classList.toggle('side-panel-open', open);
  }

  // El bottom sheet del mapa (bajo lg) arranca justo por encima del slider de
  // tiempo, tapándolo del todo bajo el DIM (D-060 — antes se anclaba al borde
  // INFERIOR del slider, dejándolo a la vista; el propietario pidió que suba
  // hasta cubrirlo entero). Su alto (top) no es fijo: se mide el borde
  // SUPERIOR del slider y se publica en --mel-sheet-top (lo consume la media
  // query del sheet). Se recalcula al abrir y en cada resize.
  const SHEET_MARGEN_SUPERIOR = 40;
  function syncSheetTop() {
    document.documentElement.style.setProperty('--mel-sheet-top', SHEET_MARGEN_SUPERIOR + 'px');
  }

  // Populate side panel details dynamically.
  // delayOpen (ms): when > 0, the CSS slide-in waits that long after the DOM
  // has been populated — lets the map pan/zoom settle visually before the
  // panel slides over it (used by the auto-open-from-location-link path).
  function populateSidePanel(group, delayOpen = 0) {
    const sidePanel = document.getElementById('map-side-panel');
    if (!sidePanel) return;

    const isAlreadyOpen = sidePanel.classList.contains('side-panel-open');

    // Firma de lo que el panel está mostrando. La consume la rama de
    // resincronización de updateMapMarkers() para no repintar lo mismo; aquí
    // solo se registra, porque cortar la función entera se saltaría además la
    // apertura y dejaría el panel con su transformación de cerrado.
    sidePanel.dataset.firmaPanel = group.locationName + '|' + group.events.map(e => e.idMel).join(',');

    const updateSidePanelDOM = () => {
      // Identidad del local que el panel está mostrando ahora mismo: es lo que
      // permite distinguir "cambiar de local" (con fundido) de "refrescar el
      // mismo" (en silencio) — ver la bifurcación más abajo.
      sidePanel.dataset.locName = group.locationName;
      // Populate side panel fields
      document.getElementById('side-panel-title').textContent = group.locationName;
      const sampleEvt = group.events[0];
      // Column G holds either a plain address/DMS string (shown as-is) or a
      // Google Maps share link, in which case we show its readable address
      // instead of the raw URL.
      document.getElementById('side-panel-address').textContent = extractAddressLabel(sampleEvt?.coordenadas) || '';

      // Calculate unique artists, designers and promoters (organiza) — same
      // 'desconocido'/'varios' exclusions as the home toolbar's own stats
      // (see initialPromoters above).
      const artistsSet = new Set();
      const designersSet = new Set();
      const promotersSet = new Set();
      group.events.forEach(evt => {
        if (evt.artistas) {
          evt.artistas.split(/,+/).forEach(a => {
            const cleanA = a.trim().toLowerCase();
            if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') artistsSet.add(cleanA);
          });
        }
        if (evt.disenador) {
          const cleanD = evt.disenador.trim().toLowerCase();
          if (cleanD && cleanD !== 'desconocido') designersSet.add(cleanD);
        }
        if (evt.organiza) {
          const cleanP = evt.organiza.trim().toLowerCase();
          if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') promotersSet.add(cleanP);
        }
      });

      // Update TagWithLink components inside side panel
      const sideEventsVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Eventos"] .tag-count-val');
      if (sideEventsVal) sideEventsVal.textContent = group.events.length;

      const sideArtistsVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Artistas"] .tag-count-val');
      if (sideArtistsVal) sideArtistsVal.textContent = artistsSet.size;

      const sideDesignersVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Diseñadores"] .tag-count-val');
      if (sideDesignersVal) sideDesignersVal.textContent = designersSet.size;

      const sidePromotersVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Promotores"] .tag-count-val');
      if (sidePromotersVal) sidePromotersVal.textContent = promotersSet.size;

      // Counts just changed digit count, which can shift each tag's natural
      // width — re-decide equal-vs-content mode (D-059/D-060).
      updateAdaptiveTagsRow('side-panel-tags-container');

      // Reconstruir la lista con EXACTAMENTE los mismos eventos que ya están
      // pintados hace que sus fotos se descarguen otra vez: desaparecen un
      // instante y vuelven. Se ve al volver de un evento, justo cuando el panel
      // termina de subir, porque al restaurar la página la lista ya venía bien
      // y aun así se rehacía entera. La firma va en un data-* del propio
      // contenedor para que sobreviva a la restauración del DOM.
      const listContainer = document.getElementById('side-panel-event-list');
      const firmaLista = group.events.map(e => e.idMel).join(',');
      if (listContainer.dataset.firmaLista === firmaLista && listContainer.children.length) return;
      listContainer.dataset.firmaLista = firmaLista;
      listContainer.innerHTML = '';

      group.events.forEach((evt, idx) => {
        // `shrink-0`: el panel es una columna flex de alto acotado y sin esto las
        // filas se encogen (trampa nº6 del traspaso).
        const card = buildEventCardList(evt, {
          showDivider: idx < group.events.length - 1,
          extraClass: 'shrink-0',
        });

        // `pointerenter` no existe en un móvil: no hay puntero que entre en nada,
        // se toca y ya. La precarga solo llegaba a escritorio, y por eso allí la
        // ficha aparecía al instante y en el teléfono se notaba la espera.
        // `touchstart` ocurre al posar el dedo, unos cientos de milisegundos
        // antes de que se suelte: justo el margen que hace falta para adelantarla.
        ['pointerenter', 'touchstart'].forEach((evento) => card.addEventListener(evento, () => {
          prefetchEventUrl(evt.idMel, { location: evt.lugar });
        }, { once: true, passive: true }));
        card.addEventListener('click', () => {
          // Al entrar desde el panel, Anterior/Siguiente queda acotado a los
          // eventos DE ESE LOCAL, en el mismo orden en que se ven en el panel.
          // `group.events` sale de `filtered`, así que ya arrastra el rango de
          // años, la búsqueda activa y el orden de la secuencia — no hay que
          // reordenarlo aquí (antes se forzaba cronológico y la navegación no
          // coincidía con lo que el visitante acababa de ver en la lista).
          try {
            sessionStorage.setItem('mel-active-nav-sequence', JSON.stringify(group.events.map(x => x.idMel)));
          } catch (e) {}
          navigateToEvent(evt.idMel, { location: evt.lugar });
        });
        listContainer.appendChild(card);
      });
    };

    // Un repoblado inmediato deja sin sentido cualquier auto-apertura diferida
    // que siguiera pendiente (D-078 la retrasa 1s para que el mapa encuentre el
    // sitio ANTES de que el panel se deslice encima). Al volver de un evento
    // abierto desde el propio panel se daban las dos: el panel abría enseguida
    // y, un segundo después, el temporizador lo repoblaba otra vez — que es el
    // parpadeo de "desaparece y vuelve a aparecer".
    if (window._melAutoOpenTimeout) {
      clearTimeout(window._melAutoOpenTimeout);
      window._melAutoOpenTimeout = null;
    }

    // El fundido existe para CAMBIAR de local (el contenido se sustituye por
    // otro distinto). Repoblar el mismo local — cosa que pasa en cada
    // re-render: arrastrar el slider, filtrar, volver de un evento — debe
    // actualizar en silencio, sin parpadear ni re-encuadrar la cámara.
    const sameLocation = sidePanel.dataset.locName === group.locationName;

    if (isAlreadyOpen && sameLocation) {
      updateSidePanelDOM();
      sidePanel.style.opacity = '1';
    } else if (isAlreadyOpen) {
      // Fade out content first, update DOM, and fade back in
      sidePanel.style.opacity = '0';
      setTimeout(() => {
        updateSidePanelDOM();
        sidePanel.style.opacity = '1';
        if (googleMap) {
          googleMap.panTo(group.coords); // panTo animates smoothly on its own
        }
      }, 150);
    } else {
      // Update and open dynamically, pushing the map (desktop) or sliding up
      // as a bottom sheet (móvil, ver media query de #map-side-panel).
      updateSidePanelDOM();
      sidePanel.style.opacity = '1';
      if (delayOpen > 0) {
        // Defer the CSS slide-in so the map has time to pan/zoom into view
        // before the panel slides over it (D-085 auto-open-from-location path).
        setTimeout(() => setSidePanelOpenState(true), delayOpen);
        // Re-measure tags once the panel has finished its width transition
        // (300ms slide-in CSS + delayOpen offset).
        setTimeout(() => updateAdaptiveTagsRow('side-panel-tags-container'), delayOpen + 310);
      } else {
        setSidePanelOpenState(true);
        // The panel animates its width in over 300ms (opening from 0 on
        // desktop, D-026's push-the-map transition) — the tags row's initial
        // measurement above ran against that stale (still-collapsing) width,
        // so re-decide once the transition has settled.
        setTimeout(() => updateAdaptiveTagsRow('side-panel-tags-container'), 310);
      }
      // Camera starts moving immediately — it animates smoothly on its own,
      // so the map glides into place WHILE the panel opens instead of
      // jumping once it already has. Keeping the map's own tiles in step
      // with the panel's width transition is handled by the ResizeObserver
      // set up in createGoogleMapInstance() (D-075), not by a timer here.
      if (googleMap) googleMap.panTo(group.coords);
    }
  }

  function fitMapToMarkers() {
    if (!googleMap || mapMarkers.length === 0) return;
    const bounds = new google.maps.LatLngBounds();
    mapMarkers.forEach(m => {
      if (m.position) {
        bounds.extend(m.position);
      }
    });

    // A single marker (or several stacked on the same spot) makes a
    // zero-area bounds, which fitBounds() would zoom into as far as it
    // can go. We used to correct that with a one-time 'idle' listener
    // added after the fact — but with searches/filters calling this on
    // every keystroke, several of those could pile up unfired and then
    // all fire together on some later, unrelated zoom (e.g. opening a
    // cluster), stomping it back down to 15. Checking synchronously up
    // front avoids ever needing that listener.
    const ne = bounds.getNorthEast();
    const sw = bounds.getSouthWest();
    if (ne.equals(sw)) {
      googleMap.setCenter(ne);
      googleMap.setZoom(15);
    } else {
      // Padding de seguridad en fitBounds para evitar que el globo/badge de los
      // marcadores más al norte (ej: Valdepiélago, que se extiende ~40px hacia arriba
      // desde sus coordenadas lat/lng) quede recortado en el borde superior del mapa.
      // Y desde D-168 hay que sumarle lo que ocupa el InfoBanner, que va
      // SUPERPUESTO al mapa y por tanto le come franja por arriba: su alto real
      // (0 si está oculto porque no falta ningún evento) más 24 de aire, el mismo
      // criterio que ya se usó para el globo. Sin esto, el banner tapaba el
      // marcador más al norte.
      const bannerEl = document.getElementById('info-banner');
      const altoBanner = bannerEl && getComputedStyle(bannerEl).display !== 'none'
        ? Math.round(bannerEl.getBoundingClientRect().height)
        : 0;
      googleMap.fitBounds(bounds, {
        top: 80 + (altoBanner ? altoBanner + 24 : 0),
        bottom: 40,
        left: 80,
        right: 80
      });
    }
  }

  // Previously stepped zoom one whole level at a time, waiting ~120ms between
  // each 'zoom_changed' — each step reloaded a fresh set of raster tiles, so
  // it always read as a series of snaps rather than continuous motion. This
  // map's custom Map ID renders as a vector map, which can display *fractional*
  // zoom levels smoothly — so instead we drive the camera every animation
  // frame with an eased, continuously-interpolated zoom (and, optionally,
  // center) between the start and target, which the vector renderer can
  // actually animate. Centering and zooming happen in the SAME loop (instead
  // of a separate panTo() fired first) so the map doesn't jump to the target
  // instantly before the zoom even starts.
  let zoomAnimFrame = null;
  function smoothZoomTo(targetZoom, targetCenter, duration = 550) {
    if (zoomAnimFrame) cancelAnimationFrame(zoomAnimFrame);
    const startZoom = googleMap.getZoom();
    const startCenterObj = googleMap.getCenter();
    const startCenter = { lat: startCenterObj.lat(), lng: startCenterObj.lng() };
    const endCenter = targetCenter
      ? {
          lat: typeof targetCenter.lat === 'function' ? targetCenter.lat() : targetCenter.lat,
          lng: typeof targetCenter.lng === 'function' ? targetCenter.lng() : targetCenter.lng,
        }
      : startCenter;
    const zoomDelta = targetZoom - startZoom;
    const centerDelta = { lat: endCenter.lat - startCenter.lat, lng: endCenter.lng - startCenter.lng };
    if (Math.abs(zoomDelta) < 0.01 && Math.abs(centerDelta.lat) < 1e-9 && Math.abs(centerDelta.lng) < 1e-9) return;
    const startTime = performance.now();
    const ease = t => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2); // ease-in-out-cubic — softer landing than the quad curve used before

    const step = (now) => {
      const t = Math.min(1, (now - startTime) / duration);
      const e = ease(t);
      googleMap.moveCamera({
        center: { lat: startCenter.lat + centerDelta.lat * e, lng: startCenter.lng + centerDelta.lng * e },
        zoom: startZoom + zoomDelta * e,
      });
      // Force the clusterer to re-group against the in-progress viewport on
      // every frame, so members that are far enough apart at the current
      // (still-animating) zoom level visually break out of the bubble as
      // soon as that happens, instead of only once the camera motion fully
      // settles and the map's own 'idle' event fires at the very end.
      if (googleMapClusterer) googleMapClusterer.render();
      zoomAnimFrame = t < 1 ? requestAnimationFrame(step) : null;
    };
    zoomAnimFrame = requestAnimationFrame(step);
  }

  function updateMapMarkers(shouldFitBounds = true) {
    if (!googleMap || !markerLib) return;

    // Kept comfortably above any cluster's zIndex (MAX_ZINDEX + count, where
    // count is a small number of events) so the active marker always renders
    // on top of cluster bubbles too.
    const ACTIVE_MARKER_ZINDEX = Number(google.maps.Marker.MAX_ZINDEX) + 1000000;


    // Get currently filtered archives
    const filtered = archives.filter(item => {
      const yr = getYear(item.fecha);
      const yearMatch = yr >= minYear && yr <= maxYear;
      const searchMatch = coincideConLaBusqueda(item, normalizarParaBuscar(searchQuery));
      return yearMatch && searchMatch;
    });

    // Group by location key for clustering (using item.coordenadas!)
    const locationGroups = {};
    filtered.forEach(item => {
      const coords = parseCoords(item.coordenadas, item.localidad);
      if (!coords) return;
      // Round coords to group nearby points
      const locKey = `${coords[0].toFixed(4)},${coords[1].toFixed(4)}`;
      if (!locationGroups[locKey]) {
        locationGroups[locKey] = {
          coords: { lat: coords[0], lng: coords[1] },
          locationName: item.lugar || item.localidad || 'Lugar desconocido',
          events: []
        };
      }
      locationGroups[locKey].events.push(item);
    });

    // El panel del mapa SIEMPRE lista sus eventos en orden cronológico, al
    // margen de la secuencia activa de la sesión (aleatoria, o la columna
    // elegida en Lista): leer la historia de un local tiene sentido de más
    // antiguo a más reciente, no barajada. Como la navegación acotada al panel
    // toma su vector de este mismo array, Anterior/Siguiente dentro de un local
    // también avanza cronológicamente — que es justo lo que se ve en la lista.
    Object.values(locationGroups).forEach(g => {
      g.events.sort((a, b) => fechaAMs(a.fecha) - fechaAMs(b.fecha));
    });

    // Auto-open side panel if loading with a ?location= parameter matching a
    // specific place name (e.g. the "Lugar" tag on event/[id].astro). Only
    // ?location= is used for this match — NOT ?search=, which is a plain
    // text search and shouldn't have the side effect of popping the map
    // panel open just because someone searched a term that happens to equal
    // a place name (this used to fall back to ?search= too, which is also
    // why the panel could get stuck open with no way to close: the close
    // button only ever cleared ?location=).
    const params = new URLSearchParams(window.location.search);
    const urlView = params.get('view');
    const urlLocation = params.get('location');
    let justAutoOpened = false;
    if (urlView === 'mapa' && !activeSidePanelKey) {
      const matchName = (urlLocation || '').toLowerCase().trim();
      if (matchName) {
        const matchKey = Object.keys(locationGroups).find(key => {
          return locationGroups[key].locationName.toLowerCase() === matchName;
        });
        if (matchKey) {
          activeSidePanelKey = matchKey;
          justAutoOpened = true;
        }
      }
    }

    // Update or hide side panel dynamically based on filtered data.
    if (activeSidePanelKey && locationGroups[activeSidePanelKey]) {
      // Pan/zoom the camera to the matched place so arriving via a "Lugar"
      // link is visibly "the map finds this place, THEN the panel opens" —
      // not just a panel that's silently already open on load. Only for the
      // just-matched case (justAutoOpened): a location the visitor already
      // had open before this render (e.g. still on ?location= from an
      // earlier auto-open) shouldn't re-snap the camera/re-delay on every
      // re-render.
      // Volviendo de un evento: el panel estaba abierto y debe seguir estándolo,
      // sin coreografía. La cámara se coloca sin animación y el panel se puebla
      // en el acto, en vez de recorrer el viaje de "el mapa encuentra el sitio
      // y ENTONCES abre el panel", que es para llegar desde una tag de "Lugar".
      let volviendoAlPanel = null;
      try {
        volviendoAlPanel = sessionStorage.getItem('mel-volviendo-al-panel');
        if (volviendoAlPanel) sessionStorage.removeItem('mel-volviendo-al-panel');
      } catch (e) {}

      if (justAutoOpened && volviendoAlPanel && googleMap) {
        googleMap.setCenter(locationGroups[activeSidePanelKey].coords);
        googleMap.setZoom(15);
        populateSidePanel(locationGroups[activeSidePanelKey]);
      } else if (justAutoOpened && googleMap) {
        googleMap.setCenter(locationGroups[activeSidePanelKey].coords);
        googleMap.setZoom(15);
        // Store the timeout ID so initHomePage can cancel it if it re-runs
        // (e.g. a second astro:page-load) before this fires — otherwise the
        // panel opens with a dead AbortController and no close listener.
        window._melAutoOpenTimeout = setTimeout(() => {
          window._melAutoOpenTimeout = null;
          populateSidePanel(locationGroups[activeSidePanelKey], 300);
        }, 1000);
      } else {
        // Esta rama existe para resincronizar el panel cuando cambian los
        // filtros. Si lo que tocaría pintar es EXACTAMENTE lo que ya se ve, no
        // hay nada que hacer: rehacer la lista y relanzar el reparto de tags se
        // ve como un parpadeo. Al volver de un evento abierto desde el panel
        // ocurría dos veces —medido a los 5ms y otra vez a los 1958ms—, la
        // segunda cuando el mapa termina de cargar y vuelve a pasar por aquí
        // con `?location=` todavía en la URL.
        const grupo = locationGroups[activeSidePanelKey];
        const panelEl = document.getElementById('map-side-panel');
        const firma = grupo.locationName + '|' + grupo.events.map(e => e.idMel).join(',');
        const yaPintado = panelEl
          && panelEl.classList.contains('side-panel-open')
          && panelEl.dataset.firmaPanel === firma;
        if (!yaPintado) populateSidePanel(grupo);
      }
    } else {
      activeSidePanelKey = null;
      const sidePanel = document.getElementById('map-side-panel');
      if (sidePanel) {
        setSidePanelOpenState(false);
        if (googleMap) {
          setTimeout(() => {
            google.maps.event.trigger(googleMap, "resize");
          }, 310);
        }
      }
    }

    // Diff against the previous marker set instead of tearing every pin down
    // and rebuilding from scratch: dragging the date slider fires this on
    // every 'input' event, and destroying+recreating all markers each time
    // made them all flash away and reappear just to update a count. Now an
    // existing location's pin is only ever mutated in place (label text,
    // active state) — only locations that actually gained or lost their last
    // matching event are added to or removed from the map.
    const newKeys = new Set(Object.keys(locationGroups));

    const toAddToClusterer = [];
    const toRemoveFromClusterer = [];
    const activeEntries = [];
    const toExit = [];

    for (const [locKey, entry] of locationMarkers) {
      if (!newKeys.has(locKey)) {
        // Se anota AQUÍ si el pin estaba a la vista, antes de que los lotes
        // del clusterer (removeMarkers) le pongan `map` a null: un miembro
        // plegado dentro de un cluster tiene `map` null y NADIE lo ha visto
        // nunca — hacerle el desvanecido de salida lo materializaba de la
        // nada durante 150ms justo cuando su grupo perdía la cifra (el
        // "marcador que se va" que veía el propietario, D-250).
        entry.eraVisible = !!entry.marker.map;
        if (entry.inClusterer && googleMapClusterer) toRemoveFromClusterer.push(entry.marker);
        toExit.push(entry);
        locationMarkers.delete(locKey);
      }
    }

    Object.keys(locationGroups).forEach(locKey => {
      const group = locationGroups[locKey];
      const count = group.events.length;
      const isActive = activeSidePanelKey === locKey;
      let entry = locationMarkers.get(locKey);

      if (!entry) {
        const markerContent = document.createElement('div');
        markerContent.className = 'mel-marker-wrapper';
        markerContent.innerHTML = `
          <div class="mel-marker-body text-marker">
            <span class="mel-marker-label"></span>
          </div>
          <div class="mel-marker-pointer"></div>
          <div class="mel-marker-shadow"></div>
        `;

        const marker = new markerLib.AdvancedMarkerElement({
          position: group.coords,
          content: markerContent,
          title: group.locationName
        });
        // La clave viaja con el marcador: clusterRenderer la necesita para
        // saber si una burbuja recreada continúa un grupo visible (D-250).
        marker.melLocKey = locKey;

        // Add click listener to show the details Side Panel. El marcador es un
        // interruptor: si el panel ya está abierto en ESTE local, volver a
        // pulsarlo lo cierra (mismo camino que el resto de cierres, para que
        // limpie ?location= y devuelva el marcador a reposo). Pulsar OTRO
        // marcador con el panel abierto sigue cambiando de local, no cerrando.
        marker.addListener("click", () => {
          if (activeSidePanelKey === locKey) {
            if (window._melClosePanelHandler) window._melClosePanelHandler();
            return;
          }
          activeSidePanelKey = locKey;
          // populateSidePanel() itself calls panTo() to smoothly recenter on
          // this marker — no separate zoom change here, just the pan.
          populateSidePanel(group);
          updateMapMarkers(false); // Redraw map to update the active marker's state without resetting bounds!
        });

        entry = { marker, group, inClusterer: false };
        locationMarkers.set(locKey, entry);
      }

      entry.group = group;
      entry.marker.eventCount = count;
      const label = entry.marker.content.querySelector('.mel-marker-label');
      if (label) label.textContent = `${group.locationName} (${count})`;
      entry.marker.content.classList.toggle('active', isActive);

      // The active marker is pulled out of the clusterer entirely and placed
      // directly on the map with a very high zIndex — so it never gets
      // folded back into a cluster bubble on zoom-out, and always renders
      // above every other pin/cluster. Everything else stays managed by the
      // clusterer as usual. The actual map/zIndex assignment for active
      // markers happens in a pass AFTER the clusterer batch calls below —
      // removeMarkers()/addMarkers() reset a marker's own .map internally,
      // which would otherwise clobber this right after we set it.
      if (isActive) {
        if (entry.inClusterer && googleMapClusterer) {
          toRemoveFromClusterer.push(entry.marker);
          entry.inClusterer = false;
        }
        activeEntries.push(entry);
      } else if (!entry.inClusterer) {
        // Explícito y no `null` (D-230): dejarlo en null delega el orden en
        // Google —que de hecho ya ordena por posición— pero entonces conviven
        // dos escalas distintas, la suya y la nuestra para clusters/activo, y
        // no son comparables entre sí. Con la misma función para todos, el
        // orden es uno solo y predecible.
        entry.marker.zIndex = zIndexPorLatitud(entry.marker.position);
        entry.marker.map = null;
        toAddToClusterer.push(entry.marker);
        entry.inClusterer = true;
      }
    });

    if (googleMapClusterer) {
      const topologyChanged = toRemoveFromClusterer.length > 0 || toAddToClusterer.length > 0;
      if (topologyChanged) {
        // A location actually entered or left the clusterer's pool — the
        // library's render() recomputes the whole clustering index from
        // scratch (it's not incremental), so every bubble on screen gets
        // torn down and recreated here, not just the one that changed. That's
        // unavoidable when membership genuinely changes, but see below for
        // the (much more common, e.g. every slider drag tick) case where it
        // doesn't.
        if (toRemoveFromClusterer.length > 0) googleMapClusterer.removeMarkers(toRemoveFromClusterer, true);
        if (toAddToClusterer.length > 0) googleMapClusterer.addMarkers(toAddToClusterer, true);
        googleMapClusterer.render();
      } else {
        // Nothing joined or left any cluster this cycle — only member counts
        // changed (e.g. dragging the date slider while every matching
        // location still has at least one event). Skip render() entirely
        // and just refresh each existing bubble's own number in place, so
        // clusters don't visibly fall apart and reform for no topological
        // reason — only once a cluster actually needs to gain/lose a member.
        (googleMapClusterer.clusters || []).forEach(cluster => {
          if (!cluster.marker || !cluster.markers || cluster.markers.length <= 1) return;
          const sum = cluster.markers.reduce((s, m) => s + (m.eventCount || 1), 0);
          const label = cluster.marker.content && cluster.marker.content.querySelector('.mel-marker-label');
          // El `+` tiene que estar AQUÍ además de en clusterRenderer: son los dos
          // sitios que escriben esta etiqueta y este reescribe la del otro cada
          // vez que un grupo gana o pierde un miembro. Con el `+` solo en el
          // renderer, desaparecía al reagrupar — un fallo intermitente de los
          // que cuestan una tarde. Si cambias el formato, cámbialo en los dos
          // (aquí va como `prefix` de animateValue, D-250).
          if (label) {
            const actual = parseInt((label.textContent || '').replace(/[^0-9]/g, ''), 10);
            if (Number.isFinite(actual) && actual !== sum) {
              // El rodillo de las tags de la cabecera, en vez del cambio seco.
              animateValue(label, actual, sum, 250, '+');
            } else if (!Number.isFinite(actual)) {
              label.textContent = '+' + sum;
            }
          }
          // La memoria de continuidad también se actualiza por aquí: si no,
          // el siguiente reagrupado rodaría desde una cifra atrasada.
          cluster.markers.forEach(m => { if (m.melLocKey) ultimaCifraDeCluster.set(m.melLocKey, sum); });
        });
      }
    }

    activeEntries.forEach(entry => {
      // Misma regla que el resto (D-230): manda la posición en pantalla. El
      // marcador activo ya no se sube por encima de todo — su sombra tapaba
      // pines más al sur. Si al usarlo resulta que el activo se queda tapado
      // y molesta, la salida acordada con el propietario NO es volver a
      // subirle el zIndex, sino distinguirlo de otra forma (tamaño, zoom).
      entry.marker.zIndex = zIndexPorLatitud(entry.marker.position);
      entry.marker.map = googleMap;
    });

    // Markers whose location no longer matches the filter don't just vanish —
    // removeMarkers() above already pulled them out of the clusterer's index,
    // but here we place them directly on the map (bypassing the clusterer) so
    // their own fade-out animation (the .exiting class) actually gets to play
    // before they're removed from the map for good.
    toExit.forEach(entry => {
      // Solo se desvanece lo que estaba A LA VISTA. Un miembro plegado en un
      // cluster se va sin ceremonia: su despedida visual es la cifra del
      // grupo bajando (el rodillo de D-250), no un pin materializándose.
      if (!entry.eraVisible) {
        entry.marker.map = null;
        return;
      }
      // Los que se van sí se dejan por encima mientras dura su desvanecido
      // (150ms): es un estado transitorio, no compite por el orden estable.
      entry.marker.zIndex = ACTIVE_MARKER_ZINDEX;
      entry.marker.map = googleMap;
      entry.marker.content.classList.add('exiting');
      setTimeout(() => {
        entry.marker.map = null;
      }, 150);
    });

    mapMarkers = Array.from(locationMarkers.values(), entry => entry.marker);
    _s.mapMarkers = mapMarkers;

    // Reordenar también aquí y no solo en `idle` (D-242): filtrar o buscar
    // cambia QUÉ marcadores hay sin mover la cámara, así que `idle` no llega
    // a dispararse y los nuevos se quedarían con el orden de latitud. En el
    // fotograma siguiente, para que ya tengan caja que medir.
    //
    // Y una SEGUNDA pasada más tarde (D-250): una burbuja recién creada por
    // el clusterer puede no tener caja todavía en ese primer fotograma —
    // reordenarMarcadoresPorPantalla() descarta las cajas con alto 0 — y se
    // quedaba con su z de latitud (~47000) frente a los 1000+i del resto:
    // un cluster que subía de cifra se plantaba por delante de todos, con
    // sombra y todo, hasta el siguiente movimiento de cámara. Es la rendija
    // entre "el marcador existe" y "el marcador mide"; la segunda pasada es
    // idempotente y barata (7-8 cajas).
    requestAnimationFrame(reordenarMarcadoresPorPantalla);
    setTimeout(reordenarMarcadoresPorPantalla, 150);

    // Auto-fit bounds of the Google Map ONLY if the map view is active/visible
    // and the caller actually wants it (callers that are about to apply
    // their own pan/zoom, e.g. opening or closing a marker's panel, pass
    // false so they don't race against this fit).
    const mapContainer = document.getElementById('view-mapa');
    if (shouldFitBounds && mapContainer && !mapContainer.classList.contains('hidden')) {
      fitMapToMarkers();
    }
  }

  // -------------------------------------------------------
  // initHomePage — re-runs on every astro:page-load
  // -------------------------------------------------------
  // Adaptive TagWithLink row (D-059/D-060): decides between the "equal
  // width" grid mode (default, Figma 341:26425 — every highlight-unit the
  // same width) and the "content-sized" flex fallback (each unit hugs its
  // own content, row bleeds+scrolls right) by REAL measurement, not a
  // fixed breakpoint. Generic over the number of units (the CSS uses
  // grid-auto-columns, not a hardcoded column count) and over whether the
  // row shares its line with another element (a Toggle, say) via
  // `opts.getReservedWidth` — pass it when there's a sibling to negotiate
  // space with, omit it for a row that's always alone (event detail tags,
  // map side panel). Duplicated by hand into event/[id].astro's own
  // <script> (AGENTS.md rule 7 — no shared client JS module system here).
  const ADAPTIVE_ROW_GAP = 32; // between highlight-units, in either mode

  function updateAdaptiveTagsRow(rowId, opts = {}) {
    const row = document.getElementById(rowId);
    if (!row) return;
    const container = opts.containerId ? document.getElementById(opts.containerId) : row.parentElement;
    if (!container) return;

    // 1. Force content-sized mode first — this is the only state in which
    // each highlight-unit's rendered width reliably reflects its own
    // natural (max-content) size, unaffected by any grid-equal sizing
    // this function may have applied on an earlier tick.
    row.classList.remove('highlights-grid-equal');
    row.classList.add('highlights-flex-content');
    row.style.width = '';

    const units = [...row.querySelectorAll('.highlight-unit')];
    if (!units.length) return;
    const naturalWidths = units.map(u => u.getBoundingClientRect().width);
    const maxNatural = Math.max(...naturalWidths);
    // Hard cap per highlight-unit is 176px (D-061 / global.css). The bar for
    // the share test skips any unit whose value is ALREADY ellipsised at that
    // cap: such a unit renders cut in BOTH modes, so letting it set the bar
    // only blocked the equal layout for the whole row and left dead space at
    // the right in exchange for nothing (D-099). The test is the value's own
    // overflow, not "is it 176px wide" — a unit that happens to measure 175.9
    // and fits perfectly must still count, and a width comparison with a
    // tolerance gets that wrong in one direction or the other.
    const stillFits = units.filter(u => {
      const val = u.querySelector('.tag-count-val');
      return !val || val.scrollWidth <= val.clientWidth + 1;
    }).map(u => u.getBoundingClientRect().width);
    const barAlone = stillFits.length ? Math.max(...stillFits) : Math.min(maxNatural, 176);
    // Sharing a line is the asymmetric case: guessing "yes" wrongly bumps the
    // Toggle onto a second line (D-091, a real bug), while guessing wrongly
    // when alone costs nothing but a slightly narrower column. So the sharing
    // branch keeps the conservative bar — which also closes the window where
    // fallback fonts make SOME units overflow and not others, dropping the
    // bar mid-load only to raise it again on fonts.ready.
    const effectiveMaxNatural = Math.min(maxNatural, 176);
    // Content width, not border box: some of these containers carry their own
    // side padding (the map side panel's is px-6/sm:px-12/lg:px-6), and the
    // border box hands the row up to 96px it does not have — it would go
    // equal-width on a share that does not exist and overflow the columns.
    const cs = getComputedStyle(container);
    const containerWidth = container.clientWidth
      - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);

    // 2. Would an equal share still fit each unit's own content if the
    // row shares its line with whatever opts.getReservedWidth() reserves
    // (e.g. a Toggle + the gap to it)? Skipped entirely when there's
    // nothing to share with (reserved === 0) — falls straight through to
    // the "alone" check below, which is then just the same math against
    // the row's own full container width.
    const reserved = opts.getReservedWidth ? opts.getReservedWidth(containerWidth) : 0;
    if (reserved > 0) {
      const spaceIfSharing = containerWidth - reserved;
      const equalShareIfSharing = (spaceIfSharing - ADAPTIVE_ROW_GAP * (units.length - 1)) / units.length;
      if (equalShareIfSharing >= effectiveMaxNatural) {
        row.classList.remove('highlights-flex-content');
        row.classList.add('highlights-grid-equal');
        row.style.width = `${spaceIfSharing}px`;
        return true;
      }
    }

    // 3. Sharing doesn't work (or there's nothing to share with) — would
    // an equal share of the FULL container width work once any sibling
    // has wrapped away (native flex-wrap resolves that on its own, purely
    // from the row's rendered width no longer leaving it room)?
    const equalShareAlone = (containerWidth - ADAPTIVE_ROW_GAP * (units.length - 1)) / units.length;
    if (equalShareAlone >= barAlone) {
      row.classList.remove('highlights-flex-content');
      row.classList.add('highlights-grid-equal');
      row.style.width = '100%';
      return false;
    }

    // 4. Neither fits — stay in content-sized mode (already applied in
    // step 1): each unit keeps its own natural width, and the row bleeds
    // + scrolls past the right edge instead of compressing anything
    // unreadable.
    return false;
  }

  function initHomePage() {
    // astro:page-load también dispara en OTRAS páginas tras una navegación
    // suave: los listeners viven en `document` y sobreviven al salto, aunque
    // el script de esta página ya no se vuelva a evaluar. Casi todo lo de
    // abajo se auto-protege buscando elementos que allí no existen, pero
    // readReturnState() no: consumía (y borraba) el estado de vuelta nada
    // más aterrizar en la ficha del evento, justo después de guardarlo, así
    // que al cerrar ya no quedaba nada que restaurar.
    if (!document.getElementById('gallery-grid')) return;

    // Let the gallery replay its first-load entrance animation for whichever
    // render actually settles out of the several that happen synchronously
    // below (slider init, the search box's own startup dispatch...) — see
    // the flag's declaration for why this can't just live in
    // bindInitialCardClicks().
    gallerySettled = false;
    isFirstDOMUpdate = true;

    // Red de seguridad: si el estado llega vacío (p. ej. una carga en la que la
    // hoja no respondió), se repuebla desde lo que sí haya servido el SSR.
    if (!_s.archives || _s.archives.length === 0) {
      _s.archives = [...initialArchives];
      _s.filtered = [...initialArchives];
    }

    // Re-sync local aliases from persisted state
    archives           = _s.archives;
    filtered           = _s.filtered;
    minYear            = _s.minYear;
    maxYear            = _s.maxYear;
    searchQuery        = _s.searchQuery;
    activeSidePanelKey = _s.activeSidePanelKey;
    currentPage        = _s.currentPage;
    currentSortCol     = _s.currentSortCol;
    currentSortDir     = _s.currentSortDir;
    ABSOLUTE_MIN_YEAR  = _s.ABSOLUTE_MIN_YEAR;
    ABSOLUTE_MAX_YEAR  = _s.ABSOLUTE_MAX_YEAR;
    googleMap          = _s.googleMap;
    mapMarkers         = _s.mapMarkers;
    locationMarkers    = _s.locationMarkers;
    mapInitialized     = _s.mapInitialized;
    mapContainerEl     = _s.mapContainerEl;
    mapCore            = _s.mapCore;
    markerLib          = _s.markerLib;
    googleMapClusterer = _s.googleMapClusterer;

    // Re-query all DOM element refs
    sliderMin  = document.getElementById('slider-min');
    sliderMax  = document.getElementById('slider-max');
    minHandle  = document.getElementById('min-handle');
    maxHandle  = document.getElementById('max-handle');
    minVal     = minHandle ? minHandle.querySelector('span') : null;
    maxVal     = maxHandle ? maxHandle.querySelector('span') : null;
    activeFill = document.getElementById('slider-active-fill');

    btnPrevPage      = document.getElementById('btn-prev-page');
    btnNextPage      = document.getElementById('btn-next-page');
    paginationNumbers = document.getElementById('pagination-numbers');

    viewBtns      = document.querySelectorAll('.toggle-btn');
    viewPanels    = document.querySelectorAll('.view-panel');
    activeIndicator = document.getElementById('toggle-active-indicator');

    // Abort any previous window listeners to prevent duplicates across page transitions
    if (window._melAbortCtrl) window._melAbortCtrl.abort();
    window._melAbortCtrl = new AbortController();
    const wSig = window._melAbortCtrl.signal;

    // Cancel any pending auto-open timeout from a previous init cycle.
    // If initHomePage runs again (e.g. a second astro:page-load during a View
    // Transition) before the 1000ms auto-open fires, the timeout would open
    // the panel with a dead AbortController, leaving the close button without
    // a listener. Cancelling it here prevents that race condition.
    if (window._melAutoOpenTimeout) {
      clearTimeout(window._melAutoOpenTimeout);
      window._melAutoOpenTimeout = null;
    }

    // En la segunda pasada de initHomePage() la vuelta ya está viva y este
    // reseteo la pisaría, que es la segunda ronda de 32 → 50 que se veía.
    if (!restaurandoVuelta()) galleryVisibleCount = PAGE_SIZE;

    const galleryViewRoot = document.getElementById('view-galería');
    if (sentinelObserver) sentinelObserver.disconnect();
    sentinelObserver = null;
    const gallerySentinel = document.getElementById('gallery-sentinel');
    if (galleryViewRoot && gallerySentinel) {
      // rootMargin inferior generoso = precarga: el siguiente lote se pide
      // ~1200px antes de que el usuario llegue al final de la rejilla.
      sentinelObserver = new IntersectionObserver((entries) => {
        if (entries.some(e => e.isIntersecting)) appendGalleryBatch();
      }, { root: galleryViewRoot, rootMargin: '0px 0px 1200px 0px' });
      sentinelObserver.observe(gallerySentinel);
    }

    // Al cambiar el ancho de columna todos los row-span quedan viejos:
    // recalcula en bloque (una sola lectura de ancho, luego solo escrituras),
    // coalescido por rAF para no medir en cada evento de resize.
    let galleryResizePending = false;
    window.addEventListener('resize', () => {
      if (galleryResizePending) return;
      galleryResizePending = true;
      requestAnimationFrame(() => {
        galleryResizePending = false;
        syncSheetTop(); // el top del bottom sheet depende de la posición del slider
        const cards = document.querySelectorAll('#gallery-grid .gallery-item');
        if (cards.length) {
          const colWidth = cards[0].clientWidth;
          cards.forEach(card => sizeGalleryCard(card, colWidth));
        }
        const sidePanel = document.getElementById('map-side-panel');
        if (sidePanel && sidePanel.classList.contains('side-panel-open')) {
          updateAdaptiveTagsRow('side-panel-tags-container');
        }
      });
    }, { signal: wSig });

    // Home toolbar specifically: the Toggle's own target width if it had
    // room is capped at 4/12 grid columns (same formula as the map side
    // panel, D-026 — 4 cols with a 24px gap out of 12 cols/11 gaps total,
    // hence -264/3+72), but never below its 320px floor even when that
    // exceeds the cap — and that cap ONLY applies while it's actually
    // sharing the line with the tags row (toggled via .toggle-shares-line):
    // once it wraps onto its own line, it should fill the FULL width
    // instead, same padding as everything else on the page (the propietario
    // was explicit about this), which is exactly what plain `grow` already
    // gives it once nothing is competing for space on that line.
    function updateHomeToolbarLayout() {
      const toolbar = document.getElementById('home-highlights-toolbar');
      const toggleWrapper = document.getElementById('home-toggle-wrapper');
      if (!toolbar || !toggleWrapper) return;
      const toggleOculto = toggleWrapper.classList.contains('hidden');
      const isSharing = updateAdaptiveTagsRow('home-highlights-tags', {
        containerId: 'home-highlights-toolbar',
        getReservedWidth: (toolbarWidth) => {
          if (toggleOculto) return 0;   // sin selector, el renglón es entero para las tags
          const fourColWidth = (toolbarWidth - 264) / 3 + 72;
          const toggleWidth = Math.max(320, fourColWidth);
          return toggleWidth + 24; // + the row↔Toggle gap
        },
      });
      toggleWrapper.classList.toggle('toggle-shares-line', isSharing);

      // El cálculo puede decir que caben y el navegador plegarlos igualmente.
      // El hueco reservado se calcula clavado, sin holgura: hay anchos en los
      // que tags + hueco + selector suman EXACTAMENTE el ancho disponible
      // (medido a 1190: 630 + 24 + 320 = 974) y el redondeo de subpíxel basta
      // para que `flex-wrap` se lo lleve abajo. Cuando pasaba eso, el selector
      // quedaba plegado PERO con su tope de ancho puesto: abajo y estrecho, que
      // es lo peor de las dos opciones. El propietario lo cazó entre 1170 y 1215.
      //
      // En vez de afinar la fórmula, se comprueba el resultado REAL: si han
      // acabado en renglones distintos, se le quita el tope y ocupa el ancho
      // entero, que es lo que debe hacer al plegarse. No oscila: sin tope el
      // selector es más ancho todavía, así que sigue plegado.
      const filaTags = document.getElementById('home-highlights-tags');
      let comparteDeVerdad = isSharing;
      if (isSharing && filaTags) {
        const plegado = Math.abs(toggleWrapper.getBoundingClientRect().top - filaTags.getBoundingClientRect().top) > 4;
        if (plegado) {
          toggleWrapper.classList.remove('toggle-shares-line');
          comparteDeVerdad = false;
          // Y las tags se recalculan SIN reserva. Se habían repartido dejando
          // hueco para un selector que ya no está en su renglón, así que se
          // quedaban apretadas a la izquierda con el resto de la línea vacío
          // (el propietario lo vio entre 1170 y 1260). Cuando algo se pliega a
          // su propia línea, cada línea usa el ancho entero: es el mismo caso
          // que cuando el selector está oculto, y se resuelve igual.
          updateAdaptiveTagsRow('home-highlights-tags', {
            containerId: 'home-highlights-toolbar',
            getReservedWidth: () => 0,
          });
        }
      }

      // La galería pasa a cuatro columnas en el mismo momento. Se cuelga de si
      // comparten renglón DE VERDAD, no de si el cálculo decía que cabían: a
      // 1190 el selector está plegado, así que allí tocan tres columnas.
      // Se hace aquí y no con un `:has()` en CSS porque al cambiar el ancho de
      // columna TODOS los row-span quedan viejos (regla 11): hay que volver a
      // medirlos, y así el remedido va enganchado al cambio y no a que alguien
      // se acuerde.
      const rejilla = document.getElementById('gallery-grid');
      if (rejilla && rejilla.classList.contains('galeria-cuatro') !== comparteDeVerdad) {
        rejilla.classList.toggle('galeria-cuatro', comparteDeVerdad);
        const primera = rejilla.querySelector('.gallery-item');
        const ancho = primera ? primera.clientWidth : 0;
        if (ancho) rejilla.querySelectorAll('.gallery-item').forEach(c => sizeGalleryCard(c, ancho));
      }
    }
    // filterArchives() es hermana de initHomePage, no hija: sin esta referencia
    // no puede pedir el recálculo del reparto al entrar o salir de "sin resultados".
    window._melActualizarToolbar = updateHomeToolbarLayout;

    updateHomeToolbarLayout();
    let highlightsResizePending = false;
    window.addEventListener('resize', () => {
      if (highlightsResizePending) return;
      highlightsResizePending = true;
      requestAnimationFrame(() => {
        highlightsResizePending = false;
        updateHomeToolbarLayout();
        // La tabla se estrecha con la ventana, así que hay que volver a medir
        // qué textos desbordan: el ancho de cada celda acaba de cambiar.
        medirMarquee(document.getElementById('list-table-body'));
      });
    }, { signal: wSig });

    // Every AdaptiveTagsRow's equal-vs-content decision (D-060) is measured
    // against real rendered text widths — at page-load time that's still
    // the fallback font, narrower than the real Lora serif values. Once
    // fonts actually swap in, re-measure whichever rows are live right now,
    // or a borderline case can wrap onto two lines instead of ellipsizing
    // (D-061). The map panel's row only gets re-measured if currently
    // open/visible — closed, it gets a fresh, already-settled measurement
    // whenever it's next populated.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        updateHomeToolbarLayout();
        const sidePanel = document.getElementById('map-side-panel');
        if (sidePanel && sidePanel.classList.contains('side-panel-open')) {
          updateAdaptiveTagsRow('side-panel-tags-container');
        }
      });
    }

    // Bind all event listeners
    bindSliderEvents();
    bindPaginationEvents();

    // Listen for view switcher from menu items
    window.addEventListener('mel-switch-view', (e) => {
      switchView(e.detail.view);
    }, { signal: wSig });

    // Keep the map's basemap style in sync with the site's light/dark
    // toggle. setOptions({colorScheme}) updates the property but Google
    // keeps rendering tiles from whichever scheme the map was originally
    // created with — the only way to actually see the other style is to
    // rebuild the Map instance, so do that in place, preserving the
    // current view, and rebuild the markers on it.
    window.addEventListener('mel-color-scheme-change', (e) => {
      if (!googleMap) return;
      const center = googleMap.getCenter();
      const zoom = googleMap.getZoom();
      // createGoogleMapInstance() drops the old markers/locationMarkers
      // itself (a new Map wipes its container, so the old ones are already
      // gone) — updateMapMarkers() then rebuilds every pin fresh on it.
      createGoogleMapInstance(
        e.detail.isDark ? google.maps.ColorScheme.DARK : google.maps.ColorScheme.LIGHT,
        center,
        zoom
      );
      updateMapMarkers(false);
    }, { signal: wSig });

    // Listen for search events
    window.addEventListener('mel-search', (e) => {
      searchQuery = e.detail.query.toLowerCase().trim();
      _s.searchQuery = searchQuery;
      try {
        const url = new URL(window.location.href);
        if (searchQuery) {
          url.searchParams.set('search', searchQuery);
        } else {
          url.searchParams.delete('search');
        }
        window.history.replaceState({}, '', url.toString());
      } catch (err) {
        console.warn("Unable to update URL query params", err);
      }
      // El buscador se anuncia también al arrancar, y ese anuncio llega en mitad
      // de una vuelta: por eso el reseteo entero tiene que pasar por el guard.
      reiniciarPosicion();
      filterArchives(true);

    }, { signal: wSig });

    viewBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const button = e.target.closest('.toggle-btn');
        if (button) switchView(button.dataset.view);
      });
    });

    // Bind close button for the map side panel. Rebound every page load
    // (rather than once inside initGoogleMap()) since the map itself may not
    // get rebuilt on a soft navigation back to this page — but the close
    // button is a fresh DOM node every time and needs its own listener.
    // NOTE: We deliberately do NOT use { signal: wSig } here. The close
    // button must remain functional even if initHomePage re-runs (which would
    // abort wSig), because the auto-open timeout fires 1000ms after init and
    // opens the panel asynchronously — if the AbortController was replaced
    // in between, the close button would be dead. We remove the old listener
    // manually via a stored reference instead.
    const closePanelBtn = document.getElementById('close-map-side-panel');
    const sidePanel = document.getElementById('map-side-panel');
    if (sidePanel) {
      // Se define SIEMPRE, no dentro del `if` de la X: esa X ya no existe en el
      // bottom sheet, y colgar de ella dejaba sin manejador a todo lo demás
      // (la cabecera que cierra al tocarla, el nombre/dirección del lateral).
      if (closePanelBtn && window._melClosePanelHandler) {
        closePanelBtn.removeEventListener('click', window._melClosePanelHandler);
      }
      window._melClosePanelHandler = () => {
        activeSidePanelKey = null;
        _s.activeSidePanelKey = null;
        // Cancel any pending auto-open so it can't re-open the panel
        // immediately after the user closes it.
        if (window._melAutoOpenTimeout) {
          clearTimeout(window._melAutoOpenTimeout);
          window._melAutoOpenTimeout = null;
        }
        // Drop ?location= so the auto-open check inside updateMapMarkers()
        // doesn't immediately re-match this same place and pop the panel
        // back open next time it runs.
        try {
          const url = new URL(window.location.href);
          url.searchParams.delete('location');
          window.history.replaceState({}, '', url.toString());
        } catch (e) {}
        setSidePanelOpenState(false);
        if (googleMap) {
          setTimeout(() => {
            google.maps.event.trigger(googleMap, "resize");
          }, 310);
        }
        // Return the closed marker to its resting look (via the same CSS
        // transition already used for hover — no pan/zoom at all, since the
        // user may well have moved around the map independently of this
        // marker) and back into the clusterer pool it was pulled out of
        // while active. updateMapMarkers()'s diff now treats it as any
        // other non-active marker since activeSidePanelKey is cleared.
        updateMapMarkers(false);
      };
      if (closePanelBtn) closePanelBtn.addEventListener('click', window._melClosePanelHandler);
    }

    // La cabecera del bottom sheet cierra el panel con un solo toque. Sustituye
    // a la X que había: un icono de 40px en la esquina es un objetivo pequeño
    // para un pulgar, y esta franja ocupa todo el ancho. Misma gestión manual
    // de listeners que la X, por el mismo motivo (debe sobrevivir a las
    // navegaciones suaves sin duplicarse).
    const zonaCierrePanel = document.getElementById('map-side-panel-close-zone');
    if (zonaCierrePanel && sidePanel) {
      if (window._melCloseZoneHandler) {
        zonaCierrePanel.removeEventListener('click', window._melCloseZoneHandler);
      }
      window._melCloseZoneHandler = () => {
        if (window.innerWidth >= 1024) return;   // como lateral manda el nombre/dirección
        if (window._melArrastroSheet) { window._melArrastroSheet = false; return; }
        if (window._melClosePanelHandler) window._melClosePanelHandler();
      };
      zonaCierrePanel.addEventListener('click', window._melCloseZoneHandler);
    }

    // Como panel lateral (lg+) no hay X: se cierra pulsando el nombre/dirección,
    // reutilizando el mismo manejador que la X (limpia ?location=, devuelve el
    // marcador a reposo…). Por debajo de lg no hace nada: ahí manda la X y el
    // dim. Se probó además arrastrar el panel hacia la derecha para cerrarlo,
    // desde la cabecera y desde una franja en el borde izquierdo: daba
    // problemas y se retiró — el cierre es solo el toque en la cabecera.
    //
    // Misma gestión manual de listeners que closePanelBtn: debe sobrevivir al
    // reemplazo del AbortController en cada re-init.
    const panelHeaderToggle = document.getElementById('side-panel-header-toggle');
    if (panelHeaderToggle) {
      if (window._melPanelHeaderHandler) {
        panelHeaderToggle.removeEventListener('click', window._melPanelHeaderHandler);
      }
      window._melPanelHeaderHandler = () => {
        if (window.innerWidth < 1024) return;
        if (window._melClosePanelHandler) window._melClosePanelHandler();
      };
      panelHeaderToggle.addEventListener('click', window._melPanelHeaderHandler);
    }

    // Tocar el dim (solo existe/es interactivo en móvil, ver su propia
    // media query) cierra el sheet igual que el botón de cerrar.
    // Same manual listener management as closePanelBtn — must survive
    // AbortController replacement.
    const sidePanelBackdrop = document.getElementById('map-side-panel-backdrop');
    if (sidePanelBackdrop) {
      if (window._melBackdropHandler) {
        sidePanelBackdrop.removeEventListener('click', window._melBackdropHandler);
      }
      window._melBackdropHandler = () => {
        if (window._melClosePanelHandler) window._melClosePanelHandler();
      };
      sidePanelBackdrop.addEventListener('click', window._melBackdropHandler);
    }

    // Bottom sheet en móvil: arrastrar el tirador hacia abajo lo cierra
    // (por encima de un umbral) o lo suelta de vuelta a su sitio. Solo
    // actúa bajo el breakpoint md (ver media query de #map-side-panel);
    // en escritorio el tirador ni siquiera es visible.
    // Se agarra desde CUALQUIER punto del panel, no solo desde la cabecera.
    // Dos zonas pueden entrar en conflicto porque tienen scroll propio: la
    // lista de eventos (vertical) y la fila de tags (horizontal). Cada una
    // se exime con la regla que le toca según su eje.
    const sidePanelHandle = document.getElementById('map-side-panel');
    if (sidePanelHandle && sidePanel) {
      let dragStartX = 0;
      let dragCurrentX = 0;
      let dragStartY = 0;
      let dragCurrentY = 0;
      let isDragging = false;

      const listaEventos = document.getElementById('side-panel-event-list');
      const tagsFila = document.getElementById('side-panel-tags-container');
      let desdeLista = false;
      let desdeTags = false;

      const dragMove = (e) => {
        if (!isDragging) return;
        const punto = e.touches ? e.touches[0] : e;
        const x = punto.clientX;
        const y = punto.clientY;
        // Empezando sobre la lista, el panel espera su turno: solo se lleva el
        // gesto cuando la lista no tiene ya nada que desplazar hacia arriba y
        // se está tirando hacia abajo. Así no se cierra el panel al querer
        // volver al principio de la lista.
        if (desdeLista && (listaEventos.scrollTop > 0 || y <= dragStartY)) {
          dragStartY = y;   // el arrastre útil empieza donde la lista se queda sin recorrido
          dragCurrentY = y;
          dragStartX = x;
          dragCurrentX = x;
          return;
        }
        // Empezando sobre las tags, el panel también espera: mientras el
        // gesto siga siendo más horizontal que vertical es SU scroll propio
        // (overflow-x-auto), no un intento de cerrar el sheet. Sin esto,
        // cualquier arrastre con un mínimo componente vertical —casi todos,
        // un dedo real no traza una recta— movía el panel entero a la vez
        // que se intentaban desplazar las tags, y por eso costaba tanto: la
        // fila competía con el propio gesto que la movía.
        if (desdeTags && Math.abs(x - dragStartX) >= Math.abs(y - dragStartY)) {
          dragStartY = y;
          dragCurrentY = y;
          dragStartX = x;
          dragCurrentX = x;
          return;
        }
        dragCurrentY = y;
        const delta = Math.max(0, dragCurrentY - dragStartY);
        sidePanel.style.transform = `translate3d(0, ${delta}px, 0)`;
      };
      const dragEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        // Un arrastre que no llega al umbral devuelve el panel a su sitio, pero
        // NO debe contar además como toque de cierre.
        if (Math.abs(dragCurrentY - dragStartY) > 6) window._melArrastroSheet = true;
        sidePanel.classList.remove('side-panel-dragging');
        sidePanel.style.transform = '';
        const delta = Math.max(0, dragCurrentY - dragStartY);
        // Umbral de cierre: una cuarta parte del tirón habitual de un sheet.
        if (delta > 120 && window._melClosePanelHandler) window._melClosePanelHandler();
        dragStartX = 0;
        dragCurrentX = 0;
        dragStartY = 0;
        dragCurrentY = 0;
      };
      const dragStart = (e) => {
        if (window.innerWidth >= 1024) return; // Bottom sheet solo bajo lg
        // Un gesto NUEVO no hereda la sospecha del anterior: si el de antes
        // puso el flag a true y el navegador no llegó a mandar el click
        // fantasma que lo consume (típico al hacer scroll dentro de la
        // lista), se quedaba pegado y se comía el primer toque limpio de la
        // siguiente vez — en cualquier sitio del panel, no solo en la lista.
        window._melArrastroSheet = false;
        desdeLista = !!(listaEventos && e.target && listaEventos.contains(e.target));
        desdeTags = !!(tagsFila && e.target && tagsFila.contains(e.target));
        isDragging = true;
        const punto = e.touches ? e.touches[0] : e;
        dragCurrentX = dragStartX = punto.clientX;
        dragCurrentY = dragStartY = punto.clientY;
        sidePanel.classList.add('side-panel-dragging');
      };

      // En captura, para adelantarse a los enlaces de la lista y de los tags.
      sidePanelHandle.addEventListener('click', (e) => {
        if (!window._melArrastroSheet) return;
        window._melArrastroSheet = false;
        e.stopPropagation();
        e.preventDefault();
      }, { capture: true, signal: wSig });

      sidePanelHandle.addEventListener('touchstart', dragStart, { passive: true, signal: wSig });
      sidePanelHandle.addEventListener('touchmove', dragMove, { passive: true, signal: wSig });
      sidePanelHandle.addEventListener('touchend', dragEnd, { signal: wSig });
      sidePanelHandle.addEventListener('mousedown', dragStart, { signal: wSig });
      window.addEventListener('mousemove', dragMove, { signal: wSig });
      window.addEventListener('mouseup', dragEnd, { signal: wSig });
    }

    // Register list table event delegation handler at document level (survives all DOM updates)
    if (!window._melListClickHandlerBound) {
      window._melListClickHandlerBound = true;
      document.addEventListener('click', (e) => {
        const listBody = document.getElementById('list-table-body');
        const mobileCards = document.getElementById('list-mobile-cards');
        const inTable = listBody && listBody.contains(e.target);
        const inMobileCards = mobileCards && mobileCards.contains(e.target);
        if (!inTable && !inMobileCards) return; // Only handle clicks within the list view (table or mobile cards)

        // Mobile: the whole EventCardList row is clickable, same target as
        // the table's thumbnail+title (abrirFicha navigates with the
        // current search as context, unlike the map panel's location-scoped
        // navigateToEvent()).
        if (inMobileCards) {
          const row = e.target.closest('.mobile-event-card-list');
          if (row) {
            e.stopPropagation();
            const id = row.getAttribute('data-id');
            const item = archives.find(x => x.idMel === id);
            if (item) abrirFicha(item);
          }
          return;
        }

        let target = e.target;

        // Check if click is on thumbnail image
        if (target.classList.contains('list-img-link') || target.closest('.list-img-link')) {
          e.stopPropagation();
          const img = target.classList.contains('list-img-link') ? target : target.closest('.list-img-link');
          const id = img.getAttribute('data-id');
          const item = archives.find(x => x.idMel === id);
          if (item) abrirFicha(item);
          return;
        }

        // Check if click is on title link or its children (span, svg)
        if (target.classList.contains('event-title-link') || target.closest('.event-title-link')) {
          e.stopPropagation();
          const link = target.classList.contains('event-title-link') ? target : target.closest('.event-title-link');
          const id = link.getAttribute('data-id');
          const item = archives.find(x => x.idMel === id);
          if (item) abrirFicha(item);
          return;
        }

        // La celda de Lugar NO busca texto: lleva al mapa, encuadra ese local y
        // despliega su panel de eventos — mismo gesto que el tag "Lugar" de la
        // ficha de evento (D-075), que para eso existe el parámetro dedicado
        // `?location=`. Se comprueba antes que .search-cell-link porque la
        // celda lleva las dos clases (comparte el estilo de enlace de tabla).
        if (target.classList.contains('location-cell-link') || target.closest('.location-cell-link')) {
          e.stopPropagation();
          const link = target.classList.contains('location-cell-link') ? target : target.closest('.location-cell-link');
          const lugar = link.getAttribute('data-location');
          if (lugar) {
            window.location.href = `/?view=mapa&location=${encodeURIComponent(lugar)}`;
          }
          return;
        }

        // "¿Nos ayudas?" es un <a href> normal (D-217): se deja navegar tal
        // cual, no es una búsqueda — comprobado antes que el genérico de abajo
        // porque también lleva la clase .search-cell-link (comparte estilo).
        if (target.classList.contains('cell-ayuda') || target.closest('.cell-ayuda')) {
          return;
        }

        // Check if click is on search cell link
        if (target.classList.contains('search-cell-link') || target.closest('.search-cell-link')) {
          e.stopPropagation();
          const link = target.classList.contains('search-cell-link') ? target : target.closest('.search-cell-link');
          const query = link.getAttribute('data-search');
          if (query) {
            window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query } }));
          }
          return;
        }

        // Check if click is on empty state clear button
        if (target.classList.contains('empty-state-clear-btn') || target.closest('.empty-state-clear-btn')) {
          e.preventDefault();
          e.stopPropagation();
          window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query: '' } }));
          return;
        }
      });
    }

    // Initialize state and render
    // Antes de nada: las tarjetas SSR ya traen su proporción de serie
    // (data-ratio, D-259) — se les fija el alto AHORA, en síncrono, no cuando
    // la primera pasada de filtro llegue por su requestAnimationFrame un
    // fotograma después. Es la diferencia entre una rejilla que nace colocada
    // y una que se coloca delante del visitante.
    dimensionarConocidas(document.getElementById('gallery-grid'));
    calculateDynamicBounds();
    // Fase 1 de la vuelta desde una ficha de evento: deja puestos rango de años
    // y orden ANTES del primer render, para no pintar el archivo entero y
    // volver a pintarlo filtrado un frame después.
    readReturnState();
    updateSlider();
    bindInitialCardClicks();
    initSortHeaders();

    // Botón flotante de ordenación. Se engancha con el AbortController de la
    // página (regla 1): initHomePage puede volver a correr y sin esto quedarían
    // dos escuchas y cada toque avanzaría dos pasos del ciclo.
    const botonOrden = document.getElementById('boton-orden');
    if (botonOrden) botonOrden.addEventListener('click', avanzarOrden, { signal: wSig });
    pintarBotonOrden();

    // Parse view, search, and location from URL parameters on load
    const loadParams = new URLSearchParams(window.location.search);
    const viewParam = loadParams.get('view');
    const searchParam = loadParams.get('search');
    const locationParam = loadParams.get('location');

    // Solo se sincroniza el ESTADO; el campo lo pinta su propio componente.
    // Aquí había además un `getElementById('search-input')` con su guard, y ese id
    // no existe en ningún archivo del proyecto (el real es `search-active-input`,
    // en HeaderTitle.astro). Nunca hizo nada: el guard se lo tragaba en silencio,
    // así que aparentaba ocuparse de rellenar el campo sin ocuparse de nada.
    // Quien lo hace de verdad es HeaderTitle, que lee `?search=` por su cuenta y
    // llama a setState('filled', …) — y eso pone el valor en el input Y dispara la
    // búsqueda, o sea las dos mitades del trabajo.
    if (searchParam !== null && searchParam !== searchQuery) {
      searchQuery = searchParam;
      _s.searchQuery = searchParam;
    }

    // OJO: aquí NO se asigna activeSidePanelKey a partir de ?location=.
    // Esa clave se indexa por coordenadas ("42.6000,-5.5675"), mientras que el
    // parámetro de la URL es el NOMBRE del local ("Dickens Tavern"). Al
    // sembrarla con el nombre, la resolución nombre→coordenadas de
    // updateMapMarkers() se saltaba (su guard es `!activeSidePanelKey`) y
    // después `locationGroups[nombre]` no existía: el panel no llegaba a
    // abrirse nunca por URL, ni al entrar por un enlace "Lugar" ni al volver
    // de un evento abierto desde el propio panel. updateMapMarkers() ya lee
    // ?location= por su cuenta y hace la traducción correcta.

    if (viewParam === 'mapa') {
      switchView('mapa');
    } else if (viewParam === 'lista') {
      switchView('lista');
    } else {
      switchView('galería');
    }


    // Fase 2 de la vuelta: página, lotes cargados y scroll, ya con la vista
    // correcta montada.
    applyReturnState();

    // El whisper de contexto: UNA vez por sesión, al entrar. Va aquí y no arriba
    // porque depende de qué vista quede montada, que lo decide el switchView de
    // unas líneas más arriba; y en un rAF porque las clases `hidden` de los
    // paneles se asientan al final del fotograma.
    // Volver de una ficha no lo dispara: la marca de sesión ya está puesta.
    try {
      if (!sessionStorage.getItem('mel-whisper-sesion')) {
        sessionStorage.setItem('mel-whisper-sesion', '1');
        requestAnimationFrame(() => whisperDeOrden(ordenActual()));
      }
    } catch (e) {}
  }

  // --- List View Sorting and Navigation Actions ---

  window.searchInListView = function(query) {
    window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query } }));
  };

  // Reordena LA SECUENCIA DE LA SESIÓN, no una copia de paso.
  //
  // Ordenar es acumulativo, por decisión del propietario: el segundo criterio es
  // siempre la ordenación anterior, y la primera vez esa anterior es el barajado
  // con el que arrancó la sesión. Ordenar por fecha y luego por nombre deja el
  // nombre mandando y la fecha decidiendo dentro de cada nombre.
  //
  // No hace falta nada para conseguirlo: `Array.prototype.sort` es estable desde
  // ES2019, así que ordenar por la columna nueva conserva intacto el orden
  // previo dentro de cada empate. Lo que sí hacía falta era dejar de partir del
  // archivo base en cada ordenación, que es lo que borraba la anterior.
  //
  // Se ordena `archives` y no una copia porque esa secuencia es la que ven TODAS
  // las vistas: la galería, la lista y el Anterior/Siguiente de la ficha salen
  // de ella (contrato de navegación). Y se persiste con el mismo mecanismo que
  // el barajado inicial, para que sobreviva a volver de un evento y a un F5.
  function aplicarOrden(col, dir) {
    const fecha = (d) => {
      if (!d || d === 'SIN FECHA') return 0;
      const p = d.split('/');
      if (p.length === 3) return new Date(p[2], p[1] - 1, p[0]).getTime();
      const p2 = d.split('-');
      if (p2.length === 3) return new Date(p2[0], p2[1] - 1, p2[2]).getTime();
      return 0;
    };
    // Sin dato va al final se ordene como se ordene. El comparador anterior
    // devolvía 1 mirando solo un lado, sin comprobar el otro: eso no es un orden
    // total, y con un comparador incoherente el navegador puede devolver
    // cualquier cosa — incluida la estabilidad de la que depende todo esto.
    const vacio = (v) => !v || v === 'desconocido';
    archives.sort((a, b) => {
      if (col === 'fecha') {
        const ta = fecha(a.fecha), tb = fecha(b.fecha);
        return dir === 'asc' ? ta - tb : tb - ta;
      }
      const va = (a[col] || '').toLowerCase().trim();
      const vb = (b[col] || '').toLowerCase().trim();
      if (vacio(va) && vacio(vb)) return 0;
      if (vacio(va)) return 1;
      if (vacio(vb)) return -1;
      return dir === 'asc' ? va.localeCompare(vb) : vb.localeCompare(va);
    });
    _s.archives = archives;
    guardarSecuenciaDeLaSesion();
  }

  function guardarSecuenciaDeLaSesion() {
    try {
      sessionStorage.setItem('mel-session-order', JSON.stringify(archives.map(x => x.idMel)));
    } catch (e) {}
  }

  // Baraja el archivo entero, Fisher-Yates, y lo deja como secuencia de la
  // sesión. Cada pulsación da un orden NUEVO: el propietario prefirió que
  // barajar sorprenda a que devuelva el orden con el que se entró.
  // Vive en el cliente porque desde D-131 el servidor sirve siempre cronológico;
  // antes barajaba él y hacían falta los dos mecanismos.
  function barajarArchivo() {
    for (let i = archives.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [archives[i], archives[j]] = [archives[j], archives[i]];
    }
    _s.archives = archives;
    guardarSecuenciaDeLaSesion();
  }

  // --- Botón flotante de ordenación (Figma 1085:47259, D-131) ---
  //
  // Ciclo: cronológico ascendente → barajar → cronológico descendente → vuelta.
  // El icono muestra SIEMPRE la acción siguiente, no el estado actual.
  const CICLO_ORDEN = ['asc', 'shuffle', 'desc'];

  // El reordenado del botón se anima MÁS LENTO que el de un filtro cualquiera, y
  // a propósito: aquí el movimiento es el contenido —es lo que le da la gracia
  // al botón— mientras que en un filtro es un efecto secundario. Un segundo y
  // medio con entrada y salida suaves, que el propietario en Chrome apenas
  // llegaba a ver el de 0,32s.
  //
  // Estos dos valores mandan sobre las DOS animaciones: la galería (transiciones
  // de vista) y la lista (FLIP propio con transform). Se publican como
  // propiedades CSS al arrancar la transición en vez de repetirse en la hoja,
  // porque dos duraciones que deben coincidir escritas por separado acaban
  // separándose — la trampa nº2 del traspaso.
  // La duración crece con lo lejos que estuviera el visitante del principio.
  // Recorriendo mucho pasan muchas más tarjetas por delante en el mismo tiempo y
  // se lee como un borrón: estirar el reloj compensa esa sensación. Pero con
  // tope, porque la idea es dar la vuelta al principio, no recorrerse el archivo
  // entero cartel a cartel.
  //
  // Los tres números son la perilla; el resto del código no sabe de esto:
  const ORDEN_ANIM_MS_BASE = 1000;   // ya arriba del todo, sin scroll que deshacer
  const ORDEN_ANIM_MS_MAX = 1600;    // por lejos que se estuviera
  const ORDEN_MS_POR_PX = 0.12;      // cuánto estira cada píxel de scroll
  // 0 px → 1000ms · 1500 px → 1180ms · 2700 px → 1324ms · 5000 px o más → 1600ms
  let duracionOrden = ORDEN_ANIM_MS_BASE;

  // El contenedor con scroll de la vista activa. En Galería y en la Lista de
  // móvil el scroll es del panel, no de la ventana.
  function scrollerActivo() {
    const galeria = document.getElementById('view-galería');
    if (galeria && !galeria.classList.contains('hidden')) return galeria;
    const lista = document.getElementById('view-lista');
    if (lista && !lista.classList.contains('hidden')) return document.getElementById('list-mobile-cards');
    return null;
  }
  // Ease-in-out, pero de los pronunciados. Los dos números que importan son el
  // 0.83 y el 0.17: cuanto más se acercan a 1 y a 0, más despacio arranca y para
  // la animación y más rápido pasa por el medio. La escala, por si hay que
  // moverla —solo hay que tocar esta línea—:
  //   cubic-bezier(0.65, 0, 0.35, 1)  cúbica   · velocidad punta ~1,9× la media
  //   cubic-bezier(0.83, 0, 0.17, 1)  quíntica · ~2,6×   <- aquí
  //   cubic-bezier(0.87, 0, 0.13, 1)  expo     · ~3,2×   (el límite antes de que
  //                                              los extremos parezcan colgados)
  // Asimétrica a propósito: arranca deprisa y frena largo.
  // El primer par (0.4, 0) es la ENTRADA — cuanto más baja la x, antes se alcanza
  // la velocidad punta. El segundo (0.15, 1) es la salida, y dejarlo bajo
  // conserva el frenado largo. Estuvo simétrica en 0.83/0.17 y tardaba
  // demasiado en coger velocidad.
  const ORDEN_ANIM_EASE = 'cubic-bezier(0.4, 0, 0.15, 1)';
  let animacionOrdenLenta = false;

  function ordenActual() {
    try {
      const guardado = sessionStorage.getItem('mel-orden-galeria');
      if (CICLO_ORDEN.includes(guardado)) return guardado;
    } catch (e) {}
    return 'asc';   // el archivo se sirve cronológico ascendente
  }

  // El barajado NO se ofrece mientras hay una búsqueda activa: barajar un puñado
  // de resultados que el visitante acaba de acotar no le dice nada.
  function cicloActual() {
    return (searchQuery && searchQuery.trim()) ? ['asc', 'desc'] : CICLO_ORDEN;
  }

  function siguienteOrden() {
    const ciclo = cicloActual();
    const i = ciclo.indexOf(ordenActual());
    // Si el orden actual no está en el ciclo, es que se estaba en aleatorio y se
    // ha buscado. NO se reordena por debajo —el visitante conserva el orden que
    // tenía— y se le ofrece ascendente, que es lo que interesa en ese momento.
    // Volver a aleatorio solo será posible al limpiar la búsqueda.
    return i === -1 ? 'asc' : ciclo[(i + 1) % ciclo.length];
  }

  function pintarBotonOrden() {
    const boton = document.getElementById('boton-orden');
    if (!boton) return;
    const siguiente = siguienteOrden();
    boton.dataset.siguiente = siguiente;
    boton.setAttribute('aria-label', {
      asc: 'Ordenar del evento más antiguo al más reciente',
      shuffle: 'Barajar el archivo',
      desc: 'Ordenar del evento más reciente al más antiguo',
    }[siguiente]);
    // Solo donde no hay tabla que ordenar. El Mapa queda fuera: allí el orden
    // no se ve por ningún lado. Y con el estado vacío tampoco: no hay nada que
    // ordenar, así que ofrecerlo sería prometer una acción sin efecto. Con un
    // único resultado tampoco hay nada que reordenar entre sí.
    const vista = document.querySelector('.view-panel:not(.hidden)')?.id?.replace('view-', '');
    const vacio = document.getElementById('views-empty-state');
    const hayVacio = vacio && !vacio.classList.contains('hidden');
    boton.dataset.visible = ((vista === 'galería' || vista === 'lista') && !hayVacio && filtered.length > 1) ? 'true' : 'false';
    // Y si el estado vacío aparece con un whisper todavía en pantalla, se retira:
    // anunciar un orden sobre "Sin resultados" no dice nada. Pasa buscando
    // deprisa, antes de que el de contexto haya terminado sus 3 segundos.
    if (hayVacio) ocultarWhisper();
  }
  window._melPintarBotonOrden = pintarBotonOrden;

  // --- Whisper -------------------------------------------------------------
  // Canal de avisos efímeros (D-162). No sabe quién le habla: recibe texto y
  // duración. El primer uso es el orden activo; el segundo, los eventos que el
  // mapa no puede ubicar.
  const TEXTO_ORDEN = {
    asc: 'Orden: de antiguo a reciente',
    shuffle: 'Orden aleatorio',
    desc: 'Orden: de reciente a antiguo',
  };
  const WHISPER_MS = 3000;   // igual en todas partes, mapa incluido
  let whisperTimer = null;

  // Centrado en pantalla, salvo que eso lo pegue al botón de ordenación: en ese
  // caso se desplaza a la izquierda hasta dejar 16px.
  //
  // La cuenta: el botón ocupa de `ancho−64` a `ancho−16`, así que el borde
  // derecho del whisper no puede pasar de `ancho−80`, y su izquierda no baja de
  // 16. De ahí que su ancho máximo con botón sea `ancho−96` — con eso, aunque el
  // texto llene el tope, los 16px de separación siguen saliendo.
  function colocarWhisper() {
    const w = document.getElementById('whisper');
    if (!w) return;

    // Sobre el MAPA se coloca contra el mapa, no contra la ventana: a 24px de su
    // borde inferior y centrado en LA PARTE VISIBLE. `#map-container` es `flex-1`
    // y encoge cuando se despliega el panel lateral, así que centrarse en su caja
    // hace que el whisper se desplace solo hacia la izquierda al abrirse el panel
    // — que es justo lo que pidió el propietario, y sale de leer la caja en vez de
    // calcular el ancho del panel a mano.
    const mapa = document.getElementById('view-mapa');
    const cajaMapa = document.getElementById('map-container');
    if (mapa && !mapa.classList.contains('hidden') && cajaMapa) {
      const r = cajaMapa.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) {
        w.style.maxWidth = Math.min(344, Math.round(r.width) - 32) + 'px';
        const ancho = w.getBoundingClientRect().width;
        w.style.left = Math.round(r.left + (r.width - ancho) / 2) + 'px';
        w.style.bottom = Math.round(document.documentElement.clientHeight - r.bottom + 24) + 'px';
        return;
      }
    }

    // Galería y Lista: contra la ventana, a la altura del botón, y esquivándolo.
    //
    // El límite lateral es el MARGEN REAL de la página (24 en móvil, 48 y 108
    // después), leído del contenedor en vez de repetir los breakpoints aquí — así
    // no se desincroniza el día que ese padding cambie.
    const pantalla = document.getElementById('pantalla-home');
    const margen = pantalla ? parseFloat(getComputedStyle(pantalla).paddingLeft) || 16 : 16;
    const boton = document.getElementById('boton-orden');
    const conBoton = !!boton && getComputedStyle(boton).display !== 'none';
    const vw = document.documentElement.clientWidth;
    w.style.bottom = '32px';
    // Con botón hay que reservar además su ancho y los 16 de separación; sin él,
    // el whisper puede llegar hasta el margen por los dos lados.
    const reservaDerecha = conBoton ? (vw - boton.getBoundingClientRect().left) + 16 : margen;
    w.style.maxWidth = Math.max(0, vw - margen - reservaDerecha) + 'px';
    const ancho = w.getBoundingClientRect().width;   // `visibility:hidden` conserva layout
    const centrado = Math.round((vw - ancho) / 2);
    const tope = vw - reservaDerecha - ancho;
    w.style.left = Math.max(margen, Math.min(centrado, tope)) + 'px';
  }

  function ocultarWhisper() {
    const w = document.getElementById('whisper');
    if (!w || w.dataset.visible !== 'true') return;
    clearTimeout(whisperTimer);
    w.dataset.visible = 'false';
  }

  function mostrarWhisper(texto, ms = WHISPER_MS) {
    const w = document.getElementById('whisper');
    const t = document.getElementById('whisper-texto');
    if (!w || !t) return;
    t.textContent = texto;
    colocarWhisper();
    w.dataset.visible = 'true';
    // Pulsando otra vez con uno en pantalla, el texto cambia y el reloj vuelve a
    // empezar. No se apilan ni se encolan.
    clearTimeout(whisperTimer);
    whisperTimer = setTimeout(() => { w.dataset.visible = 'false'; }, ms);
  }

  // El whisper del ORDEN solo donde vive el botón: por encima de 440px se ordena
  // por las cabeceras de la tabla, y allí basta con su animación y su flecha.
  function whisperDeOrden(orden) {
    const boton = document.getElementById('boton-orden');
    if (!boton || getComputedStyle(boton).display === 'none') return;
    mostrarWhisper(TEXTO_ORDEN[orden]);
  }

  // Segundo uso del canal: cuántos eventos no puede colocar el mapa. Son los que
  // traen coordenadas que `parseCoords` no sabe leer —hoy, los que ponen
  // "Desconocido" en la hoja— y son exactamente los que explican que el contador
  // diga 50 y el mapa sume 47. Sin esto, esa diferencia parece un fallo.
  //
  // Cuántos eventos del filtro vigente no puede colocar el mapa: los que traen
  // coordenadas que `parseCoords` no sabe leer (hoy, los que ponen "Desconocido"
  // en la hoja). Son los que explican que el contador diga 50 y el mapa sume 47.
  //
  // Corre en CADA render, como los demás contadores, y por eso vive en un banner
  // permanente y no en el Whisper: no es un suceso que anunciar, es un estado.
  // Al quedarse a cero se oculta el texto pero NO la caja, para que el mapa no
  // crezca y encoja mientras se escribe.
  function actualizarInfoBanner() {
    const banner = document.getElementById('info-banner');
    const texto = document.getElementById('info-banner-texto');
    if (!banner || !texto) return;
    const sinUbicar = filtered.filter(it => !parseCoords(it.coordenadas, it.localidad)).length;
    banner.dataset.vacio = sinUbicar < 1 ? 'true' : 'false';
    if (sinUbicar < 1) return;
    texto.textContent = sinUbicar === 1
      ? '1 evento no se muestra en el mapa'
      : `${sinUbicar} eventos no se muestran en el mapa`;
  }

  function avanzarOrden() {
    // Elegir un orden nuevo deja de ser "estoy volviendo de una ficha": si la
    // vuelta siguiera viva se saltaría la transición y el cambio ocurriría en un
    // fotograma.
    cancelarVuelta();

    // Se mide AQUÍ, antes de nada: el scroll se pone a cero dentro de
    // performDOMUpdates, así que a partir de ese momento la distancia ya se ha
    // perdido y no habría con qué calcular.
    const scroller = scrollerActivo();
    const distancia = scroller ? scroller.scrollTop : 0;
    duracionOrden = Math.min(
      ORDEN_ANIM_MS_MAX,
      Math.round(ORDEN_ANIM_MS_BASE + distancia * ORDEN_MS_POR_PX)
    );

    // Del ciclo VIGENTE, que no siempre es el de tres: con una búsqueda activa
    // el barajado no se ofrece (ver siguienteOrden).
    const siguiente = siguienteOrden();
    try { sessionStorage.setItem('mel-orden-galeria', siguiente); } catch (e) {}

    if (siguiente === 'shuffle') barajarArchivo();
    else aplicarOrden('fecha', siguiente);

    // Las cabeceras de la tabla dejan de mandar: el visitante acaba de elegir
    // otro orden desde el botón, y dejar una flecha encendida en una columna
    // que ya no ordena nada sería mentir.
    currentSortCol = siguiente === 'shuffle' ? null : 'fecha';
    currentSortDir = siguiente === 'shuffle' ? 'asc' : siguiente;
    try {
      sessionStorage.setItem('mel-sort-state', JSON.stringify({ col: currentSortCol, dir: currentSortDir }));
    } catch (e) {}
    syncState();
    updateSortHeaderIcons();

    // Arriba del todo: se acaba de reordenar el archivo entero bajo los pies del
    // visitante, y quedarse a media altura lo deja entre carteles que ya no son
    // los que miraba. Mismo criterio que al cambiar un filtro.
    //
    // Pero el scroll NO se toca aquí. Se pone a cero DENTRO de performDOMUpdates,
    // que es lo que hace que subir y reordenar sean un solo movimiento en vez de
    // un salto seguido de una animación. El porqué, allí.
    currentPage = 1;
    galleryVisibleCount = PAGE_SIZE;

    pintarBotonOrden();
    // El whisper anuncia el orden RECIÉN elegido, no el siguiente: el botón ya
    // enseña lo que vendría después, y decir las dos cosas a la vez confunde.
    whisperDeOrden(siguiente);
    animacionOrdenLenta = true;
    filterArchives();
  }

  function handleSortClick(col) {
    if (currentSortCol === col) {
      currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
    } else {
      currentSortCol = col;
      currentSortDir = 'asc';
    }
    aplicarOrden(currentSortCol, currentSortDir);
    try {
      sessionStorage.setItem('mel-sort-state', JSON.stringify({ col: currentSortCol, dir: currentSortDir }));
    } catch (e) {}

    updateSortHeaderIcons();

    // Re-render starting at page 1
    currentPage = 1;
    filterArchives();
  }

  // Pinta la flecha de la columna activa. Extraído de handleSortClick() porque
  // al volver de una ficha de evento el orden se restaura sin pasar por un
  // click: sin esto, la tabla salía ordenada pero ninguna cabecera lo indicaba.
  function updateSortHeaderIcons() {
    document.querySelectorAll('.sort-header').forEach(h => {
      const iconSpan = h.querySelector('.sort-icon');
      if (!iconSpan) return;
      if (h.dataset.col === currentSortCol) {
        iconSpan.className = 'sort-icon text-mel-action-primary shrink-0';
        iconSpan.innerHTML = currentSortDir === 'asc'
          ? `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>`
          : `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>`;
      } else {
        iconSpan.className = 'sort-icon text-mel-action-secondary shrink-0';
        iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>`;
      }
    });
  }

  // Initialize sort click listeners
  function initSortHeaders() {
    document.querySelectorAll('.sort-header').forEach(h => {
      h.addEventListener('click', () => {
        handleSortClick(h.dataset.col);
      });
    });
  }

  // -------------------------------------------------------
  // Bootstrap. astro:page-load fires on the initial page load too (the
  // ClientRouter in Layout.astro guarantees it), so it must be the ONLY
  // entry point: calling initHomePage() directly here as well ran it twice
  // per full load, double-binding every element listener — one sort-header
  // click toggled the direction twice (always ending up desc), one
  // pagination click advanced two pages, and every re-render kicked off
  // two overlapping view transitions.
  // -------------------------------------------------------
  // El registro es IDEMPOTENTE, y sin eso se acumulaba una copia por visita.
  //
  // El script en línea de esta página se **reevalúa en cada navegación suave**
  // que vuelva aquí, mientras que `document` sobrevive al intercambio de cuerpo.
  // Así que cada vuelta a la home dejaba enganchado otro initHomePage, y en el
  // siguiente page-load corrían TODOS. Medido con tres idas y vueltas a una
  // ficha, contando corridas por carga:
  //
  //   /event/…  2      /  2
  //   /event/…  3      /  3
  //
  // Crece una por visita y no se limpia mientras dure la pestaña. De ahí la
  // tormenta de repintados al volver de un evento (D-119, D-121): NO era
  // `astro:page-load` disparando dos veces —dispara una, medido— sino dos copias
  // del inicializador pisándose. El comentario de readReturnState() que dice lo
  // contrario queda corregido.
  //
  // La copia que sobrevive es la primera, con el `initialArchives` de aquella
  // carga. Es asumible: ese valor solo se usa para sembrar `_melState` (que ya
  // está protegido y solo corre una vez) y como red de seguridad si el estado
  // llegara vacío. El orden real de la sesión vive en `mel-session-order`.
  if (!window._melHomeInitBound) {
    window._melHomeInitBound = true;
    document.addEventListener('astro:page-load', initHomePage);
  }

  // La galería entrante nace OCULTA, antes de que el navegador la pinte.
  //
  // Ocultarla desde el final de la inicialización llegaba tarde: medido, 19ms
  // después de `astro:after-swap`, y en ese hueco ya se había pintado la galería
  // sin colocar. Eso es el parpadeo que reportó el propietario. En
  // `astro:before-swap` el documento entrante todavía no está en pantalla, así
  // que se le pone la opacidad ahí y nace invisible: no hay ningún fotograma con
  // la rejilla fuera de sitio.
  //
  // Va en el ámbito del módulo y no dentro de initHomePage: el script de esta
  // página se evalúa UNA vez y sigue vivo mientras dure la sesión de navegación,
  // incluso estando en una ficha de evento — que es justo cuando hace falta,
  // porque el que se va es el que tiene que preparar al que llega.
  document.addEventListener('astro:before-swap', (e) => {
    try {
      const crudo = sessionStorage.getItem('mel-return-state');
      if (!crudo) return;
      // Solo cuando la vuelta va a llevar la galería hasta un flyer: es
      // volverAlFlyer() quien la revela, y sin él no la revelaría nadie.
      if (!JSON.parse(crudo).flyer) return;
      const galeria = e.newDocument && e.newDocument.getElementById('view-galería');
      if (!galeria) return;
      galeria.style.transition = 'none';
      galeria.style.opacity = '0';
      // Red de seguridad, por si alguna ruta imprevista no llegara a revelarla:
      // una galería invisible para siempre es mucho peor que cualquier parpadeo.
      setTimeout(() => revelarColocado(document.getElementById('view-galería')), 3000);
    } catch (err) {}
  });

</script>
