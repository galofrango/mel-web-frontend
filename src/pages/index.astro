                ${item.disenador && item.disenador.toLowerCase() !== 'desconocido' 
                  ? `<span class="marquee-inner search-cell-link" data-search="${escHtml(item.disenador)}">${escHtml(item.disenador)}</span>` 
                  : '<span class="marquee-inner text-mel-text-tertiary opacity-60">desconocido</span>'
                }
              </td>
            `;
            listBody.appendChild(tr);
