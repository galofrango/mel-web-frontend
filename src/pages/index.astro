---
import Layout from '../layouts/Layout.astro';
import HeaderTitle from '../components/HeaderTitle.astro';
import MenuItem from '../components/MenuItem.astro';
import SideMenu from '../components/SideMenu.astro';
import TimeSlider from '../components/TimeSlider.astro';
import TagWithLink from '../components/TagWithLink.astro';
import AdaptiveTagsRow from '../components/AdaptiveTagsRow.astro';
import BotonOrden from '../components/BotonOrden.astro';
import Whisper from '../components/Whisper.astro';
import ToggleSelector from '../components/ToggleSelector.astro';
import FlyerCard from '../components/FlyerCard.astro';
import IconButton from '../components/IconButton.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import BottomSheetHeader from '../components/BottomSheetHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import { fetchEvents, rangoDeAnios, extractDriveImage, srcSetDrive, formatFechaDMY } from '../lib/mel';
import flyerTecnico from '../data/flyer_tecnico.json';

// Anchos por contexto, medidos en navegador: la tarjeta de galería se pinta a
// 342px (684 con densidad 2) y la miniatura de la lista en una caja de 40px.
const ANCHO_TARJETA = 700;
// Los dos anchos que se le ofrecen al navegador para la tarjeta, y no más: en
// la galería la velocidad manda, porque carga 32 de golpe.
//
// La cuenta, con la tarjeta midiendo 288 px CSS (contenedor de 1224, cuatro
// columnas, 24 de hueco):
//
//   pantalla normal  288 × 1 = 288  → se lleva w700
//   Retina 2×        288 × 2 = 576  → se lleva w700   ← la mayoría
//   Retina 3×        288 × 3 = 864  → se lleva w1000
//   móvil 3×         159 × 3 = 477  → se lleva w700
//
// O sea: casi todo el mundo se sigue bajando exactamente lo mismo que antes
// (3,7 MB la primera pantalla) y solo las de 3× pagan los 5 MB a cambio de ver
// los carteles nítidos. Un w1400 no lo pediría nadie — haría falta una pantalla
// de 5× — así que ofrecerlo era peso muerto en el HTML.
const ANCHOS_TARJETA = [700, 1000];
const ANCHO_MINIATURA = 200;

// El archivo entero, ya agrupado por evento y en orden cronológico ascendente.
// El fetch, el parseo del JSON-P, el mapa de columnas y el agrupado viven en
// src/lib/mel.ts porque la ficha de evento necesita exactamente lo mismo.
const initialArchives = await fetchEvents();

// La proporción REAL del cartel de cada tarjeta, sabida ANTES de que su imagen
// cargue (D-259). Viene de flyer_tecnico.json —el panel audita las dimensiones
// de las 101 imágenes del archivo—, así que el masonry puede fijar el alto de
// TODAS las tarjetas en el primer fotograma, en vez de esperar al onload de
// cada imagen y recolocar la rejilla a golpes durante el primer segundo (que
// era lo que movía tarjetas de columna en la vuelta de una ficha, empujaba el
// scroll restaurado y obligaba a volverAlFlyer a perseguir su tarjeta). Se
// muta el item para que cruce al cliente por define:vars con todo lo demás.
// Un cartel que no esté en el JSON (subido y aún sin pasar por el panel) queda
// sin ratio y conserva el camino viejo: medirse al cargar.
const idDeDriveUrl = (url?: string): string => {
  if (!url) return '';
  if (url.includes('id=')) return url.split('id=')[1].split('&')[0];
  if (url.includes('/d/')) return url.split('/d/')[1].split('/')[0];
  return '';
};
for (const item of initialArchives) {
  const d = (flyerTecnico as any)[idDeDriveUrl(item.carruselItems?.[0]?.urlDrive)]?.px;
  if (Array.isArray(d) && d[0] > 0 && d[1] > 0) (item as any).ratio = d[0] / d[1];
}

// Caché de CDN (D-258): la página es idéntica para todos los visitantes (nada
// personalizado sale del servidor; lo personal vive en sessionStorage), así que
// Vercel puede servirla cacheada sin pisar el SSR — que hasta ahora esperaba a
// Google Sheets EN CADA request antes de mandar un solo byte, y a veces Google
// respondía con el shell rate-limitado de 3KB (trampa 7 del traspaso). Los 5
// minutos los fijó el propietario (06-08-2026): un cambio en la hoja tarda eso
// como máximo en verse. `stale-while-revalidate`: pasado el plazo se sirve la
// copia vieja al instante y se renueva por detrás — nadie espera nunca a la
// hoja. Misma cabecera en las tres páginas que leen la hoja (aquí, la ficha e
// info); si se toca una, las tres.
// `max-age=60` y no 0 (D-259): con 0 el navegador revalidaba SIEMPRE, así que
// el <link rel="prefetch"> que las tarjetas disparan al posar el dedo quedaba
// inutilizado — la navegación real no podía reutilizarlo sin volver a la red.
// Con 60, la ficha precargada abre de caché local, y volver atrás también.
// Un F5 explícito revalida igualmente (los reloads se saltan el max-age).
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=600');

// El rango del deslizador de tiempo sale de los datos, no de un literal. Se
// calcula AQUÍ, en el servidor, y cruza al cliente por `define:vars` (regla 7):
// el script de esta página es inline y no puede importar de mel.ts. D-183.
const rangoAnios = rangoDeAnios(initialArchives);

const initialArtists = new Set();
const initialDesigners = new Set();
const initialPromoters = new Set();

// Recuentos únicos para los tags de cabecera. Los centinelas con que la hoja
// marca "aquí no hay dato" no cuentan como valor (D-097).
initialArchives.forEach(item => {
  if (item.artistas) {
    item.artistas.split(/,+/).forEach(a => {
      const cleanA = a.trim().toLowerCase();
      if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') initialArtists.add(cleanA);
    });
  }
  if (item.organiza) {
    const cleanP = item.organiza.trim().toLowerCase();
    if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') initialPromoters.add(cleanP);
  }
  if (item.disenador) {
    const cleanD = item.disenador.trim().toLowerCase();
    if (cleanD && cleanD !== 'desconocido') initialDesigners.add(cleanD);
  }
});

// Mapped stats matching Figma TagWithLink instances exactly
const tags = [
  { label: "Eventos", count: initialArchives.length },
  { label: "Artistas", count: initialArtists.size },
  { label: "Diseñadores", count: initialDesigners.size },
  { label: "Promotores", count: initialPromoters.size }
];

// El servidor sirve SIEMPRE el archivo en orden cronológico ascendente, que es
// como ya lo deja `initialArchives` unas líneas más arriba. Antes lo barajaba
// aquí (D-015) y el aleatorio era la puerta de entrada; ahora barajar es una
// acción del visitante, con el botón de ordenación (D-131).
//
// El cambio quita trabajo en vez de añadirlo: había dos mecanismos de barajado
// —el del servidor para la primera carga y el que hacía falta en el cliente para
// volver a barajar— y ahora hay uno solo, en el cliente.


---

<Layout title="Galería de Diseño">
  <!-- Top/bottom paddings are viewport-relative (tuned against the 4K reference:
       112px top / 32px bottom at ~1100px of viewport height ≈ 10vh / 3vh) so
       smaller screens don't waste fixed pixel gaps. -->
  <!-- h-dvh y NO h-screen (100vh): en Chrome/Safari móvil `vh` mide la pantalla
       ENTERA, incluida la franja que ocupan las barras del navegador, así que la
       página quedaba más alta que lo realmente visible y siempre sobraba un
       scroll vertical con el final tapado. `dvh` mide solo el área visible. -->
  <!-- Los huecos verticales salen de la escala del DS y suben una talla a partir
       de tablet (`md`, 768px, el mismo corte en el que la rejilla pasa de dos a
       tres columnas): `M` (24px) en móvil, `L` (32px) de tablet en adelante.
       El alto de más en móvil NO se gana apretando estos huecos —se probó a `S`
       y el propietario lo vio agobiado— sino quitando el relleno invisible que
       el slider llevaba dentro (64px de `py-8`, ver TimeSlider.astro). -->
  <!-- El `pt` superior ya no vive aquí sino en #bloque-cabecera, para que su
       fondo opaco llegue hasta el borde de arriba de la pantalla. La geometría
       resultante es idéntica: el bloque es el primer hijo. -->
  <div id="pantalla-home" class="w-full max-w-[1440px] h-dvh mx-auto bg-mel-bg-primary px-6 sm:px-12 lg:px-[108px] pb-[3vh] flex flex-col gap-mel-m md:gap-mel-l overflow-hidden" data-node-id="Screen / Desktop / Gallery">
    
    <!-- Page Header: Search (Typing Title prompt) and Menu. Single row on every
         breakpoint — on mobile the title collapses to "M.E.L." and the menu to
         its icon (see HeaderTitle/MenuItem), the gap to the menu button is 16px
         on mobile / 24px from lg up. Plain flex (title flex-1, menu shrink-0)
         at every width — NOT a 50/50 grid split — so the search box only ever
         shrinks (and truncates its placeholder) once it's genuinely out of
         room, i.e. down to that gap from the menu, instead of being capped at
         a fixed half of the row regardless of how little the menu needs. -->
    <!-- Bloque fijo de cabecera: título, slider, cifras y selector de vista.
         Existe como elemento por una razón concreta y no por orden: al reordenar
         el archivo, las tarjetas viajan por la capa superior del navegador, que
         se salta el z-index de la página (regla 2). La cabecera y la toolbar ya
         tenían nombre propio y quedaban por encima, pero eran DOS islas: por el
         hueco entre ellas y por el `pt` de arriba asomaba el fondo de la página,
         que va por debajo, y las tarjetas se veían pasar por ahí.
         Esta envoltura es opaca y de una pieza, y se lleva el `pt` superior y el
         sangrado horizontal (márgenes negativos que anulan el `px` de la página,
         igual que hace el slider) para llegar a los cuatro bordes.
         Su `view-transition-name` SÍ va aquí desde D-259 (antes solo lo ponía
         JS durante el reordenado, con el argumento de que en las transiciones
         entre páginas "no existe destino que le corresponda" — y ese grupo sin
         pareja resultó ser justo lo que faltaba): al volver de una ficha, las
         tarjetas se promocionan por su flyer-img-… y se veían POR LOS HUECOS
         entre los grupos sueltos de cabecera y toolbar, cuyos margins no eran
         de nadie. Con el bloque entero nombrado, su fondo opaco cubre la franja
         completa por encima de las tarjetas (z-index en el <style> de abajo, y
         su ::view-transition-new a 0s para que en la vuelta aparezca opaco
         desde el primer fotograma en vez de fundirse dejando ver detrás).
         Durante el reordenado, nombrarHuecos() lo renombra a mel-bloque-fijo y
         al deshacer lo devuelve a ESTE nombre, no a vacío. -->
    <div
      id="bloque-cabecera"
      style="view-transition-name: mel-bloque-cabecera;"
      class="flex flex-col gap-mel-m md:gap-mel-l shrink-0 bg-mel-bg-primary
             pt-[var(--mel-header-pt-mobile)] lg:pt-[var(--mel-header-pt-desktop)]
             -mx-6 px-6 sm:-mx-12 sm:px-12 lg:-mx-[108px] lg:px-[108px]"
    >
    <div id="home-header" class="flex items-center gap-4 lg:gap-6 shrink-0" style="view-transition-name: mel-header;">
      <div class="flex-1 min-w-0 w-full">
        <HeaderTitle hideDivider={true} />
      </div>
      <div class="shrink-0 flex justify-end">
        <MenuItem id="menu-btn" />
      </div>
    </div>

    <!-- Toolbar: Slider & Controls. El hueco hasta la cabecera lo da el gap-6
         del contenedor padre (24px). En móvil (Figma 439:140952 / 315:17658 el
         toolbar arranca más pegado a la cabecera) lo recortamos a 16px con
         -mt-2, restaurando 24px en desktop (lg:mt-0). El pb-4 mantiene el hueco
         hacia el contenido de abajo. Tailwind: gap-6=24px, -mt-2=-8px. -->
    <!-- El hueco hasta la galería es a propósito UNA TALLA MAYOR que el resto:
         el propietario quiere que la rejilla respire respecto a los controles.
         Sale de `pb + gap − 8` (el −8 lo pone el `-mt-2` del contenedor de
         vistas). Con `pb-mel-s` fijo, el escalón sale solo en las dos tallas:
         móvil 16+24−8 = 32 sobre un ritmo de 24, y tablet 16+32−8 = 40 sobre un
         ritmo de 32. Por eso el `pb` NO lleva variante: subirlo también en `md`
         daba 48, que son dos tallas de salto y no una. -->
    <!-- `mt` y `pb` van en la escala, no a pelo. Antes: `-mt-2 lg:mt-0`, un −8px
         suelto que se comía parte del primer hueco y hacía que entre el título y
         el slider hubiera 16 donde el resto tenía 24. Ahora el margen SUMA en
         escritorio (`XS`) en vez de restar en móvil, que es lo que pidió el
         propietario: una talla más entre título y slider en todas las pantallas.
         Título→slider queda en 24 (móvil) / 32 (tablet) / 40 (escritorio).
         El `pb` baja a `XS` en escritorio: allí el hueco hasta la galería suma
         además los 16px del `lg:mt` de la propia galería (D-064) y se iba a 56,
         que el propietario ve excesivo. Con esto, 48. -->
    <div id="home-toolbar" class="flex flex-col gap-mel-m md:gap-mel-l pb-mel-s lg:pb-mel-xs shrink-0 lg:mt-mel-xs" style="view-transition-name: mel-toolbar;">
      <!-- Year Slider Bar (Removed text header label as requested). On mobile the
           slider runs full-bleed to the screen edges (negative margins cancel the
           page's px-6), per the mobile toolbar design (Figma 315:17658). -->
      <div class="flex flex-col gap-2 -mx-6 sm:mx-0">
        <TimeSlider min={rangoAnios.min} max={rangoAnios.max} />
      </div>

      <!-- Filter Tags and View Switcher (Figma node 341:26425). True
           flex-wrap, not a `lg` breakpoint switch: the Toggle sits beside the
           tags row whenever both fit at their natural sizes, and drops to
           its own full-width line the moment they don't. gap-y-8 (32px,
           D-060): the propietario asked for at least 32px of vertical gap
           between the tags and a wrapped Toggle — mt-0 lg:mt-2 (unrelated:
           the slider→toolbar gap) stays as-is. -->
      <!-- `gap-y` solo se ve cuando el selector cae bajo las tags, o sea en
           móvil. `gap-x` es el hueco entre tags y selector cuando comparten
           renglón. Los dos en `M`, el mismo ritmo que el resto. -->
      <div id="home-highlights-toolbar" class="flex flex-wrap items-center gap-x-mel-m gap-y-mel-m md:gap-x-mel-l md:gap-y-mel-l mt-0 lg:mt-2">
        <!-- Event Stats Tags — AdaptiveTagsRow.astro (D-059/D-060), shared
             with the event detail's horizontal tags row and the map side
             panel. Layout mode (equal-width grid vs content-sized+scroll)
             is decided by updateAdaptiveTagsRow() in the script below, from
             real measurement rather than a fixed breakpoint. -->
        <AdaptiveTagsRow id="home-highlights-tags" tags={tags} class="pr-[32px]" />

        <!-- View Selector Toggle: grows to fill the rest of its line. Capped
             at 4 grid columns (matching the map side panel's own identical
             formula, D-026 — 4/12 columns with a 24px gap) ONLY while it's
             actually sharing that line with the tags row — toggled via
             .toggle-shares-line by updateHomeToolbarLayout() below, since a
             static max-width would otherwise also clamp it once it wraps
             onto its own line alone, where it should span the full width
             instead (the propietario caught this: "cuando pasa debajo de
             las tags, debe ocupar el ancho total de la pantalla"). Never
             narrower than 320px in either state. -->
        <div id="home-toggle-wrapper" class="grow min-w-[320px] toggle-shares-line">
          <ToggleSelector />
        </div>
      </div>

      <style>
        #home-toggle-wrapper.toggle-shares-line {
          max-width: calc((100% - 264px) / 3 + 72px);
        }
        /* La cuarta columna de la galería se cuelga del MISMO estado que decide
           que el selector de vista quepa en el renglón de las tags — que es la
           referencia que dio el propietario: "cuando el toggle se pone a la
           misma altura que las tags". No es un breakpoint: se mide en tiempo
           real contra el ancho que ocupan los textos de las tags
           (updateHomeToolbarLayout), así que colgarlo de un ancho fijo se
           desincronizaría en cuanto cambiaran los datos de la hoja. */
        #gallery-grid.galeria-cuatro {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
        @media (min-width: 1024px) {
          #home-highlights-toolbar .adaptive-tags-row.highlights-flex-content {
            width: auto;
            flex-shrink: 1;
          }
        }
      </style>
    </div>
    </div><!-- /#bloque-cabecera -->

    <!-- Main Visual Space: Galería / Mapa / Lista dynamic views -->
    <!-- Va fuera del contenedor de vistas y no dentro: es `fixed`, así que su
         sitio no depende de dónde esté en el marcado, y colgándolo de una vista
         concreta desaparecería al cambiar de pestaña. -->
    <BotonOrden />
    <!-- Fuera del contenedor de vistas por el mismo motivo que el botón: es
         `fixed`, así que su sitio no depende de dónde esté en el marcado, y
         colgándolo de una vista concreta desaparecería al cambiar de pestaña. -->
    <Whisper />

    <!-- `lg:-mt-6` sube las TRES vistas 16px más respecto del toggle en escritorio
         (petición del propietario). Se toca AQUÍ y no en cada vista, para que
         galería, mapa y lista sigan arrancando a la misma altura — desalinear una
         sola ya se probó y se notó al instante (D-168). -->
    <div id="content-views" class="relative flex-1 min-h-0 w-full overflow-visible flex flex-col justify-between transition-colors duration-300 -mt-[8px] lg:-mt-6">
      <!-- Single Sitewide Empty State Overlay anchored to content-views for Galería, Mapa, and Lista -->
      <!-- Cubre desde top-0, no desde top-[24px]: la vista Mapa arranca en 0 bajo
           lg, así que esos 24px dejaban asomar una banda de calles por encima
           del estado vacío. El contenido va algo más arriba de lo centrado
           (pb mayor que pt) ahora que el toggle desaparece en este estado y
           queda hueco de sobra por debajo. -->
      <!-- El estado vacío es el COMPONENTE, pintado aquí en SSR y solo mostrado u
           ocultado por JS. Antes se generaba con una plantilla de cadena que
           replicaba su marcado a mano, y se desincronizó a la primera: al
           cambiar el alto de la foto en el componente, la home seguía con el
           anterior. Sin `pt` propio en móvil para que la foto arranque a 32px
           de los recuentos y no a 89. -->
      <div id="views-empty-state" class="hidden absolute inset-0 bg-mel-bg-primary z-[30] items-start justify-center pb-24 lg:items-center overflow-y-auto">
        <EmptyState variant="no-results" class="pt-0 lg:pt-[24px]" />
      </div>

      <!-- 1. GALLERY VIEW (masonry 2.1: CSS Grid + row-span medido por imagen,
           cada flyer entero a ancho de columna y ratio original, sin recortes;
           orden aleatorio, scroll infinito vía #gallery-sentinel. Ver
           decisions.md D-014/D-015; galeria-1.0 es el tag de la rejilla
           antigua de alturas fijas). -->
      <!-- Negative side margins + matching padding make the scroll container clip
           44px OUTSIDE the grid on the sides, so hovered cards (scale + shadow)
           aren't cut off at the edges while the grid stays full-width. Bottom
           breathing room lives on the grid itself (pb) because a scroll
           container's own padding-bottom is dropped from the scrollable area,
           so it wouldn't reserve space at the end of the scroll.
           pt-0 (D-067, was pt-[24px]): on mobile the gap up to the toolbar
           already comes from the page's own flex layout — this extra 24px on
           top of that was pushing the grid down further than intended.
           lg:mt-[16px]/lg:pt-[8px] (D-064) still stand on desktop, where the
           opposite problem existed (cards sitting too close during scroll).
           -mb-[3vh] cancels the page's own pb-[3vh] (the calibrated top/bottom
           breathing room, rule 9 — not touching that) so the scroll
           container's own box reaches the literal bottom of the screen
           instead of stopping 3vh short of it. -->
      <div id="view-galería" class="view-panel active flex-1 w-[calc(100%+88px)] -ml-[44px] -mb-[3vh] overflow-y-auto transition-all duration-500 px-[44px] pt-0 lg:pt-[8px] lg:mt-[16px] relative">
        <!-- Nunca menos de DOS columnas, ni en el móvil más estrecho. A una sola,
             el flyer mediano mide 462px en una ventana de galería de 484: ocupa
             la pantalla entera, no cabe entero casi nunca y no se ve nada más.
             En una galería, ver las piezas de una en una y cortadas es peor que
             verlas pequeñas. Medido a 375px: a una columna caben enteros 15 de
             21; a dos, los 21, y se ven cuatro a la vez (D-124).
             La cuarta columna la enciende `.galeria-cuatro`, ver
             updateHomeToolbarLayout(). -->
        <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 gap-x-mel-m auto-rows-[4px] w-full pb-[13vh]">
          {initialArchives.slice(0, 32).map((item, i) => {
            const imgSrc = extractDriveImage(item.carruselItems[0]?.urlDrive, ANCHO_TARJETA) || `/flyers/flyer-${((i % 13) + 1)}.png`;
            const imgSrcset = srcSetDrive(item.carruselItems[0]?.urlDrive, ANCHOS_TARJETA);
            return (
              <FlyerCard
                id={item.idMel}
                title={item.evento}
                date={formatFechaDMY(item.fecha)}
                image={imgSrc}
                srcset={imgSrcset}
                prioridad={i < 8}
                ratio={(item as any).ratio}
              />
            );
          })}
        </div>
        <!-- Centinela del scroll infinito: cuando entra en el margen de
             precarga del IntersectionObserver (~1200px antes de ser visible)
             se añade el siguiente lote de tarjetas. -->
        <div id="gallery-sentinel" class="h-px w-full" aria-hidden="true"></div>
      </div>

      <!-- 2. MAP VIEW (Real Google Map with sliding side panel). top-0 on mobile,
           lg:top-[24px] on desktop (D-067) — mirrors the gallery's own pt-0/lg:pt-[8px]
           split (D-064/D-067): the propietario asked to raise all three home views'
           content by 24px on mobile specifically, desktop untouched here. -->
      <!-- El mapa va A SANGRE por los lados: los insets negativos cancelan el
           padding de la página (24 en móvil, 48 desde `sm`), igual que hace la
           lista de móvil con sus `-mx`. Desde `lg` vuelve a quedar dentro del
           contenedor de 1224, que es como está en Figma para escritorio.
           `top-0` en móvil, NO un valor propio: las tres vistas tienen que
           arrancar a la misma altura (D-067). Se probó bajarlo para dar 24px al
           banner y dejaba el Mapa 8px por encima de Galería y Lista — el
           propietario lo detectó al instante. El aire del banner se resuelve por
           otro lado, no desalineando la vista. -->
      <!-- `bottom-[-3vh]` en móvil cancela el `pb-[3vh]` de la página, igual que
           la galería hace con su `-mb-[3vh]`: el mapa llega al borde inferior de
           la pantalla en vez de dejar una franja de fondo debajo. Desde `lg` se
           queda como estaba. -->
      <div id="view-mapa" class="view-panel hidden absolute top-0 lg:top-[24px] bottom-[-3vh] lg:bottom-0 overflow-hidden flex -left-6 -right-6 sm:-left-12 sm:-right-12 lg:left-0 lg:right-0">
        <!-- El mapa y su franja de estado comparten caja, con la franja SUPERPUESTA
             (`absolute` dentro de este `relative`). Así el InfoBanner mide justo lo
             que mide el mapa —y encoge con él al desplegarse el panel, sin calcular
             nada— y sobre todo: al vaciarse desaparece y descubre el trozo de mapa
             que tapaba, en vez de dejar un rectángulo gris. El mapa ocupa todo el
             alto siempre, así que tampoco crece ni encoge. -->
        <div class="flex-1 min-w-0 h-full relative">
          <div id="map-container" class="absolute inset-0"></div>
        </div>

        <!-- Dim: solo cuando el panel es bottom sheet (bajo lg). Cubre el slider
             de tiempo (que queda a la vista, atenuado) y todo lo de abajo. -->
        <div
          id="map-side-panel-backdrop"
