    font-size: 14px;
    line-height: 20px;
    color: var(--mel-text-secondary);
  }

  .mel-popup-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px 4px 8px;
    background-color: var(--mel-action-secondary);
    border: 1px solid var(--mel-action-secondary);
    color: var(--mel-text-on-action);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    cursor: pointer;
    transition: background-color 0.15s ease;
    flex-shrink: 0;
  }

  .mel-popup-btn:hover {
    background-color: var(--mel-action-primary);
  }

  .mel-popup-btn svg {
    width: 14px;
    height: 14px;
  }

  .mel-popup-divider {
    height: 1px;
    background: var(--mel-border);
    margin: 12px 0;
  }

  .mel-popup-single {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .mel-popup-thumb {
    width: 80px;
    height: 100px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--mel-border);
  }

  .mel-popup-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sort-header {
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .sort-header:hover {
    background-color: var(--mel-bg-secondary);
    color: var(--mel-action-primary) !important;
  }
  .sort-header:hover .sort-icon {
    color: var(--mel-action-primary) !important;
  }

  /* --- List view: marquee-on-hover for truncated cell text --- */
  .marquee-cell {
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }
  /* text-overflow:ellipsis lives on the inline-block itself, not just the
     parent .marquee-cell — a parent's ellipsis doesn't reliably truncate an
     atomic inline-block child (the overflowing content isn't a text run the
     browser can cut mid-way through, just one opaque box), which is why
     resting cells were showing raw clipped text with no "…" at all instead
     of a proper ellipsis. max-width caps it to the cell's own width at rest;
     the :hover override below lifts that cap so the slide reveal can work. */
  .marquee-cell .marquee-inner {
    display: inline-block;
    position: relative;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
    transition: transform 0s linear;
    padding-right: 0;
    /* Room for the underline below the text — it has to live *inside* this
       box (not offset outside it) since marquee-inner's own overflow:hidden
       above, needed for the ellipsis, would otherwise clip it invisible.
       3px: a midpoint between Link.astro's own bottom-0 (touching the text)
       and the 6px this had before, which read as too far. */
    padding-bottom: 3px;
  }

  /* Table link cells (event title, lugar/localidad/organiza/diseño search
     links): same animated underline as the Link.astro component — a
     scaleX(0 -> 1) line from the left, instead of the browser's native
     text-decoration:underline — with a bit more breathing room from the
     text than Link.astro's own bottom-0. */
  .table-link-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .event-title-link:hover .table-link-underline,
  .search-cell-link:hover .table-link-underline {
    transform: scaleX(1);
  }
  .marquee-cell:hover .marquee-inner.is-overflowing {
    max-width: none;
    overflow: visible;
    /* Plays once and holds (no `infinite`) — looping used to snap back to the
       start mid-hover as soon as one pass finished, which read as a reset
       before the visitor had even finished reading the full name. */
    animation: marquee-scroll var(--marquee-duration, 2.2s) cubic-bezier(0.16, 1, 0.3, 1) 0.25s 1 forwards;
  }
  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-100% + var(--cell-width))); }
  }

  /* Event title: show chevron on hover */
  .event-title-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
  }
  .event-title-link .title-chevron {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .event-title-link:hover .title-chevron {
    opacity: 1;
    transform: translateX(0);
  }

  /* Search link cells */
  .search-cell-link {
    cursor: pointer;
    color: var(--mel-action-secondary);
    transition: color 0.2s ease;
  }
  .search-cell-link:hover {
    color: var(--mel-action-primary);
  }

  /* Panel lateral del mapa: en escritorio empuja el mapa (ancho 0→393px,
     ver JS classList 'side-panel-open'). En móvil se convierte en bottom
     sheet superpuesto (Figma 439:142691) que se desliza desde abajo sin
     comprimir el mapa — misma cabecera/tags/lista, solo cambia la
     geometría y se añade el tirador de arrastre. */
  #map-side-panel.side-panel-open {
    width: 393px;
    border-left-width: 1px;
  }
  @media (max-width: 767px) {
    #map-side-panel {
      /* fixed (no absolute): relativo al VIEWPORT real, no a #view-mapa —
         así llega a los bordes reales de pantalla (izq/der/abajo) y su
         borde superior queda exactamente a 64px del techo de pantalla,
         por encima incluso de la cabecera + toolbar del sitio si hace
         falta (D-023: un `absolute` dentro de #view-mapa sumaba ese
         hueco AL offset ya existente de #view-mapa, dejando el sheet
         mucho más abajo de lo pedido). */
      position: fixed;
      inset: 64px 0 0 0;
      width: 100% !important;
      height: auto !important;
      border-left-width: 0 !important;
      border-top: 1px solid var(--mel-border);
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -12px 32px rgba(25, 6, 9, 0.12);
      transform: translate3d(0, 100%, 0);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    #map-side-panel.side-panel-open {
      transform: translate3d(0, 0, 0);
    }
    #map-side-panel.side-panel-dragging {
      transition: none;
    }
    #map-side-panel-backdrop.side-panel-open {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<!-- Client Side Scripting for complete interactivity -->
<script define:vars={{ initialArchives }}>
  // -------------------------------------------------------
  // Persistent state: survives View Transition re-execution
  // -------------------------------------------------------
  if (!window._melState) {
    window._melState = {
      archives: [...initialArchives],
      filtered: [...initialArchives],
      minYear: 2004,
      maxYear: 2019,
      searchQuery: "",
      activeSidePanelKey: null,
      currentPage: 1,
      currentSortCol: null,
      currentSortDir: 'asc',
      ABSOLUTE_MIN_YEAR: 2004,
      ABSOLUTE_MAX_YEAR: 2019,
      currentDetailGroup: null,
      currentCarruselIndex: 0,
      googleMap: null,
      mapMarkers: [],
      // locKey -> { marker, group, inClusterer } — lets updateMapMarkers() update
      // an existing pin's count/active state in place instead of destroying and
      // recreating every marker on each filter change (which flashed them all).
      locationMarkers: new Map(),
      mapInitialized: false,
      mapContainerEl: null,
      infoWindow: null,
      mapCore: null,
      markerLib: null,
      googleMapClusterer: null,
      overlayAutoplayInterval: null,
      overlayCurrentIndex: 0,
    };
  }
  const _s = window._melState;

  // Aliases (writable via _s.xxx = ...)
  let archives             = _s.archives;
  let filtered             = _s.filtered;
  let minYear              = _s.minYear;
  let maxYear              = _s.maxYear;
  let searchQuery          = _s.searchQuery;
  let activeSidePanelKey   = _s.activeSidePanelKey;
  let currentPage          = _s.currentPage;
  const PAGE_SIZE          = 32;
  let currentSortCol       = _s.currentSortCol;
  let currentSortDir       = _s.currentSortDir;
  let ABSOLUTE_MIN_YEAR    = _s.ABSOLUTE_MIN_YEAR;
  let ABSOLUTE_MAX_YEAR    = _s.ABSOLUTE_MAX_YEAR;
  let currentDetailGroup   = _s.currentDetailGroup;
  let currentCarruselIndex = _s.currentCarruselIndex;

  // Helper to keep _melState in sync when we mutate these aliases
  function syncState() {
    _s.archives = archives; _s.filtered = filtered;
    _s.minYear = minYear; _s.maxYear = maxYear;
    _s.searchQuery = searchQuery; _s.activeSidePanelKey = activeSidePanelKey;
    _s.currentPage = currentPage; _s.currentSortCol = currentSortCol;
    _s.currentSortDir = currentSortDir;
    _s.ABSOLUTE_MIN_YEAR = ABSOLUTE_MIN_YEAR; _s.ABSOLUTE_MAX_YEAR = ABSOLUTE_MAX_YEAR;
    _s.currentDetailGroup = currentDetailGroup; _s.currentCarruselIndex = currentCarruselIndex;
  }

  // DOM Element refs — re-assigned in initHomePage()
  let sliderMin, sliderMax, minHandle, maxHandle, minVal, maxVal, activeFill;
  let lightbox, lightboxImg, lightboxTitle, lightboxLocation, lightboxCategory, lightboxDate, closeLightboxBtn;
  let btnPrevPage, btnNextPage, paginationNumbers;

  // Set false at the top of initHomePage() and flipped true once the initial
  // load's synchronous cascade of filterArchives() calls (slider init, the
  // search box's own startup dispatch, etc.) has settled — gallery cards
  // only get the first-load stagger-in animation while this is false, so a
  // later render triggered by that same cascade doesn't lose it, but a real
  // user-driven filter/sort/search afterwards doesn't replay it either.
  let gallerySettled = true;

  // Calculate year of event
  function getYear(dateStr) {
    if (dateStr === null || dateStr === undefined) return null;
    const str = String(dateStr).trim();
    if (!str || str === 'SIN FECHA') return null;

    // Check if it's already a 4-digit number (like "2008" or 2008)
    const numericYear = parseInt(str, 10);
    if (!isNaN(numericYear) && str.length === 4) return numericYear;

    const slashBits = str.split('/');
    if (slashBits.length === 3) {
      const yr = parseInt(slashBits[2], 10);
      if (!isNaN(yr)) return yr;
    }
    const dashBits = str.split('-');
    if (dashBits.length === 3) {
      const yr = parseInt(dashBits[0], 10);
      if (!isNaN(yr)) return yr;
    }
    const match = str.match(/\b(19\d\d|20\d\d)\b/);
    if (match) {
      return parseInt(match[1], 10);
    }
    return null;
  }

  // Hotlink extractor using the new thumbnail endpoint
  function extractDriveImage(url) {
    if (!url) return '';
    let fileId = '';
    if (url.includes('id=')) {
      fileId = url.split('id=')[1].split('&')[0];
    } else if (url.includes('/d/')) {
      fileId = url.split('/d/')[1].split('/')[0];
    }
    return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : '';
  }

  // Escapa HTML para insertarlo de forma segura en innerHTML — usado por
  // todas las réplicas JS de componentes (filas de tabla, Event Card List...).
  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // DD/MM/AAAA a partir del AAAA-MM-DD tal cual llega de la hoja (columna Fecha).
  function formatFechaDMY(fecha) {
    let formatted = fecha || '';
    if (formatted && formatted.includes('-')) {
      const parts = formatted.split('-');
      if (parts.length === 3) formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
    }
    return formatted;
  }

  // Réplica JS de EventCardList.astro (Figma "Event Card List", node
  // 291:13479 / Bottom Sheet Mobile Place Events List 439:142691): fila
  // compacta con miniatura 56x56 en fit (object-contain) sobre fondo
  // secundario, título, fecha y chevron. Compartida por el panel lateral
  // del mapa y la lista en móvil — ver AGENTS.md regla 7 si cambia el diseño.
  function buildEventCardListHtml(evt, { showDivider = true } = {}) {
    const imgSrc = extractDriveImage(evt.carruselItems?.[0]?.urlDrive) || `/flyers/flyer-1.png`;
    return `
      <div class="bg-mel-bg-secondary overflow-clip relative shrink-0 size-[56px]">
        <img src="${imgSrc}" alt="" referrerpolicy="no-referrer" class="absolute inset-0 max-w-none object-contain pointer-events-none size-full" />
      </div>
      <div class="flex flex-col flex-1 min-w-0 gap-[4px] items-start">
        <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary truncate w-full">${escHtml(evt.evento)}</p>
        <p class="font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary">${escHtml(formatFechaDMY(evt.fecha))}</p>
      </div>
      <div class="shrink-0 size-[24px] flex items-center justify-center text-mel-action-secondary group-hover:text-mel-action-primary transition-colors duration-200">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      ${showDivider ? '<div class="absolute bottom-[0.5px] h-0 left-[24px] right-[16px] border-b border-mel-border/60"></div>' : ''}
    `;
  }

  // -------------------------------------------------------
  // Galería masonry 2.1 (ver decisions.md D-015): grid + row-span medido,
  // orden aleatorio estable y scroll infinito.
  // -------------------------------------------------------
  const GALLERY_ROW = 4;   // grid-auto-rows del contenedor, en px
  const GALLERY_GAP = 24;  // hueco entre tarjetas (mel-l), horizontal y vertical

  // Cuántas tarjetas muestra la galería ahora mismo (crece por lotes de
  // PAGE_SIZE con el scroll; los filtros/búsquedas lo resetean).
  let galleryVisibleCount = PAGE_SIZE;
  // `filtered` reordenado con las claves aleatorias — lo consume el append.
  let galleryOrderedCache = [];
  let revealObserver = null;
  let sentinelObserver = null;

  // Orden aleatorio ESTABLE por sesión: cada evento recibe una clave al azar
  // la primera vez que se le ve y la conserva — así un cambio de filtro no
  // rebaraja lo que ya está en pantalla (el FLIP puede seguir cada tarjeta)
  // y añadir lotes nunca recoloca nada. Cada carga de página = orden nuevo.
  const galleryRandomKeys = new Map();
  function galleryRandKey(id) {
    if (!galleryRandomKeys.has(id)) galleryRandomKeys.set(id, Math.random());
    return galleryRandomKeys.get(id);
  }

  // Fija el row-span de una tarjeta a partir del ratio de su imagen y el
  // ancho de columna actual. `width` es opcional (una pasada de resize lo
  // lee una sola vez: todas las columnas miden lo mismo).
  function sizeGalleryCard(card, width) {
    const ratio = parseFloat(card.dataset.ratio);
    const w = width || card.clientWidth;
    if (!ratio || !w) return;
    card.style.gridRowEnd = 'span ' + Math.max(1, Math.round((w / ratio + GALLERY_GAP) / GALLERY_ROW));
    card.classList.remove('unsized');
  }

  // Llamado por el onload inline de cada <img> (y por la repesca de imágenes
  // ya completas tras cada render): publica el ratio real en la tarjeta.
  function measureFlyerImg(img) {
    const card = img.closest('.gallery-item');
    if (!card || !img.naturalWidth || !img.naturalHeight) return;
    card.dataset.ratio = String(img.naturalWidth / img.naturalHeight);
    sizeGalleryCard(card);
  }
  window.__melMeasureFlyer = measureFlyerImg;

  // Única fábrica de tarjetas de galería (render completo Y lotes del scroll
  // infinito) — réplica JS de FlyerCard.astro, ver regla 7 de CLAUDE.md.
  function buildGalleryCard(item, i) {
    const card = document.createElement('div');
    const imgSrc = extractDriveImage(item.carruselItems[0]?.urlDrive) || `/flyers/flyer-${((i % 13) + 1)}.png`;
    card.className = 'gallery-item unsized relative overflow-hidden shadow-sm group bg-white transition-all duration-300 cursor-pointer';
    card.dataset.id = item.idMel;
    card.innerHTML = `
      <!-- Image with referrerpolicy no-referrer to allow anonymous loading of Google Drive links in browsers -->
      <img src="${imgSrc}" alt="${item.evento}" referrerpolicy="no-referrer" class="w-full h-auto block pointer-events-none" style="view-transition-name: flyer-img-${item.idMel};" onload="window.__melMeasureFlyer && window.__melMeasureFlyer(this)" />

      <!-- Blending grid overlay (striped Figma style) -->
      <div class="absolute inset-0 striped-bg opacity-0 group-hover:opacity-10 transition-opacity duration-300 z-10 pointer-events-none"></div>

      <!-- Overlay info on hover -->
      <div class="absolute bottom-0 left-0 right-0 h-[32px] bg-mel-action-secondary backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 flex items-center px-4 z-20 shadow-[0px_-4px_10px_rgba(38,31,31,0.15)]">
        <p class="font-sans font-bold text-[12px] leading-[16px] tracking-[0.5px] text-mel-text-on-action truncate w-full">${item.evento}</p>
      </div>
    `;
    card.addEventListener('click', () => {
      openLightbox(item);
    });
    return card;
  }

  // Revelado al scroll: primera visita de cada tarjeta al observer — si nace
  // fuera del viewport se oculta (.reveal-pending) hasta que el scroll la
  // trae, y entonces anima su entrada con un pequeño escalonado.
  function handleRevealEntries(entries) {
    let staggerIdx = 0;
    entries.forEach(entry => {
      const card = entry.target;
      if (entry.isIntersecting) {
        if (card.classList.contains('reveal-pending')) {
          card.style.animationDelay = `${staggerIdx * 45}ms`;
          staggerIdx++;
          card.classList.remove('reveal-pending');
          card.classList.add('reveal-in');
        }
        if (revealObserver) revealObserver.unobserve(card);
      } else if (!card.classList.contains('reveal-pending') && !card.classList.contains('reveal-in')) {
        // Fuera del viewport en su primera pasada: el intro de primera carga
        // ya no le aplica (habría quedado "gastado" sin verse).
        card.classList.remove('intro-in');
        card.classList.add('reveal-pending');
      }
    });
  }

  // Scroll infinito: el centinela (#gallery-sentinel, hermano de la rejilla)
  // entra en el margen de precarga y se añade el siguiente lote SIN tocar lo
  // ya colocado. Búsquedas y filtros no interfieren: resetean
  // galleryVisibleCount y pasan por el rebuild completo de performDOMUpdates.
  function appendGalleryBatch() {
    const gridContainer = document.getElementById('gallery-grid');
    const galleryViewEl = document.getElementById('view-galería');
    if (!gridContainer || !galleryViewEl || galleryViewEl.classList.contains('hidden')) return;
    const next = galleryOrderedCache.slice(galleryVisibleCount, galleryVisibleCount + PAGE_SIZE);
    if (next.length === 0) return;
    const startIdx = galleryVisibleCount;
    galleryVisibleCount += next.length;
    next.forEach((item, i) => {
      const card = buildGalleryCard(item, startIdx + i);
      // Un lote nuevo nace siempre por debajo del viewport: directo a
      // reveal-pending, sin esperar a la primera pasada del observer.
      card.classList.add('reveal-pending');
      gridContainer.appendChild(card);
      if (revealObserver) revealObserver.observe(card);
      const img = card.querySelector('img');
      if (img && img.complete) measureFlyerImg(img);
    });
  }

  // Determine dynamic bounds
  function calculateDynamicBounds() {
    let min = Infinity;
    let max = -Infinity;
    archives.forEach(item => {
      const yr = getYear(item.fecha);
      if (yr !== null) {
        if (yr < min) min = yr;
        if (yr > max) max = yr;
      }
    });
    if (min === Infinity) min = 2004;
    if (max === -Infinity) max = 2019;
    ABSOLUTE_MIN_YEAR = min;
    ABSOLUTE_MAX_YEAR = max;

    if (sliderMin) {
      sliderMin.setAttribute('min', String(min));
      sliderMin.setAttribute('max', String(max));
    }
    if (sliderMax) {
      sliderMax.setAttribute('min', String(min));
      sliderMax.setAttribute('max', String(max));
    }
  }

  // Double Range Slider logic
  // Dragging the slider handle fires 'input' dozens of times a second — each
  // call used to run its own document.startViewTransition(), and starting a
  // new one while a previous one is still pending supersedes it, which was
  // exactly why the gallery's FLIP reorder never got to actually play during
  // a drag (only a single discrete click, giving each call room to settle,
  // worked). Coalescing into at most one filterArchives() per animation
  // frame keeps the values live-updating but stops that thrash.
  let sliderUpdateScheduled = false;
  function updateSlider() {
    if (!sliderMin || !sliderMax) return;
    let val1 = parseInt(sliderMin.value);
    let val2 = parseInt(sliderMax.value);

    // Ensure min never exceeds max — simply clamp
    if (val1 > val2) {
      val1 = val2;
      sliderMin.value = String(val1);
    }

    minYear = val1;
    maxYear = val2;

    // Reset pagination to first page when filtering changes
    currentPage = 1;
    // La galería vuelve a su primer lote de scroll infinito y al inicio del
    // scroll: quedarse a media profundidad sobre un resultado recién
    // encogido dejaba al usuario varado entre huecos.
    galleryVisibleCount = PAGE_SIZE;
    const galleryScroller = document.getElementById('view-galería');
    if (galleryScroller) galleryScroller.scrollTop = 0;

    if (sliderUpdateScheduled) return;
    sliderUpdateScheduled = true;
    requestAnimationFrame(() => {
      sliderUpdateScheduled = false;
      filterArchives();
    });
  }

  // Bind Slider Events — called from initHomePage()
  function bindSliderEvents() {
    if (sliderMin) sliderMin.addEventListener('input', updateSlider);
    if (sliderMax) sliderMax.addEventListener('input', updateSlider);
  }

  // Carousel Render inside Lightbox
  function updateLightboxCarousel() {
    if (!currentDetailGroup) return;
    const items = currentDetailGroup.carruselItems;
    const activeItem = items[currentCarruselIndex];
    lightboxImg.src = extractDriveImage(activeItem.urlDrive);
    
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const dotsContainer = document.getElementById('lightbox-dots');
    
    dotsContainer.innerHTML = '';
    
    if (items.length > 1) {
      prevBtn.classList.remove('hidden');
      nextBtn.classList.remove('hidden');
      
      items.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = `w-2 h-2 cursor-pointer transition-colors border border-mel-border ${idx === currentCarruselIndex ? 'bg-mel-action-secondary' : 'bg-white/60'}`;
        dot.addEventListener('click', () => {
          currentCarruselIndex = idx;
          updateLightboxCarousel();
        });
        dotsContainer.appendChild(dot);
      });
    } else {
      prevBtn.classList.add('hidden');
      nextBtn.classList.add('hidden');
    }
  }

  // Opening an event from ANY entry point (gallery card, list row, map
  // popup) uses the same in-place SPA overlay the map panel uses — the old
  // full-page navigation to /event/… (with its forced reload, needed there
  // to dodge the router's stale-snapshot cache) made gallery/list feel
  // heavy next to the panel's smooth fade. Prev/next inside the overlay
  // walks the currently filtered + sorted list, so it respects whatever
  // search/year/sort context the visitor is in. The /event/[id] page still
  // exists server-rendered for direct and shared links.
  function openLightbox(item) {
    openDetailsOverlaySPA(item, filtered.length ? filtered : archives);
  }

  function closeLightbox() {
    lightbox.classList.remove('flex');
    lightbox.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    currentDetailGroup = null;
  }

  // Lightbox bindings — called from initHomePage()
  function bindLightboxEvents() {
    if (closeLightboxBtn) closeLightboxBtn.addEventListener('click', closeLightbox);
    if (lightbox) lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    const lbPrev = document.getElementById('lightbox-prev');
    const lbNext = document.getElementById('lightbox-next');
    if (lbPrev) lbPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentDetailGroup) return;
      const items = currentDetailGroup.carruselItems;
      currentCarruselIndex = (currentCarruselIndex - 1 + items.length) % items.length;
      syncState();
      updateLightboxCarousel();
    });
    if (lbNext) lbNext.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentDetailGroup) return;
      const items = currentDetailGroup.carruselItems;
      currentCarruselIndex = (currentCarruselIndex + 1) % items.length;
      syncState();
      updateLightboxCarousel();
    });
  }

  function bindInitialCardClicks() {
    document.querySelectorAll('.gallery-item').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const item = archives.find(x => x.idMel === id);
        if (item) openLightbox(item);
      });
    });
  }

  // Smooth numeric counter roll animation
  function animateValue(obj, start, end, duration = 250) {
    if (start === end) return;
    let startTimestamp = null;
    const step = (timestamp) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      obj.textContent = Math.floor(progress * (end - start) + start);
      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        obj.textContent = end;
      }
    };
    window.requestAnimationFrame(step);
  }

  // Filter Archives by Year & Search Query and Recalculate unique counts
  function filterArchives(shouldFitBounds = false) {
    let tempFiltered = archives.filter(item => {
      const yr = getYear(item.fecha);
      const yearMatch = yr >= minYear && yr <= maxYear;
      
      const searchMatch = !searchQuery || 
        item.evento.toLowerCase().includes(searchQuery) || 
        item.lugar.toLowerCase().includes(searchQuery) ||
        item.localidad.toLowerCase().includes(searchQuery) ||
        item.artistas.toLowerCase().includes(searchQuery) ||
        item.organiza.toLowerCase().includes(searchQuery) ||
        item.disenador.toLowerCase().includes(searchQuery);
        
      return yearMatch && searchMatch;
    });

    // Apply sorting
    if (currentSortCol) {
      if (currentSortCol === 'fecha') {
        tempFiltered.sort((a, b) => {
          const parseDate = (dStr) => {
            if (!dStr || dStr === 'SIN FECHA') return 0;
            const parts = dStr.split('/');
            if (parts.length === 3) return new Date(parts[2], parts[1]-1, parts[0]).getTime();
            const parts2 = dStr.split('-');
            if (parts2.length === 3) return new Date(parts2[0], parts2[1]-1, parts2[2]).getTime();
            return 0;
          };
          const valA = parseDate(a.fecha);
          const valB = parseDate(b.fecha);
          return currentSortDir === 'asc' ? valA - valB : valB - valA;
        });
      } else {
        tempFiltered.sort((a, b) => {
          const dbField = currentSortCol === 'disenador' ? 'disenador' : currentSortCol;
          const valA = (a[dbField] || '').toLowerCase().trim();
          const valB = (b[dbField] || '').toLowerCase().trim();
          if (!valA || valA === 'desconocido') return 1;
          if (!valB || valB === 'desconocido') return -1;
          return currentSortDir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        });
      }
    } else {
      // Default order: chronological ascending
      tempFiltered.sort((a, b) => {
        const parseDate = (dStr) => {
          if (!dStr || dStr === 'SIN FECHA') return 0;
          const parts = dStr.split('/');
          if (parts.length === 3) return new Date(parts[2], parts[1]-1, parts[0]).getTime();
          const parts2 = dStr.split('-');
          if (parts2.length === 3) return new Date(parts2[0], parts2[1]-1, parts2[2]).getTime();
          return 0;
        };
        return parseDate(a.fecha) - parseDate(b.fecha);
      });
    }

    filtered = tempFiltered;

    // 1. Calculate dynamic statistics on the fly
    const filteredArtists = new Set();
    const filteredDesigners = new Set();
    const filteredPromoters = new Set();
    
    filtered.forEach(item => {
      if (item.artistas) {
        item.artistas.split(/[,;\/]+/).forEach(a => {
          const cleanA = a.trim().toLowerCase();
          if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') filteredArtists.add(cleanA);
        });
      }
      if (item.organiza) {
        const cleanP = item.organiza.trim().toLowerCase();
        if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') filteredPromoters.add(cleanP);
      }
      if (item.disenador) {
        const cleanD = item.disenador.trim().toLowerCase();
        if (cleanD && cleanD !== 'desconocido') filteredDesigners.add(cleanD);
      }
    });

    const stats = {
      "Eventos": filtered.length,
      "Artistas": filteredArtists.size,
      "Diseñadores": filteredDesigners.size,
      "Promotores": filteredPromoters.size
    };

    // Run dynamic counter roll animations
    for (const [label, count] of Object.entries(stats)) {
      const badge = document.querySelector(`.filter-tag[data-category="${label}"] .tag-count-val`);
      if (badge) {
        const startVal = parseInt(badge.textContent) || 0;
        animateValue(badge, startVal, count, 200);
      }
    }

    const performDOMUpdates = () => {
      // 2. Paginate filtered dataset
      const totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      
      const paginated = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

      // La galería va por libre (D-015): ignora la paginación (scroll
      // infinito por lotes) y el orden de `filtered` (orden aleatorio
      // estable por sesión). `paginated` sigue siendo el corte de la lista.
      galleryOrderedCache = [...filtered].sort((a, b) => galleryRandKey(a.idMel) - galleryRandKey(b.idMel));
      if (galleryVisibleCount < PAGE_SIZE) galleryVisibleCount = PAGE_SIZE;
      const galleryShown = galleryOrderedCache.slice(0, galleryVisibleCount);

      // Update pagination UI controls
      if (paginationNumbers) {
        paginationNumbers.innerHTML = '';
        for (let p = 1; p <= totalPages; p++) {
          const btn = document.createElement('button');
          if (p === currentPage) {
            btn.className = "relative shrink-0 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer font-serif font-medium text-[16px] leading-[24px] text-mel-action-primary tracking-[0.16px]";
            btn.innerHTML = `
              <span>${p}</span>
              <div class="absolute bottom-1 left-0 right-0 h-[2px] flex justify-center">
                <svg width="12" height="2" viewBox="0 0 12 2" fill="none" class="text-mel-action-primary">
                  <path d="M1 1C4.33333 1 7.66667 1 11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
            `;
          } else {
            btn.className = "relative shrink-0 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer font-serif font-medium text-[16px] leading-[24px] text-mel-text-secondary tracking-[0.16px] hover:text-mel-action-primary transition-colors duration-200";
            btn.innerHTML = `<span>${p}</span>`;
            btn.addEventListener('click', () => {
              currentPage = p;
              filterArchives();
            });
          }
          paginationNumbers.appendChild(btn);
        }
      }
      
      if (btnPrevPage) {
        if (currentPage === 1) {
          btnPrevPage.setAttribute('disabled', 'true');
        } else {
          btnPrevPage.removeAttribute('disabled');
        }
      }
      
      if (btnNextPage) {
        if (currentPage === totalPages) {
          btnNextPage.setAttribute('disabled', 'true');
        } else {
          btnNextPage.removeAttribute('disabled');
        }
      }

      // 3. Populate Gallery Grid View
      const gridContainer = document.getElementById('gallery-grid');

      // FLIP reorder animation (same technique as the list view): record
      // each card's current position before wiping the grid, so cards that
      // persist across a filter/search/sort change can glide from their old
      // spot to their new one instead of just popping into place — the date
      // slider was the one thing that still didn't reorder with any motion.
      // Cards that are about to disappear entirely (no longer in the new
      // filtered set) don't just get wiped out instantly either — they get
      // cloned into a fixed-in-place, fading placeholder first (see below),
      // which is what made removals look abrupt next to the smooth entrance
      // cards already had.
      const galleryViewEl = document.getElementById('view-galería');
      const isGalleryVisible = galleryViewEl && !galleryViewEl.classList.contains('hidden');
      const oldCardRects = new Map();
      const exitingCardClones = [];
      if (isGalleryVisible && gallerySettled) {
        const newIdsSet = new Set(galleryShown.map(item => item.idMel));
        const gridRectForExit = gridContainer.getBoundingClientRect();
        Array.from(gridContainer.children).forEach(card => {
          if (!card.dataset || !card.dataset.id) return;
          const cardRect = card.getBoundingClientRect();
          oldCardRects.set(card.dataset.id, cardRect);
          if (!newIdsSet.has(card.dataset.id)) {
            // Positioned absolutely *relative to the grid itself* (not the
            // viewport) so it stays inside the same overflow-clipped scroll
            // container as everything else, instead of a position:fixed
            // clone that would ignore that clipping and could show up
            // overlapping unrelated page chrome below the grid.
            const clone = card.cloneNode(true);
            // El clon es puro atrezzo de salida: sin id, ni el FLIP del
            // siguiente render ni el observer de revelado deben verlo.
            delete clone.dataset.id;
            clone.style.position = 'absolute';
            clone.style.left = (cardRect.left - gridRectForExit.left) + 'px';
            clone.style.top = (cardRect.top - gridRectForExit.top) + 'px';
            clone.style.width = cardRect.width + 'px';
            clone.style.height = cardRect.height + 'px';
            clone.style.margin = '0';
            clone.style.zIndex = '1';
            clone.style.pointerEvents = 'none';
            exitingCardClones.push(clone);
          }
        });
      }

      // Las tarjetas antiguas van a desaparecer: suelta sus observaciones de
      // revelado antes de recrearlas (el rebuild vuelve a armar las nuevas).
      if (revealObserver) revealObserver.disconnect();
      gridContainer.innerHTML = '';

      if (filtered.length === 0) {
        gridContainer.className = 'w-full flex items-center justify-center py-12 relative';
        gridContainer.innerHTML = `
          <div class="flex flex-col gap-[32px] items-center p-[24px] relative text-center max-w-[400px] w-full mx-auto" data-name="Empty State">
            <div class="h-[240px] w-[320px] overflow-hidden relative shrink-0 border border-mel-border/40 flex items-center justify-center select-none" data-name="Empty State Image">
              <img src="/empty-state-no-results.png" alt="" class="absolute inset-0 size-full pointer-events-none object-bottom" />
              <div class="absolute inset-0 bg-[var(--mel-primitive-le-900)] mix-blend-screen pointer-events-none"></div>
            </div>
            <div class="flex flex-col gap-[16px] items-center w-full" data-name="Text">
              <h2 class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary w-full m-0">Sin resultados</h2>
              <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-secondary w-full m-0">Comprueba los filtros y prueba buscando otra cosa.</p>
            </div>
          </div>
        `;
      } else {
        // relative: anchors the absolutely-positioned exiting-card clones
        // below to this element instead of the viewport. Deliberately not
        // giving this its own overflow:hidden too — an exiting card is
        // positioned using its *old* (pre-removal) coordinates, which can
        // sit below the grid's new, possibly-shorter content height once
        // other cards are gone, and clipping at the grid's own box would cut
        // it off immediately instead of letting it fade. The ancestor
        // #view-galería's own overflow-y-auto already contains everything
        // to the actual visible scroll area, which is what matters.
        // El pb fijo reserva el aire inferior: en galería ya no hay módulo de
        // paginación (scroll infinito), así que siempre el hueco grande.
        gridContainer.className = `grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-mel-l auto-rows-[4px] w-full pb-[13vh] relative`;
        galleryShown.forEach((item, i) => {
          const card = buildGalleryCard(item, i);
          if (!gallerySettled) card.classList.add('intro-in');
          gridContainer.appendChild(card);
        });
        // Repesca: las imágenes ya en caché pueden haber completado antes de
        // que su onload inline llegara a registrarse tras el innerHTML.
        gridContainer.querySelectorAll('img').forEach(img => {
          if (img.complete) measureFlyerImg(img);
        });

        // First-load entrance: stagger so the reveal sweeps in from the
        // bottom-right — cards later in reading order (DOM order, which in a
        // row-dense grid trends toward the bottom-right) start first,
        // earlier ones (top-left) start last, so it reads as if the wave
        // arrives from that corner.
        if (!gallerySettled) {
          const introCards = gridContainer.querySelectorAll('.gallery-item.intro-in');
          const total = introCards.length;
          introCards.forEach((card, idx) => {
            card.style.animationDelay = `${(total - 1 - idx) * 25}ms`;
          });
        } else if (isGalleryVisible && oldCardRects.size > 0) {
          // FLIP "play" step — cards matched by id (both X and Y, since the
          // dense grid can reshuffle a card into a completely different
          // column, not just a different row) glide from old to new; cards
          // genuinely new to the visible page fade in instead.
          const newCards = Array.from(gridContainer.children).filter(c => c.dataset && c.dataset.id);
          const toPlay = [];
          newCards.forEach(card => {
            const oldRect = oldCardRects.get(card.dataset.id);
            if (oldRect) {
              const newRect = card.getBoundingClientRect();
              const deltaX = oldRect.left - newRect.left;
              const deltaY = oldRect.top - newRect.top;
              if (Math.abs(deltaX) > 1 || Math.abs(deltaY) > 1) {
                card.style.transition = 'none';
                card.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
                toPlay.push(card);
              }
            } else {
              card.classList.add('intro-in');
              card.style.animationDelay = '0ms';
            }
          });
          if (toPlay.length > 0) {
            void gridContainer.offsetHeight;
            requestAnimationFrame(() => {
              toPlay.forEach(card => {
                card.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
                card.style.transform = '';
              });
              setTimeout(() => {
                toPlay.forEach(card => { card.style.transition = ''; card.style.transform = ''; });
              }, 420);
            });
          }
        }

        // Play the exit fade for cards that dropped out of the filtered
        // set entirely — appended into the (now rebuilt) grid so they sit
        // in the same clipped scroll container as everything else, then
        // faded + shrunk away and removed once the transition finishes.
        if (exitingCardClones.length > 0) {
          exitingCardClones.forEach(clone => gridContainer.appendChild(clone));
          void gridContainer.offsetHeight;
          requestAnimationFrame(() => {
            exitingCardClones.forEach(clone => {
              clone.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
              clone.style.opacity = '0';
              clone.style.transform = 'scale(0.94)';
            });
            setTimeout(() => {
              exitingCardClones.forEach(clone => clone.remove());
            }, 320);
          });
        }

        // Arma el revelado al scroll para todas las tarjetas recién creadas:
        // las que ya están a la vista quedan como están (intro/FLIP); las que
        // nacen por debajo del viewport se ocultan y entran animadas al llegar
        // el scroll (ver handleRevealEntries).
        if (revealObserver) {
          Array.from(gridContainer.children).forEach(card => {
            if (card.dataset && card.dataset.id) revealObserver.observe(card);
          });
        }
      }

      // 4. Populate List view (matching the paginated dataset of size 32)
      const listBody = document.getElementById('list-table-body');
      const listTable = listBody ? listBody.closest('table') : null;
      if (listBody) {
        // FLIP reorder animation: record each row's current position (keyed
        // by event id) before wiping the table, so we can slide rows from
        // their old spot to their new one after rebuilding. This uses plain
        // `transform`, not view-transition-name, specifically so it stays
        // contained by the table's own overflow clipping instead of
        // escaping it via the browser's top layer (see the NOTE below on
        // why rows don't carry a view-transition-name).
        const listViewEl = document.getElementById('view-lista');
        const isListVisible = listViewEl && !listViewEl.classList.contains('hidden');
        const oldRowRects = new Map();
        if (isListVisible) {
          Array.from(listBody.children).forEach(tr => {
            if (tr.dataset && tr.dataset.id) oldRowRects.set(tr.dataset.id, tr.getBoundingClientRect());
          });
        }

        listBody.innerHTML = '';

        if (paginated.length === 0) {
          // height:100% on the table/row/cell chain — without it, this single
          // short row only takes its own natural height, leaving a tall blank
          // gap below it up to where the (now-hidden, since totalPages<=1)
          // pagination module used to start. This makes it fill that same
          // space instead, centered, matching the gallery/list's own no-results state.
          listTable.style.height = '100%';
          listBody.innerHTML = `
            <tr style="height:100%;">
              <td colspan="6" class="border-l border-r border-b border-mel-border bg-mel-bg-primary" style="height:100%;">
                <div class="flex flex-col gap-[32px] items-center p-[24px] relative text-center max-w-[400px] w-full mx-auto h-full justify-center" data-name="Empty State">
                  <div class="h-[240px] w-[320px] overflow-hidden relative shrink-0 border border-mel-border/40 flex items-center justify-center select-none" data-name="Empty State Image">
                    <img src="/empty-state-no-results.png" alt="" class="absolute inset-0 size-full pointer-events-none object-bottom" />
                    <div class="absolute inset-0 bg-[var(--mel-primitive-le-900)] mix-blend-screen pointer-events-none"></div>
                  </div>
                  <div class="flex flex-col gap-[16px] items-center w-full" data-name="Text">
                    <h2 class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary w-full m-0">Sin resultados</h2>
                    <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-secondary w-full m-0">Comprueba los filtros y prueba buscando otra cosa.</p>
                  </div>
                </div>
              </td>
            </tr>
          `;
        } else {
          listTable.style.height = '';
          paginated.forEach(item => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-mel-bg-secondary/10 transition-colors';
            tr.dataset.id = item.idMel;
            // NOTE: rows must NOT get a per-row view-transition-name. Sorting
            // and pagination re-render inside document.startViewTransition,
            // and named elements get morphed from old to new position in the
            // browser's top layer — which ignores the table's overflow
            // clipping, so rows visibly flew above/below the table. Unnamed
            // rows just take part in the root cross-fade, which stays put.
            
            // Format date nicely to DD/MM/YYYY
            const formattedDate = formatFechaDMY(item.fecha);

            // Get first image for preview thumbnail via extractDriveImage
            let firstImg = '';
            if (item.carruselItems && item.carruselItems.length > 0) {
              firstImg = extractDriveImage(item.carruselItems[0].urlDrive);
            }

            tr.innerHTML = `
              <td class="border-l border-r border-mel-border bg-mel-bg-primary p-2">
                <div class="flex gap-[12px] h-[48px] items-center min-w-0">
                  <div class="bg-mel-bg-secondary w-[40px] h-full overflow-clip flex items-center justify-center shrink-0">
                    ${firstImg ? `<img alt="" class="list-img-link object-contain w-full h-full cursor-pointer hover:brightness-110 transition-all duration-200" data-id="${item.idMel}" src="${firstImg}" referrerpolicy="no-referrer" />` : ''}
                  </div>
                  <span class="font-sans font-medium text-[17px] leading-[24px] text-mel-action-secondary hover:text-mel-action-primary transition-colors duration-200 cursor-pointer event-title-link marquee-cell flex-1 min-w-0" data-id="${item.idMel}">
                    <span class="marquee-inner">${escHtml(item.evento)}<span class="table-link-underline"></span></span>
                    <svg class="title-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </span>
                </div>
              </td>
              <td class="border-l border-r border-mel-border bg-mel-bg-primary px-4 py-2 font-serif font-medium text-[16px] text-mel-text-secondary leading-[24px] tracking-[0.16px] marquee-cell">
                <span class="marquee-inner">${escHtml(formattedDate)}</span>
              </td>
              <td class="border-l border-r border-mel-border bg-mel-bg-primary px-4 py-2 font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] marquee-cell">
                ${item.lugar && item.lugar.toLowerCase() !== 'desconocido' 
                  ? `<span class="marquee-inner search-cell-link" data-search="${escHtml(item.lugar)}">${escHtml(item.lugar)}<span class="table-link-underline"></span></span>`
                  : '<span class="marquee-inner text-mel-text-tertiary opacity-60">desconocido</span>'
                }
              </td>
              <td class="border-l border-r border-mel-border bg-mel-bg-primary px-4 py-2 font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] marquee-cell">
                ${item.localidad && item.localidad.toLowerCase() !== 'desconocido' 
                  ? `<span class="marquee-inner search-cell-link" data-search="${escHtml(item.localidad)}">${escHtml(item.localidad)}<span class="table-link-underline"></span></span>`
                  : '<span class="marquee-inner text-mel-text-tertiary opacity-60">desconocido</span>'
                }
              </td>
              <td class="border-l border-r border-mel-border bg-mel-bg-primary px-4 py-2 font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] marquee-cell">
                ${item.organiza && item.organiza.toLowerCase() !== 'desconocido' 
                  ? `<span class="marquee-inner search-cell-link" data-search="${escHtml(item.organiza)}">${escHtml(item.organiza)}<span class="table-link-underline"></span></span>`
                  : '<span class="marquee-inner text-mel-text-tertiary opacity-60">desconocido</span>'
                }
              </td>
              <td class="border-l border-r border-mel-border bg-mel-bg-primary px-4 py-2 font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] marquee-cell">
                ${item.disenador && item.disenador.toLowerCase() !== 'desconocido' 
                  ? `<span class="marquee-inner search-cell-link" data-search="${escHtml(item.disenador)}">${escHtml(item.disenador)}<span class="table-link-underline"></span></span>` 
                  : '<span class="marquee-inner text-mel-text-tertiary opacity-60">desconocido</span>'
                }
              </td>
            `;
            listBody.appendChild(tr);
          });

          // FLIP "play" step: rows that existed before (matched by id) get
          // slid from their old position to the new one; rows that are
          // genuinely new to the visible page (revealed by a search/sort/
          // filter change) get a small fade-in instead, since they have no
          // "old" position to animate from.
          if (isListVisible) {
            const newRows = Array.from(listBody.children).filter(tr => tr.dataset && tr.dataset.id);
            const toPlay = [];
            newRows.forEach(tr => {
              const oldRect = oldRowRects.get(tr.dataset.id);
              if (oldRect) {
                const newRect = tr.getBoundingClientRect();
                const deltaY = oldRect.top - newRect.top;
                if (Math.abs(deltaY) > 1) {
                  tr.style.transition = 'none';
                  tr.style.transform = `translateY(${deltaY}px)`;
                  toPlay.push(tr);
                }
              } else if (oldRowRects.size > 0) {
                // Only treat rows as "new" once we actually have a previous
                // render to compare against — otherwise every row on the
                // very first list render would replay the intro pointlessly.
                tr.classList.add('list-row-intro');
              }
            });
            if (toPlay.length > 0) {
              // Force layout so the inverted transform above is committed
              // before we transition it away, then let it glide to rest.
              void listBody.offsetHeight;
              requestAnimationFrame(() => {
                toPlay.forEach(tr => {
