        <div class="grid grid-cols-1 lg:grid-cols-[184px_496px_496px] gap-8 lg:gap-6 items-start w-full lg:h-[400px]">

          <!-- Column 1: Tags Sidebar. h-[400px]+justify-between matches the image column's own
