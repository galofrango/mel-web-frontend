---
import Layout from '../layouts/Layout.astro';
import HeaderTitle from '../components/HeaderTitle.astro';
import MenuItem from '../components/MenuItem.astro';
import SideMenu from '../components/SideMenu.astro';
import TimeSlider from '../components/TimeSlider.astro';
import TagWithLink from '../components/TagWithLink.astro';
import ToggleSelector from '../components/ToggleSelector.astro';
import FlyerCard from '../components/FlyerCard.astro';
import IconButton from '../components/IconButton.astro';
import IntroAnimation from '../components/IntroAnimation.astro';
import BottomSheetHeader from '../components/BottomSheetHeader.astro';

// Extract Year from Date String
function getYear(dateStr) {
  if (!dateStr || dateStr === 'SIN FECHA') return null;
  const slashBits = dateStr.split('/');
  if (slashBits.length === 3) {
    const yr = parseInt(slashBits[2], 10);
    if (!isNaN(yr)) return yr;
  }
  const dashBits = dateStr.split('-');
  if (dashBits.length === 3) {
    const yr = parseInt(dashBits[0], 10);
    if (!isNaN(yr)) return yr;
  }
  const match = dateStr.match(/\b(19\d\d|20\d\d)\b/);
  if (match) {
    return parseInt(match[1], 10);
  }
  return null;
}

// Direct hotlink builder to bypass drive authentication/cors
function extractDriveImage(url) {
  if (!url) return '';
  let fileId = '';
  if (url.includes('id=')) {
    fileId = url.split('id=')[1].split('&')[0];
  } else if (url.includes('/d/')) {
    fileId = url.split('/d/')[1].split('/')[0];
  }
  return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000` : '';
}

// Fetch and Group Sheets Google Viz JSON Database
const SHEET_ID = '1buzisIlDkCo2Rj5BYZh5-JKrAYSo3RSuBXYmJVGYT0E';
const CONFIG_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json`;

let initialArchives = [];
const initialArtists = new Set();
const initialDesigners = new Set();
const initialPromoters = new Set();

try {
  const response = await fetch(CONFIG_URL);
  const text = await response.text();
  const match = text.match(/google\.visualization\.Query\.setResponse\(([\s\S]*?)\);/);
  
  if (match && match[1]) {
    const cleanJson = JSON.parse(match[1]);
    const rows = cleanJson.table.rows;
    
    const rawItems = rows.map((row) => {
      const c = row.c;
      if (!c) return null;
      return {
        evento: c[0] ? c[0].v : 'Evento sin título',
        urlDrive: c[2] ? c[2].v : '',
        fecha: c[3] ? c[3].f || c[3].v : 'SIN FECHA',
        lugar: c[4] ? c[4].v : 'León',
        localidad: c[5] ? c[5].v : '',
        coordenadas: c[6] ? c[6].v : '',
        artistas: c[7] ? c[7].v : '',
        organiza: c[8] ? c[8].v : '',
        descripcion: c[9] ? c[9].v : '',
        idMel: c[10] ? c[10].v : '',
        carruselOrder: c[11] ? c[11].v : '1',
        disenador: c[13] ? c[13].v : 'Desconocido',
        existeOriginal: c[16] ? c[16].v : '',
        formato: c[21] ? c[21].v : 'Flyer',
        notasArchivo: c[24] ? c[24].v : '',
        ocr: c[25] ? c[25].v : ''
      };
    }).filter(item => item && item.idMel && item.idMel.startsWith('MEL-'));
    
    // Group by Event Name + Date
    const groups = {};
    rawItems.forEach(item => {
      const key = `${item.evento.trim().toLowerCase()}_${item.fecha.trim().toLowerCase()}`;
      if (!groups[key]) {
        groups[key] = {
          evento: item.evento,
          fecha: item.fecha,
          carruselItems: [],
          lugar: item.lugar,
          localidad: item.localidad,
          coordenadas: item.coordenadas,
          artistas: item.artistas,
          organiza: item.organiza,
          descripcion: item.descripcion,
          disenador: item.disenador,
          existeOriginal: item.existeOriginal,
          formato: item.formato,
          notasArchivo: item.notasArchivo,
          ocr: item.ocr,
          idMel: item.idMel
        };
      }
      groups[key].carruselItems.push({
        urlDrive: item.urlDrive,
        carruselOrder: parseInt(item.carruselOrder, 10) || 1,
        idMel: item.idMel
      });
    });
    function parseDateToNumber(dateStr) {
      if (!dateStr || dateStr === 'SIN FECHA') return 0;
      const slashBits = dateStr.split('/');
      if (slashBits.length === 3) {
        const d = parseInt(slashBits[0], 10);
        const m = parseInt(slashBits[1], 10) - 1;
        const y = parseInt(slashBits[2], 10);
        return new Date(y, m, d).getTime();
      }
      const dashBits = dateStr.split('-');
      if (dashBits.length === 3) {
        const y = parseInt(dashBits[0], 10);
        const m = parseInt(dashBits[1], 10) - 1;
        const d = parseInt(dashBits[2], 10);
        return new Date(y, m, d).getTime();
      }
      return 0;
    }

    initialArchives = Object.values(groups).map((g: any) => {
      g.carruselItems.sort((a, b) => a.carruselOrder - b.carruselOrder);
      return g;
    });

    // Sort by date ascending
    initialArchives.sort((a, b) => {
      const timeA = parseDateToNumber(a.fecha);
      const timeB = parseDateToNumber(b.fecha);
      return timeA - timeB;
    });
    
    // Gather initial unique statistics
    initialArchives.forEach(item => {
      if (item.artistas) {
        item.artistas.split(/[,;\/]+/).forEach(a => {
          const cleanA = a.trim().toLowerCase();
          if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') initialArtists.add(cleanA);
        });
      }
      if (item.organiza) {
        const cleanP = item.organiza.trim().toLowerCase();
        if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') initialPromoters.add(cleanP);
      }
      if (item.disenador) {
        const cleanD = item.disenador.trim().toLowerCase();
        if (cleanD && cleanD !== 'desconocido') initialDesigners.add(cleanD);
      }
    });
  }
} catch (e) {
  console.error("Error fetching or parsing GSheets JSON database", e);
}

// Mapped stats matching Figma TagWithLink instances exactly
const tags = [
  { label: "Eventos", count: initialArchives.length },
  { label: "Artistas", count: initialArtists.size },
  { label: "Diseñadores", count: initialDesigners.size },
  { label: "Promotores", count: initialPromoters.size }
];

// Orden aleatorio de la galería (ver decisions.md D-015): cada visita baraja
// el archivo entero (Fisher-Yates) — la galería es deliberadamente "random",
// pensada para quien entra a mirar sin buscar nada concreto. El cliente
// siembra sus claves aleatorias con este mismo orden al arrancar.
const shuffledArchives = [...initialArchives];
for (let i = shuffledArchives.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledArchives[i], shuffledArchives[j]] = [shuffledArchives[j], shuffledArchives[i]];
}
---

<Layout title="Galería de Diseño">
  <!-- Top/bottom paddings are viewport-relative (tuned against the 4K reference:
       112px top / 32px bottom at ~1100px of viewport height ≈ 10vh / 3vh) so
       smaller screens don't waste fixed pixel gaps. -->
  <div class="w-full max-w-[1440px] h-screen mx-auto bg-mel-bg-primary px-6 sm:px-12 md:px-[108px] pt-[10vh] pb-[3vh] flex flex-col gap-6 overflow-hidden" data-node-id="Screen / Desktop / Gallery">
    
    <!-- Page Header: Search (Typing Title prompt) and Menu. Single row on every
         breakpoint — on mobile the title collapses to "M.E.L." and the menu to
         its icon (see HeaderTitle/MenuItem), the search stretches over all the
         remaining width, and the gap to the menu button is exactly 16px. -->
    <div class="flex items-center gap-4 md:grid md:grid-cols-12 md:gap-6 shrink-0" style="view-transition-name: mel-header;">
      <div class="flex-1 min-w-0 md:col-span-6 w-full">
        <HeaderTitle hideDivider={true} />
      </div>
      <div class="shrink-0 md:col-span-6 flex justify-end">
        <MenuItem id="menu-btn" />
      </div>
    </div>

    <!-- Toolbar: Slider & Controls. Solo pb (no pt): el hueco hasta la cabecera
         lo da únicamente el gap-6 del contenedor padre — más ajustado, como en
         el mockup de Figma (439:140952) donde el toolbar arranca pegado a la
         cabecera. -->
    <div class="flex flex-col gap-6 pb-4 shrink-0" style="view-transition-name: mel-toolbar;">
      <!-- Year Slider Bar (Removed text header label as requested). On mobile the
           slider runs full-bleed to the screen edges (negative margins cancel the
           page's px-6), per the mobile toolbar design (Figma 315:17658). -->
      <div class="flex flex-col gap-2 -mx-6 sm:mx-0">
        <TimeSlider />
      </div>

      <!-- Filter Tags and View Switcher -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center mt-2">
        <!-- Event Stats Tags (TagWithLink). Desktop (lg+): an 8-column sub-grid
             (matching the parent toolbar's own gap-6) so every tag is exactly 2
             columns wide, one gap away from the view toggle. Mobile (Figma
             369:31311): tags shrink to their content and the row scrolls
             horizontally instead. -->
        <div class="col-span-12 lg:col-span-8 flex lg:grid lg:grid-cols-8 gap-6 items-center w-full overflow-x-auto lg:overflow-visible no-scrollbar">
          {tags.map((tag) => (
            <TagWithLink label={tag.label} count={tag.count} class="shrink-0 lg:shrink lg:col-span-2 w-auto" />
          ))}
        </div>

        <!-- View Selector Toggle (Occupying exactly 4 columns) -->
        <div class="col-span-12 lg:col-span-4 w-full">
          <ToggleSelector />
        </div>
      </div>
    </div>

    <!-- Main Visual Space: Galería / Mapa / Lista dynamic views -->
    <div id="content-views" class="relative flex-1 min-h-0 w-full overflow-visible flex flex-col justify-between transition-colors duration-300 -mt-[8px]">

      <!-- 1. GALLERY VIEW (masonry 2.1: CSS Grid + row-span medido por imagen,
           cada flyer entero a ancho de columna y ratio original, sin recortes;
           orden aleatorio, scroll infinito vía #gallery-sentinel. Ver
           decisions.md D-014/D-015; galeria-1.0 es el tag de la rejilla
           antigua de alturas fijas). -->
      <!-- Negative side margins + matching padding make the scroll container clip
           44px OUTSIDE the grid on the sides and 24px above it, so hovered cards
           (scale + shadow) aren't cut off at the edges while the grid stays
           full-width. Bottom breathing room lives on the grid itself (pb) because
           a scroll container's own padding-bottom is dropped from the scrollable
           area, so it wouldn't reserve space at the end of the scroll. -->
      <div id="view-galería" class="view-panel active flex-1 w-[calc(100%+88px)] -ml-[44px] overflow-y-auto transition-all duration-500 px-[44px] pt-[24px]">
        <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-mel-l auto-rows-[4px] w-full pb-[13vh]">
          {shuffledArchives.slice(0, 32).map((item, i) => {
            const imgSrc = extractDriveImage(item.carruselItems[0]?.urlDrive) || `/flyers/flyer-${((i % 13) + 1)}.png`;
            const yr = getYear(item.fecha) || 2004;
            return (
              <FlyerCard
                id={item.idMel}
                title={item.evento}
                category={item.organiza || "Colectivo"}
                location={`${item.lugar}. ${item.localidad}`}
                year={yr}
                image={imgSrc}
              />
            );
          })}
        </div>
        <!-- Centinela del scroll infinito: cuando entra en el margen de
             precarga del IntersectionObserver (~1200px antes de ser visible)
             se añade el siguiente lote de tarjetas. -->
        <div id="gallery-sentinel" class="h-px w-full" aria-hidden="true"></div>
      </div>

      <!-- 2. MAP VIEW (Real Google Map with sliding side panel). top-[24px] instead of
           inset-0's implicit top-0 matches the gallery's own pt-[24px], which it needed so
           hovered cards' shadows didn't get clipped against the toolbar — without this, map/list
           content sat visibly closer to the toolbar than the gallery's first row of cards. -->
      <div id="view-mapa" class="view-panel hidden absolute top-[24px] right-0 bottom-0 left-0 overflow-hidden flex">
        <div id="map-container" class="flex-1 h-full"></div>

        <!-- Dim: solo bottom sheet en móvil. Mismo color/opacidad que el
             lightbox de imagen del detalle de evento (le-950/80, D-022). -->
        <div
          id="map-side-panel-backdrop"
          class="md:hidden fixed inset-0 bg-[var(--mel-primitive-le-950)]/80 z-[19] opacity-0 pointer-events-none transition-opacity duration-300"
          aria-hidden="true"
        ></div>

        <!-- Side Panel / Place Events Panel -->
        <div
          id="map-side-panel"
          class="w-0 h-full bg-mel-bg-primary border-l-0 border-mel-border flex flex-col justify-start z-20 overflow-hidden shrink-0 transition-all duration-300"
          style="opacity: 1;"
          data-node-id="341:25563"
        >
          <!-- Tirador + pliegue decorativo: solo bottom sheet en móvil (Figma
               "Bottom Sheet Header", node 269:11222). Cerrar deslizando hacia
               abajo, ver setupSidePanelDrag(). -->
          <BottomSheetHeader handleId="map-side-panel-handle" class="md:hidden" />

          <!-- Header / Close button (Figma matches: pb-[8px] px-[16px] pt-[8px]) -->
          <div class="flex items-center pb-[8px] px-[16px] pt-[8px] shrink-0 w-full">
            <IconButton 
              id="close-map-side-panel" 
              icon="x"
              variant="ghost"
              aria-label="Cerrar panel"
            />
          </div>
          
          <!-- Title & Address (Figma matches: pb-[32px] pt-[24px] px-[16px] + px-[8px] on inner text) -->
          <div class="flex flex-col gap-[8px] items-start pb-[32px] pt-[24px] px-[16px] shrink-0 w-full relative">
            <div class="px-[8px] flex flex-col gap-[16px] items-start justify-center w-full">
              <h2 id="side-panel-title" class="font-sans font-bold text-[31px] leading-[32px] text-mel-text-primary tracking-[-0.62px] truncate w-full"></h2>
              <p id="side-panel-address" class="font-serif font-medium text-[15px] leading-[24px] text-mel-text-secondary tracking-[0.15px] truncate w-full"></p>
            </div>
          </div>
          
          <!-- Highlight / Tag Section using the TagWithLink component with horizontal overflow (Figma matches: pb-[32px] px-[24px]) -->
          <div class="pb-[32px] px-[24px] flex flex-col items-start justify-center w-full z-[2] relative shrink-0">
            <div class="flex gap-[24px] items-center w-full overflow-x-auto no-scrollbar pb-1" id="side-panel-tags-container">
              <TagWithLink label="Eventos" count="0" class="shrink-0 w-auto" hideBorder={true} />
              <div class="h-8 w-[1px] bg-mel-border shrink-0"></div>
              <TagWithLink label="Artistas" count="0" class="shrink-0 w-auto" hideBorder={true} />
              <div class="h-8 w-[1px] bg-mel-border shrink-0"></div>
              <TagWithLink label="Diseñadores" count="0" class="shrink-0 w-auto" hideBorder={true} />
            </div>
            <!-- Inset bottom divider (Figma matches: bottom-0 left-24 right-24, color: mel-border) -->
            <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border"></div>
          </div>
          
          <!-- Event List (Scrollable) -->
          <div id="side-panel-event-list" class="flex-1 overflow-y-auto bg-mel-bg-primary relative">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>

      <!-- 3. LIST VIEW. pt-[24px] matches the gallery's own top padding (see the note on
           view-mapa above) so the table sits at the same height as the gallery's first row. -->
      <div id="view-lista" class="view-panel hidden flex-col justify-start w-full relative flex-1 min-h-0 pt-[24px]">
        <!-- The border lives on the <table> itself (top+bottom), not this wrapper — the wrapper
             is flex-1/stretches to fill whatever vertical space is available, so its own border
             would sit at the wrapper's edge (often below the actual last row, with an empty gap,
             whenever there are fewer rows than fit on screen) instead of hugging the table's real
             content, which is what "closing" the table means. Cells already carry border-l/border-r
             on every row, so no side borders needed here either. -->
        <!-- Mobile: réplica compacta EventCardList (Figma 439:142691) sustituye
             la tabla ancha de escritorio — ver AGENTS.md regla 7 (JS replica el
             marcado de EventCardList.astro, poblado en performDOMUpdates()). -->
        <!-- -mx-6 sm:-mx-12 cancela el padding horizontal de la página (px-6 /
             sm:px-12) en todo el rango en que esta lista es visible: las filas
             ya traen su propio pl-24/pr-16 (EventCardList), así que sin esto
             quedaban CON DOBLE margen hasta el borde de pantalla. -->
        <div id="list-mobile-cards" class="md:hidden -mx-6 sm:-mx-12 flex-1 overflow-y-auto border-t border-b border-mel-border relative">
          <!-- Dynamically populated -->
        </div>
        <div id="list-table-wrapper" class="hidden md:block overflow-x-auto w-full flex-1 overflow-y-auto">
          <table class="w-full text-left text-sm border-collapse border-t border-b border-mel-border" style="table-layout:fixed;">
            <!-- Evento gets 2 "shares" of the space, Lugar/Localidad/Organiza/Diseño get 1 share
                 each (6 shares total), Fecha gets just enough for a date. calc() inside <col>
                 width doesn't reliably resolve per-column here (tested: every calc() column came
                 out identical, ignoring the multiplier) — plain percentages, worked out by hand
                 against a ~120px Fecha column, are what actually render correctly. -->
            <colgroup>
              <col style="width:29%;" />
              <col style="width:12%;" />
              <col style="width:14.75%;" />
              <col style="width:14.75%;" />
              <col style="width:14.75%;" />
              <col style="width:14.75%;" />
            </colgroup>
            <thead class="sticky top-0 z-[2]">
              <tr class="h-[40px]">
                <th class="sort-header bg-mel-bg-secondary border-b border-l border-r border-mel-border pl-4 pr-2 py-2 text-[13px] font-sans font-bold leading-4 text-mel-text-primary tracking-[1.56px] uppercase cursor-pointer select-none" data-col="evento">
                  <div class="flex items-center justify-between gap-1">
                    <span>evento</span>
                    <span class="sort-icon text-mel-action-secondary shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>
                    </span>
                  </div>
                </th>
                <th class="sort-header bg-mel-bg-secondary border-b border-l border-r border-mel-border pl-4 pr-2 py-2 text-[13px] font-sans font-bold leading-4 text-mel-text-primary tracking-[1.56px] uppercase cursor-pointer select-none" data-col="fecha">
                  <div class="flex items-center justify-between gap-1">
                    <span>fecha</span>
                    <span class="sort-icon text-mel-action-secondary shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>
                    </span>
                  </div>
                </th>
                <th class="sort-header bg-mel-bg-secondary border-b border-l border-r border-mel-border pl-4 pr-2 py-2 text-[13px] font-sans font-bold leading-4 text-mel-text-primary tracking-[1.56px] uppercase cursor-pointer select-none" data-col="lugar">
                  <div class="flex items-center justify-between gap-1">
                    <span>lugar</span>
                    <span class="sort-icon text-mel-action-secondary shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>
                    </span>
                  </div>
                </th>
                <th class="sort-header bg-mel-bg-secondary border-b border-l border-r border-mel-border pl-4 pr-2 py-2 text-[13px] font-sans font-bold leading-4 text-mel-text-primary tracking-[1.56px] uppercase cursor-pointer select-none" data-col="localidad">
                  <div class="flex items-center justify-between gap-1">
                    <span>localidad</span>
                    <span class="sort-icon text-mel-action-secondary shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>
                    </span>
                  </div>
                </th>
                <th class="sort-header bg-mel-bg-secondary border-b border-l border-r border-mel-border pl-4 pr-2 py-2 text-[13px] font-sans font-bold leading-4 text-mel-text-primary tracking-[1.56px] uppercase cursor-pointer select-none" data-col="organiza">
                  <div class="flex items-center justify-between gap-1">
                    <span>organiza</span>
                    <span class="sort-icon text-mel-action-secondary shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>
                    </span>
                  </div>
                </th>
                <th class="sort-header bg-mel-bg-secondary border-b border-l border-r border-mel-border pl-4 pr-2 py-2 text-[13px] font-sans font-bold leading-4 text-mel-text-primary tracking-[1.56px] uppercase cursor-pointer select-none" data-col="disenador">
                  <div class="flex items-center justify-between gap-1">
                    <span>diseño</span>
                    <span class="sort-icon text-mel-action-secondary shrink-0">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>
                    </span>
                  </div>
                </th>
              </tr>
            </thead>
            <tbody id="list-table-body">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    
      <!-- Pagination Controls matching Figma Carousel Navigation 481:234622 -->
      <!-- pt-10 (40px) is deliberately more than the 24px gap the toolbar itself keeps above the
           content (view-galería/view-lista's own pt-[24px]) — this module needs more breathing
           room from whatever's above it than that, not just the same amount. -->
      <div id="pagination-controls" class="flex gap-4 items-center justify-center pt-10 pb-6 relative w-full select-none shrink-0 bg-mel-bg-primary" style="view-transition-name: mel-pagination;">
        <!-- invisible (not hidden/removed) — keeps the button's own layout space reserved so the
             page numbers stay centered, but the arrows themselves aren't shown for now. -->
        <IconButton
          id="btn-prev-page"
          icon="chevron-left"
          size={40}
          type="phantom"
          aria-label="Página anterior"
          class="invisible disabled:opacity-0 disabled:pointer-events-none transition-opacity duration-200"
        />
        <div id="pagination-numbers" class="flex gap-4 items-center relative">
          <!-- Dynamically populated page buttons -->
        </div>
        <IconButton
          id="btn-next-page"
          icon="chevron-right"
          size={40}
          type="phantom"
          aria-label="Página siguiente"
          class="invisible disabled:opacity-0 disabled:pointer-events-none transition-opacity duration-200"
        />
      </div>

    </div>

  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-mel-bg-primary/95 backdrop-blur-md hidden items-center justify-center p-6 transition-all duration-300">
    <IconButton 
      id="close-lightbox" 
      icon="x"
      size={40}
      variant="outline"
      class="absolute top-6 right-6"
      aria-label="Cerrar"
    />
    
    <div class="max-w-4xl w-full flex flex-col md:flex-row gap-8 items-center justify-center">
