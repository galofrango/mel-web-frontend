  /* Table item update bounce animation */
  @keyframes tableBounceUpdate {
    0% {
      opacity: 0.3;
      transform: translateY(18px);
    }
    65% {
      opacity: 1;
      transform: translateY(-5px);
    }
    85% {
      transform: translateY(2px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-table-bounce {
    animation: tableBounceUpdate 480ms cubic-bezier(0.25, 1.15, 0.45, 1) forwards;
  }

  /* --- List view: marquee-on-hover for truncated cell text --- */
  .marquee-cell {
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }
  /* text-overflow:ellipsis lives on the inline-block itself, not just the
     parent .marquee-cell — a parent's ellipsis doesn't reliably truncate an
     atomic inline-block child (the overflowing content isn't a text run the
     browser can cut mid-way through, just one opaque box), which is why
     resting cells were showing raw clipped text with no "…" at all instead
     of a proper ellipsis. max-width caps it to the cell's own width at rest;
     the :hover override below lifts that cap so the slide reveal can work. */
  .marquee-cell .marquee-inner {
    display: inline-block;
    position: relative;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
    transition: transform 0s linear;
    padding-right: 0;
    /* Room for the underline below the text — it has to live *inside* this
       box (not offset outside it) since marquee-inner's own overflow:hidden
       above, needed for the ellipsis, would otherwise clip it invisible.
       3px: a midpoint between Link.astro's own bottom-0 (touching the text)
       and the 6px this had before, which read as too far. */
    padding-bottom: 3px;
  }

  /* Table link cells (event title, lugar/localidad/organiza/diseño search
     links): same animated underline as the Link.astro component — a
     scaleX(0 -> 1) line from the left, instead of the browser's native
     text-decoration:underline — with a bit more breathing room from the
     text than Link.astro's own bottom-0. */
  .table-link-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .event-title-link:hover .table-link-underline,
  .search-cell-link:hover .table-link-underline {
    transform: scaleX(1);
  }
  .marquee-cell:hover .marquee-inner.is-overflowing {
    max-width: none;
    overflow: visible;
    /* Plays once and holds (no `infinite`) — looping used to snap back to the
       start mid-hover as soon as one pass finished, which read as a reset
       before the visitor had even finished reading the full name. */
    animation: marquee-scroll var(--marquee-duration, 2.2s) cubic-bezier(0.16, 1, 0.3, 1) 0.25s 1 forwards;
  }
  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-100% + var(--cell-width))); }
  }

  /* Event title: show chevron on hover */
  .event-title-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
  }
  .event-title-link .title-chevron {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .event-title-link:hover .title-chevron {
    opacity: 1;
    transform: translateX(0);
  }

  /* Search link cells */
  .search-cell-link {
    cursor: pointer;
    color: var(--mel-action-secondary);
    transition: color 0.2s ease;
  }
  .search-cell-link:hover {
    color: var(--mel-action-primary);
  }

  /* Panel del mapa — se comporta como el ToggleSelector (D-026): a partir de
     `lg` (≥1024px, donde el toggle ocupa 4 de 12 columnas) es un panel lateral
     que empuja el mapa con ese MISMO ancho proporcional; por debajo de `lg`
     (donde el toggle "se va para abajo") se convierte en bottom sheet inferior. */

  /* Desktop (lg+): ancho = 4 columnas del grid de 12 con gap-6, idéntico al
     toggle. 11 gaps de 24px = 264px; 4 cols = (100%−264)/3, +3 gaps internos
     (72px). Así el panel se estrecha/ensancha con la pantalla en vez de un
     393px fijo que ahogaba el mapa. */
  @media (min-width: 1024px) {
    #map-side-panel.side-panel-open {
      width: max(320px, calc((100% - 264px) / 3 + 72px));
      border-left-width: 1px;
      box-shadow: -8px 0 24px -4px rgba(0, 0, 0, 0.12), -2px 0 6px -1px rgba(0, 0, 0, 0.06);
    }
    /* Ocultar el primer divisor vertical solo en el panel lateral de escritorio */
    #side-panel-tags-container .highlight-unit:first-child > .bg-mel-border {
      display: none !important;
    }
  }

  /* Bajo lg: bottom sheet. Su borde superior llega justo por debajo del slider
     de tiempo (--mel-sheet-top, medido en JS), dejando el slider a la vista
     bajo el DIM. Nada redondeado: el único recurso del borde superior es el
     corte de la esquina derecha (clip-path), sin más. Emular el pliegue de
     papel del diseño se intentó de tres formas distintas y ninguna convenció;
     queda pendiente hacerlo con una imagen de cabecera para claro y oscuro
     (ver roadmap.md). Animación 0.5s de entrada/salida. */
  @media (max-width: 1023px) {
    #map-side-panel {
      position: fixed;
      inset: var(--mel-sheet-top, 40px) 0 0 0;
      width: 100% !important;
      height: auto !important;
      border-left-width: 0 !important;
      border-top: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      clip-path: polygon(0 0, calc(100% - 40px) 0, 100% 40px, 100% 100%, 0 100%);
      transform: translate3d(0, 100%, 0);
      transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
    }
    #map-side-panel.side-panel-open {
      transform: translate3d(0, 0, 0);
    }
    #map-side-panel.side-panel-dragging {
      transition: none;
    }
    #map-side-panel-backdrop.side-panel-open {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<!-- Client Side Scripting for complete interactivity -->
<script define:vars={{ initialArchives: shuffledArchives }}>
  // -------------------------------------------------------
  // Persistent state: survives View Transition re-execution
  // -------------------------------------------------------
  // Sort column/direction survive a hard reload (sessionStorage) — without
  // this, navigating into an event and back (a real page reload since D-072)
  // would silently drop whatever order the visitor picked in Lista, and the
  // Galería's own order (below) depends on this same value.
  let __melSavedSort = null;
  try {
    const raw = sessionStorage.getItem('mel-sort-state');
    if (raw) __melSavedSort = JSON.parse(raw);
  } catch (e) {}

  if (!window._melState) {
    window._melState = {
      archives: [...initialArchives],
      filtered: [...initialArchives],
      minYear: 2004,
      maxYear: 2019,
      searchQuery: "",
      activeSidePanelKey: null,
      currentPage: 1,
      currentSortCol: __melSavedSort ? __melSavedSort.col : null,
      currentSortDir: __melSavedSort ? __melSavedSort.dir : 'asc',
      ABSOLUTE_MIN_YEAR: 2004,
      ABSOLUTE_MAX_YEAR: 2019,
      currentDetailGroup: null,
      currentCarruselIndex: 0,
      googleMap: null,
      mapMarkers: [],
      // locKey -> { marker, group, inClusterer } — lets updateMapMarkers() update
      // an existing pin's count/active state in place instead of destroying and
      // recreating every marker on each filter change (which flashed them all).
      locationMarkers: new Map(),
      mapInitialized: false,
      mapContainerEl: null,
      infoWindow: null,
      mapCore: null,
      markerLib: null,
      googleMapClusterer: null,
    };
  }
  const _s = window._melState;

  // Secuencia única de la sesión (contrato de navegación, docs/architecture.md).
  // El servidor baraja el archivo en CADA render, así que sin esto volver de la
  // ficha de un evento reordenaría la galería bajo los pies del visitante y
  // "volver al mismo sitio" sería imposible. La sesión se queda con el primer
  // barajado que le sirvieron y lo reutiliza mientras dure la pestaña; pestaña
  // nueva = orden nuevo, que es lo que se buscaba con el aleatorio.
  //
  // Tiene que ir aquí y no dentro de initHomePage(): _melState nace ya con
  // `archives` poblado desde el SSR, así que cualquier guard del tipo
  // "si está vacío" no llega a dispararse nunca en una carga real.
  (function seedSessionOrder() {
    try {
      const saved = JSON.parse(sessionStorage.getItem('mel-session-order') || 'null');
      if (Array.isArray(saved) && saved.length) {
        const byId = new Map(_s.archives.map(x => [x.idMel, x]));
        const restored = saved.map(id => byId.get(id)).filter(Boolean);
        // Solo se acepta si cubre el archivo entero: si la hoja ha cambiado
        // (eventos añadidos o borrados) se descarta y se resiembra, en vez de
        // dejar fuera de la secuencia los que falten.
        if (restored.length === _s.archives.length) {
          _s.archives = restored;
          return;
        }
      }
    } catch (e) {}
    try {
      sessionStorage.setItem('mel-session-order', JSON.stringify(_s.archives.map(x => x.idMel)));
    } catch (e) {}
  })();

  // Aliases (writable via _s.xxx = ...)
  let archives             = _s.archives;
  let filtered             = _s.filtered;
  let minYear              = _s.minYear;
  let maxYear              = _s.maxYear;
  let searchQuery          = _s.searchQuery;
  let activeSidePanelKey   = _s.activeSidePanelKey;
  let currentPage          = _s.currentPage;
  const PAGE_SIZE          = 32;
  let currentSortCol       = _s.currentSortCol;
  let currentSortDir       = _s.currentSortDir;
  let ABSOLUTE_MIN_YEAR    = _s.ABSOLUTE_MIN_YEAR;
  let ABSOLUTE_MAX_YEAR    = _s.ABSOLUTE_MAX_YEAR;
  let currentDetailGroup   = _s.currentDetailGroup;
  let currentCarruselIndex = _s.currentCarruselIndex;

  // Helper to keep _melState in sync when we mutate these aliases
  function syncState() {
    _s.archives = archives; _s.filtered = filtered;
    _s.minYear = minYear; _s.maxYear = maxYear;
    _s.searchQuery = searchQuery; _s.activeSidePanelKey = activeSidePanelKey;
    _s.currentPage = currentPage; _s.currentSortCol = currentSortCol;
    _s.currentSortDir = currentSortDir;
    _s.ABSOLUTE_MIN_YEAR = ABSOLUTE_MIN_YEAR; _s.ABSOLUTE_MAX_YEAR = ABSOLUTE_MAX_YEAR;
    _s.currentDetailGroup = currentDetailGroup; _s.currentCarruselIndex = currentCarruselIndex;
  }

  // DOM Element refs — re-assigned in initHomePage()
  let sliderMin, sliderMax, minHandle, maxHandle, minVal, maxVal, activeFill;
  let lightbox, lightboxImg, lightboxTitle, lightboxLocation, lightboxCategory, lightboxDate, closeLightboxBtn;
  let btnPrevPage, btnNextPage, paginationNumbers;

  // Set false at the top of initHomePage() and flipped true once the initial
  // load's synchronous cascade of filterArchives() calls (slider init, the
  // search box's own startup dispatch, etc.) has settled — gallery cards
  // only get the first-load stagger-in animation while this is false, so a
  // later render triggered by that same cascade doesn't lose it, but a real
  // user-driven filter/sort/search afterwards doesn't replay it either.
  let gallerySettled = true;
  let isFirstDOMUpdate = true;

  // Calculate year of event
  // Fecha "d/m/aaaa" (o "aaaa-m-d") a milisegundos, para ordenar. Los eventos
  // sin fecha van a 0, así que quedan al principio de una orden ascendente.
  function fechaAMs(dateStr) {
    if (!dateStr || dateStr === 'SIN FECHA') return 0;
    const barras = String(dateStr).split('/');
    if (barras.length === 3) return new Date(+barras[2], +barras[1] - 1, +barras[0]).getTime() || 0;
    const guiones = String(dateStr).split('-');
    if (guiones.length === 3) return new Date(+guiones[0], +guiones[1] - 1, +guiones[2]).getTime() || 0;
    return 0;
  }

  function getYear(dateStr) {
    if (dateStr === null || dateStr === undefined) return null;
    const str = String(dateStr).trim();
    if (!str || str === 'SIN FECHA') return null;

    // Check if it's already a 4-digit number (like "2008" or 2008)
    const numericYear = parseInt(str, 10);
    if (!isNaN(numericYear) && str.length === 4) return numericYear;

    const slashBits = str.split('/');
    if (slashBits.length === 3) {
      const yr = parseInt(slashBits[2], 10);
      if (!isNaN(yr)) return yr;
    }
    const dashBits = str.split('-');
    if (dashBits.length === 3) {
      const yr = parseInt(dashBits[0], 10);
      if (!isNaN(yr)) return yr;
    }
    const match = str.match(/\b(19\d\d|20\d\d)\b/);
    if (match) {
      return parseInt(match[1], 10);
    }
    return null;
  }

  // Hotlink extractor using the new thumbnail endpoint
  // `ancho` = el ancho que Drive debe servir, en píxeles. Pedir siempre w1000
  // costaba ~679 KB de media por flyer (el peor del archivo, 2 MB) para pintarlo
  // en una tarjeta de 342px o, peor, en una miniatura de lista de 40px. Cada
  // llamada pide ahora el tamaño que de verdad va a usar; 1000 sigue siendo el
  // valor por defecto porque es el que necesitan la ficha y el lightbox.
  const ANCHO_TARJETA = 700;
  const ANCHO_MINIATURA = 200;

  function extractDriveImage(url, ancho = 1000) {
    if (!url) return '';
    let fileId = '';
    if (url.includes('id=')) {
      fileId = url.split('id=')[1].split('&')[0];
    } else if (url.includes('/d/')) {
      fileId = url.split('/d/')[1].split('/')[0];
    }
    return fileId ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w${ancho}` : '';
  }

  // Escapa HTML para insertarlo de forma segura en innerHTML — usado por
  // todas las réplicas JS de componentes (filas de tabla, Event Card List...).
  // Regla del sitio: un campo sin dato SIEMPRE se pinta en text-tertiary y NUNCA
  // es enlace. La hoja marca la ausencia con varios centinelas distintos, no
  // solo "desconocido" — sin contemplarlos todos, un "Varios" o un "No
  // detallados" acababa siendo un enlace que buscaba esa palabra literal.
  // `varios` y `no detallados` se muestran tal cual porque dicen algo; el resto
  // se unifica bajo "desconocido".
  const CENTINELAS_SIN_DATO = ['desconocido', 'sin fecha', 'no detallados', 'varios'];

  function celdaSinDato(valor) {
    const limpio = valor ? String(valor).trim() : '';
    const bajo = limpio.toLowerCase();
    if (!limpio || bajo === 'desconocido' || bajo === 'sin fecha') return 'desconocido';
    if (CENTINELAS_SIN_DATO.includes(bajo)) return limpio;
    return null;   // hay dato de verdad
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // DD/MM/AAAA a partir del AAAA-MM-DD tal cual llega de la hoja (columna Fecha).
  function formatFechaDMY(fecha) {
    let formatted = fecha || '';
    if (formatted && formatted.includes('-')) {
      const parts = formatted.split('-');
      if (parts.length === 3) formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
    }
    return formatted;
  }

  // Réplica JS de EventCardList.astro (Figma "Event Card List", node
  // 291:13479 / Bottom Sheet Mobile Place Events List 439:142691): fila
  // compacta con miniatura 56x56 en fit (object-contain) sobre fondo
  // secundario, título, fecha y chevron. Compartida por el panel lateral
  // del mapa y la lista en móvil — ver AGENTS.md regla 7 si cambia el diseño.
  function buildEventCardListHtml(evt, { showDivider = true } = {}) {
    const imgSrc = extractDriveImage(evt.carruselItems?.[0]?.urlDrive, ANCHO_TARJETA) || `/flyers/flyer-1.png`;
    return `
      <div class="bg-mel-bg-secondary overflow-clip relative shrink-0 size-[56px]">
        <img src="${imgSrc}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 max-w-none object-contain pointer-events-none size-full" />
      </div>
      <div class="flex flex-col flex-1 min-w-0 gap-[4px] items-start">
        <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary truncate w-full">${escHtml(evt.evento)}</p>
        <p class="typo-body-roman text-mel-text-secondary">${escHtml(formatFechaDMY(evt.fecha))}</p>
      </div>
      <div class="shrink-0 size-[24px] flex items-center justify-center text-mel-action-secondary group-hover:text-mel-action-primary transition-colors duration-200">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      ${showDivider ? '<div class="absolute bottom-[0.5px] h-0 left-6 right-6 sm:left-12 sm:right-12 lg:left-6 lg:right-6 border-b border-mel-border/60"></div>' : ''}
    `;
  }

  // -------------------------------------------------------
  // Galería masonry 2.1 (ver decisions.md D-015): grid + row-span medido,
  // orden aleatorio estable y scroll infinito.
  // -------------------------------------------------------
  const GALLERY_ROW = 4;   // grid-auto-rows del contenedor, en px
  const GALLERY_GAP = 24;  // hueco entre tarjetas (mel-l), horizontal y vertical

  let galleryVisibleCount = PAGE_SIZE;
  let galleryOrderedCache = [];
  let sentinelObserver = null;
  let mapResizeObserver = null;

  // Fija el row-span de una tarjeta a partir del ratio de su imagen y el
  // ancho de columna actual. `width` es opcional (una pasada de resize lo
  // lee una sola vez: todas las columnas miden lo mismo).
  function sizeGalleryCard(card, width) {
    const ratio = parseFloat(card.dataset.ratio);
    const w = width || card.clientWidth;
    if (!ratio || !w) return;
    card.style.gridRowEnd = 'span ' + Math.max(1, Math.round((w / ratio + GALLERY_GAP) / GALLERY_ROW));
    card.classList.remove('unsized');
  }

  // Llamado por el onload inline de cada <img> (y por la repesca de imágenes
  // ya completas tras cada render): publica el ratio real en la tarjeta.
  function measureFlyerImg(img) {
    const card = img.closest('.gallery-item');
    if (!card || !img.naturalWidth || !img.naturalHeight) return;
    card.dataset.ratio = String(img.naturalWidth / img.naturalHeight);
    sizeGalleryCard(card);
  }
  window.__melMeasureFlyer = measureFlyerImg;

  // Única fábrica de tarjetas de galería (render completo Y lotes del scroll
  // infinito) — réplica JS de FlyerCard.astro, ver regla 7 de CLAUDE.md.
  function buildGalleryCard(item, i) {
    const card = document.createElement('div');
    const imgSrc = extractDriveImage(item.carruselItems[0]?.urlDrive, ANCHO_TARJETA) || `/flyers/flyer-${((i % 13) + 1)}.png`;
    card.className = 'gallery-item unsized relative overflow-hidden shadow-[var(--mel-shadow-sm)] group bg-white transition-all duration-300 cursor-pointer';
    card.dataset.id = item.idMel;
    card.innerHTML = `
      <!-- Image with referrerpolicy no-referrer to allow anonymous loading of Google Drive links in browsers -->
      <img src="${imgSrc}" alt="${escHtml(item.evento)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-auto block pointer-events-none" style="view-transition-name: flyer-img-${item.idMel};" onload="window.__melMeasureFlyer && window.__melMeasureFlyer(this)" />

      <!-- Blending grid overlay (striped Figma style) -->
      <div class="absolute inset-0 striped-bg opacity-0 group-hover:opacity-10 transition-opacity duration-300 z-10 pointer-events-none"></div>

      <!-- Overlay info on hover (Figma "Event Info" 481:238727 — mirrors FlyerCard.astro, ver AGENTS.md regla 7) -->
      <div class="flyer-label absolute bottom-0 left-0 right-0 h-[32px] bg-mel-action-secondary backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 flex items-center justify-between gap-2 px-4 z-20 shadow-[var(--mel-shadow-flyer-label)]">
        <p class="font-sans font-bold text-[12px] leading-[16px] tracking-[0.5px] text-mel-text-on-action truncate min-w-0">${escHtml(item.evento)}</p>
        ${item.fecha ? `<p class="font-serif font-medium text-[12px] leading-[16px] tracking-[0.15px] text-mel-text-on-action shrink-0">${escHtml(formatFechaDMY(item.fecha))}</p>` : ''}
      </div>
    `;
    card.addEventListener('pointerenter', () => {
      prefetchEventUrl(item.idMel, { search: searchQuery });
    }, { once: true });
    card.addEventListener('click', () => {
      openLightbox(item);
    });
    return card;
  }

  // Scroll infinito: el centinela (#gallery-sentinel, hermano de la rejilla)
  // entra en el margen de precarga y se añade el siguiente lote SIN tocar lo
  // ya colocado. Búsquedas y filtros no interfieren: resetean
  // galleryVisibleCount y pasan por el rebuild completo de performDOMUpdates.
  function appendGalleryBatch() {
    const gridContainer = document.getElementById('gallery-grid');
    const galleryViewEl = document.getElementById('view-galería');
    if (!gridContainer || !galleryViewEl || galleryViewEl.classList.contains('hidden')) return;
    const next = galleryOrderedCache.slice(galleryVisibleCount, galleryVisibleCount + PAGE_SIZE);
    if (next.length === 0) return;
    const startIdx = galleryVisibleCount;
    galleryVisibleCount += next.length;
    next.forEach((item, i) => {
      const card = buildGalleryCard(item, startIdx + i);
      gridContainer.appendChild(card);
      const img = card.querySelector('img');
      if (img && img.complete) measureFlyerImg(img);
    });
  }

  // Determine dynamic bounds
  function calculateDynamicBounds() {
    let min = Infinity;
    let max = -Infinity;
    archives.forEach(item => {
      const yr = getYear(item.fecha);
      if (yr !== null) {
        if (yr < min) min = yr;
        if (yr > max) max = yr;
      }
    });
    if (min === Infinity) min = 2004;
    if (max === -Infinity) max = 2019;
    ABSOLUTE_MIN_YEAR = min;
    ABSOLUTE_MAX_YEAR = max;

    if (sliderMin) {
      sliderMin.setAttribute('min', String(min));
      sliderMin.setAttribute('max', String(max));
    }
    if (sliderMax) {
      sliderMax.setAttribute('min', String(min));
      sliderMax.setAttribute('max', String(max));
    }
  }

  // Double Range Slider logic
  // Dragging the slider handle fires 'input' dozens of times a second — each
  // call used to run its own document.startViewTransition(), and starting a
  // new one while a previous one is still pending supersedes it, which was
  // exactly why the gallery's FLIP reorder never got to actually play during
  // a drag (only a single discrete click, giving each call room to settle,
  // worked). Coalescing into at most one filterArchives() per animation
  // frame keeps the values live-updating but stops that thrash.
  let sliderUpdateScheduled = false;
  // D-086 ronda 4: rAF-coalescing alone (below) only guarantees at most one
  // *scheduled* filterArchives() per frame — it says nothing about how long
  // that call itself takes once it runs. Rebuilding the gallery/list DOM is
  // real work (masonry sizing, image handling, row markup), and on a phone's
  // weaker CPU a big year-range jump can make a single call take well past
  // one frame's budget, blocking the main thread — which is also where
  // touchmove events for the slider itself get queued and delivered. That's
  // the propietario's own diagnosis: Mapa stays smooth because marker
  // updates are cheap (clusterer diffing, no full rebuild); Galería/Lista
  // jank specifically on mobile because the rebuild is heavy AND touch
  // fires far more events/sec than a mouse drag ever does, so the backlog
  // compounds. Time-throttling the expensive rebuild specifically WHILE
  // actively dragging (trailing-edge — the last call always still fires,
  // nothing gets lost) keeps the slider's own live feedback (handle
  // position, year labels — cheap, CSS/text only, driven entirely inside
  // TimeSlider.astro) responsive every frame while capping how often the
  // expensive part can compete for the same thread. A discrete interaction
  // (click-to-jump, keyboard) isn't throttled at all — this only kicks in
  // while `#slider-track-wrapper` has D-068's `.dragging` class.
  let sliderLastFilterAt = 0;
  let sliderTrailingTimer = null;
  const SLIDER_DRAG_FILTER_THROTTLE_MS = 120;

  function scheduleFilterArchives() {
    if (sliderUpdateScheduled) return;
    sliderUpdateScheduled = true;
    requestAnimationFrame(() => {
      sliderUpdateScheduled = false;
      filterArchives();
    });
  }

  function updateSlider() {
    if (!sliderMin || !sliderMax) return;
    let val1 = parseInt(sliderMin.value);
    let val2 = parseInt(sliderMax.value);

    // Ensure min never exceeds max — simply clamp
    if (val1 > val2) {
      val1 = val2;
      sliderMin.value = String(val1);
    }

    minYear = val1;
    maxYear = val2;

    // Reset pagination to first page when filtering changes
    currentPage = 1;
    // La galería vuelve a su primer lote de scroll infinito y al inicio del
    // scroll: quedarse a media profundidad sobre un resultado recién
    // encogido dejaba al usuario varado entre huecos.
    galleryVisibleCount = PAGE_SIZE;
    const galleryScroller = document.getElementById('view-galería');
    if (galleryScroller) galleryScroller.scrollTop = 0;

    const trackWrapper = document.getElementById('slider-track-wrapper');
    const isDragging = trackWrapper && trackWrapper.classList.contains('dragging');
    // D-086 ronda 6: this throttle exists for touch's high event rate +
    // weaker mobile CPUs (see the comment above SLIDER_DRAG_FILTER_THROTTLE_MS) —
    // it was applying to ANY drag regardless of input device, including a
    // mouse on desktop, which never had the problem it exists to solve and
    // just got a slower, throttled re-render for no reason. TimeSlider.astro
    // stamps the actual pointer type onto this same element at drag start.
    const isTouchDragging = isDragging && trackWrapper.dataset.pointerType === 'touch';

    if (!isTouchDragging) {
      if (sliderTrailingTimer) { clearTimeout(sliderTrailingTimer); sliderTrailingTimer = null; }
      scheduleFilterArchives();
      return;
    }

    const now = performance.now();
    const elapsed = now - sliderLastFilterAt;
    if (elapsed >= SLIDER_DRAG_FILTER_THROTTLE_MS) {
      sliderLastFilterAt = now;
      scheduleFilterArchives();
    } else if (!sliderTrailingTimer) {
      sliderTrailingTimer = setTimeout(() => {
        sliderTrailingTimer = null;
        sliderLastFilterAt = performance.now();
        scheduleFilterArchives();
      }, SLIDER_DRAG_FILTER_THROTTLE_MS - elapsed);
    }
  }

  // Bind Slider Events — called from initHomePage()
  function bindSliderEvents() {
    if (sliderMin) sliderMin.addEventListener('input', updateSlider);
    if (sliderMax) sliderMax.addEventListener('input', updateSlider);
    // 'change' (D-086, TimeSlider.astro dispatches it on release, after
    // removing the `dragging` class) guarantees one final, immediate,
    // un-throttled sync — the last 'input' during a drag may have been
    // deferred by the throttle above and not caught up yet.
    if (sliderMin) sliderMin.addEventListener('change', updateSlider);
    if (sliderMax) sliderMax.addEventListener('change', updateSlider);
  }

  // Carousel Render inside Lightbox
  function updateLightboxCarousel() {
    if (!currentDetailGroup) return;
    const items = currentDetailGroup.carruselItems;
    const activeItem = items[currentCarruselIndex];
    lightboxImg.src = extractDriveImage(activeItem.urlDrive);
    
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const dotsContainer = document.getElementById('lightbox-dots');
    
    dotsContainer.innerHTML = '';
    
    if (items.length > 1) {
      prevBtn.classList.remove('hidden');
      nextBtn.classList.remove('hidden');
      
      items.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = `w-2 h-2 cursor-pointer transition-colors border border-mel-border ${idx === currentCarruselIndex ? 'bg-mel-action-secondary' : 'bg-white/60'}`;
        dot.addEventListener('click', () => {
          currentCarruselIndex = idx;
          updateLightboxCarousel();
        });
        dotsContainer.appendChild(dot);
      });
    } else {
      prevBtn.classList.add('hidden');
      nextBtn.classList.add('hidden');
    }
  }

  // Guarda el contexto de navegación justo antes de salir de `/` hacia la
  // ficha de un evento, para que al cerrarla se vuelva EXACTAMENTE al mismo
  // sitio. La URL de vuelta ya lleva lo compartible (vista, búsqueda,
  // localidad); lo que no cabe en una URL — scroll, lotes cargados del scroll
  // infinito, página de Lista, cámara del mapa, rango de años — vive aquí.
  // Se guarda en sessionStorage (no en memoria) para sobrevivir también a un
  // F5 hecho dentro de la propia ficha de evento.
  function saveReturnState() {
    try {
      const view = document.querySelector('.view-panel:not(.hidden)')?.id?.replace('view-', '') || 'galería';
      const state = {
        view,
        page: currentPage,
        galleryVisibleCount,
        sortCol: currentSortCol,
        sortDir: currentSortDir,
        minYear,
        maxYear,
        // El local del panel no se guarda aquí: viaja en la propia URL de
        // vuelta (?location=), que es donde updateMapMarkers() lo busca.
        scroll: {
          galeria: document.getElementById('view-galería')?.scrollTop || 0,
          listaTable: document.getElementById('list-table-wrapper')?.scrollTop || 0,
          listaCards: document.getElementById('list-mobile-cards')?.scrollTop || 0,
        },
        map: null,
      };
      if (googleMap && typeof googleMap.getCenter === 'function') {
        const c = googleMap.getCenter();
        if (c) state.map = { lat: c.lat(), lng: c.lng(), zoom: googleMap.getZoom() };
      }
      sessionStorage.setItem('mel-return-state', JSON.stringify(state));
    } catch (e) {}
  }

  // Contrapartida de saveReturnState(). Se consume UNA sola vez (se borra al
  // leerla): así una vuelta restaura el sitio, pero una visita posterior a `/`
  // por cualquier otra vía arranca limpia.
  //
  // Va en dos fases porque el arranque de initHomePage() pisa parte de lo que
  // queremos restaurar: updateSlider() resetea currentPage y galleryVisibleCount
  // y manda la galería arriba del todo, así que el rango de años tiene que
  // aplicarse ANTES (para que el primer render ya salga filtrado) y la posición
  // dentro de ese resultado DESPUÉS.
  // El estado de vuelta vive en `_s` (no en una variable suelta) y con fecha de
  // caducidad porque astro:page-load dispara DOS veces por navegación suave:
  // la segunda pasada de initHomePage() volvía a resetear página, lotes y
  // scroll justo después de que la primera los hubiera restaurado. Aplicándolo
  // en ambas pasadas, la restauración aguanta; la caducidad evita que una
  // visita posterior a `/` reviva un sitio viejo.
  const RETURN_STATE_TTL_MS = 4000;

  function readReturnState() {
    try {
      const raw = sessionStorage.getItem('mel-return-state');
      if (raw) {
        sessionStorage.removeItem('mel-return-state');
        _s.pendingReturn = JSON.parse(raw);
        _s.pendingReturnUntil = Date.now() + RETURN_STATE_TTL_MS;
      } else if (_s.pendingReturnUntil && Date.now() > _s.pendingReturnUntil) {
        _s.pendingReturn = null;
      }
    } catch (e) {
      _s.pendingReturn = null;
    }
    // Fase 1 — filtros que deben estar puestos antes del primer render.
    const st = _s.pendingReturn;
    if (!st) return;
    if (Number.isFinite(st.minYear) && sliderMin) sliderMin.value = String(st.minYear);
    if (Number.isFinite(st.maxYear) && sliderMax) sliderMax.value = String(st.maxYear);
    // TimeSlider siembra la posición de sus tiradores desde estos mismos
    // inputs, pero puede haberse inicializado ya (el orden entre los dos
    // scripts de astro:page-load no está garantizado): se le pide repintar.
    if (typeof window._melRenderSlider === 'function') window._melRenderSlider();
    if (st.sortCol) {
      currentSortCol = st.sortCol;
      currentSortDir = st.sortDir || 'asc';
      syncState();
      updateSortHeaderIcons();
    }
  }

  // Insiste en devolver un contenedor a `target` mientras su contenido siga
  // creciendo (imágenes cargando ⇒ alto final desconocido al principio).
  function restoreScroll(containerId, target, timeoutMs = 2500) {
    if (!target) return;
    const el = document.getElementById(containerId);
    if (!el) return;
    // El recorrido hasta la posición guardada es inevitable: las imágenes son
    // lazy y el masonry no conoce el alto de una tarjeta hasta que la suya
    // carga, así que el contenedor va creciendo y solo se puede bajar a medida
    // que da de sí. Lo que sí se puede es que no se VEA: se oculta el
    // contenedor mientras dura y se revela con un fundido corto al llegar.
    el.style.transition = 'none';
    el.style.opacity = '0';

    // Con setInterval y no requestAnimationFrame a propósito: rAF se congela en
    // pestañas en segundo plano, y esta restauración tiene que completarse
    // aunque el visitante cambie de pestaña mientras vuelve.
    const deadline = Date.now() + timeoutMs;
    let ultimo = -1;
    let estables = 0;
    const stop = () => {
      clearInterval(timer);
      el.removeEventListener('wheel', stop);
      el.removeEventListener('touchstart', stop);
      el.removeEventListener('pointerdown', stop);
      el.style.transition = 'opacity 0.25s ease';
      el.style.opacity = '1';
      setTimeout(() => { el.style.transition = ''; el.style.opacity = ''; }, 300);
    };
    // Se reafirma hasta que la posición se asienta, no solo hasta acertar una
    // vez: la segunda pasada de initHomePage() manda el scroll a 0 después de
    // que la primera ya lo hubiera colocado. Se da por asentada cuando deja de
    // moverse — sirve tanto si llega al objetivo como si el contenido se ha
    // encogido y el objetivo ya no existe (si no, esperaría oculta el plazo
    // entero para nada).
    const timer = setInterval(() => {
      if (Math.abs(el.scrollTop - target) > 2) el.scrollTop = target;
      if (el.scrollTop === ultimo) estables++; else { estables = 0; ultimo = el.scrollTop; }
      if (estables >= 3 || Date.now() >= deadline) stop();
    }, 50);
    el.addEventListener('wheel', stop, { once: true, passive: true });
    el.addEventListener('touchstart', stop, { once: true, passive: true });
    el.addEventListener('pointerdown', stop, { once: true, passive: true });
  }

  function applyReturnState() {
    const st = _s.pendingReturn;
    if (!st) return;

    // Fase 2 — posición dentro del resultado ya filtrado.
    currentPage = st.page || 1;
    galleryVisibleCount = Math.max(PAGE_SIZE, st.galleryVisibleCount || PAGE_SIZE);
    syncState();
    filterArchives();

    // El scroll no se puede fijar de una sola vez: el masonry de la galería
    // mide cada tarjeta cuando su imagen termina de cargar, así que el alto
    // del contenedor va creciendo durante el primer segundo largo. Fijar
    // scrollTop antes de que dé de sí lo clampa (acababa en 0). Se reintenta
    // frame a frame hasta que la posición aguanta, con tope de tiempo — y se
    // abandona en cuanto el visitante toca el scroll, para no pelearse con él.
    const s = st.scroll || {};
    restoreScroll('view-galería', s.galeria);
    restoreScroll('list-table-wrapper', s.listaTable);
    restoreScroll('list-mobile-cards', s.listaCards);

    // La cámara del mapa solo se restaura si el mapa ya existe. Si se vuelve a
    // la vista Mapa, se crea de forma diferida: en ese caso el paneo hacia el
    // local de `?location=` (D-075) ya deja la cámara donde corresponde.
    if (st.map && googleMap && typeof googleMap.setCenter === 'function') {
      googleMap.setCenter({ lat: st.map.lat, lng: st.map.lng });
      if (Number.isFinite(st.map.zoom)) googleMap.setZoom(st.map.zoom);
    }
  }

  // Real navigation to the static, server-rendered /event/[id] page — this
  // replaced an in-place SPA overlay that used to duplicate its whole
  // markup/logic (see docs/decisions.md D-072). Uses a hard reload
  // (data-astro-reload semantics via window.location, matching the
  // Anterior/Siguiente links on /event/[id] itself) rather than Astro's
  // soft ClientRouter navigation: an earlier full-page-navigation attempt
  // at this site hit the router's stale-snapshot cache switching between
  // two /event/[id] URLs, which is exactly why the overlay was built in
  // the first place. /event/[id] already reads ?search=/?location=/?view=
  // to compute its own filtered Anterior/Siguiente and its own return link.
  function prefetchEventUrl(idMel, { search = '', location = '' } = {}) {
    if (!idMel) return;
    const activeViewName = document.querySelector('.view-panel:not(.hidden)')?.id?.replace('view-', '') || 'galería';
    const params = new URLSearchParams();
    params.set('view', activeViewName);
    if (location) {
      params.set('location', location);
    } else if (search) {
      params.set('search', search);
    }
    const url = `/event/${idMel}?${params.toString()}`;
    if (!document.querySelector(`link[rel="prefetch"][href="${url}"]`)) {
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url;
      document.head.appendChild(link);
    }
  }

  function navigateToEvent(idMel, { search = '', location = '' } = {}) {
    saveReturnState();
    const activeViewName = document.querySelector('.view-panel:not(.hidden)')?.id?.replace('view-', '') || 'galería';
    const params = new URLSearchParams();
    params.set('view', activeViewName);
    if (currentSortCol) {
      params.set('sort', currentSortCol);
      params.set('dir', currentSortDir);
    }
    if (location) {
      params.set('location', location);
    } else if (search) {
      params.set('search', search);
    }
    const url = `/event/${idMel}?${params.toString()}`;
    if (typeof window.__melNavigate === 'function') {
      window.__melNavigate(url);
    } else {
      document.body.style.transition = 'opacity 0.15s ease';
      document.body.style.opacity = '0';
      setTimeout(() => { window.location.href = url; }, 150);
    }
  }

  function openLightbox(item) {
    navigateToEvent(item.idMel, { search: searchQuery });
  }

  function closeLightbox() {
    lightbox.classList.remove('flex');
    lightbox.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    currentDetailGroup = null;
  }

  // Lightbox bindings — called from initHomePage()
  function bindLightboxEvents() {
    if (closeLightboxBtn) closeLightboxBtn.addEventListener('click', closeLightbox);
    if (lightbox) lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    const lbPrev = document.getElementById('lightbox-prev');
    const lbNext = document.getElementById('lightbox-next');
    if (lbPrev) lbPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentDetailGroup) return;
      const items = currentDetailGroup.carruselItems;
      currentCarruselIndex = (currentCarruselIndex - 1 + items.length) % items.length;
      syncState();
      updateLightboxCarousel();
    });
    if (lbNext) lbNext.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!currentDetailGroup) return;
      const items = currentDetailGroup.carruselItems;
      currentCarruselIndex = (currentCarruselIndex + 1) % items.length;
      syncState();
      updateLightboxCarousel();
    });
  }

  function bindInitialCardClicks() {
    document.querySelectorAll('.gallery-item').forEach(card => {
      card.addEventListener('pointerenter', () => {
        const id = card.dataset.id;
        if (id) prefetchEventUrl(id, { search: searchQuery });
      }, { once: true });
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const item = archives.find(x => x.idMel === id);
        if (item) openLightbox(item);
      });
    });
  }

  // Smooth numeric counter roll animation
  function animateValue(obj, start, end, duration = 250) {
    if (start === end) return;
    let startTimestamp = null;
    const step = (timestamp) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      obj.textContent = Math.floor(progress * (end - start) + start);
      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        obj.textContent = end;
      }
    };
    window.requestAnimationFrame(step);
  }

  // Pagination lives INSIDE whichever list scroll container is currently
  // active (mobile cards vs desktop table, D-057's min-[440px] breakpoint)
  // — not as an always-visible footer that permanently eats into the
  // list's own viewport height. It only becomes visible once the user
  // actually scrolls to the end of the list (D-066 — reverts the
  // "always-visible sibling" shape from D-064/D-065, which the
  // propietario flagged as wrong: "no esté siempre visible sino que
  // aparezca al final del scroll"). Shared by filterArchives()'s own
  // repopulate AND switchView()'s tab-click toggle (D-067 — switchView()
  // had its OWN separate classList.remove('hidden') that showed


  // Filter Archives by Year & Search Query and Recalculate unique counts
  function filterArchives(shouldFitBounds = false) {
    let tempFiltered = archives.filter(item => {
      const yr = getYear(item.fecha);
      const yearMatch = yr >= minYear && yr <= maxYear;
      
      const searchMatch = !searchQuery || 
        item.evento.toLowerCase().includes(searchQuery) || 
        item.lugar.toLowerCase().includes(searchQuery) ||
        item.localidad.toLowerCase().includes(searchQuery) ||
        item.artistas.toLowerCase().includes(searchQuery) ||
        item.organiza.toLowerCase().includes(searchQuery) ||
        item.disenador.toLowerCase().includes(searchQuery);
        
      return yearMatch && searchMatch;
    });

    // Apply sorting
    if (currentSortCol) {
      if (currentSortCol === 'fecha') {
        tempFiltered.sort((a, b) => {
          const parseDate = (dStr) => {
            if (!dStr || dStr === 'SIN FECHA') return 0;
            const parts = dStr.split('/');
            if (parts.length === 3) return new Date(parts[2], parts[1]-1, parts[0]).getTime();
            const parts2 = dStr.split('-');
            if (parts2.length === 3) return new Date(parts2[0], parts2[1]-1, parts2[2]).getTime();
            return 0;
          };
          const valA = parseDate(a.fecha);
          const valB = parseDate(b.fecha);
          return currentSortDir === 'asc' ? valA - valB : valB - valA;
        });
      } else {
        tempFiltered.sort((a, b) => {
          const dbField = currentSortCol === 'disenador' ? 'disenador' : currentSortCol;
          const valA = (a[dbField] || '').toLowerCase().trim();
          const valB = (b[dbField] || '').toLowerCase().trim();
          if (!valA || valA === 'desconocido') return 1;
          if (!valB || valB === 'desconocido') return -1;
          return currentSortDir === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
        });
      }
    }

    filtered = tempFiltered;

    // El vector de navegación de la ficha de evento ES la secuencia visible:
    // `filtered` ya lleva el orden de la sesión (o el de la columna elegida en
    // Lista) y ya excluye lo que no pasa los filtros, así que Anterior/Siguiente
    // recorre exactamente lo que el visitante está viendo, sin reordenar nada
    // por su cuenta (contrato de navegación, architecture.md).
    try {
      sessionStorage.setItem('mel-active-nav-sequence', JSON.stringify(filtered.map(x => x.idMel)));
    } catch (e) {}

    // 1. Calculate dynamic statistics on the fly
    const filteredArtists = new Set();
    const filteredDesigners = new Set();
    const filteredPromoters = new Set();
    
    filtered.forEach(item => {
      if (item.artistas) {
        item.artistas.split(/[,;\/]+/).forEach(a => {
          const cleanA = a.trim().toLowerCase();
          if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') filteredArtists.add(cleanA);
        });
      }
      if (item.organiza) {
        const cleanP = item.organiza.trim().toLowerCase();
        if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') filteredPromoters.add(cleanP);
      }
      if (item.disenador) {
        const cleanD = item.disenador.trim().toLowerCase();
        if (cleanD && cleanD !== 'desconocido') filteredDesigners.add(cleanD);
      }
    });

    const stats = {
      "Eventos": filtered.length,
      "Artistas": filteredArtists.size,
      "Diseñadores": filteredDesigners.size,
      "Promotores": filteredPromoters.size
    };

    // Run dynamic counter roll animations
    for (const [label, count] of Object.entries(stats)) {
      const badge = document.querySelector(`.filter-tag[data-category="${label}"] .tag-count-val`);
      if (badge) {
        const startVal = parseInt(badge.textContent) || 0;
        animateValue(badge, startVal, count, 200);
      }
    }

    const performDOMUpdates = () => {
      // 2. Paginate filtered dataset
      const totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      
      // Galería y Lista comparten SIEMPRE la misma secuencia (`filtered`): la
      // de la sesión mientras no se ordene nada, o la columna elegida en Lista
      // en cuanto se ordene. Filtrar/buscar solo oculta, nunca reordena — antes
      // la Lista saltaba a orden aleatorio en cuanto había una búsqueda activa
      // y volvía a cronológico al borrarla.
      const paginated = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

      // La galería va por libre (D-015): ignora la paginación (scroll
      // infinito por lotes). Su orden es aleatorio estable por sesión —
      // EXCEPTO si el visitante ha elegido explícitamente un orden en Lista
      // (currentSortCol), en cuyo caso la Galería adopta ese mismo orden
      // (y los mismos filtros, ya aplicados en `filtered` por igual para
      // ambas vistas) en vez del aleatorio. `paginated` sigue siendo el
      // corte de la lista.
      galleryOrderedCache = [...filtered];
      if (galleryVisibleCount < PAGE_SIZE) galleryVisibleCount = PAGE_SIZE;
      const galleryShown = galleryOrderedCache.slice(0, galleryVisibleCount);

      // Update pagination UI controls across desktop and mobile containers
      document.querySelectorAll('.pagination-controls-container').forEach(pagControls => {
        const pagNumbers = pagControls.querySelector('.pagination-numbers');
        const btnPrev = pagControls.querySelector('.btn-prev-page');
        const btnNext = pagControls.querySelector('.btn-next-page');

        if (pagNumbers) {
          pagNumbers.innerHTML = '';
          for (let p = 1; p <= totalPages; p++) {
            const btn = document.createElement('button');
            if (p === currentPage) {
              btn.className = "relative shrink-0 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer typo-body-roman text-mel-action-primary";
              btn.innerHTML = `
                <span>${p}</span>
                <div class="absolute bottom-1 left-0 right-0 h-[2px] flex justify-center">
                  <svg width="12" height="2" viewBox="0 0 12 2" fill="none" class="text-mel-action-primary">
                    <path d="M1 1C4.33333 1 7.66667 1 11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>
              `;
            } else {
              btn.className = "relative shrink-0 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer typo-body-roman text-mel-text-secondary hover:text-mel-action-primary transition-colors duration-200";
              btn.innerHTML = `<span>${p}</span>`;
              btn.addEventListener('click', () => {
                handlePaginationNav(p);
              });
            }
            pagNumbers.appendChild(btn);
          }
        }
        
        if (btnPrev) {
          if (currentPage === 1) {
            btnPrev.setAttribute('disabled', 'true');
          } else {
            btnPrev.removeAttribute('disabled');
          }
          if (!btnPrev._hasListener) {
            btnPrev._hasListener = true;
            btnPrev.addEventListener('click', () => {
              if (currentPage > 1) handlePaginationNav(currentPage - 1);
            });
          }
        }
        
        if (btnNext) {
          if (currentPage === totalPages) {
            btnNext.setAttribute('disabled', 'true');
          } else {
            btnNext.removeAttribute('disabled');
          }
          if (!btnNext._hasListener) {
            btnNext._hasListener = true;
            btnNext.addEventListener('click', () => {
              if (currentPage < totalPages) handlePaginationNav(currentPage + 1);
            });
          }
        }
      });

      // 3. Populate Gallery Grid View
      const gridContainer = document.getElementById('gallery-grid');

      const viewsEmptyState = document.getElementById('views-empty-state');
      const listTableWrapper = document.getElementById('list-table-wrapper');
      const listMobileCards = document.getElementById('list-mobile-cards');

      if (filtered.length === 0) {
        if (gridContainer) gridContainer.innerHTML = '';
        if (viewsEmptyState) {
          viewsEmptyState.classList.remove('hidden');
          viewsEmptyState.classList.add('flex');
        }
        gridContainer.classList.add('hidden');
        if (listTableWrapper) listTableWrapper.style.display = 'none';
        if (listMobileCards) listMobileCards.style.display = 'none';
        setSidePanelOpenState(false);
        // Sin resultados no hay nada que ver en NINGUNA vista, así que el
        // selector Galería/Mapa/Lista solo invita a dar tumbos entre tres
        // pantallas vacías. Se oculta para que el estado vacío quede solo y se
        // lea como lo que es: algo inesperado. `invisible` y no `hidden` para
        // no descolocar la toolbar mientras tanto.
        const toggleWrapper = document.getElementById('home-toggle-wrapper');
        if (toggleWrapper) {
          toggleWrapper.classList.add('hidden');
        }
        // El selector de vista se retira, pero los recuentos NO: al arrastrar
        // el slider de años se entra y se sale de "sin resultados" continuamente,
        // y unas tags que parpadean son peor que unas tags con ceros.
        // Al no estar el selector, ocupan el ancho que este deja libre.
        //
        // En el fotograma siguiente y no aquí mismo: llamándolo en el acto, el
        // reparto se calculaba antes de que el resto del pintado terminara y
        // quedaba con el ancho de cuando el selector todavía estaba (medido:
        // 808px en vez de 1224).
        requestAnimationFrame(() => window._melActualizarToolbar && window._melActualizarToolbar());
      } else {
        if (viewsEmptyState) {
          viewsEmptyState.classList.add('hidden');
          viewsEmptyState.classList.remove('flex');
        }
        const toggleWrapper = document.getElementById('home-toggle-wrapper');
        if (toggleWrapper) {
          toggleWrapper.classList.remove('hidden');
        }
        requestAnimationFrame(() => window._melActualizarToolbar && window._melActualizarToolbar());
        gridContainer.classList.remove('hidden');
        if (listTableWrapper) listTableWrapper.style.display = '';
        if (listMobileCards) listMobileCards.style.display = '';

        gridContainer.className = `grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-mel-l auto-rows-[4px] w-full pb-[13vh] relative`;
        // En el primer render se conservan las tarjetas que ya vinieron del SSR
        // (solo se miden) para no destruir el marcado servido... pero SOLO si
        // coinciden con lo que toca pintar. No coinciden en dos casos reales:
        // al recargar dentro de una sesión (el servidor baraja de nuevo y la
