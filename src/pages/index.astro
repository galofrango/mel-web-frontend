      });

      // Update TagWithLink components inside side panel
      const sideEventsVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Eventos"] .tag-count-val');
      if (sideEventsVal) sideEventsVal.textContent = group.events.length;
      
      const sideArtistsVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Artistas"] .tag-count-val');
      if (sideArtistsVal) sideArtistsVal.textContent = artistsSet.size;

      const sideDesignersVal = document.querySelector('#side-panel-tags-container .filter-tag[data-category="Diseñadores"] .tag-count-val');
      if (sideDesignersVal) sideDesignersVal.textContent = designersSet.size;

      // Populate event cards list inside side panel
      const listContainer = document.getElementById('side-panel-event-list');
      listContainer.innerHTML = '';

      group.events.forEach((evt, idx) => {
        const card = document.createElement('div');
        card.className = 'content-stretch cursor-pointer flex gap-4 items-center pl-6 pr-4 py-4 relative shrink-0 w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200';
        
        const imgSrc = extractDriveImage(evt.carruselItems[0]?.urlDrive) || `/flyers/flyer-1.png`;
        const hasDivider = idx < group.events.length - 1;
        
        card.innerHTML = `
          <div class="bg-mel-bg-secondary overflow-hidden shrink-0 w-[56px] h-[56px] border border-mel-border">
            <img src="${imgSrc}" alt="${evt.evento}" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col min-w-0 flex-1 gap-1">
            <p class="font-sans font-medium text-[16px] leading-[24px] tracking-[-0.32px] text-mel-text-primary truncate">${evt.evento}</p>
            <p class="font-serif font-medium text-[15px] leading-[24px] tracking-[0.15px] text-mel-text-secondary">${evt.fecha}</p>
          </div>
          <div class="w-6 h-6 flex items-center justify-center text-mel-action-secondary shrink-0">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          ${hasDivider ? '<div class="absolute bottom-[0.5px] h-0 left-[24px] right-[24px] border-b border-mel-border/30"></div>' : ''}
        `;
        
        card.addEventListener('click', () => {
          openDetailsOverlaySPA(evt, group.events);
        });
        listContainer.appendChild(card);
      });
    };

    if (isAlreadyOpen) {
      // Fade out content first, update DOM, and fade back in
      sidePanel.style.opacity = '0';
      setTimeout(() => {
        updateSidePanelDOM();
        sidePanel.style.opacity = '1';
        if (googleMap) {
          googleMap.panTo(group.coords);
        }
      }, 150);
    } else {
      // Update and open dynamically, pushing the map
      updateSidePanelDOM();
      sidePanel.style.opacity = '1';
      sidePanel.classList.remove('w-0', 'border-l-0');
      sidePanel.classList.add('w-[393px]', 'border-l');
      if (googleMap) {
        setTimeout(() => {
          google.maps.event.trigger(googleMap, "resize");
          googleMap.panTo(group.coords);
        }, 310);
      }
    }
  }

  function fitMapToMarkers() {
    if (!googleMap || mapMarkers.length === 0) return;
    const bounds = new google.maps.LatLngBounds();
    mapMarkers.forEach(m => {
      if (m.position) {
        bounds.extend(m.position);
      }
    });

    // A single marker (or several stacked on the same spot) makes a
    // zero-area bounds, which fitBounds() would zoom into as far as it
    // can go. We used to correct that with a one-time 'idle' listener
    // added after the fact — but with searches/filters calling this on
    // every keystroke, several of those could pile up unfired and then
    // all fire together on some later, unrelated zoom (e.g. opening a
    // cluster), stomping it back down to 15. Checking synchronously up
    // front avoids ever needing that listener.
    const ne = bounds.getNorthEast();
    const sw = bounds.getSouthWest();
    if (ne.equals(sw)) {
      googleMap.setCenter(ne);
      googleMap.setZoom(15);
    } else {
      googleMap.fitBounds(bounds);
    }
  }

  // Google's setZoom() jumps straight to the target level with no in-between
  // frames — this steps through it one level at a time, waiting for each
  // step's 'zoom_changed' before firing the next, so it reads as a
  // continuous zoom-in instead of a snap.
  function smoothZoomTo(targetZoom) {
    const current = Math.round(googleMap.getZoom());
    if (current >= targetZoom) return;
    google.maps.event.addListenerOnce(googleMap, 'zoom_changed', () => {
      setTimeout(() => smoothZoomTo(targetZoom), 120);
    });
    googleMap.setZoom(current + 1);
  }

  function updateMapMarkers(shouldFitBounds = true) {
    if (!googleMap || !markerLib) return;

    // Clear existing markers from the clusterer (reused instance — see initGoogleMap)
    if (googleMapClusterer) {
      googleMapClusterer.clearMarkers();
    }
    mapMarkers.forEach(m => m.map = null);
    mapMarkers = [];
    if (infoWindow) infoWindow.close();

    // Get currently filtered archives
    const filtered = archives.filter(item => {
      const yr = getYear(item.fecha);
      const yearMatch = yr >= minYear && yr <= maxYear;
      const searchMatch = !searchQuery || 
        item.evento.toLowerCase().includes(searchQuery) || 
        item.lugar.toLowerCase().includes(searchQuery) ||
        item.localidad.toLowerCase().includes(searchQuery) ||
        item.artistas.toLowerCase().includes(searchQuery) ||
        item.organiza.toLowerCase().includes(searchQuery) ||
        item.disenador.toLowerCase().includes(searchQuery);
      return yearMatch && searchMatch;
    });

    // Group by location key for clustering (using item.coordenadas!)
    const locationGroups = {};
    filtered.forEach(item => {
      const coords = parseCoords(item.coordenadas, item.localidad);
      if (!coords) return;
      // Round coords to group nearby points
      const locKey = `${coords[0].toFixed(4)},${coords[1].toFixed(4)}`;
      if (!locationGroups[locKey]) {
        locationGroups[locKey] = {
          coords: { lat: coords[0], lng: coords[1] },
          locationName: item.lugar || item.localidad || 'León',
          events: []
        };
      }
      locationGroups[locKey].events.push(item);
    });

    // Auto-open side panel if loading with search/location parameter matching a specific place name
    const params = new URLSearchParams(window.location.search);
    const urlView = params.get('view');
    const urlSearch = params.get('search');
    const urlLocation = params.get('location');
    if (urlView === 'mapa' && !activeSidePanelKey) {
      const matchName = (urlLocation || urlSearch || '').toLowerCase().trim();
      if (matchName) {
        const matchKey = Object.keys(locationGroups).find(key => {
          return locationGroups[key].locationName.toLowerCase() === matchName;
        });
        if (matchKey) {
          activeSidePanelKey = matchKey;
        }
      }
    }

    // Update or hide side panel dynamically based on filtered data.
    // populateSidePanel() already opens the panel (if needed) and pans to
    // its coords itself, correctly timed against its own open/resize
    // transition — doing that again here just raced its own panTo with a
    // second, differently-timed one.
    if (activeSidePanelKey && locationGroups[activeSidePanelKey]) {
      activeSidePanelCoords = locationGroups[activeSidePanelKey].coords;
      populateSidePanel(locationGroups[activeSidePanelKey]);
    } else {
      activeSidePanelKey = null;
      activeSidePanelCoords = null;
      const sidePanel = document.getElementById('map-side-panel');
      if (sidePanel) {
        sidePanel.classList.remove('w-[393px]', 'border-l');
        sidePanel.classList.add('w-0', 'border-l-0');
        if (googleMap) {
          setTimeout(() => {
            google.maps.event.trigger(googleMap, "resize");
          }, 310);
        }
      }
    }

    // Create markers for each location group
    Object.keys(locationGroups).forEach(locKey => {
      const group = locationGroups[locKey];
      const count = group.events.length;

      // Build custom marker HTML (Always Text Marker format when not clustered)
      const markerContent = document.createElement('div');
      markerContent.className = 'mel-marker-wrapper';
      if (activeSidePanelKey === locKey) {
        markerContent.classList.add('active');
      }
      
      markerContent.innerHTML = `
        <div class="mel-marker-body text-marker">
          <span class="mel-marker-label">${group.locationName} (${count})</span>
        </div>
        <div class="mel-marker-pointer"></div>
      `;

      const marker = new markerLib.AdvancedMarkerElement({
        position: group.coords,
        content: markerContent,
        title: group.locationName
      });

      // Add click listener to show the details Side Panel
      marker.addListener("click", () => {
        activeSidePanelKey = locKey;
        // populateSidePanel() already pans to group.coords itself, timed to
        // run after the panel's own open/resize transition so it centers
        // against the map's final (post-panel) width — no separate panTo/
        // setZoom here, which used to fire immediately (before that resize)
        // and could also zoom out if already zoomed in past 15.
        populateSidePanel(group);
        updateMapMarkers(false); // Redraw map to update the active marker color without resetting bounds!
      });

      mapMarkers.push(marker);
    });

    // Add the freshly-filtered markers to the single, reused clusterer
    // instance (created once in initGoogleMap). Re-instantiating a new
    // MarkerClusterer here on every filter change left the previous
    // instance's rendered marker/cluster DOM nodes stuck on the map.
    if (googleMapClusterer && mapMarkers.length > 0) {
      googleMapClusterer.addMarkers(mapMarkers);
    }

    // Auto-fit bounds of the Google Map ONLY if the map view is active/visible
    // and the caller actually wants it (callers that are about to apply
    // their own pan/zoom, e.g. opening or closing a marker's panel, pass
    // false so they don't race against this fit).
    const mapContainer = document.getElementById('view-mapa');
    if (shouldFitBounds && mapContainer && !mapContainer.classList.contains('hidden')) {
      fitMapToMarkers();
    }
  }

  // -------------------------------------------------------
  // initHomePage — re-runs on every astro:page-load
  // -------------------------------------------------------
  function initHomePage() {
    // Re-sync local aliases from persisted state
    archives           = _s.archives;
    filtered           = _s.filtered;
    minYear            = _s.minYear;
    maxYear            = _s.maxYear;
    searchQuery        = _s.searchQuery;
    activeSidePanelKey = _s.activeSidePanelKey;
    currentPage        = _s.currentPage;
    currentSortCol     = _s.currentSortCol;
    currentSortDir     = _s.currentSortDir;
    ABSOLUTE_MIN_YEAR  = _s.ABSOLUTE_MIN_YEAR;
    ABSOLUTE_MAX_YEAR  = _s.ABSOLUTE_MAX_YEAR;
    currentDetailGroup   = _s.currentDetailGroup;
    currentCarruselIndex = _s.currentCarruselIndex;
    googleMap          = _s.googleMap;
    mapMarkers         = _s.mapMarkers;
    mapInitialized     = _s.mapInitialized;
    infoWindow         = _s.infoWindow;
    mapCore            = _s.mapCore;
    markerLib          = _s.markerLib;
    googleMapClusterer = _s.googleMapClusterer;
    overlayAutoplayInterval = _s.overlayAutoplayInterval;
    overlayCurrentIndex     = _s.overlayCurrentIndex;

    // Re-query all DOM element refs
    sliderMin  = document.getElementById('slider-min');
    sliderMax  = document.getElementById('slider-max');
    minHandle  = document.getElementById('min-handle');
    maxHandle  = document.getElementById('max-handle');
    minVal     = minHandle ? minHandle.querySelector('span') : null;
    maxVal     = maxHandle ? maxHandle.querySelector('span') : null;
    activeFill = document.getElementById('slider-active-fill');

    lightbox         = document.getElementById('lightbox');
    lightboxImg      = document.getElementById('lightbox-image');
    lightboxTitle    = document.getElementById('lightbox-title');
    lightboxLocation = document.getElementById('lightbox-location');
    lightboxCategory = document.getElementById('lightbox-category');
    lightboxDate     = document.getElementById('lightbox-date');
    closeLightboxBtn = document.getElementById('close-lightbox');

    btnPrevPage      = document.getElementById('btn-prev-page');
    btnNextPage      = document.getElementById('btn-next-page');
    paginationNumbers = document.getElementById('pagination-numbers');

    viewBtns      = document.querySelectorAll('.toggle-btn');
    viewPanels    = document.querySelectorAll('.view-panel');
    activeIndicator = document.getElementById('toggle-active-indicator');

    // Abort any previous window listeners to prevent duplicates across page transitions
    if (window._melAbortCtrl) window._melAbortCtrl.abort();
    window._melAbortCtrl = new AbortController();
    const wSig = window._melAbortCtrl.signal;

    // Bind all event listeners
    bindSliderEvents();
    bindLightboxEvents();
    bindPaginationEvents();

    // Listen for lightbox open from map popup buttons
    window.addEventListener('mel-open-lightbox', (e) => {
      const id = e.detail.id;
      const item = archives.find(x => x.idMel === id);
      if (item) openLightbox(item);
    }, { signal: wSig });

    // Listen for view switcher from menu items
    window.addEventListener('mel-switch-view', (e) => {
      switchView(e.detail.view);
    }, { signal: wSig });

    // Keep the map's basemap style in sync with the site's light/dark
    // toggle. setOptions({colorScheme}) updates the property but Google
    // keeps rendering tiles from whichever scheme the map was originally
    // created with — the only way to actually see the other style is to
    // rebuild the Map instance, so do that in place, preserving the
    // current view, and rebuild the markers on it.
    window.addEventListener('mel-color-scheme-change', (e) => {
      if (!googleMap) return;
      const center = googleMap.getCenter();
      const zoom = googleMap.getZoom();
      if (googleMapClusterer) googleMapClusterer.clearMarkers();
      mapMarkers.forEach(m => m.map = null);
      mapMarkers = [];
      createGoogleMapInstance(
        e.detail.isDark ? google.maps.ColorScheme.DARK : google.maps.ColorScheme.LIGHT,
        center,
        zoom
      );
      updateMapMarkers(false);
    }, { signal: wSig });

    // Listen for search events
    window.addEventListener('mel-search', (e) => {
      searchQuery = e.detail.query.toLowerCase().trim();
      _s.searchQuery = searchQuery;
      try {
        const url = new URL(window.location.href);
        if (searchQuery) {
          url.searchParams.set('search', searchQuery);
        } else {
          url.searchParams.delete('search');
        }
        window.history.replaceState({}, '', url.toString());
      } catch (err) {
        console.warn("Unable to update URL query params", err);
      }
      currentPage = 1;
      _s.currentPage = 1;
      filterArchives(true);
    }, { signal: wSig });

    viewBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const button = e.target.closest('.toggle-btn');
        if (button) switchView(button.dataset.view);
      });
    });

    // Bind overlay close
    const overlayCloseBtn = document.getElementById('event-details-overlay-close');
    if (overlayCloseBtn) {
      overlayCloseBtn.onclick = () => closeDetailsOverlaySPA(true);
    }

    window.addEventListener('popstate', (e) => {
      const overlay = document.getElementById('event-details-overlay');
      if (overlay && !overlay.classList.contains('hidden')) {
        _s.mapInitialized = false;
        _s.googleMap = null;
        _s.mapMarkers = [];
        _s.infoWindow = null;
        _s.googleMapClusterer = null;
        closeDetailsOverlaySPA(false);
      }
    }, { signal: wSig });

    // Initialize state and render
    calculateDynamicBounds();
    updateSlider();
    bindInitialCardClicks();
    initSortHeaders();

    // Parse view from URL on load
    const loadParams = new URLSearchParams(window.location.search);
    const viewParam = loadParams.get('view');
    if (viewParam === 'mapa') {
      switchView('mapa');
    } else if (viewParam === 'lista') {
      switchView('lista');
    } else {
      switchView('galería');
    }

    // Deep link: ?detail=MEL-XXXX (the URL the overlay writes while open)
    // re-opens that event's overlay on top of the chosen view, so overlay
    // URLs are fully shareable.
    const detailParam = loadParams.get('detail');
    if (detailParam) {
      const targetEvent = archives.find(x => x.idMel === detailParam);
      const overlayEl = document.getElementById('event-details-overlay');
      if (targetEvent && overlayEl && overlayEl.classList.contains('hidden')) {
        openDetailsOverlaySPA(targetEvent, filtered.length ? filtered : archives);
      }
    }
  }

  // ----------------------------------------------------
  // Fullscreen SPA Event Details Overlay Implementation
  // ----------------------------------------------------

  function makeTagHtml(label, value, href) {
    const isUnknown = !value || value.toLowerCase() === 'desconocido' || value.toLowerCase() === 'no detallados';
    const displayVal = isUnknown ? 'desconocido' : value;

    return `
      <div class="flex flex-col items-start gap-1 w-full select-none">
        <span class="font-sans text-[13px] font-bold tracking-[1.56px] leading-[16px] uppercase text-mel-text-primary">${label}</span>
        ${(!isUnknown && href)
          ? `<a href="${href}" class="group/tag font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary hover:text-mel-action-primary transition-colors relative inline-flex items-center gap-1 no-underline"><span class="relative inline-block text-inherit">${displayVal}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover/tag:scale-x-100 transition-transform duration-200 origin-left"></span></span><svg class="w-3 h-3 text-inherit opacity-0 group-hover/tag:opacity-100 transition-all duration-200 transform translate-x-[-4px] group-hover/tag:translate-x-0 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></a>`
          : `<span class="font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] ${isUnknown ? 'text-mel-text-tertiary' : 'text-mel-text-secondary'}">${displayVal}</span>`
        }
      </div>
    `;
  }

  function renderOverlayEvent(eventItem, panelEvents) {
    // 1. Text & Basic Details
    document.getElementById('overlay-event-title').textContent = eventItem.evento;
    
    const desc = eventItem.descripcion || '';
    const descContainer = document.getElementById('overlay-description-container');
    const descText = document.getElementById('overlay-event-description');
    if (desc) {
      descText.textContent = desc;
      descContainer.classList.remove('hidden');
    } else {
      descContainer.classList.add('hidden');
    }

    // 2. Sidebar Tags
    const sidebar = document.getElementById('overlay-tags-sidebar');
    sidebar.innerHTML = `
      ${makeTagHtml("Fecha", eventItem.fecha)}
      ${makeTagHtml("Lugar", eventItem.lugar, `/?view=mapa&location=${encodeURIComponent(eventItem.lugar)}`)}
      ${makeTagHtml("Localidad", eventItem.localidad, `/?search=${encodeURIComponent(eventItem.localidad)}`)}
      ${makeTagHtml("Organiza", eventItem.organiza, `/?search=${encodeURIComponent(eventItem.organiza)}`)}
      ${makeTagHtml("Diseño", eventItem.disenador, `/?search=${encodeURIComponent(eventItem.disenador)}`)}
    `;

    // 3. Artists List
    const artistsContainer = document.getElementById('overlay-artists-container');
    const artistsList = document.getElementById('overlay-artists-list');
    if (eventItem.artistas && eventItem.artistas.toLowerCase() !== 'no detallados') {
      artistsContainer.classList.remove('hidden');
      artistsList.innerHTML = eventItem.artistas.split(/[,;\/]+/).map((artist, idx, arr) => {
        const cleanArtist = artist.trim();
        if (!cleanArtist) return '';
        const isLast = idx === arr.length - 1;
        return `
          <span class="inline-flex items-center whitespace-nowrap">
            <a href="/?search=${encodeURIComponent(cleanArtist)}" class="group/art font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary hover:text-mel-action-primary transition-colors relative inline-flex items-center no-underline"><span class="relative inline-block text-inherit">${cleanArtist}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover/art:scale-x-100 transition-transform duration-200 origin-left"></span></span></a>
            ${!isLast ? `<span class="text-mel-text-secondary mr-2 font-serif font-medium text-[15px] leading-[24px] tracking-[0.15px]">,</span>` : ''}
          </span>
        `;
      }).join('');
    } else {
      artistsContainer.classList.add('hidden');
    }

    // 4. Image carousel
    const track = document.getElementById('overlay-carousel-track');
    const imageUrls = eventItem.carruselItems.map(item => extractDriveImage(item.urlDrive)).filter(Boolean);
    
    // Clear any previous interval
    if (overlayAutoplayInterval) {
      clearInterval(overlayAutoplayInterval);
      overlayAutoplayInterval = null;
    }

    track.innerHTML = imageUrls.map(img => `
      <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
        <img src="${img}" alt="${eventItem.evento}" class="w-full h-full object-contain" referrerpolicy="no-referrer" />
      </div>
    `).join('');

    overlayCurrentIndex = 0;
    track.style.transform = `translate3d(0, 0, 0)`;

    // Dots
    const dotsContainer = document.getElementById('overlay-carousel-dots');
    dotsContainer.innerHTML = '';
    
    function updateOverlayCarousel(idx) {
      overlayCurrentIndex = (idx + imageUrls.length) % imageUrls.length;
      track.style.transform = `translate3d(-${overlayCurrentIndex * 100}%, 0, 0)`;
      const dots = dotsContainer.querySelectorAll('.overlay-carousel-dot');
      dots.forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === overlayCurrentIndex ? 'true' : 'false');
      });
    }

    function startOverlayAutoplay() {
      if (overlayAutoplayInterval) clearInterval(overlayAutoplayInterval);
      if (imageUrls.length <= 1) return;
      overlayAutoplayInterval = setInterval(() => {
        updateOverlayCarousel(overlayCurrentIndex + 1);
      }, 5000);
    }

    if (imageUrls.length > 1) {
      imageUrls.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = 'overlay-carousel-dot w-8 h-8 flex items-center justify-center relative cursor-pointer group select-none';
        dot.setAttribute('data-index', idx);
        dot.setAttribute('data-active', idx === 0 ? 'true' : 'false');
        dot.innerHTML = `
          <div class="absolute inset-[4px] border border-mel-action-tertiary transition-all duration-300 opacity-0 scale-75 group-data-[active=true]:opacity-100 group-data-[active=true]:scale-100 pointer-events-none flex items-center justify-center">
            <div class="w-2 h-2 bg-mel-action-tertiary"></div>
          </div>
          <div class="dot-resting w-2 h-2 bg-mel-action-secondary transition-all duration-300 group-hover:w-[6px] group-hover:h-[6px] group-hover:bg-mel-action-primary group-data-[active=true]:opacity-0"></div>
        `;
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          updateOverlayCarousel(idx);
          startOverlayAutoplay();
        });
        dotsContainer.appendChild(dot);
      });
      startOverlayAutoplay();
    }

    // 5. Zoom image visualizer within overlay. The modal is a fixed-size
    // CSS box (Figma 841:40903) and the photo object-contains inside it —
    // no JS sizing off the image's natural dimensions (the old approach
    // both let big photos overflow the screen and leaked one window
    // resize listener per rendered event).
    const carouselMain = document.getElementById('overlay-carousel-main');
    const imageLightbox = document.getElementById('overlay-image-lightbox');
    const lightboxModal = document.getElementById('overlay-lightbox-modal');
    const lightboxTrack = document.getElementById('overlay-lightbox-track');
    const lightboxDotsContainer = document.getElementById('overlay-lightbox-dots');

    lightboxTrack.innerHTML = imageUrls.map(img => `
      <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
        <img src="${img}" alt="${eventItem.evento}" class="w-full h-full object-contain" referrerpolicy="no-referrer" />
      </div>
    `).join('');

    let lightboxIndex = 0;

    // Same sliding-track transition as the main carousel, but this never autoplays on its own
    function showLightboxImage(idx) {
      if (!imageUrls || imageUrls.length === 0) return;
      lightboxIndex = (idx + imageUrls.length) % imageUrls.length;
      if (lightboxTrack) lightboxTrack.style.transform = `translate3d(-${lightboxIndex * 100}%, 0, 0)`;
      lightboxDotsContainer.querySelectorAll('.overlay-lightbox-dot').forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === lightboxIndex ? 'true' : 'false');
      });
    }

    // Let the single, page-level keydown listener reach this event's current lightbox state
    window._melState.activeLightbox = {
      showImage: showLightboxImage,
      getIndex: () => lightboxIndex,
    };

    // Rebuild the lightbox pagination for THIS event's images
    lightboxDotsContainer.innerHTML = '';
    if (imageUrls.length > 1) {
      imageUrls.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = 'overlay-lightbox-dot w-8 h-8 flex items-center justify-center relative cursor-pointer group select-none';
        dot.setAttribute('data-index', idx);
        dot.setAttribute('data-active', idx === 0 ? 'true' : 'false');
        dot.innerHTML = `
          <div class="absolute inset-[4px] border border-mel-action-tertiary transition-all duration-300 opacity-0 scale-75 group-data-[active=true]:opacity-100 group-data-[active=true]:scale-100 pointer-events-none flex items-center justify-center">
            <div class="w-2 h-2 bg-mel-action-tertiary"></div>
          </div>
          <div class="dot-resting w-2 h-2 bg-mel-action-secondary transition-all duration-300 group-hover:w-[6px] group-hover:h-[6px] group-hover:bg-mel-action-primary group-data-[active=true]:opacity-0"></div>
        `;
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          showLightboxImage(idx);
        });
        lightboxDotsContainer.appendChild(dot);
      });
    }

    carouselMain.onclick = () => {
      if (overlayAutoplayInterval) clearInterval(overlayAutoplayInterval);
      showLightboxImage(overlayCurrentIndex);
      imageLightbox.classList.remove('hidden');
      setTimeout(() => {
        imageLightbox.classList.remove('opacity-0', 'pointer-events-none');
        imageLightbox.classList.add('opacity-100', 'pointer-events-auto');
        lightboxModal.classList.remove('scale-95');
        lightboxModal.classList.add('scale-100');
      }, 10);
    };

    const closeOverlayLightbox = () => {
      imageLightbox.classList.remove('opacity-100', 'pointer-events-auto');
      imageLightbox.classList.add('opacity-0', 'pointer-events-none');
      lightboxModal.classList.remove('scale-100');
      lightboxModal.classList.add('scale-95');
      setTimeout(() => {
        imageLightbox.classList.add('hidden');
        startOverlayAutoplay();
      }, 300);
    };

    document.getElementById('overlay-lightbox-close').onclick = closeOverlayLightbox;
    imageLightbox.onclick = (e) => {
      if (e.target === imageLightbox) closeOverlayLightbox();
    };

    // 6. Like button
    const likeKey = `mel-like-${eventItem.idMel}`;
    let isLiked = localStorage.getItem(likeKey) === 'true';
    const likeBtn = document.getElementById('overlay-btn-me-presta');
    const updateLikeUI = () => {
      likeBtn.setAttribute('data-active', isLiked ? 'true' : 'false');
    };
    updateLikeUI();
    likeBtn.onclick = () => {
      isLiked = !isLiked;
      localStorage.setItem(likeKey, String(isLiked));
      updateLikeUI();
    };

    // 7. Navigation
    const curIdx = panelEvents.findIndex(x => x.idMel === eventItem.idMel);
    const prevItem = curIdx > 0 ? panelEvents[curIdx - 1] : null;
    const nextItem = curIdx < panelEvents.length - 1 ? panelEvents[curIdx + 1] : null;

    const prevNav = document.getElementById('overlay-nav-prev-container');
    const nextNav = document.getElementById('overlay-nav-next-container');

    prevNav.innerHTML = '';
    nextNav.innerHTML = '';

    // Prev/next markup mirrors the real /event/[id] page's TagWithLink +
    // Link combo: sans uppercase label, then a serif (Lora) title in
    // text-secondary that turns action-primary on hover, with the sliding
    // chevron (left-pointing before the text for Anterior, right-pointing
    // after it for Siguiente) and the scaleX underline.
    if (prevItem) {
      const prevBtn = document.createElement('div');
      prevBtn.className = 'w-full max-w-[496px] cursor-pointer group flex flex-col items-end gap-2 select-none';
      prevBtn.innerHTML = `
        <span class="font-sans text-[13px] font-bold tracking-[1.56px] leading-[16px] uppercase text-mel-text-primary">Anterior</span>
        <span class="relative inline-flex items-center gap-1 max-w-full font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary group-hover:text-mel-action-primary transition-colors">
          <svg class="w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[4px] group-hover:translate-x-0 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          <span class="relative inline-block truncate">${prevItem.evento}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span></span>
        </span>
      `;
      prevBtn.addEventListener('click', () => {
        transitionToOverlayEvent(prevItem, panelEvents);
      });
      prevNav.appendChild(prevBtn);
    }

    if (nextItem) {
      const nextBtn = document.createElement('div');
      nextBtn.className = 'w-full max-w-[496px] cursor-pointer group flex flex-col items-start gap-2 select-none';
      nextBtn.innerHTML = `
        <span class="font-sans text-[13px] font-bold tracking-[1.56px] leading-[16px] uppercase text-mel-text-primary">Siguiente</span>
        <span class="relative inline-flex items-center gap-1 max-w-full font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary group-hover:text-mel-action-primary transition-colors">
          <span class="relative inline-block truncate">${nextItem.evento}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span></span>
          <svg class="w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[-4px] group-hover:translate-x-0 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </span>
      `;
      nextBtn.addEventListener('click', () => {
        transitionToOverlayEvent(nextItem, panelEvents);
      });
      nextNav.appendChild(nextBtn);
    }
  }

  // The overlay works from every context (gallery, list, map panel), so its
  // URL handling is context-neutral: just set/remove a `detail` param on top
  // of whatever the current URL already carries (view, search, location…)
  // instead of the old hardcoded map-flavored URL. replaceState keeps this
  // outside the history stack so Astro's router never gets involved.
  function setDetailParam(idMel) {
    try {
      const url = new URL(window.location.href);
      if (idMel) {
        url.searchParams.set('detail', idMel);
      } else {
        url.searchParams.delete('detail');
      }
      window.history.replaceState(idMel ? { spaDetail: true } : {}, '', url.toString());
    } catch(e){}
  }

  function transitionToOverlayEvent(newEvent, panelEvents) {
    setDetailParam(newEvent.idMel);

    const content = document.getElementById('overlay-details-content');
    if (content) {
      content.style.opacity = '0';
      setTimeout(() => {
        renderOverlayEvent(newEvent, panelEvents);
        content.style.opacity = '1';
      }, 250); // 250ms fade out, 250ms fade in = 500ms total dissolve transition!
    }
  }

  function openDetailsOverlaySPA(eventItem, panelEvents) {
    document.body.classList.add('overflow-hidden');

    setDetailParam(eventItem.idMel);

    // Show overlay
    const overlay = document.getElementById('event-details-overlay');
    if (overlay) {
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    }

    renderOverlayEvent(eventItem, panelEvents);
  }

  function closeDetailsOverlaySPA(shouldRestoreUrl = true) {
    const overlay = document.getElementById('event-details-overlay');
    if (overlay) {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }

    if (overlayAutoplayInterval) {
      clearInterval(overlayAutoplayInterval);
      overlayAutoplayInterval = null;
    }

    document.body.classList.remove('overflow-hidden');

    // Dropping just the detail param returns to the exact context the
    // visitor was in (view, search, panel…) — and also covers the
    // deep-link case, where there was no "previous" URL to restore.
    if (shouldRestoreUrl) setDetailParam(null);
  }

  // Overlay close buttons are bound in initHomePage()

  // --- List View Sorting and Navigation Actions ---

  window.showLocationOnMap = function(lugarName) {
    switchView('mapa');
    const matchKey = Object.keys(locationGroups).find(key => {
      return locationGroups[key].locationName.toLowerCase() === lugarName.toLowerCase().trim();
    });
    if (matchKey) {
      activeSidePanelKey = matchKey;
      populateSidePanel(locationGroups[matchKey]);
      const sidePanel = document.getElementById('map-side-panel');
      if (sidePanel) {
        sidePanel.classList.remove('w-0', 'border-l-0');
        sidePanel.classList.add('w-[360px]', 'border-l');
        sidePanel.style.opacity = '1';
      }
      const group = locationGroups[matchKey];
      if (group && googleMap) {
        googleMap.setCenter(group.coords);
        googleMap.setZoom(15);
      }
    }
  };

  window.searchInListView = function(query) {
    window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query } }));
  };

  function handleSortClick(col) {
    if (currentSortCol === col) {
      currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
    } else {
      currentSortCol = col;
      currentSortDir = 'asc';
    }

    // Update Header Icons UI
    const headers = document.querySelectorAll('.sort-header');
    headers.forEach(h => {
      const hCol = h.dataset.col;
      const iconSpan = h.querySelector('.sort-icon');
      if (hCol === currentSortCol) {
        iconSpan.className = 'sort-icon text-mel-action-primary shrink-0';
        if (currentSortDir === 'asc') {
          iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>`;
        } else {
          iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>`;
        }
      } else {
        iconSpan.className = 'sort-icon text-mel-action-secondary shrink-0';
        iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>`;
      }
    });

    // Re-render starting at page 1
    currentPage = 1;
    filterArchives();
  }

  // Initialize sort click listeners
  function initSortHeaders() {
    document.querySelectorAll('.sort-header').forEach(h => {
      h.addEventListener('click', () => {
        handleSortClick(h.dataset.col);
      });
    });
  }

  // -------------------------------------------------------
  // Bootstrap. astro:page-load fires on the initial page load too (the
  // ClientRouter in Layout.astro guarantees it), so it must be the ONLY
  // entry point: calling initHomePage() directly here as well ran it twice
  // per full load, double-binding every element listener — one sort-header
  // click toggled the direction twice (always ending up desc), one
  // pagination click advanced two pages, and every re-render kicked off
  // two overlapping view transitions.
  // -------------------------------------------------------
  document.addEventListener('astro:page-load', initHomePage);
 
</script>
