     escala con la pasada. Su primera versión, en el bloque con ámbito de
     arriba, nació muerta — trampa D-239.) */

  /* Las tarjetas móviles de la Lista llevan fondo propio (D-253): sin él,
     durante los vuelos del FLIP se transparentaban unas sobre otras. */
  .mobile-event-card-list {
    background-color: var(--mel-bg-primary);
  }

  /* The shared .view-panel.active rule sets display:flex, which stretches the
     gallery grid to the scroll viewport height and makes its rows overflow —
     that buries the grid's bottom padding mid-content instead of below the last
     row. Force the gallery scroll container to flow as a block so the grid grows
     to its natural height and pb reserves real space at the end of the scroll.
     :not(.hidden) keeps the display:none !important hide behaviour intact. */
  #view-galería:not(.hidden) {
    display: block;
  }

  /* Masonry por CSS Grid + row-span (D-015): cada tarjeta reserva tantas
     filas de 4px (auto-rows del contenedor) como pide su imagen a ancho de
     columna más el hueco de 24px — lo calcula sizeGalleryCard() cuando la
     imagen publica su ratio (onload). align-self:start deja que la tarjeta
     mida exactamente lo que mide su imagen: el resto del área reservada es
     el hueco vertical. A diferencia del multicol, añadir tarjetas al final
     NO recoloca las existentes (requisito del scroll infinito). */
  /* `position: relative` en la rejilla: ancla los fantasmas de despedida
     (absolute) del arrastre del slider — ver performDOMUpdates (D-252). */
  #gallery-grid {
    position: relative;
  }

  .gallery-item {
    align-self: start;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    /* Cada tarjeta es su propio contenedor de consulta, para que la pastilla de
       abajo pueda preguntar por el ancho de SU tarjeta. Solo en el eje en línea:
       el alto lo sigue poniendo la imagen, que es de lo que vive el masonry. */
    container-type: inline-size;
  }

  /* La pastilla con el título y la fecha solo aparece si la tarjeta da de sí.
     Por debajo de 240px el texto sale apelmazado, y en un móvil encima aparece
     sin querer: al dejar el dedo sobre una tarjeta el navegador le aplica el
     estado `hover`, y salta una pastilla que allí no pinta nada.
     Se mide la TARJETA y no la ventana a propósito: su ancho depende del número
     de columnas, y ese número no sale de un breakpoint — la cuarta columna se
     decide midiendo (ver `.galeria-cuatro`). A 1180px, por ejemplo, hay cuatro
     columnas de 223px: una ventana ancha con tarjetas estrechas. */
  @container (max-width: 239px) {
    .flyer-label {
      display: none;
    }
  }
  /* Placeholder mientras la imagen aún no ha declarado su ratio: bloque
     blanco de ~300px para que la rejilla no arranque colapsada. */
  .gallery-item.unsized {
    grid-row-end: span 75;
    min-height: 280px;
  }

  .gallery-item:hover {
    transform: scale(1.025) !important;
    z-index: 30 !important;
    box-shadow: 0 239px 67px 0 rgb(var(--mel-shadow-rgb) / 0.00),
                0 153px 61px 0 rgb(var(--mel-shadow-rgb) / 0.01),
                0 86px 52px 0 rgb(var(--mel-shadow-rgb) / 0.05),
                0 38px 38px 0 rgb(var(--mel-shadow-rgb) / 0.09),
                0 10px 21px 0 rgb(var(--mel-shadow-rgb) / 0.10) !important;
  }

  @keyframes marker-fade-in {
    0% {
      opacity: 0;
      transform: scale(0.6) translateY(10px);
    }
    60% {
      opacity: 1;
      transform: scale(1.08) translateY(-2px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* List view: rows genuinely new to the visible page (not just reordered)
     fade in — the FLIP reorder itself is driven inline via style.transform,
     see performDOMUpdates(). */
  @keyframes list-row-intro {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .list-row-intro {
    animation: list-row-intro 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Tags del panel lateral del mapa (marcado SSR de AdaptiveTagsRow, valores
     escritos por updateAdaptiveTagsRow()): el valor nunca parte a dos líneas
     ni se sale de la caja del tag — siempre puntos suspensivos. */
  .tag-value-link {
    min-width: 0;
    max-width: 100%;
  }
  .tag-value-text {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }


  @keyframes marker-fade-out {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.6) translateY(10px);
    }
  }

  .mel-marker-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    cursor: pointer;
    /* Al mantener el dedo sobre un marcador, el móvil hacía lo que hace con
       cualquier texto: seleccionarlo (D-245). Salía el resaltado sobre la
       etiqueta, y a veces las asas de selección y la lupa — encima solo de
       la etiqueta, no del puntero ni de la sombra, así que el marcador se
       veía partido en trozos. Un marcador es un botón, no un párrafo: no hay
       nada que copiar en él.
       `-webkit-touch-callout` quita además el menú contextual de iOS, y
       `tap-highlight-color` el rectángulo azul que Android pinta al tocar. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s ease-out;
    animation: marker-fade-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Sombra plana bajo el marcador (Figma 341:26188, D-222) — sustituye al
     `filter: drop-shadow` que llevaba antes el wrapper entero en reposo. Es
     un trapecio (más ancho abajo que arriba) que se ensancha desde la punta
     del puntero, en vez de un halo difuminado siguiendo el contorno.
     Proporcional al ancho del propio marcador (78%/11% de margen cada
     lado) y no a un ancho fijo, porque aquí los marcadores no son un pin de
     tamaño fijo: se ensanchan según el texto de la etiqueta.

     SIN `mix-blend-mode: multiply`, y no por olvido (D-229): es IMPOSIBLE
     aquí. Google posiciona cada marcador con un `transform` en línea, y un
     `transform` distinto de `none` crea un contexto de apilamiento — que
     aísla la mezcla. La sombra solo puede mezclarse con lo que haya dentro
     de SU marcador, que es transparente, así que se pinta como color plano.
     Comprobado en el navegador dos veces: con la sombra en rojo saturado y
     agrandada no se transparentaba ni una carretera del mapa, y forzar
     `will-change: auto` sobre `gmp-advanced-marker` tampoco cambió nada
     porque el `transform` basta por sí solo. Tampoco se arregla aislando
     `#map-container`: el contexto que estorba es el de cada marcador, no el
     del mapa.

     Se sustituye por Tinted-400 al 40% (criterio del propietario), que
     sobre el fondo claro del mapa da un gris muy parecido al que daría el
     multiply, y al ser semitransparente no tapa en bloque lo que quede
     debajo. */
  .mel-marker-shadow {
    position: absolute;
    left: 11%;
    right: 11%;
    bottom: -4px;
    height: 8px;
    background-color: color-mix(in srgb, var(--mel-primitive-tinted-400) 40%, transparent);
    clip-path: polygon(10% 0, 90% 0, 100% 100%, 0% 100%);
    pointer-events: none;
    /* Acompaña al despegue del marcador (D-240) con la misma duración y
       curva, para que encoger, aclararse y elevarse se lean como un solo
       gesto y no como tres cosas sueltas. */
    transition: left 0.15s ease-out, right 0.15s ease-out,
                background-color 0.15s ease-out;
  }

  .mel-marker-wrapper.exiting {
    animation: marker-fade-out 0.15s cubic-bezier(0.4, 0, 1, 1) forwards;
    pointer-events: none;
  }

  /* Burbujas de cluster que CONTINÚAN un grupo ya visible (D-250): sin
     animación de entrada. El clusterer no es incremental — destruye y recrea
     todas las burbujas en cada re-render (cambio de membresía, zoom) — y el
     rebote de escala de `marker-fade-in` repetido en cada tirón del slider
     era los "saltitos" que veía el propietario. La entrada con rebote queda
     solo para grupos que aparecen de verdad (carga inicial del mapa). */
  .mel-marker-wrapper.sin-entrada {
    animation: none;
  }

  /* Acotado a puntero fino: sin esto, tocar un marcador en móvil lo dejaba
     agrandado y con la sombra realzada hasta el siguiente scroll — el "hover"
     que el navegador simula al tocar, y que no suelta hasta entonces (mismo
     mecanismo que el botón "Me presta", ver LikeButton.astro). No hace falta
     equivalente táctil: tocar ya dispara `.active` (JS) y abre el panel, así
     que el aviso real no depende de este realce, que es puro adorno de ratón. */
  @media (hover: hover) and (pointer: fine) {
    .mel-marker-wrapper:hover {
      transform: scale(1.05);
      z-index: 99999 !important;
    }
    /* El marcador se DESPEGA de su sombra al pasar el ratón (D-239, Figma
       261:10331). En el componente de Figma esto es un margen negativo de
       4px que el puntero lleva en reposo y que la variante Hover quita: en
       reposo la punta pisa la sombra, en hover se separa de ella.
       Aquí se traduce en subir cuerpo y puntero 4px y dejar la sombra
       quieta — por eso NO se hace en el wrapper, que arrastraría también a
       la sombra y no habría separación ninguna. `.active` no lo lleva:
       en Figma esa variante conserva el margen negativo. */
    .mel-marker-wrapper:hover .mel-marker-body,
    .mel-marker-wrapper:hover .mel-marker-pointer {
      transform: translateY(-4px);
    }

    /* Y la sombra ENCOGE mientras el marcador sube, hasta el 72% de su ancho
       original (D-250, afinado por el propietario desde el 60% del primer
       intento; antes eran solo 4px por lado y apenas se notaba): en reposo
       ocupa el 78% del wrapper (11% de margen por lado), así que el 72% de
       eso son 56,2% de ancho → 21,9% de margen por cada lado, centrada. Y 16 puntos menos de opacidad (40% → 24%), para que se lea
       como que queda más lejos y más pequeña. Va aquí dentro, con el resto
       del realce de ratón: fuera del media query, el "hover" que el móvil
       simula al tocar la dejaría encogida y clara hasta el siguiente toque
       en otro sitio (la misma trampa de D-232). El estado `.active` no
       entra: ese lo gobierna el JS y conserva su sombra a tamaño y opacidad
       completos. */
    .mel-marker-wrapper:hover .mel-marker-shadow {
      left: 21.9%;
      right: 21.9%;
      background-color: color-mix(in srgb, var(--mel-primitive-le-400) 24%, transparent);
    }
  }

  /* En hover y en activo manda SOLO la sombra plana nueva, que además pasa a
     LE-400 (D-232). El halo difuminado que se sumaba en `:hover`
     —`drop-shadow(0 6px 16px …)`— se ha retirado de esa regla: eran dos
     sombras a la vez y el conjunto se ensuciaba. El `filter: none` de aquí
     es una guarda por si alguien vuelve a colgar un filtro del wrapper; no
     toca el `brightness` del cuerpo ni del puntero, que van en sus propios
     selectores y sí forman parte del estado activo. */
  .mel-marker-wrapper:hover,
  .mel-marker-wrapper.active {
    filter: none;
  }
  /* Activo: solo cambia el COLOR (mismo 40% que en reposo). No encoge ni se
     aclara — eso es propio del hover, que es un realce de paso; el activo es
     un estado que se queda. El hover vive en el media query de arriba. */
  .mel-marker-wrapper.active .mel-marker-shadow {
    background-color: color-mix(in srgb, var(--mel-primitive-le-400) 40%, transparent);
  }

  /* MODO OSCURO (D-243). La sombra plana desaparece en TODOS los estados: es
     una mancha clara pensada para un mapa claro, y sobre el mapa oscuro se
     lee como suciedad debajo del marcador. En su lugar, el resplandor que
     especificó el propietario (Figma: X 0 · Y 4 · Blur 4 · Spread 0 ·
     #190609 al 100%).
     Va como `drop-shadow` y no como `box-shadow` a propósito: `box-shadow`
     dibujaría un rectángulo, y el marcador no lo es — tiene la punta del
     puntero. `drop-shadow` sigue la silueta real de las dos piezas.
     Se repite en `:hover` y `.active` porque esos dos estados llevan un
     `filter: none` que si no lo borraría. */
  .dark .mel-marker-shadow {
    display: none;
  }
  .dark .mel-marker-wrapper,
  .dark .mel-marker-wrapper:hover,
  .dark .mel-marker-wrapper.active {
    filter: drop-shadow(0 4px 4px #190609);
  }

  .mel-marker-wrapper.active {
    z-index: 99998 !important;
  }
  .mel-marker-wrapper.active .mel-marker-body {
    background-color: var(--mel-action-primary) !important;
    filter: brightness(1.05);
  }
  .mel-marker-wrapper.active .mel-marker-pointer {
    border-top-color: var(--mel-action-primary) !important;
    filter: brightness(1.05);
  }
  .mel-marker-wrapper.active .mel-marker-label {
    color: var(--mel-text-on-action-primary) !important;
  }

  /* Cuerpo del CLUSTER (es el único marcador que no lleva `.text-marker`).
     `padding: 10px 12px 10px 8px` y no `12px`, por dos motivos distintos:

     - Los 10px verticales, para que el texto se comporte igual que en el resto de
       marcadores. Con `height: 40px`, `box-sizing: border-box` y 12px arriba y
       abajo, la caja de contenido quedaba en 16px para una `line-height` de 20px:
       la caja de línea desbordaba 2px por arriba y 2 por abajo. Los pines sueltos
       (`.text-marker`, 8px verticales y alto automático) sí la encajan justa, así
       que el texto del cluster era el único renderizado a presión. Con 10px la
       caja de contenido mide exactamente los 20px de la línea.
     - Los 8px de la izquierda (4 menos que los 12 de la derecha) equilibran el
       peso dentro del bocadillo ahora que la etiqueta empieza por `+`: el signo
       es más ligero y más alto que las cifras y dejaba el conjunto descentrado a
       la vista aunque la caja estuviera centrada. Petición del propietario. */
  .mel-marker-body {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px 10px 8px;
    min-width: 40px;
    width: auto;
    height: 40px;
    background-color: var(--mel-action-secondary);
    border: none;
    transition: background-color 0.15s ease-out, filter 0.15s ease-out, transform 0.15s ease-out;
    box-sizing: border-box;
  }

  .mel-marker-body.text-marker {
    padding: 8px 12px;
    width: auto;
    height: auto;
  }

  .mel-marker-label {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
    color: var(--mel-text-on-action);
    white-space: nowrap;
    transition: color 0.15s ease-out;
  }

  /* Mismo acotado que `.mel-marker-wrapper:hover` de arriba, y mismo motivo:
     puro adorno de ratón, sin equivalente táctil necesario. */
  @media (hover: hover) and (pointer: fine) {
    .mel-marker-wrapper:hover .mel-marker-body {
      background-color: var(--mel-action-primary);
      filter: brightness(1.05);
    }

    .mel-marker-wrapper:hover .mel-marker-label {
      color: var(--mel-text-on-action-primary) !important;
    }
  }

  .mel-marker-pointer {
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 10px solid var(--mel-action-secondary);
    margin-top: -1px;
    transition: border-top-color 0.15s ease-out, filter 0.15s ease-out, transform 0.15s ease-out;
    /* Por ENCIMA de la sombra (D-250): la sombra es el último hermano del
       wrapper y, siendo la única posicionada, pintaba sobre el triángulo —
       al revés de la física que se imita. El puntero es item de un flex,
       así que z-index le aplica sin necesidad de posicionarlo. */
    z-index: 1;
  }

  /* Mismo acotado que el resto de `:hover` del marcador — ver más arriba. */
  @media (hover: hover) and (pointer: fine) {
    .mel-marker-wrapper:hover .mel-marker-pointer {
      border-top-color: var(--mel-action-primary);
      filter: brightness(1.05);
    }
  }

  .sort-header {
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .sort-header:hover {
    background-color: var(--mel-bg-secondary);
    color: var(--mel-action-primary) !important;
  }
  .sort-header:hover .sort-icon {
    color: var(--mel-action-primary) !important;
  }

  /* Table item update bounce animation */
  @keyframes tableBounceUpdate {
    0% {
      opacity: 0.3;
      transform: translateY(18px);
    }
    65% {
      opacity: 1;
      transform: translateY(-5px);
    }
    85% {
      transform: translateY(2px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-table-bounce {
    animation: tableBounceUpdate 480ms cubic-bezier(0.25, 1.15, 0.45, 1) forwards;
  }

  /* Table link cells (event title, lugar/localidad/organiza/diseño search
     links): same animated underline as the Link.astro component — a
     scaleX(0 -> 1) line from the left, instead of the browser's native
     text-decoration:underline — with a bit more breathing room from the
     text than Link.astro's own bottom-0. */
  .table-link-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .event-title-link:hover .table-link-underline,
  .search-cell-link:hover .table-link-underline {
    transform: scaleX(1);
  }

  /* Event title: show chevron on hover */
  .event-title-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
  }
  .event-title-link .title-chevron {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .event-title-link:hover .title-chevron {
    opacity: 1;
    transform: translateX(0);
  }

  /* Search link cells */
  .search-cell-link {
    cursor: pointer;
    color: var(--mel-action-secondary);
    transition: color 0.2s ease;
  }
  .search-cell-link:hover {
    color: var(--mel-action-primary);
  }
  /* "¿Nos ayudas?" (D-217): ya en action-primary en reposo, para que destaque
     como invitación en vez de leerse como un dato más entre las demás celdas. */
  .search-cell-link.cell-ayuda {
    color: var(--mel-action-primary);
  }

  /* Panel del mapa — se comporta como el ToggleSelector (D-026): a partir de
     `lg` (≥1024px, donde el toggle ocupa 4 de 12 columnas) es un panel lateral
     que empuja el mapa con ese MISMO ancho proporcional; por debajo de `lg`
     (donde el toggle "se va para abajo") se convierte en bottom sheet inferior. */

  /* Desktop (lg+): ancho = 4 columnas del grid de 12 con gap-6, idéntico al
     toggle. 11 gaps de 24px = 264px; 4 cols = (100%−264)/3, +3 gaps internos
     (72px). Así el panel se estrecha/ensancha con la pantalla en vez de un
     393px fijo que ahogaba el mapa. */
  @media (min-width: 1024px) {
    #map-side-panel.side-panel-open {
      width: max(320px, calc((100% - 264px) / 3 + 72px));
      border-left-width: 1px;
      box-shadow: -8px 0 24px -4px rgba(0, 0, 0, 0.12), -2px 0 6px -1px rgba(0, 0, 0, 0.06);
    }
    /* Ocultar el primer divisor vertical solo en el panel lateral de escritorio */
    #side-panel-tags-container .highlight-unit:first-child > .bg-mel-border {
      display: none !important;
    }
    /* Título del panel un escalón más pequeño, SOLO en escritorio (D-221):
       en móvil (bottom sheet) se queda en typo-h2 tal cual. Valores de
       typo-h3 a mano en vez de la clase —cambiar la clase entera también
       habría afectado a móvil, que typo-h2 sí escala en `md` pero typo-h3
       no escala en absoluto (decisión aparte, ver el comentario de
       typo-h3 en global.css): no son la misma cosa por debajo de `lg`. */
    #side-panel-title {
      font-size: 22px;
      line-height: 28px;
      letter-spacing: -0.02em;
    }
  }

  /* Bajo lg: bottom sheet. Su borde superior llega justo por debajo del slider
     de tiempo (--mel-sheet-top, medido en JS), dejando el slider a la vista
     bajo el DIM. Nada redondeado: el único recurso del borde superior es el
     corte de la esquina derecha (clip-path), sin más. Emular el pliegue de
     papel del diseño se intentó de tres formas distintas y ninguna convenció;
     queda pendiente hacerlo con una imagen de cabecera para claro y oscuro
     (ver roadmap.md). Animación 0.5s de entrada/salida. */
  @media (max-width: 1023px) {
    #map-side-panel {
      position: fixed;
      inset: var(--mel-sheet-top, 40px) 0 0 0;
      view-transition-name: mel-side-panel;
      /* El apilamiento va en la clase (`max-lg:z-[100]`) y no aquí: una regla
         de id en este bloque no le ganaba a la utilidad `z-20`. Mientras el
         sheet se paraba justo por encima del slider no se pisaban; al subirlo a
         40px pasa por delante de los recuentos y del selector de vista, y sin
         eso se pintaban ENCIMA del panel durante toda la animación de apertura
         (visible en el vídeo: el selector sobre el nombre del local). */
      width: 100% !important;
      height: auto !important;
      border-left-width: 0 !important;
      border-top: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      clip-path: polygon(0 0, calc(100% - 40px) 0, 100% 40px, 100% 100%, 0 100%);
      transform: translate3d(0, 100%, 0);
      transition: transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
    }
    #map-side-panel.side-panel-open {
      transform: translate3d(0, 0, 0);
    }
    #map-side-panel.side-panel-dragging {
      transition: none;
    }
    #map-side-panel-backdrop.side-panel-open {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<!-- Client Side Scripting for complete interactivity -->
<script define:vars={{ initialArchives, rangoAnios }}>
  // -------------------------------------------------------
  // Persistent state: survives View Transition re-execution
  // -------------------------------------------------------
  // Una RECARGA de verdad sin vuelta pendiente arranca en cronológico (D-259,
  // decisión del propietario: "si ayuda, el barajado activo se va al cuerno al
  // recargar; la vuelta de una ficha es lo básico"). Antes, barajado y orden de
  // columna sobrevivían también al F5, y ese era el único caso que quedaba en
  // el que el DOM servido (cronológico) no coincidía con la sesión: el primer
  // filtrado reconstruía las 32 tarjetas de golpe. Ahora los tres apuntes
  // (secuencia, ciclo del botón y columna de Lista) se borran juntos y la
  // página arranca exactamente como la sirvió el servidor.
  // Guardas: `!window._melState` = solo un cargado real de documento (en una
  // navegación suave el estado vive y borrar aquí desincronizaría el botón de
  // orden de la secuencia en memoria); `mel-return-state` = se viene de una
  // ficha (por el camino suave o por el duro del panel), y ahí TODO se
  // conserva, que es el contrato.
  try {
    if (!window._melState && !sessionStorage.getItem('mel-return-state')) {
      sessionStorage.removeItem('mel-session-order');
      sessionStorage.removeItem('mel-orden-galeria');
      sessionStorage.removeItem('mel-sort-state');
    }
  } catch (e) {}

  // Sort column/direction survive a hard reload (sessionStorage) — without
  // this, navigating into an event and back (a real page reload since D-072)
  // would silently drop whatever order the visitor picked in Lista, and the
  // Galería's own order (below) depends on this same value. Desde D-259 esa
  // supervivencia queda acotada a la VUELTA de una ficha: un F5 sin vuelta
  // pendiente lo limpia todo (ver el bloque de arriba).
  let __melSavedSort = null;
  try {
    const raw = sessionStorage.getItem('mel-sort-state');
    if (raw) __melSavedSort = JSON.parse(raw);
  } catch (e) {}

  if (!window._melState) {
    window._melState = {
      archives: [...initialArchives],
      filtered: [...initialArchives],
      // Del rango real de los datos, no de 2004/2019 escritos a mano: con un
      // literal, cualquier cartel fuera de esa horquilla lo pintaba el servidor
      // y lo borraba el cliente, sin un solo error. D-183.
      minYear: rangoAnios.min,
      maxYear: rangoAnios.max,
      searchQuery: "",
      activeSidePanelKey: null,
      currentPage: 1,
      currentSortCol: __melSavedSort ? __melSavedSort.col : null,
      currentSortDir: __melSavedSort ? __melSavedSort.dir : 'asc',
      ABSOLUTE_MIN_YEAR: rangoAnios.min,
      ABSOLUTE_MAX_YEAR: rangoAnios.max,
      googleMap: null,
      mapMarkers: [],
      // locKey -> { marker, group, inClusterer } — lets updateMapMarkers() update
      // an existing pin's count/active state in place instead of destroying and
      // recreating every marker on each filter change (which flashed them all).
      locationMarkers: new Map(),
      mapInitialized: false,
      mapContainerEl: null,
      mapCore: null,
      markerLib: null,
      googleMapClusterer: null,
    };
  }
  const _s = window._melState;

  // Secuencia única de la sesión (contrato de navegación, docs/architecture.md).
  // OJO: el servidor NO baraja desde D-131 — sirve SIEMPRE cronológico
  // ascendente, y este comentario decía lo contrario durante meses (era de la
  // era pre-D-131; cazado en D-258). Lo que esta siembra protege hoy: el orden
  // que el VISITANTE haya puesto (barajado o columna, `aplicarOrden` persiste
  // aquí mismo) sobrevive a la vuelta de una ficha, aunque el servidor vuelva a
  // servir cronológico. A un F5 sin vuelta pendiente ya NO sobrevive (D-259):
  // el bloque de limpieza de arriba borra los apuntes y se resiembra del orden
  // servido, así que toda carga real es un espejo exacto del DOM del servidor —
  // de ello depende que el primer filtrado reutilice los nodos SSR en vez de
  // reconstruirlos.
  //
  // Tiene que ir aquí y no dentro de initHomePage(): _melState nace ya con
  // `archives` poblado desde el SSR, así que cualquier guard del tipo
  // "si está vacío" no llega a dispararse nunca en una carga real.
  (function seedSessionOrder() {
    try {
      const saved = JSON.parse(sessionStorage.getItem('mel-session-order') || 'null');
      if (Array.isArray(saved) && saved.length) {
        const byId = new Map(_s.archives.map(x => [x.idMel, x]));
        const restored = saved.map(id => byId.get(id)).filter(Boolean);
        // Solo se acepta si cubre el archivo entero: si la hoja ha cambiado
        // (eventos añadidos o borrados) se descarta y se resiembra, en vez de
        // dejar fuera de la secuencia los que falten.
        if (restored.length === _s.archives.length) {
          _s.archives = restored;
          return;
        }
      }
    } catch (e) {}
    try {
      sessionStorage.setItem('mel-session-order', JSON.stringify(_s.archives.map(x => x.idMel)));
    } catch (e) {}
  })();

  // Aliases (writable via _s.xxx = ...)
  let archives             = _s.archives;
  let filtered             = _s.filtered;
  let minYear              = _s.minYear;
  let maxYear              = _s.maxYear;
  let searchQuery          = _s.searchQuery;
  let activeSidePanelKey   = _s.activeSidePanelKey;
  let currentPage          = _s.currentPage;
  const PAGE_SIZE          = 32;
  let currentSortCol       = _s.currentSortCol;
  let currentSortDir       = _s.currentSortDir;
  let ABSOLUTE_MIN_YEAR    = _s.ABSOLUTE_MIN_YEAR;
  let ABSOLUTE_MAX_YEAR    = _s.ABSOLUTE_MAX_YEAR;

  // Helper to keep _melState in sync when we mutate these aliases
  function syncState() {
    _s.archives = archives; _s.filtered = filtered;
    _s.minYear = minYear; _s.maxYear = maxYear;
    _s.searchQuery = searchQuery; _s.activeSidePanelKey = activeSidePanelKey;
    _s.currentPage = currentPage; _s.currentSortCol = currentSortCol;
    _s.currentSortDir = currentSortDir;
    _s.ABSOLUTE_MIN_YEAR = ABSOLUTE_MIN_YEAR; _s.ABSOLUTE_MAX_YEAR = ABSOLUTE_MAX_YEAR;
  }

  // DOM Element refs — re-assigned in initHomePage()
  let sliderMin, sliderMax, minHandle, maxHandle, minVal, maxVal, activeFill;
  let btnPrevPage, btnNextPage, paginationNumbers;

  // Set false at the top of initHomePage() and flipped true once the initial
  // load's synchronous cascade of filterArchives() calls (slider init, the
  // search box's own startup dispatch, etc.) has settled — gallery cards
  // only get the first-load stagger-in animation while this is false, so a
  // later render triggered by that same cascade doesn't lose it, but a real
  // user-driven filter/sort/search afterwards doesn't replay it either.
  let gallerySettled = true;
  let isFirstDOMUpdate = true;

  // Calculate year of event
  // Fecha "d/m/aaaa" (o "aaaa-m-d") a milisegundos, para ordenar. Los eventos
  // sin fecha van a 0, así que quedan al principio de una orden ascendente.
  function fechaAMs(dateStr) {
    if (!dateStr || dateStr === 'SIN FECHA') return 0;
    const barras = String(dateStr).split('/');
    if (barras.length === 3) return new Date(+barras[2], +barras[1] - 1, +barras[0]).getTime() || 0;
    const guiones = String(dateStr).split('-');
    if (guiones.length === 3) return new Date(+guiones[0], +guiones[1] - 1, +guiones[2]).getTime() || 0;
    return 0;
  }

  function getYear(dateStr) {
    if (dateStr === null || dateStr === undefined) return null;
    const str = String(dateStr).trim();
    if (!str || str === 'SIN FECHA') return null;

    // Check if it's already a 4-digit number (like "2008" or 2008)
    const numericYear = parseInt(str, 10);
    if (!isNaN(numericYear) && str.length === 4) return numericYear;

    const slashBits = str.split('/');
    if (slashBits.length === 3) {
      const yr = parseInt(slashBits[2], 10);
      if (!isNaN(yr)) return yr;
    }
    const dashBits = str.split('-');
    if (dashBits.length === 3) {
      const yr = parseInt(dashBits[0], 10);
      if (!isNaN(yr)) return yr;
    }
    const match = str.match(/\b(19\d\d|20\d\d)\b/);
    if (match) {
      return parseInt(match[1], 10);
    }
    return null;
  }

  // Hotlink extractor using the new thumbnail endpoint
  // `ancho` = el ancho que Drive debe servir, en píxeles. Pedir siempre w1000
  // costaba ~679 KB de media por flyer (el peor del archivo, 2 MB) para pintarlo
  // en una tarjeta de 342px o, peor, en una miniatura de lista de 40px. Cada
  // llamada pide ahora el tamaño que de verdad va a usar; 1000 sigue siendo el
  // valor por defecto porque es el que necesita la ficha del evento.
  const ANCHO_TARJETA = 700;
  const ANCHOS_TARJETA = [700, 1000];   // gemelo del de arriba
  const ANCHO_MINIATURA = 200;
  // Gemelo de `srcSetDrive` en mel.ts (regla 7: este script lleva `define:vars`,
  // así que es inline y no puede importar nada). Si se toca allí, aquí también.
  const TAMANOS_TARJETA = '(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw';
  const srcSetDrive = (url, anchos = ANCHOS_TARJETA) =>
    anchos.map((a) => `${extractDriveImage(url, a)} ${a}w`).filter((par) => !par.startsWith(' ')).join(', ');

  // Endpoint directo lh3 (D-258), no el redirect de drive.google.com/thumbnail:
  // el salto era un 302 no-store que se repagaba en cada carga; el directo se
  // cachea 24h en el navegador. La explicación completa, en la fuente de verdad
  // (extractDriveImage en mel.ts) — si se toca allí, aquí también.
  function extractDriveImage(url, ancho = 1000) {
    if (!url) return '';
    let fileId = '';
    if (url.includes('id=')) {
      fileId = url.split('id=')[1].split('&')[0];
    } else if (url.includes('/d/')) {
      fileId = url.split('/d/')[1].split('/')[0];
    }
    return fileId ? `https://lh3.googleusercontent.com/d/${fileId}=w${ancho}` : '';
  }

  // Escapa HTML para insertarlo de forma segura en innerHTML — usado por
  // todas las réplicas JS de componentes (filas de tabla, Event Card List...).
  // Regla del sitio: un campo sin dato SIEMPRE se pinta en text-tertiary y NUNCA
  // es enlace. La hoja marca la ausencia con varios centinelas distintos, no
  // solo "desconocido" — sin contemplarlos todos, un "Varios" o un "No
  // detallados" acababa siendo un enlace que buscaba esa palabra literal.
  // `varios` y `no detallados` se muestran tal cual porque dicen algo; el resto
  // se unifica bajo "desconocido".
  const CENTINELAS_SIN_DATO = ['desconocido', 'sin fecha', 'no detallados', 'varios'];

  // Mismo enlace de colaboración que la ficha de evento (event/[id].astro,
  // AYUDA_TEXTO/AYUDA_HREF) para cuando una celda de la tabla no tiene dato:
  // antes se pintaba inerte ("Desconocido" en gris), ahora invita a rellenarlo,
  // igual que ya hacía la ficha (D-217).
  const AYUDA_TEXTO = '¿Nos ayudas?';
  const AYUDA_HREF = '/info#contacto';

  function celdaSinDato(valor) {
    const limpio = valor ? String(valor).trim() : '';
    const bajo = limpio.toLowerCase();
    if (!limpio || bajo === 'desconocido' || bajo === 'sin fecha') return 'desconocido';
    if (CENTINELAS_SIN_DATO.includes(bajo)) return limpio;
    return null;   // hay dato de verdad
  }

  // La medición del marquee ya NO vive aquí (D-233): es una sola función
  // compartida, `window.melMedirMarquee(ámbito)`, definida en Layout.astro —
  // el único sitio de este proyecto donde un script NO es en línea y por
  // tanto puede compartirse entre páginas. Antes estaba copiada a mano aquí
  // y en event/[id].astro. El guard es por si se llama antes de que el
  // script compartido haya corrido.
  function medirMarquee(ambito) {
    if (window.melMedirMarquee) window.melMedirMarquee(ambito || document);
  }

  // Los promotores pueden venir varios separados por comas (D-218), igual
  // que los artistas — cada uno con su propio enlace de búsqueda, no uno
  // solo para la cadena completa (que no encontraba nada porque esa cadena
  // literal no coincide con ningún evento). Sin el subrayado compartido de
  // celda que llevan las demás columnas (asumía un solo enlace por celda);
  // el color al pasar el ratón sí lo hereda cada nombre vía .search-cell-link.
  function celdaPromotores(valor) {
    const sd = celdaSinDato(valor);
    if (sd) return `<a href="${AYUDA_HREF}" class="marquee-inner search-cell-link cell-ayuda">${AYUDA_TEXTO}<span class="table-link-underline"></span></a>`;
    const nombres = String(valor).split(/,+/).map(n => n.trim()).filter(Boolean);
    const partes = nombres.map(nombre => {
      const esCentinela = CENTINELAS_SIN_DATO.includes(nombre.toLowerCase());
      return esCentinela
        ? escHtml(nombre)
        : `<span class="search-cell-link" data-search="${escHtml(nombre)}">${escHtml(nombre)}</span>`;
    });
    return `<span class="marquee-inner">${partes.join(', ')}</span>`;
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // DD/MM/AAAA a partir del AAAA-MM-DD tal cual llega de la hoja (columna Fecha).
  function formatFechaDMY(fecha) {
    let formatted = fecha || '';
    if (formatted && formatted.includes('-')) {
      const parts = formatted.split('-');
      if (parts.length === 3) formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
    }
    // Antepone un cero al día de una sola cifra (D-216) — réplica de
    // formatFechaDMY() en mel.ts, ver ese comentario para el motivo.
    const piezas = formatted.split('/');
    if (piezas.length === 3 && piezas[0].length === 1) {
      piezas[0] = '0' + piezas[0];
      formatted = piezas.join('/');
    }
    return formatted;
  }

  // Fila compacta de evento (Figma "Event Card List", node 291:13479 / Bottom
  // Sheet Mobile Place Events List 439:142691): miniatura 56x56 en fit
  // (object-contain) sobre fondo secundario, título, fecha y chevron.
  // Compartida por el panel lateral del mapa y la lista en móvil.
  //
  // Devuelve el elemento COMPLETO, contenedor incluido, y ahí está el motivo de
  // que exista. Antes devolvía solo el contenido y cada uno de los dos sitios
  // que la usan escribía por su cuenta las doce utilidades del contenedor; había
  // además un EventCardList.astro que no se importaba en ningún sitio y se
  // anunciaba como "la referencia" del marcado — tres copias, y la referencia ya
  // había divergido (su divisor seguía en 24px fijos cuando el que se ve lleva
  // los insets responsive de abajo). Aquí hay UN sitio.
  function buildEventCardList(evt, { showDivider = true, extraClass = '' } = {}) {
    const imgSrc = extractDriveImage(evt.carruselItems?.[0]?.urlDrive, ANCHO_TARJETA) || `/flyers/flyer-1.png`;
    const row = document.createElement('div');
    row.className = `group content-stretch cursor-pointer flex gap-[16px] items-center px-6 sm:px-12 lg:px-6 py-[16px] relative w-full hover:bg-mel-bg-secondary active:bg-mel-bg-tertiary transition-colors duration-200 ${extraClass}`.trim();
    row.innerHTML = `
      <div class="bg-mel-bg-secondary overflow-clip relative shrink-0 size-[56px]">
        <img src="${imgSrc}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 max-w-none object-contain pointer-events-none size-full" />
      </div>
      <div class="flex flex-col flex-1 min-w-0 gap-[4px] items-start">
        <p class="typo-lead text-mel-text-primary truncate w-full">${escHtml(evt.evento)}</p>
        <p class="typo-body-roman text-mel-text-secondary">${escHtml(formatFechaDMY(evt.fecha))}</p>
      </div>
      <div class="shrink-0 size-[24px] flex items-center justify-center text-mel-action-secondary group-hover:text-mel-action-primary group-active:text-mel-action-primary transition-colors duration-200">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      ${showDivider ? '<div class="absolute bottom-[0.5px] h-0 left-6 right-6 sm:left-12 sm:right-12 lg:left-6 lg:right-6 border-b border-mel-border"></div>' : ''}
    `;
    return row;
  }

  // -------------------------------------------------------
  // Galería masonry 2.1 (ver decisions.md D-015): grid + row-span medido,
  // orden aleatorio estable y scroll infinito.
  // -------------------------------------------------------
  const GALLERY_ROW = 4;   // grid-auto-rows del contenedor, en px
  // Hueco entre tarjetas, horizontal y vertical. TIENE QUE VALER LO MISMO que el
  // `gap-x-mel-m` de la rejilla: si dejan de coincidir, los row-span salen mal y
  // el masonry se descuadra. Dos números que deben ser el mismo, escritos por
  // separado — la trampa nº 2 del traspaso. Al cambiar la escala del DS
  // (M pasó a ser 24, antes lo era L) se movió la clase, no el número.
  const GALLERY_GAP = 24;

  let galleryVisibleCount = PAGE_SIZE;
  let galleryOrderedCache = [];
  let sentinelObserver = null;
  let mapResizeObserver = null;

  // Proporción real de cada cartel, por idMel, medida una sola vez en toda la
  // sesión.
  //
  // El ratio vivía SOLO en `card.dataset.ratio`, así que cada reconstrucción de
  // la galería (cualquier filtro, búsqueda o reordenado) tiraba la medida con la
  // tarjeta y volvía a esperar al `onload` de la imagen. Mientras tanto las 32
  // tarjetas eran placeholders `.unsized` del mismo alto: por eso al reordenar se
  // veían cajas blancas altas y la cuadrícula daba un salto un segundo después,
  // cuando las imágenes iban llegando y cada una reclamaba su altura.
  //
  // Para el botón de ordenación esto es lo que decide si hay animación o no: el
  // navegador fotografía el estado nuevo al salir del callback, y si en ese
  // instante ninguna tarjeta está medida, fotografía la cuadrícula equivocada.
  //
  // En _melState y no en una const del script (D-259): el script se reevalúa en
  // cada navegación suave, así que un Map local moría justo al volver de una
  // ficha — que es exactamente cuando más falta hacía. Con esto, y con los
  // ratios que ya vienen del servidor (item.ratio, de flyer_tecnico.json), la
  // rejilla de la vuelta nace medida entera: nada baila de columna ni empuja el
  // scroll restaurado mientras llegan las imágenes.
  _s.ratiosMedidos = _s.ratiosMedidos || new Map();
  const ratiosMedidos = _s.ratiosMedidos;

  // Da altura a las tarjetas cuya proporción ya conocemos, en una sola pasada.
  // Lee el ancho de columna una vez y no una por tarjeta: todas miden lo mismo.
  function dimensionarConocidas(grid) {
    if (!grid) return;
    const pendientes = Array.from(grid.children).filter(
      (c) => c.dataset && c.dataset.ratio && c.classList.contains('unsized')
    );
    if (pendientes.length === 0) return;
    const ancho = pendientes[0].clientWidth;
    pendientes.forEach((c) => sizeGalleryCard(c, ancho));
  }

  // Fija el row-span de una tarjeta a partir del ratio de su imagen y el
  // ancho de columna actual. `width` es opcional (una pasada de resize lo
  // lee una sola vez: todas las columnas miden lo mismo).
  function sizeGalleryCard(card, width) {
    const ratio = parseFloat(card.dataset.ratio);
    const w = width || card.clientWidth;
    if (!ratio || !w) return;
    card.style.gridRowEnd = 'span ' + Math.max(1, Math.round((w / ratio + GALLERY_GAP) / GALLERY_ROW));
    card.classList.remove('unsized');
  }

  // Llamado por el onload inline de cada <img> (y por la repesca de imágenes
  // ya completas tras cada render): publica el ratio real en la tarjeta.
  function measureFlyerImg(img) {
    const card = img.closest('.gallery-item');
    if (!card || !img.naturalWidth || !img.naturalHeight) return;
    const ratio = img.naturalWidth / img.naturalHeight;
    card.dataset.ratio = String(ratio);
    if (card.dataset.id) ratiosMedidos.set(card.dataset.id, ratio);
    sizeGalleryCard(card);
  }
  window.__melMeasureFlyer = measureFlyerImg;

  // Única fábrica de tarjetas de galería en cliente (render completo Y lotes del
  // scroll infinito).
  //
  // ESPEJO de FlyerCard.astro (regla 7). Las dos copias existen a la fuerza y el
  // por qué está escrito en la cabecera de ese componente: este script lleva
  // `define:vars`, o sea que es inline, y un script inline no admite `import`.
  // Si tocas el marcado de una, toca la otra — y compáralas, que ya se
  // separaron una vez.
  //
  // Durante un reordenado las tarjetas se nombran por HUECO y no por contenido.
  //
  // Normalmente cada tarjeta se llama `flyer-img-{id}`, que es lo que permite el
  // morphing a la ficha del evento. Pero al reordenar el archivo entero, las 32
  // tarjetas que se van y las 32 que llegan no comparten NI UNA (84 eventos, 32
  // por página: ascendente enseña la 1–32 y descendente la 84–53, intersección
  // vacía). Sin pareja no hay nada que mover y el navegador solo puede fundir.
  //
  // Llamándolas por el hueco que ocupan, todas emparejan: el navegador mueve la
  // caja de su sitio viejo al nuevo Y funde dentro el contenido viejo con el
  // nuevo. Se ven las hojas blancas desplazarse mientras las imágenes se
  // disuelven unas en otras. El movimiento es real (el masonry recoloca los
  // huecos porque cada cartel mide distinto); lo que es prestado es la identidad.
  // Sale más barato que ahora, además: 32 grupos emparejados en vez de 32 que se
  // van más 32 que llegan.
  //
  // Se revierte al acabar la transición, si no el morphing a la ficha se rompe.
  function nombrarHuecos(porHueco) {
    const grid = document.getElementById('gallery-grid');
    if (grid) {
      Array.from(grid.children).forEach((card, i) => {
        if (!card.dataset || !card.dataset.id) return;
        card.style.viewTransitionName = porHueco ? `mel-hueco-${i}` : `flyer-img-${card.dataset.id}`;
      });
    }

    // El bloque de cabecera entero pasa a ser UNA pieza opaca por encima de las
    // tarjetas mientras dura el reordenado, y sus dos nombres interiores se
    // apagan: si siguieran puestos, cabecera y toolbar se capturarían aparte y
    // dejarían su silueta recortada en el bloque, que es justo el agujero por el
    // que se colaban las tarjetas. Arriba no se mueve nada durante un reordenado,
    // así que no necesitan grupo propio.
    // Al deshacer se restaura su nombre FIJO (D-259), no vacío: el bloque
    // participa siempre en las transiciones entre páginas como pieza opaca.
    const bloque = document.getElementById('bloque-cabecera');
    if (bloque) bloque.style.viewTransitionName = porHueco ? 'mel-bloque-fijo' : 'mel-bloque-cabecera';
    // Por id y no por el `style`: al apagarlos el atributo deja de contener el
    // nombre, así que un selector como `[style*="mel-header"]` encontraría los
    // elementos a la ida y no a la vuelta, y se quedarían apagados para siempre.
    [['home-header', 'mel-header'], ['home-toolbar', 'mel-toolbar']].forEach(([id, nombre]) => {
      const el = document.getElementById(id);
      if (el) el.style.viewTransitionName = porHueco ? 'none' : nombre;
    });
  }

  function buildGalleryCard(item, i) {
    const card = document.createElement('div');
    const imgSrc = extractDriveImage(item.carruselItems[0]?.urlDrive, ANCHO_TARJETA) || `/flyers/flyer-${((i % 13) + 1)}.png`;
    const conjunto = srcSetDrive(item.carruselItems[0]?.urlDrive);
    const srcsetAttr = conjunto ? ` srcset="${conjunto}" sizes="${TAMANOS_TARJETA}"` : '';
    // Copiada LITERAL de FlyerCard.astro, en el mismo orden, para que un `diff`
    // entre las dos cante en cuanto se separen. Ya lo hicieron: aquí estaba la
    // sombra del DS y allí no, así que la galería cambiaba de aspecto en cuanto
    // tocabas un filtro.
    card.className = 'gallery-item unsized relative overflow-hidden shadow-[var(--mel-shadow-sm)] bg-white cursor-pointer transition-all duration-300 group hover:z-30';
    card.dataset.id = item.idMel;
    // Si la proporción de este cartel se conoce, la tarjeta nace sabiendo su
    // altura en vez de como placeholder. dimensionarConocidas() se la aplica en
    // cuanto está en el DOM (aquí clientWidth aún es 0). Dos fuentes, por este
    // orden: lo medido en esta sesión y lo que el servidor ya sabía de
    // flyer_tecnico.json (item.ratio, D-259) — espejo del data-ratio SSR de
    // FlyerCard.astro.
    const ratioConocido = ratiosMedidos.get(item.idMel) || item.ratio;
    if (ratioConocido) card.dataset.ratio = String(ratioConocido);
    // El nombre de transición va en LA TARJETA, igual que en FlyerCard.astro
    // (regla 7: las dos tienen que decir lo mismo). Estando en la `<img>` volaba
    // solo la foto y la caja blanca se quedaba quieta detrás.
    card.style.viewTransitionName = `flyer-img-${item.idMel}`;
    card.innerHTML = `
      <!-- Image with referrerpolicy no-referrer to allow anonymous loading of Google Drive links in browsers -->
      <img src="${imgSrc}"${srcsetAttr} alt="${escHtml(item.evento)}" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-auto block pointer-events-none" onload="window.__melMeasureFlyer && window.__melMeasureFlyer(this)" onerror="this.onerror=null; this.src='/flyers/flyer-1.png'; window.__melMeasureFlyer && window.__melMeasureFlyer(this);" />

      <!-- RETIRADO (D-234): capa de rayas diagonales en hover. Ver el porqué
           en su gemela FlyerCard.astro (regla 7). -->

      <!-- Overlay info on hover (Figma "Event Info" 481:238727 — mirrors FlyerCard.astro, ver AGENTS.md regla 7) -->
      <div class="flyer-label absolute bottom-0 left-0 right-0 h-[32px] bg-mel-action-secondary backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 flex items-center justify-between gap-2 px-4 z-20 shadow-[var(--mel-shadow-flyer-label)]">
        <p class="typo-caption text-mel-text-on-action truncate min-w-0">${escHtml(item.evento)}</p>
        ${item.fecha ? `<p class="typo-caption text-mel-text-on-action shrink-0">${escHtml(formatFechaDMY(item.fecha))}</p>` : ''}
      </div>
    `;
    // `pointerenter` no existe en un móvil: no hay puntero que entre en nada,
    // se toca y ya. La precarga solo llegaba a escritorio, y por eso allí la
    // ficha aparecía al instante y en el teléfono se notaba la espera.
    // `touchstart` ocurre al posar el dedo, unos cientos de milisegundos
    // antes de que se suelte: justo el margen que hace falta para adelantarla.
    ['pointerenter', 'touchstart'].forEach((evento) => card.addEventListener(evento, () => {
      prefetchEventUrl(item.idMel, { search: searchQuery });
    }, { once: true, passive: true }));
    card.addEventListener('click', () => {
      abrirFicha(item);
    });
    return card;
  }

  // Guardería de tarjetas retiradas por el filtro (D-251, idea del
  // propietario). Una tarjeta que sale del rango no se destruye: se guarda
  // desmontada con su <img> ya cargada, y si su año vuelve al rango se
  // revive tal cual — sin volver a pedir ni descodificar nada. Es lo que
  // hace que arrastrar el slider adelante y atrás no reestrene tarjetas en
  // blanco. Tope holgado por si el archivo crece; hoy caben todas.
  const guarderiaTarjetas = new Map();
  const GUARDERIA_MAX = 150;

  // Duración y curva ÚNICAS para los vuelos de reordenación (galería Y
  // lista, D-252 — petición del propietario: misma respiración en las dos
  // vistas). La curva anterior (0.16, 1, …) disparaba las tarjetas de
  // salida y solo suavizaba el aterrizaje; esta arranca y posa suave.
  // El throttle del arrastre se calcula a partir de FLIP_DUR: ningún
  // filtrado nuevo hasta que el vuelo en curso ha terminado.
  const FLIP_DUR = 350;   // 450 en el primer intento; el propietario lo bajó
  const FLIP_EASE = 'cubic-bezier(0.3, 0, 0.25, 1)';

  // FLIP del reorden de la galería durante el ARRASTRE del slider (D-251,
  // regla 2: animación contenida = transforms). Sustituye a la view
  // transition en ese camino: mueve los nodos reales — las imágenes siguen
  // vivas, nada se fotografía — así que las supervivientes DESLIZAN a su
  // sitio nuevo (al quitar años por la izquierda con orden cronológico, se
  // ve subir a las que quedan, que es la lectura natural que pedía el
  // propietario) y las que entran hacen un fundido corto.
  //
  // Con la Web Animations API, NO con transiciones CSS, y no es capricho:
  // `.gallery-item` lleva su transición de hover con `!important` (más
  // abajo, en el CSS), así que el juego clásico del FLIP — `transition:
  // none` para colocar la inversión y reactivarla para el vuelo — pierde
  // siempre contra esa regla y las tarjetas saltan en seco (comprobado en
  // el navegador con el patrón aislado). `el.animate()` va por fuera de la
  // cascada: ni lee ni escribe `style.transition`, gana a la transición en
  // el orden de composición, y al terminar se limpia sola (sin `fill`).
  //
  // Aguanta cruces ENCADENADOS: los rects viejos se capturan ANTES de
  // reconciliar (posición visual, con el vuelo anterior incluido porque la
  // animación afecta al rect), aquí se CANCELAN los vuelos pendientes para
  // medir el destino sobre layout limpio, y cada tarjeta viaja del delta a
  // cero — un cruce que las pilla a medio vuelo las redirige desde donde
  // estén.
  let vuelosGaleria = [];
  function reproducirFlipGaleria(grid, rectsViejos, entrantes, dur = FLIP_DUR, ease = FLIP_EASE) {
    vuelosGaleria.forEach(a => { try { a.cancel(); } catch (e) {} });
    vuelosGaleria = [];

    // Misma referencia que la captura: relativa a la rejilla (ver D-252 en
    // el punto de captura — el scroll no debe colarse en los deltas).
    const baseNueva = grid.getBoundingClientRect();
    Array.from(grid.children).forEach(el => {
      const viejo = el.dataset && el.dataset.id && rectsViejos.get(el.dataset.id);
      if (!viejo) return;
      const nuevo = el.getBoundingClientRect();
      const dx = viejo.left - (nuevo.left - baseNueva.left);
      const dy = viejo.top - (nuevo.top - baseNueva.top);
      if (Math.abs(dx) > 1 || Math.abs(dy) > 1) {
        vuelosGaleria.push(el.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
          { duration: dur, easing: ease }
        ));
      }
    });

    // Entradas al ritmo de la pasada (D-256): con el compás del arrastre son
    // los ~260ms de siempre, pero en el sort (vuelos de hasta 1500ms) crecen
    // hasta 500 — si no, media rejilla aparecía "de golpe" al lado de vuelos
    // lentos y el barajado se leía como un corte. Por WAAPI y no con la
    // clase CSS de antes: mismas razones de siempre (ámbito) y así entran en
    // vuelosGaleria y un cruce encadenado las redirige en vez de pisarlas.
    const durEntrada = Math.max(260, Math.min(500, Math.round(dur / 3)));
    (entrantes || []).forEach(el => {
      if (el.dataset && rectsViejos.has(el.dataset.id)) return;
      vuelosGaleria.push(el.animate(
        [{ opacity: 0, transform: 'scale(0.9)' }, { opacity: 1, transform: 'scale(1)' }],
        { duration: durEntrada, easing: 'ease-out' }
      ));
    });
  }

  // Despedida y llegada de filas de la Lista (D-255) — UN solo efecto para
  // móvil y escritorio, el que el propietario señaló como referencia: fundido
  // + encogimiento a la vez, y las vecinas se deslizan solas por el reflujo
  // del colapso, sin FLIP aparte. Un `<tr>` no colapsa como un div (ni admite
  // overflow ni altura animable con celdas de alto fijo), así que en la tabla
  // se pliegan sus CELDAS: paddings, altura de línea y el bloque interior.
  // WAAPI y no clases CSS por lo de siempre (D-253): la mitad de este marcado
  // lo fabrica el JS y las reglas con ámbito no lo visten.
  function plegarYRetirar(fila) {
    fila.style.pointerEvents = 'none';
    const animaciones = [];
    if (fila.tagName === 'TR') {
      fila.querySelectorAll('td').forEach(td => {
        td.style.overflow = 'hidden';
        const cs = getComputedStyle(td);
        animaciones.push(td.animate(
          [{ paddingTop: cs.paddingTop, paddingBottom: cs.paddingBottom, lineHeight: cs.lineHeight },
           { paddingTop: '0px', paddingBottom: '0px', lineHeight: '0px' }],
          { duration: 260, easing: 'ease-out' }
        ));
        const bloque = td.firstElementChild;
        if (bloque && bloque.offsetHeight) {
          bloque.style.overflow = 'hidden';
          animaciones.push(bloque.animate(
            [{ height: bloque.offsetHeight + 'px' }, { height: '0px' }],
            { duration: 260, easing: 'ease-out' }
          ));
        }
      });
    } else {
      fila.style.overflow = 'hidden';
      animaciones.push(fila.animate(
        [{ height: fila.offsetHeight + 'px' }, { height: '0px' }],
        { duration: 260, easing: 'ease-out' }
      ));
    }
    animaciones.push(fila.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 260, easing: 'ease-out' }));
    Promise.allSettled(animaciones.map(a => a.finished)).then(() => fila.remove());
  }

  function desplegarFila(fila) {
    if (fila.tagName === 'TR') {
      fila.querySelectorAll('td').forEach(td => {
        td.style.overflow = 'hidden';
        const cs = getComputedStyle(td);
        td.animate(
          [{ paddingTop: '0px', paddingBottom: '0px', lineHeight: '0px' },
           { paddingTop: cs.paddingTop, paddingBottom: cs.paddingBottom, lineHeight: cs.lineHeight }],
          { duration: 260, easing: 'ease-out' }
        );
        const bloque = td.firstElementChild;
        if (bloque && bloque.offsetHeight) {
          bloque.animate([{ height: '0px' }, { height: bloque.offsetHeight + 'px' }], { duration: 260, easing: 'ease-out' });
        }
      });
    } else {
      fila.animate([{ height: '0px' }, { height: fila.offsetHeight + 'px' }], { duration: 260, easing: 'ease-out' });
    }
    fila.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 260, easing: 'ease-out' });
  }

  // Scroll infinito: el centinela (#gallery-sentinel, hermano de la rejilla)
  // entra en el margen de precarga y se añade el siguiente lote SIN tocar lo
  // ya colocado. Búsquedas y filtros no interfieren: resetean
  // galleryVisibleCount y pasan por el rebuild completo de performDOMUpdates.
  function appendGalleryBatch() {
    const gridContainer = document.getElementById('gallery-grid');
    const galleryViewEl = document.getElementById('view-galería');
    if (!gridContainer || !galleryViewEl || galleryViewEl.classList.contains('hidden')) return;
    // De dónde sigue el lote lo dice el DOM, no el contador. Son dos formas de
    // anotar el mismo hecho —cuántas tarjetas hay pintadas— y se escriben en
    // horarios distintos: el contador, de forma síncrona y desde cuatro sitios
    // (initHomePage, updateSlider, el buscador y applyReturnState); el DOM, de
    // forma asíncrona, dentro de performDOMUpdates, que filterArchives() le
    // entrega a document.startViewTransition(). Al volver de una ficha esas dos
    // agendas se cruzan y el contador se queda en 32 con 50 tarjetas ya
    // pintadas: el lote pedía el tramo 32–50, que estaba en pantalla, y lo
    // añadía otra vez (18 tarjetas duplicadas). El DOM es lo único que no puede
    // mentir sobre lo que hay pintado, así que manda él y el contador se limita
    // a seguirlo.
    const startIdx = gridContainer.children.length;
    const next = galleryOrderedCache.slice(startIdx, startIdx + PAGE_SIZE);
    if (next.length === 0) return;
    galleryVisibleCount = startIdx + next.length;
    next.forEach((item, i) => {
      const card = buildGalleryCard(item, startIdx + i);
      gridContainer.appendChild(card);
      const img = card.querySelector('img');
      if (img && img.complete) measureFlyerImg(img);
    });
    // Los carteles ya vistos antes (se bajó, se filtró y se volvió a bajar) no
    // vuelven a pasar por el placeholder.
    dimensionarConocidas(gridContainer);
  }

  // Determine dynamic bounds
  function calculateDynamicBounds() {
    let min = Infinity;
    let max = -Infinity;
    archives.forEach(item => {
      const yr = getYear(item.fecha);
      if (yr !== null) {
        if (yr < min) min = yr;
        if (yr > max) max = yr;
      }
    });
    if (min === Infinity) min = rangoAnios.min;
    if (max === -Infinity) max = rangoAnios.max;
    ABSOLUTE_MIN_YEAR = min;
    ABSOLUTE_MAX_YEAR = max;

    if (sliderMin) {
      sliderMin.setAttribute('min', String(min));
      sliderMin.setAttribute('max', String(max));
    }
    if (sliderMax) {
      sliderMax.setAttribute('min', String(min));
      sliderMax.setAttribute('max', String(max));
    }
  }

  // Double Range Slider logic
  // Dragging the slider handle fires 'input' dozens of times a second — each
  // call used to run its own document.startViewTransition(), and starting a
  // new one while a previous one is still pending supersedes it, which was
  // exactly why the gallery's FLIP reorder never got to actually play during
  // a drag (only a single discrete click, giving each call room to settle,
  // worked). Coalescing into at most one filterArchives() per animation
  // frame keeps the values live-updating but stops that thrash.
  let sliderUpdateScheduled = false;
  // D-086 ronda 4: rAF-coalescing alone (below) only guarantees at most one
  // *scheduled* filterArchives() per frame — it says nothing about how long
  // that call itself takes once it runs. Rebuilding the gallery/list DOM is
  // real work (masonry sizing, image handling, row markup), and on a phone's
  // weaker CPU a big year-range jump can make a single call take well past
  // one frame's budget, blocking the main thread — which is also where
  // touchmove events for the slider itself get queued and delivered. That's
  // the propietario's own diagnosis: Mapa stays smooth because marker
  // updates are cheap (clusterer diffing, no full rebuild); Galería/Lista
  // jank specifically on mobile because the rebuild is heavy AND touch
  // fires far more events/sec than a mouse drag ever does, so the backlog
  // compounds. Time-throttling the expensive rebuild specifically WHILE
  // actively dragging (trailing-edge — the last call always still fires,
  // nothing gets lost) keeps the slider's own live feedback (handle
  // position, year labels — cheap, CSS/text only, driven entirely inside
  // TimeSlider.astro) responsive every frame while capping how often the
  // expensive part can compete for the same thread. A discrete interaction
  // (click-to-jump, keyboard) isn't throttled at all — this only kicks in
  // while `#slider-track-wrapper` has D-068's `.dragging` class.
  let sliderLastFilterAt = 0;
  let sliderTrailingTimer = null;
  // Al ritmo del vuelo (D-252, la "interpolación" que pidió el propietario):
  // ningún filtrado nuevo hasta que la animación FLIP en curso ha terminado.
  // En un arrastre rápido los años intermedios NO se reproducen — el disparo
  // agrupado (trailing) lee el rango vigente al saltar, así que se va
  // directo del vuelo en curso al último año pisado. Antes era 120ms y solo
  // táctil (D-086 r4/r6, cuando el problema era el hilo principal); ahora
  // marca el compás de la animación y aplica a CUALQUIER puntero.
  const SLIDER_DRAG_FILTER_THROTTLE_MS = FLIP_DUR + 30;
  // Último rango (min-max) que llegó a programar un filtrado. Con él,
  // updateSlider() ignora los `input` de un arrastre que no cruzan de año.
  // (La serialización de transiciones de D-248 vivió aquí y se retiró en
  // D-251: el arrastre ya no arranca transiciones que serializar.)
  let ultimoRangoSlider = null;
  // El `change` del soltar que descarga una pasada agrupada pendiente forma
  // parte del ARRASTRE aunque la clase `.dragging` ya no esté: debe volar
  // por FLIP, no arrancar una view transition discreta justo al soltar
  // (D-253 — el propietario veía parpadear el fondo de la toolbar y hasta
  // el slider en ese instante). Bandera de un solo uso, la consume
  // filterArchives.
  let vueloDeSoltado = false;

  function scheduleFilterArchives() {
    if (sliderUpdateScheduled) return;
    sliderUpdateScheduled = true;
    requestAnimationFrame(() => {
      sliderUpdateScheduled = false;
      filterArchives();
    });
  }

  function updateSlider() {
    if (!sliderMin || !sliderMax) return;
    let val1 = parseInt(sliderMin.value);
    let val2 = parseInt(sliderMax.value);

    // Ensure min never exceeds max — simply clamp
    if (val1 > val2) {
      val1 = val2;
      sliderMin.value = String(val1);
    }

    minYear = val1;
    maxYear = val2;

    const trackWrapper = document.getElementById('slider-track-wrapper');
    const isDragging = trackWrapper && trackWrapper.classList.contains('dragging');

    // TimeSlider dispara `input` en CADA movimiento del puntero, cambie o no
    // el año — durante un arrastre eso era refiltrar decenas de veces por
    // segundo el mismo rango. Si el rango no ha cruzado de año, no hay nada
    // que hacer. Fuera del arrastre también se descarta el duplicado, con un
    // matiz (D-251): el `change` del soltar era un refiltrado del MISMO rango
    // que el último cruce ya pintó — con view transition, o sea 32 grupos
    // fotografiados para un no-op — y el segundo disparo del clic en barra
    // (input+change seguidos), otro. Solo pasa si no hay un throttle táctil
    // pendiente: si lo hay, este disparo ES la sincronización final y tiene
    // que correr (limpia el timer más abajo). El primer disparo de la sesión
    // nunca se descarta (ultimoRangoSlider nace null).
    const rango = val1 + '-' + val2;
    if (rango === ultimoRangoSlider && (isDragging || !sliderTrailingTimer)) return;
    ultimoRangoSlider = rango;

    // El slider YA NO resetea la posición — ni arrastrando, ni al soltar, ni
    // con el clic en barra (D-252): quien está al final del scroll y toca el
    // slider se queda donde está. Si el contenido encoge, el navegador
    // recorta el scroll él solo, y el FLIP mide en coordenadas relativas a
    // la rejilla precisamente para que ese recorte no ensucie los vuelos.
    // La búsqueda conserva su vuelta arriba: tiene su propio
    // reiniciarPosicion() en su handler.

    // El throttle marca el compás del FLIP para CUALQUIER puntero (D-252;
    // la exención del ratón de D-086 r6 tenía sentido cuando esto protegía
    // al hilo principal — ahora agrupa cruces para que cada vuelo termine).
    if (!isDragging) {
      if (sliderTrailingTimer) {
        // Hay una pasada agrupada pendiente: este disparo es el remate del
        // arrastre y viaja como él, por FLIP (ver vueloDeSoltado).
        clearTimeout(sliderTrailingTimer);
        sliderTrailingTimer = null;
        vueloDeSoltado = true;
      }
      scheduleFilterArchives();
      return;
    }

    // El compás del vuelo solo aplica con la GALERÍA a la vista (D-253): en
    // la Lista las filas no marean al moverse (criterio del propietario) y
    // es mejor reproducir todos los años; allí queda el throttle corto de
    // siempre (120ms, D-086 r4), que protege el hilo principal sin agrupar.
    const vistaGaleria = document.getElementById('view-galería');
    const compas = (vistaGaleria && !vistaGaleria.classList.contains('hidden'))
      ? SLIDER_DRAG_FILTER_THROTTLE_MS : 120;

    const now = performance.now();
    const elapsed = now - sliderLastFilterAt;
    if (elapsed >= compas) {
      sliderLastFilterAt = now;
      scheduleFilterArchives();
    } else if (!sliderTrailingTimer) {
      sliderTrailingTimer = setTimeout(() => {
        sliderTrailingTimer = null;
        sliderLastFilterAt = performance.now();
        scheduleFilterArchives();
      }, compas - elapsed);
    }
  }

  // Bind Slider Events — called from initHomePage()
  function bindSliderEvents() {
    if (sliderMin) sliderMin.addEventListener('input', updateSlider);
    if (sliderMax) sliderMax.addEventListener('input', updateSlider);
    // 'change' (D-086, TimeSlider.astro dispatches it on release, after
    // removing the `dragging` class) guarantees one final, immediate,
    // un-throttled sync — the last 'input' during a drag may have been
    // deferred by the throttle above and not caught up yet.
    if (sliderMin) sliderMin.addEventListener('change', updateSlider);
    if (sliderMax) sliderMax.addEventListener('change', updateSlider);
  }

  // Guarda el contexto de navegación justo antes de salir de `/` hacia la
  // ficha de un evento, para que al cerrarla se vuelva EXACTAMENTE al mismo
  // sitio. La URL de vuelta ya lleva lo compartible (vista, búsqueda,
  // localidad); lo que no cabe en una URL — scroll, lotes cargados del scroll
  // infinito, página de Lista, cámara del mapa, rango de años — vive aquí.
  // Se guarda en sessionStorage (no en memoria) para sobrevivir también a un
  // F5 hecho dentro de la propia ficha de evento.
  // Qué flyer se abrió por última vez, para poder volver a ÉL y no a un píxel.
  function recordarFlyerAbierto(idMel) {
    _s.ultimoFlyerAbierto = idMel || null;
    // Y CUÁL de las URLs del cartel se bajó de verdad esta tarjeta, para que la
    // ficha pueda pintarla de fondo mientras llega la suya.
    //
    // La ficha no reaprovecha nada de lo que la galería ya tiene: la tarjeta
    // pide 700 u 1000 de ancho y la ficha 1400 o 2000 (ANCHOS_TARJETA contra
    // ANCHOS_FICHA), y otro ancho es otra URL, o sea otra descarga desde cero.
    // De ahí la entrada "a dos tiempos" que grabó el propietario: el morph
    // llevaba la tarjeta a su sitio en ~200ms y aterrizaba en una caja VACÍA, y
    // la foto aparecía medio segundo más tarde como un segundo golpe.
    //
    // `currentSrc` y no `src`: con `srcset` quien elige el ancho es el
    // navegador, y solo él sabe cuál acabó bajándose. Esa es la que está en
    // caché y la única que se pinta al instante.
    try {
      // Todas y no la primera: el mismo evento está a la vez en la galería, en
      // la tabla y en las tarjetas de móvil, y las de los contenedores ocultos
      // no han cargado nada (currentSrc vacío). Vale la primera que SÍ tenga.
      const candidatas = idMel ? document.querySelectorAll(`[data-id="${idMel}"] img`) : [];
      const img = Array.from(candidatas).find(el => el.currentSrc);
      if (img) {
        sessionStorage.setItem('mel-cartel-cacheado', JSON.stringify({ id: idMel, src: img.currentSrc }));
      }
    } catch (e) {}
  }

  function saveReturnState() {
    try {
      const view = document.querySelector('.view-panel:not(.hidden)')?.id?.replace('view-', '') || 'galería';
      const state = {
        view,
        page: currentPage,
        galleryVisibleCount,
        sortCol: currentSortCol,
        sortDir: currentSortDir,
        minYear,
        maxYear,
        // El local del panel no se guarda aquí: viaja en la propia URL de
        // vuelta (?location=), que es donde updateMapMarkers() lo busca.
        // Además del píxel, QUÉ flyer se estaba mirando. El píxel es frágil por
        // construcción en esta galería: el masonry mide cada tarjeta cuando su
        // imagen carga, así que el alto crece durante el primer segundo y el
        // píxel guardado deja de caer donde caía — de ahí que la vuelta no
        // siempre acertase con el flyer de origen. El identificador sigue
        // siendo verdad aunque el alto cambie.
        flyer: _s.ultimoFlyerAbierto || null,
        scroll: {
          galeria: document.getElementById('view-galería')?.scrollTop || 0,
          listaTable: document.getElementById('list-table-wrapper')?.scrollTop || 0,
          listaCards: document.getElementById('list-mobile-cards')?.scrollTop || 0,
        },
        map: null,
      };
      if (googleMap && typeof googleMap.getCenter === 'function') {
        const c = googleMap.getCenter();
        if (c) state.map = { lat: c.lat(), lng: c.lng(), zoom: googleMap.getZoom() };
      }
      sessionStorage.setItem('mel-return-state', JSON.stringify(state));
    } catch (e) {}
  }

  // Contrapartida de saveReturnState(). Se consume UNA sola vez (se borra al
  // leerla): así una vuelta restaura el sitio, pero una visita posterior a `/`
  // por cualquier otra vía arranca limpia.
  //
  // Va en dos fases porque el arranque de initHomePage() pisa parte de lo que
  // queremos restaurar: updateSlider() resetea currentPage y galleryVisibleCount
  // y manda la galería arriba del todo, así que el rango de años tiene que
  // aplicarse ANTES (para que el primer render ya salga filtrado) y la posición
  // dentro de ese resultado DESPUÉS.
  // El estado de vuelta vive en `_s` (no en una variable suelta) y con fecha de
  // caducidad.
  //
  // OJO, esto decía que `astro:page-load` dispara DOS veces por navegación
  // suave. **Es falso**, y está medido: dispara UNA. Lo que había eran varias
  // copias de initHomePage() enganchadas —una por cada visita a la home, porque
  // el script se reevalúa y `document` sobrevive—, y en cada carga corrían todas
  // (D-126). Ese era el origen de la "segunda pasada" que reseteaba página,
  // lotes y scroll justo después de que la primera los hubiera restaurado.
  //
  // Con el registro ya idempotente solo corre una, pero la caducidad se queda:
  // sigue haciendo falta para que una visita posterior a `/` no reviva un sitio
  // viejo, y para que el guard de restaurandoVuelta() sepa cuándo callar los
  // reseteos de arranque (D-121).
  const RETURN_STATE_TTL_MS = 4000;

  function readReturnState() {
    try {
      const raw = sessionStorage.getItem('mel-return-state');
      if (raw) {
        sessionStorage.removeItem('mel-return-state');
        _s.pendingReturn = JSON.parse(raw);
        _s.pendingReturnUntil = Date.now() + RETURN_STATE_TTL_MS;
      } else if (_s.pendingReturnUntil && Date.now() > _s.pendingReturnUntil) {
        _s.pendingReturn = null;
      }
    } catch (e) {
      _s.pendingReturn = null;
    }
    // Fase 1 — filtros que deben estar puestos antes del primer render.
    const st = _s.pendingReturn;
    if (!st) return;
    if (Number.isFinite(st.minYear) && sliderMin) sliderMin.value = String(st.minYear);
    if (Number.isFinite(st.maxYear) && sliderMax) sliderMax.value = String(st.maxYear);
    // TimeSlider siembra la posición de sus tiradores desde estos mismos
    // inputs, pero puede haberse inicializado ya (el orden entre los dos
    // scripts de astro:page-load no está garantizado): se le pide repintar.
    if (typeof window._melRenderSlider === 'function') window._melRenderSlider();
    if (st.sortCol) {
      currentSortCol = st.sortCol;
      currentSortDir = st.sortDir || 'asc';
      syncState();
      updateSortHeaderIcons();
    }
  }

  // Ocultar un contenedor mientras se recoloca, y revelarlo al llegar.
  //
  // El recorrido hasta el sitio es inevitable —las imágenes son lazy y el alto
  // de cada tarjeta no se sabe hasta que la suya carga—, pero que se VEA no lo
  // es. Lo usan los dos sitios que recolocan (restoreScroll y volverAlFlyer):
  // son un solo par de funciones y no una copia en cada uno a propósito, que dos
  // cosas que deben coincidir escritas por separado es la trampa favorita de
  // este código.
  //
  // El `void el.offsetWidth` NO es decorativo. Sin él, el navegador funde el
  // ocultar y el revelar en un único recálculo de estilo: no queda ningún estado
  // "desde" el que transicionar y la opacidad salta de 0 a 1 sin fundido alguno.
  // Medido con `getAnimations()`: sin el reflow, cero transiciones creadas; con
  // él, una. El fundido de la vuelta a Lista llevaba así desde que se escribió —
  // de ahí que el propietario dijera que "no se aprecia" en producción: no es
  // que fuese sutil, es que no existía.
  function ocultarParaColocar(el) {
    if (!el) return;
    el.style.transition = 'none';
    el.style.opacity = '0';
  }

  function revelarColocado(el) {
    // Solo revela lo que está oculto: así llamarlo dos veces no reinicia nada.
    if (!el || el.style.opacity !== '0') return;
    void el.offsetWidth;
    el.style.transition = 'opacity 0.25s ease';
    el.style.opacity = '1';
    setTimeout(() => { el.style.transition = ''; el.style.opacity = ''; }, 300);
  }

  // Insiste en devolver un contenedor a `target` mientras su contenido siga
  // creciendo (imágenes cargando ⇒ alto final desconocido al principio).
  // Lleva la galería hasta una tarjeta concreta y la deja QUIETA ahí.
  //
  // Colocarla una vez no basta, y por eso a veces quedaba cerca y otras no: el
  // masonry mide cada tarjeta cuando su imagen carga, así que durante el primer
  // segundo largo las de arriba van creciendo y empujando a las de abajo. La
  // tarjeta se mueve DESPUÉS de haberla colocado. Se reafirma durante todo el
  // plazo, recalculando en cada vuelta dónde está la tarjeta AHORA: la tarjeta
  // es la referencia estable, su píxel no. También puede no existir todavía,
  // porque el scroll infinito carga por lotes; por eso se busca en cada vuelta.
  //
  // Se fija el scrollTop del contenedor en lugar de usar scrollIntoView() a
  // propósito: scrollIntoView desplaza también todos los contenedores
  // antepasados, incluida la ventana, y en un móvil eso mueve la página entera.
  //
  // Devuelve false si no hay a dónde ir, para que quien llama recaiga en el
  // píxel guardado.
  // `timeoutMs` NO es cuánto dura la persecución: es solo la red de seguridad
  // para una imagen que no llegue nunca (ver el criterio de parada más abajo).
  // Por eso es holgado. Reafirmar no cuesta nada —cuando la tarjeta ya está
  // colocada no se escribe— y al primer gesto del visitante se abandona.
  function volverAlFlyer(idMel, timeoutMs = 10000) {
    const cont = document.getElementById('view-galería');
    if (!cont || !idMel) return false;

    // En móvil la tarjeta va pegada al borde superior de la galería, que es
    // exactamente donde acaba la toolbar (el contenedor no lleva relleno
    // superior ahí). Es lo que pidió el propietario y se mantiene.
    //
    // El corte es `md`, donde la rejilla pasa de dos a tres columnas. Antes era
    // 639px porque marcaba el paso de UNA columna a dos, y a una columna la
    // tarjeta era más alta que la ventana: centrar algo que no cabe no centra
    // nada, recorta por arriba y por abajo a la vez. Desde D-124 no hay ningún
    // caso de una sola columna, así que ese corte ya no significaba lo que decía.
    const enMovil = window.matchMedia('(max-width: 767px)').matches;

    // Se tapa el viaje. El revelado lleva su PROPIO plazo, corto y aparte del
    // del bucle: aquel puede llegar a 10s esperando una imagen que quizá no
    // llegue nunca, y la galería en blanco diez segundos es peor que cualquier
    // salto. Se revela en cuanto la tarjeta queda colocada —lo normal, unos
    // pocos fotogramas— o a los 700ms como tope, lo que pase antes. El bucle
    // sigue corrigiendo por debajo, ya a la vista.
    ocultarParaColocar(cont);
    const revelar = () => { clearTimeout(relojRevelado); revelarColocado(cont); };
    const relojRevelado = setTimeout(revelar, 700);

    const deadline = Date.now() + timeoutMs;
    const stop = () => {
      clearInterval(timer);
      cont.removeEventListener('wheel', stop);
      cont.removeEventListener('touchstart', stop);
      cont.removeEventListener('pointerdown', stop);
      // Pase lo que pase —llegada, plazo agotado, o el visitante tocando el
      // scroll— la galería NO puede quedarse invisible.
      revelar();
    };
    // setInterval y no requestAnimationFrame, igual que restoreScroll(): rAF se
    // congela en pestañas en segundo plano y esto tiene que llegar a su sitio
    // aunque el visitante se vaya a otra pestaña mientras vuelve.
    // ¿Puede todavía moverse la tarjeta? Solo si queda algo sin medir de ella
    // hacia arriba: el masonry le pone `unsized` a cada tarjeta hasta que su
    // imagen carga y se le calcula el alto, y mientras alguna de las de arriba
    // siga sin medir, el alto de lo que hay por encima puede crecer y llevarse
    // la nuestra con él. Las de abajo dan igual: crecer por debajo no la mueve.
    const puedeMoverse = (tarjeta) => {
      const sinMedir = cont.querySelectorAll('.gallery-item.unsized');
      for (let i = 0; i < sinMedir.length; i++) {
        // La propia tarjeta cuenta: sin su alto no se puede centrar.
        if (sinMedir[i] === tarjeta) return true;
        // FOLLOWING = la tarjeta va después ⇒ la sin medir está por encima.
        if (sinMedir[i].compareDocumentPosition(tarjeta) & Node.DOCUMENT_POSITION_FOLLOWING) return true;
      }
      return false;
    };

    const timer = setInterval(() => {
      const tarjeta = cont.querySelector(`.gallery-item[data-id="${idMel}"]`);
      if (tarjeta) {
        const arriba = tarjeta.getBoundingClientRect().top - cont.getBoundingClientRect().top + cont.scrollTop;
        const hueco = cont.clientHeight - tarjeta.offsetHeight;
        const objetivo = enMovil ? arriba : arriba - Math.max(0, hueco / 2);
        if (Math.abs(cont.scrollTop - objetivo) > 2) cont.scrollTop = objetivo;
        // Se relee DESPUÉS de asignar, no antes: si el destino cae más allá del
        // tope el navegador lo recorta, la diferencia sigue siendo grande y no
        // se revela — que es justo lo que hay que hacer mientras la rejilla no
        // haya crecido lo bastante para que la tarjeta pueda llegar a su sitio.
        if (Math.abs(cont.scrollTop - objetivo) <= 2) revelar();
      }
      // Se para cuando la tarjeta YA NO PUEDE moverse, no cuando el reloj se
      // acaba ni cuando el scroll parece quieto.
      //
      // "Quieto" no vale: el scroll se queda quieto también cuando NO ha
      // llegado, porque mientras la rejilla no ha crecido del todo el destino
      // cae más abajo del tope y el navegador lo recorta ahí. Medido: destino
      // 3908, tope 3838, tres lecturas idénticas y el bucle dándose por bueno.
      //
      // Un plazo tampoco vale: con 4s la tarjeta acabó a 550px de su sitio con
      // 27 imágenes aún sin medir. Cuánto tardan no lo decide este código —
      // vienen de Drive por la red, y en Safari ni siquiera cargan hasta que el
      // visitante ha pasado por drive.google.com (ver roadmap). Cualquier número
      // que se elija aquí es una apuesta sobre la conexión de otro.
      if (tarjeta && !puedeMoverse(tarjeta)) stop();
      // El plazo queda solo de red de seguridad, para la imagen que no carga
      // nunca y dejaría su tarjeta `unsized` para siempre.
      else if (Date.now() >= deadline) stop();
    }, 50);
    // Se abandona en cuanto el visitante toca el scroll: no pelearse con él.
    cont.addEventListener('wheel', stop, { once: true, passive: true });
    cont.addEventListener('touchstart', stop, { once: true, passive: true });
    cont.addEventListener('pointerdown', stop, { once: true, passive: true });
    return true;
  }

  function restoreScroll(containerId, target, timeoutMs = 2500) {
    if (!target) return;
    const el = document.getElementById(containerId);
    if (!el) return;
    // El recorrido hasta la posición guardada es inevitable: las imágenes son
    // lazy y el masonry no conoce el alto de una tarjeta hasta que la suya
    // carga, así que el contenedor va creciendo y solo se puede bajar a medida
    // que da de sí. Lo que sí se puede es que no se VEA.
    ocultarParaColocar(el);

    // Con setInterval y no requestAnimationFrame a propósito: rAF se congela en
    // pestañas en segundo plano, y esta restauración tiene que completarse
    // aunque el visitante cambie de pestaña mientras vuelve.
    const deadline = Date.now() + timeoutMs;
    let ultimo = -1;
    let estables = 0;
    const stop = () => {
      clearInterval(timer);
      el.removeEventListener('wheel', stop);
      el.removeEventListener('touchstart', stop);
      el.removeEventListener('pointerdown', stop);
      revelarColocado(el);
    };
    // Se reafirma hasta que la posición se asienta, no solo hasta acertar una
    // vez: la segunda pasada de initHomePage() manda el scroll a 0 después de
    // que la primera ya lo hubiera colocado. Se da por asentada cuando deja de
    // moverse — sirve tanto si llega al objetivo como si el contenido se ha
    // encogido y el objetivo ya no existe (si no, esperaría oculta el plazo
    // entero para nada).
    const timer = setInterval(() => {
      if (Math.abs(el.scrollTop - target) > 2) el.scrollTop = target;
      if (el.scrollTop === ultimo) estables++; else { estables = 0; ultimo = el.scrollTop; }
      if (estables >= 3 || Date.now() >= deadline) stop();
    }, 50);
    el.addEventListener('wheel', stop, { once: true, passive: true });
    el.addEventListener('touchstart', stop, { once: true, passive: true });
    el.addEventListener('pointerdown', stop, { once: true, passive: true });
  }

  // ¿Estamos en mitad de una vuelta desde una ficha de evento?
  //
  // Tres sitios mandan la galería «al primer lote y arriba del todo» cuando
  // cambia un filtro: initHomePage(), updateSlider() y el manejador de
  // `mel-search`. Existen para un gesto del visitante —mover el slider, escribir
  // en el buscador—, donde quedarse a media profundidad sobre un resultado
  // recién encogido lo dejaría varado entre huecos.
  //
  // Al volver de una ficha no hay ningún gesto suyo detrás: son los tres
  // arrancando. El buscador es el más sorprendente — al iniciarse anuncia que no
  // hay búsqueda (`setState('default')` dispara `dispatchSearch("")`), y eso
  // llega aquí indistinguible de haber borrado el campo a mano. El resultado
  // medido era que la restauración ponía 50 tarjetas y el arranque las devolvía
  // a 32 justo después: la rejilla se pintaba CUATRO veces en 1,7s (32 → 32 → 50,
  // y otra ronda 32 → 50), encogiéndose y reestirándose a la vista, y encima
  // moviendo el suelo bajo la tarjeta que el anclaje intentaba fijar.
  //
  // Mientras haya una vuelta viva, la restauración manda y los reseteos se
  // callan. No se cambia el orden en que corren —el del buscador vive en otro
  // componente y su `astro:page-load` no está garantizado que llegue antes ni
  // después (ver readReturnState)—, que es justo por lo que hace falta un guard
  // y no reordenar llamadas.
  function restaurandoVuelta() {
    return !!_s.pendingReturn && Date.now() < (_s.pendingReturnUntil || 0);
  }

  // Da la vuelta por consumida antes de que expire su plazo.
  //
  // La restauración se calla los reseteos Y la transición de vista (arriba: una
  // vuelta trae viva la del ClientRouter y apilar otra la supersedería, regla 3).
  // Eso está bien mientras el visitante no haya hecho nada, pero en cuanto elige
  // un orden nuevo ya no está volviendo a ningún sitio: está pidiendo otra cosa.
  // Sin esto, ordenar justo al aterrizar desde una ficha —sin tocar el scroll,
  // que es lo que cancelaba la vuelta por otra vía— saltaba al orden nuevo en un
  // fotograma, sin animación ninguna.
  function cancelarVuelta() {
    _s.pendingReturn = null;
    _s.pendingReturnUntil = 0;
  }

  // Cambiar un filtro devuelve al principio del resultado: primera página, primer
  // lote de scroll infinito y galería arriba. Quedarse a media profundidad sobre
  // un resultado recién encogido dejaba al visitante varado entre huecos.
  //
  // Los tres reseteos van JUNTOS y detrás de un solo guard a propósito. Estuvieron
  // copiados en los dos sitios que filtran (el slider de años y el buscador) y en
  // los dos se protegió `galleryVisibleCount` pero no `currentPage`. Como la
  // galería no usa paginación, el descuido no se veía: el único síntoma era volver
  // de una ficha a la Lista estando en la página 2 y aterrizar en la 1. Un guard
  // por copia vuelve a divergir; este no puede.
  function reiniciarPosicion() {
    if (restaurandoVuelta()) return;
    currentPage = 1;
    _s.currentPage = 1;
    galleryVisibleCount = PAGE_SIZE;
    const galleryScroller = document.getElementById('view-galería');
    if (galleryScroller) galleryScroller.scrollTop = 0;
  }

  function applyReturnState() {
    const st = _s.pendingReturn;
    if (!st) return;

    // Fase 2 — posición dentro del resultado ya filtrado.
    currentPage = st.page || 1;
    galleryVisibleCount = Math.max(PAGE_SIZE, st.galleryVisibleCount || PAGE_SIZE);
    syncState();
    filterArchives();

    // El scroll no se puede fijar de una sola vez: el masonry de la galería
    // mide cada tarjeta cuando su imagen termina de cargar, así que el alto
    // del contenedor va creciendo durante el primer segundo largo. Fijar
    // scrollTop antes de que dé de sí lo clampa (acababa en 0). Se reintenta
    // frame a frame hasta que la posición aguanta, con tope de tiempo — y se
    // abandona en cuanto el visitante toca el scroll, para no pelearse con él.
    const s = st.scroll || {};
    // Si sabemos por qué flyer se entró, se vuelve a ÉL. El píxel queda de red
    // de seguridad para cuando no hay flyer (se entró desde lista o mapa) o
    // cuando ese flyer ya no está en pantalla porque cambió el filtro.
    if (!st.flyer || !volverAlFlyer(st.flyer)) restoreScroll('view-galería', s.galeria);
    restoreScroll('list-table-wrapper', s.listaTable);
    restoreScroll('list-mobile-cards', s.listaCards);

    // La cámara del mapa solo se restaura si el mapa ya existe. Si se vuelve a
    // la vista Mapa, se crea de forma diferida: en ese caso el paneo hacia el
    // local de `?location=` (D-075) ya deja la cámara donde corresponde.
    if (st.map && googleMap && typeof googleMap.setCenter === 'function') {
      googleMap.setCenter({ lat: st.map.lat, lng: st.map.lng });
      if (Number.isFinite(st.map.zoom)) googleMap.setZoom(st.map.zoom);
    }
  }

  // Real navigation to the static, server-rendered /event/[id] page — this
  // replaced an in-place SPA overlay that used to duplicate its whole
  // markup/logic (see docs/decisions.md D-072). Uses a hard reload
  // (data-astro-reload semantics via window.location, matching the
  // Anterior/Siguiente links on /event/[id] itself) rather than Astro's
  // soft ClientRouter navigation: an earlier full-page-navigation attempt
  // at this site hit the router's stale-snapshot cache switching between
  // two /event/[id] URLs, which is exactly why the overlay was built in
  // the first place. /event/[id] already reads ?search=/?location=/?view=
  // to compute its own filtered Anterior/Siguiente and its own return link.
  // ÚNICA fábrica de URLs de ficha. La usan la precarga y la navegación, y por eso
  // existe: cada una construía la suya y se habían separado. `navigateToEvent`
  // añadía `sort` y `dir` cuando había un orden activo y `prefetchEventUrl` no, así
  // que salían dos cadenas distintas:
  //   precarga:   /event/X?view=mapa&location=Dickens+Tavern
  //   navegación: /event/X?view=mapa&sort=fecha&dir=desc&location=Dickens+Tavern
  // El navegador indexa lo precargado por URL exacta, así que no había acierto y la
  // ficha se cargaba en frío — el propietario lo notó como "tarda muchísimo en
  // abrir". Y no era un caso raro: el botón de ordenación deja `currentSortCol` en
  // 'fecha', así que desde el primer uso TODA la precarga del sitio quedaba
  // inútil, en la galería, en la lista y en el panel.
  // Si hay que añadir un parámetro más, va aquí y las dos lo heredan.
  function eventUrl(idMel, { search = '', location = '' } = {}) {
    const activeViewName = document.querySelector('.view-panel:not(.hidden)')?.id?.replace('view-', '') || 'galería';
    const params = new URLSearchParams();
    params.set('view', activeViewName);
    if (currentSortCol) {
      params.set('sort', currentSortCol);
      params.set('dir', currentSortDir);
    }
    if (location) {
      params.set('location', location);
    } else if (search) {
      params.set('search', search);
    }
    return `/event/${idMel}?${params.toString()}`;
  }

  function prefetchEventUrl(idMel, { search = '', location = '' } = {}) {
    if (!idMel) return;
    const url = eventUrl(idMel, { search, location });
    if (!document.querySelector(`link[rel="prefetch"][href="${url}"]`)) {
      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url;
      document.head.appendChild(link);
    }
  }

  function navigateToEvent(idMel, { search = '', location = '' } = {}) {
    // Antes de guardar el estado: así el flyer de origen viaja dentro de él.
    recordarFlyerAbierto(idMel);
    saveReturnState();
    // La MISMA fábrica que usa la precarga (eventUrl), no una copia: si las dos
    // construyen la cadena por su cuenta acaban divergiendo, y basta un parámetro
    // de diferencia para que lo precargado no se use.
    const url = eventUrl(idMel, { search, location });
    if (typeof window.__melNavigate === 'function') {
      window.__melNavigate(url);
    } else {
      document.body.style.transition = 'opacity 0.15s ease';
      document.body.style.opacity = '0';
      setTimeout(() => { window.location.href = url; }, 150);
    }
  }

  // Abrir un cartel = navegar a su ficha. Se llamaba `openLightbox` y no abría
  // ningún lightbox: aquel overlay se sustituyó por navegación real y el nombre
  // se quedó, apuntando a un modal que ya no existía. Su marcado y sus listeners
  // siguieron en pie hasta esta limpieza.
  function abrirFicha(item) {
    navigateToEvent(item.idMel, { search: searchQuery });
  }

  function bindInitialCardClicks() {
    document.querySelectorAll('.gallery-item').forEach(card => {
      // Mismo motivo que en buildGalleryCard: en un móvil no hay `pointerenter`.
      ['pointerenter', 'touchstart'].forEach((evento) => card.addEventListener(evento, () => {
        const id = card.dataset.id;
        if (id) prefetchEventUrl(id, { search: searchQuery });
      }, { once: true, passive: true }));
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        const item = archives.find(x => x.idMel === id);
        if (item) abrirFicha(item);
      });
    });
  }

  // Smooth numeric counter roll animation. `prefix` va pegado a cada
  // fotograma del rodillo (los clusters del mapa lo usan con '+', D-250) —
  // escribirlo aparte dejaría el número desnudo durante la animación.
  function animateValue(obj, start, end, duration = 250, prefix = '') {
    if (start === end) return;
    let startTimestamp = null;
    const step = (timestamp) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      obj.textContent = prefix + Math.floor(progress * (end - start) + start);
      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        obj.textContent = prefix + end;
      }
    };
    window.requestAnimationFrame(step);
  }

  // Pagination lives INSIDE whichever list scroll container is currently
  // active (mobile cards vs desktop table, D-057's min-[440px] breakpoint)
  // — not as an always-visible footer that permanently eats into the
  // list's own viewport height. It only becomes visible once the user
  // actually scrolls to the end of the list (D-066 — reverts the
  // "always-visible sibling" shape from D-064/D-065, which the
  // propietario flagged as wrong: "no esté siempre visible sino que
  // aparezca al final del scroll"). Shared by filterArchives()'s own
  // repopulate AND switchView()'s tab-click toggle (D-067 — switchView()
  // had its OWN separate classList.remove('hidden') that showed


  // La búsqueda perdona tildes, diéresis y puntuación.
  //
  // Sin esto, escribir "leon" no encontraba "León", ni "mucrovision" a
  // "Mucrovisión", ni "valdepielago" a "Valdepiélago". En una sola ficha hay
  // cuatro nombres con tilde o diéresis (Hüugen, León, Mucrovisión, Don Vilón),
  // y en un teléfono prácticamente nadie escribe los acentos: la búsqueda
  // fallaba en silencio, que es la peor manera de fallar.
  //
  // `normalize('NFD')` separa cada letra de su acento y el rango ̀-ͯ
  // barre los acentos sueltos. La puntuación se convierte en espacio y no se
  // borra, para no pegar palabras: "Promissing/Youngster" queda como dos
  // palabras y sigue encontrándose escribiéndolo con barra o sin ella.
  //
  // Una sola función para las dos vistas: este filtro estaba copiado tal cual en
  // la galería y en el mapa, y así no pueden separarse (regla 7).
  function normalizarParaBuscar(texto) {
    return (texto || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  function coincideConLaBusqueda(item, consulta) {
    if (!consulta) return true;
    return normalizarParaBuscar(item.evento).includes(consulta)
      || normalizarParaBuscar(item.lugar).includes(consulta)
      || normalizarParaBuscar(item.localidad).includes(consulta)
      || normalizarParaBuscar(item.artistas).includes(consulta)
      || normalizarParaBuscar(item.organiza).includes(consulta)
      || normalizarParaBuscar(item.disenador).includes(consulta);
  }

  // Filter Archives by Year & Search Query and Recalculate unique counts
  function filterArchives(shouldFitBounds = false) {
    let tempFiltered = archives.filter(item => {
      const yr = getYear(item.fecha);
      const yearMatch = yr >= minYear && yr <= maxYear;
      
      const searchMatch = coincideConLaBusqueda(item, normalizarParaBuscar(searchQuery));

      return yearMatch && searchMatch;
    });

    // Aquí NO se ordena: filtrar solo quita, nunca reordena. El orden lo lleva
    // ya `archives`, que es la secuencia de la sesión, y ordenarlo es cosa de
    // aplicarOrden() (ver allí por qué). Antes se reordenaba en cada llamada
    // partiendo del archivo base, y por eso cada ordenación borraba la anterior.
    filtered = tempFiltered;

    // El vector de navegación de la ficha de evento ES la secuencia visible:
    // `filtered` ya lleva el orden de la sesión (o el de la columna elegida en
    // Lista) y ya excluye lo que no pasa los filtros, así que Anterior/Siguiente
    // recorre exactamente lo que el visitante está viendo, sin reordenar nada
    // por su cuenta (contrato de navegación, architecture.md).
    try {
      sessionStorage.setItem('mel-active-nav-sequence', JSON.stringify(filtered.map(x => x.idMel)));
    } catch (e) {}

    // 1. Calculate dynamic statistics on the fly
    const filteredArtists = new Set();
    const filteredDesigners = new Set();
    const filteredPromoters = new Set();
    
    filtered.forEach(item => {
      if (item.artistas) {
        item.artistas.split(/,+/).forEach(a => {
          const cleanA = a.trim().toLowerCase();
          if (cleanA && cleanA !== 'no detallados' && cleanA !== 'desconocido') filteredArtists.add(cleanA);
        });
      }
      if (item.organiza) {
        const cleanP = item.organiza.trim().toLowerCase();
        if (cleanP && cleanP !== 'desconocido' && cleanP !== 'varios') filteredPromoters.add(cleanP);
      }
      if (item.disenador) {
        const cleanD = item.disenador.trim().toLowerCase();
        if (cleanD && cleanD !== 'desconocido') filteredDesigners.add(cleanD);
      }
    });

    const stats = {
      "Eventos": filtered.length,
      "Artistas": filteredArtists.size,
      "Diseñadores": filteredDesigners.size,
      "Promotores": filteredPromoters.size
    };

    // Run dynamic counter roll animations
    for (const [label, count] of Object.entries(stats)) {
      const badge = document.querySelector(`.filter-tag[data-category="${label}"] .tag-count-val`);
      if (badge) {
        const startVal = parseInt(badge.textContent) || 0;
        animateValue(badge, startVal, count, 200);
      }
    }

    const performDOMUpdates = () => {
      // 2. Paginate filtered dataset
      const totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      
      // Galería y Lista comparten SIEMPRE la misma secuencia (`filtered`): la
      // de la sesión mientras no se ordene nada, o la columna elegida en Lista
      // en cuanto se ordene. Filtrar/buscar solo oculta, nunca reordena — antes
      // la Lista saltaba a orden aleatorio en cuanto había una búsqueda activa
      // y volvía a cronológico al borrarla.
      const paginated = filtered.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

      // La galería va por libre (D-015): ignora la paginación (scroll
      // infinito por lotes). Su orden es aleatorio estable por sesión —
      // EXCEPTO si el visitante ha elegido explícitamente un orden en Lista
      // (currentSortCol), en cuyo caso la Galería adopta ese mismo orden
      // (y los mismos filtros, ya aplicados en `filtered` por igual para
      // ambas vistas) en vez del aleatorio. `paginated` sigue siendo el
      // corte de la lista.
      galleryOrderedCache = [...filtered];
      if (galleryVisibleCount < PAGE_SIZE) galleryVisibleCount = PAGE_SIZE;
      const galleryShown = galleryOrderedCache.slice(0, galleryVisibleCount);

      // Update pagination UI controls across desktop and mobile containers
      document.querySelectorAll('.pagination-controls-container').forEach(pagControls => {
        const pagNumbers = pagControls.querySelector('.pagination-numbers');
        const btnPrev = pagControls.querySelector('.btn-prev-page');
        const btnNext = pagControls.querySelector('.btn-next-page');

        if (pagNumbers) {
          pagNumbers.innerHTML = '';
          for (let p = 1; p <= totalPages; p++) {
            const btn = document.createElement('button');
            if (p === currentPage) {
              btn.className = "relative shrink-0 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer typo-body-roman text-mel-action-primary";
              btn.innerHTML = `
                <span>${p}</span>
                <div class="absolute bottom-1 left-0 right-0 h-[2px] flex justify-center">
                  <svg width="12" height="2" viewBox="0 0 12 2" fill="none" class="text-mel-action-primary">
                    <path d="M1 1C4.33333 1 7.66667 1 11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>
              `;
            } else {
              btn.className = "relative shrink-0 w-8 h-8 flex items-center justify-center bg-transparent border-none cursor-pointer typo-body-roman text-mel-text-secondary hover:text-mel-action-primary transition-colors duration-200";
              btn.innerHTML = `<span>${p}</span>`;
              btn.addEventListener('click', () => {
                handlePaginationNav(p);
              });
            }
            pagNumbers.appendChild(btn);
          }
        }
        
        if (btnPrev) {
          if (currentPage === 1) {
            btnPrev.setAttribute('disabled', 'true');
          } else {
            btnPrev.removeAttribute('disabled');
          }
          if (!btnPrev._hasListener) {
            btnPrev._hasListener = true;
            btnPrev.addEventListener('click', () => {
              if (currentPage > 1) handlePaginationNav(currentPage - 1);
            });
          }
        }
        
        if (btnNext) {
          if (currentPage === totalPages) {
            btnNext.setAttribute('disabled', 'true');
          } else {
            btnNext.removeAttribute('disabled');
          }
          if (!btnNext._hasListener) {
            btnNext._hasListener = true;
            btnNext.addEventListener('click', () => {
              if (currentPage < totalPages) handlePaginationNav(currentPage + 1);
            });
          }
        }
      });

      // 3. Populate Gallery Grid View
      const gridContainer = document.getElementById('gallery-grid');
      // Estado del FLIP del arrastre (D-251): los llena la reconciliación de
      // abajo y los consume reproducirFlipGaleria() tras el dimensionado.
      let rectsViejosGaleria = null;
      const entrantesGaleria = [];

      const viewsEmptyState = document.getElementById('views-empty-state');
      const listTableWrapper = document.getElementById('list-table-wrapper');
      const listMobileCards = document.getElementById('list-mobile-cards');

      if (filtered.length === 0) {
        if (gridContainer) gridContainer.innerHTML = '';
        if (viewsEmptyState) {
          viewsEmptyState.classList.remove('hidden');
          viewsEmptyState.classList.add('flex');
        }
        gridContainer.classList.add('hidden');
        if (listTableWrapper) listTableWrapper.style.display = 'none';
        if (listMobileCards) listMobileCards.style.display = 'none';
        setSidePanelOpenState(false);
        // Sin resultados no hay nada que ver en NINGUNA vista, así que el
        // selector Galería/Mapa/Lista solo invita a dar tumbos entre tres
        // pantallas vacías. Se oculta para que el estado vacío quede solo y se
        // lea como lo que es: algo inesperado. `invisible` y no `hidden` para
        // no descolocar la toolbar mientras tanto.
        const toggleWrapper = document.getElementById('home-toggle-wrapper');
        if (toggleWrapper) {
          toggleWrapper.classList.add('hidden');
        }
        // El selector de vista se retira, pero los recuentos NO: al arrastrar
        // el slider de años se entra y se sale de "sin resultados" continuamente,
        // y unas tags que parpadean son peor que unas tags con ceros.
        // Al no estar el selector, ocupan el ancho que este deja libre.
        //
        // En el fotograma siguiente y no aquí mismo: llamándolo en el acto, el
        // reparto se calculaba antes de que el resto del pintado terminara y
        // quedaba con el ancho de cuando el selector todavía estaba (medido:
        // 808px en vez de 1224).
        requestAnimationFrame(() => window._melActualizarToolbar && window._melActualizarToolbar());
      } else {
        if (viewsEmptyState) {
          viewsEmptyState.classList.add('hidden');
          viewsEmptyState.classList.remove('flex');
        }
        const toggleWrapper = document.getElementById('home-toggle-wrapper');
        if (toggleWrapper) {
          toggleWrapper.classList.remove('hidden');
        }
        requestAnimationFrame(() => window._melActualizarToolbar && window._melActualizarToolbar());
        gridContainer.classList.remove('hidden');
        if (listTableWrapper) listTableWrapper.style.display = '';
        if (listMobileCards) listMobileCards.style.display = '';

        // Aquí NO se reescriben las clases de la rejilla. Había una asignación
        // completa de `className` repitiendo a mano las del marcado (regla 7 de
        // AGENTS.md, réplica en JS de un componente Astro), y hacía dos daños:
        // se desincronizó al cambiar las columnas —dejaba la galería en una sola
        // en móvil por mucho que dijera el marcado— y borraba en cada render la
        // clase `galeria-cuatro`, que se enciende desde otro sitio. Era además
        // redundante: lo único que se le añade a esta rejilla es `hidden`, y esa
        // se quita en la línea de arriba.
        // En el primer render se conservan las tarjetas que ya vinieron del SSR
        // (solo se miden) para no destruir el marcado servido... pero SOLO si
        // coinciden con lo que toca pintar. No coinciden en dos casos reales:
        // al recargar dentro de una sesión (el servidor baraja de nuevo y la
        // sesión manda su propio orden) y al volver de una ficha de evento con
        // filtros restaurados (el SSR sirve el archivo entero). Sin esta
        // comprobación, ambos casos se quedaban mostrando el HTML del servidor.
        const ssrIds = Array.from(gridContainer.children).map(el => el.dataset.id);
        const targetIds = galleryShown.map(x => x.idMel);
        const ssrMatchesTarget = ssrIds.length === targetIds.length
          && ssrIds.every((id, i) => id === targetIds[i]);
        if (isFirstDOMUpdate && gridContainer.children.length > 0 && ssrMatchesTarget) {
          gridContainer.querySelectorAll('img').forEach(img => {
            if (img.complete) measureFlyerImg(img);
          });
        } else {
          // Reconciliación por idMel, NO borrado total (D-249). Antes esto era
          // `innerHTML = ''` + reconstruir las 32 tarjetas en cada filtrado, y
          // una <img> recién creada (lazy + async) llega SIN descodificar a la
          // foto "nueva" de la view transition: en escritorio la caché lo tapa,
          // en Chrome móvil se veían cajas blancas moviéndose durante toda la
          // animación (reportado con la búsqueda de siempre igual que con el
          // arrastre del slider). Mover un nodo existente conserva su imagen
          // descodificada, su medida del masonry y sus listeners — los tiene
          // seguro: o nació de buildGalleryCard o es SSR pasado por
          // bindInitialCardClicks. Solo se crean las tarjetas que ENTRAN al
          // resultado y se retiran las que salen — y las que salen van a la
          // guardería, no a la basura (D-251).
          //
          // Durante el arrastre, el reorden lo anima el FLIP (D-251): la
          // posición VISUAL de partida se captura aquí, antes de tocar nada
          // (con el transform de un vuelo anterior incluido, si lo hay), y
          // reproducirFlipGaleria() se dispara tras dimensionarConocidas(),
          // cuando la rejilla ya está en su layout final.
          if (arrastrandoSlider || animacionOrdenLenta) {
            // También en el SORT del botón (D-255): el reordenado viaja por
            // FLIP de identidad — cada cartel vuela a su sitio — en vez de la
            // view transition por huecos, que "transformaba" una tarjeta en
            // otra (emparejaba por posición) y fotografiaba 32 grupos.
            // Coordenadas RELATIVAS a la rejilla, no al viewport (D-252): si
            // el scroll cambia entre la captura y la medición del destino
            // (p. ej. el navegador lo recorta porque el contenido encogió),
            // unos rects de viewport meterían ese desplazamiento común en
            // todos los deltas y la rejilla entera parecería volar en bloque.
            // Relativo al grid, el FLIP solo anima reordenación de verdad.
            const baseVieja = gridContainer.getBoundingClientRect();
            rectsViejosGaleria = new Map();
            Array.from(gridContainer.children).forEach(el => {
              if (!el.dataset || !el.dataset.id) return;
              const r = el.getBoundingClientRect();
              if (!r.height) return;   // sin caja no hay posición que contar
              rectsViejosGaleria.set(el.dataset.id, {
                left: r.left - baseVieja.left,
                top: r.top - baseVieja.top,
                width: r.width,
                height: r.height,
              });
            });
          }
          const vivas = new Map();
          Array.from(gridContainer.children).forEach(el => {
            if (el.dataset && el.dataset.id) vivas.set(el.dataset.id, el);
          });
          const conservadas = new Set();
          // Colocación SOLO si el nodo no está ya donde toca (D-254). El
          // appendChild incondicional de antes movía TODAS las tarjetas en
          // cada pasada aunque el orden no cambiara, y en iOS mover un nodo
          // con <img> puede repintarla — el parpadeo de las tarjetas de
          // ARRIBA que vio el propietario al recortar por la derecha, cuando
          // allí no debería inmutarse nada. Un nodo que ya es el siguiente
          // del cursor no se toca.
          // Saltando estorbos (fantasmas absolutos y tarjetas que van a salir
          // en esta misma pasada): sin el salto, cada tarjeta viva posterior a
          // un estorbo se movía de DOM sin necesidad (D-256).
          const idsMostrados = new Set(galleryShown.map(x => x.idMel));
          const esEstorboCarta = n => !n.dataset || !n.dataset.id || !idsMostrados.has(n.dataset.id);
          let cursorGaleria = null;
          const colocarEnGaleria = (nodo) => {
            let siguiente = cursorGaleria ? cursorGaleria.nextSibling : gridContainer.firstChild;
            while (siguiente && siguiente !== nodo && esEstorboCarta(siguiente)) siguiente = siguiente.nextSibling;
            if (siguiente !== nodo) gridContainer.insertBefore(nodo, siguiente);
            cursorGaleria = nodo;
          };
          galleryShown.forEach((item, i) => {
            const existente = vivas.get(item.idMel);
            if (existente) {
              conservadas.add(item.idMel);
              colocarEnGaleria(existente);
              return;
            }
            const guardada = guarderiaTarjetas.get(item.idMel);
            if (guardada) {
              guarderiaTarjetas.delete(item.idMel);
              colocarEnGaleria(guardada);
              entrantesGaleria.push(guardada);
            } else {
              const nueva = buildGalleryCard(item, i);
              colocarEnGaleria(nueva);
              entrantesGaleria.push(nueva);
            }
          });
          const aGuarderia = (id, el) => {
            ['transform', 'transition', 'opacity', 'position', 'left', 'top',
             'width', 'height', 'pointerEvents', 'zIndex'].forEach(p => { el.style[p] = ''; });
            guarderiaTarjetas.set(id, el);
            if (guarderiaTarjetas.size > GUARDERIA_MAX) {
              guarderiaTarjetas.delete(guarderiaTarjetas.keys().next().value);
            }
          };
          vivas.forEach((el, id) => {
            if (conservadas.has(id)) return;
            const rectRel = rectsViejosGaleria && rectsViejosGaleria.get(id);
            if (!rectRel) {
              // Sin arrastre (o sin caja medida) no hay despedida: fuera y a
              // la guardería.
              el.remove();
              aGuarderia(id, el);
              return;
            }
            // Despedida durante el arrastre (D-252): el PROPIO nodo hace de
            // fantasma — clonarlo estrenaría una <img> sin descodificar, la
            // enfermedad que venimos curando. Se queda en la rejilla pero
            // fuera de flujo (absolute, coordenadas relativas al grid, que
            // es `position: relative` para esto), sin `data-id` para que ni
            // la reconciliación ni el FLIP lo confundan con una tarjeta
            // viva, y encoge mientras se apaga. Al terminar recupera su id
            // y pasa a la guardería, listo para revivir.
            delete el.dataset.id;
            el.style.position = 'absolute';
            el.style.left = rectRel.left + 'px';
            el.style.top = rectRel.top + 'px';
            el.style.width = rectRel.width + 'px';
            el.style.height = rectRel.height + 'px';
            el.style.pointerEvents = 'none';
            el.style.zIndex = '1';
            // Al ritmo de la pasada, como las entradas (D-256): ~260ms en el
            // arrastre, hasta 500 en el sort lento.
            const durDespedida = Math.max(260, Math.min(500,
              Math.round((animacionOrdenLenta ? duracionOrden : FLIP_DUR) / 3)));
            const despedida = el.animate(
              [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.9)' }],
              { duration: durDespedida, easing: 'ease-out' }
            );
            despedida.onfinish = despedida.oncancel = () => {
              el.remove();
              el.dataset.id = id;
              aGuarderia(id, el);
            };
          });
          gridContainer.querySelectorAll('img').forEach(img => {
            if (img.complete) measureFlyerImg(img);
          });
        }
        // Antes de que el navegador fotografíe el estado nuevo al salir de este
        // callback, la cuadrícula tiene que estar YA colocada: las tarjetas cuyo
        // cartel se midió antes reclaman aquí su altura, sin esperar al onload.
        // Si esto se hace después, la foto sale de una cuadrícula de placeholders
        // y la animación anima el sitio equivocado.
        dimensionarConocidas(gridContainer);
        // El vuelo del arrastre (D-251): con el layout ya asentado, cada
        // superviviente viaja de su posición visual capturada a la nueva y
        // las entrantes funden. Solo hay rects si esto vino de un arrastre.
        if (rectsViejosGaleria && rectsViejosGaleria.size) {
          // El sort del botón conserva su ritmo propio y deliberadamente
          // lento (D-131: ahí el movimiento ES el contenido).
          reproducirFlipGaleria(
            gridContainer, rectsViejosGaleria, entrantesGaleria,
            animacionOrdenLenta ? duracionOrden : FLIP_DUR,
            animacionOrdenLenta ? ORDEN_ANIM_EASE : FLIP_EASE
          );
        }
        // Ordenando desde el botón, el scroll vuelve arriba. Ya NO se llama a
        // nombrarHuecos(true) aquí (D-255): eso era coreografía de la view
        // transition por huecos, y en el camino FLIP habría dejado los
        // nombres `mel-hueco-N` puestos PARA SIEMPRE (quien los restauraba
        // era el `finished` de una transición que ya no se arranca),
        // rompiendo el morph a la ficha. El salto de scroll es instantáneo y
        // los vuelos van en coordenadas de la rejilla (D-252), así que no se
        // contaminan con él.
        if (animacionOrdenLenta) {
          const galeriaScroller = document.getElementById('view-galería');
          if (galeriaScroller) galeriaScroller.scrollTop = 0;
        }
      }
      isFirstDOMUpdate = false;

      // 4. Populate List view (matching the paginated dataset of size 32)
      const listBody = document.getElementById('list-table-body');
      const listTable = listBody ? listBody.closest('table') : null;
      if (listBody) {
        // FLIP reorder animation: record each row's current position (keyed
        // by event id) before wiping the table, so we can slide rows from
        // their old spot to their new one after rebuilding. This uses plain
        // `transform`, not view-transition-name, specifically so it stays
        // contained by the table's own overflow clipping instead of
        // escaping it via the browser's top layer (see the NOTE below on
        // why rows don't carry a view-transition-name).
        const listViewEl = document.getElementById('view-lista');
        const isListVisible = listViewEl && !listViewEl.classList.contains('hidden');
        // Se apuntan las posiciones de las filas de la TABLA y también las de
        // las TARJETAS de móvil. Antes solo se miraba la tabla, así que por
        // debajo de 440px —donde la lista son tarjetas y donde vive el botón de
        // ordenación— no se animaba absolutamente nada: no es que la animación
        // se viera poco, es que no existía.
        const tarjetasLista = document.getElementById('list-mobile-cards-items')
          || document.getElementById('list-mobile-cards');
        // OJO con este mapa (D-252, el "siempre bajan" que veía el
        // propietario): la tabla y las tarjetas móviles comparten los MISMOS
        // idMel y vuelcan aquí juntas — y el contenedor oculto (tabla en
        // móvil, tarjetas en escritorio) devolvía rects de tamaño CERO que
        // machacaban los buenos según el orden de captura. Un delta contra
        // (0,0) hacía que TODA fila pareciera venir de arriba y bajara,
        // quitaras los años que quitaras. Sin caja no hay posición: se salta.
        // Y en RELATIVO a su contenedor, como la galería: un recorte de
        // scroll no debe colarse en los deltas como movimiento de filas.
        const oldRowRects = new Map();
        const capturarFilas = (cont) => {
          if (!cont) return;
          const base = cont.getBoundingClientRect();
          Array.from(cont.children).forEach(fila => {
            if (!fila.dataset || !fila.dataset.id) return;
            const r = fila.getBoundingClientRect();
            if (!r.height) return;
            oldRowRects.set(fila.dataset.id, { top: r.top - base.top });
          });
        };
        if (isListVisible) {
          capturarFilas(listBody);
          capturarFilas(tarjetasLista);
        }

        // Mismo truco que en la galería, y por el mismo motivo: el scroll se pone
        // a cero DESPUÉS de apuntar las posiciones viejas y ANTES de medir las
        // nuevas, así que el desplazamiento del scroll entra dentro del salto que
        // calcula el FLIP y las filas suben reordenándose de una sola vez.
        if (animacionOrdenLenta) {
          const listaScroller = document.getElementById('list-mobile-cards');
          if (listaScroller) listaScroller.scrollTop = 0;
        }

        // El FLIP se reproduce por separado para la tabla y para las tarjetas de
        // móvil, y cada uno JUSTO DESPUÉS de que su contenedor se haya
        // reconstruido. Estuvo escrito de un tirón para los dos, ejecutándose
        // donde se rehace la tabla — que es ANTES de que se rehagan las tarjetas
        // (más abajo, `mobileListItems.innerHTML = ''`). Así que en móvil medía y
        // animaba los nodos VIEJOS, que treinta líneas después se tiraban a la
        // basura. Los transforms se aplicaban de verdad; simplemente no llegaban
        // vivos al siguiente fotograma. Si vuelves a juntar las dos llamadas,
        // vuelve el bug.
        const reproducirFlip = (nodos) => {
          const toPlay = [];
          const aEntrar = [];
          // Misma referencia que la captura: relativa al contenedor (D-252).
          const baseNueva = nodos.length && nodos[0].parentElement
            ? nodos[0].parentElement.getBoundingClientRect() : { top: 0 };
          nodos.forEach((el) => {
            if (!el.dataset || !el.dataset.id) return;
            const oldRect = oldRowRects.get(el.dataset.id);
            if (oldRect) {
              const deltaY = oldRect.top - (el.getBoundingClientRect().top - baseNueva.top);
              if (Math.abs(deltaY) > 1) {
                el.style.transition = 'none';
                el.style.transform = `translateY(${deltaY}px)`;
                toPlay.push(el);
              }
            } else if (oldRowRects.size > 0) {
              // Solo se tratan como "nuevas" cuando hay un render anterior con
              // el que comparar; si no, el primer pintado de la lista repetiría
              // la entrada de todas las filas sin motivo. La entrada es el
              // ESPEJO de la despedida (despliegue + fundido, D-255) — antes
              // era la clase `list-row-intro`, un fundido corto que al lado
              // del pliegue de salida se leía "del tirón".
              if (animacionOrdenLenta) aEntrar.push(el);
