        card.className = 'group content-stretch cursor-pointer flex gap-[16px] items-center pl-[24px] pr-[16px] py-[16px] relative shrink-0 w-full hover:bg-mel-bg-secondary transition-colors duration-200';
        card.innerHTML = buildEventCardListHtml(evt, { showDivider: idx < group.events.length - 1 });

        card.addEventListener('click', () => {
          openDetailsOverlaySPA(evt, group.events);
        });
        listContainer.appendChild(card);
      });
    };

    if (isAlreadyOpen) {
      // Fade out content first, update DOM, and fade back in
      sidePanel.style.opacity = '0';
      setTimeout(() => {
        updateSidePanelDOM();
        sidePanel.style.opacity = '1';
        if (googleMap) {
          googleMap.panTo(group.coords); // panTo animates smoothly on its own
        }
      }, 150);
    } else {
      // Update and open dynamically, pushing the map (desktop) or sliding up
      // as a bottom sheet (móvil, ver media query de #map-side-panel).
      updateSidePanelDOM();
      sidePanel.style.opacity = '1';
      setSidePanelOpenState(true);
      if (googleMap) {
        setTimeout(() => {
          google.maps.event.trigger(googleMap, "resize");
          googleMap.panTo(group.coords);
        }, 310);
      }
    }
  }

  function fitMapToMarkers() {
    if (!googleMap || mapMarkers.length === 0) return;
    const bounds = new google.maps.LatLngBounds();
    mapMarkers.forEach(m => {
      if (m.position) {
        bounds.extend(m.position);
      }
    });

    // A single marker (or several stacked on the same spot) makes a
    // zero-area bounds, which fitBounds() would zoom into as far as it
    // can go. We used to correct that with a one-time 'idle' listener
    // added after the fact — but with searches/filters calling this on
    // every keystroke, several of those could pile up unfired and then
    // all fire together on some later, unrelated zoom (e.g. opening a
    // cluster), stomping it back down to 15. Checking synchronously up
    // front avoids ever needing that listener.
    const ne = bounds.getNorthEast();
    const sw = bounds.getSouthWest();
    if (ne.equals(sw)) {
      googleMap.setCenter(ne);
      googleMap.setZoom(15);
    } else {
      googleMap.fitBounds(bounds);
    }
  }

  // Previously stepped zoom one whole level at a time, waiting ~120ms between
  // each 'zoom_changed' — each step reloaded a fresh set of raster tiles, so
  // it always read as a series of snaps rather than continuous motion. This
  // map's custom Map ID renders as a vector map, which can display *fractional*
  // zoom levels smoothly — so instead we drive the camera every animation
  // frame with an eased, continuously-interpolated zoom (and, optionally,
  // center) between the start and target, which the vector renderer can
  // actually animate. Centering and zooming happen in the SAME loop (instead
  // of a separate panTo() fired first) so the map doesn't jump to the target
  // instantly before the zoom even starts.
  let zoomAnimFrame = null;
  function smoothZoomTo(targetZoom, targetCenter, duration = 550) {
    if (zoomAnimFrame) cancelAnimationFrame(zoomAnimFrame);
    const startZoom = googleMap.getZoom();
    const startCenterObj = googleMap.getCenter();
    const startCenter = { lat: startCenterObj.lat(), lng: startCenterObj.lng() };
    const endCenter = targetCenter
      ? {
          lat: typeof targetCenter.lat === 'function' ? targetCenter.lat() : targetCenter.lat,
          lng: typeof targetCenter.lng === 'function' ? targetCenter.lng() : targetCenter.lng,
        }
      : startCenter;
    const zoomDelta = targetZoom - startZoom;
    const centerDelta = { lat: endCenter.lat - startCenter.lat, lng: endCenter.lng - startCenter.lng };
    if (Math.abs(zoomDelta) < 0.01 && Math.abs(centerDelta.lat) < 1e-9 && Math.abs(centerDelta.lng) < 1e-9) return;
    const startTime = performance.now();
    const ease = t => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2); // ease-in-out-cubic — softer landing than the quad curve used before

    const step = (now) => {
      const t = Math.min(1, (now - startTime) / duration);
      const e = ease(t);
      googleMap.moveCamera({
        center: { lat: startCenter.lat + centerDelta.lat * e, lng: startCenter.lng + centerDelta.lng * e },
        zoom: startZoom + zoomDelta * e,
      });
      // Force the clusterer to re-group against the in-progress viewport on
      // every frame, so members that are far enough apart at the current
      // (still-animating) zoom level visually break out of the bubble as
      // soon as that happens, instead of only once the camera motion fully
      // settles and the map's own 'idle' event fires at the very end.
      if (googleMapClusterer) googleMapClusterer.render();
      zoomAnimFrame = t < 1 ? requestAnimationFrame(step) : null;
    };
    zoomAnimFrame = requestAnimationFrame(step);
  }

  function updateMapMarkers(shouldFitBounds = true) {
    if (!googleMap || !markerLib) return;

    // Kept comfortably above any cluster's zIndex (MAX_ZINDEX + count, where
    // count is a small number of events) so the active marker always renders
    // on top of cluster bubbles too.
    const ACTIVE_MARKER_ZINDEX = Number(google.maps.Marker.MAX_ZINDEX) + 1000000;

    if (infoWindow) infoWindow.close();

    // Get currently filtered archives
    const filtered = archives.filter(item => {
      const yr = getYear(item.fecha);
      const yearMatch = yr >= minYear && yr <= maxYear;
      const searchMatch = !searchQuery || 
        item.evento.toLowerCase().includes(searchQuery) || 
        item.lugar.toLowerCase().includes(searchQuery) ||
        item.localidad.toLowerCase().includes(searchQuery) ||
        item.artistas.toLowerCase().includes(searchQuery) ||
        item.organiza.toLowerCase().includes(searchQuery) ||
        item.disenador.toLowerCase().includes(searchQuery);
      return yearMatch && searchMatch;
    });

    // Group by location key for clustering (using item.coordenadas!)
    const locationGroups = {};
    filtered.forEach(item => {
      const coords = parseCoords(item.coordenadas, item.localidad);
      if (!coords) return;
      // Round coords to group nearby points
      const locKey = `${coords[0].toFixed(4)},${coords[1].toFixed(4)}`;
      if (!locationGroups[locKey]) {
        locationGroups[locKey] = {
          coords: { lat: coords[0], lng: coords[1] },
          locationName: item.lugar || item.localidad || 'León',
          events: []
        };
      }
      locationGroups[locKey].events.push(item);
    });

    // Auto-open side panel if loading with search/location parameter matching a specific place name
    const params = new URLSearchParams(window.location.search);
    const urlView = params.get('view');
    const urlSearch = params.get('search');
    const urlLocation = params.get('location');
    if (urlView === 'mapa' && !activeSidePanelKey) {
      const matchName = (urlLocation || urlSearch || '').toLowerCase().trim();
      if (matchName) {
        const matchKey = Object.keys(locationGroups).find(key => {
          return locationGroups[key].locationName.toLowerCase() === matchName;
        });
        if (matchKey) {
          activeSidePanelKey = matchKey;
        }
      }
    }

    // Update or hide side panel dynamically based on filtered data.
    if (activeSidePanelKey && locationGroups[activeSidePanelKey]) {
      populateSidePanel(locationGroups[activeSidePanelKey]);
    } else {
      activeSidePanelKey = null;
      const sidePanel = document.getElementById('map-side-panel');
      if (sidePanel) {
        setSidePanelOpenState(false);
        if (googleMap) {
          setTimeout(() => {
            google.maps.event.trigger(googleMap, "resize");
          }, 310);
        }
      }
    }

    // Diff against the previous marker set instead of tearing every pin down
    // and rebuilding from scratch: dragging the date slider fires this on
    // every 'input' event, and destroying+recreating all markers each time
    // made them all flash away and reappear just to update a count. Now an
    // existing location's pin is only ever mutated in place (label text,
    // active state) — only locations that actually gained or lost their last
    // matching event are added to or removed from the map.
    const newKeys = new Set(Object.keys(locationGroups));

    const toAddToClusterer = [];
    const toRemoveFromClusterer = [];
    const activeEntries = [];
    const toExit = [];

    for (const [locKey, entry] of locationMarkers) {
      if (!newKeys.has(locKey)) {
        if (entry.inClusterer && googleMapClusterer) toRemoveFromClusterer.push(entry.marker);
        toExit.push(entry);
        locationMarkers.delete(locKey);
      }
    }

    Object.keys(locationGroups).forEach(locKey => {
      const group = locationGroups[locKey];
      const count = group.events.length;
      const isActive = activeSidePanelKey === locKey;
      let entry = locationMarkers.get(locKey);

      if (!entry) {
        const markerContent = document.createElement('div');
        markerContent.className = 'mel-marker-wrapper';
        markerContent.innerHTML = `
          <div class="mel-marker-body text-marker">
            <span class="mel-marker-label"></span>
          </div>
          <div class="mel-marker-pointer"></div>
        `;

        const marker = new markerLib.AdvancedMarkerElement({
          position: group.coords,
          content: markerContent,
          title: group.locationName
        });

        // Add click listener to show the details Side Panel
        marker.addListener("click", () => {
          activeSidePanelKey = locKey;
          // populateSidePanel() itself calls panTo() to smoothly recenter on
          // this marker — no separate zoom change here, just the pan.
          populateSidePanel(group);
          updateMapMarkers(false); // Redraw map to update the active marker's state without resetting bounds!
        });

        entry = { marker, group, inClusterer: false };
        locationMarkers.set(locKey, entry);
      }

      entry.group = group;
      entry.marker.eventCount = count;
      const label = entry.marker.content.querySelector('.mel-marker-label');
      if (label) label.textContent = `${group.locationName} (${count})`;
      entry.marker.content.classList.toggle('active', isActive);

      // The active marker is pulled out of the clusterer entirely and placed
      // directly on the map with a very high zIndex — so it never gets
      // folded back into a cluster bubble on zoom-out, and always renders
      // above every other pin/cluster. Everything else stays managed by the
      // clusterer as usual. The actual map/zIndex assignment for active
      // markers happens in a pass AFTER the clusterer batch calls below —
      // removeMarkers()/addMarkers() reset a marker's own .map internally,
      // which would otherwise clobber this right after we set it.
      if (isActive) {
        if (entry.inClusterer && googleMapClusterer) {
          toRemoveFromClusterer.push(entry.marker);
          entry.inClusterer = false;
        }
        activeEntries.push(entry);
      } else if (!entry.inClusterer) {
        entry.marker.zIndex = null;
        entry.marker.map = null;
        toAddToClusterer.push(entry.marker);
        entry.inClusterer = true;
      }
    });

    if (googleMapClusterer) {
      const topologyChanged = toRemoveFromClusterer.length > 0 || toAddToClusterer.length > 0;
      if (topologyChanged) {
        // A location actually entered or left the clusterer's pool — the
        // library's render() recomputes the whole clustering index from
        // scratch (it's not incremental), so every bubble on screen gets
        // torn down and recreated here, not just the one that changed. That's
        // unavoidable when membership genuinely changes, but see below for
        // the (much more common, e.g. every slider drag tick) case where it
        // doesn't.
        if (toRemoveFromClusterer.length > 0) googleMapClusterer.removeMarkers(toRemoveFromClusterer, true);
        if (toAddToClusterer.length > 0) googleMapClusterer.addMarkers(toAddToClusterer, true);
        googleMapClusterer.render();
      } else {
        // Nothing joined or left any cluster this cycle — only member counts
        // changed (e.g. dragging the date slider while every matching
        // location still has at least one event). Skip render() entirely
        // and just refresh each existing bubble's own number in place, so
        // clusters don't visibly fall apart and reform for no topological
        // reason — only once a cluster actually needs to gain/lose a member.
        (googleMapClusterer.clusters || []).forEach(cluster => {
          if (!cluster.marker || !cluster.markers || cluster.markers.length <= 1) return;
          const sum = cluster.markers.reduce((s, m) => s + (m.eventCount || 1), 0);
          const label = cluster.marker.content && cluster.marker.content.querySelector('.mel-marker-label');
          if (label) label.textContent = String(sum);
        });
      }
    }

    activeEntries.forEach(entry => {
      entry.marker.zIndex = ACTIVE_MARKER_ZINDEX;
      entry.marker.map = googleMap;
    });

    // Markers whose location no longer matches the filter don't just vanish —
    // removeMarkers() above already pulled them out of the clusterer's index,
    // but here we place them directly on the map (bypassing the clusterer) so
    // their own fade-out animation (the .exiting class) actually gets to play
    // before they're removed from the map for good.
    toExit.forEach(entry => {
      entry.marker.zIndex = ACTIVE_MARKER_ZINDEX;
      entry.marker.map = googleMap;
      entry.marker.content.classList.add('exiting');
      setTimeout(() => {
        entry.marker.map = null;
      }, 150);
    });

    mapMarkers = Array.from(locationMarkers.values(), entry => entry.marker);
    _s.mapMarkers = mapMarkers;

    // Auto-fit bounds of the Google Map ONLY if the map view is active/visible
    // and the caller actually wants it (callers that are about to apply
    // their own pan/zoom, e.g. opening or closing a marker's panel, pass
    // false so they don't race against this fit).
    const mapContainer = document.getElementById('view-mapa');
    if (shouldFitBounds && mapContainer && !mapContainer.classList.contains('hidden')) {
      fitMapToMarkers();
    }
  }

  // -------------------------------------------------------
  // initHomePage — re-runs on every astro:page-load
  // -------------------------------------------------------
  function initHomePage() {
    // Let the gallery replay its first-load entrance animation for whichever
    // render actually settles out of the several that happen synchronously
    // below (slider init, the search box's own startup dispatch...) — see
    // the flag's declaration for why this can't just live in
    // bindInitialCardClicks().
    gallerySettled = false;

    // Re-sync local aliases from persisted state
    archives           = _s.archives;
    filtered           = _s.filtered;
    minYear            = _s.minYear;
    maxYear            = _s.maxYear;
    searchQuery        = _s.searchQuery;
    activeSidePanelKey = _s.activeSidePanelKey;
    currentPage        = _s.currentPage;
    currentSortCol     = _s.currentSortCol;
    currentSortDir     = _s.currentSortDir;
    ABSOLUTE_MIN_YEAR  = _s.ABSOLUTE_MIN_YEAR;
    ABSOLUTE_MAX_YEAR  = _s.ABSOLUTE_MAX_YEAR;
    currentDetailGroup   = _s.currentDetailGroup;
    currentCarruselIndex = _s.currentCarruselIndex;
    googleMap          = _s.googleMap;
    mapMarkers         = _s.mapMarkers;
    locationMarkers    = _s.locationMarkers;
    mapInitialized     = _s.mapInitialized;
    mapContainerEl     = _s.mapContainerEl;
    infoWindow         = _s.infoWindow;
    mapCore            = _s.mapCore;
    markerLib          = _s.markerLib;
    googleMapClusterer = _s.googleMapClusterer;
    overlayAutoplayInterval = _s.overlayAutoplayInterval;
    overlayCurrentIndex     = _s.overlayCurrentIndex;

    // Re-query all DOM element refs
    sliderMin  = document.getElementById('slider-min');
    sliderMax  = document.getElementById('slider-max');
    minHandle  = document.getElementById('min-handle');
    maxHandle  = document.getElementById('max-handle');
    minVal     = minHandle ? minHandle.querySelector('span') : null;
    maxVal     = maxHandle ? maxHandle.querySelector('span') : null;
    activeFill = document.getElementById('slider-active-fill');

    lightbox         = document.getElementById('lightbox');
    lightboxImg      = document.getElementById('lightbox-image');
    lightboxTitle    = document.getElementById('lightbox-title');
    lightboxLocation = document.getElementById('lightbox-location');
    lightboxCategory = document.getElementById('lightbox-category');
    lightboxDate     = document.getElementById('lightbox-date');
    closeLightboxBtn = document.getElementById('close-lightbox');

    btnPrevPage      = document.getElementById('btn-prev-page');
    btnNextPage      = document.getElementById('btn-next-page');
    paginationNumbers = document.getElementById('pagination-numbers');

    viewBtns      = document.querySelectorAll('.toggle-btn');
    viewPanels    = document.querySelectorAll('.view-panel');
    activeIndicator = document.getElementById('toggle-active-indicator');

    // Abort any previous window listeners to prevent duplicates across page transitions
    if (window._melAbortCtrl) window._melAbortCtrl.abort();
    window._melAbortCtrl = new AbortController();
    const wSig = window._melAbortCtrl.signal;

    // --- Galería masonry 2.1 (D-015) ---
    // Siembra las claves aleatorias con el orden que ya pintó el servidor
    // (él también baraja): la primera pasada de filtros reproduce ese orden
    // en vez de re-barajar visiblemente lo que ya está en pantalla.
    if (galleryRandomKeys.size === 0) {
      const ssrCards = document.querySelectorAll('#gallery-grid .gallery-item');
      ssrCards.forEach((card, idx) => {
        if (card.dataset.id) galleryRandomKeys.set(card.dataset.id, (idx + 0.5) / ssrCards.length);
      });
    }
    galleryVisibleCount = PAGE_SIZE;

    const galleryViewRoot = document.getElementById('view-galería');
    if (revealObserver) revealObserver.disconnect();
    revealObserver = galleryViewRoot
      ? new IntersectionObserver(handleRevealEntries, { root: galleryViewRoot, rootMargin: '0px 0px 5% 0px', threshold: 0.01 })
      : null;

    if (sentinelObserver) sentinelObserver.disconnect();
    sentinelObserver = null;
    const gallerySentinel = document.getElementById('gallery-sentinel');
    if (galleryViewRoot && gallerySentinel) {
      // rootMargin inferior generoso = precarga: el siguiente lote se pide
      // ~1200px antes de que el usuario llegue al final de la rejilla.
      sentinelObserver = new IntersectionObserver((entries) => {
        if (entries.some(e => e.isIntersecting)) appendGalleryBatch();
      }, { root: galleryViewRoot, rootMargin: '0px 0px 1200px 0px' });
      sentinelObserver.observe(gallerySentinel);
    }

    // Al cambiar el ancho de columna todos los row-span quedan viejos:
    // recalcula en bloque (una sola lectura de ancho, luego solo escrituras),
    // coalescido por rAF para no medir en cada evento de resize.
    let galleryResizePending = false;
    window.addEventListener('resize', () => {
      if (galleryResizePending) return;
      galleryResizePending = true;
      requestAnimationFrame(() => {
        galleryResizePending = false;
        const cards = document.querySelectorAll('#gallery-grid .gallery-item');
        if (!cards.length) return;
        const colWidth = cards[0].clientWidth;
        cards.forEach(card => sizeGalleryCard(card, colWidth));
      });
    }, { signal: wSig });

    // Bind all event listeners
    bindSliderEvents();
    bindLightboxEvents();
    bindPaginationEvents();

    // Listen for lightbox open from map popup buttons
    window.addEventListener('mel-open-lightbox', (e) => {
      const id = e.detail.id;
      const item = archives.find(x => x.idMel === id);
      if (item) openLightbox(item);
    }, { signal: wSig });

    // Listen for view switcher from menu items
    window.addEventListener('mel-switch-view', (e) => {
      switchView(e.detail.view);
    }, { signal: wSig });

    // Keep the map's basemap style in sync with the site's light/dark
    // toggle. setOptions({colorScheme}) updates the property but Google
    // keeps rendering tiles from whichever scheme the map was originally
    // created with — the only way to actually see the other style is to
    // rebuild the Map instance, so do that in place, preserving the
    // current view, and rebuild the markers on it.
    window.addEventListener('mel-color-scheme-change', (e) => {
      if (!googleMap) return;
      const center = googleMap.getCenter();
      const zoom = googleMap.getZoom();
      // createGoogleMapInstance() drops the old markers/locationMarkers
      // itself (a new Map wipes its container, so the old ones are already
      // gone) — updateMapMarkers() then rebuilds every pin fresh on it.
      createGoogleMapInstance(
        e.detail.isDark ? google.maps.ColorScheme.DARK : google.maps.ColorScheme.LIGHT,
        center,
        zoom
      );
      updateMapMarkers(false);
    }, { signal: wSig });

    // Listen for search events
    window.addEventListener('mel-search', (e) => {
      searchQuery = e.detail.query.toLowerCase().trim();
      _s.searchQuery = searchQuery;
      try {
        const url = new URL(window.location.href);
        if (searchQuery) {
          url.searchParams.set('search', searchQuery);
        } else {
          url.searchParams.delete('search');
        }
        window.history.replaceState({}, '', url.toString());
      } catch (err) {
        console.warn("Unable to update URL query params", err);
      }
      currentPage = 1;
      _s.currentPage = 1;
      // La galería vuelve a su primer lote de scroll infinito y arriba
      // (mismo motivo que en updateSlider).
      galleryVisibleCount = PAGE_SIZE;
      const galleryScroller = document.getElementById('view-galería');
      if (galleryScroller) galleryScroller.scrollTop = 0;
      filterArchives(true);
    }, { signal: wSig });

    viewBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const button = e.target.closest('.toggle-btn');
        if (button) switchView(button.dataset.view);
      });
    });

    // Bind close button for the map side panel. Rebound every page load
    // (rather than once inside initGoogleMap()) since the map itself may not
    // get rebuilt on a soft navigation back to this page — but the close
    // button is a fresh DOM node every time and needs its own listener.
    const closePanelBtn = document.getElementById('close-map-side-panel');
    const sidePanel = document.getElementById('map-side-panel');
    if (closePanelBtn && sidePanel) {
      closePanelBtn.addEventListener('click', () => {
        activeSidePanelKey = null;
        _s.activeSidePanelKey = null;
        // Drop ?location= so the auto-open check inside updateMapMarkers()
        // doesn't immediately re-match this same place and pop the panel
        // back open next time it runs.
        try {
          const url = new URL(window.location.href);
          url.searchParams.delete('location');
          window.history.replaceState({}, '', url.toString());
        } catch (e) {}
        setSidePanelOpenState(false);
        if (googleMap) {
          setTimeout(() => {
            google.maps.event.trigger(googleMap, "resize");
          }, 310);
        }
        // Return the closed marker to its resting look (via the same CSS
        // transition already used for hover — no pan/zoom at all, since the
        // user may well have moved around the map independently of this
        // marker) and back into the clusterer pool it was pulled out of
        // while active. updateMapMarkers()'s diff now treats it as any
        // other non-active marker since activeSidePanelKey is cleared.
        updateMapMarkers(false);
      }, { signal: wSig });
    }

    // Tocar el dim (solo existe/es interactivo en móvil, ver su propia
    // media query) cierra el sheet igual que el botón de cerrar.
    const sidePanelBackdrop = document.getElementById('map-side-panel-backdrop');
    if (sidePanelBackdrop && closePanelBtn) {
      sidePanelBackdrop.addEventListener('click', () => closePanelBtn.click(), { signal: wSig });
    }

    // Bottom sheet en móvil: arrastrar el tirador hacia abajo lo cierra
    // (por encima de un umbral) o lo suelta de vuelta a su sitio. Solo
    // actúa bajo el breakpoint md (ver media query de #map-side-panel);
    // en escritorio el tirador ni siquiera es visible.
    const sidePanelHandle = document.getElementById('map-side-panel-handle');
    if (sidePanelHandle && sidePanel) {
      let dragStartY = 0;
      let dragCurrentY = 0;
      let isDragging = false;

      const dragMove = (e) => {
        if (!isDragging) return;
        dragCurrentY = e.touches ? e.touches[0].clientY : e.clientY;
        const delta = Math.max(0, dragCurrentY - dragStartY);
        sidePanel.style.transform = `translate3d(0, ${delta}px, 0)`;
      };
      const dragEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        sidePanel.classList.remove('side-panel-dragging');
        sidePanel.style.transform = '';
        const delta = Math.max(0, dragCurrentY - dragStartY);
        // Umbral de cierre: una cuarta parte del tirón habitual de un sheet.
        if (delta > 120 && closePanelBtn) closePanelBtn.click();
        dragStartY = 0;
        dragCurrentY = 0;
      };
      const dragStart = (e) => {
        if (window.innerWidth >= 768) return; // Bottom sheet solo en móvil
        isDragging = true;
        dragCurrentY = dragStartY = e.touches ? e.touches[0].clientY : e.clientY;
        sidePanel.classList.add('side-panel-dragging');
      };

      sidePanelHandle.addEventListener('touchstart', dragStart, { passive: true, signal: wSig });
      sidePanelHandle.addEventListener('touchmove', dragMove, { passive: true, signal: wSig });
      sidePanelHandle.addEventListener('touchend', dragEnd, { signal: wSig });
      sidePanelHandle.addEventListener('mousedown', dragStart, { signal: wSig });
      window.addEventListener('mousemove', dragMove, { signal: wSig });
      window.addEventListener('mouseup', dragEnd, { signal: wSig });
    }

    // Bind overlay close
    const overlayCloseBtn = document.getElementById('event-details-overlay-close');
    if (overlayCloseBtn) {
      overlayCloseBtn.onclick = () => closeDetailsOverlaySPA(true);
    }

    window.addEventListener('popstate', (e) => {
      const overlay = document.getElementById('event-details-overlay');
      if (overlay && !overlay.classList.contains('hidden')) {
        _s.mapInitialized = false;
        _s.googleMap = null;
        _s.mapMarkers = [];
        _s.infoWindow = null;
        _s.googleMapClusterer = null;
        closeDetailsOverlaySPA(false);
      }
    }, { signal: wSig });

    // Register list table event delegation handler at document level (survives all DOM updates)
    if (!window._melListClickHandlerBound) {
      window._melListClickHandlerBound = true;
      document.addEventListener('click', (e) => {
        const listBody = document.getElementById('list-table-body');
        const mobileCards = document.getElementById('list-mobile-cards');
        const inTable = listBody && listBody.contains(e.target);
        const inMobileCards = mobileCards && mobileCards.contains(e.target);
        if (!inTable && !inMobileCards) return; // Only handle clicks within the list view (table or mobile cards)

        // Mobile: the whole EventCardList row is clickable, same target as
        // the table's thumbnail+title (openLightbox with the full filtered
        // list as carousel context, unlike the map panel's location-scoped
        // openDetailsOverlaySPA).
        if (inMobileCards) {
          const row = e.target.closest('.mobile-event-card-list');
          if (row) {
            e.stopPropagation();
            const id = row.getAttribute('data-id');
            const item = archives.find(x => x.idMel === id);
            if (item) openLightbox(item);
          }
          return;
        }

        let target = e.target;

        // Check if click is on thumbnail image
        if (target.classList.contains('list-img-link') || target.closest('.list-img-link')) {
          e.stopPropagation();
          const img = target.classList.contains('list-img-link') ? target : target.closest('.list-img-link');
          const id = img.getAttribute('data-id');
          const item = archives.find(x => x.idMel === id);
          if (item) openLightbox(item);
          return;
        }

        // Check if click is on title link or its children (span, svg)
        if (target.classList.contains('event-title-link') || target.closest('.event-title-link')) {
          e.stopPropagation();
          const link = target.classList.contains('event-title-link') ? target : target.closest('.event-title-link');
          const id = link.getAttribute('data-id');
          const item = archives.find(x => x.idMel === id);
          if (item) openLightbox(item);
          return;
        }

        // Check if click is on search cell link
        if (target.classList.contains('search-cell-link') || target.closest('.search-cell-link')) {
          e.stopPropagation();
          const link = target.classList.contains('search-cell-link') ? target : target.closest('.search-cell-link');
          const query = link.getAttribute('data-search');
          if (query) {
            window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query } }));
          }
          return;
        }
      });
    }

    // Initialize state and render
    calculateDynamicBounds();
    updateSlider();
    bindInitialCardClicks();
    initSortHeaders();

    // Parse view from URL on load
    const loadParams = new URLSearchParams(window.location.search);
    const viewParam = loadParams.get('view');
    if (viewParam === 'mapa') {
      switchView('mapa');
    } else if (viewParam === 'lista') {
      switchView('lista');
    } else {
      switchView('galería');
    }

    // Deep link: ?detail=MEL-XXXX (the URL the overlay writes while open)
    // re-opens that event's overlay on top of the chosen view, so overlay
    // URLs are fully shareable.
    const detailParam = loadParams.get('detail');
    if (detailParam) {
      const targetEvent = archives.find(x => x.idMel === detailParam);
      const overlayEl = document.getElementById('event-details-overlay');
      if (targetEvent && overlayEl && overlayEl.classList.contains('hidden')) {
        openDetailsOverlaySPA(targetEvent, filtered.length ? filtered : archives);
      }
    }

    // Everything above runs synchronously, including any filterArchives()
    // calls triggered along the way (e.g. the search box's own startup
    // dispatch) — deferring to a macrotask means gallerySettled only flips
    // once all of those have actually happened, so a genuine later render
    // still gets the intro, but a real user interaction afterwards won't.
    // Two filterArchives() calls happen synchronously above (this function's
    // own updateSlider() call, and the search box's own startup dispatch),
    // each wrapped in document.startViewTransition() — starting a second
    // transition while one is still pending defers/supersedes the first, so
    // their performDOMUpdates() callbacks don't necessarily settle in the
    // same tick a plain setTimeout(…, 0) would catch. A short, generous delay
    // covers that without risking a real (much later) user interaction ever
    // seeing gallerySettled still false.
    setTimeout(() => { gallerySettled = true; }, 200);
  }

  // ----------------------------------------------------
  // Fullscreen SPA Event Details Overlay Implementation
  // ----------------------------------------------------

  function makeTagHtml(label, value, href) {
    const isUnknown = !value || value.toLowerCase() === 'desconocido' || value.toLowerCase() === 'no detallados';
    const displayVal = isUnknown ? 'desconocido' : value;

    // The value link/text must never wrap to a second line or bleed past the
    // tag's box — always ellipsis instead (tag-value-link/-text below get
    // matching global CSS for that; see the min-width:0 chain needed to make
    // ellipsis actually work inside nested flex containers).
    return `
      <div class="flex flex-col items-start gap-1 w-full min-w-0 select-none">
        <span class="font-sans text-[13px] font-bold tracking-[1.56px] leading-[16px] uppercase text-mel-text-primary">${label}</span>
        ${(!isUnknown && href)
          ? `<a href="${href}" class="tag-value-link group/tag font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary hover:text-mel-action-primary transition-colors relative inline-flex items-center gap-1 no-underline min-w-0 max-w-full"><span class="tag-value-text relative text-inherit">${displayVal}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover/tag:scale-x-100 transition-transform duration-200 origin-left"></span></span><svg class="w-3 h-3 text-inherit opacity-0 group-hover/tag:opacity-100 transition-all duration-200 transform translate-x-[-4px] group-hover/tag:translate-x-0 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></a>`
          : `<span class="tag-value-text block w-full font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] ${isUnknown ? 'text-mel-text-tertiary' : 'text-mel-text-secondary'}">${displayVal}</span>`
        }
      </div>
    `;
  }

  function renderOverlayEvent(eventItem, panelEvents) {
    // 1. Text & Basic Details (desktop title + its mobile twin above the grid)
    document.getElementById('overlay-event-title').textContent = eventItem.evento;
    const mobileTitle = document.getElementById('overlay-event-title-mobile');
    if (mobileTitle) mobileTitle.textContent = eventItem.evento;
    
    const desc = eventItem.descripcion || '';
    const descContainer = document.getElementById('overlay-description-container');
    const descText = document.getElementById('overlay-event-description');
    if (desc) {
      descText.textContent = desc;
      descContainer.classList.remove('hidden');
    } else {
      descContainer.classList.add('hidden');
    }

    // 2. Sidebar Tags
    const sidebar = document.getElementById('overlay-tags-sidebar');
    sidebar.innerHTML = `
      ${makeTagHtml("Fecha", eventItem.fecha)}
      ${makeTagHtml("Lugar", eventItem.lugar, `/?view=mapa&location=${encodeURIComponent(eventItem.lugar)}`)}
      ${makeTagHtml("Localidad", eventItem.localidad, `/?search=${encodeURIComponent(eventItem.localidad)}`)}
      ${makeTagHtml("Organiza", eventItem.organiza, `/?search=${encodeURIComponent(eventItem.organiza)}`)}
      ${makeTagHtml("Diseño", eventItem.disenador, `/?search=${encodeURIComponent(eventItem.disenador)}`)}
    `;

    // 3. Artists List
    const artistsContainer = document.getElementById('overlay-artists-container');
    const artistsList = document.getElementById('overlay-artists-list');
    if (eventItem.artistas && eventItem.artistas.toLowerCase() !== 'no detallados') {
      artistsContainer.classList.remove('hidden');
      artistsList.innerHTML = eventItem.artistas.split(/[,;\/]+/).map((artist, idx, arr) => {
        const cleanArtist = artist.trim();
        if (!cleanArtist) return '';
        const isLast = idx === arr.length - 1;
        return `
          <span class="inline-flex items-center whitespace-nowrap">
            <a href="/?search=${encodeURIComponent(cleanArtist)}" class="group/art font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary hover:text-mel-action-primary transition-colors relative inline-flex items-center no-underline"><span class="relative inline-block text-inherit">${cleanArtist}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover/art:scale-x-100 transition-transform duration-200 origin-left"></span></span></a>
            ${!isLast ? `<span class="text-mel-text-secondary mr-2 font-serif font-medium text-[15px] leading-[24px] tracking-[0.15px]">,</span>` : ''}
          </span>
        `;
      }).join('');
    } else {
      artistsContainer.classList.add('hidden');
    }

    // 4. Image carousel
    const track = document.getElementById('overlay-carousel-track');
    const imageUrls = eventItem.carruselItems.map(item => extractDriveImage(item.urlDrive)).filter(Boolean);
    
    // Clear any previous interval
    if (overlayAutoplayInterval) {
      clearInterval(overlayAutoplayInterval);
      overlayAutoplayInterval = null;
    }

    track.innerHTML = imageUrls.map(img => `
      <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
        <img src="${img}" alt="${eventItem.evento}" class="w-full h-full object-contain" referrerpolicy="no-referrer" />
      </div>
    `).join('');

    overlayCurrentIndex = 0;
    track.style.transform = `translate3d(0, 0, 0)`;

    // Dots
    const dotsContainer = document.getElementById('overlay-carousel-dots');
    dotsContainer.innerHTML = '';
    
    function updateOverlayCarousel(idx) {
      overlayCurrentIndex = (idx + imageUrls.length) % imageUrls.length;
      track.style.transform = `translate3d(-${overlayCurrentIndex * 100}%, 0, 0)`;
      const dots = dotsContainer.querySelectorAll('.overlay-carousel-dot');
      dots.forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === overlayCurrentIndex ? 'true' : 'false');
      });
    }

    function startOverlayAutoplay() {
      if (overlayAutoplayInterval) clearInterval(overlayAutoplayInterval);
      if (imageUrls.length <= 1) return;
      overlayAutoplayInterval = setInterval(() => {
        updateOverlayCarousel(overlayCurrentIndex + 1);
      }, 5000);
    }

    if (imageUrls.length > 1) {
      imageUrls.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = 'overlay-carousel-dot w-8 h-8 flex items-center justify-center relative cursor-pointer group select-none';
        dot.setAttribute('data-index', idx);
        dot.setAttribute('data-active', idx === 0 ? 'true' : 'false');
        dot.innerHTML = `
          <div class="absolute inset-[4px] border border-mel-action-tertiary transition-all duration-300 opacity-0 scale-75 group-data-[active=true]:opacity-100 group-data-[active=true]:scale-100 pointer-events-none flex items-center justify-center">
            <div class="w-2 h-2 bg-mel-action-tertiary"></div>
          </div>
          <div class="dot-resting w-2 h-2 bg-mel-action-secondary transition-all duration-300 group-hover:w-[6px] group-hover:h-[6px] group-hover:bg-mel-action-primary group-data-[active=true]:opacity-0"></div>
        `;
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          updateOverlayCarousel(idx);
          startOverlayAutoplay();
        });
        dotsContainer.appendChild(dot);
      });
      startOverlayAutoplay();
    }

    // 5. Zoom image visualizer within overlay. The modal is a fixed-size
    // CSS box (Figma 841:40903) and the photo object-contains inside it —
    // no JS sizing off the image's natural dimensions (the old approach
    // both let big photos overflow the screen and leaked one window
    // resize listener per rendered event).
    const carouselMain = document.getElementById('overlay-carousel-main');
    const imageLightbox = document.getElementById('overlay-image-lightbox');
    const lightboxModal = document.getElementById('overlay-lightbox-modal');
    const lightboxTrack = document.getElementById('overlay-lightbox-track');
    const lightboxDotsContainer = document.getElementById('overlay-lightbox-dots');

    lightboxTrack.innerHTML = imageUrls.map(img => `
      <div class="w-full h-full shrink-0 flex items-center justify-center overflow-hidden">
        <img src="${img}" alt="${eventItem.evento}" class="w-full h-full object-contain" referrerpolicy="no-referrer" />
      </div>
    `).join('');

    let lightboxIndex = 0;

    // Same sliding-track transition as the main carousel, but this never autoplays on its own
    function showLightboxImage(idx) {
      if (!imageUrls || imageUrls.length === 0) return;
      lightboxIndex = (idx + imageUrls.length) % imageUrls.length;
      if (lightboxTrack) lightboxTrack.style.transform = `translate3d(-${lightboxIndex * 100}%, 0, 0)`;
      lightboxDotsContainer.querySelectorAll('.overlay-lightbox-dot').forEach((dot, dIdx) => {
        dot.setAttribute('data-active', dIdx === lightboxIndex ? 'true' : 'false');
      });
    }

    // Let the single, page-level keydown listener reach this event's current lightbox state
    window._melState.activeLightbox = {
      showImage: showLightboxImage,
      getIndex: () => lightboxIndex,
    };

    // Bottom padding matches the other sides (pb-8) when there's no pagination row to show —
    // with dots, pb-4 plus their own padding reads as the same visual weight, so it stays
    // smaller there on purpose (mirrors the static logic in event/[id].astro). The dots
    // container itself must also be fully hidden (not just emptied) when there's nothing to
    // show in it — its own pt-4/pb-1 padding still occupies height even with zero children,
    // which is what made the bottom edge read as bigger than the other three sides.
    lightboxModal.classList.toggle('pb-4', imageUrls.length > 1);
    lightboxModal.classList.toggle('pb-8', imageUrls.length <= 1);
    lightboxDotsContainer.classList.toggle('hidden', imageUrls.length <= 1);

    // Rebuild the lightbox pagination for THIS event's images
    lightboxDotsContainer.innerHTML = '';
    if (imageUrls.length > 1) {
      imageUrls.forEach((_, idx) => {
        const dot = document.createElement('div');
        dot.className = 'overlay-lightbox-dot w-8 h-8 flex items-center justify-center relative cursor-pointer group select-none';
        dot.setAttribute('data-index', idx);
        dot.setAttribute('data-active', idx === 0 ? 'true' : 'false');
        dot.innerHTML = `
          <div class="absolute inset-[4px] border border-mel-action-tertiary transition-all duration-300 opacity-0 scale-75 group-data-[active=true]:opacity-100 group-data-[active=true]:scale-100 pointer-events-none flex items-center justify-center">
            <div class="w-2 h-2 bg-mel-action-tertiary"></div>
          </div>
          <div class="dot-resting w-2 h-2 bg-mel-action-secondary transition-all duration-300 group-hover:w-[6px] group-hover:h-[6px] group-hover:bg-mel-action-primary group-data-[active=true]:opacity-0"></div>
        `;
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          showLightboxImage(idx);
        });
        lightboxDotsContainer.appendChild(dot);
      });
    }

    carouselMain.onclick = () => {
      if (overlayAutoplayInterval) clearInterval(overlayAutoplayInterval);
      showLightboxImage(overlayCurrentIndex);
      imageLightbox.classList.remove('hidden');
      setTimeout(() => {
        imageLightbox.classList.remove('opacity-0', 'pointer-events-none');
        imageLightbox.classList.add('opacity-100', 'pointer-events-auto');
        lightboxModal.classList.remove('scale-95');
        lightboxModal.classList.add('scale-100');
      }, 10);
    };

    const closeOverlayLightbox = () => {
      imageLightbox.classList.remove('opacity-100', 'pointer-events-auto');
      imageLightbox.classList.add('opacity-0', 'pointer-events-none');
      lightboxModal.classList.remove('scale-100');
      lightboxModal.classList.add('scale-95');
      setTimeout(() => {
        imageLightbox.classList.add('hidden');
        startOverlayAutoplay();
      }, 300);
    };

    document.getElementById('overlay-lightbox-close').onclick = closeOverlayLightbox;
    imageLightbox.onclick = (e) => {
      if (e.target === imageLightbox) closeOverlayLightbox();
    };

    // 6. Like button
    const likeKey = `mel-like-${eventItem.idMel}`;
    let isLiked = localStorage.getItem(likeKey) === 'true';
    const likeBtn = document.getElementById('overlay-btn-me-presta');
    const updateLikeUI = () => {
      likeBtn.setAttribute('data-active', isLiked ? 'true' : 'false');
    };
    updateLikeUI();
    likeBtn.onclick = () => {
      isLiked = !isLiked;
      localStorage.setItem(likeKey, String(isLiked));
      updateLikeUI();
    };

    // 7. Navigation
    const curIdx = panelEvents.findIndex(x => x.idMel === eventItem.idMel);
    const prevItem = curIdx > 0 ? panelEvents[curIdx - 1] : null;
    const nextItem = curIdx < panelEvents.length - 1 ? panelEvents[curIdx + 1] : null;

    // Lets the page-level keydown listener step to the prev/next event with
    // the arrow keys, same as clicking Anterior/Siguiente.
    window._melState.activeOverlayNav = { prevItem, nextItem, panelEvents };

    const prevNav = document.getElementById('overlay-nav-prev-container');
    const nextNav = document.getElementById('overlay-nav-next-container');

    prevNav.innerHTML = '';
    nextNav.innerHTML = '';

    // Prev/next markup mirrors the real /event/[id] page's TagWithLink +
    // Link combo: sans uppercase label, then a serif (Lora) title in
    // text-secondary that turns action-primary on hover, with the sliding
    // chevron (left-pointing before the text for Anterior, right-pointing
    // after it for Siguiente) and the scaleX underline.
    if (prevItem) {
      const prevBtn = document.createElement('div');
      prevBtn.className = 'w-full max-w-[496px] cursor-pointer group flex flex-col items-end gap-2 select-none';
      prevBtn.innerHTML = `
        <span class="font-sans text-[13px] font-bold tracking-[1.56px] leading-[16px] uppercase text-mel-text-primary">Anterior</span>
        <span class="relative inline-flex items-center gap-1 max-w-full font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary group-hover:text-mel-action-primary transition-colors">
          <svg class="w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[4px] group-hover:translate-x-0 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          <span class="relative inline-block truncate">${prevItem.evento}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span></span>
        </span>
      `;
      prevBtn.addEventListener('click', () => {
        transitionToOverlayEvent(prevItem, panelEvents);
      });
      prevNav.appendChild(prevBtn);
    }

    if (nextItem) {
      const nextBtn = document.createElement('div');
      nextBtn.className = 'w-full max-w-[496px] cursor-pointer group flex flex-col items-start gap-2 select-none';
      nextBtn.innerHTML = `
        <span class="font-sans text-[13px] font-bold tracking-[1.56px] leading-[16px] uppercase text-mel-text-primary">Siguiente</span>
        <span class="relative inline-flex items-center gap-1 max-w-full font-serif font-medium text-[16px] leading-[24px] tracking-[0.16px] text-mel-text-secondary group-hover:text-mel-action-primary transition-colors">
          <span class="relative inline-block truncate">${nextItem.evento}<span class="absolute bottom-0 left-0 right-0 h-[1px] bg-current scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span></span>
          <svg class="w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[-4px] group-hover:translate-x-0 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </span>
      `;
      nextBtn.addEventListener('click', () => {
        transitionToOverlayEvent(nextItem, panelEvents);
      });
      nextNav.appendChild(nextBtn);
    }
  }

  // The overlay works from every context (gallery, list, map panel), so its
  // URL handling is context-neutral: just set/remove a `detail` param on top
  // of whatever the current URL already carries (view, search, location…)
  // instead of the old hardcoded map-flavored URL. replaceState keeps this
  // outside the history stack so Astro's router never gets involved.
  function setDetailParam(idMel) {
    try {
      const url = new URL(window.location.href);
      if (idMel) {
        url.searchParams.set('detail', idMel);
      } else {
        url.searchParams.delete('detail');
      }
      window.history.replaceState(idMel ? { spaDetail: true } : {}, '', url.toString());
    } catch(e){}
  }

  function transitionToOverlayEvent(newEvent, panelEvents) {
    setDetailParam(newEvent.idMel);

    const content = document.getElementById('overlay-details-content');
    if (!content) { renderOverlayEvent(newEvent, panelEvents); return; }

    // Sections that persist in the same slot (title, tags, image, artist
    // list) just get their content rewritten in place — same idea as the map
    // cluster's own count updating directly rather than the whole bubble
    // redrawing — instead of the old blanket 500ms fade-to-blank-and-back.
    // Only the sections whose *visibility* can toggle (description, artists)
    // get a FLIP: if one collapses/expands, whatever comes after glides into
    // its new position instead of snapping.
    const flipEls = ['overlay-description-container', 'overlay-artists-container', 'overlay-btn-me-presta']
      .map(id => document.getElementById(id))
      .filter(Boolean);
    const oldRects = flipEls.map(el => el.getBoundingClientRect());

    // Photo dissolve: snapshot the carousel exactly as it looks right now
    // into a fixed-position clone stacked on top of the real one, let
    // renderOverlayEvent() swap the real carousel to the new event's photo
    // underneath, then fade the snapshot away — so the old photo visibly
    // dissolves into the new one instead of popping.
    const carouselBox = document.getElementById('overlay-carousel-main');
    let dissolveClone = null;
    if (carouselBox) {
      const rect = carouselBox.getBoundingClientRect();
      dissolveClone = carouselBox.cloneNode(true);
      dissolveClone.removeAttribute('id');
      dissolveClone.style.position = 'fixed';
      dissolveClone.style.left = rect.left + 'px';
      dissolveClone.style.top = rect.top + 'px';
      dissolveClone.style.width = rect.width + 'px';
      dissolveClone.style.height = rect.height + 'px';
      dissolveClone.style.margin = '0';
      dissolveClone.style.zIndex = '9999';
      dissolveClone.style.pointerEvents = 'none';
      dissolveClone.style.transition = 'opacity 0.5s ease';
      document.body.appendChild(dissolveClone);
    }

    renderOverlayEvent(newEvent, panelEvents);

    if (dissolveClone) {
      requestAnimationFrame(() => {
        dissolveClone.style.opacity = '0';
        setTimeout(() => { dissolveClone.remove(); }, 520);
      });
    }

    flipEls.forEach((el, i) => {
      const oldRect = oldRects[i];
      const newRect = el.getBoundingClientRect();
      const deltaY = oldRect.top - newRect.top;
      if (Math.abs(deltaY) > 1) {
        el.style.transition = 'none';
        el.style.transform = `translateY(${deltaY}px)`;
        requestAnimationFrame(() => {
          el.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
          el.style.transform = '';
          setTimeout(() => { el.style.transition = ''; el.style.transform = ''; }, 420);
        });
      }
    });
  }

  function openDetailsOverlaySPA(eventItem, panelEvents) {
    document.body.classList.add('overflow-hidden');

    setDetailParam(eventItem.idMel);

    // Show overlay
    const overlay = document.getElementById('event-details-overlay');
    const content = document.getElementById('overlay-details-content');
    if (overlay) {
      overlay.classList.remove('overlay-fading');
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    }
    // Start offset/hidden — renderOverlayEvent() below populates it while
    // still invisible, then the next step reveals it with a settle-in motion
    // shared by all three entry points (gallery card, list row, map panel),
    // since they all funnel through this same function.
    if (content) content.classList.add('overlay-content-enter');

    renderOverlayEvent(eventItem, panelEvents);

    // Double rAF: the first frame just commits the "enter" (offset) state so
    // the browser actually paints it — removing the class immediately after
    // adding it (single frame) risks the two style changes getting coalesced
    // into a no-op, skipping the transition entirely.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (content) content.classList.remove('overlay-content-enter');
      });
    });
  }

  function closeDetailsOverlaySPA(shouldRestoreUrl = true) {
    const overlay = document.getElementById('event-details-overlay');
    const content = document.getElementById('overlay-details-content');

    if (content) content.classList.add('overlay-content-enter');
    if (overlay) overlay.classList.add('overlay-fading');

    if (overlayAutoplayInterval) {
      clearInterval(overlayAutoplayInterval);
      overlayAutoplayInterval = null;
    }

    document.body.classList.remove('overflow-hidden');

    // Dropping just the detail param returns to the exact context the
    // visitor was in (view, search, panel…) — and also covers the
    // deep-link case, where there was no "previous" URL to restore.
    if (shouldRestoreUrl) setDetailParam(null);

    // Let the shrink-and-fade play out before actually hiding the overlay —
    // hiding it immediately would just cut the animation off. Matches the
    // 0.55s transition on #overlay-details-content.
    setTimeout(() => {
      if (overlay) {
        overlay.classList.remove('overlay-fading');
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      }
      if (content) content.classList.remove('overlay-content-enter');
    }, 500);
  }

  // Overlay close buttons are bound in initHomePage()

  // --- List View Sorting and Navigation Actions ---

  window.showLocationOnMap = function(lugarName) {
    switchView('mapa');
    const matchKey = Object.keys(locationGroups).find(key => {
      return locationGroups[key].locationName.toLowerCase() === lugarName.toLowerCase().trim();
    });
    if (matchKey) {
      activeSidePanelKey = matchKey;
      populateSidePanel(locationGroups[matchKey]); // ya añade 'side-panel-open' y opacity
      const group = locationGroups[matchKey];
      if (group && googleMap) {
        googleMap.setCenter(group.coords);
        googleMap.setZoom(15);
      }
    }
  };

  window.searchInListView = function(query) {
    window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query } }));
  };

  function handleSortClick(col) {
    if (currentSortCol === col) {
      currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
    } else {
      currentSortCol = col;
      currentSortDir = 'asc';
    }

    // Update Header Icons UI
    const headers = document.querySelectorAll('.sort-header');
    headers.forEach(h => {
      const hCol = h.dataset.col;
      const iconSpan = h.querySelector('.sort-icon');
      if (hCol === currentSortCol) {
        iconSpan.className = 'sort-icon text-mel-action-primary shrink-0';
        if (currentSortDir === 'asc') {
          iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>`;
        } else {
          iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>`;
        }
      } else {
        iconSpan.className = 'sort-icon text-mel-action-secondary shrink-0';
        iconSpan.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="7 15 12 20 17 15"></polyline><polyline points="7 9 12 4 17 9"></polyline></svg>`;
      }
    });

    // Re-render starting at page 1
    currentPage = 1;
    filterArchives();
  }

  // Initialize sort click listeners
  function initSortHeaders() {
    document.querySelectorAll('.sort-header').forEach(h => {
      h.addEventListener('click', () => {
        handleSortClick(h.dataset.col);
      });
    });
  }

  // -------------------------------------------------------
  // Bootstrap. astro:page-load fires on the initial page load too (the
  // ClientRouter in Layout.astro guarantees it), so it must be the ONLY
  // entry point: calling initHomePage() directly here as well ran it twice
  // per full load, double-binding every element listener — one sort-header
  // click toggled the direction twice (always ending up desc), one
  // pagination click advanced two pages, and every re-render kicked off
  // two overlapping view transitions.
  // -------------------------------------------------------
  document.addEventListener('astro:page-load', initHomePage);
 
</script>
