  let fxNoiseLayer: HTMLElement;
  let playhead: HTMLElement, timelineTrack: HTMLElement, keyframeMarkers: HTMLElement, progress: HTMLElement;
  let tcCurrent: HTMLElement, btnPlayPause: HTMLElement, iconPlay: HTMLElement, iconPause: HTMLElement, lblPlayPause: HTMLElement;
  let addKfTimeBadge: HTMLElement, currentFrameBadge: HTMLElement, btnDeleteKf: HTMLElement;
  let chkAutoKeyframe: HTMLInputElement, chkPreviewMotion: HTMLInputElement;
  let presetButtonsContainer: HTMLElement;

  // Color & Opacity Controls
  let ctrlBgColor: HTMLInputElement, hexBgColor: HTMLInputElement, ctrlBgOpacity: HTMLInputElement;
  let ctrlSubColor: HTMLInputElement, hexSubColor: HTMLInputElement, ctrlSubOpacity: HTMLInputElement;
