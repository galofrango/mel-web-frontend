    },
    {
      id: 'riso',
      name: '2. Riso LED',
      keyframes: [
        { time: 0.0, bgColor: '#fbf7f4', bgOpacity: 100, subColor: '#280a14', subOpacity: 100, cian: { color: '#00e5ff', opacity: 100, blend: 'multiply', bloom: 0, bleed: 4, blur: 0.2, halftone: 60, angle: 15, htSize: 6, htHard: 50 }, yellow: { color: '#ffea00', opacity: 100, blend: 'multiply', bloom: 0, bleed: 6, blur: 0.4, halftone: 65, angle: 0, htSize: 6, htHard: 50 }, magenta: { color: '#ff0077', opacity: 100, blend: 'multiply', bloom: 0, bleed: 3, blur: 0.1, halftone: 60, angle: 75, htSize: 6, htHard: 50 }, crtOpacity: 0, crtSize: 5, scanlineOpacity: 0, paperOpacity: 60, paperType: 'riso', paperScale: 3 },
        { time: 1.2, bgColor: '#0a0812', bgOpacity: 100, subColor: '#ffffff', subOpacity: 100, cian: { color: '#00ffff', opacity: 100, blend: 'screen', bloom: 15, bleed: 1, blur: 0, halftone: 0, angle: 15, htSize: 6, htHard: 50 }, yellow: { color: '#ffff00', opacity: 100, blend: 'screen', bloom: 12, bleed: 1, blur: 0, halftone: 0, angle: 0, htSize: 6, htHard: 50 }, magenta: { color: '#ff00ff', opacity: 100, blend: 'screen', bloom: 15, bleed: 1, blur: 0, halftone: 0, angle: 75, htSize: 6, htHard: 50 }, crtOpacity: 100, crtSize: 5, scanlineOpacity: 0, paperOpacity: 0, paperType: 'riso', paperScale: 3 }
      ]
    },
    {
      id: 'scanline',
