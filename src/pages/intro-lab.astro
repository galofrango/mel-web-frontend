---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Estudio de Animación y Efectos Intro - MEL">
  <!-- Top Navigation & Presets Bar -->
  <header class="fixed top-0 left-0 right-0 z-[400] bg-[#120e14]/90 backdrop-blur-md border-b border-white/10 px-4 py-2 flex flex-wrap items-center justify-between gap-3 text-white text-xs select-none shadow-xl">
    <div class="flex items-center gap-3 overflow-x-auto">
      <div class="flex items-center gap-2 font-bold text-[#ff00ff] tracking-wider uppercase shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-[#00ffff] animate-pulse"></span>
        ESTUDIO DE TIMELINE & FX
      </div>
      <div class="h-4 w-[1px] bg-white/20 shrink-0"></div>
      
      <!-- Dynamic Preset selector buttons -->
      <div class="flex items-center gap-1.5 shrink-0" id="preset-buttons">
        <!-- Rendered dynamically by JS -->
      </div>

      <!-- Snapshot & Rename Buttons -->
      <button id="btn-take-snapshot" title="Guardar nueva versión snapshot" class="px-2.5 py-1 rounded bg-[#00ffff]/20 hover:bg-[#00ffff]/30 text-[#00ffff] border border-[#00ffff]/40 font-bold transition-all flex items-center gap-1 shrink-0">
        <span>📸 Snapshot</span>
      </button>
      <button id="btn-rename-preset" title="Renombrar la versión activa" class="px-2 py-1 rounded bg-white/10 hover:bg-white/20 text-white/80 transition-all text-[11px] shrink-0">
        ✏️ Renombrar
      </button>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <!-- Auto-Keyframe Toggle Switch -->
      <label class="flex items-center gap-1.5 cursor-pointer bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded text-white/90">
        <input type="checkbox" id="chk-auto-keyframe" checked class="accent-[#00ffff]">
        <span class="font-medium text-[11px]">Auto-Keyframe</span>
      </label>

      <!-- Toggle Physical Ascension Motion preview -->
      <label class="flex items-center gap-1.5 cursor-pointer bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded text-white/90">
        <input type="checkbox" id="chk-preview-motion" checked class="accent-[#00ffff]">
        <span class="font-medium text-[11px]">Simular Vuelo</span>
      </label>

      <button id="btn-toggle-panel" class="px-3 py-1 rounded bg-white/10 hover:bg-white/20 transition-all text-white/90 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        Panel de Parámetros
      </button>

      <button id="btn-export-code" class="px-3 py-1 rounded bg-[var(--mel-primitive-le-600)] hover:bg-[var(--mel-primitive-le-500)] text-white font-medium transition-all flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        Copiar JS
      </button>
    </div>
  </header>

  <!-- SVG Filters & Dynamic Halftone Patterns -->
  <svg class="hidden absolute w-0 h-0" aria-hidden="true">
    <defs>
      <!-- Layer Cyan SVG Ink Bleed -->
      <filter id="bleed-cian" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" result="noise" />
        <feDisplacementMap id="disp-cian" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>

      <!-- Layer Yellow SVG Ink Bleed -->
      <filter id="bleed-yellow" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
        <feDisplacementMap id="disp-yellow" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>

      <!-- Layer Magenta SVG Ink Bleed -->
      <filter id="bleed-magenta" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="3" result="noise" />
        <feDisplacementMap id="disp-magenta" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>

      <!-- CSS-IRL Halftone Dot Patterns (updated dynamically by JS) -->
      <pattern id="svg-ht-cian" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(15)">
        <circle id="svg-ht-cian-circle" cx="4" cy="4" r="2" fill="#00ffff" />
      </pattern>
      <pattern id="svg-ht-yellow" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(0)">
        <circle id="svg-ht-yellow-circle" cx="4" cy="4" r="2" fill="#ffff00" />
      </pattern>
      <pattern id="svg-ht-magenta" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(75)">
        <circle id="svg-ht-magenta-circle" cx="4" cy="4" r="2" fill="#ff00ff" />
      </pattern>
    </defs>
  </svg>

  <!-- Animated Film Grain SVG noise filter (global) -->
  <svg class="hidden absolute w-0 h-0" aria-hidden="true">
    <defs>
      <filter id="grain-filter" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence id="grain-turbulence" type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" result="noise"/>
        <feColorMatrix type="saturate" values="0" in="noise" result="gray"/>
        <feBlend mode="overlay" in="SourceGraphic" in2="gray" result="blend"/>
        <feComposite in="blend" in2="SourceGraphic" operator="in"/>
      </filter>
    </defs>
  </svg>



  <!-- Main Canvas Container (Fixed layout matching IntroAnimation) -->
  <div
    id="lab-canvas-overlay"
    class="fixed inset-0 bg-[#f7f3f5] z-[300] flex items-end justify-center overflow-hidden transition-none select-none"
  >
    <!-- Paper Grain Overlay -->
    <div id="fx-paper-layer" class="absolute inset-0 pointer-events-none opacity-40 z-10"></div>

    <!-- Film Grain Noise Overlay (global, above all CMYK layers) -->
    <div id="fx-noise-layer" class="absolute inset-0 pointer-events-none z-40 mix-blend-overlay opacity-0"></div>
    
    <!-- CRT Subpixel Overlay -->
    <div id="fx-crt-layer" class="absolute inset-0 pointer-events-none opacity-0 z-20"></div>

    <!-- Scanline Layer -->
    <div id="fx-scanline-layer" class="absolute inset-0 pointer-events-none opacity-0 z-25 bg-[linear-gradient(0deg,rgba(0,0,0,0.6)_50%,transparent_50%)] bg-[length:100%_4px]"></div>

    <!-- Content Container (Fixed 1440x1024 coordinate system) -->
    <div class="relative w-full max-w-[1440px] h-full max-h-[1024px] aspect-[1440/1024] flex flex-col justify-end p-[7.5%] pb-[140px] md:pb-[160px] z-30">
      
      <div class="flex flex-col items-start w-full">
        
        <!-- Title Layer Container with isolate stacking context -->
        <div id="lab-title-container" class="relative w-full h-[220px] md:h-[420px] cursor-pointer isolate">
          
          <!-- CIAN Layer -->
          <div 
            id="lab-layer-cian"
            class="intro-title-layer absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#00ffff] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply transition-none overflow-visible"
          >
            <!-- Solid Base Text: visibility:hidden so it provides layout but never shows -->
            <div id="lab-layer-cian-base" class="relative z-10 flex flex-col" style="visibility:hidden">
              <span class="block">Memoria</span>
              <span class="block">Electrónica</span>
              <span class="block">Leonesa</span>
            </div>
            <!-- Halftone overlay: no background, no contrast filter — just dots clipped to text -->
            <div id="lab-layer-cian-ht" class="absolute inset-0 z-30 pointer-events-none flex flex-col">
              <div id="lab-layer-cian-ht-dots" class="flex flex-col" style="-webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; background-image:radial-gradient(circle,#00ffff 40%,transparent 41%); background-size:8px 8px;">
                <span class="block">Memoria</span>
                <span class="block">Electrónica</span>
                <span class="block">Leonesa</span>
              </div>
            </div>
          </div>

          <!-- YELLOW Layer -->
          <div 
            id="lab-layer-yellow"
            class="intro-title-layer absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#ffff00] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply transition-none overflow-visible"
          >
            <div id="lab-layer-yellow-base" class="relative z-10 flex flex-col" style="visibility:hidden">
              <span class="block">Memoria</span>
              <span class="block">Electrónica</span>
              <span class="block">Leonesa</span>
            </div>
            <div id="lab-layer-yellow-ht" class="absolute inset-0 z-30 pointer-events-none flex flex-col">
              <div id="lab-layer-yellow-ht-dots" class="flex flex-col" style="-webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; background-image:radial-gradient(circle,#ffff00 40%,transparent 41%); background-size:8px 8px;">
                <span class="block">Memoria</span>
                <span class="block">Electrónica</span>
                <span class="block">Leonesa</span>
              </div>
            </div>
          </div>

          <!-- MAGENTA Layer -->
          <div 
            id="lab-layer-magenta"
            class="intro-title-layer absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#ff00ff] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply transition-none overflow-visible"
          >
            <div id="lab-layer-magenta-base" class="relative z-10 flex flex-col" style="visibility:hidden">
              <span class="block">Memoria</span>
              <span class="block">Electrónica</span>
              <span class="block">
                Leonesa<span id="lab-reg-symbol" class="text-[#981932] text-[0.8em] tracking-[-0.05em] font-sans font-bold relative -top-[0.1em] ml-1">®</span>
              </span>
            </div>
            <div id="lab-layer-magenta-ht" class="absolute inset-0 z-30 pointer-events-none flex flex-col">
              <div id="lab-layer-magenta-ht-dots" class="flex flex-col" style="-webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; background-image:radial-gradient(circle,#ff00ff 40%,transparent 41%); background-size:8px 8px;">
                <span class="block">Memoria</span>
                <span class="block">Electrónica</span>
                <span class="block">
                  Leonesa<span class="text-[#981932] text-[0.8em] tracking-[-0.05em] font-sans font-bold relative -top-[0.1em] ml-1">®</span>
                </span>
              </div>
            </div>
          </div>

        </div>

        <!-- Divider Line -->
        <div
          id="lab-divider"
          class="w-full h-[2px] bg-[#190609] my-[3.3%] transition-none opacity-100 scale-x-100 origin-left"
        ></div>

        <!-- Subtitle Container -->
        <div
          id="lab-subtitle-container"
          class="flex items-center flex-wrap h-[48px] shrink-0 font-sans font-normal text-[4.6vw] md:text-[38px] text-[#190609] tracking-[-0.04em] relative w-full transition-none"
        >
          <!-- Populated dynamically -->
        </div>

      </div>

    </div>
  </div>

  <!-- Parameter Inspector Panel (Right Drawer) -->
  <aside id="inspector-panel" class="fixed top-12 right-0 bottom-32 w-84 md:w-96 bg-[#161219]/95 text-white/90 backdrop-blur-lg border-l border-white/10 z-[450] p-4 overflow-y-auto text-xs space-y-5 shadow-2xl transition-transform duration-300 transform translate-x-0">
    <div class="flex items-center justify-between border-b border-white/10 pb-2">
      <h3 class="font-bold uppercase tracking-wider text-[#00ffff] flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        INSPECTOR DE PARÁMETROS
      </h3>
      <span id="current-frame-badge" class="font-mono bg-white/10 text-[#ffff00] px-2 py-0.5 rounded text-[11px]">t = 0.00s</span>
    </div>

    <!-- Section 1: Global Colors & Timing -->
    <div class="space-y-3">
      <h4 class="font-semibold text-white/70 uppercase tracking-wider text-[10px] border-b border-white/5 pb-1">1. Fondo & Divisoria Generales</h4>
      
      <div class="space-y-2">
        <!-- Background color & HEX input -->
        <div class="p-2 bg-white/5 rounded space-y-1.5">
          <label class="block text-white/70 font-medium text-[11px]">Fondo</label>
          <div class="flex items-center gap-2">
            <input type="color" id="ctrl-bg-color" value="#f7f3f5" class="w-8 h-8 bg-transparent rounded cursor-pointer border border-white/20 shrink-0">
            <input type="text" id="hex-bg-color" value="#f7f3f5" class="w-24 bg-[#241e29] border border-white/20 rounded px-2 py-1 text-white font-mono text-[11px]">
            <div class="flex items-center gap-1.5 flex-1">
              <span class="text-[10px] text-white/50">Op:</span>
              <input type="range" id="ctrl-bg-opacity" min="0" max="100" value="100" class="w-full accent-[#00ffff]">
            </div>
          </div>
        </div>

        <!-- Subtitle/Divider color & HEX input -->
        <div class="p-2 bg-white/5 rounded space-y-1.5">
          <label class="block text-white/70 font-medium text-[11px]">Divisoria & Subtítulo</label>
          <div class="flex items-center gap-2">
            <input type="color" id="ctrl-sub-color" value="#190609" class="w-8 h-8 bg-transparent rounded cursor-pointer border border-white/20 shrink-0">
            <input type="text" id="hex-sub-color" value="#190609" class="w-24 bg-[#241e29] border border-white/20 rounded px-2 py-1 text-white font-mono text-[11px]">
            <div class="flex items-center gap-1.5 flex-1">
              <span class="text-[10px] text-white/50">Op:</span>
              <input type="range" id="ctrl-sub-opacity" min="0" max="100" value="100" class="w-full accent-[#00ffff]">
            </div>
          </div>
        </div>
        
        <!-- Global Noise -->
        <div class="p-2 bg-white/5 rounded space-y-2">
          <label class="block text-white/70 font-medium text-[11px]">Ruido Global (Film Grain)</label>
          <div class="grid grid-cols-2 gap-2 text-[10px]">
            <div>
              <label class="block text-white/50">Opacidad (%)</label>
              <input type="range" id="ctrl-noise-op" min="0" max="100" value="0" class="w-full accent-[#00ffff]">
            </div>
            <div>
              <label class="block text-white/50">Frecuencia / Escala</label>
              <input type="range" id="ctrl-noise-scale" min="0.1" max="5.0" step="0.1" value="0.65" class="w-full accent-[#00ffff]">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 2: Individual Layer Effects (Cian, Yellow, Magenta) + CSS-IRL Halftone & Screen Angles -->
    <div class="space-y-4">
      <h4 class="font-semibold text-white/70 uppercase tracking-wider text-[10px] border-b border-white/5 pb-1 flex items-center justify-between">
        <span>2. Efectos & Halftone CMYK por Capa</span>
        <a href="https://css-irl.info/css-halftone-patterns/" target="_blank" class="text-[#00ffff] hover:underline text-[9px]">Trama CSS-IRL ↗</a>
      </h4>

      <!-- Layer CIAN -->
      <div class="p-3 bg-white/5 rounded-lg space-y-2.5 border border-[#00ffff]/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-1.5">
          <div class="flex items-center gap-2">
            <input type="color" id="ctrl-cian-color" value="#00ffff" class="w-6 h-6 bg-transparent rounded cursor-pointer">
            <input type="text" id="hex-cian-color" value="#00ffff" class="w-20 bg-[#241e29] border border-white/20 rounded px-1.5 py-0.5 text-white font-mono text-[11px]">
            <span class="font-bold text-[#00ffff]">CAPA CIAN</span>
          </div>
          <!-- SOLO Button -->
          <button id="btn-solo-cian" class="solo-btn px-2.5 py-0.5 rounded text-[10px] font-bold border border-[#00ffff]/40 bg-white/5 hover:bg-[#00ffff]/20 text-[#00ffff] transition-all">
            SOLO
          </button>
        </div>

        <div class="grid grid-cols-2 gap-2 text-[10px]">
          <div>
            <label class="block text-white/50 mb-0.5">Modo de Fusión</label>
            <select id="ctrl-cian-blend" class="w-full bg-[#241e29] border border-white/20 rounded px-1.5 py-1 text-white">
              <option value="multiply">multiply</option>
              <option value="screen">screen</option>
              <option value="overlay">overlay</option>
              <option value="plus-lighter">plus-lighter</option>
              <option value="normal">normal</option>
            </select>
          </div>
          <div>
            <label class="block text-white/50 mb-0.5">Opacidad (%)</label>
            <input type="range" id="ctrl-cian-opacity" min="0" max="100" value="100" class="w-full accent-[#00ffff]">
          </div>
        </div>

        <!-- CSS-IRL Halftone Controls for Cyan (Default Angle 15°) -->
        <div class="p-2 bg-black/40 rounded border border-[#00ffff]/30 space-y-1.5 text-[10px]">
          <div class="flex items-center justify-between font-bold text-[#00ffff]">
            <span>Trama Halftone CSS-IRL (Cian)</span>
            <span id="lbl-cian-angle" class="font-mono text-[10px] bg-[#00ffff]/20 px-1.5 py-0.2 rounded">15°</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-white/60 font-medium">Ángulo offset (°)</label>
              <input type="range" id="ctrl-cian-angle" min="0" max="360" value="15" class="w-full accent-[#00ffff]">
            </div>
            <div>
              <label class="block text-white/60 font-medium">Contraste (fuerza punto)</label>
              <input type="range" id="ctrl-cian-halftone" min="0" max="100" value="60" class="w-full accent-[#00ffff]">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-white/60">Tamaño celda (px)</label>
              <input type="range" id="ctrl-cian-ht-size" min="2" max="30" value="8" class="w-full accent-[#00ffff]">
            </div>
            <div>
              <label class="block text-white/60">Núcleo sólido (%)</label>
              <input type="range" id="ctrl-cian-ht-hard" min="5" max="90" value="30" class="w-full accent-[#00ffff]">
            </div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2 text-[10px]">
          <div>
            <label class="block text-white/50">Bloom / Glow</label>
            <input type="range" id="ctrl-cian-bloom" min="0" max="50" value="0" class="w-full accent-[#00ffff]">
          </div>
          <div>
            <label class="block text-white/50">Sangrado</label>
            <input type="range" id="ctrl-cian-bleed" min="0" max="15" step="0.5" value="0" class="w-full accent-[#00ffff]">
          </div>
          <div>
            <label class="block text-white/50">Desenfoque bordes</label>
            <input type="range" id="ctrl-cian-blur" min="0" max="20" step="0.5" value="0" class="w-full accent-[#00ffff]">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2 text-[10px]">
          <div>
            <label class="block text-white/50">Offset X (px)</label>
            <input type="range" id="ctrl-cian-offset-x" min="-24" max="24" value="0" class="w-full accent-[#00ffff]">
          </div>
          <div>
            <label class="block text-white/50">Offset Y (px)</label>
            <input type="range" id="ctrl-cian-offset-y" min="-24" max="24" value="0" class="w-full accent-[#00ffff]">
          </div>
        </div>
      </div>

      <!-- Layer YELLOW -->
      <div class="p-3 bg-white/5 rounded-lg space-y-2.5 border border-[#ffff00]/30">
        <div class="flex items-center justify-between border-b border-white/10 pb-1.5">
          <div class="flex items-center gap-2">
            <input type="color" id="ctrl-yellow-color" value="#ffff00" class="w-6 h-6 bg-transparent rounded cursor-pointer">
            <input type="text" id="hex-yellow-color" value="#ffff00" class="w-20 bg-[#241e29] border border-white/20 rounded px-1.5 py-0.5 text-white font-mono text-[11px]">
            <span class="font-bold text-[#ffff00]">CAPA AMARILLO</span>
          </div>
          <!-- SOLO Button -->
          <button id="btn-solo-yellow" class="solo-btn px-2.5 py-0.5 rounded text-[10px] font-bold border border-[#ffff00]/40 bg-white/5 hover:bg-[#ffff00]/20 text-[#ffff00] transition-all">
            SOLO
          </button>
        </div>

        <div class="grid grid-cols-2 gap-2 text-[10px]">
          <div>
            <label class="block text-white/50 mb-0.5">Modo de Fusión</label>
            <select id="ctrl-yellow-blend" class="w-full bg-[#241e29] border border-white/20 rounded px-1.5 py-1 text-white">
              <option value="multiply">multiply</option>
              <option value="screen">screen</option>
              <option value="overlay">overlay</option>
              <option value="plus-lighter">plus-lighter</option>
              <option value="normal">normal</option>
            </select>
          </div>
          <div>
            <label class="block text-white/50 mb-0.5">Opacidad (%)</label>
            <input type="range" id="ctrl-yellow-opacity" min="0" max="100" value="100" class="w-full accent-[#ffff00]">
          </div>
        </div>

        <!-- CSS-IRL Halftone Controls for Yellow -->
        <div class="p-2 bg-black/40 rounded border border-[#ffff00]/30 space-y-1.5 text-[10px]">
          <div class="flex items-center justify-between font-bold text-[#ffff00]">
            <span>Trama Halftone CSS-IRL (Amarillo)</span>
            <span id="lbl-yellow-angle" class="font-mono text-[10px] bg-[#ffff00]/20 px-1.5 py-0.2 rounded">0°</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-white/60 font-medium">Ángulo offset (°)</label>
              <input type="range" id="ctrl-yellow-angle" min="0" max="360" value="0" class="w-full accent-[#ffff00]">
            </div>
            <div>
              <label class="block text-white/60 font-medium">Contraste (fuerza punto)</label>
              <input type="range" id="ctrl-yellow-halftone" min="0" max="100" value="60" class="w-full accent-[#ffff00]">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
