  function switchPreset(newId: string) {
    if (newId === activePresetId) return;

    savePresetsToStorage();

    activePresetId = newId;
    const found = presetsList.find(p => p.id === newId);
    if (found) {
      activeKeyframes = JSON.parse(JSON.stringify(found.keyframes));
    }

    renderPresetButtons();
    renderKeyframeMarkers();
    seekTo(currentTime);
  }

  function takeSnapshot() {
    savePresetsToStorage();
    const name = prompt("Escribe el nombre para este Snapshot de animación:", `Versión ${presetsList.length + 1}`);
    if (!name || !name.trim()) return;

    const newId = 'snap_' + Date.now();
    const newPreset: Preset = {
      id: newId,
      name: name.trim(),
      keyframes: JSON.parse(JSON.stringify(activeKeyframes))
    };

    presetsList.push(newPreset);
    activePresetId = newId;
    savePresetsToStorage();

    renderPresetButtons();
    renderKeyframeMarkers();
    seekTo(currentTime);
  }

  function renameActivePreset() {
    const found = presetsList.find(p => p.id === activePresetId);
    if (!found) return;

    const newName = prompt("Renombrar esta versión:", found.name);
    if (!newName || !newName.trim()) return;

    found.name = newName.trim();
    savePresetsToStorage();
    renderPresetButtons();
  }

