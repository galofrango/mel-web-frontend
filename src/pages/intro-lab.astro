    bloom: number; // 0 to 50
    bleed: number; // 0 to 15
    blur: number; // 0 to 10
    halftone: number; // 0 to 100 (opacity of halftone)
    angle: number; // Screen Angle in degrees (0 to 360)
    htSize: number; // Dot size in px (2 to 30)
    htHard: number; // Dot hardness % (10 to 90)
    offsetX?: number; // -24 to 24
    offsetY?: number; // -24 to 24
  }

  interface Keyframe {
    time: number; // 0.0s to 3.0s
    bgColor: string;
    bgOpacity: number;
    subColor: string;
    subOpacity: number;
    cian: LayerFX;
    yellow: LayerFX;
    magenta: LayerFX;
    crtOpacity: number;
    crtSize: number;
    scanlineOpacity: number;
    paperOpacity: number;
    paperType: string;
    paperScale: number;
    noiseOpacity?: number; // Global noise opacity 0-100
    noiseScale?: number;   // Global noise scale/frequency 0-10
  }

  interface Preset {
    id: string;
    name: string;
    keyframes: Keyframe[];
  }

  // Initial Presets
  const DEFAULT_PRESETS: Preset[] = [
