  function toggleSolo(layerKey: 'cian' | 'yellow' | 'magenta', btnEl: HTMLElement) {
    soloState[layerKey] = !soloState[layerKey];
    if (soloState[layerKey]) {
      btnEl.classList.add('bg-[#00ffff]', 'text-black', 'border-[#00ffff]');
      btnEl.classList.remove('bg-white/5', 'text-[#00ffff]');
    } else {
      btnEl.classList.remove('bg-[#00ffff]', 'text-black', 'border-[#00ffff]');
      btnEl.classList.add('bg-white/5', 'text-[#00ffff]');
    }
    seekTo(currentTime);
