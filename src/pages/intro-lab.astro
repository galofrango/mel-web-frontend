  let presetsList: Preset[] = loadPresetsFromStorage();
  let activePresetId: string = presetsList[0].id;
  let activeKeyframes: Keyframe[] = JSON.parse(JSON.stringify(presetsList[0].keyframes));

  let currentTime = 0.0;
  const maxTime = 3.0;
  let isPlaying = false;
  let isLooping = true;
  let animReqId: number | null = null;
  let lastTimestamp: number | null = null;

  // Track if user is actively interacting with an input control to avoid sync overwrites
  let isUserInteracting = false;

  // SOLO State
  const soloState = {
    cian: false,
    yellow: false,
    magenta: false
  };

  // DOM elements
  let canvasOverlay: HTMLElement, paperLayer: HTMLElement, crtLayer: HTMLElement, scanlineLayer: HTMLElement;
  let layerCian: HTMLElement, layerYellow: HTMLElement, layerMagenta: HTMLElement, divider: HTMLElement, subContainer: HTMLElement;
