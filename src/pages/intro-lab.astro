  let isDraggingTrack = false;
  let draggingKfIndex: number | null = null;

  function handleTimelineMouseDown(e: MouseEvent) {
    const kfMarker = (e.target as HTMLElement).closest('.kf-marker');
    if (kfMarker) {
      const idxStr = kfMarker.getAttribute('data-kf-idx');
      if (idxStr !== null) {
        draggingKfIndex = parseInt(idxStr, 10);
        return;
      }
    }
    isDraggingTrack = true;
    processTrackSeek(e);
  }

  function handleGlobalMouseMove(e: MouseEvent) {
    if (draggingKfIndex !== null) {
      const rect = timelineTrack.getBoundingClientRect();
      const clickX = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
      const newTime = parseFloat(((clickX / rect.width) * maxTime).toFixed(2));
      
      activeKeyframes[draggingKfIndex].time = newTime;
      activeKeyframes.sort((a, b) => a.time - b.time);
      savePresetsToStorage();
      renderKeyframeMarkers();
      seekTo(newTime);
      return;
    }

    if (isDraggingTrack) {
      processTrackSeek(e);
    }
  }

  function handleGlobalMouseUp() {
    isDraggingTrack = false;
    draggingKfIndex = null;
    isUserInteracting = false;
  }

  function processTrackSeek(e: MouseEvent) {
    const rect = timelineTrack.getBoundingClientRect();
    const clickX = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
    const ratio = clickX / rect.width;
    seekTo(ratio * maxTime);
  }

  function togglePlay() {
    isPlaying = !isPlaying;
    if (isPlaying) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      if (lblPlayPause) lblPlayPause.textContent = 'Pausa (Espacio)';
      lastTimestamp = performance.now();
      animReqId = requestAnimationFrame(playLoop);
    } else {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      if (lblPlayPause) lblPlayPause.textContent = 'Play (Espacio)';
      if (animReqId) cancelAnimationFrame(animReqId);
    }
  }

  function playLoop(timestamp: number) {
    if (!isPlaying) return;
    if (lastTimestamp === null) lastTimestamp = timestamp;
    const delta = (timestamp - lastTimestamp) / 1000;
    lastTimestamp = timestamp;

    currentTime += delta;
    if (currentTime >= maxTime) {
      if (isLooping) {
        currentTime = 0;
      } else {
        currentTime = maxTime;
        togglePlay();
        return;
      }
    }

    seekTo(currentTime);
    animReqId = requestAnimationFrame(playLoop);
  }

  function seekTo(t: number) {
    currentTime = Math.max(0, Math.min(maxTime, t));
    const pct = (currentTime / maxTime) * 100;
    
    if (playhead) playhead.style.left = `${pct}%`;
    if (progress) progress.style.width = `${pct}%`;

    const seconds = Math.floor(currentTime);
    const ms = Math.floor((currentTime % 1) * 100);
    const tcStr = `00:0${seconds}.${ms < 10 ? '0' : ''}${ms}`;
    if (tcCurrent) tcCurrent.textContent = tcStr;
    if (addKfTimeBadge) addKfTimeBadge.textContent = `${currentTime.toFixed(2)}s`;
    if (currentFrameBadge) currentFrameBadge.textContent = `t = ${currentTime.toFixed(2)}s`;

    const state = interpolateKeyframes(currentTime);
    applyStateToCanvas(state, currentTime);

    // Only overwrite UI controls if the user is NOT actively dragging a slider or typing
    if (!isUserInteracting) {
      syncUIFromState(state);
    }

    const exactKfIndex = activeKeyframes.findIndex(k => Math.abs(k.time - currentTime) < 0.05);
    if (exactKfIndex !== -1) {
      btnDeleteKf.classList.remove('hidden');
    } else {
      btnDeleteKf.classList.add('hidden');
    }
  }

  function hexToRgb(hex: string) {
    const c = hex.replace('#', '');
    const num = parseInt(c, 16);
    return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
  }

  function rgbToHex(r: number, g: number, b: number) {
    return '#' + [r, g, b].map(x => Math.round(x).toString(16).padStart(2, '0')).join('');
  }

  function lerpColor(c1: string, c2: string, factor: number) {
    try {
      const rgb1 = hexToRgb(c1);
      const rgb2 = hexToRgb(c2);
      const r = rgb1[0] + (rgb2[0] - rgb1[0]) * factor;
      const g = rgb1[1] + (rgb2[1] - rgb1[1]) * factor;
      const b = rgb1[2] + (rgb2[2] - rgb1[2]) * factor;
      return rgbToHex(r, g, b);
    } catch (e) {
      return c1;
    }
  }

  function lerp(a: number, b: number, factor: number) {
    return a + (b - a) * factor;
  }

  function lerpLayerFX(l1: LayerFX, l2: LayerFX, factor: number): LayerFX {
    return {
      color: lerpColor(l1.color, l2.color, factor),
      opacity: lerp(l1.opacity ?? 100, l2.opacity ?? 100, factor),
      blend: factor < 0.5 ? l1.blend : l2.blend,
      bloom: lerp(l1.bloom, l2.bloom, factor),
      bleed: lerp(l1.bleed, l2.bleed, factor),
      blur: lerp(l1.blur, l2.blur, factor),
      halftone: lerp(l1.halftone ?? 0, l2.halftone ?? 0, factor),
      angle: lerp(l1.angle ?? 0, l2.angle ?? 0, factor),
      htSize: lerp(l1.htSize ?? 8, l2.htSize ?? 8, factor),
      htHard: lerp(l1.htHard ?? 40, l2.htHard ?? 40, factor),
      offsetX: lerp(l1.offsetX ?? 0, l2.offsetX ?? 0, factor),
      offsetY: lerp(l1.offsetY ?? 0, l2.offsetY ?? 0, factor)
    };
  }

  function interpolateKeyframes(t: number): Keyframe {
    const sorted = [...activeKeyframes].sort((a, b) => a.time - b.time);
    
    if (sorted.length === 0) return DEFAULT_PRESETS[0].keyframes[0];
    if (t <= sorted[0].time) return sorted[0];
    if (t >= sorted[sorted.length - 1].time) return sorted[sorted.length - 1];

    let prev = sorted[0];
    let next = sorted[sorted.length - 1];
    for (let i = 0; i < sorted.length - 1; i++) {
      if (t >= sorted[i].time && t <= sorted[i + 1].time) {
        prev = sorted[i];
        next = sorted[i + 1];
        break;
      }
    }

    const duration = next.time - prev.time;
    const factor = duration > 0 ? (t - prev.time) / duration : 0;

    return {
      time: t,
      bgColor: lerpColor(prev.bgColor, next.bgColor, factor),
      bgOpacity: lerp(prev.bgOpacity ?? 100, next.bgOpacity ?? 100, factor),
      subColor: lerpColor(prev.subColor, next.subColor, factor),
      subOpacity: lerp(prev.subOpacity ?? 100, next.subOpacity ?? 100, factor),
      cian: lerpLayerFX(prev.cian, next.cian, factor),
      yellow: lerpLayerFX(prev.yellow, next.yellow, factor),
      magenta: lerpLayerFX(prev.magenta, next.magenta, factor),
      crtOpacity: lerp(prev.crtOpacity, next.crtOpacity, factor),
      crtSize: lerp(prev.crtSize, next.crtSize, factor),
      scanlineOpacity: lerp(prev.scanlineOpacity, next.scanlineOpacity, factor),
      paperOpacity: lerp(prev.paperOpacity, next.paperOpacity, factor),
      paperType: factor < 0.5 ? prev.paperType : next.paperType,
      paperScale: lerp(prev.paperScale, next.paperScale, factor),
      noiseOpacity: lerp(prev.noiseOpacity ?? 0, next.noiseOpacity ?? 0, factor),
      noiseScale: lerp(prev.noiseScale ?? 0.65, next.noiseScale ?? 0.65, factor)
    };
  }

  function cubicEaseIn(p: number) {
    return Math.pow(p, 2.5);
  }

  // CSS-IRL Halftone technique:
  // - htWrapper: background:white + filter:contrast(N) — sharpens soft gradient blobs into discrete dots
  // - htDots child: radial-gradient with soft stops clipped to text via background-clip:text
  //   * htSize = background-size cell in px (dot spacing)
  //   * htHard = inner solid stop % (larger = bigger solid core = larger dot)
  //   * angle = background-position offset to shift grid (approximates screen angle)
  //   * blur on child feathers the already-clipped text mask → smaller dots at letter edges
  function applyLayerHalftone(htWrapperEl: HTMLElement | null, fx: LayerFX) {
    if (!htWrapperEl) return;
    const dotsEl = htWrapperEl.firstElementChild as HTMLElement | null;

    // We need to set background: white for multiply, black for screen/plus-lighter
    // This allows the CSS-IRL contrast filter to work against a solid color,
    // which is then eliminated by the parent layer's blend mode.
    const isDarkBlend = ['screen', 'plus-lighter', 'color-dodge', 'lighten'].includes(fx.blend);
    htWrapperEl.style.backgroundColor = isDarkBlend ? 'black' : 'white';

    // contrast slider (0-100) maps to CSS contrast(1) … contrast(50)
    // At contrast=0 the halftone is invisible (effectively off)
    const contrastVal = Math.max(1, Math.round((fx.halftone ?? 60) / 100 * 50));
    htWrapperEl.style.filter = `contrast(${contrastVal})`;
    // wrapper is always visible — the contrast drives the intensity
    htWrapperEl.style.opacity = '1';

    if (!dotsEl) return;

    const sz = Math.max(3, Math.round(fx.htSize ?? 8));
    // inner solid stop: percentage of the cell radius that is fully opaque
    const stop1Pct = Math.max(5, Math.min(85, fx.htHard ?? 30));
    // outer fade stop: always a bit larger than the inner stop
    const stop2Pct = Math.min(100, stop1Pct + 25);
    const color = fx.color ?? '#00ffff';

    // background-size drives the spacing between dots
    dotsEl.style.backgroundSize = `${sz}px ${sz}px`;
    dotsEl.style.backgroundImage =
      `radial-gradient(circle, ${color} ${stop1Pct}%, transparent ${stop2Pct}%)`;

    // Approximate screen angle via background-position offset:
    // Shift by (angle/360 * sz) on each axis gives a phase offset that
    // rotates the visual perception of the grid at low cost.
    const angleDeg = fx.angle ?? 0;
    const offset = ((angleDeg / 360) * sz).toFixed(2);
    dotsEl.style.backgroundPosition = `${offset}px ${offset}px`;

    // Blur on the dot child: applied AFTER background-clip:text masks to letter shapes.
    // This feathers the hard text edge into a gradient zone, which filter:contrast()
    // on the parent then converts into smaller dots at the periphery — true halftone edge behaviour.
    const blurPx = fx.blur ?? 0;
    dotsEl.style.filter = blurPx > 0 ? `blur(${blurPx}px)` : 'none';
  }

  function applyStateToCanvas(state: Keyframe, t: number) {
    if (canvasOverlay) {
      canvasOverlay.style.backgroundColor = state.bgColor;
      canvasOverlay.style.opacity = `${(state.bgOpacity ?? 100) / 100}`;
    }

    // Apply global paper layer
    if (paperLayer) {
      paperLayer.style.opacity = `${state.paperOpacity / 100}`;
      const scale = Math.round(state.paperScale);
      if (state.paperType === 'halftone') {
        paperLayer.style.backgroundImage = `
          radial-gradient(#000 15%, transparent 16%),
          radial-gradient(#000 15%, transparent 16%),
          repeating-linear-gradient(45deg, rgba(0,0,0,0.03) 0px, rgba(0,0,0,0.03) 2px, transparent 2px, transparent 6px)
        `;
        paperLayer.style.backgroundSize = `${scale}px ${scale}px, ${scale}px ${scale}px, 8px 8px`;
        paperLayer.style.backgroundPosition = `0 0, ${scale/2}px ${scale/2}px, 0 0`;
      } else if (state.paperType === 'riso') {
        paperLayer.style.backgroundImage = `radial-gradient(rgba(40,10,20,0.2) 1px, transparent 0)`;
        paperLayer.style.backgroundSize = `${scale}px ${scale}px`;
      } else if (state.paperType === 'satin') {
        paperLayer.style.backgroundImage = `repeating-radial-gradient(circle at 50% 50%, rgba(0,0,0,0.05) 0, rgba(0,0,0,0.05) 1px, transparent 1px, transparent 4px)`;
        paperLayer.style.backgroundSize = `${scale}px ${scale}px`;
      } else if (state.paperType === 'toner') {
        paperLayer.style.backgroundImage = `radial-gradient(circle at 20% 20%, rgba(0,0,0,0.12) 1px, transparent 1px), radial-gradient(circle at 80% 70%, rgba(0,0,0,0.12) 1px, transparent 1px)`;
        paperLayer.style.backgroundSize = `${scale}px ${scale}px, ${scale+1}px ${scale+1}px`;
      }
    }

    // Apply CRT Layer
    if (crtLayer) {
      crtLayer.style.opacity = `${state.crtOpacity / 100}`;
      const sz = Math.round(state.crtSize);
      crtLayer.style.backgroundImage = `
        linear-gradient(90deg, rgba(255,0,0,0.8) 0px 1px, rgba(0,255,0,0.8) 1px 2px, rgba(0,0,255,0.8) 2px 3px, rgba(0,0,0,0.95) 3px ${sz}px),
        linear-gradient(0deg, rgba(0,0,0,0.4) 50%, rgba(255,255,255,0.05) 50%)
      `;
      crtLayer.style.backgroundSize = `${sz}px 100%, 100% 4px`;
    }

    // Apply Scanline layer
    if (scanlineLayer) {
      scanlineLayer.style.opacity = `${state.scanlineOpacity / 100}`;
    }

    // Apply Global Noise Filter
    if (fxNoiseLayer) {
      fxNoiseLayer.style.opacity = `${(state.noiseOpacity ?? 0) / 100}`;
      const turbulence = document.getElementById('grain-turbulence');
      if (turbulence) {
        turbulence.setAttribute('baseFrequency', `${state.noiseScale ?? 0.65}`);
      }
      if ((state.noiseOpacity ?? 0) > 0) {
        fxNoiseLayer.style.filter = `url(#grain-filter)`;
      } else {
        fxNoiseLayer.style.filter = `none`;
      }
    }

    // Calculate Physical Ascension Flight Y-Positions
    let yellowY = 0, magentaY = 0, cianY = 0, subY = 0, dividerScale = 1, dividerOpacity = (state.subOpacity ?? 100) / 100;
    if (chkPreviewMotion && chkPreviewMotion.checked && t > 0.8) {
      const flightProgress = Math.min(1, (t - 0.8) / 2.2);
      const ease = cubicEaseIn(flightProgress);

      yellowY = -200 * ease;
      magentaY = -165 * ease;
      cianY = -135 * ease;
      subY = -90 * ease;
      dividerScale = Math.max(0, 1 - ease * 1.2);
      dividerOpacity = Math.max(0, ((state.subOpacity ?? 100) / 100) - ease * 1.5);
    }

    // Check SOLO state
    const isAnySolo = soloState.cian || soloState.yellow || soloState.magenta;

    // Apply Layer CIAN: CSS-IRL halftone wrapper drives blur+dots, bloom+bleed on layer
    const isCianVisible = !isAnySolo || soloState.cian;
    const dispCian = document.getElementById('disp-cian');
    if (dispCian) dispCian.setAttribute('scale', `${state.cian.bleed}`);
    applyLayerHalftone(layerCianHt, state.cian);
    
    if (layerCian) {
      layerCian.style.display = isCianVisible ? 'flex' : 'none';
      layerCian.style.color = state.cian.color;
      layerCian.style.opacity = `${(state.cian.opacity ?? 100) / 100}`;
      layerCian.style.mixBlendMode = state.cian.blend;
      const ox = state.cian.offsetX ?? 0;
      const oy = state.cian.offsetY ?? 0;
      layerCian.style.transform = `translate3d(${ox}px, calc(${cianY}vh + ${oy}px), 0)`;
      const bloom = state.cian.bloom > 0 ? `drop-shadow(0 0 ${state.cian.bloom}px ${state.cian.color})` : '';
      const bleed = state.cian.bleed > 0 ? `url(#bleed-cian)` : '';
      layerCian.style.filter = [bloom, bleed].filter(Boolean).join(' ') || 'none';
    }

    // Apply Layer YELLOW: CSS-IRL halftone
    const isYellowVisible = !isAnySolo || soloState.yellow;
    const dispYellow = document.getElementById('disp-yellow');
    if (dispYellow) dispYellow.setAttribute('scale', `${state.yellow.bleed}`);
    applyLayerHalftone(layerYellowHt, state.yellow);

    if (layerYellow) {
      layerYellow.style.display = isYellowVisible ? 'flex' : 'none';
      layerYellow.style.color = state.yellow.color;
      layerYellow.style.opacity = `${(state.yellow.opacity ?? 100) / 100}`;
      layerYellow.style.mixBlendMode = state.yellow.blend;
      const ox = state.yellow.offsetX ?? 0;
      const oy = state.yellow.offsetY ?? 0;
      layerYellow.style.transform = `translate3d(${ox}px, calc(${yellowY}vh + ${oy}px), 0)`;
      const bloom = state.yellow.bloom > 0 ? `drop-shadow(0 0 ${state.yellow.bloom}px ${state.yellow.color})` : '';
      const bleed = state.yellow.bleed > 0 ? `url(#bleed-yellow)` : '';
      layerYellow.style.filter = [bloom, bleed].filter(Boolean).join(' ') || 'none';
    }

    // Apply Layer MAGENTA: CSS-IRL halftone
    const isMagentaVisible = !isAnySolo || soloState.magenta;
    const dispMagenta = document.getElementById('disp-magenta');
    if (dispMagenta) dispMagenta.setAttribute('scale', `${state.magenta.bleed}`);
    applyLayerHalftone(layerMagentaHt, state.magenta);

    if (layerMagenta) {
      layerMagenta.style.display = isMagentaVisible ? 'flex' : 'none';
      layerMagenta.style.color = state.magenta.color;
      layerMagenta.style.opacity = `${(state.magenta.opacity ?? 100) / 100}`;
      layerMagenta.style.mixBlendMode = state.magenta.blend;
      const ox = state.magenta.offsetX ?? 0;
      const oy = state.magenta.offsetY ?? 0;
      layerMagenta.style.transform = `translate3d(${ox}px, calc(${magentaY}vh + ${oy}px), 0)`;
      const bloom = state.magenta.bloom > 0 ? `drop-shadow(0 0 ${state.magenta.bloom}px ${state.magenta.color})` : '';
      const bleed = state.magenta.bleed > 0 ? `url(#bleed-magenta)` : '';
      layerMagenta.style.filter = [bloom, bleed].filter(Boolean).join(' ') || 'none';
    }

    if (divider) {
      divider.style.backgroundColor = state.subColor;
      divider.style.transform = `scaleX(${dividerScale})`;
      divider.style.opacity = `${dividerOpacity}`;
    }

    if (subContainer) {
      subContainer.style.color = state.subColor;
      const words = document.querySelectorAll('.lab-word');
      words.forEach((w, idx) => {
        const wordEl = w as HTMLElement;
        wordEl.style.color = state.subColor;
        
        let wordSubY = subY;
        if (chkPreviewMotion && chkPreviewMotion.checked && t > 0.8 + idx * 0.15) {
          const wProg = Math.min(1, (t - (0.8 + idx * 0.15)) / 2.2);
          wordSubY = -90 * cubicEaseIn(wProg);
        } else if (chkPreviewMotion && chkPreviewMotion.checked && t <= 0.8 + idx * 0.15) {
          wordSubY = 0;
        }
        wordEl.style.transform = `translate3d(0, ${wordSubY}vh, 0)`;
        wordEl.style.opacity = wordSubY < -80 ? '0' : `${(state.subOpacity ?? 100) / 100}`;
      });
    }
  }

  function syncUIFromState(state: Keyframe) {
    if (ctrlBgColor) ctrlBgColor.value = state.bgColor;
    if (hexBgColor) hexBgColor.value = state.bgColor.toUpperCase();
    if (ctrlBgOpacity) ctrlBgOpacity.value = `${state.bgOpacity ?? 100}`;

    if (ctrlSubColor) ctrlSubColor.value = state.subColor;
    if (hexSubColor) hexSubColor.value = state.subColor.toUpperCase();
    if (ctrlSubOpacity) ctrlSubOpacity.value = `${state.subOpacity ?? 100}`;
    
    if (ctrlNoiseOp) ctrlNoiseOp.value = `${state.noiseOpacity ?? 0}`;
    if (ctrlNoiseScale) ctrlNoiseScale.value = `${state.noiseScale ?? 0.65}`;

    // Cian Sync
    if (ctrlCianColor) ctrlCianColor.value = state.cian.color;
    if (hexCianColor) hexCianColor.value = state.cian.color.toUpperCase();
    if (ctrlCianOpacity) ctrlCianOpacity.value = `${state.cian.opacity ?? 100}`;
    if (ctrlCianBlend) ctrlCianBlend.value = state.cian.blend;
    if (ctrlCianBloom) ctrlCianBloom.value = `${state.cian.bloom}`;
    if (ctrlCianBleed) ctrlCianBleed.value = `${state.cian.bleed}`;
    if (ctrlCianBlur) ctrlCianBlur.value = `${state.cian.blur}`;
    if (ctrlCianHalftone) ctrlCianHalftone.value = `${state.cian.halftone ?? 0}`;
    if (ctrlCianAngle) ctrlCianAngle.value = `${state.cian.angle ?? 15}`;
    if (ctrlCianHtSize) ctrlCianHtSize.value = `${state.cian.htSize ?? 8}`;
    if (ctrlCianHtHard) ctrlCianHtHard.value = `${state.cian.htHard ?? 40}`;
    if (ctrlCianOffsetX) ctrlCianOffsetX.value = `${state.cian.offsetX ?? 0}`;
    if (ctrlCianOffsetY) ctrlCianOffsetY.value = `${state.cian.offsetY ?? 0}`;
    if (lblCianAngle) lblCianAngle.textContent = `${Math.round(state.cian.angle ?? 15)}°`;

    // Yellow Sync
    if (ctrlYellowColor) ctrlYellowColor.value = state.yellow.color;
    if (hexYellowColor) hexYellowColor.value = state.yellow.color.toUpperCase();
    if (ctrlYellowOpacity) ctrlYellowOpacity.value = `${state.yellow.opacity ?? 100}`;
    if (ctrlYellowBlend) ctrlYellowBlend.value = state.yellow.blend;
    if (ctrlYellowBloom) ctrlYellowBloom.value = `${state.yellow.bloom}`;
    if (ctrlYellowBleed) ctrlYellowBleed.value = `${state.yellow.bleed}`;
    if (ctrlYellowBlur) ctrlYellowBlur.value = `${state.yellow.blur}`;
    if (ctrlYellowHalftone) ctrlYellowHalftone.value = `${state.yellow.halftone ?? 0}`;
    if (ctrlYellowAngle) ctrlYellowAngle.value = `${state.yellow.angle ?? 0}`;
    if (ctrlYellowHtSize) ctrlYellowHtSize.value = `${state.yellow.htSize ?? 8}`;
    if (ctrlYellowHtHard) ctrlYellowHtHard.value = `${state.yellow.htHard ?? 40}`;
    if (ctrlYellowOffsetX) ctrlYellowOffsetX.value = `${state.yellow.offsetX ?? 0}`;
    if (ctrlYellowOffsetY) ctrlYellowOffsetY.value = `${state.yellow.offsetY ?? 0}`;
    if (lblYellowAngle) lblYellowAngle.textContent = `${Math.round(state.yellow.angle ?? 0)}°`;

    // Magenta Sync
    if (ctrlMagentaColor) ctrlMagentaColor.value = state.magenta.color;
    if (hexMagentaColor) hexMagentaColor.value = state.magenta.color.toUpperCase();
    if (ctrlMagentaOpacity) ctrlMagentaOpacity.value = `${state.magenta.opacity ?? 100}`;
    if (ctrlMagentaBlend) ctrlMagentaBlend.value = state.magenta.blend;
    if (ctrlMagentaBloom) ctrlMagentaBloom.value = `${state.magenta.bloom}`;
    if (ctrlMagentaBleed) ctrlMagentaBleed.value = `${state.magenta.bleed}`;
    if (ctrlMagentaBlur) ctrlMagentaBlur.value = `${state.magenta.blur}`;
    if (ctrlMagentaHalftone) ctrlMagentaHalftone.value = `${state.magenta.halftone ?? 0}`;
    if (ctrlMagentaAngle) ctrlMagentaAngle.value = `${state.magenta.angle ?? 75}`;
    if (ctrlMagentaHtSize) ctrlMagentaHtSize.value = `${state.magenta.htSize ?? 8}`;
    if (ctrlMagentaHtHard) ctrlMagentaHtHard.value = `${state.magenta.htHard ?? 40}`;
    if (ctrlMagentaOffsetX) ctrlMagentaOffsetX.value = `${state.magenta.offsetX ?? 0}`;
    if (ctrlMagentaOffsetY) ctrlMagentaOffsetY.value = `${state.magenta.offsetY ?? 0}`;
    if (lblMagentaAngle) lblMagentaAngle.textContent = `${Math.round(state.magenta.angle ?? 75)}°`;

    if (ctrlCrtOp) ctrlCrtOp.value = `${state.crtOpacity}`;
    if (ctrlCrtSize) ctrlCrtSize.value = `${state.crtSize}`;
    if (ctrlScanlineOp) ctrlScanlineOp.value = `${state.scanlineOpacity}`;
    if (ctrlPaperOp) ctrlPaperOp.value = `${state.paperOpacity}`;
    if (ctrlPaperType) ctrlPaperType.value = state.paperType;
    if (ctrlPaperScale) ctrlPaperScale.value = `${state.paperScale}`;

    const valCrt = document.getElementById('val-crt-op'); if (valCrt) valCrt.textContent = `${Math.round(state.crtOpacity)}%`;
    const valPaper = document.getElementById('val-paper-op'); if (valPaper) valPaper.textContent = `${Math.round(state.paperOpacity)}%`;
  }

  function getUIState(): Keyframe {
    const v = (el: HTMLInputElement | HTMLSelectElement | null) => el?.value ?? '0';
    return {
      time: parseFloat(currentTime.toFixed(2)),
      bgColor: ctrlBgColor?.value ?? '#f7f3f5',
      bgOpacity: parseFloat(v(ctrlBgOpacity)),
      subColor: ctrlSubColor?.value ?? '#190609',
      subOpacity: parseFloat(v(ctrlSubOpacity)),
      cian: {
        color: ctrlCianColor?.value ?? '#00ffff',
        opacity: parseFloat(v(ctrlCianOpacity)),
        blend: v(ctrlCianBlend),
        bloom: parseFloat(v(ctrlCianBloom)),
        bleed: parseFloat(v(ctrlCianBleed)),
        blur: parseFloat(v(ctrlCianBlur)),
        halftone: parseFloat(v(ctrlCianHalftone)),
        angle: parseFloat(v(ctrlCianAngle)),
        htSize: parseFloat(v(ctrlCianHtSize)),
        htHard: parseFloat(v(ctrlCianHtHard)),
        offsetX: parseFloat(v(ctrlCianOffsetX)),
        offsetY: parseFloat(v(ctrlCianOffsetY))
      },
      yellow: {
        color: ctrlYellowColor?.value ?? '#ffff00',
        opacity: parseFloat(v(ctrlYellowOpacity)),
        blend: v(ctrlYellowBlend),
        bloom: parseFloat(v(ctrlYellowBloom)),
        bleed: parseFloat(v(ctrlYellowBleed)),
        blur: parseFloat(v(ctrlYellowBlur)),
        halftone: parseFloat(v(ctrlYellowHalftone)),
        angle: parseFloat(v(ctrlYellowAngle)),
        htSize: parseFloat(v(ctrlYellowHtSize)),
        htHard: parseFloat(v(ctrlYellowHtHard)),
        offsetX: parseFloat(v(ctrlYellowOffsetX)),
        offsetY: parseFloat(v(ctrlYellowOffsetY))
      },
      magenta: {
        color: ctrlMagentaColor?.value ?? '#ff00ff',
        opacity: parseFloat(v(ctrlMagentaOpacity)),
        blend: v(ctrlMagentaBlend),
        bloom: parseFloat(v(ctrlMagentaBloom)),
        bleed: parseFloat(v(ctrlMagentaBleed)),
        blur: parseFloat(v(ctrlMagentaBlur)),
        halftone: parseFloat(v(ctrlMagentaHalftone)),
        angle: parseFloat(v(ctrlMagentaAngle)),
        htSize: parseFloat(v(ctrlMagentaHtSize)),
        htHard: parseFloat(v(ctrlMagentaHtHard)),
        offsetX: parseFloat(v(ctrlMagentaOffsetX)),
        offsetY: parseFloat(v(ctrlMagentaOffsetY))
      },
      crtOpacity: parseFloat(v(ctrlCrtOp)),
      crtSize: parseFloat(v(ctrlCrtSize)),
      scanlineOpacity: parseFloat(v(ctrlScanlineOp)),
      paperOpacity: parseFloat(v(ctrlPaperOp)),
      paperType: v(ctrlPaperType),
      paperScale: parseFloat(v(ctrlPaperScale)),
      noiseOpacity: parseFloat(v(ctrlNoiseOp)),
      noiseScale: parseFloat(v(ctrlNoiseScale))
    };
  }

  function updateFromUIAndAutoKeyframe() {
    const uiState = getUIState();
    applyStateToCanvas(uiState, currentTime);

    if (chkAutoKeyframe && chkAutoKeyframe.checked) {
      const tRounded = parseFloat(currentTime.toFixed(2));
      const idx = activeKeyframes.findIndex(k => Math.abs(k.time - tRounded) < 0.08);
      if (idx !== -1) {
        activeKeyframes[idx] = uiState;
      } else {
        activeKeyframes.push(uiState);
        activeKeyframes.sort((a, b) => a.time - b.time);
      }
      savePresetsToStorage();
      renderKeyframeMarkers();
    }
  }

  function addOrUpdateKeyframeFromUI() {
    const uiState = getUIState();
    const tRounded = parseFloat(currentTime.toFixed(2));
    const idx = activeKeyframes.findIndex(k => Math.abs(k.time - tRounded) < 0.08);
    if (idx !== -1) {
      activeKeyframes[idx] = uiState;
    } else {
      activeKeyframes.push(uiState);
      activeKeyframes.sort((a, b) => a.time - b.time);
    }

    savePresetsToStorage();
    renderKeyframeMarkers();
    seekTo(currentTime);
  }

  function deleteCurrentKeyframe() {
    const idx = activeKeyframes.findIndex(k => Math.abs(k.time - currentTime) < 0.08);
    if (idx !== -1 && activeKeyframes.length > 1) {
      activeKeyframes.splice(idx, 1);
      savePresetsToStorage();
      renderKeyframeMarkers();
      seekTo(currentTime);
    }
  }

  function renderKeyframeMarkers() {
    if (!keyframeMarkers) return;
    keyframeMarkers.innerHTML = activeKeyframes.map((kf, idx) => {
      const pct = (kf.time / maxTime) * 100;
      return `<div class="kf-marker absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-[#00ffff] rotate-45 border border-black cursor-grab active:cursor-grabbing pointer-events-auto shadow-[0_0_6px_#00ffff]" data-kf-idx="${idx}" style="left: calc(${pct}% - 6px);" title="Keyframe t = ${kf.time.toFixed(2)}s (Arrastra para mover)"></div>`;
    }).join('');
  }

  function exportJSConfig() {
    savePresetsToStorage();
    const configStr = JSON.stringify(presetsList, null, 2);
    navigator.clipboard.writeText(configStr).then(() => {
      alert("¡Configuración de Presets y Timeline copiada al portapapeles!\n\n" + configStr);
    });
  }

  document.addEventListener('astro:page-load', initStudio);
</script>

<style>
  .intro-title-layer {
    transform-origin: bottom left;
  }
  .kf-marker:hover {
    transform: translateY(-50%) rotate(45deg) scale(1.3);
  }
</style>
