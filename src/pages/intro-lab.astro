        { time: 1.0, bgColor: '#050508', bgOpacity: 100, subColor: '#ffffff', subOpacity: 100, cian: { color: '#00ffff', opacity: 100, blend: 'screen', bloom: 25, bleed: 0, blur: 0, halftone: 0, angle: 15, htSize: 8, htHard: 40 }, yellow: { color: '#ffff00', opacity: 100, blend: 'screen', bloom: 20, bleed: 0, blur: 0, halftone: 0, angle: 0, htSize: 8, htHard: 40 }, magenta: { color: '#ff00ff', opacity: 100, blend: 'screen', bloom: 25, bleed: 0, blur: 0, halftone: 0, angle: 75, htSize: 8, htHard: 40 }, crtOpacity: 90, crtSize: 4, scanlineOpacity: 20, paperOpacity: 0, paperType: 'halftone', paperScale: 6 }
