---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Estudio Intro V2 (Canvas 2D Engine) - MEL">
  <!-- Top Navigation & Header Bar -->
  <header class="fixed top-0 left-0 right-0 z-[400] bg-[#1c1c1e]/90 backdrop-blur-2xl border-b border-white/[0.08] px-5 h-12 flex items-center justify-between gap-4 text-white text-xs select-none shadow-sm">
    <div class="flex items-center gap-4 overflow-x-auto">
      <!-- Brand -->
      <div class="flex items-center gap-2 font-semibold text-white tracking-wider uppercase text-[11px] shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-[#0a84ff] shadow-[0_0_8px_#0a84ff]"></span>
        MEL Intro Lab V2 (Canvas 2D)
      </div>
      <div class="h-4 w-[1px] bg-white/10 shrink-0"></div>
      
      <!-- Preset Buttons -->
      <div class="flex items-center gap-1.5 shrink-0" id="preset-buttons">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <button id="btn-replay" class="px-3 py-1.5 rounded-md bg-white/10 hover:bg-white/15 text-white font-medium transition-all text-[11px] flex items-center gap-1.5 border border-white/10">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        Reactivar Intro
      </button>

      <a href="/preview-v2" target="_blank" class="px-3.5 py-1.5 rounded-md bg-[#0a84ff] hover:bg-[#0070e0] text-white font-semibold transition-all text-[11px] flex items-center gap-1.5 shadow-sm border border-white/10">
        Previsualizar ↗
      </a>
    </div>
  </header>

  <!-- Canvas Stage Container -->
  <div id="v2-stage-container" class="fixed inset-0 bg-[#f7f3f5] z-[300] flex items-center justify-center overflow-hidden select-none">
    
    <!-- 1440x1024 Aspect Frame -->
    <div class="relative w-full max-w-[1440px] h-full max-h-[1024px] aspect-[1440/1024] flex flex-col justify-end p-[7.5%] pb-[140px] md:pb-[160px] z-30 pointer-events-none">
      
      <!-- Master Title Stage (Canvas 2D) -->
      <div id="lab-title-container" class="relative w-full h-[220px] md:h-[420px] isolate">
        <canvas id="cmyk-canvas" class="absolute inset-0 w-full h-full pointer-events-none"></canvas>
      </div>

      <!-- Line Divider (DOM) -->
      <div
        id="lab-divider"
        class="w-full h-[2px] bg-[#190609] my-[3.3%] opacity-100 scale-x-100 origin-left transition-transform duration-700 ease-out"
      ></div>

      <!-- Subtitle Container (DOM) -->
      <div
        id="lab-subtitle-container"
        class="flex items-center flex-wrap h-[48px] shrink-0 font-['Space_Grotesk'] font-normal text-[4.6vw] md:text-[38px] text-[#190609] tracking-[-0.04em] leading-[48px] relative w-full"
      >
        <!-- Subtitle words populated by JS -->
      </div>

    </div>
  </div>

  <!-- Apple Pro Inspector Sidebar -->
  <aside id="inspector-panel" class="fixed top-12 right-0 bottom-0 w-[320px] md:w-[350px] bg-[#1c1c1e]/95 text-white/90 backdrop-blur-3xl border-l border-white/[0.08] z-[450] p-5 overflow-y-auto shadow-2xl flex flex-col gap-5 [scrollbar-width:thin] [scrollbar-color:#ffffff20_transparent]">
    
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <h3 class="font-semibold text-white/60 tracking-widest text-[10px] uppercase">Inspector Gráfico V2</h3>
      <span class="text-[10px] font-mono text-[#0a84ff] bg-[#0a84ff]/10 px-2 py-0.5 rounded border border-[#0a84ff]/20">Canvas 2D</span>
    </div>

    <!-- Sliders -->
    <div class="space-y-4 text-xs">
      
      <!-- Aberración RGB/CMY -->
      <div class="space-y-1.5 p-3 bg-white/5 rounded-lg border border-white/5">
        <div class="flex justify-between items-center font-medium text-white/80">
          <span>Desplazamiento CMYK</span>
          <span class="font-mono text-[#0a84ff]" id="val-chroma">8.0 px</span>
        </div>
        <input type="range" id="ctrl-chroma" min="0" max="25" step="0.5" value="8" class="w-full accent-[#0a84ff] cursor-pointer">
      </div>

      <!-- Halftone Density -->
      <div class="space-y-1.5 p-3 bg-white/5 rounded-lg border border-white/5">
        <div class="flex justify-between items-center font-medium text-white/80">
          <span>Trama Halftone</span>
          <span class="font-mono text-[#0a84ff]" id="val-halftone">40 %</span>
        </div>
        <input type="range" id="ctrl-halftone" min="0" max="100" step="1" value="40" class="w-full accent-[#0a84ff] cursor-pointer">
      </div>

      <!-- Bloom Glow -->
      <div class="space-y-1.5 p-3 bg-white/5 rounded-lg border border-white/5">
        <div class="flex justify-between items-center font-medium text-white/80">
          <span>Resplandor (Bloom)</span>
          <span class="font-mono text-[#0a84ff]" id="val-bloom">2.0 px</span>
        </div>
        <input type="range" id="ctrl-bloom" min="0" max="15" step="0.5" value="2" class="w-full accent-[#0a84ff] cursor-pointer">
      </div>

      <!-- Film Grain Noise -->
      <div class="space-y-1.5 p-3 bg-white/5 rounded-lg border border-white/5">
        <div class="flex justify-between items-center font-medium text-white/80">
          <span>Ruido Fílmico</span>
          <span class="font-mono text-[#0a84ff]" id="val-noise">15 %</span>
        </div>
        <input type="range" id="ctrl-noise" min="0" max="100" step="1" value="15" class="w-full accent-[#0a84ff] cursor-pointer">
      </div>

      <!-- Scanlines -->
      <div class="space-y-1.5 p-3 bg-white/5 rounded-lg border border-white/5">
        <div class="flex justify-between items-center font-medium text-white/80">
          <span>Scanlines CRT</span>
          <span class="font-mono text-[#0a84ff]" id="val-scanlines">10 %</span>
        </div>
        <input type="range" id="ctrl-scanlines" min="0" max="100" step="1" value="10" class="w-full accent-[#0a84ff] cursor-pointer">
      </div>

      <!-- Glitch -->
      <div class="space-y-1.5 p-3 bg-white/5 rounded-lg border border-white/5">
        <div class="flex justify-between items-center font-medium text-white/80">
          <span>Glitch Puntual</span>
          <span class="font-mono text-[#0a84ff]" id="val-glitch">0 %</span>
        </div>
        <input type="range" id="ctrl-glitch" min="0" max="100" step="1" value="0" class="w-full accent-[#0a84ff] cursor-pointer">
      </div>

    </div>

    <!-- Export Action -->
    <div class="pt-2 border-t border-white/10 mt-auto">
      <button id="btn-export-settings" class="w-full py-2.5 rounded-lg bg-white/10 hover:bg-white/15 text-white font-medium text-xs transition-all flex items-center justify-center gap-2 border border-white/10">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        Guardar Configuración
      </button>
    </div>

  </aside>
</Layout>

<script>
  // ==========================================================================
  // CONFIGURACIÓN Y ESTADO DE INTRO V2 (CANVAS 2D)
  // ==========================================================================
  interface StudioSettings {
    chroma: number;
    halftone: number;
    bloom: number;
    noise: number;
    scanlines: number;
    glitch: number;
  }

  const PRESETS: Record<string, { name: string; settings: StudioSettings }> = {
    cmyk_pure: {
      name: '1. CMYK Puro',
      settings: { chroma: 8, halftone: 35, bloom: 1.5, noise: 12, scanlines: 10, glitch: 0 }
    },
    riso_art: {
      name: '2. Risografía',
      settings: { chroma: 16, halftone: 75, bloom: 0, noise: 30, scanlines: 0, glitch: 0 }
    },
    crt_macro: {
      name: '3. CRT Macro',
      settings: { chroma: 12, halftone: 20, bloom: 6, noise: 25, scanlines: 45, glitch: 15 }
    },
    minimal_apple: {
      name: '4. Minimal Apple',
      settings: { chroma: 3, halftone: 0, bloom: 0, noise: 5, scanlines: 0, glitch: 0 }
    }
  };

  let activePresetKey = 'cmyk_pure';
  let currentSettings: StudioSettings = { ...PRESETS[activePresetKey].settings };

  // LocalStorage Sync
  const saved = localStorage.getItem('mel_intro_v2_settings');
  if (saved) {
    try { currentSettings = { ...currentSettings, ...JSON.parse(saved) }; } catch(e) {}
  }

  // DOM Elements
  const canvas = document.getElementById('cmyk-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
  const container = document.getElementById('lab-title-container')!;
  const subtitleContainer = document.getElementById('lab-subtitle-container')!;

  const ctrlChroma = document.getElementById('ctrl-chroma') as HTMLInputElement;
  const ctrlHalftone = document.getElementById('ctrl-halftone') as HTMLInputElement;
  const ctrlBloom = document.getElementById('ctrl-bloom') as HTMLInputElement;
  const ctrlNoise = document.getElementById('ctrl-noise') as HTMLInputElement;
  const ctrlScanlines = document.getElementById('ctrl-scanlines') as HTMLInputElement;
  const ctrlGlitch = document.getElementById('ctrl-glitch') as HTMLInputElement;

  // Subtitle Setup (Animación palabra a palabra)
  const subtitleText = "A través del diseño gráfico";
  const words = subtitleText.split(' ');
  subtitleContainer.innerHTML = words.map((w, i) => `
    <span class="subtitle-word inline-block opacity-0 translate-y-4 transition-all duration-500 ease-out mr-[0.3em]" style="transition-delay: ${i * 120 + 400}ms">
      ${w}
    </span>
  `).join('');

  function triggerSubtitleAnimation() {
    subtitleContainer.querySelectorAll('.subtitle-word').forEach(el => {
      el.classList.remove('opacity-0', 'translate-y-4');
    });
  }

  // Render Loop & Physics Time
  let startTime = performance.now();
  
  function resizeCanvas() {
    const rect = container.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  // Canvas Text Drawing Helper
  function drawTextLayer(
    layerCtx: CanvasRenderingContext2D,
    textLines: string[],
    color: string,
    offsetX: number,
    offsetY: number,
    progress: number,
    fontSize: number,
    lineHeight: number,
    htDensity: number
  ) {
    const dpr = window.devicePixelRatio || 1;
    const scaledFontSize = fontSize * dpr;
    const scaledLineHeight = lineHeight * dpr;

    layerCtx.save();
    layerCtx.font = `bold ${scaledFontSize}px "Space Grotesk", sans-serif`;
    layerCtx.letterSpacing = `${-8 * dpr}px`;
    layerCtx.textAlign = 'left';
    layerCtx.textBaseline = 'top';

    const startY = (1 - progress) * (scaledFontSize * 0.8); // Entrance mask from bottom

    textLines.forEach((line, idx) => {
      const y = idx * scaledLineHeight + startY + (offsetY * dpr);
      const x = offsetX * dpr;

      // Draw Main Solid Text
      layerCtx.fillStyle = color;
      layerCtx.fillText(line, x, y);

      // Draw Registered Symbol on Leonesa
      if (line.includes("Leonesa")) {
        const textWidth = layerCtx.measureText("Leonesa").width;
        layerCtx.save();
        layerCtx.font = `bold ${scaledFontSize * 0.4}px "Space Grotesk", sans-serif`;
        layerCtx.fillText("®", x + textWidth + (10 * dpr), y);
        layerCtx.restore();
      }
    });

    // Halftone Overlay Pattern Clipping
    if (htDensity > 0) {
      layerCtx.globalCompositeOperation = 'destination-out';
      const patternCanvas = document.createElement('canvas');
      const patternSize = Math.max(4, Math.floor(12 - (htDensity / 10))) * dpr;
      patternCanvas.width = patternSize;
      patternCanvas.height = patternSize;
      const pCtx = patternCanvas.getContext('2d')!;
      pCtx.fillStyle = '#000000';
      pCtx.beginPath();
      pCtx.arc(patternSize / 2, patternSize / 2, patternSize * 0.35 * (htDensity / 100), 0, Math.PI * 2);
      pCtx.fill();

      const pattern = layerCtx.createPattern(patternCanvas, 'repeat');
      if (pattern) {
        layerCtx.fillStyle = pattern;
        layerCtx.fillRect(0, 0, layerCtx.canvas.width, layerCtx.canvas.height);
      }
    }

    layerCtx.restore();
  }

  function render() {
    requestAnimationFrame(render);
    const now = performance.now();
    const elapsed = (now - startTime) / 1000;
    
    // Physics Ascension Ease-In Curve (2100ms duration)
    const animDuration = 2.1;
    const rawProgress = Math.min(1, elapsed / animDuration);
    const progress = Math.pow(rawProgress, 2.5);

    if (rawProgress >= 0.3) {
      triggerSubtitleAnimation();
    }

    const width = canvas.width;
    const height = canvas.height;
    const dpr = window.devicePixelRatio || 1;

    // Clear Canvas
    ctx.clearRect(0, 0, width, height);

    // Calculate Dynamic Font Size
    const isMobile = window.innerWidth < 768;
    const fontSize = isMobile ? window.innerWidth * 0.138 : 190;
    const lineHeight = fontSize * 0.82;
    const lines = ["Memoria", "Electrónica", "Leonesa"];

    const chroma = currentSettings.chroma;
    const bloom = currentSettings.bloom;
    const glitch = currentSettings.glitch;

    // Glitch Random Jitter
    let glitchX = 0;
    if (glitch > 0 && Math.random() < (glitch / 100) * 0.3) {
      glitchX = (Math.random() - 0.5) * 20;
    }

    // LAYER 1: CIAN (Cyan #00ffff - Static 0px offset)
    const cianCanvas = document.createElement('canvas');
    cianCanvas.width = width; cianCanvas.height = height;
    const cianCtx = cianCanvas.getContext('2d')!;
    drawTextLayer(cianCtx, lines, '#00ffff', glitchX, 0, progress, fontSize, lineHeight, currentSettings.halftone);

    // LAYER 2: YELLOW (Yellow #ffff00 - Max 16px offset)
    const yellowCanvas = document.createElement('canvas');
    yellowCanvas.width = width; yellowCanvas.height = height;
    const yellowCtx = yellowCanvas.getContext('2d')!;
    const yellowX = glitchX - (chroma * 1.5 * progress);
    const yellowY = -(chroma * 0.8 * progress);
    drawTextLayer(yellowCtx, lines, '#ffff00', yellowX, yellowY, progress, fontSize, lineHeight, currentSettings.halftone);

    // LAYER 3: MAGENTA (Magenta #ff00ff - Max 8px offset)
    const magentaCanvas = document.createElement('canvas');
    magentaCanvas.width = width; magentaCanvas.height = height;
    const magentaCtx = magentaCanvas.getContext('2d')!;
    const magentaX = glitchX + (chroma * 0.8 * progress);
    const magentaY = -(chroma * 0.4 * progress);
    drawTextLayer(magentaCtx, lines, '#ff00ff', magentaX, magentaY, progress, fontSize, lineHeight, currentSettings.halftone);

    // Composite Layers with Multiply Blend Mode
    ctx.save();
    ctx.globalCompositeOperation = 'multiply';
    ctx.drawImage(cianCanvas, 0, 0);
    ctx.drawImage(yellowCanvas, 0, 0);
    ctx.drawImage(magentaCanvas, 0, 0);
    ctx.restore();

    // Bloom Resplandor Overlay
    if (bloom > 0) {
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.filter = `blur(${bloom * dpr}px)`;
      ctx.globalAlpha = 0.3;
      ctx.drawImage(cianCanvas, 0, 0);
      ctx.drawImage(magentaCanvas, 0, 0);
      ctx.restore();
    }

    // Global Noise & Scanlines Overlay
    const noise = currentSettings.noise;
    const scanlines = currentSettings.scanlines;

    if (noise > 0 || scanlines > 0) {
      ctx.save();
      if (scanlines > 0) {
        ctx.fillStyle = `rgba(0, 0, 0, ${ (scanlines / 100) * 0.15 })`;
        for (let y = 0; y < height; y += 4 * dpr) {
          ctx.fillRect(0, y, width, 2 * dpr);
        }
      }
      if (noise > 0) {
        const imgData = ctx.getImageData(0, 0, width, height);
        const data = imgData.data;
        const amount = (noise / 100) * 25;
        for (let i = 0; i < data.length; i += 16) {
          const n = (Math.random() - 0.5) * amount;
          data[i] = Math.min(255, Math.max(0, data[i] + n));
          data[i+1] = Math.min(255, Math.max(0, data[i+1] + n));
          data[i+2] = Math.min(255, Math.max(0, data[i+2] + n));
        }
        ctx.putImageData(imgData, 0, 0);
      }
      ctx.restore();
    }
  }

  requestAnimationFrame(render);

  // Bind UI Controls
  function updateFromUI() {
    currentSettings.chroma = parseFloat(ctrlChroma.value);
    currentSettings.halftone = parseFloat(ctrlHalftone.value);
    currentSettings.bloom = parseFloat(ctrlBloom.value);
    currentSettings.noise = parseFloat(ctrlNoise.value);
    currentSettings.scanlines = parseFloat(ctrlScanlines.value);
    currentSettings.glitch = parseFloat(ctrlGlitch.value);

    document.getElementById('val-chroma')!.textContent = `${currentSettings.chroma.toFixed(1)} px`;
    document.getElementById('val-halftone')!.textContent = `${currentSettings.halftone} %`;
    document.getElementById('val-bloom')!.textContent = `${currentSettings.bloom.toFixed(1)} px`;
    document.getElementById('val-noise')!.textContent = `${currentSettings.noise} %`;
    document.getElementById('val-scanlines')!.textContent = `${currentSettings.scanlines} %`;
    document.getElementById('val-glitch')!.textContent = `${currentSettings.glitch} %`;

    localStorage.setItem('mel_intro_v2_settings', JSON.stringify(currentSettings));
  }

  [ctrlChroma, ctrlHalftone, ctrlBloom, ctrlNoise, ctrlScanlines, ctrlGlitch].forEach(input => {
    input.addEventListener('input', updateFromUI);
  });

  // Replay Trigger
  document.getElementById('btn-replay')?.addEventListener('click', () => {
    startTime = performance.now();
    subtitleContainer.querySelectorAll('.subtitle-word').forEach(el => {
      el.classList.add('opacity-0', 'translate-y-4');
    });
  });

  // Presets Render
  const presetBtnContainer = document.getElementById('preset-buttons')!;
  function renderPresetsUI() {
    presetBtnContainer.innerHTML = Object.entries(PRESETS).map(([key, p]) => {
      const isActive = key === activePresetKey;
      return `<button data-preset="${key}" class="px-2.5 py-1 rounded-md text-[11px] font-medium transition-all ${
        isActive ? 'bg-[#0a84ff] text-white shadow-sm font-semibold' : 'bg-white/5 hover:bg-white/10 text-white/60 hover:text-white border border-white/10'
      }">${p.name}</button>`;
    }).join('');

    presetBtnContainer.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const k = btn.getAttribute('data-preset')!;
        activePresetKey = k;
        currentSettings = { ...PRESETS[k].settings };
        ctrlChroma.value = currentSettings.chroma.toString();
        ctrlHalftone.value = currentSettings.halftone.toString();
        ctrlBloom.value = currentSettings.bloom.toString();
        ctrlNoise.value = currentSettings.noise.toString();
        ctrlScanlines.value = currentSettings.scanlines.toString();
        ctrlGlitch.value = currentSettings.glitch.toString();
        updateFromUI();
        renderPresetsUI();
      });
    });
  }
  renderPresetsUI();

  document.getElementById('btn-export-settings')?.addEventListener('click', () => {
    navigator.clipboard.writeText(JSON.stringify(currentSettings, null, 2));
    alert('Configuración copiada al portapapeles');
  });

</script>
