---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MEL GL Lab - Editor Avanzado (Híbrido)">
  <!-- Top Navigation & Presets Bar -->
  <header class="fixed top-0 left-0 right-0 z-[400] bg-[#1c1c1e]/90 backdrop-blur-2xl border-b border-white/10 px-5 py-0 h-14 flex items-center justify-between gap-4 text-white text-xs select-none shadow-sm">
    <div class="flex items-center gap-4 overflow-x-auto">
      <div class="flex items-center gap-2 font-semibold text-white/90 tracking-widest uppercase text-[11px] shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-[#0a84ff]"></span>
        MEL GL Lab
      </div>
      <div class="h-5 w-[1px] bg-white/10 shrink-0"></div>
      
      <div class="flex items-center gap-1.5 shrink-0" id="preset-buttons">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>

    <div class="flex items-center gap-4 shrink-0">
      <label class="flex items-center gap-1.5 cursor-pointer text-white/70 hover:text-white transition-colors">
        <input type="checkbox" id="chk-auto-keyframe" checked class="w-3.5 h-3.5 accent-[#0a84ff]">
        <span class="text-[11px] font-medium">Auto-KF</span>
      </label>

      <div class="h-5 w-[1px] bg-white/10"></div>

      <a href="/preview-gl" target="_blank" class="px-3 py-1.5 rounded-md bg-white/10 hover:bg-white/20 text-white font-medium transition-all flex items-center gap-1.5 text-[11px] border border-white/10">
        Previsualizar ↗
      </a>
      <button id="btn-export-code" class="px-3 py-1.5 rounded-md bg-[#0a84ff]/20 hover:bg-[#0a84ff]/30 text-[#0a84ff] font-medium transition-all flex items-center gap-1.5 text-[11px] border border-[#0a84ff]/30">
        Copiar JS
      </button>
    </div>
  </header>

  <!-- HÍBRIDO DOM + WEBGL: Maqueta estructural original -->
  <div class="fixed inset-0 bg-[#f7f3f5] z-[300] flex items-end justify-center overflow-hidden select-none" id="main-bg-container">
    
    <!-- Contenedor Maestro (1440x1024) -->
    <div class="relative w-full max-w-[1440px] h-full max-h-[1024px] aspect-[1440/1024] flex flex-col justify-end p-[7.5%] pb-[140px] md:pb-[160px] z-30">
      
      <div class="flex flex-col items-start w-full">
        
        <!-- Título: Canvas WebGL con mix-blend-multiply -->
        <div id="lab-title-container" class="relative w-full h-[220px] md:h-[420px] isolate pointer-events-none">
          <!-- WebGL canvas desborda un poco para evitar cortar los efectos de Bloom/Glitch -->
          <canvas id="gl-canvas" class="absolute left-[-5%] top-[-10%] w-[110%] h-[120%] pointer-events-none mix-blend-multiply"></canvas>
          <canvas id="text-canvas" class="hidden"></canvas>
        </div>

        <!-- Línea Divisoria (DOM) -->
        <div
          id="lab-divider"
          class="w-full h-[2px] bg-[#190609] my-[3.3%] opacity-100 scale-x-100 origin-left"
        ></div>

        <!-- Subtítulo (DOM) -->
        <div
          id="lab-subtitle-container"
          class="flex items-center flex-wrap h-[48px] shrink-0 font-['Space_Grotesk'] font-normal text-[4.6vw] md:text-[38px] text-[#190609] tracking-[-0.04em] leading-[48px] relative w-full"
        >
        </div>

      </div>

    </div>
  </div>

  <!-- Inspector Apple Pro Panel -->
  <aside id="inspector-panel" class="fixed top-14 right-0 bottom-[148px] w-[340px] bg-[#1c1c1e]/90 text-white/90 backdrop-blur-3xl border-l border-white/[0.08] z-[450] p-5 overflow-y-auto shadow-2xl flex flex-col gap-6 [scrollbar-width:thin] [scrollbar-color:#ffffff20_transparent]">
    
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <h3 class="font-semibold text-white/50 tracking-widest text-[10px] uppercase">Inspector Gráfico</h3>
      <span id="current-frame-badge" class="font-mono bg-black/30 border border-white/10 text-[#0a84ff] px-2 py-1 rounded md text-[11px] tabular-nums font-medium shadow-inner">t = 0.00s</span>
    </div>

    <!-- Sliders Form -->
    <div class="space-y-5">
      
      <div class="space-y-1.5">
        <div class="flex justify-between items-center text-[11px] font-medium text-white/80">
          <span>Aberración RGB</span>
          <span class="font-mono text-[#0a84ff] value-display" data-display="chroma">0.00</span>
        </div>
        <input type="range" data-slider="chroma" min="0" max="20" step="0.1" class="w-full accent-[#0a84ff]">
      </div>

      <div class="space-y-1.5">
        <div class="flex justify-between items-center text-[11px] font-medium text-white/80">
          <span>Bloom (Iluminación Global)</span>
          <span class="font-mono text-[#0a84ff] value-display" data-display="bloom">0.00</span>
        </div>
        <input type="range" data-slider="bloom" min="0" max="15" step="0.1" class="w-full accent-[#0a84ff]">
      </div>

      <div class="space-y-1.5 border-t border-white/5 pt-4">
        <div class="flex justify-between items-center text-[11px] font-medium text-white/80">
          <span>Densidad de Semitono</span>
          <span class="font-mono text-[#0a84ff] value-display" data-display="halftone">0.00</span>
        </div>
        <input type="range" data-slider="halftone" min="0" max="1" step="0.01" class="w-full accent-[#0a84ff]">
      </div>

      <div class="space-y-1.5 border-t border-white/5 pt-4">
        <div class="flex justify-between items-center text-[11px] font-medium text-white/80">
          <span>Ruido Fílmico</span>
          <span class="font-mono text-[#0a84ff] value-display" data-display="noise">0.00</span>
        </div>
        <input type="range" data-slider="noise" min="0" max="1" step="0.01" class="w-full accent-[#0a84ff]">
      </div>

      <div class="space-y-1.5">
        <div class="flex justify-between items-center text-[11px] font-medium text-white/80">
          <span>Scanlines CRT</span>
          <span class="font-mono text-[#0a84ff] value-display" data-display="scanlines">0.00</span>
        </div>
        <input type="range" data-slider="scanlines" min="0" max="1" step="0.01" class="w-full accent-[#0a84ff]">
      </div>

      <div class="space-y-1.5 border-t border-white/5 pt-4">
        <div class="flex justify-between items-center text-[11px] font-medium text-white/80">
          <span>Glitch Analógico</span>
          <span class="font-mono text-red-400 value-display" data-display="glitch">0.00</span>
        </div>
        <input type="range" data-slider="glitch" min="0" max="1" step="0.01" class="w-full accent-red-500">
      </div>

    </div>
  </aside>
</Layout>

<script>
  // ==========================================================================
  // ESTADO Y KEYFRAMES GL
  // ==========================================================================
  interface GLPreset {
    id: string;
    name: string;
    values: {
        chroma: number;
        bloom: number;
        halftone: number;
        noise: number;
        scanlines: number;
        glitch: number;
    };
  }

  const DEFAULT_GL_PRESETS: GLPreset[] = [
    {
      id: 'gl_default',
      name: 'Exploración Base',
      values: { chroma: 1.5, bloom: 0.0, halftone: 0.8, noise: 0.1, scanlines: 0.2, glitch: 0.0 }
    }
  ];

  let presetsList: GLPreset[] = loadPresetsFromStorage();
  let activePresetId: string = presetsList[0].id;
  let currentState = { ...presetsList[0].values };

  // DOM Elements
  const presetButtonsContainer = document.getElementById('preset-buttons')!;

  // Subtitle DOM Elements
  const subtitleContainer = document.getElementById('lab-subtitle-container')!;
  const dividerLine = document.getElementById('lab-divider')!;
  const subtitleText = "A través del diseño gráfico";
  const wordsArray = subtitleText.split(' ');

  subtitleContainer.innerHTML = wordsArray.map(w => 
    `<span class="mr-[1.5vw] md:mr-3 inline-block overflow-hidden pb-1"><span class="inline-block translate-y-[110%] intro-word font-normal">${w}</span></span>`
  ).join('');
  const wordSpans = document.querySelectorAll('.intro-word') as NodeListOf<HTMLElement>;

  // ==========================================================================
  // STORAGE & PRESETS
  // ==========================================================================
  function loadPresetsFromStorage(): GLPreset[] {
    try {
      const saved = localStorage.getItem('mel_intro_gl_settings_v4');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch (e) {}
    return JSON.parse(JSON.stringify(DEFAULT_GL_PRESETS));
  }

  function savePresetsToStorage() {
    localStorage.setItem('mel_intro_gl_settings_v4', JSON.stringify(presetsList));
  }

  function switchPreset(newId: string) {
    if (newId === activePresetId) return;
    savePresetsToStorage();
    activePresetId = newId;
    const found = presetsList.find(p => p.id === newId);
    if (found) activeKeyframes = JSON.parse(JSON.stringify(found.keyframes));
    renderPresetButtons();
    renderKeyframeMarkers();
    seekTo(currentTime);
  }

  function takeSnapshot() {
    savePresetsToStorage();
    const newId = 'snap_' + Date.now();
    const newPreset: GLPreset = {
      id: newId,
      name: `Versión ${presetsList.length + 1}`,
      keyframes: JSON.parse(JSON.stringify(activeKeyframes))
    };
    presetsList.push(newPreset);
    activePresetId = newId;
    savePresetsToStorage();
    renderPresetButtons();
    renderKeyframeMarkers();
    seekTo(currentTime);
  }

  function renderPresetButtons() {
    presetButtonsContainer.innerHTML = presetsList.map(p => {
      const isActive = p.id === activePresetId;
      if (isActive) {
        return `<span class="relative flex items-center">
          <input data-preset-id="${p.id}" type="text" value="${p.name.replace(/"/g, '&quot;')}"
            class="preset-name-input px-3 py-1.5 rounded-md bg-[#0a84ff] border border-transparent text-white text-[11px] font-bold w-[140px] focus:outline-none shadow-md transition-all"
          />
        </span>`;
      }
      return `<button data-preset-id="${p.id}" class="preset-btn px-3 py-1.5 rounded-md transition-all font-medium text-[11px] bg-white/5 hover:bg-white/10 text-white/60 hover:text-white border border-white/10">${p.name}</button>`;
    }).join('');

    presetButtonsContainer.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-preset-id');
        if (id) switchPreset(id);
      });
    });

    const nameInput = presetButtonsContainer.querySelector('.preset-name-input') as HTMLInputElement | null;
    if (nameInput) {
      nameInput.addEventListener('blur', () => {
        const id = nameInput.getAttribute('data-preset-id');
        const found = presetsList.find(p => p.id === id);
        if (found && nameInput.value.trim()) {
          found.name = nameInput.value.trim();
          savePresetsToStorage();
        }
      });
      nameInput.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') nameInput.blur();
        e.stopPropagation();
      });
    }
  }

  // ==========================================================================
  // TIMELINE & KEYFRAME MATH
  // ==========================================================================
  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

  function interpolateKeyframes(time: number): Omit<GLKeyframe, 'time'> {
    const kfs = [...activeKeyframes].sort((a, b) => a.time - b.time);
    if (kfs.length === 0) return { chroma: 0, bloom: 0, halftone: 0, noise: 0, scanlines: 0, glitch: 0 };
    if (time <= kfs[0].time) return { ...kfs[0] };
    if (time >= kfs[kfs.length - 1].time) return { ...kfs[kfs.length - 1] };

    let prev = kfs[0], next = kfs[1];
    for (let i = 0; i < kfs.length - 1; i++) {
      if (time >= kfs[i].time && time <= kfs[i + 1].time) {
        prev = kfs[i]; next = kfs[i + 1]; break;
      }
    }
    const span = next.time - prev.time;
    const factor = span === 0 ? 0 : (time - prev.time) / span;

    return {
      chroma: lerp(prev.chroma, next.chroma, factor),
      bloom: lerp(prev.bloom, next.bloom, factor),
      halftone: lerp(prev.halftone, next.halftone, factor),
      noise: lerp(prev.noise, next.noise, factor),
      scanlines: lerp(prev.scanlines, next.scanlines, factor),
      glitch: lerp(prev.glitch, next.glitch, factor)
    };
  }

  function addOrUpdateKeyframe(state: Omit<GLKeyframe, 'time'>) {
    const existingIdx = activeKeyframes.findIndex(k => Math.abs(k.time - currentTime) < 0.05);
    if (existingIdx !== -1) {
      activeKeyframes[existingIdx] = { time: activeKeyframes[existingIdx].time, ...state };
    } else {
      activeKeyframes.push({ time: currentTime, ...state });
      activeKeyframes.sort((a, b) => a.time - b.time);
    }
    savePresetsToStorage();
    renderKeyframeMarkers();
    btnDeleteKf.classList.remove('hidden');
  }

  function deleteKeyframe() {
    const exactKfIndex = activeKeyframes.findIndex(k => Math.abs(k.time - currentTime) < 0.05);
    if (exactKfIndex !== -1) {
      activeKeyframes.splice(exactKfIndex, 1);
      savePresetsToStorage();
      renderKeyframeMarkers();
      seekTo(currentTime);
    }
  }

  function renderKeyframeMarkers() {
    keyframeMarkers.innerHTML = activeKeyframes.map((k, idx) => {
      const pct = (k.time / maxTime) * 100;
      return `<div class="kf-marker absolute top-1/2 -mt-1.5 w-3 h-3 bg-white border-2 border-[#0a84ff] rotate-45 cursor-pointer shadow-md hover:scale-125 transition-transform" style="left: calc(${pct}% - 6px);" data-kf-idx="${idx}" title="${k.time.toFixed(2)}s"></div>`;
    }).join('');
  }

  function easeOutExpo(x: number): number { return x === 1 ? 1 : 1 - Math.pow(2, -10 * x); }
  function easeInExpo(x: number): number { return x === 0 ? 0 : Math.pow(2, 10 * x - 10); }

  function seekTo(t: number) {
    currentTime = Math.max(0, Math.min(maxTime, t));
    const pct = (currentTime / maxTime) * 100;
    
    playhead.style.left = `${pct}%`;
    progress.style.width = `${pct}%`;

    const seconds = Math.floor(currentTime);
    const ms = Math.floor((currentTime % 1) * 100);
    tcCurrent.textContent = `00:0${seconds}.${ms < 10 ? '0' : ''}${ms}`;
    addKfTimeBadge.textContent = `${currentTime.toFixed(2)}s`;
    currentFrameBadge.textContent = `t = ${currentTime.toFixed(2)}s`;

    currentState = interpolateKeyframes(currentTime);
    
    if (!isUserInteracting) {
      syncUIFromState(currentState);
    }

    // ANIMACIÓN DOM: Subtítulo y divider
    // Divider entra a los 0.4s y dura 0.6s
    const divT = Math.max(0, Math.min(1, (currentTime - 0.4) / 0.6));
    dividerLine.style.transform = `scaleX(${easeOutExpo(divT)})`;
    dividerLine.style.opacity = divT > 0 ? '1' : '0';

    // Subtitle entra a partir de los 0.8s, cada palabra desfasada 0.05s
    wordSpans.forEach((span, i) => {
      const wordStart = 0.8 + (i * 0.05);
      const wordT = Math.max(0, Math.min(1, (currentTime - wordStart) / 0.5));
      const yOffset = 110 - (easeOutExpo(wordT) * 110);
      span.style.transform = `translateY(${yOffset}%)`;
    });

    const exactKfIndex = activeKeyframes.findIndex(k => Math.abs(k.time - currentTime) < 0.05);
    if (exactKfIndex !== -1) btnDeleteKf.classList.remove('hidden');
    else btnDeleteKf.classList.add('hidden');
  }

  function playLoop(timestamp: number) {
    if (!isPlaying) return;
    if (lastTimestamp === null) lastTimestamp = timestamp;
    const delta = (timestamp - lastTimestamp) / 1000;
    lastTimestamp = timestamp;

    currentTime += delta;
    if (currentTime >= maxTime) {
      if (isLooping) {
        currentTime = 0;
      } else {
        currentTime = maxTime;
        togglePlay();
        return;
      }
    }

    seekTo(currentTime);
    animReqId = requestAnimationFrame(playLoop);
  }

  function togglePlay() {
    isPlaying = !isPlaying;
    const iconPlay = document.getElementById('icon-play')!;
    const iconPause = document.getElementById('icon-pause')!;
    const lblPlayPause = document.getElementById('lbl-play-pause')!;
    if (isPlaying) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      lblPlayPause.textContent = 'Pausa';
      lastTimestamp = performance.now();
      animReqId = requestAnimationFrame(playLoop);
    } else {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      lblPlayPause.textContent = 'Play';
      if (animReqId) cancelAnimationFrame(animReqId);
    }
  }

  // ==========================================================================
  // UI SLIDER CONTROLS (APPLE PRO)
  // ==========================================================================
  function syncUIFromState(state: Omit<GLKeyframe, 'time'>) {
    document.querySelectorAll('input[type="range"][data-slider]').forEach(slider => {
      const key = slider.getAttribute('data-slider') as keyof Omit<GLKeyframe, 'time'>;
      const display = document.querySelector(`[data-display="${key}"]`);
      if (state[key] !== undefined) {
        (slider as HTMLInputElement).value = state[key].toString();
        if (display) display.textContent = state[key].toFixed(2);
      }
    });
  }

  document.querySelectorAll('input[type="range"][data-slider]').forEach(slider => {
    slider.addEventListener('input', (e) => {
      const key = slider.getAttribute('data-slider') as keyof Omit<GLKeyframe, 'time'>;
      const val = parseFloat((e.target as HTMLInputElement).value);
      currentState[key] = val;
      
      const display = document.querySelector(`[data-display="${key}"]`);
      if (display) display.textContent = val.toFixed(2);

      if (chkAutoKeyframe.checked && !isPlaying) {
        addOrUpdateKeyframe(currentState);
      }
    });
    
    slider.addEventListener('mousedown', () => isUserInteracting = true);
    slider.addEventListener('mouseup', () => isUserInteracting = false);
    slider.addEventListener('touchstart', () => isUserInteracting = true);
    slider.addEventListener('touchend', () => isUserInteracting = false);
  });

  // Timeline Mouse Interaction
  let isDraggingTrack = false;
  let draggingKfIndex: number | null = null;

  timelineTrack.addEventListener('mousedown', (e) => {
    const kfMarker = (e.target as HTMLElement).closest('.kf-marker');
    if (kfMarker) {
      const idxStr = kfMarker.getAttribute('data-kf-idx');
      if (idxStr !== null) {
        draggingKfIndex = parseInt(idxStr, 10);
        return;
      }
    }
    isDraggingTrack = true;
    processTrackSeek(e);
  });

  window.addEventListener('mousemove', (e) => {
    if (draggingKfIndex !== null) {
      const rect = timelineTrack.getBoundingClientRect();
      const clickX = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
      const newTime = parseFloat(((clickX / rect.width) * maxTime).toFixed(2));
      activeKeyframes[draggingKfIndex].time = newTime;
      activeKeyframes.sort((a, b) => a.time - b.time);
      savePresetsToStorage();
      renderKeyframeMarkers();
      seekTo(newTime);
      return;
    }
    if (isDraggingTrack) processTrackSeek(e);
  });

  window.addEventListener('mouseup', () => {
    isDraggingTrack = false;
    draggingKfIndex = null;
  });

  function processTrackSeek(e: MouseEvent) {
    const rect = timelineTrack.getBoundingClientRect();
    const clickX = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
    const ratio = clickX / rect.width;
    seekTo(ratio * maxTime);
  }

  // Bind Buttons
  document.getElementById('btn-play-pause')?.addEventListener('click', togglePlay);
  document.getElementById('btn-jump-start')?.addEventListener('click', () => seekTo(0));
  document.getElementById('btn-loop')?.addEventListener('click', () => { isLooping = !isLooping; });
  document.getElementById('btn-add-keyframe')?.addEventListener('click', () => addOrUpdateKeyframe(currentState));
  document.getElementById('btn-delete-keyframe')?.addEventListener('click', deleteKeyframe);
  document.getElementById('btn-take-snapshot')?.addEventListener('click', takeSnapshot);
  
  document.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && !['INPUT','TEXTAREA'].includes(document.activeElement?.tagName || '')) {
      e.preventDefault();
      togglePlay();
    }
  });


  // ==========================================================================
  // RENDERIZADO TEXTO CANVAS 2D (TEXTURA WEBGL)
  // ==========================================================================
  const textCanvas = document.getElementById('text-canvas') as HTMLCanvasElement;
  const ctx = textCanvas.getContext('2d', { willReadFrequently: true })!;
  
  // Tamaño holgado para evitar recortes con el desenfoque
  const C_WIDTH = 2448;
  const C_HEIGHT = 840;
  textCanvas.width = C_WIDTH;
  textCanvas.height = C_HEIGHT;

  const words = [
    { text: "Memoria", yBase: 250, offset: 0 },
    { text: "Electrónica", yBase: 450, offset: 0.15 },
    { text: "Leonesa", yBase: 650, offset: 0.3 }
  ];

  function renderTextToCanvas(t: number) {
    ctx.clearRect(0, 0, C_WIDTH, C_HEIGHT);
    // IMPORTANTE: Fondo negro absoluto para usar mix-blend-multiply en el DOM.
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, C_WIDTH, C_HEIGHT);
    
    ctx.fillStyle = '#ffffff';
    ctx.font = 'bold 200px "Space Grotesk", sans-serif';
    ctx.letterSpacing = '-10px';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';

    const startX = 150;
    
    words.forEach(w => {
      let y = w.yBase;
      let maskHeight = 250;

      if (t < 1.0) {
        const localT = Math.max(0, Math.min(1, (t - w.offset) / 0.7));
        const e = easeOutExpo(localT);
        y = w.yBase + 100 * (1 - e);
        maskHeight = e * 250;
      } else if (t < 2.0) {
        y = w.yBase;
      } else {
        const localT = Math.max(0, Math.min(1, (t - 2.0 - w.offset) / 0.7));
        const e = easeInExpo(localT);
        y = w.yBase - 800 * e;
      }

      ctx.save();
      ctx.beginPath();
      ctx.rect(0, w.yBase - maskHeight + 100, C_WIDTH, maskHeight);
      ctx.clip();
      
      ctx.fillText(w.text, startX, y);

      if (w.text === "Leonesa") {
        ctx.save();
        ctx.font = 'bold 90px sans-serif';
        const mX = ctx.measureText("Leonesa").width + startX + 20;
        ctx.fillText("®", mX, y - 60);
        ctx.restore();
      }
      ctx.restore();
    });
  }


  // ==========================================================================
  // WEBGL SETUP & SHADERS
  // ==========================================================================
  const glCanvas = document.getElementById('gl-canvas') as HTMLCanvasElement;
  const gl = glCanvas.getContext('webgl', { preserveDrawingBuffer: true })!;

  function resizeGL() {
    // Escalar al contenedor del título, pero con un padding extra (110% w, 120% h definido en CSS)
    const rect = document.getElementById('lab-title-container')!.getBoundingClientRect();
    glCanvas.width = rect.width * 1.1 * window.devicePixelRatio;
    glCanvas.height = rect.height * 1.2 * window.devicePixelRatio;
    gl.viewport(0, 0, gl.canvas.width, gl.canvas.height);
  }
  window.addEventListener('resize', resizeGL);
  resizeGL();

  const vsSource = `
    attribute vec4 aVertexPosition;
    attribute vec2 aTextureCoord;
    varying vec2 vUv;
    void main() {
      gl_Position = aVertexPosition;
      vUv = aTextureCoord;
    }
  `;

  const fsSource = `
    precision highp float;
    varying vec2 vUv;
    uniform sampler2D uSampler;
    uniform float uTime;
    uniform vec2 uRes;
    
    uniform float uChroma;
    uniform float uBloom;
    uniform float uHalftone;
    uniform float uNoise;
    uniform float uScanlines;
    uniform float uGlitch;

    float rand(vec2 co){ return fract(sin(dot(co.xy ,vec2(12.9898,78.233))) * 43758.5453); }

    void main() {
      vec2 uv = vUv;

      // GLITCH
      float glitchY = floor(uv.y * 100.0) / 100.0;
      float glitchNoise = rand(vec2(glitchY, floor(uTime * 10.0)));
      if (uGlitch > 0.0 && glitchNoise < (uGlitch * 0.3)) {
        uv.x += (rand(vec2(uTime, glitchY)) - 0.5) * 0.1 * uGlitch;
      }

      // CROMÁTICA
      float chromaOffset = (uChroma / uRes.x);
      vec2 dirR = vec2(chromaOffset, 0.0);
      vec2 dirB = vec2(-chromaOffset, 0.0);

      // Si leemos fuera de límites, forzamos negro
      float r = (uv.x + dirR.x > 1.0 || uv.x + dirR.x < 0.0) ? 0.0 : texture2D(uSampler, uv + dirR).r;
      float g = texture2D(uSampler, uv).g;
      float b = (uv.x + dirB.x > 1.0 || uv.x + dirB.x < 0.0) ? 0.0 : texture2D(uSampler, uv + dirB).b;
      
      vec3 color = vec3(r, g, b);

      // BLOOM
      if (uBloom > 0.0) {
        float bOff = uBloom * 3.0 / uRes.x;
        vec3 blurCol = vec3(0.0);
        blurCol += texture2D(uSampler, uv + vec2(bOff, bOff)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(-bOff, -bOff)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(bOff, -bOff)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(-bOff, bOff)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(bOff*1.5, 0.0)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(-bOff*1.5, 0.0)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(0.0, bOff*1.5)).rgb;
        blurCol += texture2D(uSampler, uv + vec2(0.0, -bOff*1.5)).rgb;
        color += (blurCol * 0.125) * uBloom * 0.5;
      }

      // HALFTONE
      if (uHalftone > 0.0) {
        float luma = dot(color, vec3(0.299, 0.587, 0.114));
        float dotSize = 8.0; 
        vec2 center = floor(gl_FragCoord.xy / dotSize) * dotSize + (dotSize * 0.5);
        float dist = distance(gl_FragCoord.xy, center);
        float radius = (dotSize * 0.65) * luma * uHalftone;
        float htMask = 1.0 - smoothstep(radius - 1.0, radius + 0.5, dist);
        
        vec3 htColor = vec3(htMask) * color;
        color = mix(color, htColor, uHalftone);
      }

      // El fondo será 1 (blanco) para ser invisible con mix-blend-multiply
      vec3 finalColor = 1.0 - color;

      // Aplicar ruido y scanlines SOLO a las partes con contenido
      float lumaContent = max(max(color.r, color.g), color.b);
      if (lumaContent > 0.01) {
        // SCANLINES (Oscurecemos)
        if (uScanlines > 0.0) {
          float scanline = sin(uv.y * uRes.y * 1.5) * 0.05 * uScanlines;
          finalColor -= scanline;
        }

        // RUIDO
        if (uNoise > 0.0) {
          float n = (rand(uv * uTime) - 0.5) * uNoise * 0.2;
          finalColor += n;
        }
      }

      // Asegurar que no pasamos de 0 o 1
      finalColor = clamp(finalColor, 0.0, 1.0);

      gl_FragColor = vec4(finalColor, 1.0);
    }
  `;

  function initShaderProgram(gl: WebGLRenderingContext, vs: string, fs: string) {
    const vertexShader = gl.createShader(gl.VERTEX_SHADER)!;
    gl.shaderSource(vertexShader, vs);
    gl.compileShader(vertexShader);
    const fragmentShader = gl.createShader(gl.FRAGMENT_SHADER)!;
    gl.shaderSource(fragmentShader, fs);
    gl.compileShader(fragmentShader);
    
    if (!gl.getShaderParameter(fragmentShader, gl.COMPILE_STATUS)) {
      console.error(gl.getShaderInfoLog(fragmentShader));
    }

    const shaderProgram = gl.createProgram()!;
    gl.attachShader(shaderProgram, vertexShader);
    gl.attachShader(shaderProgram, fragmentShader);
    gl.linkProgram(shaderProgram);
    return shaderProgram;
  }

  const shaderProgram = initShaderProgram(gl, vsSource, fsSource);
  const programInfo = {
    program: shaderProgram,
    attribLocations: {
      vertexPosition: gl.getAttribLocation(shaderProgram, 'aVertexPosition'),
      textureCoord: gl.getAttribLocation(shaderProgram, 'aTextureCoord'),
    },
    uniformLocations: {
      uSampler: gl.getUniformLocation(shaderProgram, 'uSampler'),
      uTime: gl.getUniformLocation(shaderProgram, 'uTime'),
      uRes: gl.getUniformLocation(shaderProgram, 'uRes'),
      uChroma: gl.getUniformLocation(shaderProgram, 'uChroma'),
      uBloom: gl.getUniformLocation(shaderProgram, 'uBloom'),
      uHalftone: gl.getUniformLocation(shaderProgram, 'uHalftone'),
      uNoise: gl.getUniformLocation(shaderProgram, 'uNoise'),
      uScanlines: gl.getUniformLocation(shaderProgram, 'uScanlines'),
      uGlitch: gl.getUniformLocation(shaderProgram, 'uGlitch'),
    },
  };

  const positionBuffer = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,1, 1,1, -1,-1, 1,-1]), gl.STATIC_DRAW);

  const textureCoordBuffer = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, textureCoordBuffer);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([0,0, 1,0, 0,1, 1,1]), gl.STATIC_DRAW);

  const texture = gl.createTexture();
  gl.bindTexture(gl.TEXTURE_2D, texture);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);

  // Initialize UI
  renderPresetButtons();
  renderKeyframeMarkers();
  seekTo(0);

  function renderWebGL() {
    requestAnimationFrame(renderWebGL);

    renderTextToCanvas(currentTime);
    gl.bindTexture(gl.TEXTURE_2D, texture);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, textCanvas);

    gl.useProgram(programInfo.program);

    gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
    gl.vertexAttribPointer(programInfo.attribLocations.vertexPosition, 2, gl.FLOAT, false, 0, 0);
    gl.enableVertexAttribArray(programInfo.attribLocations.vertexPosition);

    gl.bindBuffer(gl.ARRAY_BUFFER, textureCoordBuffer);
    gl.vertexAttribPointer(programInfo.attribLocations.textureCoord, 2, gl.FLOAT, false, 0, 0);
    gl.enableVertexAttribArray(programInfo.attribLocations.textureCoord);

    gl.uniform1f(programInfo.uniformLocations.uTime, currentTime);
    gl.uniform2f(programInfo.uniformLocations.uRes, gl.canvas.width, gl.canvas.height);
    gl.uniform1f(programInfo.uniformLocations.uChroma, currentState.chroma);
    gl.uniform1f(programInfo.uniformLocations.uBloom, currentState.bloom);
    gl.uniform1f(programInfo.uniformLocations.uHalftone, currentState.halftone);
    gl.uniform1f(programInfo.uniformLocations.uNoise, currentState.noise);
    gl.uniform1f(programInfo.uniformLocations.uScanlines, currentState.scanlines);
    gl.uniform1f(programInfo.uniformLocations.uGlitch, currentState.glitch);

    gl.activeTexture(gl.TEXTURE0);
    gl.bindTexture(gl.TEXTURE_2D, texture);
    gl.uniform1i(programInfo.uniformLocations.uSampler, 0);

    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
  }

  requestAnimationFrame(renderWebGL);

  document.getElementById('btn-export-code')?.addEventListener('click', () => {
    navigator.clipboard.writeText(JSON.stringify(presetsList, null, 2));
    alert('Presets GL copiados al portapapeles');
  });

</script>
