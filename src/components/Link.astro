---
interface Props {
  href?: string;
  class?: string;
  alignment?: 'Left' | 'Center' | 'Right';
  state?: 'Default' | 'Hover' | 'Disabled';
  id?: string;
  hideChevron?: boolean;
}

const { href = "#", class: className = "", alignment = "Left", state = "Default", id, hideChevron = false } = Astro.props;

const isRight = alignment === "Right";
const isCenter = alignment === "Center";
const isDisabled = state === "Disabled";
---
{isDisabled ? (
  <span 
    class={`mel-link-disabled ${className}`} 
    id={id}
  >
    <slot />
  </span>
) : (
  <a 
    href={href} 
    class={`group relative inline-flex items-center gap-1 no-underline mel-link-active ${className} ${isRight ? "justify-end text-right" : isCenter ? "justify-center text-center" : "justify-start text-left"}`}
    id={id}
  >
    <span class="relative inline-block text-inherit">
      <slot />
      <span class="mel-link-underline absolute bottom-0 left-0 right-0 h-[1px] scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
    </span>
    
    <!-- Chevron icon for Left alignment (rendered on the right of text in hover) -->
    {!isRight && !hideChevron && (
      <svg 
        class="w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[-4px] group-hover:translate-x-0 shrink-0" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    )}
    
    <!-- Chevron icon for Right alignment (rendered on the left of text in hover) -->
    {isRight && !hideChevron && (
      <svg 
        class="w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[4px] group-hover:translate-x-0 order-first shrink-0" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    )}
  </a>
)}

<style>
  /* Apply Lora font styles without hardcoding using Figma token variables */
  .mel-link-active {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: var(--Font-Size-Body-Roman, 16px);
    font-style: normal;
    font-weight: 500;
    line-height: var(--Line-Height-Body-Roman, 24px);
    letter-spacing: 0.16px;
    
    /* Default color from theme variable */
    color: var(--Text-Secondary, var(--mel-text-secondary));
    background-color: transparent;
  }

  .mel-link-active:hover {
    /* Action Primary color in Hover state for ALL nested elements (inheriting bg/color) */
    color: var(--Action-Primary, var(--mel-action-primary));
  }

  .mel-link-disabled {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: var(--Font-Size-Body-Roman, 16px);
    font-style: normal;
    font-weight: 500;
    line-height: var(--Line-Height-Body-Roman, 24px);
    letter-spacing: 0.16px;
    color: var(--Text-Tertiary, var(--mel-text-tertiary));
    user-select: none;
  }

  .mel-link-underline {
    background-color: currentColor;
  }
</style>
