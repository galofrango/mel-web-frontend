---
interface Props {
  href?: string;
  class?: string;
  alignment?: 'Left' | 'Center' | 'Right';
  state?: 'Default' | 'Hover' | 'Disabled' | 'Primary';
  id?: string;
  hideChevron?: boolean;
  reload?: boolean;
  ariaLabel?: string;
  expandHitArea?: boolean;
}

const { href = "#", class: className = "", alignment = "Left", state = "Default", id, hideChevron = false, reload = false, ariaLabel, expandHitArea = false } = Astro.props;

const isRight = alignment === "Right";
const isCenter = alignment === "Center";
const isDisabled = state === "Disabled";
---
{isDisabled ? (
  <span 
    class={`mel-link-disabled ${className}`} 
    id={id}
  >
    <slot />
  </span>
) : (
  <a
    href={href}
    aria-label={ariaLabel}
    class={`group relative inline-flex items-center gap-1 no-underline mel-link-active ${state === 'Primary' ? "mel-link-primary" : ""} typo-body-roman ${expandHitArea ? "mel-link-hit-expand" : ""} ${className} ${isRight ? "justify-end text-right" : isCenter ? "justify-center text-center" : "justify-start text-left"}`}
    id={id}
    {/* El atributo SOLO existe si de verdad se pide recarga dura (D-266).
        Antes se emitía siempre —`data-astro-reload="false"` con el valor por
        defecto— y el ClientRouter de Astro no mira el valor sino la PRESENCIA
        (`el.dataset.astroReload !== undefined`, en su ClientRouter.astro), así
        que TODOS los enlaces del sitio recargaban la página entera. Nadie lo
        había pedido: ni un solo sitio del proyecto pasa `reload`. Era el
        motivo de que llegar al mapa por la tag de "Lugar" se sintiera un
        pantallazo, y de paso tiraba a la basura la app ya cargada en cada
        salto por una tag. */}
    data-astro-reload={reload ? '' : undefined}
  >
    <span class="mel-link-text relative inline-block text-inherit min-w-0">
      <slot />
      <span class="mel-link-underline absolute bottom-0 left-0 right-0 h-[1px] scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
    </span>
    
    <!-- Chevron icon for Left alignment (appears at the right of the text on
         hover). Absolutely positioned so it takes NO layout space: an in-flow
         chevron (even at opacity-0) reserved 16px at the value's right edge,
         making linked tags visibly wider than plain ones (owner-reported). -->
    {!isRight && !hideChevron && (
      <svg 
        class="absolute left-full ml-1 top-1/2 -translate-y-1/2 w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[-4px] group-hover:translate-x-0 shrink-0" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    )}
    
    <!-- Chevron icon for Right alignment (appears at the left of the text on
         hover). Absolute for the same no-reserved-space reason as above. -->
    {isRight && !hideChevron && (
      <svg 
        class="absolute right-full mr-1 top-1/2 -translate-y-1/2 w-3 h-3 text-inherit opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-x-[4px] group-hover:translate-x-0 order-first shrink-0" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor" 
        stroke-width="3"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    )}
  </a>
)}

<style>
  /* Apply Lora font styles without hardcoding using Figma token variables */
  .mel-link-active {
    /* Default color from theme variable */
    color: var(--mel-text-secondary);
    background-color: transparent;
  }

  /* overflow/ellipsis live on the inner text span, NOT on the <a> itself —
     the chevron below is a sibling of this span, deliberately positioned
     OUTSIDE the <a>'s own content box (`left-full`, "takes no layout
     space"); putting overflow:hidden on the <a> clipped that chevron
     invisible on every hover, everywhere on the site (found while chasing
     a "missing chevron" report on the event detail's horizontal tags,
     D-066 — but the bug lived here, not in that specific row). */
  .mel-link-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mel-link-active:hover {
    /* Action Primary color in Hover state for ALL nested elements (inheriting bg/color) */
    color: var(--mel-action-primary);
  }

  /* state="Primary" (D-217): ya en action-primary en reposo, no solo al pasar
     el ratón — para las invitaciones "¿Nos ayudas?", que deben destacar como
     tales en vez de leerse como un dato más. */
  .mel-link-primary {
    color: var(--mel-action-primary);
  }

  /* Invisible halo that enlarges the tap/click target well past the visible
     text (D-1xx: tags in the map side panel were hard to hit accurately).
     A ::before generated INSIDE the <a> is still part of its own hit-test
     region, so hovering the halo triggers :hover/chevron exactly like
     hovering the text — no separate overlay stealing the event. */
  .mel-link-hit-expand::before {
    content: '';
    position: absolute;
    inset: -12px;
  }

  .mel-link-disabled {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--mel-text-tertiary);
    user-select: none;
  }

  .mel-link-underline {
    background-color: currentColor;
  }
</style>
