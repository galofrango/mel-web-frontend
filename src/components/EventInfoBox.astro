---
interface Props {
  description?: string;
  artists?: string;
  organizer?: string;
  designer?: string;
}

const { description, artists, organizer, designer } = Astro.props;

const cleanArtists = artists ? artists.split(/,+/).map(a => a.trim()).filter(a => a.toLowerCase() !== 'no detallados' && a.toLowerCase() !== 'desconocido') : [];
---
<div class="grid grid-cols-1 md:grid-cols-12 gap-8 py-8" data-node-id="EventInfoBox">
  <!-- Main description -->
  <div class="col-span-12 md:col-span-8 flex flex-col gap-4">
    <h3 class="font-sans font-bold text-xl uppercase tracking-wider text-mel-action-secondary">
      Descripción
    </h3>
    {description ? (
      <p class="typo-body-roman text-mel-text-primary whitespace-pre-line">
        {description}
      </p>
    ) : (
      <p class="typo-body-roman text-mel-text-secondary italic">
        Sin descripción detallada.
      </p>
    )}
  </div>

  <!-- Meta Info sidebar -->
  <div class="col-span-12 md:col-span-4 flex flex-col gap-6 p-6 border border-mel-border/60 bg-mel-bg-secondary/20 relative">
    <div class="absolute inset-0 striped-bg opacity-[0.03] z-0 pointer-events-none"></div>
    <div class="relative z-10 flex flex-col gap-6">
      {cleanArtists.length > 0 && (
        <div class="flex flex-col gap-2">
          <span class="typo-overline text-mel-text-secondary">Artistas</span>
          <div class="flex flex-wrap gap-2">
            {cleanArtists.map(artist => (
              <span class="px-2 py-1 bg-mel-bg-primary text-mel-text-primary border border-mel-border/60 text-sm font-medium">
                {artist}
              </span>
            ))}
          </div>
        </div>
      )}

      {organizer && organizer.toLowerCase() !== 'desconocido' && (
        <div class="flex flex-col gap-1">
          <span class="typo-overline text-mel-text-secondary">Organiza / Colectivo</span>
          <span class="font-sans font-semibold text-mel-text-primary text-base">
            {organizer}
          </span>
        </div>
      )}

      {designer && designer.toLowerCase() !== 'desconocido' && (
        <div class="flex flex-col gap-1">
          <span class="typo-overline text-mel-text-secondary">Diseñador del Flyer</span>
          <span class="font-sans font-semibold text-mel-text-primary text-base">
            {designer}
          </span>
        </div>
      )}
      
      <!-- Back button -->
      <a 
        href="/"
        class="mt-4 flex items-center justify-center gap-2 px-4 py-2 border border-mel-action-secondary bg-mel-action-secondary hover:bg-mel-action-primary hover:border-mel-action-primary text-mel-text-on-action hover:text-mel-text-on-action-primary font-sans font-bold uppercase text-sm tracking-wider cursor-pointer transition-colors shadow-[var(--mel-shadow-sm)]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Volver a la Galería
      </a>
    </div>
  </div>
</div>

<style>
  .striped-bg {
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      var(--mel-border) 10px,
      var(--mel-border) 11px
    );
  }
</style>
