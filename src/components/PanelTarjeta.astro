---
/**
 * PanelTarjeta — una de las dos tarjetas "Highlight XL" de /panel (Figma
 * 1200:116096). Puramente presentacional: recibe ya calculados la cifra total
 * (IDs únicos del nivel) y el desglose de hasta tres secciones + una cuarta
 * línea de desbordamiento; no conoce `Grupo` ni hace ningún cálculo propio.
 *
 * Franja de color de 8px a la izquierda, a toda su altura — código de color
 * por gravedad (ajuste del propietario tras rediseñar el panel en Figma).
 * Va en `position: absolute` (`top:-1px bottom:-1px left:-1px`, 8px de
 * ancho) CUBRIENDO el borde de la tarjeta, no como `border-l-8`: así lo
 * construye el propio nodo 1220:228148 (un rectángulo "Color indicator"
 * aparte, hermano del contenido, no un borde) — confirmado contra Figma en
 * vivo. Ya no es "mismo idioma que `FRANJA_CABECERA`" en PanelSeccion.astro:
 * esa cabecera sigue con `border-l-8` porque no se ha tocado en esta tarea,
 * y es un nodo de Figma distinto. `FRANJA_GRAVEDAD` mapea nivel → clase de
 * fondo para esa franja. Añadir un nivel 3 es añadir su color en global.css y una línea en
 * este mapa Y en el de PanelSeccion.astro — los dos únicos sitios que lo
 * necesitan, nunca las tarjetas u cabeceras ya pintadas.
 *
 * Los colores salen de la familia `banner` del DS (02/08/2026): nivel 1 es
 * `banner-error-border` y nivel 2 `banner-warning-border`, que es la traducción
 * literal de `Border/Banner Error` y `Border/Banner Warning` de Figma. Antes
 * nivel 1 usaba `le-400` (#aa3c52) y el diseño pide #981932 — se veía más
 * claro de la cuenta.
 *
 * `min-h-[206px]` (no `h-`): 206px es el alto de la tarjeta en Figma, pero
 * es el de la MÁS CORTA de las dos (3 líneas, sin desbordamiento) — «Bajo
 * rendimiento» tiene más de tres secciones y añade la cuarta línea de "Otras
 * incidencias", así que su contenido real mide más que eso. Un alto fijo
 * recortaría esa cuarta línea o desbordaría la caja; `min-h` da el suelo de
 * 206px a la tarjeta corta (deja hueco debajo, ver el porqué más abajo) sin
 * arriesgar la larga.
 *
 * Sin líneas de relleno (corrección tras la revisión visual del propietario):
 * `lineas` trae solo las que existen, 0 a 3, nunca rellena con placeholder.
 * El desglose va PEGADO ARRIBA, justo bajo la cifra — se probó alineado abajo
 * (`mt-auto`) en una ronda anterior y el propietario prefirió esta: es como se
 * ven las tarjetas cuando llegan a las cuatro líneas, así que una tarjeta con
 * menos avisos deja el hueco debajo del desglose, no encima. Es a propósito.
 *
 * `activa` decide el estado visual (bg-tertiary + borde action-primary +
 * sombra vs. bg-secondary + borde border). Hoy siempre llega en `false`: sin
 * JS todavía no hay ningún filtro aplicado, así que ninguna tarjeta filtra
 * nada — pero la prop existe porque el propio componente define los dos
 * estados (spec, sección Interfaz), y la tarea 6 conmutará la misma clase.
 *
 * `aria-pressed` viaja con la misma prop. Ajuste del propietario tras usar el
 * panel: la tarjeta activa representa el filtro EN CURSO, no un interruptor
 * — pulsarla de nuevo no hace nada (ver `pulsarTarjeta` en panel.astro), así
 * que el atributo tiene que anunciar "es la actual", no "conmutador que se
 * apaga pulsándolo otra vez".
 */
interface Linea {
  titulo: string;
  cifra: number;
}

interface Props {
  nivel: 1 | 2;
  overline: string;
  cifra: number;
  /** Solo las líneas reales que hay, 0 a 3 — sin relleno. */
  lineas: Linea[];
  /** Suma de las secciones que no caben en las 3 líneas. `null` = sin sobrante. */
  desbordamiento: number | null;
  activa?: boolean;
  /**
   * Si la tarjeta FILTRA el panel al pulsarla. La de «Peso ahorrado» no filtra
   * nada —no es una gravedad, es un marcador de lo hecho— así que se pinta como
   * `<div>` y sin `data-nivel`. Es importante que no lo lleve: el filtro por
   * tarjeta esconde las secciones cuyo nivel no coincide, y una tarjeta con un
   * nivel inventado dejaría el panel en blanco al pulsarla.
   */
  filtra?: boolean;
  /** Clase de fondo de la franja cuando la tarjeta no tiene nivel. */
  franja?: string;
  /** Texto pequeño bajo la cifra (p. ej. «desde el 3 de agosto»). */
  pie?: string | null;
  /** Qué parte del archivo representa esa cifra. Va al lado y entre paréntesis:
   *  «74» no dice si son muchos o pocos hasta que sabes que es la mitad. */
  porcentaje?: number | null;
}

const { nivel, overline, cifra, lineas, desbordamiento, activa = false,
        filtra = true, franja, pie = null, porcentaje = null } = Astro.props;

// El borde de la tarjeta activa lleva SU color de gravedad, no el rojo de
// acción: con `action-primary` fijo, la de «Bajo rendimiento» salía con franja
// ámbar y borde granate, dos colores diciendo cosas distintas de lo mismo.
const BORDE_ACTIVO: Record<1 | 2, string> = {
  1: 'border-mel-banner-error-border',
  2: 'border-mel-banner-warning-border',
};
const estadoClase = activa
  ? `bg-mel-bg-tertiary ${franja ? 'border-mel-banner-success-border' : BORDE_ACTIVO[nivel]} shadow-[var(--mel-shadow-button)]`
  : 'bg-mel-bg-secondary border-mel-border';

// Ver comentario de cabecera: barra absoluta de 8px por nivel, independiente
// de si la tarjeta está activa o no (el color de gravedad no es un estado,
// es un dato). Ahora es clase de FONDO (`bg-`), no de borde.
const FRANJA_GRAVEDAD: Record<1 | 2, string> = {
  1: 'bg-mel-banner-error-border',
  2: 'bg-mel-banner-warning-border',
};
const claseFranja = franja ?? FRANJA_GRAVEDAD[nivel];
const Etiqueta = filtra ? 'button' : 'div';
---

<Etiqueta
  type={filtra ? 'button' : undefined}
  class={`${filtra ? 'tarj ' : ''}group relative flex flex-col items-start gap-4 text-left border pl-8 pr-6 py-6 min-h-[206px] transition-colors duration-200 w-full ${estadoClase}`}
  data-nivel={filtra ? nivel : undefined}
  data-activa={filtra ? (activa ? 'true' : 'false') : undefined}
  aria-pressed={filtra ? (activa ? 'true' : 'false') : undefined}
>
  <span class="typo-overline text-mel-text-primary">{overline}</span>

  <span class="flex items-baseline gap-3">
    <span class="cifra typo-h1 text-mel-text-primary">{cifra}</span>
    {porcentaje !== null && <span class="pct typo-h3 text-mel-text-secondary">({porcentaje}%)</span>}
  </span>

  <span class="lins flex flex-col w-full gap-1">
    {lineas.map((linea) => (
      <span class="flex items-baseline justify-between gap-4 w-full">
        <span class="typo-caption text-mel-text-primary truncate">{linea.titulo}</span>
        <span class="typo-caption text-mel-text-primary shrink-0">{linea.cifra}</span>
      </span>
    ))}
    {desbordamiento !== null && (
      <span class="flex items-baseline justify-between gap-4 w-full">
        <span class="typo-caption text-mel-text-secondary truncate">Otras incidencias</span>
        <span class="typo-caption text-mel-text-secondary shrink-0">+{desbordamiento}</span>
      </span>
    )}
  </span>

  {pie && <span class="typo-caption text-mel-text-tertiary">{pie}</span>}

  <span class={`absolute top-[-1px] bottom-[-1px] left-[-1px] w-2 ${claseFranja}`} aria-hidden="true"></span>
</Etiqueta>
