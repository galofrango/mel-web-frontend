<script is:inline>
  // Solo en la carga que la muestra (el <head> ya puso la clase). En una
  // navegación suave a la portada este script se vuelve a ejecutar, pero la
  // clase ya no está (Astro copia los atributos del <html> nuevo): no hace nada.
  (function () {
    var raiz = document.documentElement;
    var capa = document.getElementById('mel-intro');
    if (!capa || !raiz.classList.contains('mel-intro')) return;
    var oyentes = new AbortController();
    function saltar() { raiz.classList.add('mel-intro-salta'); }
    ['pointerdown', 'wheel', 'keydown', 'touchmove'].forEach(function (ev) {
      addEventListener(ev, saltar, { once: true, passive: true, signal: oyentes.signal });
    });
    // Al acabar el fundido (el de siempre o el de saltar) se va del todo.
    capa.addEventListener('animationend', function (e) {
      if (e.target !== capa) return;
      oyentes.abort();
      raiz.classList.remove('mel-intro', 'mel-intro-salta');
      capa.remove();
      // Lo que la portada guarda para después de la entrada (el aviso del
      // orden, D-341) espera a esto.
      window.dispatchEvent(new CustomEvent('mel-intro-fin'));
    });
  })();
</script>

<style is:global>
  #mel-intro { display: none; }
  html.mel-intro #mel-intro {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    inset: 0;
    z-index: 400;
    background-color: var(--mel-bg-secondary);
    color: var(--mel-action-secondary);
    animation: mel-intro-fuera 1s ease-in-out 2.5s forwards;
  }
  /* Saltarla: otro nombre de animación para que arranque de cero (cambiar solo
     la duración de la misma la daría por acabada en el acto, sin fundido). */
  html.mel-intro.mel-intro-salta #mel-intro {
    animation: mel-intro-salta 0.3s ease-out forwards;
  }
  @keyframes mel-intro-fuera { to { opacity: 0; visibility: hidden; } }
  @keyframes mel-intro-salta { from { opacity: 1; } to { opacity: 0; visibility: hidden; } }

  /* `--m`: ancho de la marca. El propietario eligió en la simulación 112 px en
     un móvil de 375 y 136 px en una pantalla de 1440, y después pidió 16 y 32 px
     menos de ALTO del conjunto (el alto lo marca la marca: 0,9 × su ancho): queda
     en 94 px (25,1vw) y 100 px (6,97vw), con suelo y techo en la proporción del
     primer tamaño. El logo entra con un fundido de 1 s sobre el fondo. */
  .mel-intro-logo {
    --m: 25.1vw;
    display: flex;
    align-items: flex-end;
    gap: calc(var(--m) * 0.2);
    animation: mel-intro-entra 1s ease-out both;
  }
  @keyframes mel-intro-entra { from { opacity: 0; } }
  .mel-intro-logo svg { display: block; fill: currentColor; }
  .mel-intro-marca { width: var(--m); height: calc(var(--m) * 0.9); }
  /* Con `.mel-intro-logo` delante: si no, la regla de arriba (`… svg`) pesa
     más y el texto salía también en el móvil, aplastando la marca. */
  .mel-intro-logo .mel-intro-texto { display: none; }
  @media (min-width: 768px) {
    .mel-intro-logo { --m: clamp(60px, 6.97vw, 140px); }
    .mel-intro-logo .mel-intro-texto {
      display: block;
      height: calc(var(--m) * 0.80821);
      width: calc(var(--m) * 1.39307);
      margin-bottom: calc(var(--m) * -0.004);
    }
  }

  /* Las rayas bajan una raya entera (300 unidades) frenando. Arranque a ~270
     unidades/s, cerca de los 300 del bucle de Figma: la pendiente inicial de
     esta curva es 1,84 × 300 / 2,05 s. */
  .mel-intro-rayas {
    animation: mel-intro-rayas 2.05s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }
  @keyframes mel-intro-rayas {
    from { transform: translateY(-300px); }
    to { transform: translateY(0); }
  }
</style>
