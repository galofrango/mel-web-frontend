  <div class="mel-intro-logo">
    <svg class="mel-intro-marca" viewBox="0 0 1000 900">
      <defs>
        <clipPath id="mel-intro-ventana"><path d="M600 400L0 0V900H1000V200L600 400Z"/></clipPath>
        <path id="mel-intro-raya" d="M600 400L0 0V200L600 600L1000 400V200L600 400Z"/>
      </defs>
      <g clip-path="url(#mel-intro-ventana)">
        <g class="mel-intro-rayas">
          <use href="#mel-intro-raya"/>
          <use href="#mel-intro-raya" y="300"/>
          <use href="#mel-intro-raya" y="600"/>
          <use href="#mel-intro-raya" y="900"/>
        </g>
      </g>
    </svg>
    <svg class="mel-intro-texto" viewBox="100 246 1393.07 808.21">
