---
/**
 * EventCard.astro
 * Map popup card matching Figma "Event Card Construction"
 * Variants: Single (one event with thumbnail) / Multiple (list of events at same location)
 */
interface EventItem {
  title: string;
  date: string;
  id: string;
  imageUrl?: string;
  location?: string;
}

interface Props {
  variant?: 'single' | 'multiple';
  locationName?: string;
  events: EventItem[];
  class?: string;
}

const { variant = 'single', locationName = '', events = [], class: className = '' } = Astro.props;
const isSingle = variant === 'single' && events.length === 1;
const eventCount = events.length;
---

<!-- This component is rendered client-side as HTML for Leaflet popups -->
<!-- The structure below serves as reference for the JS popup builder -->

{isSingle ? (
  <!-- Single Event Card -->
  <div 
    class:list={["event-card-single", className]}
    data-node-id="Event Card Construction / Single"
  >
    <div class="flex gap-4 items-start">
      {events[0]?.imageUrl && (
        <div class="w-[80px] h-[100px] shrink-0 overflow-hidden border border-mel-border/30">
          <img 
            src={events[0].imageUrl} 
            alt={events[0].title}
            referrerpolicy="no-referrer"
            class="w-full h-full object-cover"
          />
        </div>
      )}
      <div class="flex flex-col gap-1 flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
          <p class="font-sans font-bold text-[17px] leading-[24px] tracking-[-0.17px] text-mel-text-primary truncate">
            {events[0].title}
          </p>
        </div>
        <p class="font-sans font-medium text-[16px] leading-[20px] text-mel-text-secondary">
          {events[0].date}
        </p>
        {events[0].location && (
          <p class="font-sans font-medium text-[16px] leading-[20px] text-mel-text-secondary">
            {events[0].location}
          </p>
        )}
        <button 
          class="event-card-btn mt-2 self-start flex items-center gap-1 px-3 py-1 border border-mel-action-secondary bg-mel-action-secondary text-mel-text-on-action font-sans font-medium text-[16px] leading-[20px] cursor-pointer transition-colors hover:bg-mel-action-primary hover:border-mel-action-primary hover:text-mel-text-on-action-primary"
          data-id={events[0].id}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          Abrir
        </button>
      </div>
    </div>
  </div>
) : (
  <!-- Multiple Events Card -->
  <div 
    class:list={["event-card-multiple", className]}
    data-node-id="Event Card Construction / Multiple"
  >
    <div class="flex items-center justify-between gap-2 mb-4">
      <p class="font-sans font-bold text-[17px] leading-[24px] tracking-[-0.17px] text-mel-text-primary">
        {eventCount} eventos en {locationName}
      </p>
    </div>
    <div class="flex flex-col gap-4">
      {events.map((event, i) => (
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between gap-1">
            <div class="flex flex-col gap-1 flex-1 min-w-0">
              <p class="font-sans font-bold text-[17px] leading-[24px] tracking-[-0.17px] text-mel-text-primary truncate">
                {event.title}
              </p>
              <p class="font-sans font-medium text-[16px] leading-[20px] text-mel-text-secondary">
                {event.date}
              </p>
            </div>
            <button 
              class="event-card-btn shrink-0 flex items-center gap-1 pl-2 pr-3 py-1 border border-mel-action-secondary bg-mel-action-secondary text-mel-text-on-action font-sans font-medium text-[16px] leading-[20px] cursor-pointer transition-colors hover:bg-mel-action-primary hover:border-mel-action-primary hover:text-mel-text-on-action-primary"
              data-id={event.id}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              Abrir
            </button>
          </div>
          {i < events.length - 1 && (
            <div class="h-px w-full bg-mel-border/60"></div>
          )}
        </div>
      ))}
    </div>
  </div>
)}
