---
interface Props {
  label: string;
  active?: boolean;
  dataView?: string;
  class?: string;
}

const { label, active = false, dataView = "", class: className = "" } = Astro.props;
---
<button 
  class:list={[
    "toggle-btn",
    "flex items-center justify-center h-[48px] flex-1 min-w-0 cursor-pointer border-none outline-none bg-transparent transition-all duration-200 relative",
    active ? "toggle-btn-active" : "toggle-btn-inactive",
    className
  ]}
  data-view={dataView}
  data-active={active ? "true" : "false"}
>
  {/* El peso cambia con el estado, así que la clase del DS también: `typo-button`
      (700) activo y `typo-lead` (500) en reposo. Las dos son 17/24 con el mismo
      interletrado, así que solo cambia el grosor y no salta nada de sitio. */}
  <span class:list={[
    "overflow-hidden text-ellipsis whitespace-nowrap relative z-10 transition-colors duration-200",
    active ? "typo-button text-mel-text-on-action" : "typo-lead text-mel-text-secondary"
  ]}>
    {label}
  </span>
</button>

<style>
  .toggle-btn-inactive:hover span {
    color: var(--mel-action-secondary);
  }
</style>
