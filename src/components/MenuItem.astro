---
import Icon from './Icon.astro';
import { PHANTOM_ESTADOS_GRUPO } from '../lib/ds';

interface Props {
  id?: string;
}

const { id } = Astro.props;
---
<button
  id={id}
  class="flex gap-4 h-10 items-center relative bg-transparent border-none cursor-pointer group outline-none select-none text-left"
  data-node-id="Menú Item"
>
  {/* 22/28 FIJO, no `typo-h3`. "Menú" vive en la misma fila que el título del
      sitio y tiene que medir lo mismo que él (regla 10). `typo-h3` sube a 25/32
      en escritorio —así lo manda el DS— y el título no lo hace, porque es una
      licencia fija (ver design-system.md). Con la clase puesta, "Menú" salía
      visiblemente más grande que "Memoria Electrónica Leonesa". */}
  <span class="typo-h3 hidden md:inline text-mel-text-primary group-hover:text-mel-action-primary transition-colors duration-200 select-none">
    Menú
  </span>
  <!-- Hueco de icono de 40px: es un botón phantom del DS a todos los efectos y
       tiene que verse EXACTAMENTE igual que uno. Lo que no puede es SER uno:
       este elemento ya es un `<button>` (lleva también el texto "Menú", que
       debe seguir siendo pulsable), y meter otro `<button>` dentro es HTML
       inválido. La salida no es copiar los tokens a mano —así fue como este
       botón se quedó con el pulsado viejo cuando cambió el del componente—
       sino tirar de la MISMA cadena de clases, en su variante de grupo:
       el estado lo tiene el botón de fuera y lo pinta este hueco de dentro. -->
  <div class:list={["w-10 h-10 flex items-center justify-center transition-colors duration-200 shrink-0", PHANTOM_ESTADOS_GRUPO]}>
    <Icon icon="menu" size={24} strokeWidth={3} />
  </div>
</button>
