---
interface Props {
  label: string;
  count: number | string;
}

const { label, count } = Astro.props;
---
<button 
  class="filter-tag group flex flex-col items-start px-6 py-2 border-l border-mel-border/60 hover:text-mel-action-secondary bg-transparent border-t-0 border-r-0 border-b-0 outline-none cursor-pointer transition-all duration-200"
  data-category={label}
  data-node-id="Tag with link"
>
  <span class="font-sans font-bold text-[13px] tracking-[1.56px] uppercase text-mel-text-secondary group-hover:text-mel-action-secondary transition-colors">
    {label}
  </span>
  <span class="font-sans font-medium text-[17px] leading-[24px] text-mel-text-primary mt-1">
    {count}
  </span>
</button>
