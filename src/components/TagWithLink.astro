---
import Link from './Link.astro';

interface Props {
  label: string;
  count: number | string;
  alignment?: 'Left' | 'Center' | 'Right';
  titleIcon?: boolean;
  class?: string;
  href?: string;
  state?: 'Default' | 'Hover' | 'Disabled';
  hideBorder?: boolean;
  reload?: boolean;
  ariaLabel?: string;
}

const {
  label,
  count,
  alignment = "Left",
  titleIcon = false,
  class: className = "",
  href,
  state = "Default",
  hideBorder = false,
  reload = false,
  ariaLabel
} = Astro.props;

const isRight = alignment === "Right";
const isCenter = alignment === "Center";

// Smart width override logic: default to w-[184px] if no width class is provided
const hasWidth = className.split(/\s+/).some(cls => cls.startsWith('w-'));
const widthClass = hasWidth ? '' : 'w-[184px]';

// Border and padding styling: default to border-l and px-8 (32px, the sitewide
// minimum on each side of a vertical separator between TagWithLink instances —
// see D-043) unless hideBorder is requested. NO vertical padding in either
// mode: every Tag is exactly 48px tall (16px label + 8px gap + 24px value) so
// the border-l divider between tags is also exactly 48px.
const borderClass = hideBorder ? 'px-0 py-0' : 'border-l border-mel-border/30 px-8 py-0';
---
<div 
  class={`filter-tag flex flex-col gap-2 relative ${widthClass} ${borderClass} bg-transparent transition-all duration-200 ${isRight ? "items-end text-right" : isCenter ? "items-center text-center" : "items-start text-left"} ${className}`}
  data-category={label}
  data-node-id="Tag with link"
>
  <div class={`flex gap-1 items-center relative shrink-0 ${isRight ? "justify-end" : ""}`}>
    {titleIcon && (
      <div class="flex items-center justify-center shrink-0 w-4 h-4 text-mel-text-primary">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="6" cy="6" r="3" fill="currentColor"/>
        </svg>
      </div>
    )}
    <span class="font-sans font-bold text-[13px] leading-[16px] tracking-[1.56px] uppercase text-mel-text-primary whitespace-nowrap">
      {label}
    </span>
  </div>

  <div class={`flex h-[24px] items-center relative shrink-0 w-full min-w-0 ${isRight ? "justify-end" : isCenter ? "justify-center" : ""}`}>
    {href ? (
      <Link alignment={alignment} href={href} state={state} reload={reload} ariaLabel={ariaLabel} class="min-w-0 max-w-full">
        <span class="tag-count-val">{count}</span>
      </Link>
    ) : (
      <span class={`tag-count-val block w-full typo-body-roman ${state === 'Disabled' ? "text-mel-text-tertiary select-text" : "text-mel-text-secondary select-text"}`}>
        {count}
      </span>
    )}
  </div>
</div>

<style>
  /* The value is never allowed to wrap to a second line or overflow the tag's
     box — always ellipsis instead, regardless of how long the text is or how
     narrow the container (e.g. the map side panel) gets. Reaching into the
     child Link component's own markup needs :global() since Astro's scoped
     styles don't cross component boundaries. */
  .tag-count-val {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }
  :global(.filter-tag .mel-link-active) {
    min-width: 0;
    max-width: 100%;
  }
  :global(.filter-tag .mel-link-active > span) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }
</style>
