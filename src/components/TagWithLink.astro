---
import Link from './Link.astro';

interface TagMultiItem {
  texto: string;
  href?: string;
  ariaLabel?: string;
}

interface Props {
  label: string;
  count?: number | string;
  alignment?: 'Left' | 'Center' | 'Right';
  titleIcon?: boolean;
  class?: string;
  href?: string;
  state?: 'Default' | 'Hover' | 'Disabled' | 'Primary';
  hideBorder?: boolean;
  reload?: boolean;
  ariaLabel?: string;
  // Varios valores en la misma tag, cada uno con su propio enlace (D-218:
  // los promotores pueden venir separados por comas, y cada uno debe buscar
  // el suyo, no la cadena completa). Cuando se pasa, sustituye a count/href.
  multi?: TagMultiItem[];
}

const {
  label,
  count,
  alignment = "Left",
  titleIcon = false,
  class: className = "",
  href,
  state = "Default",
  hideBorder = false,
  reload = false,
  ariaLabel,
  multi
} = Astro.props;

const isRight = alignment === "Right";
const isCenter = alignment === "Center";

// Smart width override logic: default to w-[184px] if no width class is provided
const hasWidth = className.split(/\s+/).some(cls => cls.startsWith('w-'));
const widthClass = hasWidth ? '' : 'w-[184px]';

// Border and padding styling: default to border-l and px-8 (32px, the sitewide
// minimum on each side of a vertical separator between TagWithLink instances —
// see D-043) unless hideBorder is requested. NO vertical padding in either
// mode: every Tag is exactly 48px tall (16px label + 8px gap + 24px value) so
// the border-l divider between tags is also exactly 48px.
const borderClass = hideBorder ? 'px-0 py-0' : 'border-l border-mel-border px-8 py-0';
---
<div 
  class={`filter-tag flex flex-col gap-2 relative ${widthClass} ${borderClass} bg-transparent transition-all duration-200 ${isRight ? "items-end text-right" : isCenter ? "items-center text-center" : "items-start text-left"} ${className}`}
  data-category={label}
  data-node-id="Tag with link"
>
  <div class={`flex gap-1 items-center relative shrink-0 ${isRight ? "justify-end" : ""}`}>
    {titleIcon && (
      <div class="flex items-center justify-center shrink-0 w-4 h-4 text-mel-text-primary">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="6" cy="6" r="3" fill="currentColor"/>
        </svg>
      </div>
    )}
    <span class="typo-overline text-mel-text-primary whitespace-nowrap">
      {label}
    </span>
  </div>

  <!-- `marquee-cell`/`marquee-inner` (D-220, global.css): en reposo trunca
       con puntos suspensivos igual que antes; al pasar el ratón, si de
       verdad desborda (`.is-overflowing`, lo decide el JS de cada página
       porque no hay módulo compartido — regla 7), desliza para dejar ver el
       resto en vez de quedarse cortado en seco contra el borde. -->
  <div class={`marquee-cell flex h-[24px] items-center relative shrink-0 w-full min-w-0 overflow-hidden ${isRight ? "justify-end" : isCenter ? "justify-center" : ""}`}>
    {multi && multi.length ? (
      <div class="tag-multi marquee-inner min-w-0 max-w-full">
        {multi.map((m, idx) => (
          <span class="inline-flex items-center shrink-0">
            {m.href ? (
              <Link href={m.href} state={state} ariaLabel={m.ariaLabel} hideChevron={true} class="shrink-0">{m.texto}</Link>
            ) : (
              <span class="text-mel-text-secondary">{m.texto}</span>
            )}
            {idx < multi.length - 1 && <span class="text-mel-text-secondary mr-1">,</span>}
          </span>
        ))}
      </div>
    ) : href ? (
      <Link alignment={alignment} href={href} state={state} reload={reload} ariaLabel={ariaLabel} expandHitArea={true} class="min-w-0 max-w-full">
        <span class="tag-count-val marquee-inner">{count}</span>
      </Link>
    ) : (
      <span class={`tag-count-val marquee-inner w-full typo-body-roman ${state === 'Disabled' ? "text-mel-text-tertiary select-text" : "text-mel-text-secondary select-text"}`}>
        {count}
      </span>
    )}
  </div>
</div>

<style>
  /* The value is never allowed to wrap to a second line or overflow the tag's
     box — always ellipsis instead, regardless of how long the text is or how
     narrow the container (e.g. the map side panel) gets. Reaching into the
     child Link component's own markup needs :global() since Astro's scoped
     styles don't cross component boundaries. */
  .tag-count-val {
    /* `display` ya no va aquí (D-220): esta clase convive siempre con
       `.marquee-inner` (global.css), que pone `inline-block` — un
       `display:block` aquí empataba en especificidad con esa regla y
       ganaba por orden de carga, dejando el valor sin el modo de scroll
       al pasar el ratón aunque desbordara de verdad. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }
  :global(.filter-tag .mel-link-active) {
    min-width: 0;
    max-width: 100%;
  }
  :global(.filter-tag .mel-link-active > span) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }
</style>
