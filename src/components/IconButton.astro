---
/**
 * IconButton.astro
 * Standardized Icon Button Component matching Figma "Icon Button" (111:3929).
 *
 * - type="primary": Solid background (Resting: action-secondary, Hover:
 *   action-primary, Pressed: text-tertiary), drop shadow + blur, icon in
 *   text-on-action.
 * - type="phantom": Transparent bg, no border/shadow (Resting: action-
 *   secondary, Hover: action-primary, Pressed: action-tertiary).
 *
 * Size norms:
 * - size=40: Houses a 24px icon with 3px stroke width
 * - size=24: Houses a 16px icon with 2px stroke width
 */
import Icon from './Icon.astro';

interface Props {
  icon: 'x' | 'search' | 'chevron-left' | 'chevron-right' | 'menu';
  size?: 40 | 24;
  type?: 'primary' | 'phantom';
  variant?: 'ghost' | 'outline'; // Legacy mapping
  class?: string;
  id?: string;
  'aria-label'?: string;
  href?: string; // Renders as <a> instead of <button> — e.g. a close control that's really a link to another page (see event/[id].astro's own click-intercept + hard-reload pattern, D-074).
}

const {
  icon,
  size = 40,
  type: propType,
  variant,
  class: className = '',
  id,
  'aria-label': ariaLabel,
  href
} = Astro.props;

// Determine final DS type
const finalType = propType || (variant === 'ghost' ? 'phantom' : 'primary');

// Determine dimensions
const sizeClasses = size === 40 ? 'w-10 h-10' : 'w-6 h-6';
const iconSize = size === 40 ? 24 : 16;
const strokeWidth = size === 40 ? 3 : 2;

// Determine variant design tokens (Resting/Hover/Pressed per Figma 111:3929)
const variantClasses = finalType === 'primary'
  ? 'bg-mel-action-secondary text-mel-text-on-action backdrop-blur-[2px] shadow-[var(--mel-shadow-button)] hover:bg-mel-action-primary hover:text-mel-text-on-action-primary active:bg-mel-text-tertiary active:text-mel-text-on-action'
  : 'bg-transparent text-mel-action-secondary hover:text-mel-action-primary hover:bg-transparent active:text-mel-action-tertiary';
---

{href ? (
  <a
    id={id}
    href={href}
    class={`flex items-center justify-center cursor-pointer transition-all duration-200 shrink-0 outline-none no-underline ${sizeClasses} ${variantClasses} ${className}`}
    aria-label={ariaLabel}
  >
    <Icon icon={icon} size={iconSize} strokeWidth={strokeWidth} />
  </a>
) : (
  <button
    id={id}
    class={`flex items-center justify-center cursor-pointer transition-all duration-200 shrink-0 outline-none rounded-none border-none ${sizeClasses} ${variantClasses} ${className}`}
    aria-label={ariaLabel}
  >
    <Icon icon={icon} size={iconSize} strokeWidth={strokeWidth} />
  </button>
)}
