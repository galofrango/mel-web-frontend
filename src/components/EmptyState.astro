---
// EmptyState.astro
// Reusable Empty State component matching Figma 825:72958 specifications exactly.

interface Props {
  variant?: "construction" | "no-results";
  title?: string;
  description?: string;
  showImage?: boolean;
  showButton?: boolean;
  buttonText?: string;
  buttonLink?: string;
}

const {
  variant = "construction",
  title,
  description,
  showImage = true,
  showButton = variant === "construction",
  buttonText = "De acuerdo",
  buttonLink = "/"
} = Astro.props;

// Determine default texts and images based on the variant
const defaultTitle = variant === "construction" ? "En construcción" : "Sin resultados";
const defaultDesc = variant === "construction" 
  ? "Estamos trabajando para poder ofrecerte más cosas interesantes." 
  : "Comprueba los filtros y prueba buscando otra cosa.";

const displayTitle = title ?? defaultTitle;
const displayDescription = description ?? defaultDesc;

const imageSrc = variant === "construction" 
  ? "/empty-state-construction.png" 
  : "/empty-state-no-results.png";

const imgFitClass = variant === "construction" ? "object-cover" : "object-bottom";
---

<div 
  class="flex flex-col gap-[32px] items-center p-[24px] relative text-center max-w-[400px] w-full mx-auto"
  data-node-id="810:71904"
  data-name="Empty State"
>
  <!-- Tinted Photographic Empty State Image -->
  {showImage && (
    <div 
      class="h-[240px] w-[320px] overflow-hidden relative shrink-0 border border-mel-border/40 flex items-center justify-center select-none"
      data-node-id="821:72317"
      data-name="Empty State Image"
    >
      <!-- Black and white image asset -->
      <img 
        src={imageSrc} 
        alt="" 
        class={`absolute inset-0 size-full pointer-events-none ${imgFitClass}`} 
        referrerpolicy="no-referrer"
      />
      <!-- Photographic tint layer blending to create the branding duotone -->
      <div 
        class="absolute inset-0 bg-[var(--mel-primitive-le-900)] mix-blend-screen pointer-events-none"
        data-name="Filtro fotográfico"
      ></div>
    </div>
  )}

  <!-- Title & Description -->
  <div 
    class="flex flex-col gap-[16px] items-center w-full"
    data-node-id="810:71907"
    data-name="Text"
  >
    <h2 
      class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary w-full m-0"
      data-node-id="810:71902"
    >
      {displayTitle}
    </h2>
    <p 
      class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-secondary w-full m-0"
      data-node-id="810:71905"
    >
      {displayDescription}
    </p>
  </div>

  <!-- Action Button. In the "construction" variant this goes back to wherever
       the visitor came from (not just buttonLink) with a fade — see the
       script below — matching the dissolve used when closing an event's
       details overlay. -->
  {showButton && (
    <a
      href={buttonLink}
      id={variant === "construction" ? "empty-state-back-btn" : undefined}
      class="inline-flex gap-[8px] items-center justify-center px-[24px] py-[12px] bg-mel-action-secondary border border-mel-action-secondary text-mel-text-on-action font-sans font-bold text-[17px] leading-[24px] tracking-[-0.34px] no-underline hover:bg-mel-action-primary hover:border-mel-action-primary transition-colors duration-200 cursor-pointer shadow-[var(--mel-shadow-sm)]"
      data-node-id="821:72737"
      data-name="Button"
    >
      <span data-node-id="821:72738">
        {buttonText}
      </span>
    </a>
  )}
</div>

{/* Unconditional so Astro reliably hoists/bundles it — the #empty-state-back-btn
    id only exists in the DOM for the "construction" variant, so this safely
    no-ops for the other variants (which don't show this button at all). */}
<script>
  function initEmptyStateBackButton() {
    const btn = document.getElementById('empty-state-back-btn');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      // Always back to the gallery (not document.referrer — that was
      // occasionally empty/unusable and left the button looking stuck with
      // nowhere to go). history.back() would also go through Astro's own
      // ClientRouter transition *on top of* this fade — two overlapping
      // transitions, which is what caused the earlier stutter/hiccup. A hard
      // reload skips ClientRouter entirely for this one navigation.
      //
      // The navigation starts immediately (not after the fade finishes) so
      // the destination starts loading right away, in parallel with the
      // fade — waiting first just meant staring at a blank faded page while
      // the actual load hadn't even begun yet.
      document.body.style.transition = 'opacity 0.5s ease';
      document.body.style.opacity = '0';
      window.location.href = '/';
    });
  }
  document.addEventListener('astro:page-load', initEmptyStateBackButton);
</script>
