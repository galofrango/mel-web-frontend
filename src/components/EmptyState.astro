---
// EmptyState.astro
// Reusable Empty State component matching Figma 825:72958 specifications exactly.

interface Props {
  variant?: "construction" | "no-results" | "404";
  title?: string;
  description?: string;
  showImage?: boolean;
  showButton?: boolean;
  buttonText?: string;
  buttonLink?: string;
}

const {
  variant = "construction",
  title,
  description,
  showImage = true,
  showButton = true,
  buttonText,
  buttonLink = "/"
} = Astro.props;

// Textos, foto y encuadre por variante (Figma: 825:72958 para construcción y
// sin-resultados, 1073:114391 para el 404). Todo en una tabla en vez de
// encadenar ternarios: añadir una variante nueva es una fila más.
const VARIANTES = {
  construction: {
    title: "En construcción",
    description: "Estamos trabajando para poder ofrecerte más cosas interesantes.",
    button: "De acuerdo",
    image: "/empty-state-construction.png",
    fit: "object-cover",
  },
  "no-results": {
    title: "Sin resultados",
    description: "Elimina los filtros o prueba a buscar otra cosa.",
    button: "Quitar filtros",
    image: "/empty-state-no-results.png",
    fit: "object-bottom",
  },
  "404": {
    title: "404",
    description: "El ritmo que buscas aún no existe",
    button: "Ir al inicio",
    image: "/empty-state-404.png",
    fit: "object-cover",
  },
};

const cfg = VARIANTES[variant] ?? VARIANTES.construction;

const displayTitle = title ?? cfg.title;
const displayDescription = description ?? cfg.description;
const displayButtonText = buttonText ?? cfg.button;
const imageSrc = cfg.image;
const imgFitClass = cfg.fit;
---

<div 
  class="flex flex-col gap-[32px] items-center p-[24px] relative text-center max-w-[400px] w-full mx-auto"
  data-node-id="810:71904"
  data-name="Empty State"
>
  <!-- Tinted Photographic Empty State Image -->
  {showImage && (
    <div 
      class="h-[240px] w-[320px] overflow-hidden relative shrink-0 border border-mel-border/40 flex items-center justify-center select-none"
      data-node-id="821:72317"
      data-name="Empty State Image"
    >
      <!-- Black and white image asset -->
      <img 
        src={imageSrc} 
        alt="" 
        class={`absolute inset-0 size-full pointer-events-none ${imgFitClass}`} 
        referrerpolicy="no-referrer"
      />
      <!-- Photographic tint layer blending to create the branding duotone -->
      <div 
        class="absolute inset-0 bg-[var(--mel-primitive-le-900)] mix-blend-screen pointer-events-none"
        data-name="Filtro fotográfico"
      ></div>
    </div>
  )}

  <!-- Title & Description -->
  <div 
    class="flex flex-col gap-[16px] items-center w-full"
    data-node-id="810:71907"
    data-name="Text"
  >
    <h2 
      class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary w-full m-0"
      data-node-id="810:71902"
    >
      {displayTitle}
    </h2>
    <p 
      class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-secondary w-full m-0"
      data-node-id="810:71905"
    >
      {displayDescription}
    </p>
  </div>

  <!-- Action Button -->
  {showButton && (
    <a
      href={buttonLink}
      id={variant === "construction" ? "empty-state-back-btn" : undefined}
      class={`${variant === "no-results" ? "empty-state-clear-btn " : ""}inline-flex gap-[8px] items-center justify-center px-[24px] py-[12px] bg-mel-action-secondary border border-mel-action-secondary text-mel-text-on-action font-sans font-bold text-[17px] leading-[24px] tracking-[-0.34px] no-underline hover:bg-mel-action-primary hover:border-mel-action-primary hover:text-mel-text-on-action-primary transition-colors duration-200 cursor-pointer shadow-[var(--mel-shadow-sm)]`}
      data-node-id="821:72737"
      data-name="Button"
    >
      <span data-node-id="821:72738">
        {displayButtonText}
      </span>
    </a>
  )}
</div>

<script>
  function initEmptyStateBackButton() {
    const btn = document.getElementById('empty-state-back-btn');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      document.body.style.transition = 'opacity 0.5s ease';
      document.body.style.opacity = '0';
      window.location.href = '/';
    });
  }
  document.addEventListener('astro:page-load', initEmptyStateBackButton);
</script>
