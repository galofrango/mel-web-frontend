---
// EmptyState.astro
// Reusable Empty State component matching Figma 825:72958 specifications exactly.

interface Props {
  variant?: "construction" | "no-results";
  title?: string;
  description?: string;
  showImage?: boolean;
  showButton?: boolean;
  buttonText?: string;
  buttonLink?: string;
}

const {
  variant = "construction",
  title,
  description,
  showImage = true,
  showButton = true,
  buttonText = variant === "no-results" ? "Quitar filtros" : "De acuerdo",
  buttonLink = "/"
} = Astro.props;

// Determine default texts and images based on the variant
const defaultTitle = variant === "construction" ? "En construcción" : "Sin resultados";
const defaultDesc = variant === "construction" 
  ? "Estamos trabajando para poder ofrecerte más cosas interesantes." 
  : "Elimina los filtros o prueba a buscar otra cosa.";

const displayTitle = title ?? defaultTitle;
const displayDescription = description ?? defaultDesc;

const imageSrc = variant === "construction" 
  ? "/empty-state-construction.png" 
  : "/empty-state-no-results.png";

const imgFitClass = variant === "construction" ? "object-cover" : "object-bottom";
---

<div 
  class="flex flex-col gap-[32px] items-center p-[24px] relative text-center max-w-[400px] w-full mx-auto"
  data-node-id="810:71904"
  data-name="Empty State"
>
  <!-- Tinted Photographic Empty State Image -->
  {showImage && (
    <div 
      class="h-[240px] w-[320px] overflow-hidden relative shrink-0 border border-mel-border/40 flex items-center justify-center select-none"
      data-node-id="821:72317"
      data-name="Empty State Image"
    >
      <!-- Black and white image asset -->
      <img 
        src={imageSrc} 
        alt="" 
        class={`absolute inset-0 size-full pointer-events-none ${imgFitClass}`} 
        referrerpolicy="no-referrer"
      />
      <!-- Photographic tint layer blending to create the branding duotone -->
      <div 
        class="absolute inset-0 bg-[var(--mel-primitive-le-900)] mix-blend-screen pointer-events-none"
        data-name="Filtro fotográfico"
      ></div>
    </div>
  )}

  <!-- Title & Description -->
  <div 
    class="flex flex-col gap-[16px] items-center w-full"
    data-node-id="810:71907"
    data-name="Text"
  >
    <h2 
      class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary w-full m-0"
      data-node-id="810:71902"
    >
      {displayTitle}
    </h2>
    <p 
      class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-secondary w-full m-0"
      data-node-id="810:71905"
    >
      {displayDescription}
    </p>
  </div>

  <!-- Action Button -->
  {showButton && (
    <a
      href={buttonLink}
      id={variant === "construction" ? "empty-state-back-btn" : (variant === "no-results" ? "empty-state-clear-btn" : undefined)}
      class="inline-flex gap-[8px] items-center justify-center px-[24px] py-[12px] bg-mel-action-secondary border border-mel-action-secondary text-mel-text-on-action font-sans font-bold text-[17px] leading-[24px] tracking-[-0.34px] no-underline hover:bg-mel-action-primary hover:border-mel-action-primary hover:text-mel-text-on-action-primary transition-colors duration-200 cursor-pointer shadow-[var(--mel-shadow-sm)]"
      data-node-id="821:72737"
      data-name="Button"
    >
      <span data-node-id="821:72738">
        {buttonText}
      </span>
    </a>
  )}
</div>

<script>
  function initEmptyStateButtons() {
    const backBtn = document.getElementById('empty-state-back-btn');
    if (backBtn) {
      backBtn.addEventListener('click', (e) => {
        e.preventDefault();
        document.body.style.transition = 'opacity 0.5s ease';
        document.body.style.opacity = '0';
        window.location.href = '/';
      });
    }

    const clearBtn = document.getElementById('empty-state-clear-btn');
    if (clearBtn) {
      clearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (window.location.pathname === '/') {
          window.dispatchEvent(new CustomEvent('mel-set-search', { detail: { query: '' } }));
          const sliderMin = document.getElementById('slider-min') as HTMLInputElement;
          const sliderMax = document.getElementById('slider-max') as HTMLInputElement;
          if (sliderMin && sliderMax) {
            sliderMin.value = "2004";
            sliderMax.value = "2019";
            sliderMin.dispatchEvent(new Event('input', { bubbles: true }));
            sliderMax.dispatchEvent(new Event('input', { bubbles: true }));
          }
        } else {
          window.location.href = '/';
        }
      });
    }
  }
  document.addEventListener('astro:page-load', initEmptyStateButtons);
</script>
