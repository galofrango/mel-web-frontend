---
interface Props {
  id: string;
  year: number;
  direction: 'left' | 'right';
  class?: string;
}

const { id, year, direction, class: className = "" } = Astro.props;
---
<div 
  id={id} 
  class={`absolute z-40 backdrop-blur-[2px] bg-mel-action-secondary text-mel-text-on-action px-[12px] py-[8px] flex items-center justify-center shadow-[var(--mel-shadow-handle)] select-none cursor-pointer border border-mel-action-secondary ${className}`}
  style="height: 36px; min-width: 60px;"
  data-node-id="Slider Handler"
>
  <span class="font-sans font-medium text-[16px] leading-[20px] text-mel-text-on-action select-none pointer-events-none">
    {year}
  </span>

  {direction === 'left' && (
    <div class="absolute right-[-12px] top-1/2 -translate-y-1/2 w-[12px] h-[16px] flex items-center justify-center pointer-events-none shrink-0">
      <svg width="12" height="16" viewBox="0 0 12 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-mel-action-secondary">
        <path d="M12 8L0 16V0L12 8Z" fill="currentColor"/>
      </svg>
    </div>
  )}

  {direction === 'right' && (
    <div class="absolute left-[-12px] top-1/2 -translate-y-1/2 w-[12px] h-[16px] flex items-center justify-center pointer-events-none shrink-0 rotate-180">
      <svg width="12" height="16" viewBox="0 0 12 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-mel-action-secondary">
        <path d="M12 8L0 16V0L12 8Z" fill="currentColor"/>
      </svg>
    </div>
  )}
</div>
