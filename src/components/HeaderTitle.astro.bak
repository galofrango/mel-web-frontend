---
interface Props {
  hideDivider?: boolean;
}
const { hideDivider = false } = Astro.props;
import Pica from './Pica.astro';
import IconButton from './IconButton.astro';
---
<div id="search-box-container" class="relative h-[48px] w-full transition-all duration-300 border-none" data-state="default">
  
  <!-- 1. Default / Header State (Title "Memoria Electrónica Leonesa|") -->
  <button 
    id="search-state-default" 
    class="flex items-center relative w-full h-full text-left bg-transparent border-none cursor-pointer select-none outline-none group" 
    data-node-id="369:28414"
  >
    <div class="flex items-center relative shrink-0">
      <span class="font-sans font-bold text-[22px] leading-[28px] text-mel-text-primary tracking-[-0.44px] whitespace-nowrap select-none group-hover:text-mel-action-secondary transition-colors duration-200">
        Memoria Electrónica Leonesa
      </span>
      <Pica class="ml-1" />
    </div>
  </button>

  <!-- 2. Active Search Input (Placeholder & Filling States) -->
  <div 
    id="search-state-active" 
    class="hidden border-b border-mel-action-tertiary h-full flex items-center justify-between relative w-full transition-all duration-200"
  >
    <div class="flex flex-1 items-center relative h-full">
      <!-- Shadow Span for calculating exact cursor offset -->
      <span 
        id="search-input-shadow" 
        class="absolute left-0 top-1/2 -translate-y-1/2 opacity-0 pointer-events-none whitespace-pre font-sans font-medium text-[17px] tracking-[-0.34px]"
      ></span>

      <!-- Custom absolute Pica cursor aligning with the font baseline -->
      <div 
        id="search-custom-cursor" 
        class="absolute left-0 top-[14px] w-[3px] h-[20px] bg-mel-action-secondary animate-mel-cursor z-10 pointer-events-none transition-transform duration-75"
      ></div>
      
      <input 
        type="text" 
        id="search-active-input" 
        placeholder="Busca un evento, artista, diseñador discoteca..." 
        class="bg-transparent border-none font-sans font-medium text-[17px] leading-[24px] text-mel-text-primary placeholder:text-mel-text-tertiary/60 tracking-[-0.34px] focus:outline-none w-full py-2 caret-transparent pl-3 transition-all duration-200"
        autocomplete="off"
      />
    </div>
    
    <!-- Clear/Close button -->
    <IconButton 
      id="search-clear-btn" 
      icon="x"
      size={40}
      variant="ghost"
      aria-label="Limpiar búsqueda"
    />
  </div>

  <!-- 3. Filled State (Tag/Pill style) -->
  <div 
    id="search-state-filled" 
    class="hidden bg-mel-bg-secondary border-b border-mel-action-tertiary h-full flex items-center justify-between pl-4 w-full transition-colors"
  >
    <div class="flex items-center relative shrink-0 truncate mr-2">
      <span 
        id="search-filled-text" 
        class="font-sans font-bold text-[17px] text-mel-action-secondary tracking-[-0.34px]"
      >
        Query
      </span>
    </div>
    
    <!-- Reset/Close button -->
    <IconButton 
      id="search-reset-btn" 
      icon="x"
      size={40}
      variant="ghost"
      class="hover:bg-mel-bg-secondary/80"
      aria-label="Reiniciar búsqueda"
    />
  </div>

</div>
<div class={`h-px bg-mel-border w-full mt-4 ${hideDivider ? 'hidden' : ''}`}></div>

<script>
  function initSearch() {
    const container = document.getElementById('search-box-container');
    const stateDefault = document.getElementById('search-state-default');
    const stateActive = document.getElementById('search-state-active');
    const stateFilled = document.getElementById('search-state-filled');
    
    const activeInput = document.getElementById('search-active-input') as HTMLInputElement;
    const shadowSpan = document.getElementById('search-input-shadow');
    const customCursor = document.getElementById('search-custom-cursor');
    
    const filledText = document.getElementById('search-filled-text');
    
    const clearBtn = document.getElementById('search-clear-btn');
    const resetBtn = document.getElementById('search-reset-btn');

    if (!container) return;

    function updateCustomCursorPosition() {
      if (!activeInput || !shadowSpan || !customCursor) return;
      
      const val = activeInput.value;
      if (val.length === 0) {
        // Placeholder state: Cursor is at left (0 offset) and padding is added
        activeInput.classList.add('pl-3');
        customCursor.style.transform = 'translate3d(0, 0, 0)';
      } else {
        // Filling state: Cursor moves right with text width, padding is removed
        activeInput.classList.remove('pl-3');
        shadowSpan.textContent = val;
        const textWidth = shadowSpan.getBoundingClientRect().width;
        customCursor.style.transform = `translate3d(${textWidth}px, 0, 0)`;
      }
    }

    function setState(state: 'default' | 'placeholder' | 'filling' | 'filled', val = "") {
      if (!container) return;
      container.setAttribute('data-state', state);

      // Hide all
      stateDefault?.classList.add('hidden');
      stateActive?.classList.add('hidden');
      stateFilled?.classList.add('hidden');

      if (state === 'default') {
        stateDefault?.classList.remove('hidden');
        if (activeInput) activeInput.value = "";
        dispatchSearch("");
      } 
      else if (state === 'placeholder') {
        stateActive?.classList.remove('hidden');
        activeInput?.focus();
        updateCustomCursorPosition();
      } 
      else if (state === 'filling') {
        stateActive?.classList.remove('hidden');
        updateCustomCursorPosition();
      } 
      else if (state === 'filled') {
        stateFilled?.classList.remove('hidden');
        if (filledText) filledText.textContent = val;
        if (activeInput) activeInput.value = val;
        dispatchSearch(val);
      }
    }

    function dispatchSearch(query: string) {
      window.dispatchEvent(new CustomEvent('mel-search', { detail: { query } }));
    }

    // Event Listeners attached directly
    stateDefault?.addEventListener('click', () => {
      setState('placeholder');
    });

    activeInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (val.length > 0) {
        setState('filling');
      } else {
        setState('placeholder');
      }
      updateCustomCursorPosition();
      dispatchSearch(val.trim());
    });

    activeInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = activeInput.value.trim();
        if (val.length > 0) {
          setState('filled', val);
        } else {
          setState('default');
        }
      } else if (e.key === 'Escape') {
        setState('default');
      }
    });

    // On initialization, check if search query parameter exists
    const params = new URLSearchParams(window.location.search);
    const urlQuery = params.get('search');
    if (urlQuery && urlQuery.trim().length > 0) {
      setState('filled', urlQuery.trim());
    } else {
      setState('default');
    }

    // Blur logic: if click outside and empty, return to default
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (container && !container.contains(target)) {
        const currentState = container.getAttribute('data-state');
        if (currentState === 'placeholder' || (currentState === 'filling' && activeInput && activeInput.value.trim() === "")) {
          setState('default');
        }
      }
    });

    clearBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setState('default');
      const url = new URL(window.location.href);
      url.searchParams.delete('search');
      url.searchParams.delete('view');
      window.history.replaceState({}, '', url.toString());
    });

    resetBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setState('default');
      const url = new URL(window.location.href);
      url.searchParams.delete('search');
      url.searchParams.delete('view');
      window.history.replaceState({}, '', url.toString());
    });
  }

  // Bind to astro:page-load for View Transitions compatibility
  document.addEventListener('astro:page-load', initSearch);
</script>

<style is:global>
  @keyframes mel-cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  .animate-mel-cursor {
    animation: mel-cursor-blink 1s infinite;
  }
</style>
