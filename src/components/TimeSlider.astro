---
import SliderHandler from './SliderHandler.astro';

/**
 * El rango lo manda quien tiene los datos (index.astro, vía `rangoDeAnios` de
 * mel.ts). Antes eran 2004 y 2019 escritos a mano aquí, y el script de este
 * mismo componente ya avisaba de que era «silently wrong the moment it
 * doesn't» (D-086 ronda 6). Pasó: un cartel de 2003 quedaba fuera del rango de
 * partida, así que el servidor lo pintaba y el cliente lo borraba. D-183.
 *
 * Los valores por defecto se quedan por si alguien monta el componente suelto,
 * pero ninguna página del sitio debería depender de ellos.
 */
interface Props {
  min?: number;
  max?: number;
}
const { min = 2004, max = 2019 } = Astro.props;
---
{/* touch-none (D-068): without an explicit touch-action, a touch-drag that
    starts on a handle and moves across the track can ALSO be interpreted by
    the browser as an attempt to pan/scroll the page — the two compete, and
    the handle visibly jitters while the page rubber-bands sideways for an
    instant. JS already handles the entire drag itself (pointermove/pointerup
    on window), so the browser's own touch gesture recognition has nothing
    useful to do here — telling it not to try removes the conflict at the
    source, on both the handles (SliderHandler.astro) and the track. */}
<!-- El alto sale del TIRADOR (36px, fijo en SliderHandler), no de un relleno.
     Antes eran `py-8`: 64px de relleno puro, porque la barra y los tiradores van
     en posición absoluta y no aportan alto ninguno. Ese relleno era invisible
     pero contaba, así que el hueco entre el slider y lo de al lado era 32px
     mayor que entre el resto de elementos — el propietario lo cazó con el
     inspector: "hay algún elemento que no está construido con el mismo padding".
     Sin él, el componente ocupa lo que ocupa y quien manda en la separación es
     el contenedor de la home, que la saca de la escala del DS. -->
<div id="slider-track-wrapper" class="relative w-full h-9 select-none cursor-pointer touch-none" data-node-id="Slider Bar/Time Slider">
  
  <!-- Inactive Slider Bar Background (8px height, rounded-none, color mel-border) -->
  <div class="h-2 w-full bg-mel-border absolute top-1/2 -translate-y-1/2 rounded-none"></div>
  
  <!-- Active Slider Bar Fill (8px height, rounded-none, action/secondary mel-action-secondary) -->
  <div id="slider-active-fill" class="h-2 bg-mel-action-secondary absolute top-1/2 -translate-y-1/2 rounded-none" style="left: 54px; right: 54px;"></div>
  
  <!-- Dual range input fields (Hidden visually but kept for state/accessibility) -->
  <input 
    type="range" 
    id="slider-min" 
    min={min} 
    max={max} 
    value={min} 
    class="absolute opacity-0 pointer-events-none w-full h-2 top-1/2 -translate-y-1/2 z-0 outline-none"
  />
  <input 
    type="range" 
    id="slider-max" 
    min={min} 
    max={max} 
    value={max} 
    class="absolute opacity-0 pointer-events-none w-full h-2 top-1/2 -translate-y-1/2 z-0 outline-none"
  />

  <!-- Interactive Slider handlers positioned relative to their tips -->
  <SliderHandler id="min-handle" year={min} direction="left" class="top-1/2 -translate-y-1/2" style="left: 24px;" />
  <SliderHandler id="max-handle" year={max} direction="right" class="top-1/2 -translate-y-1/2" style="right: 24px; left: auto;" />
</div>

<script>
  // Bound only via astro:page-load (see bottom of file), never called directly:
  // a soft Astro navigation away from and back to this page swaps in a fresh
  // #slider-track-wrapper DOM node, but this script tag itself only runs once
  // per real browser load — without re-running init on every page-load, the
  // handles/listeners stay wired to the old, now-detached elements and the
  // freshly-rendered ones never get positioned (they show their unstyled
  // default, which looks "bunched" at the left edge).
  function initTimeSlider() {
  const trackWrapper = document.getElementById('slider-track-wrapper');
  const sliderMin = document.getElementById('slider-min') as HTMLInputElement;
  const sliderMax = document.getElementById('slider-max') as HTMLInputElement;
  const minHandle = document.getElementById('min-handle') as HTMLElement;
  const maxHandle = document.getElementById('max-handle') as HTMLElement;
  const activeFill = document.getElementById('slider-active-fill') as HTMLElement;

  // Cancel listeners bound by a previous init (e.g. from before an earlier
  // soft navigation away from this page) so they don't pile up.
  if ((window as any)._melTimeSliderAbortCtrl) (window as any)._melTimeSliderAbortCtrl.abort();
  const abortCtrl = new AbortController();
  (window as any)._melTimeSliderAbortCtrl = abortCtrl;
  const sig = abortCtrl.signal;

  if (trackWrapper && sliderMin && sliderMax && minHandle && maxHandle && activeFill) {
    const minValSpan = minHandle.querySelector('span') as HTMLSpanElement;
    const maxValSpan = maxHandle.querySelector('span') as HTMLSpanElement;

    // Read live from the <input>'s own min/max — index.astro's
    // calculateDynamicBounds() sets these from the real data range (D-086
    // ronda 6: this used to be a hardcoded 2004/2019 literal, completely
    // disconnected from that dynamic computation — harmless while the data
    // actually spans exactly 2004-2019, but silently wrong the moment it
    // doesn't, e.g. once older/newer events get added, or a future range
    // like 1980-2030). Read fresh each time rather than cached once at
    // init: init-order between this script and index.astro's own isn't
    // guaranteed, and the bounds can legitimately change later (new data).
    const getBounds = () => {
      const min = parseInt(sliderMin.min, 10);
      const max = parseInt(sliderMin.max, 10);
      const MIN_YEAR = Number.isFinite(min) ? min : 2004;
      const MAX_YEAR = Number.isFinite(max) ? max : 2019;
      return { MIN_YEAR, MAX_YEAR, RANGE: MAX_YEAR - MIN_YEAR || 1 };
    };

    // Continuous percentage states (0 to 100). Seeded from the inputs' own
    // values rather than hardcoded to the full range: when index.astro restores
    // a year filter on the way back from an event's detail page, the handles
    // have to land where that range actually is, not at both extremes.
    let minPct = 0;
    let maxPct = 100;
    {
      const { MIN_YEAR, RANGE } = getBounds();
      const v1 = parseInt(sliderMin.value, 10);
      const v2 = parseInt(sliderMax.value, 10);
      if (Number.isFinite(v1)) minPct = ((v1 - MIN_YEAR) / RANGE) * 100;
      if (Number.isFinite(v2)) maxPct = ((v2 - MIN_YEAR) / RANGE) * 100;
    }

    let isDraggingMin = false;
    let isDraggingMax = false;
    let justFinishedDrag = false; // Suppress click right after drag

    const setDraggingClass = (active) => {
      if (active) {
        trackWrapper.classList.add('dragging');
      } else {
        trackWrapper.classList.remove('dragging');
      }
    };

    const render = () => {
      // 96px de margen reservado a cada lado = tirador (min-width 60px) + punta
      // de flecha (12px) + 24px de aire real hasta el borde de pantalla (D-021).
      // El tirador max se ancla por `right` (no `left`): su ancho real crece
      // con el texto del año ("2019" > "2004" en px), así que anclar desde el
      // lado contrario a su borde exterior es lo único que garantiza los 24px
      // exactos sin depender de cuánto mida el contenido.
      minHandle.style.left = `calc(96px + (100% - 192px) * ${minPct / 100} - 72px)`;
      maxHandle.style.left = 'auto';
      maxHandle.style.right = `calc(96px + (100% - 192px) * ${(100 - maxPct) / 100} - 72px)`;

      activeFill.style.left = `calc(96px + (100% - 192px) * ${minPct / 100} - 42px)`;
      activeFill.style.right = `calc(96px + (100% - 192px) * ${(100 - maxPct) / 100} - 42px)`;

      const { MIN_YEAR, RANGE } = getBounds();
      const val1 = Math.round((minPct / 100) * RANGE + MIN_YEAR);
      const val2 = Math.round((maxPct / 100) * RANGE + MIN_YEAR);

      if (minValSpan) minValSpan.textContent = String(val1);
      if (maxValSpan) maxValSpan.textContent = String(val2);
    };

    // Initialize layout
    render();

    // index.astro restaura el rango de años escribiendo directamente en los
    // <input> al volver de una ficha de evento, y el orden de arranque entre
    // los dos scripts de astro:page-load no está garantizado: se expone el
    // repintado para que pueda pedirlo explícitamente después de escribirlos.
    (window as any)._melRenderSlider = () => {
      const { MIN_YEAR, RANGE } = getBounds();
      const v1 = parseInt(sliderMin.value, 10);
      const v2 = parseInt(sliderMax.value, 10);
      if (Number.isFinite(v1)) minPct = ((v1 - MIN_YEAR) / RANGE) * 100;
      if (Number.isFinite(v2)) maxPct = ((v2 - MIN_YEAR) / RANGE) * 100;
      render();
    };

    // D-086 ronda 2: capture the pointer on the handle itself as soon as the
    // drag starts. Without this, a fast touch drag can move far enough per
    // frame that the browser decides the gesture isn't settled on this
    // element anymore and starts treating it as a page scroll/pan attempt
    // instead — the handle and the page then fight over the same gesture,
    // which is what reads as "trembling". setPointerCapture pins every
    // subsequent event for this pointerId to the handle regardless of where
    // the finger actually is on screen, so the browser has no ambiguity to
    // resolve. This is safe here (unlike a previous, reverted attempt) only
    // because position math below already reads from trackWrapper's own
    // rect — a static element that never moves — never from the handle's
    // own current position, so there's no feedback loop between "where the
    // handle is drawn" and "where we think the pointer is".
    let activePointerId = null;
    let activeHandle = null;

    // D-086 ronda 3: the propietario pinned down the actual symptom — not a
    // gesture conflict, but the reported year flickering back and forth
    // between two (sometimes non-adjacent) values while dragging slowly,
    // easing off past ~2016. At a typical mobile width the usable track is
    // only ~13px per year (198px / 15 years at 390px viewport) — a real
    // finger's touch coordinate is nowhere near as stable as a mouse
    // cursor at that resolution, so ordinary contact-area noise between
    // two consecutive touchmove samples is enough to swing the rounded
    // year back and forth on its own, with nothing actually conflicting
    // for the gesture. Exponentially smoothing the raw pointer position
    // before converting it to a year absorbs that per-sample noise —
    // smoothedPct chases the raw pct gradually instead of snapping to it
    // every event, and resets fresh on every new drag so the handle still
    // grabs exactly where the finger lands.
    //
    // D-086 ronda 5: the propietario confirmed most of the actual trembling
    // was the main-thread-blocking issue fixed separately in index.astro
    // (ronda 4, throttling the expensive re-render during drag) — with
    // that fixed, this smoothing is doing more harm than good: it was
    // applying unconditionally to EVERY pointer type, including mouse,
    // which never had a noise problem to begin with (a mouse cursor is
    // precise to the pixel) — visible as a laggy "motion blur" trail on
    // desktop that had never been there before. Smoothing now only kicks
    // in for touch/pen input (checked once per drag, at pointerdown —
    // pointerType doesn't change mid-gesture) and uses a lighter factor,
    // since it's now a secondary safety net rather than the primary fix.
    let smoothedPct = null;
    let isTouchDrag = false;
    const POINTER_SMOOTHING = 0.55; // lower = smoother/more lag, higher = snappier/less filtering — touch only

    // El salto animado del clic en barra (D-235, reimplantado a petición del
    // propietario). La clase solo existe durante el clic y se retira sola;
    // así el arrastre sigue siendo instantáneo (el tirador no puede ir por
    // detrás del dedo) y las escrituras programáticas —restaurar el rango al
    // volver de una ficha— tampoco se animan.
    let saltoTimer = null;
    const animarSalto = () => {
      if (saltoTimer) clearTimeout(saltoTimer);
      trackWrapper.classList.add('salto-animado');
      saltoTimer = setTimeout(() => {
        trackWrapper.classList.remove('salto-animado');
        saltoTimer = null;
      }, 550);
    };

    // Compensación del punto de agarre. El tirador es una caja de ~66px que
    // CUELGA a un lado de su ancla (el piquito marca el año; D-021 fija el
    // -72px para que a pct 0 el borde quede a 24px del margen). El arrastre
    // mapeaba el cursor a la posición ABSOLUTA del año, sin importar por
    // dónde agarraras la caja: pillándola por el centro había ~39px de zona
    // muerta hacia un lado y el cursor viajaba fuera de la caja todo el
    // gesto (medido; siempre fue así, pero el reorden en vivo de D-248 hizo
    // que por fin se notara). Se memoriza al agarrar cuánto dista el cursor
    // del ancla y se resta en cada movimiento: el tirador arranca al primer
    // píxel, se agarre por donde se agarre.
    let agarreOffsetPx = 0;

    const beginDrag = (e, which) => {
      // Si se agarra un tirador a mitad de salto, el salto se corta aquí:
      // con la clase puesta, el arrastre iría con 0.5s de retraso.
      if (saltoTimer) { clearTimeout(saltoTimer); saltoTimer = null; }
      trackWrapper.classList.remove('salto-animado');
      setDraggingClass(true);
      isDraggingMin = which === 'min';
      isDraggingMax = which === 'max';
      activePointerId = e.pointerId;
      activeHandle = which === 'min' ? minHandle : maxHandle;
      smoothedPct = null;
      {
        // Ancla actual del tirador agarrado, en píxeles de pantalla — la
        // misma cuenta que hace rawPct pero del revés.
        const rect = trackWrapper.getBoundingClientRect();
        const pctActual = which === 'min' ? minPct : maxPct;
        const anclaX = rect.left + 96 + (rect.width - 192) * (pctActual / 100);
        agarreOffsetPx = e.clientX - anclaX;
      }
      isTouchDrag = e.pointerType === 'touch' || e.pointerType === 'pen';
      // D-086 ronda 6: index.astro's own drag-time throttle (ronda 4) reads
      // this to decide whether to throttle the expensive filterArchives()
      // re-render — that throttle exists purely for touch's high event
      // rate + weaker mobile CPUs, and was wrongly slowing down mouse
      // drags on desktop too (same class of mistake as the smoothing in
      // ronda 3/5, just in the other file). `.dragging` alone doesn't
      // carry pointer-type info, so it's exposed here explicitly instead
      // of index.astro guessing.
      trackWrapper.dataset.pointerType = isTouchDrag ? 'touch' : 'mouse';
      try { activeHandle.setPointerCapture(e.pointerId); } catch (err) {}
      e.stopPropagation();
      e.preventDefault();
    };

    minHandle.addEventListener('pointerdown', (e) => beginDrag(e, 'min'));
    maxHandle.addEventListener('pointerdown', (e) => beginDrag(e, 'max'));

    // Window level pointermove for absolute robustness
    window.addEventListener('pointermove', (e) => {
      if (!isDraggingMin && !isDraggingMax) return;
      const rect = trackWrapper.getBoundingClientRect();
      // `- agarreOffsetPx`: el cursor manda sobre el ANCLA del tirador
      // conservando la distancia con la que se agarró (ver beginDrag).
      const rawPct = Math.max(0, Math.min(100, ((e.clientX - agarreOffsetPx - rect.left - 96) / (rect.width - 192)) * 100));
      // Mouse input is precise to the pixel — no noise to filter, and
      // smoothing it only adds a laggy trail with nothing to show for it.
      // First sample of a touch drag snaps immediately (no lag grabbing
      // the handle); every one after that eases toward the raw value.
      let pct = rawPct;
      if (isTouchDrag) {
        smoothedPct = smoothedPct === null ? rawPct : smoothedPct + (rawPct - smoothedPct) * POINTER_SMOOTHING;
        pct = smoothedPct;
      }

      const { MIN_YEAR, RANGE } = getBounds();
      if (isDraggingMin) {
        // Clamp: never exceed maxPct
        minPct = Math.min(pct, maxPct);
        const yearVal = Math.round((minPct / 100) * RANGE + MIN_YEAR);
        sliderMin.value = String(yearVal);
        sliderMin.dispatchEvent(new Event('input', { bubbles: true }));
      } else if (isDraggingMax) {
        // Clamp: never go below minPct
        maxPct = Math.max(pct, minPct);
        const yearVal = Math.round((maxPct / 100) * RANGE + MIN_YEAR);
        sliderMax.value = String(yearVal);
        sliderMax.dispatchEvent(new Event('input', { bubbles: true }));
      }
      render();
    }, { signal: sig });

    // Shared cleanup for both a normal release (pointerup) and an aborted
    // gesture (pointercancel — the browser can fire this instead of
    // pointerup on touch, e.g. if it decides mid-gesture to hand the
    // interaction to something else). Before this, only pointerup was
    // handled: a pointercancel left isDraggingMin/Max stuck `true` forever,
    // so pointermove kept moving the handle via JS while the browser had
    // already reclaimed the gesture on its own end — the two visibly
    // fighting is the other half of the "trembling" symptom.
    const endDrag = () => {
      const { MIN_YEAR, RANGE } = getBounds();
      if (isDraggingMin) {
        isDraggingMin = false;
        setDraggingClass(false);
        justFinishedDrag = true;
        const yearVal = Math.round((minPct / 100) * RANGE + MIN_YEAR);
        minPct = ((yearVal - MIN_YEAR) / RANGE) * 100;
        sliderMin.value = String(yearVal);
        sliderMin.dispatchEvent(new Event('change', { bubbles: true }));
      } else if (isDraggingMax) {
        isDraggingMax = false;
        setDraggingClass(false);
        justFinishedDrag = true;
        const yearVal = Math.round((maxPct / 100) * RANGE + MIN_YEAR);
        maxPct = ((yearVal - MIN_YEAR) / RANGE) * 100;
        sliderMax.value = String(yearVal);
        sliderMax.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        return;
      }
      if (activeHandle !== null && activePointerId !== null) {
        try { activeHandle.releasePointerCapture(activePointerId); } catch (err) {}
      }
      activePointerId = null;
      activeHandle = null;
      render();
      // Reset justFinishedDrag after the click event has had a chance to fire
      requestAnimationFrame(() => { justFinishedDrag = false; });
    };

    window.addEventListener('pointerup', endDrag, { signal: sig });
    window.addEventListener('pointercancel', endDrag, { signal: sig });

    // Track Click positioning — suppressed after drags, with cross-over protection
    trackWrapper.addEventListener('click', (e) => {
      // If we just finished a drag, ignore this click entirely
      if (justFinishedDrag) return;

      const target = e.target as HTMLElement;
      if (minHandle.contains(target) || maxHandle.contains(target)) return;

      const { MIN_YEAR, RANGE } = getBounds();
      const rect = trackWrapper.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, ((e.clientX - rect.left - 96) / (rect.width - 192)) * 100));
      const clickedYear = Math.round((pct / 100) * RANGE + MIN_YEAR);

      const val1 = Math.round((minPct / 100) * RANGE + MIN_YEAR);
      const val2 = Math.round((maxPct / 100) * RANGE + MIN_YEAR);

      // Solo el clic en barra viaja animado — ver animarSalto() arriba.
      animarSalto();

      if (Math.abs(clickedYear - val1) < Math.abs(clickedYear - val2)) {
        // Move min handle — but clamp so it never exceeds max
        const clampedYear = Math.min(clickedYear, val2);
        minPct = ((clampedYear - MIN_YEAR) / RANGE) * 100;
        sliderMin.value = String(clampedYear);
        sliderMin.dispatchEvent(new Event('input', { bubbles: true }));
        sliderMin.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        // Move max handle — but clamp so it never goes below min
        const clampedYear = Math.max(clickedYear, val1);
        maxPct = ((clampedYear - MIN_YEAR) / RANGE) * 100;
        sliderMax.value = String(clampedYear);
        sliderMax.dispatchEvent(new Event('input', { bubbles: true }));
        sliderMax.dispatchEvent(new Event('change', { bubbles: true }));
      }
      render();
    });
  }
  }

  document.addEventListener('astro:page-load', initTimeSlider);
</script>

<style>
  /* El slider entero sale de la foto de la raíz de las view transitions
     (D-248). Con el reordenado en vivo durante el arrastre, cada cruce de
     año arranca una transición cuyo crossfade incluía TODA la página — el
     tirador aparecía dos veces: el vivo bajo el dedo y el fantasma de donde
     estaba al arrancar la foto, disolviéndose 320ms (el "halo" grabado por
     el propietario). Nombre propio + grupo a 0s en index.astro (mismo
     remedio que el botón de orden, D-131): la imagen "nueva" de un grupo es
     VIVA, así que el slider se pinta siempre nítido y al día. */
  /* ACOTADO desde D-261: el nombre existe SOLO durante el salto del clic en
     barra (.salto-animado), que es la única transición en la que el slider se
     mueve y su imagen viva debe mandar (el arrastre ya no arranca
     transiciones desde D-251 — va por FLIP). Fijo, sacaba al slider del
     bloque de cabecera como capa aparte en cada navegación entre páginas, y
     con sus reglas de 0s desaparecía DEL TIRÓN mientras el resto de la
     franja se fundía — el trato desigual que el propietario grabó en vídeo.
     Sin nombre, viaja dentro de la foto de #bloque-cabecera como todo lo
     demás. `.dragging` se incluye por si algún camino futuro vuelve a
     arrancar una transición con el dedo puesto: la regla de D-248 (imagen
     viva, sin halo) es exactamente la que querríamos ahí. */
  #slider-track-wrapper.dragging,
  #slider-track-wrapper.salto-animado {
    view-transition-name: mel-slider;
  }

  /* Smooth snapping transitions.
     OJO (D-235): las menciones a #min-handle/#max-handle de estas dos reglas
     están MUERTAS — los tiradores los pinta SliderHandler.astro, otro
     componente, y el ámbito de Astro no les añade el atributo de este
     archivo. Solo #slider-active-fill (que sí es de esta plantilla) las
     recibe. No se "arreglan" volviéndolas globales: eso daría transición al
     arrastre entero, que el propietario marcó como delicado. */
  #slider-active-fill, #min-handle, #max-handle {
    transition: left 0.5s cubic-bezier(0.25, 1, 0.5, 1), right 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Disable transitions while dragging for fluid continuous cursor matching */
  #slider-track-wrapper.dragging #slider-active-fill,
  #slider-track-wrapper.dragging #min-handle,
  #slider-track-wrapper.dragging #max-handle {
    transition: none !important;
  }

  /* Área táctil ampliada de los tiradores (D-253): 12px invisibles por cada
     lado para acertarles a la primera en móvil. Un pseudo-elemento extiende
     la zona de hit de SU elemento, así que el pointerdown sigue naciendo en
     el tirador y beginDrag ni se entera. `:global()` porque los tiradores
     los pinta SliderHandler.astro (la frontera de ámbito de siempre). En la
     franja de 12px pegada al tirador, el clic-en-barra pasa a ser agarre —
     que es justo lo que un dedo esperaba tocando ahí. */
  :global(#min-handle::before),
  :global(#max-handle::before) {
    content: '';
    position: absolute;
    inset: -12px;
  }

  /* El salto del clic en barra, y SOLO él, anima también los tiradores
     (D-235). `:global()` para cruzar la frontera de ámbito hasta
     SliderHandler.astro, pero acotado a `.salto-animado`, que el JS pone al
     pulsar la barra y retira a los 550ms (o al empezar un arrastre). Misma
     curva y duración que el relleno, para que tirador y barra viajen juntos. */
  #slider-track-wrapper.salto-animado :global(#min-handle),
  #slider-track-wrapper.salto-animado :global(#max-handle) {
    transition: left 0.5s cubic-bezier(0.25, 1, 0.5, 1), right 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>
