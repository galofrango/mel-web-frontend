---
import SliderHandler from './SliderHandler.astro';
---
{/* touch-none (D-068): without an explicit touch-action, a touch-drag that
    starts on a handle and moves across the track can ALSO be interpreted by
    the browser as an attempt to pan/scroll the page — the two compete, and
    the handle visibly jitters while the page rubber-bands sideways for an
    instant. JS already handles the entire drag itself (pointermove/pointerup
    on window), so the browser's own touch gesture recognition has nothing
    useful to do here — telling it not to try removes the conflict at the
    source, on both the handles (SliderHandler.astro) and the track. */}
<div id="slider-track-wrapper" class="relative w-full py-8 select-none cursor-pointer touch-none" data-node-id="Slider Bar/Time Slider">
  
  <!-- Inactive Slider Bar Background (8px height, rounded-none, color mel-border) -->
  <div class="h-2 w-full bg-mel-border absolute top-1/2 -translate-y-1/2 rounded-none"></div>
  
  <!-- Active Slider Bar Fill (8px height, rounded-none, action/secondary mel-action-secondary) -->
  <div id="slider-active-fill" class="h-2 bg-mel-action-secondary absolute top-1/2 -translate-y-1/2 rounded-none" style="left: 96px; right: 96px;"></div>
  
  <!-- Dual range input fields (Hidden visually but kept for state/accessibility) -->
  <input 
    type="range" 
    id="slider-min" 
    min="2004" 
    max="2019" 
    value="2004" 
    class="absolute opacity-0 pointer-events-none w-full h-2 top-1/2 -translate-y-1/2 z-0 outline-none"
  />
  <input 
    type="range" 
    id="slider-max" 
    min="2004" 
    max="2019" 
    value="2019" 
    class="absolute opacity-0 pointer-events-none w-full h-2 top-1/2 -translate-y-1/2 z-0 outline-none"
  />

  <!-- Interactive Slider handlers positioned relative to their tips -->
  <SliderHandler id="min-handle" year={2004} direction="left" class="top-1/2 -translate-y-1/2" />
  <SliderHandler id="max-handle" year={2019} direction="right" class="top-1/2 -translate-y-1/2" />
</div>

<script>
  // Bound only via astro:page-load (see bottom of file), never called directly:
  // a soft Astro navigation away from and back to this page swaps in a fresh
  // #slider-track-wrapper DOM node, but this script tag itself only runs once
  // per real browser load — without re-running init on every page-load, the
  // handles/listeners stay wired to the old, now-detached elements and the
  // freshly-rendered ones never get positioned (they show their unstyled
  // default, which looks "bunched" at the left edge).
  function initTimeSlider() {
  const trackWrapper = document.getElementById('slider-track-wrapper');
  const sliderMin = document.getElementById('slider-min') as HTMLInputElement;
  const sliderMax = document.getElementById('slider-max') as HTMLInputElement;
  const minHandle = document.getElementById('min-handle') as HTMLElement;
  const maxHandle = document.getElementById('max-handle') as HTMLElement;
  const activeFill = document.getElementById('slider-active-fill') as HTMLElement;

  // Cancel listeners bound by a previous init (e.g. from before an earlier
  // soft navigation away from this page) so they don't pile up.
  if ((window as any)._melTimeSliderAbortCtrl) (window as any)._melTimeSliderAbortCtrl.abort();
  const abortCtrl = new AbortController();
  (window as any)._melTimeSliderAbortCtrl = abortCtrl;
  const sig = abortCtrl.signal;

  if (trackWrapper && sliderMin && sliderMax && minHandle && maxHandle && activeFill) {
    const minValSpan = minHandle.querySelector('span') as HTMLSpanElement;
    const maxValSpan = maxHandle.querySelector('span') as HTMLSpanElement;

    const MIN_YEAR = 2004;
    const MAX_YEAR = 2019;
    const RANGE = MAX_YEAR - MIN_YEAR; // 15

    // Continuous percentage states (0 to 100)
    let minPct = 0;
    let maxPct = 100;

    let isDraggingMin = false;
    let isDraggingMax = false;
    let justFinishedDrag = false; // Suppress click right after drag

    const setDraggingClass = (active) => {
      if (active) {
        trackWrapper.classList.add('dragging');
      } else {
        trackWrapper.classList.remove('dragging');
      }
    };

    const render = () => {
      // 96px de margen reservado a cada lado = tirador (min-width 60px) + punta
      // de flecha (12px) + 24px de aire real hasta el borde de pantalla (D-021).
      // El tirador max se ancla por `right` (no `left`): su ancho real crece
      // con el texto del año ("2019" > "2004" en px), así que anclar desde el
      // lado contrario a su borde exterior es lo único que garantiza los 24px
      // exactos sin depender de cuánto mida el contenido.
      minHandle.style.left = `calc(96px + (100% - 192px) * ${minPct / 100} - 72px)`;
      maxHandle.style.left = 'auto';
      maxHandle.style.right = `calc(96px + (100% - 192px) * ${(100 - maxPct) / 100} - 72px)`;

      activeFill.style.left = `calc(96px + (100% - 192px) * ${minPct / 100} - 42px)`;
      activeFill.style.right = `calc(96px + (100% - 192px) * ${(100 - maxPct) / 100} - 42px)`;

      const val1 = Math.round((minPct / 100) * RANGE + MIN_YEAR);
      const val2 = Math.round((maxPct / 100) * RANGE + MIN_YEAR);

      if (minValSpan) minValSpan.textContent = String(val1);
      if (maxValSpan) maxValSpan.textContent = String(val2);
    };

    // Initialize layout
    render();

    // D-086 ronda 2: capture the pointer on the handle itself as soon as the
    // drag starts. Without this, a fast touch drag can move far enough per
    // frame that the browser decides the gesture isn't settled on this
    // element anymore and starts treating it as a page scroll/pan attempt
    // instead — the handle and the page then fight over the same gesture,
    // which is what reads as "trembling". setPointerCapture pins every
    // subsequent event for this pointerId to the handle regardless of where
    // the finger actually is on screen, so the browser has no ambiguity to
    // resolve. This is safe here (unlike a previous, reverted attempt) only
    // because position math below already reads from trackWrapper's own
    // rect — a static element that never moves — never from the handle's
    // own current position, so there's no feedback loop between "where the
    // handle is drawn" and "where we think the pointer is".
    let activePointerId = null;
    let activeHandle = null;

    // D-086 ronda 3: the propietario pinned down the actual symptom — not a
    // gesture conflict, but the reported year flickering back and forth
    // between two (sometimes non-adjacent) values while dragging slowly,
    // easing off past ~2016. At a typical mobile width the usable track is
    // only ~13px per year (198px / 15 years at 390px viewport) — a real
    // finger's touch coordinate is nowhere near as stable as a mouse
    // cursor at that resolution, so ordinary contact-area noise between
    // two consecutive touchmove samples is enough to swing the rounded
    // year back and forth on its own, with nothing actually conflicting
    // for the gesture. Exponentially smoothing the raw pointer position
    // before converting it to a year absorbs that per-sample noise without
    // adding perceptible lag — smoothedPct chases the raw pct gradually
    // instead of snapping to it every event, and resets fresh on every new
    // drag so the handle still grabs exactly where the finger lands.
    let smoothedPct = null;
    const POINTER_SMOOTHING = 0.35; // lower = smoother/more lag, higher = snappier/less filtering

    const beginDrag = (e, which) => {
      setDraggingClass(true);
      isDraggingMin = which === 'min';
      isDraggingMax = which === 'max';
      activePointerId = e.pointerId;
      activeHandle = which === 'min' ? minHandle : maxHandle;
      smoothedPct = null;
      try { activeHandle.setPointerCapture(e.pointerId); } catch (err) {}
      e.stopPropagation();
      e.preventDefault();
    };

    minHandle.addEventListener('pointerdown', (e) => beginDrag(e, 'min'));
    maxHandle.addEventListener('pointerdown', (e) => beginDrag(e, 'max'));

    // Window level pointermove for absolute robustness
    window.addEventListener('pointermove', (e) => {
      if (!isDraggingMin && !isDraggingMax) return;
      const rect = trackWrapper.getBoundingClientRect();
      const rawPct = Math.max(0, Math.min(100, ((e.clientX - rect.left - 96) / (rect.width - 192)) * 100));
      // First sample of this drag snaps immediately (no lag grabbing the
      // handle); every one after that eases toward the raw value instead
      // of jumping straight to it, filtering out the touch-noise jitter
      // that was flipping the rounded year back and forth.
      smoothedPct = smoothedPct === null ? rawPct : smoothedPct + (rawPct - smoothedPct) * POINTER_SMOOTHING;
      const pct = smoothedPct;

      if (isDraggingMin) {
        // Clamp: never exceed maxPct
        minPct = Math.min(pct, maxPct);
        const yearVal = Math.round((minPct / 100) * RANGE + MIN_YEAR);
        sliderMin.value = String(yearVal);
        sliderMin.dispatchEvent(new Event('input', { bubbles: true }));
      } else if (isDraggingMax) {
        // Clamp: never go below minPct
        maxPct = Math.max(pct, minPct);
        const yearVal = Math.round((maxPct / 100) * RANGE + MIN_YEAR);
        sliderMax.value = String(yearVal);
        sliderMax.dispatchEvent(new Event('input', { bubbles: true }));
      }
      render();
    }, { signal: sig });

    // Shared cleanup for both a normal release (pointerup) and an aborted
    // gesture (pointercancel — the browser can fire this instead of
    // pointerup on touch, e.g. if it decides mid-gesture to hand the
    // interaction to something else). Before this, only pointerup was
    // handled: a pointercancel left isDraggingMin/Max stuck `true` forever,
    // so pointermove kept moving the handle via JS while the browser had
    // already reclaimed the gesture on its own end — the two visibly
    // fighting is the other half of the "trembling" symptom.
    const endDrag = () => {
      if (isDraggingMin) {
        isDraggingMin = false;
        setDraggingClass(false);
        justFinishedDrag = true;
        const yearVal = Math.round((minPct / 100) * RANGE + MIN_YEAR);
        minPct = ((yearVal - MIN_YEAR) / RANGE) * 100;
        sliderMin.value = String(yearVal);
        sliderMin.dispatchEvent(new Event('change', { bubbles: true }));
      } else if (isDraggingMax) {
        isDraggingMax = false;
        setDraggingClass(false);
        justFinishedDrag = true;
        const yearVal = Math.round((maxPct / 100) * RANGE + MIN_YEAR);
        maxPct = ((yearVal - MIN_YEAR) / RANGE) * 100;
        sliderMax.value = String(yearVal);
        sliderMax.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        return;
      }
      if (activeHandle !== null && activePointerId !== null) {
        try { activeHandle.releasePointerCapture(activePointerId); } catch (err) {}
      }
      activePointerId = null;
      activeHandle = null;
      render();
      // Reset justFinishedDrag after the click event has had a chance to fire
      requestAnimationFrame(() => { justFinishedDrag = false; });
    };

    window.addEventListener('pointerup', endDrag, { signal: sig });
    window.addEventListener('pointercancel', endDrag, { signal: sig });

    // Track Click positioning — suppressed after drags, with cross-over protection
    trackWrapper.addEventListener('click', (e) => {
      // If we just finished a drag, ignore this click entirely
      if (justFinishedDrag) return;

      const target = e.target as HTMLElement;
      if (minHandle.contains(target) || maxHandle.contains(target)) return;

      const rect = trackWrapper.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, ((e.clientX - rect.left - 96) / (rect.width - 192)) * 100));
      const clickedYear = Math.round((pct / 100) * RANGE + MIN_YEAR);

      const val1 = Math.round((minPct / 100) * RANGE + MIN_YEAR);
      const val2 = Math.round((maxPct / 100) * RANGE + MIN_YEAR);

      if (Math.abs(clickedYear - val1) < Math.abs(clickedYear - val2)) {
        // Move min handle — but clamp so it never exceeds max
        const clampedYear = Math.min(clickedYear, val2);
        minPct = ((clampedYear - MIN_YEAR) / RANGE) * 100;
        sliderMin.value = String(clampedYear);
        sliderMin.dispatchEvent(new Event('input', { bubbles: true }));
        sliderMin.dispatchEvent(new Event('change', { bubbles: true }));
      } else {
        // Move max handle — but clamp so it never goes below min
        const clampedYear = Math.max(clickedYear, val1);
        maxPct = ((clampedYear - MIN_YEAR) / RANGE) * 100;
        sliderMax.value = String(clampedYear);
        sliderMax.dispatchEvent(new Event('input', { bubbles: true }));
        sliderMax.dispatchEvent(new Event('change', { bubbles: true }));
      }
      render();
    });
  }
  }

  document.addEventListener('astro:page-load', initTimeSlider);
</script>

<style>
  /* Smooth snapping transitions */
  #slider-active-fill, #min-handle, #max-handle {
    transition: left 0.5s cubic-bezier(0.25, 1, 0.5, 1), right 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Disable transitions while dragging for fluid continuous cursor matching */
  #slider-track-wrapper.dragging #slider-active-fill,
  #slider-track-wrapper.dragging #min-handle,
  #slider-track-wrapper.dragging #max-handle {
    transition: none !important;
  }
</style>
