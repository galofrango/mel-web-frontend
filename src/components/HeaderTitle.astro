---
interface Props {
  hideDivider?: boolean;
}
const { hideDivider = false } = Astro.props;
import Pica from './Pica.astro';
import IconButton from './IconButton.astro';
---
<div id="search-box-container" class="relative h-[48px] transition-all duration-300" data-state="default">
  
  <!-- 1. Default / Header State (Title "|Memoria Electrónica Leonesa") -->
  <!-- V1.2 — la pica va DELANTE del título, no detrás.
       El primer problema del buscador es que no se identifica como tal. El
       segundo, entre quienes sí lo entienden, es que pulsan A LA DERECHA de la
       pica para empezar a escribir —donde iría el texto si el caret estuviera
       esperando— y ahí no hay nada: el botón acaba en la pica y el toque cae al
       vacío. Poniéndola delante, ese mismo gesto instintivo aterriza sobre el
       título, que sí es pulsable.
       No se amplía la zona de click ni se toca el estado activo: solo cambia de
       lado el caret. Es el único cambio de la V1.2. -->
  <button
    id="search-state-default"
    class="flex items-center relative w-fit h-full text-left bg-transparent border-none cursor-pointer select-none outline-none group"
    data-node-id="762:69441"
  >
    <div class="flex items-center relative shrink-0">
      <Pica class="mr-1 group-hover:bg-mel-action-primary transition-colors duration-200" />
      <!-- El título va en `text-tertiary` y no en `primary` para que la pica
           destaque sobre él y el conjunto se lea como un PLACEHOLDER y no como un
           logotipo — que es exactamente el problema de fondo: la gente no
           identifica esto como un buscador (ver insights.md). La pica es lo único
           que insinúa que aquí se escribe, y su parpadeo se nota menos ahora que
           está a la izquierda (antes cerraba la frase, donde la vista acaba de
           leer); restarle peso al texto es lo que la deja llamar la atención.
           Se probó primero `secondary` y el propietario pidió bajar otra talla.

           El colapso a siglas está en 440px y NO en `lg` (1024), donde estaba.
           Medido: el título largo ocupa 300px con Space Grotesk cargada (270 con
           la de reserva, así que la medida es con la fuente buena) y la pica suma
           9px con su margen. La separación real hasta el menú es
           `ventana − 2×padding − ancho del menú − 309`, y con la regla del
           propietario de no bajar nunca de 40px sale:
             <640    padding 24 · menú 40 (icono)        → mínimo 437px
             640–767 padding 48 · menú 40                → mínimo 485px
             768–1023 padding 48 · menú 113 (Menú+icono) → mínimo 558px
             ≥1024   padding 108 · menú 113              → mínimo 678px
           Cada tramo necesita menos de lo que mide su propio suelo, así que el
           título entero cabe en cualquier ancho ≥437px. A 1024 sobraban 215px de
           margen ya en una pantalla de 700. 440 deja 43px de separación (3 de
           colchón) y reutiliza el breakpoint que el proyecto ya usa para el botón
           de ordenación y para la lista en tarjetas.
           Si cambia el texto del título, el del menú o el padding de la página,
           hay que rehacer esta cuenta. -->
      <!-- `font-semibold` (600) y no `font-bold` (700): en `tertiary` las letras
           de "Memoria" se pegaban entre sí. La causa es el `tracking-[-0.44px]`
           —espaciado NEGATIVO— combinado con trazos gruesos: el hueco entre
           letras casi desaparece, y al aclarar el color se pierde el contraste
           que antes ayudaba a separarlas.
           Bajar el peso lo arregla sin tocar el espaciado, y encaja fino porque
           Space Grotesk mantiene los mismos avances entre pesos: medido, el
           título largo mide 299,5px tanto en 700 como en 600 (y 299,3 en 400).
           Trazos más finos en el mismo sitio = hueco visible más ancho.
           Efecto secundario de eso: el cálculo del breakpoint de 440px NO se ve
           afectado por este cambio, el mínimo sigue en 437px.
           Si hiciera falta abrirlo más, la otra palanca es relajar el tracking
           negativo, que es la causa de fondo. -->
      <span class="font-sans font-semibold text-[22px] leading-[28px] tracking-[-0.44px] text-mel-text-tertiary whitespace-nowrap select-none transition-colors duration-200">
        <span class="min-[440px]:hidden">M.E.L.</span><span class="hidden min-[440px]:inline">Memoria Electrónica Leonesa</span>
      </span>
    </div>
  </button>

  <!-- 2. Active Search Input (Placeholder & Filling States) -->
  <div 
    id="search-state-active" 
    class="hidden h-full flex items-center justify-between relative w-full transition-all duration-200"
  >
    <div class="flex flex-1 items-center relative h-full">
      <!-- Caret falso SOLO mientras el campo está vacío (estado placeholder),
           para que se parezca al del título en reposo: mismo 5x24 y mismo
           parpadeo. En cuanto se escribe una letra desaparece y toma el relevo
           el caret NATIVO del navegador — el de verdad, el único que se puede
           poner entre dos letras para corregir y que sigue a las flechas y a la
           selección. Mientras se ve el falso, el nativo se oculta
           (caret-transparent, lo pone el JS) para no ver dos. -->
      <div
        id="search-fake-caret"
        class="hidden absolute left-0 top-1/2 -translate-y-1/2 w-[5px] h-[24px] bg-mel-action-primary animate-mel-cursor pointer-events-none z-10"
        aria-hidden="true"
      ></div>

      <!-- Caret NATIVO del navegador (caret-mel-action-primary), no uno pintado
           a mano. El anterior era un <div> absoluto colocado midiendo el ancho
           del texto con un span espejo: se veía bien escribiendo al final, pero
           era mentira — no se podía poner entre dos letras para corregir, ni
           seguía a las flechas, ni a la selección. El precio de que sea real es
           que su grosor y su parpadeo los decide el navegador; el color sí se
           puede fijar. -->
      <!-- El placeholder va por token (`placeholder:text-mel-text-tertiary`) y no
           con el `#ad858d` a pelo que tenía: es el MISMO color, pero escrito a
           mano se habría quedado atrás el día que se ajuste `text-tertiary` —está
           pendiente por contraste, ver insights.md— y habrían aparecido dos grises
           distintos en la misma cabecera. -->
      <input
        type="text"
        id="search-active-input"
        placeholder="Busca un evento, artista, diseñador discoteca..."
 class="typo-h3 bg-transparent border-none text-mel-action-secondary caret-mel-action-primary placeholder:text-[20px] placeholder:font-normal placeholder:text-mel-text-tertiary placeholder:truncate focus:outline-none w-full py-1 pl-[6px] transition-all duration-200"
        autocomplete="off"
      />
    </div>
    
    <!-- Clear/Close button -->
    <IconButton 
      id="search-clear-btn" 
      icon="x"
      size={40}
      variant="ghost"
      aria-label="Limpiar búsqueda"
    />
  </div>

  <!-- 3. Filled State (Tag style, matching V2 text without background) -->
  <div
    id="search-state-filled"
    class="hidden h-full flex items-center justify-between w-full transition-colors cursor-pointer"
  >
    <div class="flex items-center relative min-w-0 truncate mr-2">
      <span
        id="search-filled-text"
        class="typo-h3 text-mel-action-primary truncate"
      >
        Query
      </span>
    </div>

    <!-- Reset/Close button -->
    <IconButton
      id="search-reset-btn"
      icon="x"
      size={40}
      variant="ghost"
      aria-label="Reiniciar búsqueda"
    />
  </div>

  <!-- Off-screen span matching the placeholder's own font (normal weight,
       not the bold used for typed text) so its rendered width can be used
       as the search box's max-width — see applyContainerWidth(). Lives
       directly under the container (not inside search-state-active) so it's
       measurable even while that state is display:none, e.g. on first load. -->
  <span
    id="search-placeholder-shadow"
    class="absolute left-0 top-0 opacity-0 pointer-events-none whitespace-pre font-sans font-normal text-[22px] tracking-[-0.44px]"
    aria-hidden="true"
  ></span>

</div>
<div class={`h-px bg-mel-border w-full mt-4 ${hideDivider ? 'hidden' : ''}`}></div>

<script>
  function initSearch() {
    const container = document.getElementById('search-box-container');
    const stateDefault = document.getElementById('search-state-default');
    const stateActive = document.getElementById('search-state-active');
    const stateFilled = document.getElementById('search-state-filled');
    
    const activeInput = document.getElementById('search-active-input') as HTMLInputElement;
    const placeholderShadow = document.getElementById('search-placeholder-shadow');
    const fakeCaret = document.getElementById('search-fake-caret');

    const filledText = document.getElementById('search-filled-text');

    const clearBtn = document.getElementById('search-clear-btn');
    const resetBtn = document.getElementById('search-reset-btn');

    if (!container) return;

    // Ceiling for the expanded (active/filled) width: the box should never
    // grow past what the placeholder text itself needs, however much room
    // the row has — it only shrinks below that when space is actually tight.
    // pl-[6px] (input's own left padding) + 40 (clear button, IconButton
    // size=40) are the two other pieces of the box besides the text itself.
    function measurePlaceholderMaxWidth() {
      if (!placeholderShadow || !activeInput) return Infinity;
      placeholderShadow.textContent = activeInput.placeholder;
      return placeholderShadow.getBoundingClientRect().width + 6 + 40;
    }
    const placeholderMaxWidth = measurePlaceholderMaxWidth();

    // Measure the compact (title-only) and expanded (available-but-capped-at-
    // the-placeholder's-own-width) widths in px up front. CSS can't smoothly
    // animate to/from `fit-content`, so we drive the container's width
    // transition between two real numbers instead — that's what lets the
    // underline (100% of container) visibly grow to the right and shrink
    // back to the left instead of snapping.
    let compactWidth = stateDefault?.getBoundingClientRect().width ?? 0;
    let expandedWidth = Math.min(container.parentElement?.clientWidth ?? 0, placeholderMaxWidth);

    function applyContainerWidth() {
      if (!container) return;
      const state = container.getAttribute('data-state');
      container.style.width = `${state === 'default' ? compactWidth : expandedWidth}px`;
    }

    applyContainerWidth();

    function remeasure() {
      if (stateDefault && !stateDefault.classList.contains('hidden')) {
        compactWidth = stateDefault.getBoundingClientRect().width;
      }
      if (container?.parentElement) {
        expandedWidth = Math.min(container.parentElement.clientWidth, placeholderMaxWidth);
      }
      applyContainerWidth();
    }

    window.addEventListener('resize', remeasure);

    // Con el campo vacío se enseña el caret FALSO (grueso y parpadeante, igual
    // que la Pica del título) y se esconde el nativo; en cuanto hay una letra
    // se invierte, porque a partir de ahí hace falta el de verdad para poder
    // colocarse entre caracteres. El hueco de 6px a la izquierda solo existe
    // mientras está el falso: es el sitio que ocupa.
    function ajustarCaret() {
      if (!activeInput) return;
      const vacio = activeInput.value.length === 0;
      activeInput.classList.toggle('pl-[6px]', vacio);
      activeInput.classList.toggle('caret-transparent', vacio);
      if (fakeCaret) fakeCaret.classList.toggle('hidden', !vacio);
    }

    function setState(state: 'default' | 'placeholder' | 'filling' | 'filled', val = "") {
      if (!container) return;

      // Switching directly from one filled term to a different one (e.g.
      // clicking another search-cell-link while a search is already active):
      // retract the underline and briefly fade the text, swap it while
      // retracted, then let it reappear — instead of just snapping the new
      // term in place instantly.
      const prevState = container.getAttribute('data-state');
      if (state === 'filled' && prevState === 'filled' && filledText && filledText.textContent !== val) {
        container.classList.add('search-retracting');
        if (filledText) filledText.style.opacity = '0';
        setTimeout(() => {
          if (filledText) filledText.textContent = val;
          if (activeInput) activeInput.value = val;
          container?.classList.remove('search-retracting');
          if (filledText) filledText.style.opacity = '1';
          dispatchSearch(val);
        }, 180);
        return;
      }

      container.setAttribute('data-state', state);
      applyContainerWidth();

      // Hide all
      stateDefault?.classList.add('hidden');
      stateActive?.classList.add('hidden');
      stateFilled?.classList.add('hidden');

      if (state === 'default') {
        stateDefault?.classList.remove('hidden');
        if (activeInput) activeInput.value = "";
        dispatchSearch("");
      } 
      else if (state === 'placeholder') {
        stateActive?.classList.remove('hidden');
        activeInput?.focus();
        ajustarCaret();
      } 
      else if (state === 'filling') {
        stateActive?.classList.remove('hidden');
        ajustarCaret();
      } 
      else if (state === 'filled') {
        stateFilled?.classList.remove('hidden');
        if (filledText) filledText.textContent = val;
        if (activeInput) activeInput.value = val;
        dispatchSearch(val);
      }
    }

    function dispatchSearch(query: string) {
      window.dispatchEvent(new CustomEvent('mel-search', { detail: { query } }));
    }

    // Event Listeners attached directly
    stateDefault?.addEventListener('click', () => {
      setState('placeholder');
    });

    activeInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (val.length > 0) {
        setState('filling');
      } else {
        setState('placeholder');
      }
      ajustarCaret();
      dispatchSearch(val.trim());
    });

    activeInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = activeInput.value.trim();
        if (val.length > 0) {
          setState('filled', val);
        } else {
          setState('default');
        }
      } else if (e.key === 'Escape') {
        setState('default');
      }
    });

    // Allow clicking on filled text area to edit search query
    stateFilled?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (resetBtn && resetBtn.contains(target)) return;
      
      const val = filledText ? filledText.textContent || "" : "";
      setState('filling');
      if (activeInput) {
        activeInput.value = val;
        activeInput.focus();
        const len = val.length;
        activeInput.setSelectionRange(len, len);
        ajustarCaret();
      }
    });

    // Listen for external search triggers (e.g. from clicking grid/list cell links)
    window.addEventListener('mel-set-search', (e: any) => {
      const query = e.detail.query || "";
      if (query.trim().length > 0) {
        setState('filled', query.trim());
      } else {
        setState('default');
      }
    });

    // On initialization, check if search query parameter exists
    const params = new URLSearchParams(window.location.search);
    const urlQuery = params.get('search');
    if (urlQuery && urlQuery.trim().length > 0) {
      setState('filled', urlQuery.trim());
    } else {
      setState('default');
    }

    // Blur logic: if click outside and empty, return to default
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (container && !container.contains(target)) {
        const currentState = container.getAttribute('data-state');
        if (currentState === 'placeholder' || (currentState === 'filling' && activeInput && activeInput.value.trim() === "")) {
          setState('default');
        }
      }
    });

    function limpiarSearchDeLaUrl() {
      const url = new URL(window.location.href);
      url.searchParams.delete('search');
      url.searchParams.delete('view');
      window.history.replaceState({}, '', url.toString());
    }

    // La X del buscador borra en DOS tiempos, no de golpe. Con algo escrito (o
    // con una búsqueda ya fijada) vacía el campo pero deja el buscador abierto
    // y con el foco puesto: en móvil el teclado no se cierra, que es justo lo
    // que quieres para escribir otra cosa. Solo cuando ya no hay nada que
    // borrar la segunda pulsación cierra del todo, devuelve el título y quita
    // el foco para que baje el teclado.
    function pulsarCerrarBuscador(e) {
      e.stopPropagation();
      const estado = container?.getAttribute('data-state');
      const hayTexto = !!(activeInput && activeInput.value.trim() !== '');
      limpiarSearchDeLaUrl();

      if (estado === 'filled' || hayTexto) {
        if (activeInput) activeInput.value = '';
        setState('placeholder');   // setState hace focus(): el teclado sigue abierto
        dispatchSearch('');
      } else {
        activeInput?.blur();       // baja el teclado antes de replegar
        setState('default');
      }
    }

    clearBtn?.addEventListener('click', pulsarCerrarBuscador);
    resetBtn?.addEventListener('click', pulsarCerrarBuscador);
  }

  // Bind to astro:page-load for View Transitions compatibility
  document.addEventListener('astro:page-load', initSearch);
</script>

<style is:global>
  #search-box-container {
    position: relative;
    /* Fallback for the instant before JS measures and takes over; JS then
       drives width transitions between real px values (see applyContainerWidth). */
    width: fit-content;
    max-width: 100%;
  }

  /* Zona de toque ampliada del título/buscador en reposo (D-1xx: costaba
     acertarlo, sobre todo en el modo "M.E.L." de móvil, donde el título
     colapsado deja mucho hueco muerto a su derecha antes del menú). Un
     ::before absoluto no cambia el tamaño natural del botón (fit-content en
     compactWidth se mide ANTES de que JS aplique nada, y un pseudo-elemento
     posicionado no participa en esa medida), así que es seguro ampliar sin
     tocar el cálculo de anchura del buscador. Sesgado hacia la derecha, no
     simétrico, porque ahí es donde sobra sitio; a la izquierda ya está el
     borde de la página. */
  #search-state-default::before {
    content: '';
    position: absolute;
    top: -12px;
    bottom: -12px;
    left: -8px;
    right: -64px;
  }

  #search-box-container::after {
    content: '';
    position: absolute;
    /* Separado 4px del fondo de la caja y no pegado a él. La caja mide 48px
       mientras la fila del título mide 40, así que el subrayado caía 8px por
       debajo del resto de la fila: se leía lejos del propio buscador y, al
       abrirse, demasiado cerca del slider. */
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--mel-action-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Resting state with hover: line grows right and contracts left.
     Acotado a punteros que de verdad tienen hover: en táctil el navegador deja
     el :hover "pegado" al último elemento tocado hasta que se toca otra cosa,
     así que al cerrar el buscador con la X el subrayado se quedaba puesto aun
     habiendo vuelto al estado de reposo. En escritorio pasaba lo mismo mientras
     el puntero siguiera sobre la caja. */
  @media (hover: hover) and (pointer: fine) {
    #search-box-container[data-state="default"]:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }
  /* Active states: line expands to full width */
  #search-box-container[data-state="placeholder"]::after,
  #search-box-container[data-state="filling"]::after,
  #search-box-container[data-state="filled"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* Switching between two filled search terms: retract toward the right
     first (overriding the rule above), then falls back to it — which grows
     from the left — once the class is removed, giving a retract-then-regrow
     swipe instead of an instant snap. */
  #search-box-container.search-retracting::after {
    transform: scaleX(0) !important;
    transform-origin: right center !important;
    transition: transform 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #search-filled-text {
    transition: opacity 0.18s ease;
  }
</style>
