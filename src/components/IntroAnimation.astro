---
// IntroAnimation.astro
// Premium interactive chromatic aberration offset hover & scroll/Enter triggered split ascension animation.
---

<div 
  id="intro-animation-overlay" 
  class="fixed inset-0 bg-[#f7f3f5] z-[300] flex items-center justify-center overflow-hidden transition-opacity duration-[1000ms] ease-in-out opacity-0 pointer-events-none hidden"
>
  <!-- Animated container keeping a fixed aspect ratio of 1440x1024 to match Figma coordinate space perfectly -->
  <div class="relative w-full max-w-[1440px] h-full max-h-[1024px] aspect-[1440/1024] flex flex-col justify-end p-[108px] select-none">
    
    <!-- Flex column layout to perfectly control spacing and bring elements closer together -->
    <div class="flex flex-col items-start w-full">
      
      <!-- Title Text Layer Container (active for mouse movement hover parallax) -->
      <div id="intro-title-container" class="relative w-full h-[220px] md:h-[420px] cursor-pointer">
        
        <!-- CIAN Layer -->
        <div 
          id="intro-layer-cian"
          class="intro-title-layer absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#00ffff] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply opacity-88"
        >
          <span class="block">Memoria</span>
          <span class="block">Electrónica</span>
          <span class="block">Leonesa</span>
        </div>

        <!-- YELLOW Layer -->
        <div 
          id="intro-layer-yellow"
          class="intro-title-layer absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#ffff00] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply opacity-88"
        >
          <span class="block">Memoria</span>
          <span class="block">Electrónica</span>
          <span class="block">Leonesa</span>
        </div>

        <!-- MAGENTA Layer -->
        <div 
          id="intro-layer-magenta"
          class="intro-title-layer absolute left-0 bottom-0 flex flex-col font-sans font-bold leading-[0.8] text-[13.8vw] md:text-[200px] text-[#ff00ff] tracking-[-0.05em] whitespace-nowrap mix-blend-multiply opacity-95"
        >
          <span class="block">Memoria</span>
          <span class="block">Electrónica</span>
          <span class="block">
            Leonesa<span class="text-[#981932] text-[0.8em] tracking-[-0.05em] font-sans font-bold select-none relative -top-[0.1em] ml-1">®</span>
          </span>
        </div>

      </div>

      <!-- Divider Line: 2px thickness, action secondary color, my-[24px] spacing -->
      <div 
        id="intro-divider"
        class="w-full h-[2px] bg-[var(--mel-action-secondary)] my-[24px] transition-all duration-[1200ms] ease-out opacity-100 scale-x-100 origin-left"
      ></div>

      <!-- Subtitle Container: equidistant from the divider -->
      <div class="flex items-center gap-[12px] h-[48px] shrink-0 font-sans font-normal text-[2.6vw] md:text-[38px] text-[#190609] tracking-[-0.04em] relative w-full">
        <div id="intro-sub-1" class="intro-sub-word translate-y-0">A través</div>
        <div id="intro-sub-2" class="intro-sub-word translate-y-0 ml-[8px]">del diseño</div>
        <div id="intro-sub-3" class="intro-sub-word translate-y-0 ml-[8px]">gráfico</div>
      </div>

    </div>

    <!-- Scroll / Enter Action Callout Indicator -->
    <div 
      id="intro-scroll-indicator" 
      class="absolute bottom-[32px] left-[108px] flex items-center gap-2 font-sans font-medium text-[15px] text-mel-text-secondary opacity-60 transition-opacity duration-500 animate-pulse pointer-events-none"
    >
      <span>Scroll o presiona Enter para comenzar</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </div>

  </div>
</div>

<script>
  let animationStarted = false;
  let activeDissolveTimeout = null;
  let activeCompleteTimeout = null;
  let touchStartY = 0;

  // Mouse physical simulation state
  let lastClientX = null;
  let lastClientY = null;
  let targetX = 0;
  let targetY = 0;
  
  // Render positions
  let cianX = 0, cianY = 0;
  let yellowX = 0, yellowY = 0;
  let magentaX = 0, magentaY = 0;

  // Dom refs
  let overlay, titleContainer, layerCian, layerYellow, layerMagenta, divider, sub1, sub2, sub3, scrollIndicator;
  let animationFrameId = null;

  function runIntroAnimation() {
    overlay = document.getElementById('intro-animation-overlay');
    titleContainer = document.getElementById('intro-title-container');
    layerCian = document.getElementById('intro-layer-cian');
    layerYellow = document.getElementById('intro-layer-yellow');
    layerMagenta = document.getElementById('intro-layer-magenta');
    divider = document.getElementById('intro-divider');
    sub1 = document.getElementById('intro-sub-1');
    sub2 = document.getElementById('intro-sub-2');
    sub3 = document.getElementById('intro-sub-3');
    scrollIndicator = document.getElementById('intro-scroll-indicator');

    if (!overlay) return;

    // Reset state & timeouts
    animationStarted = false;
    targetX = 0;
    targetY = 0;
    cianX = 0; cianY = 0;
    yellowX = 0; yellowY = 0;
    magentaX = 0; magentaY = 0;
    lastClientX = null;
    lastClientY = null;

    if (activeDissolveTimeout) clearTimeout(activeDissolveTimeout);
    if (activeCompleteTimeout) clearTimeout(activeCompleteTimeout);
    if (animationFrameId) cancelAnimationFrame(animationFrameId);

    overlay.classList.remove('hidden');
    overlay.offsetHeight; // Force reflow
    
    // Display intro overlay container
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    overlay.classList.add('opacity-100', 'pointer-events-auto');
    document.body.classList.add('overflow-hidden');

    resetLayersToResting(true);

    if (divider) {
      divider.style.opacity = '1';
      divider.style.transform = 'scaleX(1)';
    }

    if (scrollIndicator) {
      scrollIndicator.style.opacity = '0.6';
    }

    // Set up mouse offset listeners
    if (titleContainer) {
      titleContainer.addEventListener('mousemove', handleTitleMouseMove);
      titleContainer.addEventListener('mouseleave', handleTitleMouseLeave);
      titleContainer.addEventListener('mouseenter', handleTitleMouseEnter);
    }

    // Set up trigger listeners (scroll down, keydown Enter, touch swipe up)
    window.addEventListener('wheel', handleScrollTrigger, { passive: false });
    window.addEventListener('keydown', handleKeyTrigger);
    window.addEventListener('touchstart', handleTouchStart, { passive: true });
    window.addEventListener('touchmove', handleTouchMove, { passive: false });

    // Start physical simulation loop
    animationFrameId = requestAnimationFrame(updatePhysicsLoop);
  }

  function resetLayersToResting(immediate = false) {
    const transition = immediate ? 'none' : 'transform 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 1.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1)';
    [layerCian, layerYellow, layerMagenta, sub1, sub2, sub3].forEach(el => {
      if (el) {
        el.style.transition = transition;
        el.style.transform = 'translate3d(0, 0, 0)';
        if (el.id.includes('cian') || el.id.includes('yellow')) el.style.opacity = '0.88';
        if (el.id.includes('magenta')) el.style.opacity = '0.95';
        el.style.filter = 'none';
      }
    });
  }

  // Mouse move physics loop
  function updatePhysicsLoop() {
    if (animationStarted) return;

    // Decay the target push force slowly to make the return longer (decay rate = 0.94)
    targetX *= 0.94;
    targetY *= 0.94;

    // Slower interpolation rate (lerp = 0.04) for a longer, smoother return transition
    cianX += (targetX - cianX) * 0.04;
    cianY += (targetY - cianY) * 0.04;

    yellowX += (targetX * 0.5 - yellowX) * 0.04;
    yellowY += (targetY * 0.5 - yellowY) * 0.04;

    magentaX += (targetX * 0.25 - magentaX) * 0.04;
    magentaY += (targetY * 0.25 - magentaY) * 0.04;

    // Cyan calculations (max 16px)
    const distCian = Math.sqrt(cianX * cianX + cianY * cianY);
    const blurCian = Math.min(6, (distCian / 16) * 6);
    const opacCian = Math.max(0.3, 0.88 - (distCian / 16) * 0.58);
    if (layerCian) {
      layerCian.style.transform = `translate3d(${cianX}px, ${cianY}px, 0)`;
      layerCian.style.filter = blurCian > 0.1 ? `blur(${blurCian}px)` : 'none';
      layerCian.style.opacity = String(opacCian);
    }

    // Yellow calculations (max 8px)
    const distYellow = Math.sqrt(yellowX * yellowX + yellowY * yellowY);
    const blurYellow = Math.min(4, (distYellow / 8) * 4);
    const opacYellow = Math.max(0.3, 0.88 - (distYellow / 8) * 0.58);
    if (layerYellow) {
      layerYellow.style.transform = `translate3d(${yellowX}px, ${yellowY}px, 0)`;
      layerYellow.style.filter = blurYellow > 0.1 ? `blur(${blurYellow}px)` : 'none';
      layerYellow.style.opacity = String(opacYellow);
    }

    // Magenta calculations (max 4px)
    const distMagenta = Math.sqrt(magentaX * magentaX + magentaY * magentaY);
    const blurMagenta = Math.min(2, (distMagenta / 4) * 2);
    const opacMagenta = Math.max(0.4, 0.95 - (distMagenta / 4) * 0.55);
    if (layerMagenta) {
      layerMagenta.style.transform = `translate3d(${magentaX}px, ${magentaY}px, 0)`;
      layerMagenta.style.filter = blurMagenta > 0.1 ? `blur(${blurMagenta}px)` : 'none';
      layerMagenta.style.opacity = String(opacMagenta);
    }

    animationFrameId = requestAnimationFrame(updatePhysicsLoop);
  }

  function handleTitleMouseEnter(e) {
    lastClientX = e.clientX;
    lastClientY = e.clientY;
    [layerCian, layerYellow, layerMagenta].forEach(l => {
      if (l) l.style.transition = 'none';
    });
  }

  // Capture mouse velocity/direction vector
  function handleTitleMouseMove(e) {
    if (animationStarted) return;

    if (lastClientX === null || lastClientY === null) {
      lastClientX = e.clientX;
      lastClientY = e.clientY;
      return;
    }

    const dx = e.clientX - lastClientX;
    const dy = e.clientY - lastClientY;

    lastClientX = e.clientX;
    lastClientY = e.clientY;

    // Push the layers in the direction of the movement vector
    // Multiply by a factor to make it feel responsive, then clamp to Cyan limit (-16px to 16px)
    targetX = Math.max(-16, Math.min(16, targetX + dx * 0.8));
    targetY = Math.max(-16, Math.min(16, targetY + dy * 0.8));
  }

  function handleTitleMouseLeave() {
    lastClientX = null;
    lastClientY = null;
  }

  // Trigger scroll conditions
  function handleScrollTrigger(e) {
    if (animationStarted) return;
    if (e.deltaY > 5) {
      e.preventDefault();
      startAscension();
    }
  }

  function handleKeyTrigger(e) {
    if (animationStarted) return;
    if (e.key === 'Enter') {
      e.preventDefault();
      startAscension();
    }
  }

  function handleTouchStart(e) {
    if (animationStarted) return;
    touchStartY = e.touches[0].clientY;
  }

  function handleTouchMove(e) {
    if (animationStarted) return;
    const currentY = e.touches[0].clientY;
    if (touchStartY - currentY > 30) {
      e.preventDefault();
      startAscension();
    }
  }

  // Animation timeline trigger
  function startAscension() {
    animationStarted = true;

    // Clean up trigger event listeners
    window.removeEventListener('wheel', handleScrollTrigger);
    window.removeEventListener('keydown', handleKeyTrigger);
    window.removeEventListener('touchstart', handleTouchStart);
    window.removeEventListener('touchmove', handleTouchMove);

    if (titleContainer) {
      titleContainer.removeEventListener('mousemove', handleTitleMouseMove);
      titleContainer.removeEventListener('mouseleave', handleTitleMouseLeave);
      titleContainer.removeEventListener('mouseenter', handleTitleMouseEnter);
    }

    if (animationFrameId) cancelAnimationFrame(animationFrameId);

    // Setup smooth transition styles for the final vertical fly-up
    const transitionStyle = 'transform 2500ms cubic-bezier(0.77, 0, 0.175, 1), opacity 2500ms cubic-bezier(0.77, 0, 0.175, 1), filter 2500ms cubic-bezier(0.77, 0, 0.175, 1)';
    [layerCian, layerYellow, layerMagenta].forEach(l => {
      if (l) {
        l.style.transition = transitionStyle;
        l.style.filter = 'none';
      }
    });
    [sub1, sub2, sub3].forEach(s => {
      if (s) s.style.transition = transitionStyle;
    });

    // Translate layers completely above the top of the viewport
    if (layerYellow) {
      layerYellow.style.opacity = '0.88';
      layerYellow.style.transform = 'translate3d(0, -180vh, 0)';
    }
    if (layerMagenta) {
      layerMagenta.style.opacity = '0.95';
      layerMagenta.style.transform = 'translate3d(0, -140vh, 0)';
    }
    if (layerCian) {
      layerCian.style.opacity = '0.88';
      layerCian.style.transform = 'translate3d(0, -115vh, 0)';
    }

    // Subtitle words fly upward out of the screen
    if (sub1) sub1.style.transform = 'translate3d(0, -115vh, 0)';
    if (sub2) sub2.style.transform = 'translate3d(0, -115vh, 0)';
    if (sub3) sub3.style.transform = 'translate3d(0, -115vh, 0)';

    // Divider line collapses and fades out
    if (divider) {
      divider.style.transform = 'scaleX(0)';
      divider.style.opacity = '0';
    }

    // Scroll hint indicator fades out
    if (scrollIndicator) {
      scrollIndicator.style.opacity = '0';
    }

    // Dissolve Phase
    activeDissolveTimeout = setTimeout(() => {
      if (overlay) {
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        overlay.classList.add('opacity-0', 'pointer-events-none');
      }
      document.body.classList.remove('overflow-hidden');
    }, 1700);

    // Complete Phase
    activeCompleteTimeout = setTimeout(() => {
      if (overlay) overlay.classList.add('hidden');
      window.dispatchEvent(new CustomEvent('mel-switch-view', { detail: { view: 'galería' } }));
    }, 2700);
  }

  // Bind to global trigger events
  window.addEventListener('mel-trigger-intro', runIntroAnimation);

  // Auto-trigger if URL search query contains intro=true
  document.addEventListener('astro:page-load', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('intro') === 'true') {
      try {
        const url = new URL(window.location.href);
        url.searchParams.delete('intro');
        window.history.replaceState({}, '', url.toString());
      } catch (e) {}

      runIntroAnimation();
    }
  });
</script>

<style>
  .intro-title-layer {
    transform-origin: bottom left;
    will-change: transform, filter, opacity;
  }
  .intro-sub-word {
    will-change: transform;
  }
</style>
