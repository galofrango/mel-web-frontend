---
/**
 * Tarjeta de la galería, lado servidor: pinta las primeras 32.
 *
 * MANTENIMIENTO EN ESPEJO (regla 7 de AGENTS.md). A partir de la tarjeta 33, y
 * en cada filtrado, búsqueda, reordenado o lote del scroll infinito, estas
 * tarjetas las rehace `buildGalleryCard()` en el script de index.astro. Las dos
 * TIENEN que decir lo mismo.
 *
 * Y no se puede arreglar con un import: el script de la home lleva
 * `define:vars`, lo que en Astro implica que es un script INLINE, y un script
 * inline no lo procesa Vite — un `import` ahí se queda como texto literal y
 * revienta en el navegador (comprobado). Compartir este marcado de verdad exige
 * cambiar cómo se declara ese script, que es la maquinaria de la que dependen la
 * inicialización por `astro:page-load` y el singleton `window._melState`.
 *
 * Ya se habían separado una vez: aquí faltaba la sombra del DS
 * (`--mel-shadow-sm`, que design-system.md asigna explícitamente a la tarjeta de
 * galería) y allí faltaba el `onerror`.
 *
 * `data-year`, `data-category`, `data-title` y `data-location` estaban aquí y no
 * los leía nadie — ni una regla CSS ni un selector. Por eso su ausencia en la
 * réplica JS nunca dio la cara. Fuera, con sus props.
 */
interface Props {
  title: string;
  date: string;
  image: string;
  /** La misma imagen a varios anchos, para que el navegador elija según la
   *  pantalla. Ver `srcSetDrive` en mel.ts. Vacío = solo `src`, que es lo que
   *  pasa con las imágenes de relleno locales. */
  srcset?: string;
  id: string;
  /** true = esta tarjeta cae en la primera pantalla: la imagen va `eager` y
   *  con `fetchpriority="high"` (D-258). Con todo `lazy`, el navegador
   *  degradaba también las fotos que se ven nada más entrar — que son
   *  exactamente las de la primera impresión. Solo la pone el SSR para las
   *  primeras tarjetas; la réplica `buildGalleryCard()` no la necesita (todo
   *  lo que construye JS es de la tarjeta 33 en adelante o de repintados, que
   *  nunca son primera pantalla) y por eso allí `lazy` fijo NO es divergencia
   *  del espejo. */
  prioridad?: boolean;
}

const { title, date, image, srcset = '', id, prioridad = false } = Astro.props;

/** Cuánto ocupa esta tarjeta en pantalla, por tramos. Es lo que el navegador
 *  necesita para elegir del `srcset` ANTES de maquetar: sin esto supone que la
 *  imagen ocupa el ancho completo de la ventana y se baja la más grande
 *  siempre. La rejilla es de 2 columnas, 3 a partir de `md` y 4 a partir de
 *  `lg`, dentro de un contenedor que no pasa de 1440. */
const TAMANOS = '(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw';
---
<!-- El `view-transition-name` va en LA TARJETA, no en la imagen de dentro.
     Estuvo en la `<img>` y eso hacía que al reordenar volase solo la foto: la
     caja blanca con su sombra se quedaba en la posición vieja haciendo un
     fundido, porque sin nombre propio pertenece al fotograma de la raíz. Se veía
     como marcos blancos fijos por detrás de las fotos en movimiento, y como que
     "las cartas no se mueven" — y era literal, no se movían, solo las fotos.
     Con el nombre aquí viaja la tarjeta entera: fondo, sombra, imagen y
     etiqueta, como un solo objeto. -->
<div
  style={`view-transition-name: flyer-img-${id};`}
  class="gallery-item unsized relative overflow-hidden shadow-[var(--mel-shadow-sm)] bg-white cursor-pointer transition-all duration-300 group hover:z-30"
  data-id={id}
  data-node-id="Grid Image V2"
>
  <!-- Image with referrerpolicy no-referrer to allow anonymous loading of Google Drive links in browsers.
       h-auto: la imagen entera a ancho de columna y ratio original (sin recortes).
       onload publica el ratio real y fija el row-span de la tarjeta en el grid
       (masonry 2.1) — con guarda por si la imagen carga antes que el módulo JS
       (initHomePage repesca las imágenes ya completas). -->
  <img
    src={image}
    srcset={srcset || undefined}
    sizes={srcset ? TAMANOS : undefined}
    alt={title}
    loading={prioridad ? 'eager' : 'lazy'}
    fetchpriority={prioridad ? 'high' : undefined}
    decoding="async"
    referrerpolicy="no-referrer"
    class="w-full h-auto block pointer-events-none"
    onload="window.__melMeasureFlyer && window.__melMeasureFlyer(this)"
    onerror="this.onerror=null; this.src='/flyers/flyer-1.png'; window.__melMeasureFlyer && window.__melMeasureFlyer(this);"
  />

  <!-- RETIRADO (D-234): aquí había una capa de rayas diagonales (`striped-bg`)
       que subía a `opacity-10` en hover. En escritorio se notaba poco, pero
       en móvil el navegador simula el hover al tocar y, sumado al atenuado
       táctil genérico de global.css, las rayas se veían claramente ENCIMA
       del cartel mientras se mantenía pulsado. El propietario lo descartó:
       un archivo de carteles no debe ensuciar el cartel.
       Si algún día se recupera, va también en su gemela `buildGalleryCard()`
       de index.astro (regla 7). -->

  <!-- Figma "Event Info" (node 481:238727): 32px bottom bar in action-secondary,
       title left / date right, justify-between. Title truncates first (min-w-0)
       so the date never gets pushed off on narrow cards. -->
  <div
    class="flyer-label absolute bottom-0 left-0 right-0 h-[32px] bg-mel-action-secondary backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 flex items-center justify-between gap-2 px-4 z-20 shadow-[var(--mel-shadow-flyer-label)]"
  >
    <p class="typo-caption text-mel-text-on-action truncate min-w-0">
      {title}
    </p>
    {date && (
      <p class="typo-caption text-mel-text-on-action shrink-0">
        {date}
      </p>
    )}
  </div>
</div>
