---
interface Props {
  title: string;
  category: string;
  location: string;
  year: number;
  date: string;
  image: string;
  id: string;
}

const { title, category, location, year, date, image, id } = Astro.props;
---
<!-- El `view-transition-name` va en LA TARJETA, no en la imagen de dentro.
     Estuvo en la `<img>` y eso hacía que al reordenar volase solo la foto: la
     caja blanca con su sombra se quedaba en la posición vieja haciendo un
     fundido, porque sin nombre propio pertenece al fotograma de la raíz. Se veía
     como marcos blancos fijos por detrás de las fotos en movimiento, y como que
     "las cartas no se mueven" — y era literal, no se movían, solo las fotos.
     Con el nombre aquí viaja la tarjeta entera: fondo, sombra, imagen y
     etiqueta, como un solo objeto. -->
<div
  style={`view-transition-name: flyer-img-${id};`}
  class="gallery-item unsized relative overflow-hidden bg-white cursor-pointer transition-all duration-300 group hover:z-30"
  data-id={id}
  data-year={year}
  data-category={category}
  data-title={title.toLowerCase()}
  data-location={location.toLowerCase()}
  data-node-id="Grid Image V2"
>
  <!-- Image with referrerpolicy no-referrer to allow anonymous loading of Google Drive links in browsers.
       h-auto: la imagen entera a ancho de columna y ratio original (sin recortes).
       onload publica el ratio real y fija el row-span de la tarjeta en el grid
       (masonry 2.1) — con guarda por si la imagen carga antes que el módulo JS
       (initHomePage repesca las imágenes ya completas). -->
  <img
    src={image}
    alt={title}
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
    class="w-full h-auto block pointer-events-none"
    onload="window.__melMeasureFlyer && window.__melMeasureFlyer(this)"
    onerror="this.onerror=null; this.src='/flyers/flyer-1.png'; window.__melMeasureFlyer && window.__melMeasureFlyer(this);"
  />

  <!-- Blending grid overlay (striped Figma style) -->
  <div class="absolute inset-0 striped-bg opacity-0 group-hover:opacity-10 transition-opacity duration-300 z-10 pointer-events-none"></div>

  <!-- Figma "Event Info" (node 481:238727): 32px bottom bar in action-secondary,
       title left / date right, justify-between. Title truncates first (min-w-0)
       so the date never gets pushed off on narrow cards. -->
  <div
    class="flyer-label absolute bottom-0 left-0 right-0 h-[32px] bg-mel-action-secondary backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 flex items-center justify-between gap-2 px-4 z-20 shadow-[var(--mel-shadow-flyer-label)]"
  >
    <p class="font-sans font-bold text-[12px] leading-[16px] tracking-[0.5px] text-mel-text-on-action truncate min-w-0">
      {title}
    </p>
    {date && (
      <p class="font-serif font-medium text-[12px] leading-[16px] tracking-[0.15px] text-mel-text-on-action shrink-0">
        {date}
      </p>
    )}
  </div>
</div>
