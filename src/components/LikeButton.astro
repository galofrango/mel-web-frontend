---
interface Props {
  id?: string;
  active?: boolean;
  class?: string;
}

const { id, active = false, class: className = "" } = Astro.props;
---
<button
  id={id}
  class={`content-stretch cursor-pointer flex items-center justify-center py-3 px-4 relative select-none outline-none group border typo-caption ${className}`}
  data-active={active ? "true" : "false"}
>
  <!-- Centered Label with color transition. El color de hover/pulsado NO va
       por `group-hover:`/`group-data-[active=true]:group-hover:` (Tailwind):
       vive a mano en el <style> de abajo, gated por puntero, así que aquí solo
       quedan los colores que dependen del estado real (`data-active`), no del
       puntero. -->
  <span class="like-label text-mel-action-secondary group-data-[active=true]:text-mel-text-on-action transition-colors duration-300 select-none pointer-events-none">
    Me presta
  </span>

  <!-- Icon container sliding in from the right (width and opacity transition) -->
  <div class="icon-container flex items-center justify-center overflow-hidden shrink-0 w-0 opacity-0 ml-0 transition-all duration-300 ease-out group-data-[active=true]:w-5 group-data-[active=true]:opacity-100 group-data-[active=true]:ml-2">
    <svg class="like-icon w-4 h-4 text-mel-text-on-action shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
  </div>
</button>

<style>
  /* Border and Background transitions matching Figma and fluid easing specifications */
  button {
    border-color: var(--mel-action-secondary);
    background-color: transparent;
    padding-left: 16px;
    padding-right: 16px;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  button[data-active="true"] {
    border-color: var(--mel-action-secondary);
    background-color: var(--mel-action-secondary);
    color: var(--mel-text-on-action);
  }

  /* El color de hover, tanto este a mano como el `group-hover:` de Tailwind
     que llevaba el label/icono (comprobado en el CSS compilado: ninguno de
     los dos va protegido por `@media (hover:hover)` en esta versión — v4 NO
     lo hace automáticamente), se dispara con el "hover" simulado que el
     móvil aplica al tocar y no lo suelta hasta el siguiente scroll o toque en
     otro sitio. Sin acotar a puntero fino, el botón se quedaba en el color de
     acción primaria pegado. Por eso el label/icono ya no llevan `group-hover:`
     en el marcado — todo el color de puntero vive aquí, dentro del gate. */
  @media (hover: hover) and (pointer: fine) {
    button:hover {
      border-color: var(--mel-action-primary);
    }
    button:not([data-active="true"]):hover .like-label {
      color: var(--mel-action-primary);
    }

    button[data-active="true"]:hover {
      border-color: var(--mel-action-primary);
      background-color: var(--mel-action-primary);
    }
    button[data-active="true"]:hover .like-label,
    button[data-active="true"]:hover .like-icon {
      color: var(--mel-text-on-action-primary);
    }
  }

  /* Su propio pulsado táctil (Figma no lo especifica aparte, así que reutiliza
     el mismo lenguaje visual del hover): al llevar `group`, el atenuado
     genérico de global.css lo da por resuelto y no se aplica — sin esto, en
     táctil se quedaba sin ningún aviso visual al tocar. */
  @media (hover: none) {
    button:active {
      border-color: var(--mel-action-primary);
    }
    button:not([data-active="true"]):active .like-label {
      color: var(--mel-action-primary);
    }

    button[data-active="true"]:active {
      border-color: var(--mel-action-primary);
      background-color: var(--mel-action-primary);
    }
    button[data-active="true"]:active .like-label,
    button[data-active="true"]:active .like-icon {
      color: var(--mel-text-on-action-primary);
    }
  }
</style>
