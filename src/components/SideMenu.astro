---
import IconButton from './IconButton.astro';
---

<!-- Side Menu Backdrop Overlay (Dimming) -->
<div 
  id="side-menu-backdrop" 
  class="fixed inset-0 bg-[var(--mel-dim)] mix-blend-multiply z-[190] opacity-0 pointer-events-none transition-opacity duration-300 hidden"
></div>

<!-- Side Menu Overlay Container -->
<div 
  id="side-menu-container" 
  class="fixed inset-y-0 right-0 w-full max-w-[496px] h-screen bg-mel-bg-primary border-l border-mel-border shadow-[var(--mel-shadow-menu)] z-[200] flex flex-col justify-between transition-all duration-300 transform translate-x-full hidden"
  data-node-id="562:70168"
  data-name="Side Menu"
>
  <!-- Top Content Section -->
  <div class="flex flex-col w-full">
    <!-- Header / Close button (No border). pt-[calc(10vh-40px)] md:pt-[10vh] matches every page header's
         own top offset, and min-h keeps `min-h − pt` constant at 64px (the page
         header's own row height) at every breakpoint, so this close button always
         lands at exactly the same height as the button that opened it — whatever
         that shared pt happens to be tuned to. -->
    <div class="flex items-center pb-[16px] px-[16px] pt-[calc(10vh-40px)] md:pt-[10vh] min-h-[calc(10vh+24px)] md:min-h-[calc(10vh+64px)] shrink-0 w-full">
      <IconButton 
        id="close-side-menu" 
        icon="x"
        variant="ghost"
        aria-label="Cerrar menú"
      />
    </div>
    
    <!-- Title (Figma matches: pb-[32px] pt-[8px] px-[16px] + px-[8px] on inner text) -->
    <div class="flex flex-col gap-[8px] items-start pb-[32px] pt-[8px] px-[16px] shrink-0 w-full relative">
      <p class="font-sans font-bold text-[28px] leading-[32px] tracking-[-0.56px] text-mel-text-primary px-[8px]">
        Menú
      </p>
    </div>
    
    <!-- Menu List (Without divide-y, using absolute offset dividers inside anchors) -->
    <div class="flex flex-col items-start w-full relative" data-node-id="562:70115" data-name="Menu List">
      <!-- Item: Inicio -->
      <a href="/" id="menu-item-home" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Inicio
          </p>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>

      <!-- Item: Intro -->
      <a href="/?intro=true" id="menu-item-intro" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Intro
          </p>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>
      
      <!-- Item: Sala de exposiciones (Figma 562:70116, "Nuevo" tag) -->
      <a href="/exposiciones" id="menu-item-exhibitions" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Sala de exposiciones
          </p>
        </div>
        <div class="bg-mel-action-primary flex items-center gap-1 px-2 py-0.5 shrink-0">
          <span class="font-sans font-medium text-[16px] leading-[20px] text-mel-text-on-action-primary">Nuevo</span>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>
      
      <!-- Item: Proyecto -->
      <a href="/info#proyecto" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Proyecto
          </p>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>
      
      <!-- Item: Equipo -->
      <a href="/info#equipo" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Equipo
          </p>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>
      
      <!-- Item: Contacto -->
      <a href="/info#contacto" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Contacto
          </p>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>
      
      <!-- Item: Apoya el proyecto -->
      <a href="/info#contacto" class="group flex gap-[8px] h-[64px] items-center pl-[16px] pr-[16px] w-full hover:bg-mel-bg-secondary/40 transition-colors duration-200 no-underline relative">
        <div class="flex flex-1 gap-[4px] items-center min-w-px pl-[8px]">
          <p class="font-sans font-medium text-[17px] leading-[24px] tracking-[-0.34px] text-mel-text-primary group-hover:text-mel-action-primary truncate">
            Apoya el proyecto
          </p>
        </div>
        <IconButton size={24} icon="chevron-right" variant="ghost" class="text-mel-action-secondary group-hover:text-mel-action-primary pointer-events-none" />
        <div class="absolute bottom-0 left-[24px] right-[24px] h-[1px] bg-mel-border/30"></div>
      </a>
    </div>
  </div>
  
  <!-- Bottom Footer Section -->
  <div class="px-6 pb-[24px] pt-4 flex gap-[16px] items-end w-full relative" data-node-id="562:70119" data-name="Menu Panel Footer">
    <!-- Color Mode Toggle Button (Moon/Sun) -->
    <button 
      id="color-mode-toggle"
      class="w-10 h-10 bg-mel-action-secondary text-mel-text-on-action flex items-center justify-center cursor-pointer hover:bg-mel-action-primary hover:text-mel-text-on-action-primary transition-colors shrink-0 shadow-[var(--mel-shadow-sm)] border-none"
      aria-label="Cambiar modo color"
      data-node-id="550:69887"
    >
      <!-- Lucide Moon Icon (Active in Light theme) -->
      <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
      <!-- Lucide Sun Icon (Active in Dark theme) -->
      <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
    </button>
    
    <!-- Copy Text -->
    <div class="flex flex-col font-sans font-medium text-[16px] leading-[20px] text-mel-text-secondary select-none" data-node-id="562:70121" data-name="Text">
      <span class="truncate w-[180px]" data-node-id="562:70122">MEL® Web v1.0</span>
      <span class="truncate w-[180px]" data-node-id="562:70123">All rights reserved</span>
    </div>
  </div>
</div>

<script>
  function initSideMenuGlobal() {
    const menuBtn = document.getElementById('menu-btn');
    const sideMenu = document.getElementById('side-menu-container');
    const closeMenuBtn = document.getElementById('close-side-menu');
    const backdrop = document.getElementById('side-menu-backdrop');
    const homeLink = document.getElementById('menu-item-home');
    const introLink = document.getElementById('menu-item-intro');
    const colorToggle = document.getElementById('color-mode-toggle');

    function openMenu() {
      if (sideMenu && backdrop) {
        sideMenu.classList.remove('hidden');
        backdrop.classList.remove('hidden');
        // Force reflow to allow transition
        sideMenu.offsetHeight;
        sideMenu.classList.remove('translate-x-full');
        sideMenu.classList.add('translate-x-0');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        document.body.classList.add('overflow-hidden');
      }
    }

    function closeMenu() {
      if (sideMenu && backdrop) {
        sideMenu.classList.remove('translate-x-0');
        sideMenu.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
          sideMenu.classList.add('hidden');
          backdrop.classList.add('hidden');
        }, 300);
      }
    }

    if (menuBtn) {
      // Remove any existing listeners to prevent multiple fires
      const newMenuBtn = menuBtn.cloneNode(true);
      menuBtn.parentNode?.replaceChild(newMenuBtn, menuBtn);
      newMenuBtn.addEventListener('click', openMenu);
    }

    if (closeMenuBtn) {
      closeMenuBtn.addEventListener('click', closeMenu);
    }

    if (backdrop) {
      backdrop.addEventListener('click', closeMenu);
    }

    if (homeLink) {
      homeLink.addEventListener('click', (e) => {
        if (window.location.pathname === '/') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('mel-switch-view', { detail: { view: 'galería' } }));
          closeMenu();
        }
      });
    }

    if (introLink) {
      introLink.addEventListener('click', (e) => {
        if (window.location.pathname === '/') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('mel-trigger-intro'));
          closeMenu();
        }
      });
    }

    if (colorToggle) {
      // Remove any existing color mode toggle listener
      const newColorToggle = colorToggle.cloneNode(true);
      colorToggle.parentNode?.replaceChild(newColorToggle, colorToggle);
      newColorToggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('mel-color-scheme', isDark ? 'dark' : 'light');
        window.dispatchEvent(new CustomEvent('mel-color-scheme-change', { detail: { isDark } }));
      });
    }
  }

  // astro:page-load also fires on the initial load (ClientRouter is always
  // present via Layout.astro), so it's the single entry point — calling
  // initSideMenuGlobal() directly here too ran it twice per full load and
  // double-bound the close/backdrop/home listeners.
  document.addEventListener('astro:page-load', initSideMenuGlobal);
</script>

<style>
  /* Moon and Sun SVGs visibility based on the dark mode class of <html> */
  #color-mode-toggle .sun-icon {
    display: none;
  }
  #color-mode-toggle .moon-icon {
    display: block;
  }

  :global(.dark) #color-mode-toggle .sun-icon {
    display: block !important;
  }
  :global(.dark) #color-mode-toggle .moon-icon {
    display: none !important;
  }
</style>
