---
/**
 * BottomSheetHeader.astro
 * Cabecera decorativa reutilizable para bottom sheets — Figma "Bottom Sheet
 * Header" (node 269:11222): un tirador de arrastre RECTANGULAR sobre un panel
 * cuya esquina superior derecha está DOBLADA (pliegue de papel / dog-ear).
 *
 * IMPORTANTE — nada en este sitio tiene esquinas redondeadas: ni el tirador ni
 * el panel. El único recurso decorativo del borde superior es este pliegue.
 *
 * El pliegue es una CAPA CLARA superpuesta (dog-ear), NO un recorte del sheet:
 * si recortáramos la esquina se vería el DIM oscuro por el hueco (parecía un
 * agujero, no papel). Al pintar un triángulo claro con la sombra del doblez,
 * se lee como esquina de papel doblada sobre cualquier fondo.
 *
 * Escala en horizontal sin límite (`w-full`): el pliegue mantiene su tamaño
 * fijo en la esquina en vez de deformarse con el ancho.
 */
interface Props {
  notch?: number;      // px del pliegue en la esquina (Figma: 40)
  height?: number;     // px de alto de la franja (Figma: 56)
  handleId?: string;   // id del tirador para engancharle el gesto de arrastre
  class?: string;
}

const { notch = 40, height = 56, handleId, class: className = '' } = Astro.props;
---

<div
  class:list={["relative w-full shrink-0 pointer-events-none", className]}
  style={`height:${height}px`}
  data-node-id="269:11222"
  data-name="Bottom Sheet Header"
>
  <!-- Sombra del pliegue. El pliegue en sí NO se pinta aquí: la esquina está
       recortada de verdad en el propio sheet (clip-path, ver la media query de
       #map-side-panel), igual que en Figma, donde el fondo del sheet ya llega
       con la esquina cortada (`M0 0 H353 L393 40 V64 H0 Z`) y la cara doblada
       es del MISMO color que el papel. Lo único que hace legible el doblez es
       esta sombra por dentro de la diagonal.
       Es un degradado plano en vez del SVG borroso del diseño: mismo primitivo
       de sombra y mismo efecto, sin filtros que repintar en cada frame de la
       animación de entrada del sheet. -->
  <div
    class="absolute top-0 right-0"
    style={`width:${notch}px; height:${notch}px;
            clip-path: polygon(0 0, 0 100%, 100% 100%);
            background: linear-gradient(225deg, rgb(var(--mel-shadow-rgb) / 0.18) ${Math.round(notch * 0.7)}px, transparent ${Math.round(notch * 0.7) + 18}px);`}
    aria-hidden="true"
    data-name="Sombra Pliegue"
  ></div>

  <!-- Tirador: rectángulo recto (SIN redondear), color borde. -->
  <div
    id={handleId}
    class="absolute left-1/2 -translate-x-1/2 w-[80px] h-[5px] bg-mel-border pointer-events-auto cursor-grab active:cursor-grabbing touch-none"
    style="top:16px;"
    data-name="Handler"
  ></div>
</div>
