---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Memoria Electrónica Leonesa - Preservando el patrimonio y la historia de León." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Memoria Electrónica Leonesa</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Google Maps Platform Bootstrap Script -->
    <script is:inline>
      (g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({
        key: "AIzaSyC8cKIwnuJZbtUMkH0QNqTM7AHuxvpcUQo",
        v: "weekly"
      });
    </script>
    
    <!-- Marker Clusterer for Google Maps -->
    <script is:inline src="https://unpkg.com/@googlemaps/markerclusterer/dist/index.min.js"></script>

    <!-- Theme initialization script to prevent flash of light theme -->
    <script is:inline>
      function applyTheme() {
        const savedScheme = localStorage.getItem('mel-color-scheme') || 'light';
        if (savedScheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);



      // Defensive reset: EmptyState's "De acuerdo" button fades document.body
      // to opacity 0 before navigating back — if Astro's own transition ever
      // reuses this same body element across the swap, that inline style
      // would otherwise stick around and leave the destination page blank.
      document.addEventListener('astro:page-load', () => {
        document.body.style.opacity = '';
        document.body.style.transition = '';
      });

      // Hide the browser's native "Save image as…"/"Copy image" context menu
      // on every photo site-wide. This doesn't actually stop someone from
      // getting the file (dev tools, drag-and-drop elsewhere still work),
      // just removes the obvious one-click way.
      document.addEventListener('contextmenu', (e) => {
        if (e.target && e.target.tagName === 'IMG') e.preventDefault();
      });

      // Firefox doesn't support the -webkit-user-drag CSS property (see the
      // global stylesheet), so it needs this JS fallback to actually block
      // dragging a photo out of the page.
      document.addEventListener('dragstart', (e) => {
        if (e.target && e.target.tagName === 'IMG') e.preventDefault();
      });
    </script>

    <!-- Enable Astro View Transitions for dynamic premium navigation page swaps -->
    <ClientRouter />
  </head>
  <body class="bg-mel-bg-primary text-mel-text-primary font-sans min-h-full flex flex-col selection:bg-mel-action-secondary selection:text-white transition-colors duration-300">
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Space Grotesk', sans-serif;
  }

  /* Blocks the browser's native "drag this image out" gesture site-wide,
     alongside the contextmenu prevention above (drag was still possible
     with just that). -webkit-user-drag covers Chrome/Safari; the dragstart
     listener below covers Firefox, which doesn't support that property. */
  img {
    -webkit-user-drag: none;
    user-drag: none;
  }
</style>
