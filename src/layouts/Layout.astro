---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  // Imagen de la vista previa al compartir el enlace (D-303). `ancho` y `alto`
  // son los píxeles REALES de esa URL: con ellos WhatsApp y compañía reservan
  // la caja sin tener que descargarla antes. Sin imagen, la tarjeta sale solo
  // con texto.
  imagen?: { url: string; ancho?: number; alto?: number; alt: string };
}

const { title, description = "Memoria Electrónica Leonesa - Preservando el patrimonio y la historia de León.", imagen } = Astro.props;
const tituloCompleto = `${title} | Memoria Electrónica Leonesa`;
// La dirección «oficial» de la página, sin la parte de `?search=…`: las
// variantes de una misma ficha cuentan como UNA para los buscadores y las
// vistas previas. El dominio sale de `site` en astro.config.mjs; el día que
// haya dominio propio, se cambia solo allí.
// Una página de error no tiene dirección oficial (el 404 fija su estado antes).
const canonica = Astro.response.status === 404 ? null : new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon (D-336): el SVG lleva dentro la versión clara y la oscura; el ICO
         es el respaldo de Safari 18 o anterior. `sizes` en el ICO para que Chrome
         no lo prefiera al SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Pantalla de inicio (D-337): el iPhone usa el apple-touch-icon; Android, el
         manifest (192, 512 y maskable). `display: browser`: se abre como la web
         normal, no como app. theme-color solo lo usa Chrome en Android (Safari 26
         lo ignora); lo cambia applyTheme() según el botón luna/sol. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F6F3F5" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{tituloCompleto}</title>
    {canonica && <link rel="canonical" href={canonica} />}

    <!-- Vista previa al compartir el enlace (D-303): la leen WhatsApp, Telegram,
         Facebook, X, Slack… (`og:` es el estándar Open Graph; `twitter:` lo
         que X sigue pidiendo aparte). Solo el título, la descripción y, si la
         página la da, la imagen. -->
    <meta property="og:site_name" content="Memoria Electrónica Leonesa" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    {canonica && <meta property="og:url" content={canonica} />}
    {imagen && <>
      <meta property="og:image" content={imagen.url} />
      <meta property="og:image:type" content="image/jpeg" />
      {imagen.ancho && imagen.alto ? <>
        <meta property="og:image:width" content={String(imagen.ancho)} />
        <meta property="og:image:height" content={String(imagen.alto)} />
      </> : null}
      <meta property="og:image:alt" content={imagen.alt} />
    </>}
    <meta name="twitter:card" content={imagen ? 'summary_large_image' : 'summary'} />
    
    <!-- Fuentes propias (D-284): Astro las descarga al compilar y las sirve desde
         /_astro; `preload` adelanta las del subconjunto latin. Antes eran una
         hoja de estilos de Google (render-blocking) y dos preconnect. -->
    <Font cssVariable="--font-space-grotesk" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-lora" preload={[{ subset: 'latin' }]} />
    <link rel="preconnect" href="https://maps.googleapis.com">
    <link rel="preconnect" href="https://maps.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://maps.googleapis.com">
    <!-- El dominio del que vienen TODOS los carteles (D-258). Fuentes y mapas
         llevaban preconnect desde siempre; las imágenes —lo más pesado del
         sitio— no, así que la primera foto pagaba DNS+TCP+TLS enteros. Sin
         `crossorigin`: los <img> van en modo no-cors (no llevan atributo
         crossorigin), y un preconnect crossorigin abriría una conexión que
         esas peticiones no pueden reutilizar. -->
    <link rel="preconnect" href="https://lh3.googleusercontent.com">
    
    <!-- Google Maps Platform Bootstrap Script -->
    <script is:inline>
      (g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({
        key: "AIzaSyC8cKIwnuJZbtUMkH0QNqTM7AHuxvpcUQo",
        v: "weekly"
      });
    </script>
    
    <!-- Agrupador de marcadores del mapa (D-291). Copia fija de la 2.6.2, con su
         licencia al lado, servida desde nuestro dominio. Antes venía de unpkg
         sin versión: una redirección al «último» en cada visita, un tercero más
         que ve la IP del visitante y, siendo síncrono en el <head>, ~0,8 s de
         bloqueo del primer pintado. `defer` es seguro: el mapa solo se crea al
         abrir la vista Mapa, mucho después de que se ejecute. Para actualizarlo,
         carpeta nueva con la versión en el nombre, nunca pisar esta. -->
    <script is:inline defer src="/vendor/markerclusterer-2.6.2/index.min.js"></script>

    <!-- Theme initialization script to prevent flash of light theme -->
    <script is:inline>
      function applyTheme() {
        const savedScheme = localStorage.getItem('mel-color-scheme') || 'light';
        if (savedScheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        // Color de la barra de Chrome en Android (D-337): el bg-primary de cada
        // modo (tinted-50 / le-950 en global.css). Tras una navegación suave la
        // etiqueta llega del SSR con el claro, por eso se repite en after-swap.
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', savedScheme === 'dark' ? '#190609' : '#F6F3F5');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
      window.addEventListener('mel-color-scheme-change', applyTheme);



      // Defensive reset: EmptyState's "De acuerdo" button fades document.body
      // to opacity 0 before navigating back — if Astro's own transition ever
      // reuses this same body element across the swap, that inline style
      // would otherwise stick around and leave the destination page blank.
      document.addEventListener('astro:page-load', () => {
        document.body.style.opacity = '';
        document.body.style.transition = '';
      });

      // Hide the browser's native "Save image as…"/"Copy image" context menu
      // on every photo site-wide. This doesn't actually stop someone from
      // getting the file (dev tools, drag-and-drop elsewhere still work),
      // just removes the obvious one-click way.
      document.addEventListener('contextmenu', (e) => {
        if (e.target && e.target.tagName === 'IMG') e.preventDefault();
      });

      // Firefox doesn't support the -webkit-user-drag CSS property (see the
      // global stylesheet), so it needs this JS fallback to actually block
      // dragging a photo out of the page.
      document.addEventListener('dragstart', (e) => {
        if (e.target && e.target.tagName === 'IMG') e.preventDefault();
      });
    </script>

    <!-- Enable Astro View Transitions for dynamic premium navigation page swaps -->
    <ClientRouter />
    <script>
      import { navigate } from 'astro:transitions/client';
      (window as any).__melNavigate = navigate;
    </script>

    <!-- Marquee compartido (D-233). Estaba duplicado a mano en el script de
         index.astro y en el de event/[id].astro, con la trampa de siempre:
         dos copias que se separan. Aquí NO aplica la regla 7 de AGENTS.md —
         esa regla habla de los scripts con `define:vars`, que Astro sirve en
         línea y por eso no pueden importar nada. Este `<script>` sí pasa por
         Vite, así que puede vivir una sola vez y dejar la función colgada de
         `window` para que ambas páginas la llamen desde su `astro:page-load`.
         El CSS ya vivía en global.css; ahora la medición también es única. -->
    <script>
      // Velocidad constante del deslizado, en píxeles por segundo: el
      // recorrido manda, así un texto el doble de largo tarda el doble
      // (teletipo de bolsa, criterio del propietario).
      const MARQUEE_PX_POR_SEGUNDO = 55;
      // La vuelta sigue siendo más rápida que la ida, pero menos que antes
      // (era 0.55): el propietario pidió que su frenada "durase más". Va como
      // proporción y no como un fijo para que un recorrido largo no vuelva de
      // un parpadeo. La curva de la vuelta también decelera durante más
      // tramo que la de ida — ver global.css.
      const MARQUEE_FACTOR_VUELTA = 0.7;
      // Por debajo de esto no merece la pena deslizar nada: son sobras de
      // redondeo o un par de píxeles que ya se leen. Sin el umbral, celdas
      // que desbordan 3-4px hacían un tirón de una décima de segundo, que se
      // ve como un temblor y no como una revelación.
      // Antes eran 8px, para que un sobrante de tres o cuatro no diera un tirón
      // de una décima que se lee como un temblor. El propietario pidió que se
      // aplique siempre, así que el umbral baja a lo mínimo (por debajo de esto
      // son sobras de redondeo, no texto) y de que no tiemble se encarga ahora
      // MARQUEE_MINIMO_S: un recorrido corto se hace despacio en vez de no
      // hacerse. Es mejor arreglo que el umbral, porque el problema nunca fue la
      // distancia sino la duración.
      const MARQUEE_MINIMO_PX = 2;
      // Suelo de duración de la ida, en segundos.
      const MARQUEE_MINIMO_S = 0.25;

      (window as any).melMedirMarquee = function (raiz?: Element | Document | null) {
        const ambito: Element | Document = (raiz as any) || document;
        ambito.querySelectorAll('.marquee-cell').forEach((cell) => {
          const celda = cell as HTMLElement;
          const inner = celda.querySelector('.marquee-inner') as HTMLElement | null;
          if (!inner) return;

          // Ancho ÚTIL (sin el padding de la celda) y NO `clientWidth`: en la
          // tabla el padding son 32px (`px-4`), y medir con clientWidth dejaba
          // justo esos 32px de texto sin llegar a verse, además de no marcar
          // como desbordadas celdas que sí se truncan.
          const es = getComputedStyle(celda);
          const util = celda.clientWidth
            - parseFloat(es.paddingLeft || '0')
            - parseFloat(es.paddingRight || '0');

          inner.classList.remove('is-overflowing');
          // `util > 0` descarta las celdas que aún no tienen caja (vista
          // oculta, primer render): ahí clientWidth es 0 y marcarlas daría
          // un desbordamiento falso en todas.
          const recorrido = inner.scrollWidth - util;
          if (util > 0 && recorrido > MARQUEE_MINIMO_PX) {
            inner.classList.add('is-overflowing');
            const ida = Math.max(recorrido / MARQUEE_PX_POR_SEGUNDO, MARQUEE_MINIMO_S);
            celda.style.setProperty('--marquee-duration', ida + 's');
            celda.style.setProperty('--marquee-return', (ida * MARQUEE_FACTOR_VUELTA) + 's');
            celda.style.setProperty('--cell-width', util + 'px');
            // El recorte tiene que ocurrir en la caja de CONTENIDO, no en la
            // de padding: si no, el texto se desliza por debajo del padding
            // izquierdo y acaba pegado al borde de la celda, sin respiro.
            celda.style.setProperty('--marquee-pad-l', (parseFloat(es.paddingLeft || '0')) + 'px');
            celda.style.setProperty('--marquee-pad-r', (parseFloat(es.paddingRight || '0')) + 'px');
          }
        });
      };
    </script>

    <script is:inline>
      // Precarga de páginas que funciona también en el iPhone (D-299).
      //
      // Las tarjetas, las filas y la ficha vecina se precargaban con
      // `<link rel="prefetch">`, y Safari NO lo entiende: lo ignora en
      // silencio. Y en un iPhone todos los navegadores son Safari por dentro
      // (Apple obliga a usar su motor, WebKit), Chrome incluido. Así que la
      // precarga al posar el dedo (D-161) no existía en ningún iPhone: la
      // ficha empezaba a pedirse al soltar. Donde el navegador no entiende
      // `prefetch`, se pide con `fetch`, igual que hace el propio Astro con su
      // precarga; la respuesta (`max-age=60`, D-259) queda en la caché del
      // navegador y la navegación la reutiliza.
      //
      // Lo que Astro no hace y aquí hace falta: un toque dura ~100-150 ms y una
      // ficha en frío tarda más en llegar, así que al soltar el dedo la
      // precarga suele estar A MEDIAS. La navegación pediría la misma página
      // otra vez, en paralelo, y no se ganaría nada. Por eso, si hay una
      // precarga de la página a la que se va, el cargador de Astro (`e.loader`,
      // sustituible en `astro:before-preparation`) la espera y se la entrega
      // tal cual: durante esa carga, el `fetch` de esa misma dirección devuelve
      // la página ya descargada. No se fía de la caché del navegador porque en
      // las ventanas privadas de WebKit no la hay (medido: dos `fetch` seguidos
      // de la misma ficha salían los dos a la red), y ahí la espera solo habría
      // servido para pedirla dos veces. El resto lo hace el cargador de Astro de
      // siempre (leer la página, esperar a sus estilos…), sin copiarlo aquí.
      //
      // Una vez por documento: este script no se reevalúa en las navegaciones
      // suaves; la bandera evita duplicados si alguna vez lo hiciera.
      (function () {
        if (window.__melPrecargar) return;
        var prueba = document.createElement('link');
        var conLink = !!(prueba.relList && prueba.relList.supports && prueba.relList.supports('prefetch'));
        var enCurso = new Map();   // URL absoluta, sin # → { p: promesa, t: cuándo se pidió }
        var VIGENCIA_MS = 60000;   // el max-age de las páginas (D-259)
        // Prioridad: en una pantalla táctil, normal — se precarga lo que se va a
        // tocar enseguida (la foto bajo el dedo, las vecinas de la ficha), y en
        // «baja» esperaría detrás de las fotos que aún cargan: medido en el
        // iPhone del propietario, una vecina en baja tardó 945 ms en llegar
        // (las demás, 90-180) porque el carrusel seguía descargando. Solo va en
        // baja lo que dispara el ratón al pasar por la galería en Safari de
        // ordenador, que es una suposición y no un toque.
        var tactil = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
        var ultimoToque = 0;
        addEventListener('touchstart', function () { ultimoToque = Date.now(); }, { passive: true, capture: true });
        function clave(url) {
          var u = new URL(url, location.href);
          u.hash = '';
          return u.href;
        }
        // Con «ahorro de datos» activado en el móvil, no se precarga nada.
        var ahorro = !!(navigator.connection && navigator.connection.saveData);
        // Precargas lanzadas durante el toque en curso: si el dedo acaba
        // desplazando la página en vez de tocar, se cancelan (abajo). Empezar
        // a desplazar con el dedo sobre una foto o un enlace no debe gastar
        // datos en una página que nadie va a abrir.
        var delToque = [];
        window.__melPrecargar = function (url) {
          if (!url || ahorro) return;
          var k;
          try { k = clave(url); } catch (e) { return; }
          if (conLink) {
            // Por la dirección completa: la misma página puede llegar escrita
            // de dos formas (relativa desde la ficha, absoluta desde un enlace).
            var ya1 = document.head.querySelectorAll('link[rel="prefetch"]');
            for (var i = 0; i < ya1.length; i++) if (ya1[i].href === k) return;
            var l = document.createElement('link');
            l.rel = 'prefetch';
            l.href = k;
            document.head.appendChild(l);
            return;
          }
          // Fuera las caducadas: cada copia es una página entera (~160 KB) y
          // pasando el ratón por la galería se acumularían decenas.
          var ya = Date.now();
          enCurso.forEach(function (v, c) { if (ya - v.t >= VIGENCIA_MS) enCurso.delete(c); });
          if (enCurso.has(k)) return;
          var conDedo = tactil || Date.now() - ultimoToque < 100;
          var corte = window.AbortController ? new AbortController() : null;
          if (Date.now() - ultimoToque < 100) delToque.push({ k: k, corte: corte });
          var opciones = conDedo ? {} : { priority: 'low' };
          if (corte) opciones.signal = corte.signal;
          // Solo se guarda una respuesta buena y directa; con cualquier otra
          // cosa la navegación la pide de nuevo, como siempre.
          enCurso.set(k, {
            t: Date.now(),
            p: fetch(k, opciones).then(function (r) {
              if (!r.ok || r.redirected) return null;
              var tipo = r.headers.get('content-type') || 'text/html';
              return r.text().then(function (html) { return { html: html, tipo: tipo }; });
            }).catch(function () { return null; }),
          });
        };
        // Los enlaces internos se precargan aquí, no con la precarga de Astro
        // (apagada en astro.config.mjs, ver allí por qué): al posar el dedo, y
        // con ratón tras 80 ms encima, como hacía Astro. Así la X de la ficha,
        // las etiquetas o el menú adelantan su página igual que las tarjetas,
        // y la navegación se la queda en vez de pedirla otra vez.
        function enlaceInterno(el) {
          var a = el && el.closest ? el.closest('a[href]') : null;
          if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download') || a.hasAttribute('data-astro-reload')) return null;
          var h = a.getAttribute('href');
          if (!h || h.charAt(0) === '#') return null;
          var u;
          try { u = new URL(a.href, location.href); } catch (e) { return null; }
          if (u.origin !== location.origin) return null;
          if (u.pathname === location.pathname && u.search === location.search) return null;
          return u.href;
        }
        var x0 = 0, y0 = 0;
        addEventListener('touchstart', function (e) {
          delToque = [];
          var t = e.touches && e.touches[0];
          if (t) { x0 = t.clientX; y0 = t.clientY; }
          var u = enlaceInterno(e.target);
          if (u) window.__melPrecargar(u);
        }, { passive: true, capture: true });
        // El dedo se mueve más que un temblor (el mismo umbral de 8 px que
        // `mel-desplazando`): era un desplazamiento, no un toque. Fuera las
        // precargas de este toque que aún no hayan llegado.
        addEventListener('touchmove', function (e) {
          if (!delToque.length) return;
          var t = e.touches && e.touches[0];
          if (!t || (Math.abs(t.clientX - x0) <= 8 && Math.abs(t.clientY - y0) <= 8)) return;
          delToque.forEach(function (d) {
            if (d.corte) d.corte.abort();
            enCurso.delete(d.k);
          });
          delToque = [];
        }, { passive: true });
        var intencion = null;
        addEventListener('pointerover', function (e) {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(intencion);
          var u = enlaceInterno(e.target);
          if (u) intencion = setTimeout(function () { window.__melPrecargar(u); }, 80);
        }, { passive: true });
        addEventListener('pointerout', function (e) {
          if (e.pointerType === 'mouse') clearTimeout(intencion);
        }, { passive: true });
        // Un clic más rápido que los 80 ms: se precarga al pulsar, y la
        // navegación que viene detrás se la queda (si no, el reloj saltaría
        // después y pediría la página otra vez).
        addEventListener('pointerdown', function (e) {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(intencion);
          var u = enlaceInterno(e.target);
          if (u) window.__melPrecargar(u);
        }, { passive: true, capture: true });
        // Con el teclado, al llegar al enlace (como hacía Astro).
        document.addEventListener('focusin', function (e) {
          var u = enlaceInterno(e.target);
          if (u) window.__melPrecargar(u);
        }, { passive: true });

        document.addEventListener('astro:before-preparation', function (e) {
          var k = clave(e.to.href);
          var previa = enCurso.get(k);
          // Ni para enviar un formulario (no hay ninguno hoy, pero sería
          // devolver la página en vez de enviarlo) ni con una copia caducada.
          // La caducidad se mira con el reloj y no con un temporizador: en una
          // pestaña en segundo plano del iPhone los temporizadores se paran.
          if (!previa || e.formData || Date.now() - previa.t >= VIGENCIA_MS) return;
          // No se borra al usarla: si una navegación cancela a otra hacia la
          // misma página (un doble toque), la segunda también la aprovecha.
          var cargar = e.loader;
          e.loader = function () {
            return previa.p.then(function (pagina) {
              if (!pagina || e.signal.aborted) return cargar();
              // El cargador de Astro llega a su `fetch` sin esperar a nada, así
              // que el préstamo se pone y se quita en el mismo instante.
              var real = window.fetch;
              var prestamo = function (pedido) {
                var dir = pedido && pedido.url ? pedido.url : String(pedido);
                if (clave(dir) === k) {
                  window.fetch = real;
                  window.__melUltimaPrecargada = k;   // lo lee el cronómetro (crono.js)
                  return Promise.resolve(new Response(pagina.html, { headers: { 'content-type': pagina.tipo } }));
                }
                return real.apply(this, arguments);
              };
              window.fetch = prestamo;
              return Promise.resolve(cargar()).finally(function () {
                if (window.fetch === prestamo) window.fetch = real;
              });
            });
          };
        });
      })();
    </script>

    <script is:inline>
      // Los estilos que Google Maps mete en la cabecera sobreviven a la
      // navegación (D-301). Google los añade al <head> UNA vez, al crear el
      // primer mapa (7 <style> y 2 <link> de fuentes: sus controles, los
      // marcadores, los atajos de teclado…), y Astro, al cambiar de página,
      // borra de la cabecera todo lo que la página nueva no trae. Al volver al
      // mapa, sin esos estilos, las imágenes de los botones de zoom caían bajo
      // la regla general de Tailwind (`img { display:block; max-width:100% }`):
      // se apilaban las de cada estado y el «+»/«−» se descuadraban. Es el
      // problema 17 del roadmap; pasaba también antes de D-300.
      //
      // Cómo se reconocen sin depender de sus nombres (cambian, y dos ni llevan
      // «gm-»): lo que está en la cabecera al terminar de cargar la página, o
      // justo después de cada cambio de página, es nuestro; lo que aparece
      // después lo ha puesto otro. Justo antes de cada cambio, a lo ajeno se le
      // da una marca de persistencia de Astro y se le pone pareja en la página
      // entrante: Astro conserva el elemento que tiene pareja. Los estilos que
      // inyecta el servidor de desarrollo (`data-vite-dev-id`) se dejan a Astro.
      (function () {
        if (window.__melTercerosListo) return;
        window.__melTercerosListo = true;
        var propios = new WeakSet();
        var n = 0;
        function marcarPropios() {
          for (var i = 0; i < document.head.children.length; i++) {
            var el = document.head.children[i];
            // Los ajenos ya conservados siguen siendo ajenos en la página nueva.
            if ((el.getAttribute('data-astro-transition-persist') || '').indexOf('mel-terceros-') === 0) continue;
            propios.add(el);
          }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', marcarPropios);
        else marcarPropios();
        document.addEventListener('astro:after-swap', marcarPropios);
        function conservarAjenos(nuevoDoc) {
          var hijos = Array.prototype.slice.call(document.head.children);
          hijos.forEach(function (el) {
            if (propios.has(el) || el.hasAttribute('data-vite-dev-id')) return;
            if (!el.matches('style, link[rel="stylesheet"]')) return;
            var id = el.getAttribute('data-astro-transition-persist');
            // Con una marca de persistencia que no es nuestra, manda quien la puso.
            if (id && id.indexOf('mel-terceros-') !== 0) return;
            if (!id) {
              id = 'mel-terceros-' + (++n);
              el.setAttribute('data-astro-transition-persist', id);
            }
            var pareja = nuevoDoc.createElement('meta');
            pareja.setAttribute('data-astro-transition-persist', id);
            nuevoDoc.head.appendChild(pareja);
          });
        }
        // Se marca DENTRO del intercambio y no al avisar de él: sin transiciones
        // nativas, Astro espera a su animación entre el aviso y el intercambio,
        // y un estilo que Google añadiera en ese hueco se perdería.
        document.addEventListener('astro:before-swap', function (e) {
          var intercambiar = e.swap;
          e.swap = function () {
            conservarAjenos(e.newDocument);
            return intercambiar.apply(this, arguments);
          };
        });
      })();
    </script>

    <script is:inline>
      // Cronómetro en pantalla (D-299), APAGADO para todo el mundo. Se
      // enciende abriendo cualquier página con `?crono` y dura lo que la
      // pestaña; `?crono=0` (o su ×) lo apaga. Solo entonces se descarga
      // `/crono.js`: a un visitante normal no le cuesta nada. Para medir en un
      // teléfono de verdad, sin cable, dónde se va el tiempo de cada navegación.
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('crono');
          if (q !== null) {
            if (q === '0') sessionStorage.removeItem('mel-crono');
            else sessionStorage.setItem('mel-crono', '1');
          }
          if (sessionStorage.getItem('mel-crono') !== '1') return;
        } catch (e) { return; }
        var s = document.createElement('script');
        s.src = '/crono.js';
        s.defer = true;
        document.head.appendChild(s);
      })();
    </script>

    <script is:inline>
      // Nada se ve pulsado mientras el dedo está desplazando. El navegador
      // enciende `:active` en cuanto tocas y lo mantiene durante todo el gesto,
      // así que arrastrar para hacer scroll sobre una lista dejaba sus filas
      // iluminadas como si estuvieran a punto de abrirse. En cuanto el dedo se
      // mueve más que un temblor, se marca la raíz y el CSS anula el pulsado
      // (ver `html.mel-desplazando` en global.css).
      //
      // Va en el layout y no en cada página: es comportamiento de todo el sitio.
      // Se registra una sola vez — este script no se reevalúa en las
      // navegaciones suaves, pero la bandera evita duplicados si alguna vez lo
      // hiciera.
      (function () {
        if (window.__melPulsadoListo) return;
        window.__melPulsadoListo = true;
        var y0 = null, x0 = null;
        var UMBRAL = 8;   // por debajo de esto es un dedo quieto, no un arrastre
        addEventListener('touchstart', function (e) {
          var t = e.touches[0];
          y0 = t.clientY; x0 = t.clientX;
          document.documentElement.classList.remove('mel-desplazando');
        }, { passive: true });
        addEventListener('touchmove', function (e) {
          if (y0 === null) return;
          var t = e.touches[0];
          if (Math.abs(t.clientY - y0) > UMBRAL || Math.abs(t.clientX - x0) > UMBRAL) {
            document.documentElement.classList.add('mel-desplazando');
          }
        }, { passive: true });
        addEventListener('touchend', function () {
          y0 = null; x0 = null;
          // Se retira en el fotograma siguiente: quitarla en el acto deja que el
          // `:active` residual del navegador pinte un parpadeo al levantar.
          requestAnimationFrame(function () {
            document.documentElement.classList.remove('mel-desplazando');
          });
        }, { passive: true });

        // --- Pulsado que sobrevive al dedo (solo táctil) -------------------
        // En un teléfono `:active` se apaga en cuanto levantas el dedo, así que
        // si la acción tarda —cargar una ficha, cerrar una página— te quedas
        // mirando sin saber si has acertado a pulsar. Al soltar se fija
        // `.mel-pulsado`, que cada componente del DS pinta igual que su estado
        // pulsado (ver lib/ds.ts), y ahí se queda hasta que pasa algo.
        //
        // Solo táctil: se cuelga de `touchend`, que un ratón no dispara. En
        // escritorio esto no llega a existir, que es donde no hace falta porque
        // el puntero no tapa el botón y la espera se lee en el cursor.
        //
        // Las cuatro formas de quedarse pegado, y su respuesta:
        //  - El toque acaba siendo un scroll → ya hay bandera para eso
        //    (`mel-desplazando`), se reutiliza en vez de medir otra vez.
        //  - El dedo se va del botón antes de soltar → se comprueba dónde cae.
        //  - La acción no cambia de página, o la vuelta restaura esta → se
        //    barre en los eventos de navegación y en `pageshow`.
        //  - La acción falla o tarda una barbaridad → reloj de seguridad.
        var PULSADO = 'mel-pulsado';
        var SEGURIDAD_MS = 4000;
        var relojPulsado = null;
        var candidato = null;

        function limpiarPulsado() {
          clearTimeout(relojPulsado);
          relojPulsado = null;
          var marcados = document.querySelectorAll('.' + PULSADO);
          for (var i = 0; i < marcados.length; i++) marcados[i].classList.remove(PULSADO);
        }

        addEventListener('touchstart', function (e) {
          limpiarPulsado();   // un toque nuevo cancela el anterior
          // Las tarjetas de la galería no son botones (son `div` con un clic),
          // así que se nombran aparte (D-299). Sin esto su único pulsado era
          // el "hover" que el móvil se inventa al tocar, con 300 ms de
          // transición: desde que la ficha llega antes (París, D-298) la página
          // se congela para la transición antes de que se vea.
          // `[data-mel-tocable]` (D-299): una caja entera que responde al toque
          // aunque el enlace de dentro sea pequeño (Anterior/Siguiente de la
          // ficha). Manda sobre el enlace: se marca la caja, que es lo tocado.
          candidato = e.target && e.target.closest
            ? (e.target.closest('[data-mel-tocable]') || e.target.closest('button, a[href], [role="button"], .gallery-item'))
            : null;
        }, { passive: true, capture: true });

        addEventListener('touchend', function (e) {
          var boton = candidato;
          candidato = null;
          if (!boton) return;
          // Lo que actúa sin cambiar de página (`data-mel-instantaneo`, D-338)
          // no espera nada: con su `:active` mientras dura el dedo basta. Si se
          // marcara, se quedaría pulsado hasta el reloj de 4 s (la X del
          // buscador se quedaba en crema después de borrar).
          if (boton.hasAttribute('data-mel-instantaneo')) return;
          if (document.documentElement.classList.contains('mel-desplazando')) return;
          // ¿Se ha soltado encima? Si el dedo se fue a otra parte no habrá
          // pulsación, y dejar el botón encendido sería mentir.
          var t = e.changedTouches && e.changedTouches[0];
          if (t) {
            var bajoElDedo = document.elementFromPoint(t.clientX, t.clientY);
            if (!bajoElDedo || !boton.contains(bajoElDedo)) return;
          }
          boton.classList.add(PULSADO);
          relojPulsado = setTimeout(limpiarPulsado, SEGURIDAD_MS);
        }, { passive: true });

        ['astro:before-swap', 'astro:page-load', 'pageshow'].forEach(function (evento) {
          addEventListener(evento, limpiarPulsado);
        });
      })();
    </script>
  </head>
  <body class="bg-mel-bg-primary text-mel-text-primary font-sans min-h-full flex flex-col selection:bg-mel-action-secondary selection:text-white transition-colors duration-300">
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-sans);
  }

  /* Blocks the browser's native "drag this image out" gesture site-wide,
     alongside the contextmenu prevention above (drag was still possible
     with just that). -webkit-user-drag covers Chrome/Safari; the dragstart
     listener below covers Firefox, which doesn't support that property. */
  img {
    -webkit-user-drag: none;
    user-drag: none;
  }
</style>
